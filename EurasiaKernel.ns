		public << other <Integer> ^<Integer> = (
			^(ArgumentError value: other) signal
		)
		public >> other <Integer> ^<Integer> = (
			^(ArgumentError value: other) signal
		)
		public addFromFloat: x <Float> ^<Float> = (
			^x + self asFloat
		)
		public addFromFraction: left = (
			^left numerator + (self * left denominator) / left denominator
