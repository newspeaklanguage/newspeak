Newspeak3
'Eurasia'
class EurasiaKernelTestReference packageUsing: manifest = (
	(* The psoup side of the kernel differential tests (eurasia/scripts/kernel-tests.sh): runs the test suites with Minitest, asynchronously as psoup's TestRunner does (each test in a turn of its own, the next when its promise settles), and prints one line per test in EurasiaKernelTestRunner's format: Context>>selector, then success, failure or error, and a description. Minitest reports every broken test promise as an error; as on Eurasia, a failed assertion (TestFailureException) is printed as a failure. *)
	
	|
		Minitest = manifest Minitest.
		KernelTests = manifest KernelTests.
		AccessModifierTesting = manifest AccessModifierTesting.
		KernelWeakTests = manifest KernelWeakTests.
		ActorsTesting = manifest ActorsTesting.
		TestActor = manifest TestActor.
		MirrorTesting = manifest MirrorTesting.
		MirrorTestingModel = manifest MirrorTestingModel.
		MirrorBuilderTesting = manifest MirrorBuilderTesting.
		ActivationMirrorTesting = manifest ActivationMirrorTesting.
	|
) (
	describe: exception = (
		^[ exception messageText printString ] on: Exception do: [:e | '?' ]
	)
	public main: platform args: args = (
		| minitest tester |
		minitest:: Minitest usingPlatform: platform.
		platform actors ultimateExceptionHandler: [:e :activation |
				('Unhandled in a turn: ' , (describe: e)) out
			].
		tester:: minitest Tester testModules: {KernelTests usingPlatform: platform
				testFramework: minitest. AccessModifierTesting usingPlatform: platform
				testFramework: minitest. KernelWeakTests usingPlatform: platform
				minitest: minitest
				gcAction: [ platform kernel garbageCollect ]. ActorsTesting usingPlatform: platform
				actors: platform actors
				testActor: TestActor
				minitest: minitest. MirrorTesting usingPlatform: platform
				minitest: minitest
				model: MirrorTestingModel new. MirrorBuilderTesting usingPlatform: platform
				minitest: minitest. ActivationMirrorTesting usingPlatform: platform
				minitest: minitest. }.
		tester prepare.
		run: tester platform: platform
	)
	outcomeOf: result platform: platform = (
		(* An explicit class send raises in Newspeak, so the exception's class name comes from a mirror. *)
		
		result isSuccess ifTrue: [ ^'success' ].
		result isFailure ifTrue: [ ^'failure ' , result description printString ].
		^((platform mirrors ObjectMirror reflecting: result exception) getClass mixin name = 'TestFailureException' ifTrue: [
				'failure '
			]
			ifFalse: [ 'error ' ]) , (describe: result exception)
	)
	run: tester platform: platform = (
		tester atEnd ifTrue: [ ^'done' out ].
		platform actors Promise when: tester stepAsync
			fulfilled: [:result |
				(result testCase environment classDeclarationMirror simpleName , '>>' , result testCase selector , ' ' , (outcomeOf: result
					platform: platform)) out.
				run: tester platform: platform
			]
	)
) : ()
