			^newIdFor: 'dropDownMenu'
		)
		public dropDownImage = (
			^super dropDownImage
		)
		replaceUndefined: event = (
			^js global replaceUndefined: event
		)
		printJSObjectTree: event = (
			^js global printJSObjectTree: event
		)
		newMenuId ^<String> = (
			^newIdFor: 'menu'
		)
		newWindowId ^<String> = (
			^newIdFor: 'window'
		)
		alert: text <String> = (
			(* FragmentFactory>>alert: is reachable only from presenters, since
     FragmentFactory is mixed into Fragment to form Presenter. The file and media
     fragments below are plain Fragments, so their error handlers were sending
     alert: to something that has never understood it - a DNU that MASKED the very
     error being reported. Declared here at module level, where those nested
     classes reach it by lexical scope; presenters continue to find
     FragmentFactory's, which their inheritance chain reaches first. *)
			
			js global alert: text
		)
		newFileChooserId ^<String> = (
			^newIdFor: 'fileChooser'
		)
		newIdFor: type <String> ^<String> = (
			(* An ordinal within the current scope, per fragment type, rendered as a path.
     The caller prefixes its type marker, so two types in one scope may share an
     ordinal without colliding.

     Every mint is recorded in the diagnostic ledger (croquet-post.js) when it is
     switched on. This counter IS the event address, so two clients agree about
     which widget an event names only while they mint in the same order - and the
     ledger is what makes a disagreement attributable at the point it happens
     rather than at its first consequence, which may be thousands of events and
     one dead chat later. *)
			
			| key = fragmentScopePath , '/' , type. n = (scopedCounters at: key
				ifAbsent: [ 0 ]) + 1. |
			scopedCounters at: key put: n.
			mintLedgerOn ifTrue: [
					js global nsRecordMint: type ordinal: n scope: fragmentScopePath
				].
			^fragmentScopePath , '/' , n printString
		)
		mintingContext: label <String> do: block <[X def]> ^<X> = (
			(* Label every id minted inside block with what was being built. ensure:, like
     withFragmentScope:do: - an unwound stack would mislabel everything after
     it. *)
			
			mintLedgerOn ifFalse: [ ^block value ].
			js global nsPushMintContext: label.
			^[ block value ] ensure: [ js global nsPopMintContext: nil ]
		)
		newFragmentScope ^<String> = (
			(* Minted in the CURRENT scope, so the token is itself the same on every
     client - the construct that owns it is built in deterministic order; only
     its content arrives late. *)
			
			^newIdFor: 'scope'
		)
		withFragmentScope: scope <String> do: block <[X def]> ^<X> = (
			(* ensure:, so that a failure while realizing content cannot leave the path
     dangling and skew everything numbered afterwards. *)
			
			| saved = fragmentScopePath. |
			fragmentScopePath:: scope.
			^[ block value ] ensure: [ fragmentScopePath:: saved ]
		)
		withFragmentScope: scope <String> at: index <Integer> do: block <[X def]> ^<X> = (
			(* Keyed by index rather than a counter: two clients realizing different
     windows of one sequence must still number an element they both realize
     identically. *)
			
			^withFragmentScope: scope , '/r' , index printString do: block
		)
		newButtonId ^<String> = (
			^newIdFor: 'button'
		)
		JSObject = (
			(* make JS Object constructor available to nested classes *)
			
			^super JSObject
		)
		descriptorFor: fd <JSObject> ^<JSObject> = (
			(* Given a file description, produce a description of the metadata only, without the contents *)
			
			| descriptor = JSObject new. |
			
			(* Copy all the data except the actual file contents (the array buffer) to the incoming file descriptor *)
			{#name. #type. #lastModified. #webkitRelativePath. } do: [:pn <Symbol> |
					descriptor at: pn put: (fd at: pn)
				].
			^descriptor
		)
		extractFileData: fs <List[Alien[File]]> whenReady: blk <[:JSArray[JSObject] | Object]> = (
			(* In principle, the data is the file list, fs. However, files cannot be serialized as part of a Croquet event. Even if they could, they are often too large. We must obtain their contents via their asynchronous API and package that up. We then feed the data into the blk parameter for further processing. See #chooseFileList: for what that further processing looks like. *)
			
			| ps <List[Alien[Promise[[ArrayBuffer]]]]> = (js global at: 'Array') new: fs size. fds <JSArray[JSObject]> = 
			(* An array of file descriptors - JS objects of the form 
  {name: String, type: String, lastModified: Float, webkitRelativePath: String, handle: JSPromise, arrayBuff: Blob} *)
			(js global at: 'Array') new: fs size. |
			1 to: fs size
				do: [:i <Integer> |
					| f <Alien[File]> = fs at: i. |
					ps at: i - 1 put: (fs at: i) arrayBuffer.
					fds at: i - 1 put: (descriptorFor: f)
				].
			((js global at: 'Promise') all: ps) then: [:buffers <JSArray[ArrayBuffer]> |
					0 to: fs size - 1
						do: [:i <Integer> | (fds at: i) at: #arrayBuff put: (buffers at: i) ].
					[
						blk value: fds.
						nil
					] on: Error
						do: [:ex |
							alert: 'HopscotchForCroquet FileChooserFragment extractFileData:whenReady ' , ex printString.
							nil
						].
					nil
				]
				onError: [:ex |
					alert: ex printString.
					nil
				]
		)
		processMediaUpdatesFromFiles: files <List[Alien[File]]> = (
		)
		createFile: fd <JSObject> ^<Alien[File]> = (
			(* Given a file description, return a corresponding JS File object.
The argument is of the form 
{name: String, type: String, lastModified: Float, webkitRelativePath: String, handle: JSPromise, arrayBuff: JSArrayBuffer} *)
			
			| contents <JSArray> = (js global at: 'Array') new: 1. options = JSObject new. |
			contents at: 0 put: (fd at: #arrayBuff).
			options at: #type put: (fd at: #type);
				at: #lastModified put: (fd at: #lastModified).
			^(js global at: #File) new: contents name: (fd at: #name) options: options
		)
		newMediaCreatorId ^<String> = (
			^newIdFor: 'mediaCreator'
		)
		newTimerId ^<String> = (
			^newIdFor: 'timer'
		)
		public blobURIFor: file <Alien[File]> ^<String> = (
			(* Make inherited method accessible to nested classes *)
			
			^super blobURIFor: file
		)
		publish: s <String> event: en <String> data: d = (
			(* Routed through nsPublish (croquet-post.js) rather than the view's own publish. Croquet silently drops reflector messages over 16KB, and the editor fragments send their full text on every keystroke; nsPublish detours oversized payloads through the file server, publishing only a handle. *)
			
			js global nsPublish: s event: en data: d
		)
		rootView ^<Alien[NewspeakCroquetView]> = (
			^js global at: #theView
		)
		public syncRandom ^<Float> = (
			(* A random number in [0, 1) from a deterministic PRNG replicated across
	   all clients of the session (seeded from the session id; see nsSyncRandom
	   in the croquet support script). DISCIPLINE: draw only inside synchronized
	   event handlers (button actions, editor responses, tick handlers), which
	   run in identical order on every client and under replay; a draw outside
	   them - a local animation frame, a promise callback, hover feedback -
	   advances the stream on one client only and desynchronizes every draw
	   after it. For purely local, non-shared randomness use the browser's
	   Math.random via js global instead. *)
			
			^(js global at: #nsSyncRandom) apply: nil
		)
		showMenu: menu <Alien[Div]> forShell: s <HopscotchShell> inVisual: v <Visual> = (
			(* Make the inherited method visible to nested classes *)
			
			super showMenu: menu forShell: s inVisual: v
		)
		computeContentForMenu: menuSupplier <[Menu]> ^<Alien[Div]> = (
			(* Make the inherited method visible to nested classes *)
			
			^super computeContentForMenu: menuSupplier
		)
		openMenu: aMenu <Menu> forShell: s <HopscotchShell> inVisual: v <Visual> = (
			(* Overridden so as to wrap the menu items so that their actions post Croquet events. Every context menu is opened from a synchronized action (a button or link), so each client computes the Menu at the same event position and its subscription matches under replay. The shell keeps the Menu so that the next open retires it (see HopscotchShell noteContextMenu:); Menu is not a Fragment, so nothing else would.

Until 2026-09-16 this was a module-level openMenu:, which Presenter>>openMenu: shadowed by inheritance - the wrapper never ran and context-menu actions ran on the clicking client alone. *)
			
			| m <Menu> = Menu supplier: [ aMenu ]. |
			s noteContextMenu: m.
			showMenu: (computeContentForMenu: [ m menuContents ]) forShell: s inVisual: v
		)
		showMenu: menu <Alien[Div]> forFragment: m <DropDownMenuFragment> = (
			(* Make the inherited method visible to nested classes *)
			
			super showMenu: menu forFragment: m
		)
		subscribeFragment: fragmentId scope: scope eventSpec: eventSpec <String> handler: blk <[CroquetEvent]> = (
			(* Without a label: for subscribers that are not fragments of a presenter (menus, timers), whose events the alarm checks by delivery count only. *)
			
			^subscribeFragment: fragmentId
				scope: scope
				eventSpec: eventSpec
				handler: blk
				label: nil
		)
		subscribeFragment: fragmentId scope: scope eventSpec: eventSpec <String> handler: blk <[CroquetEvent]> label: label <String | UndefinedObject> = (
			(* Routed through nsSubscribe (croquet-post.js), which wraps the handler to resolve detoured (oversized) payloads - see #publish:event:data: - records the wrapped handler so it is available for replay after rejoining the session, and subscribes it. The label (Fragment>>croquetLabel, or nil) is registered for the address there, for the divergence alarm's label check. *)
			
			| handler = [:e |
				blk value: e.
				(js global at: #eventProcessed) apply: nil.
				nil
			]. |
			js global nsSubscribe: scope
				eventSpec: eventSpec
				handler: handler
				label: label
		)
		superButton ^<super ButtonFragment class> = (
			^super ButtonFragment
		)
		superCheckbox ^<super CheckboxFragment class> = (
			^super CheckboxFragment
		)
		superPicker ^<super PickerFragment class> = (
			^super PickerFragment
		)
		superColorPicker ^<super ColorPickerFragment class> = (
			^super ColorPickerFragment
		)
		superDatePicker ^<super DatePickerFragment class> = (
			^super DatePickerFragment
		)
		superTimePicker ^<super ColorTimeFragment class> = (
			^super TimePickerFragment
		)
		superCodeMirror ^<super CodeMirrorFragment class> = (
			^super CodeMirrorFragment
		)
		superRadioButton ^<super RadioButtonFragment class> = (
			^super RadioButtonFragment
		)
		superImageButton ^<super ImageButtonFragment class> = (
			^super ImageButtonFragment
		)
		superDropdownMenu ^<super DropdownMenuFragment class> = (
			^super DropdownMenuFragment
		)
		superFileChooser ^<super FileChooserFragment class> = (
			^super FileChooserFragment
		)
		superHyperlink ^<super HyperlinkFragment class> = (
			^super HyperlinkFragment
		)
		superHyperlinkImage ^<super HyperlinkImageFragment class> = (
			^super HyperlinkImageFragment
		)
		superMediaCreator ^<super MediaCreatorFragment class> = (
			^super MediaCreatorFragment
		)
		superSlider ^<super SliderFragment class> = (
			^super SliderFragment
		)
		superTextEditor ^<super TextEditorFragment class> = (
			^super TextEditorFragment
		)
		superToggleComposer ^<super ToggleComposer class> = (
			^super ToggleComposer
		)
	) : ()
) : ()
