Newspeak3
'Emmanuel'
class EmmanuelNewspeakHost usingPlatform: p emmanuel: em parsing: parsing = (
	(* The Newspeak instance of Emmanuel's host parameter (Section 3.4 and 4.1 of
the specification): it parses the code of a bracket into statements,
evaluates the arguments of messages, and prints statements.

Parsing uses the recursive-descent NewspeakPredictiveParsing. A bracket's
code reaches the host as pieces, code and markup literals; each literal is
replaced by an identifier of the same length, so the parser sees ordinary
Newspeak, and its byte positions are mapped back to positions in the
source. A statement must be a send to the implicit receiver; anything else
is a syntax error. The comments before a statement belong to it, and a
comment after the last statement is a statement of its own.

Evaluation: a markup literal evaluates to itself (E1), and so do string,
symbol, and number literals. Any other argument is computed: it goes to the
evaluator given to Host evaluator:, which answers its value. Without an
evaluator, a computed argument raises.

Printing is the trivial instance: a statement is printed as its source, after
its comments; statements are separated by a period and a space. *)
	
	|
		private List = p collections List.
		private emmanuel = em.
		private parser = parsing CommonParser new.
	|
) (
	public class Host evaluator: ev = (
		(* The host. ev, if not nil, evaluates computed arguments:
ev evaluate: aString answers the value. *)
		
		|
			private evaluator = ev.
		|
	) (
		bracketSpan: pieces = (
			^emmanuel Span from: (spanOfPiece: pieces first) start
				to: (spanOfPiece: pieces last) end
		)
		commentsIn: code positions: positions = (
			(* The spans of the comments in the code, skipping strings. *)
			
			| out = List new. k ::= 1. e |
			[ k <= code size ] whileTrue: [
					(code at: k) = 39 ifTrue: [
							e:: emmanuel scanString: code from: k + 1.
							e isNil ifTrue: [ ^out asArray ].
							k:: e
						]
						ifFalse: [
							(k < code size and: [ (code at: k) = 40 and: [ (code at: k + 1) = 42 ] ]) ifTrue: [
									e:: emmanuel scanComment: code from: k + 2 depth: 1.
									e isNil ifTrue: [ ^out asArray ].
									out add: (emmanuel Span from: (positions at: k)
											to: (positions at: e - 1) + 1).
									k:: e
								]
								ifFalse: [ k:: k + 1 ]
						]
				].
			^out asArray
		)
		public eval: expr hostState: chi = (
			| ast = expr ast. value |
			expr isPlaceholder ifTrue: [
					^emmanuel Evaluated state: chi value: expr lits first
				].
			(ast isKindOfStringAST or: [
					ast isKindOfSymbolAST or: [ ast isKindOfNumberNode ]
				]) ifTrue: [ ^emmanuel Evaluated state: chi value: ast value ].
			evaluator isNil ifTrue: [
					^emmanuel Raised state: chi
						exception: (HostException description: 'a computed argument, and no evaluator')
				].
			value:: [ evaluator evaluate: expr text ] on: Error
				do: [:e |
					^emmanuel Raised state: chi
						exception: (HostException description: e messageText)
				].
			^emmanuel Evaluated state: chi value: value
		)
		exprFor: ast holes: holes positions: positions byteToCode: byteToCode code: code = (
			| first = byteToCode at: ast start. last = byteToCode at: ast end. lits = List new. placeholder text |
			holes do: [:h |
					| literal = h at: 2. |
					(literal span start >= (positions at: first) and: [
							literal span end <= ((positions at: last) + 1)
						]) ifTrue: [ lits add: literal ]
				].
			placeholder:: ast isKindOfUnresolvedSendNode and: [
					(isImplicitReceiver: ast receiver) and: [
							holes anySatisfy: [:h | (h at: 1) = ast message selector asString ]
						]
				].
			text:: emmanuel stringOfCodePoints: (code asArray copyFrom: first to: last).
			^HostExpr ast: ast text: text literals: lits asArray placeholder: placeholder
		)
		isImplicitReceiver: ast = (
			^ast isKindOfVariableNode and: [ ast name = #'@here' ]
		)
		public parse: pieces = (
			(* The statements of a bracket, or a Failure. *)
			
			| code = List new. positions = List new. holes = List new. bytes = List new. byteToCode = List new. body statements comments out literalsByName |
			pieces do: [:piece |
					piece isHole ifTrue: [
							| literal = piece literal. size = literal span end - literal span start. name = placeholderFor: holes size + 1
								size: size. |
							holes add: {name. literal. }.
							0 to: size - 1
								do: [:j |
									code add: 32.
									positions add: literal span start + j
								].
							1 to: name size
								do: [:j |
									bytes add: (name at: j).
									byteToCode add: code size - size + j
								]
						]
						ifFalse: [
							piece chars keysAndValuesDo: [:j :cp |
									code add: cp.
									positions add: piece span start + j - 1.
									emmanuel encodeCodePoint: cp on: bytes.
									[ byteToCode size < bytes size ] whileTrue: [
											byteToCode add: code size
										]
								]
						]
				].
			code isEmpty ifTrue: [ ^{} ].
			body:: [ parser parseExpression: (String withAll: bytes asArray) ] on: Error
				do: [:e | ^emmanuel Failure span: (bracketSpan: pieces) ].
			statements:: body statements asArray.
			literalsByName:: holes.
			comments:: commentsIn: code asArray positions: positions asArray.
			out:: List new.
			statements do: [:s |
					| start = positions at: (byteToCode at: s start). end = (positions at: (byteToCode at: s end)) + 1. before = comments select: [:c |
							c end <= start
						]. |
					(s isKindOfUnresolvedSendNode and: [ isImplicitReceiver: s receiver ]) ifFalse: [
							^emmanuel Failure span: (emmanuel Span from: start to: end)
						].
					comments:: comments reject: [:c | c start < end ].
					out add: (emmanuel SendStatement comments: before asArray
							selector: s message selector asString
							arguments: (s message arguments asArray collect: [:a |
									exprFor: a
										holes: holes
										positions: positions
										byteToCode: byteToCode
										code: code
								])
							span: (emmanuel Span from: start to: end))
				].
			comments do: [:c | out add: (emmanuel CommentStatement span: c) ].
			^out asArray
		)
		placeholderFor: index size: size = (
			(* An identifier of the given size, unique within the bracket. *)
			
			| name ::= 'q' , index printString. |
			[ name size < size ] whileTrue: [ name:: name , 'q' ].
			^name
		)
		public print: statements source: w = (
			| out = List new. |
			statements keysAndValuesDo: [:i :s |
					i > 1 ifTrue: [ out add: (emmanuel PrintedCode chars: {46. 32. }) ].
					s isComment ifTrue: [
							out add: (emmanuel PrintedCode chars: (emmanuel slice: w span: s span))
						]
						ifFalse: [
							s comments do: [:c |
									out add: (emmanuel PrintedCode chars: (emmanuel slice: w span: c) , {32. })
								].
							out add: (emmanuel PrintedCode chars: (emmanuel slice: w span: s span))
						]
				].
			^out asArray
		)
		spanOfPiece: piece = (
			^piece isHole ifTrue: [ piece literal span ] ifFalse: [ piece span ]
		)
	) : ()
	public class HostException description: d = (
		(* An exception the host raised while evaluating an argument. *)
		
		|
			public description = d.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: 'EXCEPTION';
				string: description;
				close
		)
	) : ()
	public class HostExpr ast: a text: t literals: ls placeholder: b = (
		(* An argument: its AST, its source text (with each markup literal
replaced by spaces), and its markup literals in order. *)
		
		|
			public ast = a.
			public text = t.
			public lits = ls.
			public isPlaceholder = b.
		|
	) (
		public erased = (
			^HostExpr ast: ast
				text: text
				literals: (lits collect: [:l | l erased ])
				placeholder: isPlaceholder
		)
		public printTermOn: t = (
			t open;
				atom: 'HOSTEXPR';
				string: text;
				list: lits;
				close
		)
	) : ()
) : ()
