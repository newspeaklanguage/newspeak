;; Section 4.1: the host evaluator and the block signature, and the trees
;; that values may carry.
;;
;; Host states, values, exceptions, and block states are abstract in the
;; LaTeX. A transcription choice: each is a carrier wide enough for every
;; instance the regressions use. A host state is an opaque number; a value
;; is a markup literal, a finished tree, or an opaque host number; a block
;; state is a class name with field values. Strings, integers, and nil are
;; there for the standard library (Section 6); a symbol is a string literal,
;; so it evaluates to a string. Trees are declared here because
;; values and block states contain them.

syntax hoststate = HOSTSTATE nat
syntax exception = EXCEPTION nat
var chi : hoststate
var xi : exception

;; @equation eq:trees
syntax value = LITV markupliteral | TREEV markupliteral tree | HOSTV nat | STRV (char*) | INTV nat | NILV
syntax blockstate = STATE text (value*)
syntax flag = CLOSED | UNCLOSED | REJECTED
syntax titem =
  | RUN (char*) span
  | SUB tree
  | NOTE span
  | MUT stmt
  | DNU stmt
  | STRAY (char*) span
  | ROOTPOP stmt
  | REFUSED stmt
syntax tree = TREE blockstate (titem*) (stmt*) flag
var v : value
var kappa : blockstate
var f : flag
var ti : titem
var tr : tree

;; @equation eq:host-evaluator
syntax evaloutcome = VAL hoststate value | EXN hoststate exception
relation Eval: (hoststate, hostexpr) => (evaloutcome)

;; @equation eq:content-class
syntax contentclass = FLOW | PARA | CELL | INLINE
var q : contentclass
def $cls(blockstate) : contentclass

;; @equation eq:block-signature
syntax effect =
  | POP | POPREJECT | LEAF blockstate | PUSH blockstate | MUTATE blockstate
  | REFUSE | NOTUNDERSTOOD
var ep : effect
syntax effoutcome = EFF hoststate effect | EXNS hoststate exception
relation Effect: (hoststate, blockstate, text, value*) => (effoutcome)

;; @equation eq:host-printer
;; The host's pretty printer: the statements of one bracket as code with
;; holes, a hole being a markup literal for the core to print.
syntax ppiece = PCODE (char*) | PLIT markupliteral
var pp : ppiece
def $hostPrint(char*, stmt*) : ppiece*
