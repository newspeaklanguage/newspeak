Newspeak3
'Root'
class IDEHygieneTesting usingPlatform: p namespace: ns minitest: minitest = Object new (
	(* IDE-wide code hygiene checks.
	Silent error handlers -- on: Error do: [:e | ] and the like -- hid two IDE
	wiring bugs (each a doesNotUnderstand). Handlers in the IDE must either let the
	error through or log it (ide noteSwallowed:in:); the few that must stay silent
	are listed, with reasons, in SilentHandlerTests>>allowedSilentHandlers. *)
	
	|
		private TestContext = minitest TestContext.
		private ClassMirror = p mirrors ClassMirror.
		private List = p collections List.
		private namespace = ns.
	|
) (
	public class SilentHandlerTests new = TestContext new (
		(* Searches source text, so it is approximate: it catches the common
		spellings of a handler that discards the error, not every possible one. *)
		
	) (
		allowedSilentHandlers = (
			(* Deliberately silent, each for a stated reason:
			- HopscotchWebIDE>>loadFrom:usingPlatform: runs before the IDE exists (no
			  noteSwallowed:in: yet); its outer handler already writes to the console.
			- AI_IDE_Support>>logBus: is itself a console logger.
			- Repository>>pushForce: turns the failure into a rejected push, which the
			  user sees. *)
			
			^{'HopscotchWebIDE>>loadFrom:usingPlatform:'. 'AI_IDE_Support>>logBus:'. 'Repository>>pushForce:'. }
		)
		ideModuleNames = (
			^{#HopscotchWebIDE. #Browsing. #Debugging. #Documents. #MinitestUI. #WorkspaceManager. #AI_IDE_Support. #Repositories. #Namespacing. }
		)
		silentHandlerMethodsIn: decl into: found = (
			{decl instanceSide. decl classSide. } do: [:m |
					m methods do: [:meth |
							| s hit |
							s:: meth source.
							(s isNil not and: [
									(s includesSubstring: 'on: Error') or: [
											s includesSubstring: 'on: Exception'
										]
								]) ifTrue: [
									hit:: false.
									silentHandlerPatterns do: [:p |
											(s includesSubstring: p) ifTrue: [ hit:: true ]
										].
									hit ifTrue: [ found add: m name asString , '>>' , meth name asString ]
								]
						]
				].
			decl instanceSide nestedClasses do: [:n |
					silentHandlerMethodsIn: n into: found
				]
		)
		silentHandlerPatterns = (
			^{'do: [:e |]'. 'do: [:e | ]'. 'do: [:e <Exception> |]'. 'do: [:e <Exception> | ]'. 'do: []'. 'do: [:ex |]'. 'do: [:e | nil ]'. 'do: [:e <Exception> | nil ]'. 'do: [:e | nil]'. }
		)
		public testAllowedSilentHandlersStillExist = (
			(* Keeps the allow-list honest: an entry whose method is gone or no longer
			   silent should be removed. *)
			
			| found stale report |
			found:: List new.
			ideModuleNames do: [:nm |
					| cls |
					cls:: namespace at: nm ifAbsent: [ nil ].
					cls isNil ifFalse: [
							silentHandlerMethodsIn: (ClassMirror reflecting: cls) mixin declaration
								into: found
						]
				].
			stale:: allowedSilentHandlers reject: [:name | found includes: name ].
			report:: stale inject: '' into: [:acc :name | acc , ' ' , name ].
			assert: [ stale isEmpty ]
				description: 'allowedSilentHandlers entries no longer silent (or gone) -- remove them:' , report
		)
		public testNoUnexpectedSilentErrorHandlers = (
			| found unexpected report |
			found:: List new.
			ideModuleNames do: [:nm |
					| cls |
					cls:: namespace at: nm ifAbsent: [ nil ].
					cls isNil ifFalse: [
							silentHandlerMethodsIn: (ClassMirror reflecting: cls) mixin declaration
								into: found
						]
				].
			unexpected:: found reject: [:name | allowedSilentHandlers includes: name ].
			report:: unexpected inject: '' into: [:acc :name | acc , ' ' , name ].
			assert: [ unexpected isEmpty ]
				description: 'Error handlers that swallow errors silently (log via ide noteSwallowed:in:, or add to allowedSilentHandlers with a reason):' , report
		)
	) : (
		TEST_CONTEXT = (
		)
	)
) : ()