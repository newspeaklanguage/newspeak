Newspeak3
'Eurasia'
class EurasiaRestoreProbe usingPlatform: platform = (
	(* M7 step 4 (EURASIA_M7_SNAPSHOTS_REPLAY_DESIGN_2026-11-18.md section 3.4): a checkpoint restored into a new host. The probe holds a host object in a lazy slot and in an ordinary slot, makes itself the restore handler (role 40), and asks for a checkpoint in the middle of its turn. Restored into a new host, the turn continues where the checkpoint was taken; the lazy slot looks the host object up again, the ordinary slot's Alien is dead, and the handler is sent restored in a turn of its own. The genesis packager packages this application as if nested in EurasiaKernel (so vm is visible) and fills the module slots below; eurasia/scripts/replay-tests.sh runs it on wasm. *)
	
	|
		Kernel
		CollectionsForPrimordialSoup
		EurasiaActors
		EurasiaRuntime
		internalKernel
		js
		ordinary
	|
) (
	lazy math = js global at: 'Math'.
	public main: platform args: args = (
		js:: platform js.
		vm setRole: 40 to: self.
		ordinary:: js global at: 'Math'.
		report: 'before'.
		vm checkpointNow.
		report: 'after'
	)
	public platformOver: ik = (
		internalKernel:: ik.
		^(EurasiaRuntime kernel: Kernel
			collections: CollectionsForPrimordialSoup
			actors: EurasiaActors) Platform internalKernel: ik
	)
	report: when = (
		| lazyMax ordinaryMax |
		lazyMax:: [ (math call: 'max' withArguments: {1. 2. }) printString ] on: Error
			do: [:e | 'failed' ].
		ordinaryMax:: [ (ordinary call: 'max' withArguments: {3. 4. }) printString ] on: Error
			do: [:e | 'failed' ].
		vm print: when , ' lazy ' , lazyMax , ' ordinary ' , ordinaryMax
	)
	public restored = (
		report: 'restored'
	)
) : ()
