	) (
		public cull: arg1 = (
			0 = numArgs ifTrue: [ ^self value ].
			1 = numArgs ifTrue: [ ^self value: arg1 ].
			^numArgsError: 1
		)
		public cull: arg1 cull: arg2 = (
			0 = numArgs ifTrue: [ ^self value ].
			1 = numArgs ifTrue: [ ^self value: arg1 ].
			2 = numArgs ifTrue: [ ^self value: arg1 value: arg2 ].
			^numArgsError: 2
