;; The fixture host evaluator and host printer, shared by the core
;; regressions and the library regressions. Hand-written, non-normative.

;; Host expressions: a lone literal evaluates to itself (E1); ids below 900
;; are opaque constants; 900 raises; 901 reads and bumps a counter; 902
;; raises while the counter is 0; ids
;; from 1000 are the strings and nil of $const (a symbol, #x, is the
;; string literal 'x', so #intro is the string "intro").
rule Eval/ev-literal:
  (chi, HOSTEXPR k L) => (VAL chi (LITV L))

rule Eval/ev-opaque:
  (chi, HOSTEXPR k eps) => (VAL chi (HOSTV k))
  -- if k < 900

rule Eval/ev-raise:
  (chi, HOSTEXPR 900 eps) => (EXN chi (EXCEPTION 900))

rule Eval/ev-count:
  (HOSTSTATE z, HOSTEXPR 901 eps) => (VAL (HOSTSTATE $(z + 1)) (HOSTV z))

;; 902 raises unless the counter has been bumped: what it does depends on
;; what came before it, as a real host's code can.
rule Eval/ev-fragile:
  (HOSTSTATE z, HOSTEXPR 902 eps) => (EXN (HOSTSTATE z) (EXCEPTION 902))
  -- if z = 0

rule Eval/ev-fragile-ok:
  (HOSTSTATE z, HOSTEXPR 902 eps) => (VAL (HOSTSTATE z) (HOSTV 902))
  -- if z > 0

rule Eval/ev-const:
  (chi, HOSTEXPR k eps) => (VAL chi $const(k))
  -- if k >= 1000

def $const(nat) : value
def $const(1001) = STRV ("i" "n" "t" "r" "o")
def $const(1002) = STRV ("x" " " ":" "=" " " "1")
def $const(1003) = STRV ("s" "m" "a" "l" "l" "t" "a" "l" "k")
def $const(1004) = STRV ("<" "h" "r" ">")
def $const(1005) = NILV
def $const(1006) = STRV ("f" "i" "g")
def $const(1007) = STRV ("H" "a" "m" "l" "e" "t")
def $const(1008) = STRV ("p" "l" "o" "t")
;; For editing (Section 7): actTitle computes a string; 'Act I' and
;; 'y := 2' are string literals; standardTitle (1010, in the library's
;; generated host) answers a template literal; scratchTitle answers a
;; literal whose source is not in the image.
def $const(1009) = STRV ("A" "c" "t" " " "I")
def $const(1011) = STRV ("A" "c" "t" " " "I")
def $const(1012) = STRV ("y" " " ":" "=" " " "2")
def $const(1015) = STRV ("h" "t" "t" "p" ":" "/" "/" "x")
def $const(1016) = STRV ("h" "t" "t" "p" ":" "/" "/" "y")
def $const(1017) = STRV ("l" "a" "r" "g" "e")
def $const(1018) = STRV ("s" "m" "a" "l" "l")
def $const(1019) = STRV ("x" "L" "a" "r" "g" "e")
def $const(1013) = LITV (MARKUP "scratch" ((FINAL ("T" "m" "p") (SPAN 2 5))) (SPAN 0 7))

;; The host printer: statements separated by ". ", each after its
;; comments. A keyword send whose one argument is a literal is printed from
;; its selector, with the literal in a hole, so the layout inside it is
;; normalized; any other send, and a comment, is copied from its source.
def $spell(text) : char*
def $spell("title:") = "t" "i" "t" "l" "e" ":"
def $spell("subtitle:") = "s" "u" "b" "t" "i" "t" "l" "e" ":"
def $spell("author:") = "a" "u" "t" "h" "o" "r" ":"
def $spell("section:") = "s" "e" "c" "t" "i" "o" "n" ":"
def $spell("link:") = "l" "i" "n" "k" ":"
def $spell("caption:") = "c" "a" "p" "t" "i" "o" "n" ":"
def $spell("attribution:") = "a" "t" "t" "r" "i" "b" "u" "t" "i" "o" "n" ":"
def $spell("codeBlock:") = "c" "o" "d" "e" "B" "l" "o" "c" "k" ":"
def $spell("paragraph") = "p" "a" "r" "a" "g" "r" "a" "p" "h"
def $spell("endParagraph") = "e" "n" "d" "P" "a" "r" "a" "g" "r" "a" "p" "h"
def $spell("emphasis") = "e" "m" "p" "h" "a" "s" "i" "s"
def $spell("endEmphasis") = "e" "n" "d" "E" "m" "p" "h" "a" "s" "i" "s"
def $spell("strong") = "s" "t" "r" "o" "n" "g"
def $spell("newline") = "n" "e" "w" "l" "i" "n" "e"
def $spell("endStrong") = "e" "n" "d" "S" "t" "r" "o" "n" "g"
def $spell("underline") = "u" "n" "d" "e" "r" "l" "i" "n" "e"
def $spell("endUnderline") = "e" "n" "d" "U" "n" "d" "e" "r" "l" "i" "n" "e"
def $spell("strikethrough") = "s" "t" "r" "i" "k" "e" "t" "h" "r" "o" "u" "g" "h"
def $spell("endStrikethrough") = "e" "n" "d" "S" "t" "r" "i" "k" "e" "t" "h" "r" "o" "u" "g" "h"
def $spell("subscript") = "s" "u" "b" "s" "c" "r" "i" "p" "t"
def $spell("endSubscript") = "e" "n" "d" "S" "u" "b" "s" "c" "r" "i" "p" "t"
def $spell("superscript") = "s" "u" "p" "e" "r" "s" "c" "r" "i" "p" "t"
def $spell("endSuperscript") = "e" "n" "d" "S" "u" "p" "e" "r" "s" "c" "r" "i" "p" "t"
def $spell("size:") = "s" "i" "z" "e" ":"
def $spell("endSize") = "e" "n" "d" "S" "i" "z" "e"

def $noLits(hostexpr*) : bool
def $noLits(eps) = true
def $noLits(eta eta'*) = ($lits(eta) = eps) /\ $noLits(eta'*)

def $hpComments(char*, span*) : ppiece*
def $hpComments(w*, eps) = eps
def $hpComments(w*, s s'*) = (PCODE ($slice(w*, s) " ")) $hpComments(w*, s'*)

def $hpStmt(char*, stmt) : ppiece*
def $hpStmt(w*, COMMENT s) = (PCODE ($slice(w*, s)))
def $hpStmt(w*, SEND (s'*) x (eta*) s) = $hpComments(w*, s'*) (PCODE ($slice(w*, s)))
  -- if $noLits(eta*) /\ s =/= SPAN 0 0
;; A statement given by the field interface has the span [0, 0) and no
;; source: a unary one is printed from its selector.
def $hpStmt(w*, SEND (s'*) x eps (SPAN 0 0)) = (PCODE ($spell(x)))
def $hpStmt(w*, SEND (s'*) x (HOSTEXPR k L) s) = $hpComments(w*, s'*) (PCODE ($spell(x) " ")) (PLIT L)
;; A keyword send with no source whose one argument is a constant string,
;; as an edit's style with a value is: its argument as the symbol #u.
def $hpStmt(w*, SEND (s'*) x (HOSTEXPR k eps) (SPAN 0 0)) = (PCODE ($spell(x) " " "#" $strChars($const(k))))

def $strChars(value) : char*
def $strChars(STRV (u*)) = u*

def $hostPrint(w*, eps) = eps
def $hostPrint(w*, sigma) = $hpStmt(w*, sigma)
def $hostPrint(w*, sigma sigma' sigma''*) =
  $hpStmt(w*, sigma) (PCODE ("." " ")) $hostPrint(w*, sigma' sigma''*)

;; The host side of the field interface (Section 7). A keyword send is
;; written `x: arg` with one space, so its argument starts after it.
def $argSpan(SEND (s'*) x (eta) (SPAN i j), 0) = SPAN $(i + $lenC($spell(x)) + 1) j

def $strLitIds : nat*
def $strLitIds = 1002 1004 1007 1011 1012 1015 1016

def $isStrLit(SEND (s'*) x (HOSTEXPR k (L*)) s, 0) = L* = eps /\ k <- $strLitIds

def $enc(u*) = "'" u* "'"

def $printsValue(I*, STRV (u*)) = true
def $printsValue(I*, TREEV (MARKUP nm (n*) s) tr) = $inImage(I*, nm)
def $printsValue(I*, LITV L) = false
def $printsValue(I*, HOSTV k) = false
def $printsValue(I*, INTV k) = false
def $printsValue(I*, NILV) = false

def $printValue(I*, STRV (u*)) = $enc(u*)
def $printValue(I*, TREEV (MARKUP nm (n*) s) tr) = $slice($source(I*, nm), s)
