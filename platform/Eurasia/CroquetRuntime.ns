Newspeak3
'Eurasia'
class CroquetRuntime web: webRuntime jsForCroquet: jsForCroquetModule hopscotchForCroquet: hopscotchForCroquetModule hostForCroquet: hostForCroquetModule hopscotch: hopscotchModule ducts: ductsModule voiceController: voiceControllerClass = (
	(* The platform of a Hopscotch application under Croquet on Eurasia's web host, as PrimordialSoup/CroquetRuntime's is on psoup: Eurasia's web platform (a WebRuntime, given), differing from it in exactly three slots - js (per-session local storage, JSForCroquet), hopscotch (HopscotchForCroquet layered over HopscotchForHTML5) and host (HostForCroquet, routing requests through the coordinated-IO scheme) - plus the isKindOfPlatformWithCroquet predicate. The page must load the Croquet client and the Croquet support script, and start Eurasia only once Session.join has produced a view (eurasia/web/croquet-viewer.html). *)
	
	|
		private WebPlatform = webRuntime Platform.
		private JSForCroquet = jsForCroquetModule.
		private HopscotchForCroquet = hopscotchForCroquetModule.
		private HostForCroquet = hostForCroquetModule.
		private Hopscotch = hopscotchModule.
		private Ducts = ductsModule.
		private VoiceController = voiceControllerClass.
	|
) (
	public class Platform over: basePlatform = WebPlatform over: basePlatform (
		(* WebRuntime's platform with the Croquet js, hopscotch and host. The superclass's initializer runs first and may send js (its modules capture it), so the overrides are lazy and reach the base platform's js through baseJs, a method. *)
		
	) (
		lazy public hopscotch = (* Lazy, as in WebRuntime: Hopscotch captures platform aiAccess when it is built. *) hopscotchForCroquet Hopscotch usingPlatform: self
			images: images
			ducts: (Ducts usingPlatform: self)
			voiceControlClass: VoiceController.
		lazy private hopscotchForCroquet = HopscotchForCroquet usingPlatform: self
			hopscotch: Hopscotch.
		lazy public host = (* The synchronized host: requests route through the coordinated-IO scheme so every client and every late joiner shares the initiator's recorded result. See HostForCroquet. *) nil = hostModule ifFalse: [
				HostForCroquet usingPlatform: self hostClass: hostModule
			].
		lazy public js = (* Per-session local storage, as on psoup (JSForCroquet). *) (JSForCroquet usingPlatform: self
			js: BaseJS) Js usingPlatform: self.
		class BaseJS usingPlatform: p = (
			(* The base platform's js with the factory JSForCroquet's Js inherits from (psoup's Aliens usingPlatform:): it forwards what Eurasia's js answers. *)
			
		) (
			public global = (
				^baseJs global
			)
			public localStorage = (
				^baseJs localStorage
			)
			public undefined = (
				^baseJs undefined
			)
		) : ()
		baseJs = (
			(* The js of the platform this one extends: Eurasia's own, which the superclass's slot holds. *)
			
			^super js
		)
		public isKindOfPlatformWithCroquet ^<Boolean> = (
			^true
		)
		public vmName ^<String> = (
			^'Eurasia (Croquet)'
		)
	) : ()
) : ()
