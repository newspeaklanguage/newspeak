Newspeak3
'Eurasia'
class EurasiaSaveImageProbe usingPlatform: platform = (
	(* Saving a running image (Actors>>saveImage:): the probe saves its image, which the VM takes at its next safepoint and hands to the host (on the command line, a file), and its promise is fulfilled with #saved; a second save while the first is under way is refused. The saved image, run on its own, is restored into a new host: the restore action runs, and the same promise is fulfilled with #restored instead. The genesis packager packages this application as if nested in InternalKernel (so vm is visible) and fills the module slots below; eurasia/scripts/replay-tests.sh runs it. *)
	
	|
		Kernel
		PrimordialSoupCollections
		Actors
		Runtime
		internalKernel
	|
) (
	public main: platform args: args = (
		| actors = platform actors. |
		actors whenRestored: [ vm print: 'restored: the restore action ran' ].
		actors Promise when: (actors saveImage: 'saved.eus')
			fulfilled: [:outcome |
				vm print: 'saveImage: answered ' , outcome printString.
				nil
			]
			broken: [:problem |
				vm print: 'saveImage: broken ' , problem printString.
				nil
			].
		actors Promise when: (actors saveImage: 'second.eus')
			fulfilled: [:outcome |
				vm print: 'a second save: answered ' , outcome printString.
				nil
			]
			broken: [:problem |
				vm print: 'a second save: refused'.
				nil
			].
		vm print: 'asked for the image to be saved'
	)
	public platformOver: ik = (
		internalKernel:: ik.
		^(Runtime kernel: Kernel collections: PrimordialSoupCollections actors: Actors) Platform internalKernel: ik
	)
) : ()
