	public saveImage: name <String> ^<Promise[Symbol]> = (
		(* Save the running image, its state and not only its code, under name: the VM takes a checkpoint at its next safepoint and hands it to the host, which keeps it (the web host's page stores it in the browser). Answers a promise of #saved once the image is handed over; in an image restored from it, the same promise is fulfilled with #restored instead. One save at a time. *)
		
		| r |
		imageHandler pendingSave isNil ifFalse: [
				^Promise broken: 'An image is already being saved.'
			].
		r:: Resolver new.
		imageHandler pendingSave: r.
		setRole: 40 to: imageHandler.
		primSaveImage: name.
		^r promise
	)
