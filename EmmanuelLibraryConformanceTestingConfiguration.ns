Newspeak3
'Emmanuel'
class EmmanuelLibraryConformanceTestingConfiguration packageTestsUsing: manifest = (
	(* Runs the block library (EmmanuelBlocks) against the specification's
library regressions. From tool/:
  ./run-tests.sh EmmanuelLibraryConformanceTestingConfiguration ../Emmanuel.ns ../EmmanuelTesting.ns ../EmmanuelBlocks.ns ../EmmanuelLibraryConformanceTesting.ns

The tests run headless, where the platform has no GUI. The library is built
on a stub platform with the real collections and kernel; its Hopscotch and
JavaScript are stubs, which the tests never use, since they look at trees
and never render them. *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelBlocks = manifest EmmanuelBlocks.
		private EmmanuelTesting = manifest EmmanuelTesting.
		private EmmanuelLibraryConformanceTesting = manifest EmmanuelLibraryConformanceTesting.
	|
) (
	class Stub new = (
		(* Answers itself to every message. *)
		
	) (
		public doesNotUnderstand: message = (
			^self
		)
	) : ()
	class StubPlatform realPlatform: real = (
		(* The real collections and kernel; anything else is a Stub. *)
		
		|
			private realPlatform = real.
			private stub = Stub new.
		|
	) (
		public collections = (
			^realPlatform collections
		)
		public doesNotUnderstand: message = (
			^stub
		)
		public kernel = (
			^realPlatform kernel
		)
	) : ()
	public testModulesUsingPlatform: p minitest: m = (
		| emmanuel = Emmanuel usingPlatform: p. |
		^{EmmanuelLibraryConformanceTesting usingPlatform: p
			minitest: m
			testing: (EmmanuelTesting usingPlatform: p emmanuel: emmanuel)
			blocks: (EmmanuelBlocks usingPlatform: (StubPlatform realPlatform: p)
				emmanuel: emmanuel). }
	)
) : ()
