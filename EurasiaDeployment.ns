Newspeak3
'Eurasia'
class EurasiaDeployment usingPlatform: platform = (
	(* Applications as Eurasia images, from their sources (EURASIA_BUILD_AND_DEPLOY_DESIGN_2026-11-21.md, sections 2.2 and 2.3): application descriptions, platform definitions and the entry each application's genesis image is built around. Where the sources come from is a provider's business: EurasiaBuild's files on the command line, an IDE's classes in the IDE (DeploymentManager); see Builder. The packager (EurasiaPackager) then makes the genesis image from the entry and the modules' sources. *)
	
	|
		private List = platform collections List.
		private Map = platform collections Map.
		private mirrors = platform mirrors.
	|
) (
	class Application named: n main: path platform: definition modules: extras sources: provider = (
		(* An application (design section 2.2), given unambiguously by its main module (a reference the source provider gives): a psoup application (packageUsing: manifest, main: platform args:) with a platform definition. Its modules are those its main module names in manifest sends (manifest X: the module X, else the image resource X; manifest P X: platform P's module X, and for P = Eurasia, the platform the application runs on, its own module X), and the extra modules the build list gives (for a module that the main module hands its manifest to). Within an application a manifest name answers one module; the packager refuses a module named like a kernel class. *)
		
		|
			public name = n.
			private mainPath = path.
			public platformDefinition = definition.
			private extraPaths = extras.
			private mainClass
			private modulesFound
			private foreign
			private images
			private allModules
			private foreignPlatforms = Map new.
			private kernelSlots
			private absent
			private unresolved
			private sources = provider.
		|
		scan.
	) (
		public absentModules ^<List[String]> = (
			(* What the application's manifest answers nil for: modules carrying primitives, with no Eurasia fork (P X for platform P's). *)
			
			| all |
			all:: List new.
			absent do: [:n | all add: n ].
			foreign do: [:f | (f at: 6) ifTrue: [ all add: (f at: 1) , ' ' , (f at: 2) ] ].
			^all
		)
		borrowed ^<Array[String]> = (
			(* Modules of psoup's platform that Eurasia uses as its own: they fill the slot PrimordialSoupX, and the manifest's X answers them. *)
			
			^{'Collections'. }
		)
		carriesPrimitives: module <String> ^<Boolean> = (
			(* Whether the module's source carries a psoup primitive pragma. Such a module is absent from the application (its manifest answers nil for it, as a JS deployment's does): no module Eurasia runs carries a primitive, and one that Eurasia needs has a fork without them (EURASIA_BUILD_AND_DEPLOY_DESIGN_2026-11-21.md, section 6). *)
			
			^carriesPrimitivePragma: (sources source: module)
		)
		public entrySource ^<String> = (
			| slots lookups platformLookups imageChecks |
			slots:: List new.
			allModules do: [:m | slots add: tab , tab , (m at: 1) ].
			foreign do: [:f | (f at: 4) ifTrue: [ slots add: tab , tab , (f at: 5) ] ].
			kernelSlots do: [:k | slots add: tab , tab , k ].
			lookups:: List new.
			modulesFound do: [:m |
					lookups add: tab , tab , tab , '''' , (m at: 1) , ''' = name ifTrue: [ ^outer EurasiaEntry ' , (m at: 1) , ' ].'
				].
			absent asArray , unresolved asArray do: [:n |
					lookups add: tab , tab , tab , '''' , n , ''' = name ifTrue: [ ^nil ].'
				].
			borrowed do: [:n |
					lookups add: tab , tab , tab , '''' , n , ''' = name ifTrue: [ ^outer EurasiaEntry PrimordialSoup' , n , ' ].'
				].
			platformNames do: [:p |
					lookups add: tab , tab , tab , '''' , p , ''' = name ifTrue: [ ^PlatformManifest named: ''' , p , ''' ].'
				].
			platformLookups:: List new.
			foreign do: [:f |
					platformLookups add: tab , tab , tab , '(''' , (f at: 1) , ''' = platform and: [ ''' , (f at: 2) , ''' = name ]) ifTrue: [ ^' , ((f at: 6) ifTrue: [
								'nil'
							]
							ifFalse: [ 'outer EurasiaEntry ' , (f at: 5) ]) , ' ].'
				].
			imageChecks:: joined: (images collect: [:n | '''' , n , '''.' ]) with: ' '.
			^'Newspeak3
''Eurasia''
class EurasiaEntry usingPlatform: platform = (
	(' , '* ' , mainClass , ' on Eurasia, ' , platformDefinition description , ': the entry of the application ' , name , ', generated by EurasiaDeployment (newspeak/EurasiaDeployment.ns). The genesis packager packages it as a top-level class and fills the module slots below; genesis builds the platform (platformOver:). main:args: starts ' , mainClass , ' with a manifest answering its modules by name, and its image resources as the files a page serves. *' , ')

	|
' , (joined: slots
				with: nl) , '
		internalKernel
	|
) (
	class Manifest new = (
		(' , '* The application''s manifest: its modules by name, and its image resources as file names. *' , ')

	) (
		doesNotUnderstand: message = (
			| name = message selector. |
' , (joined: lookups
				with: nl) , '
			({' , imageChecks , ' } includes: name) ifTrue: [ ^name , ''.png'' ].
			^super doesNotUnderstand: message
		)
	) : ()
	class PlatformManifest named: p = (
		(' , '* Another platform''s modules, manifest P X: the slot named PX. *' , ')

		|
			platform = p.
		|
	) (
		doesNotUnderstand: message = (
			| name = message selector. |
' , (joined: platformLookups
				with: nl) , '
			^super doesNotUnderstand: message
		)
	) : ()
	public main: platform args: args = (
		^(' , mainClass , ' packageUsing: Manifest new) main: platform args: args
	)
	public platformOver: ik = (
		| base reflective |
		internalKernel:: ik.
' , platformDefinition platformOverSource , '
	)
) : ()
'
		)
		public imageResources ^<List[String]> = (
			(* The image resources a page must serve for it (X as X.png): those its manifest answers as file names, and its platform's own. *)
			
			| all |
			all:: List new.
			images asArray , platformDefinition images asArray do: [:n |
					(all includes: n) ifFalse: [ all add: n ]
				].
			^all
		)
		public keepsSources ^<Boolean> = (
			^platformDefinition keepsSources
		)
		moduleFileNamed: n <String> ^<String | Nil> = (
			(* The module of manifest X: Eurasia's own (its fork, platform/Eurasia/X), else the provider's (the newspeak checkout's, else psoup's), or nil. *)
			
			^(sources module: n ofPlatform: ownPlatform) ifNil: [ sources module: n ]
		)
		public modulePaths ^<List[String]> = (
			(* The modules to package: the platform's, the application's (with Eurasia's own that it names), then the other platforms' modules. *)
			
			| paths |
			paths:: List new.
			allModules do: [:m | paths add: (m at: 2) ].
			foreign do: [:f | (f at: 4) ifTrue: [ paths add: (f at: 3) ] ].
			^paths
		)
		public moduleSlots ^<List[{String. String}]> = (
			(* The entry's module slots, each with the module it holds: {slot. reference}. A deployment from live classes (an IDE on Eurasia) fills the entry's slots from them, as the packager does from the modules it compiles; the slot InternalKernel holds the kernel's class, which the provider answers as Eurasia's module InternalKernel. *)
			
			| all |
			all:: List new.
			allModules do: [:m | all add: {m at: 1. m at: 2. } ].
			foreign do: [:f | (f at: 4) ifTrue: [ all add: {f at: 5. f at: 3. } ] ].
			kernelSlots do: [:k | all add: {k. platformFile: ownPlatform named: k. } ].
			^all
		)
		ownPlatform ^<String> = (
			(* The platform the application runs on: its modules are the application's own, not another platform's. *)
			
			^'Eurasia'
		)
		platformFile: p <String> named: n <String> ^<String | Nil> = (
			^sources module: n ofPlatform: p
		)
		platformNames ^<List[String]> = (
			| names |
			names:: List new.
			foreignPlatforms keys do: [:p | names add: p ].
			^sorted: names
		)
		scan = (
			| main names slotNames toScan scanned kept ownModules |
			absent:: List new.
			unresolved:: List new.
			main:: sources source: mainPath.
			mainClass:: classNameIn: main.
			foreignPlatforms at: 'PrimordialSoup' put: (List withAll: borrowed).
			names:: List new.
			
			(* The sources whose manifest sends count: the main module's, the extra modules', and those of the modules a scanned source hands its manifest to (manifest X packageUsing: manifest), transitively. *)
			toScan:: List new.
			toScan add: main.
			extraPaths do: [:p | toScan add: (sources source: p) ].
			scanned:: 0.
			[ scanned < toScan size ] whileTrue: [
					| source |
					scanned:: scanned + 1.
					source:: toScan at: scanned.
					
					(* manifest P X: platform P's module X, if there is one; if not, and P and X read as names (capitalized), the module is absent (answered nil), as an IDE whose Root lacks the modules left out of it sees psoup's. *)
					(manifestPairsIn: source) do: [:pair |
							((nil = (platformFile: (pair at: 1) named: (pair at: 2))) not or: [
									(isCapitalized: (pair at: 1)) and: [ isCapitalized: (pair at: 2) ]
								]) ifTrue: [
									| list = foreignPlatforms at: (pair at: 1) ifAbsentPut: [ List new ]. |
									(list includes: (pair at: 2)) ifFalse: [ list add: (pair at: 2) ]
								]
						].
					(manifestNamesIn: source) do: [:n |
							(names includes: n) ifFalse: [
									names add: n.
									(source indexOf: 'manifest ' , n , ' packageUsing: manifest') > 0 ifTrue: [
											nil = (moduleFileNamed: n) ifFalse: [
													toScan add: (sources source: (moduleFileNamed: n))
												]
										]
								]
						]
				].
			kept:: List new.
			names do: [:n | (foreignPlatforms includesKey: n) ifFalse: [ kept add: n ] ].
			names:: kept.
			modulesFound:: List new.
			images:: List new.
			
			(* A borrowed module (Collections) is the platform's, which the manifest answers (borrowed): never a module of the application's own, though an IDE's Root holds it under that name. *)
			(sorted: names) do: [:n |
					| module = (borrowed includes: n) ifTrue: [ nil ]
						ifFalse: [ moduleFileNamed: n ]. |
					nil = module ifTrue: [
							(sources hasImage: n) ifTrue: [ images add: n ]
								ifFalse: [
									((isCapitalized: n) and: [ (borrowed includes: n) not ]) ifTrue: [
											unresolved add: n
										]
								]
						]
						ifFalse: [
							(carriesPrimitives: module) ifTrue: [ absent add: n ]
								ifFalse: [ modulesFound add: {n. module. } ]
						]
				].
			extraPaths do: [:p |
					| c = classNameIn: (sources source: p). |
					((modulesFound asArray collect: [:m | m at: 1 ]) includes: c) ifFalse: [
							modulesFound add: {c. p. }
						]
				].
			
			(* Eurasia's own modules the application names (manifest Eurasia X): the slot X, shared with the platform definition's, so that a module of the platform is packaged once. InternalKernel is the image's own kernel, which the packager puts in the slot InternalKernel: it is not packaged again as a module. *)
			ownModules:: List new.
			(foreignPlatforms at: ownPlatform ifAbsent: [ {} ]) do: [:n |
					n = 'InternalKernel' ifFalse: [
							ownModules add: {n. platformFile: ownPlatform named: n. }
						]
				].
			slotNames:: List new.
			kernelSlots:: List new.
			((foreignPlatforms at: ownPlatform ifAbsent: [ {} ]) includes: 'InternalKernel') ifTrue: [
					slotNames add: 'InternalKernel'.
					kernelSlots add: 'InternalKernel'
				].
			allModules:: List new.
			platformDefinition modules , modulesFound asArray , ownModules asArray , {{mainClass. mainPath. }. } do: [:m |
					(slotNames includes: (m at: 1)) ifFalse: [
							slotNames add: (m at: 1).
							allModules add: m
						]
				].
			
			(* Each other platform's module: {platform. name. module. whether it needs its own slot. its slot}; one that already has a slot (the platform definition's PrimordialSoupCollections; Eurasia's own) keeps it, and the manifest still answers it. *)
			foreign:: List new.
			platformNames do: [:p |
					(sorted: (foreignPlatforms at: p)) do: [:n |
							| slot = p = ownPlatform ifTrue: [ n ] ifFalse: [ p , n ]. module = platformFile: p
								named: n. missing |
							missing:: (slotNames includes: slot) not and: [
									nil = module or: [ carriesPrimitives: module ]
								].
							foreign add: {p. n. module. (slotNames includes: slot) not and: [
										missing not
									]. slot. missing. }
						]
				]
		)
		public unresolvedNames ^<List[String]> = (
			(* Module names (capitalized) the application's manifest sends ask for that are neither a module nor an image resource where the sources come from: the manifest answers nil for them, as for an absent module, since an IDE's Root lacks the modules left out of it (WebCompiler), so that an application built from an IDE's sources and one built from the files answer alike. Other words (a comment's) answer nothing. A borrowed module (Collections) is answered by its own lookup. *)
			
			^unresolved
		)
	) : ()
	public class Builder over: provider = (
		(* What a build list, or an IDE, builds applications with: platform definitions and applications, over a source provider (the build's files; an IDE's classes). The provider answers a module's reference by name (module:, newspeakModule:, psoupModule:, module:ofPlatform:, buildInfo; nil if it has none), its source (source:), and whether a name is an image resource (hasImage:); a reference is a path, or reads like one: a module of platform P has platform/P/ in it. *)
		
		|
			private definitions = Map new.
			private sources = provider.
		|
	) (
		public application: path <String> platform: definition <PlatformDefinition> modules: extras <Array[String]> named: name <String> = (
			^Application named: name
				main: path
				platform: definition
				modules: extras
				sources: sources
		)
		public application: path <String> platform: definition <PlatformDefinition> named: name <String> = (
			^Application named: name
				main: path
				platform: definition
				modules: {}
				sources: sources
		)
		public base ^<PlatformDefinition> = (
			(* Eurasia's base platform (Runtime): no mirrors, no sources. *)
			
			^definitions at: #base
				ifAbsentPut: [
					PlatformDefinition describedAs: 'with Eurasia''s base platform'
						modules: baseModules
						sourcesFrom: (eurasia: 'Runtime')
						in: sources
						platformOver: tab , tab , '^(Runtime kernel: Kernel
			collections: PrimordialSoupCollections
			actors: Actors) Platform internalKernel: ik'
				]
		)
		baseModules ^<Array[{String. String}]> = (
			^{{'Kernel'. sources psoupModule: 'Kernel'. }. {'PrimordialSoupCollections'. sources module: 'Collections'
				ofPlatform: 'PrimordialSoup'. }. {'Actors'. eurasia: 'Actors'. }. {'Runtime'. eurasia: 'Runtime'. }. }
		)
		eurasia: moduleName <String> ^<String> = (
			^sources module: moduleName ofPlatform: 'Eurasia'
		)
		hopscotchModules ^<Array[{String. String}]> = (
			^{'Ducts'. 'GraphicsForHTML5'. 'FontsForHTML5'. 'TextModule'. 'HopscotchForHTML5'. 'VoiceController'. 'AIAccess'. } collect: [:n |
					{n. sources newspeakModule: n. }
				]
		)
		mirrorModules ^<Array[{String. String}]> = (
			^{{'Mirrors'. eurasia: 'Mirrors'. }. {'RuntimeWithMirrors'. eurasia: 'RuntimeWithMirrors'. }. {'NewspeakASTs'. sources psoupModule: 'NewspeakASTs'. }. {'NewspeakPredictiveParsing'. sources psoupModule: 'NewspeakPredictiveParsing'. }. {'IntermediatesForPrimordialSoup'. sources psoupModule: 'IntermediatesForPrimordialSoup'. }. {'NewspeakCompilation'. sources psoupModule: 'NewspeakCompilation'. }. {'NewspeakBytecodeCompilation'. sources psoupModule: 'NewspeakBytecodeCompilation'. }. {'Newspeak2V5BytecodeCompilation'. sources newspeakModule: 'Newspeak2V5BytecodeCompilation'. }. {'MetadataParsing'. sources psoupModule: 'MetadataParsing'. }. }
		)
		public newspeak: path <String> ^<String> = (
			(* A module of the newspeak checkout, by its file: X.ns. *)
			
			^sources newspeakFile: path
		)
		public primordialsoup: path <String> ^<String> = (
			(* A module of the primordialsoup checkout, by its file: newspeak/X.ns. *)
			
			^sources primordialsoupFile: path
		)
		public withHopscotch ^<PlatformDefinition> = (
			(* The base platform with Hopscotch (WebRuntime): no mirrors, no sources. *)
			
			^definitions at: #withHopscotch
				ifAbsentPut: [
					(PlatformDefinition describedAs: 'with Eurasia''s base platform and Hopscotch'
						modules: baseModules , {{'WebRuntime'. eurasia: 'WebRuntime'. }. } , hopscotchModules
						sourcesFrom: (eurasia: 'Runtime')
						in: sources
						platformOver: tab , tab , 'base:: (Runtime kernel: Kernel
			collections: PrimordialSoupCollections
			actors: Actors) Platform internalKernel: ik.
		^(WebRuntime internalKernel: nil
			hopscotch: HopscotchForHTML5
			ducts: Ducts
			graphics: GraphicsForHTML5
			fonts: FontsForHTML5
			text: TextModule
			voiceController: VoiceController
			aiAccess: AIAccess) Platform over: base') imagesFrom: (eurasia: 'WebRuntime')
				]
		)
		public withMirrors ^<PlatformDefinition> = (
			(* The base platform with mirrors (RuntimeWithMirrors) and the compiler they build: sources kept. *)
			
			^definitions at: #withMirrors
				ifAbsentPut: [
					PlatformDefinition describedAs: 'with Eurasia''s base platform and mirrors'
						modules: baseModules , mirrorModules
						sourcesFrom: (eurasia: 'RuntimeWithMirrors')
						in: sources
						platformOver: tab , tab , 'base:: (Runtime kernel: Kernel
			collections: PrimordialSoupCollections
			actors: Actors) Platform internalKernel: ik.
		^(RuntimeWithMirrors mirrors: Mirrors
			asts: NewspeakASTs
			parsing: NewspeakPredictiveParsing
			intermediates: IntermediatesForPrimordialSoup
			compilation: (Newspeak2V5BytecodeCompilation mixinApply: (NewspeakBytecodeCompilation mixinApply: NewspeakCompilation))
			metadataParsing: MetadataParsing) Platform over: base
			internalKernel: ik'
				]
		)
		public withMirrorsAndHopscotch ^<PlatformDefinition> = (
			(* The IDE's platform: the base platform with mirrors and Hopscotch, the build's stamp (BuildInfo) and the host services (Host): sources kept. *)
			
			^definitions at: #withMirrorsAndHopscotch
				ifAbsentPut: [
					(PlatformDefinition describedAs: 'with Eurasia''s base platform, mirrors and Hopscotch'
						modules: baseModules , mirrorModules , {{'WebRuntime'. eurasia: 'WebRuntime'. }. } , hopscotchModules , {{'BuildInfo'. sources buildInfo. }. {'Host'. sources psoupModule: 'Host'. }. }
						sourcesFrom: (eurasia: 'RuntimeWithMirrors')
						in: sources
						platformOver: tab , tab , 'base:: (Runtime kernel: Kernel
			collections: PrimordialSoupCollections
			actors: Actors) Platform internalKernel: ik.
		reflective:: (RuntimeWithMirrors mirrors: Mirrors
			asts: NewspeakASTs
			parsing: NewspeakPredictiveParsing
			intermediates: IntermediatesForPrimordialSoup
			compilation: (Newspeak2V5BytecodeCompilation mixinApply: (NewspeakBytecodeCompilation mixinApply: NewspeakCompilation))
			metadataParsing: MetadataParsing) Platform over: base internalKernel: ik.
		^((WebRuntime internalKernel: (reflective mirrors ObjectMirror reflecting: ik) getClass reflectee
			hopscotch: HopscotchForHTML5
			ducts: Ducts
			graphics: GraphicsForHTML5
			fonts: FontsForHTML5
			text: TextModule
			voiceController: VoiceController
			aiAccess: AIAccess) Platform over: reflective) buildInfo: BuildInfo;
			hostModule: Host;
			yourself') imagesFrom: (eurasia: 'WebRuntime')
				]
		)
	) : ()
	class PlatformDefinition describedAs: d <String> modules: ms <Array[{String. String}]> sourcesFrom: runtimeModule <String> in: provider platformOver: body <String> = (
		(* A platform an application runs on (design section 2.2): its modules (slot name and file, in packaging order), the source of the entry's platformOver: body (over the internal kernel ik), and the runtime module whose class says whether images keep their methods' sources (keepsSources: sources follow mirrors). A new platform is a new definition. *)
		
		|
			public description = d.
			public modules = ms.
			private sourcesModule = runtimeModule.
			private sources = provider.
			public platformOverSource = body.
			private keepsSourcesAnswer
			private imagesModule
		|
	) (
		public images ^<List[String]> = (
			(* The image resources the platform itself loads, which a page must serve: those its imagesModule (Hopscotch's WebRuntime) resolves (resolveImage: 'X.png'), from that module's source; none without one. *)
			
			| source images marker i |
			images:: List new.
			nil = imagesModule ifTrue: [ ^images ].
			source:: sources source: imagesModule.
			marker:: 'resolveImage: '''.
			i:: 1.
			[ (i:: source indexOf: marker startingAt: i) > 0 ] whileTrue: [
					| name = identifierIn: source at: i + marker size. |
					(name isEmpty or: [ images includes: name ]) ifFalse: [ images add: name ].
					i:: i + marker size
				].
			^images
		)
		public imagesFrom: module <String> = (
			(* Says which module's source lists the images the platform loads (images). *)
			
			imagesModule:: module
		)
		public keepsSources ^<Boolean> = (
			(* The runtime module's class's answer, from the module being built: compiled here, not instantiated. *)
			
			nil = keepsSourcesAnswer ifTrue: [
					keepsSourcesAnswer:: (classFromSource: (sources source: sourcesModule)) keepsSources
				].
			^keepsSourcesAnswer
		)
		public runtimeModule ^<String> = (
			(* The runtime module, whose class says whether images keep sources (keepsSources); a deployment from live classes asks that class itself. *)
			
			^sourcesModule
		)
	) : ()
	carriesPrimitivePragma: source <String> ^<Boolean> = (
		(* Whether source has a psoup primitive pragma: a comment, outside string literals, that begins :literalmessage: primitive:. Text that only mentions one, in a string (a test's input, generated psoup source), is not one. *)
		
		| marker i n |
		marker:: ' :literalmessage: primitive: '.
		(source indexOf: marker startingAt: 1) = 0 ifTrue: [ ^false ].
		n:: source size.
		i:: 1.
		[ i <= n ] whileTrue: [
				| c = source at: i. |
				c = 39 ifTrue: [
						
						(* A string literal: to its closing quote; a doubled quote is part of it. *)
						i:: i + 1.
						[
							i <= n and: [
									((source at: i) = 39 and: [
											i = n or: [ ((source at: i + 1) = 39) not ]
										]) not
								]
						] whileTrue: [
								i:: (source at: i) = 39 ifTrue: [ i + 2 ] ifFalse: [ i + 1 ]
							].
						i:: i + 1
					]
					ifFalse: [
						(c = 40 and: [ i < n and: [ (source at: i + 1) = 42 ] ]) ifTrue: [
								
								(* A comment: a pragma if it begins with the marker; else skipped to its end. *)
								(source copyFrom: i + 2 to: (i + 1 + marker size min: n)) = marker ifTrue: [
										^true
									].
								i:: source indexOf: '*' , ')' startingAt: i + 2.
								i = 0 ifTrue: [ ^false ].
								i:: i + 2
							]
							ifFalse: [ i:: i + 1 ]
					]
			].
		^false
	)
	public classFromSource: unit <String> = (
		(* The top-level class that a module's source declares, compiled through the mirrors and installed, not instantiated: its declaration, after the unit's header (the language and category lines). *)
		
		^(mirrors ClassDeclarationBuilder fromSource: (unit copyFrom: (unit indexOf: nl , 'class ') + 1
				to: unit size)) install applyToObject reflectee
	)
	classNameIn: source <String> ^<String> = (
		(* The name after the first word class in source: tool-image.py's class_name. *)
		
		| i start |
		i:: 1.
		[ (i:: source indexOf: 'class' startingAt: i) > 0 ] whileTrue: [
				((i = 1 or: [ (isWordByte: (source at: i - 1)) not ]) and: [
						i + 5 <= source size and: [ isSpace: (source at: i + 5) ]
					]) ifTrue: [
						start:: i + 5.
						[ start <= source size and: [ isSpace: (source at: start) ] ] whileTrue: [
								start:: start + 1
							].
						(start <= source size and: [ isIdentifierStart: (source at: start) ]) ifTrue: [
								^identifierIn: source at: start
							]
					].
				i:: i + 1
			].
		^Error signal: 'no class in source'
	)
	identifierIn: source <String> at: start <Integer> ^<String> = (
		| stop |
		stop:: start.
		[ stop <= source size and: [ isWordByte: (source at: stop) ] ] whileTrue: [
				stop:: stop + 1
			].
		^source copyFrom: start to: stop - 1
	)
	isCapitalized: name <String> ^<Boolean> = (
		(* Whether name reads as a module's (or platform's) name: it starts with a capital letter. *)
		
		^name isEmpty not and: [ (name at: 1) between: 65 and: 90 ]
	)
	isIdentifierStart: b <Integer> ^<Boolean> = (
		^(b >= 65 and: [ b <= 90 ]) or: [ (b >= 97 and: [ b <= 122 ]) or: [ b = 95 ] ]
	)
	isSpace: b <Integer> ^<Boolean> = (
		^b = 32 or: [
				b = 9 or: [ b = 10 or: [ b = 13 or: [ b = 12 or: [ b = 11 ] ] ] ]
			]
	)
	isWordByte: b <Integer> ^<Boolean> = (
		^(isIdentifierStart: b) or: [ b >= 48 and: [ b <= 57 ] ]
	)
	joined: strings with: separator <String> ^<String> = (
		| result |
		result:: ''.
		strings do: [:s |
				result isEmpty ifFalse: [ result:: result , separator ].
				result:: result , s
			].
		^result
	)
	manifestNamesIn: source <String> ^<List[String]> = (
		(* Each X of source's 'manifest X', in order: generate-ide-entry.py's findall of manifest ([A-Za-z_0-9]+). *)
		
		| names i |
		names:: List new.
		i:: 1.
		[ (i:: source indexOf: 'manifest ' startingAt: i) > 0 ] whileTrue: [
				| x = identifierIn: source at: i + 9. |
				x isEmpty ifFalse: [ names add: x ].
				i:: i + 9 + x size
			].
		^names
	)
	manifestPairsIn: source <String> ^<List[{String. String}]> = (
		(* Each {P. X} of source's 'manifest P X', in order: generate-ide-entry.py's findall of manifest ([A-Za-z_0-9]+) ([A-Za-z_0-9]+). *)
		
		| pairs i |
		pairs:: List new.
		i:: 1.
		[ (i:: source indexOf: 'manifest ' startingAt: i) > 0 ] whileTrue: [
				| p x j |
				p:: identifierIn: source at: i + 9.
				j:: i + 9 + p size.
				(p isEmpty not and: [ j <= source size and: [ (source at: j) = 32 ] ]) ifTrue: [
						x:: identifierIn: source at: j + 1.
						x isEmpty ifTrue: [ i:: i + 1 ]
							ifFalse: [
								pairs add: {p. x. }.
								i:: j + 1 + x size
							]
					]
					ifFalse: [ i:: i + 1 ]
			].
		^pairs
	)
	nl ^<String> = (
		^String with: 10
	)
	precedes: a <String> or: b <String> ^<Boolean> = (
		(* a <= b by bytes, as Python sorts strings. *)
		
		1 to: (a size min: b size)
			do: [:i | (a at: i) = (b at: i) ifFalse: [ ^(a at: i) < (b at: i) ] ].
		^a size <= b size
	)
	sorted: strings ^<List[String]> = (
		| list |
		list:: List new.
		strings do: [:s | list add: s ].
		list sort: [:a :b | precedes: a or: b ].
		^list
	)
	tab ^<String> = (
		^String with: 9
	)
) : ()
