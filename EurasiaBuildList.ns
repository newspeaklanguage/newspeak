Newspeak3
'Eurasia'
class EurasiaBuildList new = (
	(* The applications eurasia/scripts/build.sh builds (EurasiaBuild; EURASIA_BUILD_AND_DEPLOY_DESIGN_2026-11-21.md, section 3.2): the IDE, psoup's command-line tools (their Eurasia forks, without psoup's primitives: eurasia/kernel/fork-apps.py), and two Hopscotch demos. Each is its main module's file and a platform definition; its modules are found from its main module's manifest sends (EurasiaBuild's Application). *)
	
) (
	public applicationsFor: build = (
		^{build application: (build newspeak: 'HopscotchWebIDE.ns')
			platform: build withMirrorsAndHopscotch
			named: 'ide'. build application: (build newspeak: 'platform/Eurasia/NewspeakParser.ns')
			platform: build withMirrors
			named: 'parser'. build application: (build newspeak: 'platform/Eurasia/NewspeakPrettyPrintApp.ns')
			platform: build withMirrors
			named: 'prettyprinter'. build application: (build newspeak: 'platform/Eurasia/NewspeakRoundTripCheckApp.ns')
			platform: build withMirrors
			named: 'roundtrip'. build application: (build newspeak: 'platform/Eurasia/NewspeakAttachmentDiffApp.ns')
			platform: build withMirrors
			named: 'attachmentdiff'. build application: (build newspeak: 'platform/Eurasia/NewspeakTestRunner.ns')
			platform: build withMirrors
			named: 'testrunner'. build application: (build newspeak: 'CounterApp.ns')
			platform: build withHopscotch
			named: 'counter'. build application: (build newspeak: 'TodoMVCApp.ns')
			platform: build withHopscotch
			named: 'todomvc'. }
	)
) : ()
