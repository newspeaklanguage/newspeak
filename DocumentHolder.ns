Newspeak3
'Newspeak'
class DocumentHolder usingDocumentClass: dc <Document class> ide: webIDE
(* :exemplar: ide documentHolder *)
 = (
	|
		Document <Document class> = dc.
		ide = webIDE.
	|
) (
	public EmmanuelDocument = (
		(* The superclass of the class of an Emmanuel document: see
	Documents>>createDocumentSubclassNamed:body:superclass:. *)
		
		^ide documents emmanuel EmmanuelDocument
	)
) : ()
