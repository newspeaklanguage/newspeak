import Newspeak.SequentialInitialization

namespace Newspeak

namespace Program

/-- Equation (10.17): top-level code has no enclosing object; every other
    activation encloses an object literal by its activation object. -/
def objectLiteralEnclosingObject (p : Program) (h : Heap)
    (activation : ActivationId) : Option ObjRef := do
  let activationDef ← h.activations activation
  match activationDef.provenance with
  | .top => some p.nilObject
  | .method _ | .closure _ | .initializer _ =>
      some (.activationObject activation)

def objectLiteralFactory (descriptor : ObjectLiteralDescriptor)
    (mixin : MixinDef) : FactoryDef :=
  { activationDeclaration := descriptor.initializerDeclaration
    selector := mixin.initializerSelector
    parameters := []
    plan := .body descriptor.superclassMessage }

def objectLiteralNewMessage (mixin : MixinDef) : Message :=
  ⟨mixin.initializerSelector, []⟩

/-- Static evidence generated by elaboration for the synthetic class-side
    factory of an object literal.  In particular, the installed method body
    contains parameter identities, not runtime argument objects. -/
structure ObjectLiteralFactoryImplementation (p : Program)
    (descriptor : ObjectLiteralDescriptor) (instanceMixin : MixinDef) where
  classMixin : MixinDef
  method : MethodDef
  classMixinFound : p.mixins descriptor.classMixin = some classMixin
  methodFound : classMixin.methods instanceMixin.initializerSelector =
    some method
  selectorMatches : method.selector = instanceMixin.initializerSelector
  accessPublic : method.access = .publicAccess
  parametersEmpty : method.parameters = []
  ownerMatches : method.owner = .objectLiteral descriptor.declaration
  localsEmpty : p.methodLocals method.identity = []
  bodyInstalled : p.methodBodies method.identity =
    some [.return (.newInstanceCurrent instanceMixin.initializerSelector [])]

/-- The class object allocated for an object literal reaches its synthesized
    primary factory through ordinary public lookup. -/
theorem allocatedObjectLiteral_dispatchesToPrimaryFactory (p : Program)
    (state : AllocationState) (descriptor : ObjectLiteralDescriptor)
    (instanceMixin : MixinDef) (superclass : ClassId)
    (enclosingObject : ObjRef) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack)
    (implementation :
      ObjectLiteralFactoryImplementation p descriptor instanceMixin)
    (allocationWellFormed : p.WellFormed
      (p.allocateClassPair state
        (.expression (.objectLiteral descriptor.declaration))
        descriptor.instanceMixin descriptor.classMixin superclass
        enclosingObject (objectLiteralFactory descriptor instanceMixin)).1.heap) :
    let allocation := p.allocateClassPair state
      (.expression (.objectLiteral descriptor.declaration))
      descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
      (objectLiteralFactory descriptor instanceMixin)
    p.RequestCompletionStep
      ⟨allocation.1, .push rest ⟨current, frames⟩,
        .dispatch (.ordinary (.classObject allocation.2.1))
          (objectLiteralNewMessage instanceMixin)⟩
      ⟨allocation.1, .push rest ⟨current, frames⟩,
        .invoke implementation.method (.classObject allocation.2.1)
          allocation.2.2 (objectLiteralNewMessage instanceMixin)⟩ := by
  let allocation := p.allocateClassPair state
    (.expression (.objectLiteral descriptor.declaration))
    descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
    (objectLiteralFactory descriptor instanceMixin)
  have installed := p.allocateClassPair_installs state
    (.expression (.objectLiteral descriptor.declaration))
    descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
    (objectLiteralFactory descriptor instanceMixin)
  have classInstalled : allocation.1.heap.classes allocation.2.1 = some
      { mixin := descriptor.instanceMixin
        superclass := superclass
        enclosingObject := enclosingObject
        metaclass := allocation.2.2
        origin := .expression (.objectLiteral descriptor.declaration)
        primaryFactory := some (objectLiteralFactory descriptor instanceMixin) } :=
    by simpa [allocation] using installed.1
  have metaclassInstalled : allocation.1.heap.classes allocation.2.2 = some
      { mixin := descriptor.classMixin
        superclass := p.classClass
        enclosingObject := enclosingObject
        metaclass := p.metaclassClass
        origin := .expression (.objectLiteral descriptor.declaration)
        primaryFactory := none } :=
    by simpa [allocation] using installed.2
  have metaclassNotTop : allocation.2.2 ≠ p.top := by
    intro equal
    have live : allocation.1.heap.classes allocation.2.2 ≠ none := by
      rw [metaclassInstalled]
      simp
    exact live (by simpa [equal] using allocationWellFormed.topHasNoClassRecord)
  have receiverClass : allocation.1.heap.classOf
      (.classObject allocation.2.1) = some allocation.2.2 := by
    simp [Heap.classOf, classInstalled]
  have directFactory : p.direct allocation.1.heap allocation.2.2
      instanceMixin.initializerSelector = some implementation.method := by
    simp [Program.direct, metaclassInstalled, implementation.classMixinFound,
      implementation.methodFound]
  have publicLookup : p.PublicLookupRules allocation.1.heap
      instanceMixin.initializerSelector allocation.2.2
      (some ⟨implementation.method, allocation.2.2⟩) :=
    .hit metaclassNotTop directFactory implementation.accessPublic
  have dispatch : p.OrdinaryDispatch allocation.1.heap
      (.classObject allocation.2.1) (objectLiteralNewMessage instanceMixin)
      (.invoke implementation.method (.classObject allocation.2.1)
        allocation.2.2 (objectLiteralNewMessage instanceMixin)) :=
    .hit receiverClass publicLookup
  have notClosure : ¬allocation.1.heap.ClosureCall
      (.classObject allocation.2.1) (objectLiteralNewMessage instanceMixin) := by
    rintro ⟨id, closure, impossible, live, selector, arity⟩
    cases impossible
  exact .invoke (.invoke (.ordinary notClosure dispatch))

/-- Object-Super, Object-Commit, and the two object-literal error rules. -/
inductive ObjectLiteralStep (p : Program) :
    SequentialConfig → SequentialConfig → Prop where
  | superclass {state : AllocationState} {rest : ActivationStack}
      {current : ActivationId} {frames : EvalStack}
      {declaration : ObjectLiteralDeclId} {superclassExpression : CoreExpr}
      {descriptor : ObjectLiteralDescriptor} {enclosingObject : ObjRef}
      (descriptorFound : p.objectLiterals declaration = some descriptor)
      (enclosingFound :
        p.objectLiteralEnclosingObject state.heap current = some enclosingObject) :
      ObjectLiteralStep p
        ⟨state, .push rest ⟨current, frames⟩,
          .evaluate (.objectLiteral declaration superclassExpression)⟩
        ⟨state, .push rest ⟨current,
          .push frames (.makeObjectLiteral descriptor enclosingObject)⟩,
          .evaluate superclassExpression⟩
  | commit {state : AllocationState} {rest : ActivationStack}
      {current : ActivationId} {frames : EvalStack}
      {descriptor : ObjectLiteralDescriptor} {enclosingObject : ObjRef}
      {superclass : ClassId} {mixin : MixinDef}
      {allocation : AllocationState × ClassId × ClassId}
      (inheritanceValid : inheritanceError state.heap (.classObject superclass)
        descriptor.superclassMessage = none)
      (topValid : p.validTopSuperclass enclosingObject
        descriptor.superclassSyntax superclass = true)
      (mixinFound : p.mixins descriptor.instanceMixin = some mixin)
      (initializerMatches : mixin.initializerDeclaration =
        descriptor.initializerDeclaration)
      (nullary : mixin.initializerParameters = [])
      (allocated : allocation = p.allocateClassPair state
        (.expression (.objectLiteral descriptor.declaration))
        descriptor.instanceMixin descriptor.classMixin superclass
        enclosingObject (objectLiteralFactory descriptor mixin))
      (allocationWellFormed : p.WellFormed allocation.1.heap) :
      ObjectLiteralStep p
        ⟨state, .push rest ⟨current,
          .push frames (.makeObjectLiteral descriptor enclosingObject)⟩,
          .object (.classObject superclass)⟩
        ⟨allocation.1, .push rest ⟨current, frames⟩,
          .dispatch (.ordinary (.classObject allocation.2.1))
            (objectLiteralNewMessage mixin)⟩
  | inheritanceError {state : AllocationState} {rest : ActivationStack}
      {current : ActivationId} {frames : EvalStack}
      {descriptor : ObjectLiteralDescriptor} {enclosingObject value : ObjRef}
      {error : RuntimeError}
      (invalid : inheritanceError state.heap value
        descriptor.superclassMessage = some error) :
      ObjectLiteralStep p
        ⟨state, .push rest ⟨current,
          .push frames (.makeObjectLiteral descriptor enclosingObject)⟩,
          .object value⟩
        ⟨state, .push rest ⟨current, frames⟩, .runtimeError error⟩
  | topSuperclassError {state : AllocationState} {rest : ActivationStack}
      {current : ActivationId} {frames : EvalStack}
      {descriptor : ObjectLiteralDescriptor} {superclass : ClassId}
      (inheritanceValid : inheritanceError state.heap (.classObject superclass)
        descriptor.superclassMessage = none)
      (topInvalid : p.validTopSuperclass p.nilObject
        descriptor.superclassSyntax superclass = false) :
      ObjectLiteralStep p
        ⟨state, .push rest ⟨current,
          .push frames (.makeObjectLiteral descriptor p.nilObject)⟩,
          .object (.classObject superclass)⟩
        ⟨state, .push rest ⟨current, frames⟩,
          .runtimeError .topSuperclass⟩

theorem objectLiteralStep_deterministic {p : Program}
    {before after₁ after₂ : SequentialConfig}
    (step₁ : p.ObjectLiteralStep before after₁)
    (step₂ : p.ObjectLiteralStep before after₂) : after₁ = after₂ := by
  cases step₁ with
  | superclass descriptor₁ enclosing₁ =>
      cases step₂ with
      | superclass descriptor₂ enclosing₂ =>
          have descriptorEqual := Option.some.inj
            (descriptor₁.symm.trans descriptor₂)
          subst descriptorEqual
          have enclosingEqual := Option.some.inj
            (enclosing₁.symm.trans enclosing₂)
          subst enclosingEqual
          rfl
  | commit valid₁ top₁ mixin₁ declaration₁ nullary₁ allocated₁ wf₁ =>
      cases step₂ with
      | commit valid₂ top₂ mixin₂ declaration₂ nullary₂ allocated₂ wf₂ =>
          have mixinEqual := Option.some.inj (mixin₁.symm.trans mixin₂)
          subst mixinEqual
          rw [allocated₁, allocated₂]
      | inheritanceError invalid₂ =>
          rw [valid₁] at invalid₂
          contradiction
      | topSuperclassError valid₂ top₂ =>
          rw [top₁] at top₂
          contradiction
  | inheritanceError invalid₁ =>
      cases step₂ with
      | commit valid₂ top₂ mixin₂ declaration₂ nullary₂ allocated₂ wf₂ =>
          rw [valid₂] at invalid₁
          contradiction
      | inheritanceError invalid₂ =>
          have errorEqual := Option.some.inj (invalid₁.symm.trans invalid₂)
          subst errorEqual
          rfl
      | topSuperclassError valid₂ top₂ =>
          rw [valid₂] at invalid₁
          contradiction
  | topSuperclassError valid₁ top₁ =>
      cases step₂ with
      | commit valid₂ top₂ mixin₂ declaration₂ nullary₂ allocated₂ wf₂ =>
          rw [top₂] at top₁
          contradiction
      | inheritanceError invalid₂ =>
          rw [valid₁] at invalid₂
          contradiction
      | topSuperclassError valid₂ top₂ => rfl

/-- `classWithEO`: force the receiver-local enclosing object for a normalized
    class body; a mixin application retains the source class's enclosing
    object and therefore ignores the forced value. -/
def evaluateNestedClassMiss (p : Program) (state : AllocationState)
    (rest : ActivationStack) (current : ActivationId) (frames : EvalStack)
    (object : ObjectId) (declaration : ClassDeclId)
    (classExpression : CoreExpr) : Option SequentialConfig :=
  match classExpression with
  | .classBody classDeclaration superclassExpression => do
      let descriptor ← p.classBodies classDeclaration
      some ⟨state, .push rest ⟨current,
        .push (.push frames (.nestedClassStore object declaration))
          (.makeClassBody descriptor (.ordinaryObject object))⟩,
        .evaluate superclassExpression⟩
  | .mixinApply _ _ _ =>
      some ⟨state, .push rest ⟨current,
        .push frames (.nestedClassStore object declaration)⟩,
        .evaluate classExpression⟩
  | _ => none

/-- Equation (10.14): a per-receiver, single-valued nested-class cache. -/
inductive NestedClassStep (p : Program) :
    SequentialConfig → SequentialConfig → Prop where
  | hit {state : AllocationState} {rest : ActivationStack}
      {current : ActivationId} {frames : EvalStack}
      {activation : ActivationDef} {object : ObjectId}
      {declaration : ClassDeclId} {classExpression : CoreExpr}
      {classId : ClassId}
      (currentActivation : state.heap.activations current = some activation)
      (receiver : activation.currentReceiver = .ordinaryObject object)
      (cached : state.heap.readNestedClass object declaration = some classId) :
      NestedClassStep p
        ⟨state, .push rest ⟨current, frames⟩,
          .evaluate (.nestedClass declaration classExpression)⟩
        ⟨state, .push rest ⟨current, frames⟩,
          .object (.classObject classId)⟩
  | miss {state : AllocationState} {rest : ActivationStack}
      {current : ActivationId} {frames : EvalStack}
      {activation : ActivationDef} {object : ObjectId}
      {declaration : ClassDeclId} {classExpression : CoreExpr}
      {after : SequentialConfig}
      (currentActivation : state.heap.activations current = some activation)
      (receiver : activation.currentReceiver = .ordinaryObject object)
      (absent : state.heap.readNestedClass object declaration = none)
      (next : p.evaluateNestedClassMiss state rest current frames object
        declaration classExpression = some after) :
      NestedClassStep p
        ⟨state, .push rest ⟨current, frames⟩,
          .evaluate (.nestedClass declaration classExpression)⟩ after
  | store {state : AllocationState} {rest : ActivationStack}
      {current : ActivationId} {frames : EvalStack} {object : ObjectId}
      {declaration : ClassDeclId} {classId : ClassId} {heap : Heap}
      (written : state.heap.writeNestedClass object declaration classId =
        some heap) :
      NestedClassStep p
        ⟨state, .push rest ⟨current,
          .push frames (.nestedClassStore object declaration)⟩,
          .object (.classObject classId)⟩
        ⟨{state with heap := heap}, .push rest ⟨current, frames⟩,
          .object (.classObject classId)⟩

theorem nestedClassStep_deterministic {p : Program}
    {before after₁ after₂ : SequentialConfig}
    (step₁ : p.NestedClassStep before after₁)
    (step₂ : p.NestedClassStep before after₂) : after₁ = after₂ := by
  cases step₁ with
  | hit activation₁ receiver₁ cached₁ =>
      cases step₂ with
      | hit activation₂ receiver₂ cached₂ =>
          have activationEqual := Option.some.inj
            (activation₁.symm.trans activation₂)
          subst activationEqual
          have objectEqual := ObjRef.ordinaryObject.inj
            (receiver₁.symm.trans receiver₂)
          subst objectEqual
          have equal := Option.some.inj (cached₁.symm.trans cached₂)
          subst equal
          rfl
      | miss activation₂ receiver₂ absent₂ next₂ =>
          have activationEqual := Option.some.inj
            (activation₁.symm.trans activation₂)
          subst activationEqual
          have objectEqual := ObjRef.ordinaryObject.inj
            (receiver₁.symm.trans receiver₂)
          subst objectEqual
          rw [absent₂] at cached₁
          contradiction
  | miss activation₁ receiver₁ absent₁ next₁ =>
      cases step₂ with
      | hit activation₂ receiver₂ cached₂ =>
          have activationEqual := Option.some.inj
            (activation₁.symm.trans activation₂)
          subst activationEqual
          have objectEqual := ObjRef.ordinaryObject.inj
            (receiver₁.symm.trans receiver₂)
          subst objectEqual
          rw [absent₁] at cached₂
          contradiction
      | miss activation₂ receiver₂ absent₂ next₂ =>
          have activationEqual := Option.some.inj
            (activation₁.symm.trans activation₂)
          subst activationEqual
          have objectEqual := ObjRef.ordinaryObject.inj
            (receiver₁.symm.trans receiver₂)
          subst objectEqual
          exact Option.some.inj (next₁.symm.trans next₂)
  | store written₁ =>
      cases step₂ with
      | store written₂ =>
          have equal := Option.some.inj (written₁.symm.trans written₂)
          subst equal
          rfl

theorem readNestedClass_singleValued {h : Heap} {object : ObjectId}
    {declaration : ClassDeclId} {left right : ClassId}
    (leftRead : h.readNestedClass object declaration = some left)
    (rightRead : h.readNestedClass object declaration = some right) :
    left = right :=
  Option.some.inj (leftRead.symm.trans rightRead)

theorem WellFormed.writeNestedClass_wellFormed {p : Program} {h h' : Heap}
    (wf : p.WellFormed h) {object : ObjectId} {declaration : ClassDeclId}
    {classId : ClassId}
    (write : h.writeNestedClass object declaration classId = some h') :
    p.WellFormed h' := by
  cases objectLive : h.objects object with
  | none => simp [Heap.writeNestedClass, objectLive] at write
  | some objectDef =>
      simp [Heap.writeNestedClass, objectLive] at write
      subst h'
      apply wf.installObject_wellFormed
      exact wf.objectClassesAreLive (.ordinaryObject object) objectDef.classId
        (by simp [Heap.classOf, objectLive])

theorem AllocationState.writeNestedClass_preserves_supplies
    {state : AllocationState} {heap : Heap} {object : ObjectId}
    {declaration : ClassDeclId} {classId : ClassId}
    (fresh : state.SuppliesFresh)
    (write : state.heap.writeNestedClass object declaration classId = some heap) :
    ({state with heap := heap} : AllocationState).SuppliesFresh := by
  cases objectLive : state.heap.objects object with
  | none => simp [Heap.writeNestedClass, objectLive] at write
  | some objectDef =>
      simp [Heap.writeNestedClass, objectLive] at write
      subst heap
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · intro id frontier
        exact fresh.1 id frontier
      · intro id frontier
        exact fresh.2.1 id frontier
      · intro id frontier
        exact fresh.2.2.1 id frontier
      · intro id frontier
        have away : id ≠ object := by
          intro equal
          subst id
          have absent := fresh.2.2.2.1 object frontier
          rw [objectLive] at absent
          contradiction
        simpa [Heap.installObject, away] using
          fresh.2.2.2.1 id frontier
      · intro id frontier
        exact fresh.2.2.2.2 id frontier

theorem Heap.writeNestedClass_retainsActivations {h h' : Heap}
    {object : ObjectId} {declaration : ClassDeclId} {classId : ClassId}
    (write : h.writeNestedClass object declaration classId = some h') :
    ∀ id activation, h.activations id = some activation →
      ∃ activation', h'.activations id = some activation' := by
  intro id activation live
  cases objectLive : h.objects object with
  | none => simp [Heap.writeNestedClass, objectLive] at write
  | some objectDef =>
      simp [Heap.writeNestedClass, objectLive] at write
      subst h'
      exact ⟨activation, live⟩

theorem objectLiteralStep_preserves_wellFormed {p : Program}
    {before after : SequentialConfig} (wf : SequentialWellFormed p before)
    (step : p.ObjectLiteralStep before after) :
    SequentialWellFormed p after := by
  cases step with
  | superclass =>
      exact ⟨wf.heap, wf.supplies, by simpa [StackLive] using wf.stack,
        trivial⟩
  | commit valid topValid mixin declarationMatches nullary allocated allocationWf =>
      refine ⟨allocationWf, ?_, ?_, trivial⟩
      · rw [allocated]
        exact allocateClassPair_preserves_supplies p wf.supplies _ _ _ _ _ _
      · rw [allocated]
        exact stackLive_transport wf.stack
          (allocateClassPair_retainsActivations p _ _ _ _ _ _ _)
  | inheritanceError =>
      exact ⟨wf.heap, wf.supplies, by simpa [StackLive] using wf.stack,
        trivial⟩
  | topSuperclassError =>
      exact ⟨wf.heap, wf.supplies, by simpa [StackLive] using wf.stack,
        trivial⟩

theorem nestedClassStep_preserves_wellFormed {p : Program}
    {before after : SequentialConfig} (wf : SequentialWellFormed p before)
    (step : p.NestedClassStep before after) :
    SequentialWellFormed p after := by
  cases step with
  | hit => exact ⟨wf.heap, wf.supplies, wf.stack, trivial⟩
  | @miss state rest current frames activation object declaration expression
      after currentActivation receiver absent next =>
      cases expression <;> simp [evaluateNestedClassMiss] at next
      all_goals
        try
          { subst after
            exact ⟨wf.heap, wf.supplies,
              by simpa [StackLive] using wf.stack, trivial⟩ }
      case classBody classDeclaration superclassExpression =>
        cases descriptorResult : p.classBodies classDeclaration with
        | none => simp [descriptorResult] at next
        | some descriptor =>
            simp [descriptorResult] at next
            subst after
            exact ⟨wf.heap, wf.supplies,
              by simpa [StackLive] using wf.stack, trivial⟩
  | store written =>
      refine ⟨wf.heap.writeNestedClass_wellFormed written,
        AllocationState.writeNestedClass_preserves_supplies wf.supplies written,
        ?_, trivial⟩
      exact stackLive_transport wf.stack
        (Heap.writeNestedClass_retainsActivations written)

inductive ObjectAndNestedClassStep (p : Program) :
    SequentialConfig → SequentialConfig → Prop where
  | objectLiteral {before after : SequentialConfig} :
      p.ObjectLiteralStep before after → p.ObjectAndNestedClassStep before after
  | nestedClass {before after : SequentialConfig} :
      p.NestedClassStep before after → p.ObjectAndNestedClassStep before after

theorem objectAndNestedClassStep_deterministic {p : Program}
    {before after₁ after₂ : SequentialConfig}
    (step₁ : p.ObjectAndNestedClassStep before after₁)
    (step₂ : p.ObjectAndNestedClassStep before after₂) : after₁ = after₂ := by
  cases step₁ with
  | objectLiteral object₁ =>
      cases step₂ with
      | objectLiteral object₂ =>
          exact objectLiteralStep_deterministic object₁ object₂
      | nestedClass nested₂ => cases object₁ <;> cases nested₂
  | nestedClass nested₁ =>
      cases step₂ with
      | objectLiteral object₂ => cases nested₁ <;> cases object₂
      | nestedClass nested₂ =>
          exact nestedClassStep_deterministic nested₁ nested₂

theorem objectAndNestedClassStep_preserves_wellFormed {p : Program}
    {before after : SequentialConfig} (wf : SequentialWellFormed p before)
    (step : p.ObjectAndNestedClassStep before after) :
    SequentialWellFormed p after := by
  cases step with
  | objectLiteral object => exact objectLiteralStep_preserves_wellFormed wf object
  | nestedClass nested => exact nestedClassStep_preserves_wellFormed wf nested

theorem sequentialStep_objectAndNestedClass_disjoint {p : Program}
    {before sequentialAfter objectAfter : SequentialConfig}
    (sequential : p.SequentialStep before sequentialAfter)
    (objects : p.ObjectAndNestedClassStep before objectAfter) : False := by
  cases sequential with
  | expression expression =>
      cases objects with
      | objectLiteral object =>
          cases object with
          | superclass =>
              cases expression with
              | nonOrdinary requestData =>
                  simp [nonOrdinaryRequest] at requestData
          | commit => cases expression
          | inheritanceError => cases expression
          | topSuperclassError => cases expression
      | nestedClass nested =>
          cases nested with
          | hit =>
              cases expression with
              | nonOrdinary requestData =>
                  simp [nonOrdinaryRequest] at requestData
          | miss =>
              cases expression with
              | nonOrdinary requestData =>
                  simp [nonOrdinaryRequest] at requestData
          | store => cases expression
  | request request =>
      cases objects with
      | objectLiteral object => cases object <;> cases request
      | nestedClass nested => cases nested <;> cases request
  | invocation invocation =>
      cases objects with
      | objectLiteral object => cases object <;> cases invocation
      | nestedClass nested => cases nested <;> cases invocation
  | body body =>
      cases body with
      | graph next =>
          cases objects with
          | objectLiteral object =>
              cases object <;> simp [bodyMachineNext] at next
          | nestedClass nested =>
              cases nested <;> simp [bodyMachineNext] at next
  | returns returns =>
      cases returns with
      | graph next =>
          cases objects with
          | objectLiteral object =>
              cases object <;> simp [returnMachineNext] at next
          | nestedClass nested =>
              cases nested <;> simp [returnMachineNext] at next
  | closure closure =>
      cases objects with
      | objectLiteral object =>
          cases object <;>
            cases closure with
            | creation creation => cases creation
            | dispatch dispatch => cases dispatch
            | invocation invocation => cases invocation
      | nestedClass nested =>
          cases nested <;>
            cases closure with
            | creation creation => cases creation
            | dispatch dispatch => cases dispatch
            | invocation invocation => cases invocation
  | objectSlots slots =>
      cases objects with
      | objectLiteral object => cases object <;> cases slots
      | nestedClass nested => cases nested <;> cases slots
  | classes classes =>
      cases objects with
      | objectLiteral object => cases object <;> cases classes
      | nestedClass nested => cases nested <;> cases classes
  | messages messages =>
      cases objects with
      | objectLiteral object => cases object <;> cases messages
      | nestedClass nested => cases nested <;> cases messages

@[simp] theorem initializationCoordinatorNext_makeObjectLiteralFrame_none
    (p : Program) (state : AllocationState) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack) (value : ObjRef)
    (descriptor : ObjectLiteralDescriptor) (enclosingObject : ObjRef) :
    p.initializationCoordinatorNext
      ⟨state, .push rest ⟨current,
        .push frames (.makeObjectLiteral descriptor enclosingObject)⟩,
        .object value⟩ = none := by
  cases value <;> rfl

@[simp] theorem initializationCoordinatorNext_nestedClassStoreFrame_none
    (p : Program) (state : AllocationState) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack) (value : ObjRef)
    (object : ObjectId) (declaration : ClassDeclId) :
    p.initializationCoordinatorNext
      ⟨state, .push rest ⟨current,
        .push frames (.nestedClassStore object declaration)⟩,
        .object value⟩ = none := by
  cases value <;> rfl

@[simp] theorem slotInitializationNext_makeObjectLiteralFrame_none
    (p : Program) (state : AllocationState) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack) (value : ObjRef)
    (descriptor : ObjectLiteralDescriptor) (enclosingObject : ObjRef) :
    p.slotInitializationNext
      ⟨state, .push rest ⟨current,
        .push frames (.makeObjectLiteral descriptor enclosingObject)⟩,
        .object value⟩ = none := by
  cases value <;> rfl

@[simp] theorem slotInitializationNext_nestedClassStoreFrame_none
    (p : Program) (state : AllocationState) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack) (value : ObjRef)
    (object : ObjectId) (declaration : ClassDeclId) :
    p.slotInitializationNext
      ⟨state, .push rest ⟨current,
        .push frames (.nestedClassStore object declaration)⟩,
        .object value⟩ = none := by
  cases value <;> rfl

theorem instanceInitializationStep_objectAndNestedClass_disjoint {p : Program}
    {before initializationAfter objectAfter : SequentialConfig}
    (initialization : p.InstanceInitializationStep before initializationAfter)
    (objects : p.ObjectAndNestedClassStep before objectAfter) : False := by
  cases initialization with
  | factory factory =>
      cases objects with
      | objectLiteral object => cases object <;> cases factory
      | nestedClass nested => cases nested <;> cases factory
  | coordinator coordinator =>
      cases coordinator with
      | graph next =>
          cases objects with
          | objectLiteral object =>
              cases object with
              | superclass => simp [initializationCoordinatorNext] at next
              | commit => simp [initializationCoordinatorNext] at next
              | inheritanceError =>
                  simp only
                    [initializationCoordinatorNext_makeObjectLiteralFrame_none]
                    at next
                  cases next
              | topSuperclassError =>
                  simp [initializationCoordinatorNext] at next
          | nestedClass nested =>
              cases nested <;> simp [initializationCoordinatorNext] at next
  | slots slots =>
      cases slots with
      | graph next =>
          cases objects with
          | objectLiteral object =>
              cases object with
              | superclass => simp [slotInitializationNext] at next
              | commit => simp [slotInitializationNext] at next
              | inheritanceError =>
                  simp only [slotInitializationNext_makeObjectLiteralFrame_none]
                    at next
                  cases next
              | topSuperclassError => simp [slotInitializationNext] at next
          | nestedClass nested =>
              cases nested <;> simp [slotInitializationNext] at next

theorem sequentialStepWithInitialization_objectAndNestedClass_disjoint
    {p : Program} {before sequentialAfter objectAfter : SequentialConfig}
    (sequential : p.SequentialStepWithInitialization before sequentialAfter)
    (objects : p.ObjectAndNestedClassStep before objectAfter) : False := by
  cases sequential with
  | prior prior => exact sequentialStep_objectAndNestedClass_disjoint prior objects
  | initialization initialization =>
      exact instanceInitializationStep_objectAndNestedClass_disjoint
        initialization objects

/-- The enlarged sequential relation through object literals and
    receiver-local nested-class caching. -/
inductive SequentialStepWithObjects (p : Program) :
    SequentialConfig → SequentialConfig → Prop where
  | prior {before after : SequentialConfig} :
      p.SequentialStepWithInitialization before after →
        p.SequentialStepWithObjects before after
  | objects {before after : SequentialConfig} :
      p.ObjectAndNestedClassStep before after →
        p.SequentialStepWithObjects before after

theorem sequentialStepWithObjects_deterministic {p : Program}
    {before after₁ after₂ : SequentialConfig}
    (wf : p.WellFormed before.allocation.heap)
    (step₁ : p.SequentialStepWithObjects before after₁)
    (step₂ : p.SequentialStepWithObjects before after₂) : after₁ = after₂ := by
  cases step₁ with
  | prior prior₁ =>
      cases step₂ with
      | prior prior₂ =>
          exact sequentialStepWithInitialization_deterministic wf prior₁ prior₂
      | objects objects₂ =>
          exact (sequentialStepWithInitialization_objectAndNestedClass_disjoint
            prior₁ objects₂).elim
  | objects objects₁ =>
      cases step₂ with
      | prior prior₂ =>
          exact (sequentialStepWithInitialization_objectAndNestedClass_disjoint
            prior₂ objects₁).elim
      | objects objects₂ =>
          exact objectAndNestedClassStep_deterministic objects₁ objects₂

theorem sequentialStepWithObjects_preserves_wellFormed {p : Program}
    {before after : SequentialConfig} (wf : SequentialWellFormed p before)
    (step : p.SequentialStepWithObjects before after) :
    SequentialWellFormed p after := by
  cases step with
  | prior prior => exact sequentialStepWithInitialization_preserves_wellFormed wf prior
  | objects objects =>
      exact objectAndNestedClassStep_preserves_wellFormed wf objects

/-- Finite execution of the checked sequential relation.  This closure is
    deliberately separate from one-step execution: later actor scheduling and
    reflection boundaries quantify over finite sequential segments. -/
inductive SequentialExecutionWithObjects (p : Program) :
    SequentialConfig → SequentialConfig → Prop where
  | refl (config : SequentialConfig) :
      p.SequentialExecutionWithObjects config config
  | next {before middle after : SequentialConfig} :
      p.SequentialStepWithObjects before middle →
      p.SequentialExecutionWithObjects middle after →
      p.SequentialExecutionWithObjects before after

theorem SequentialExecutionWithObjects.single {p : Program}
    {before after : SequentialConfig}
    (step : p.SequentialStepWithObjects before after) :
    p.SequentialExecutionWithObjects before after :=
  .next step (.refl after)

theorem SequentialExecutionWithObjects.trans {p : Program}
    {before middle after : SequentialConfig}
    (first : p.SequentialExecutionWithObjects before middle)
    (second : p.SequentialExecutionWithObjects middle after) :
    p.SequentialExecutionWithObjects before after := by
  induction first with
  | refl => exact second
  | next step remaining ih => exact .next step (ih second)

theorem SequentialExecutionWithObjects.preserves_wellFormed {p : Program}
    {before after : SequentialConfig} (wf : SequentialWellFormed p before)
    (execution : p.SequentialExecutionWithObjects before after) :
    SequentialWellFormed p after := by
  induction execution with
  | refl => exact wf
  | next step remaining ih =>
      exact ih (sequentialStepWithObjects_preserves_wellFormed wf step)

theorem requestCompletion_is_objectExecution {p : Program}
    {before after : SequentialConfig}
    (step : p.RequestCompletionStep before after) :
    p.SequentialExecutionWithObjects before after :=
  .single (.prior (.prior (.request step)))

theorem methodInvocation_is_objectExecution {p : Program}
    {before after : SequentialConfig}
    (step : p.MethodInvocationStep before after) :
    p.SequentialExecutionWithObjects before after :=
  .single (.prior (.prior (.invocation step)))

theorem bodyMachine_is_objectExecution {p : Program}
    {before after : SequentialConfig}
    (step : p.BodyMachineStep before after) :
    p.SequentialExecutionWithObjects before after :=
  .single (.prior (.prior (.body step)))

theorem factoryNew_is_objectExecution {p : Program}
    {before after : SequentialConfig}
    (step : p.FactoryNewStep before after) :
    p.SequentialExecutionWithObjects before after :=
  .single (.prior (.initialization (.factory step)))

theorem objectLiteral_is_objectExecution {p : Program}
    {before after : SequentialConfig}
    (step : p.ObjectLiteralStep before after) :
    p.SequentialExecutionWithObjects before after :=
  .single (.objects (.objectLiteral step))

/-- Invoking the synthesized nullary factory method reaches its internal
    `newInstanceCurrent` primitive after ordinary method entry and the two
    body-machine steps that skip empty locals and install the return frame.
    The result covers both tail and non-tail invocation. -/
theorem objectLiteralFactoryInvocation_reachesPrimitive (p : Program)
    (state : AllocationState) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack)
    (currentDef : ActivationDef) (descriptor : ObjectLiteralDescriptor)
    (instanceMixin : MixinDef)
    (implementation :
      ObjectLiteralFactoryImplementation p descriptor instanceMixin)
    (receiver : ObjRef) (definingClass : ClassId)
    (currentLive : state.heap.activations current = some currentDef) :
    ∃ factoryState factoryRest factoryActivation factoryActivationDef
        factoryFrames,
      p.SequentialExecutionWithObjects
        ⟨state, .push rest ⟨current, frames⟩,
          .invoke implementation.method receiver definingClass
            (objectLiteralNewMessage instanceMixin)⟩
        ⟨factoryState,
          .push factoryRest
            ⟨factoryActivation, .push factoryFrames .returnFrame⟩,
          .evaluate
            (.newInstanceCurrent instanceMixin.initializerSelector [])⟩ ∧
      factoryState.heap.activations factoryActivation =
        some factoryActivationDef ∧
      factoryActivationDef.currentReceiver = receiver ∧
      factoryActivationDef.currentClass = some definingClass ∧
      factoryState.heap.classes = state.heap.classes ∧
      factoryState.heap.objects = state.heap.objects ∧
      factoryState.nextObject = state.nextObject := by
  let message := objectLiteralNewMessage instanceMixin
  let factoryBody : List Statement :=
    [.return (.newInstanceCurrent instanceMixin.initializerSelector [])]
  have selectorMatches : implementation.method.selector = message.selector := by
    simpa [message, objectLiteralNewMessage] using implementation.selectorMatches
  have arityMatches : implementation.method.parameters.length =
      message.arguments.length := by
    simp [message, objectLiteralNewMessage, implementation.parametersEmpty]
  cases frames with
  | empty =>
      let allocation := p.allocateMethodActivation state implementation.method
        receiver definingClass message currentDef.continuation
      let initialized : SequentialConfig :=
        ⟨allocation.1, .push rest ⟨allocation.2, .empty⟩,
          .initialize allocation.2 [] factoryBody (.methodBody receiver)⟩
      let body : SequentialConfig :=
        ⟨allocation.1, .push rest ⟨allocation.2, .empty⟩,
          .body (.methodBody receiver) factoryBody⟩
      let primitive : SequentialConfig :=
        ⟨allocation.1,
          .push rest ⟨allocation.2,
            .push (.push .empty (.sequence (.methodBody receiver) []))
              .returnFrame⟩,
          .evaluate
            (.newInstanceCurrent instanceMixin.initializerSelector [])⟩
      have invocation : p.MethodInvocationStep
          ⟨state, .push rest ⟨current, .empty⟩,
            .invoke implementation.method receiver definingClass message⟩
          initialized := by
        apply MethodInvocationStep.tail currentLive selectorMatches arityMatches
          implementation.localsEmpty
        simpa [factoryBody] using implementation.bodyInstalled
      have enterBody : p.BodyMachineStep initialized body := by
        apply BodyMachineStep.graph
        simp [initialized, body, factoryBody, bodyMachineNext]
      have enterPrimitive : p.BodyMachineStep body primitive := by
        apply BodyMachineStep.graph
        simp [body, primitive, factoryBody, bodyMachineNext, startStatement]
      have trace : p.SequentialExecutionWithObjects
          ⟨state, .push rest ⟨current, .empty⟩,
            .invoke implementation.method receiver definingClass message⟩
          primitive :=
        (methodInvocation_is_objectExecution invocation).trans
          ((bodyMachine_is_objectExecution enterBody).trans
            (bodyMachine_is_objectExecution enterPrimitive))
      let activation := p.methodActivationDefinition allocation.2
        implementation.method receiver definingClass message
        currentDef.continuation
      refine ⟨allocation.1, rest, allocation.2, activation,
        .push .empty (.sequence (.methodBody receiver) []), ?_, ?_, rfl, rfl,
        ?_, ?_, ?_⟩
      · simpa [message, primitive] using trace
      · simpa [allocation, activation] using
          p.allocateMethodActivation_installs state implementation.method
            receiver definingClass message currentDef.continuation
      · simp [allocation, allocateMethodActivation, Heap.installActivation]
      · simp [allocation, allocateMethodActivation, Heap.installActivation]
      · simp [allocation, allocateMethodActivation]
  | push below topFrame =>
      let fullFrames := EvalStack.push below topFrame
      let allocation := p.allocateMethodActivation state implementation.method
        receiver definingClass message (some current)
      let factoryRest := ActivationStack.push rest ⟨current, fullFrames⟩
      let initialized : SequentialConfig :=
        ⟨allocation.1, .push factoryRest ⟨allocation.2, .empty⟩,
          .initialize allocation.2 [] factoryBody (.methodBody receiver)⟩
      let body : SequentialConfig :=
        ⟨allocation.1, .push factoryRest ⟨allocation.2, .empty⟩,
          .body (.methodBody receiver) factoryBody⟩
      let primitive : SequentialConfig :=
        ⟨allocation.1,
          .push factoryRest ⟨allocation.2,
            .push (.push .empty (.sequence (.methodBody receiver) []))
              .returnFrame⟩,
          .evaluate
            (.newInstanceCurrent instanceMixin.initializerSelector [])⟩
      have invocation : p.MethodInvocationStep
          ⟨state, .push rest ⟨current, fullFrames⟩,
            .invoke implementation.method receiver definingClass message⟩
          initialized := by
        apply MethodInvocationStep.nonTail selectorMatches arityMatches
          implementation.localsEmpty
        simpa [factoryBody] using implementation.bodyInstalled
      have enterBody : p.BodyMachineStep initialized body := by
        apply BodyMachineStep.graph
        simp [initialized, body, factoryBody, bodyMachineNext]
      have enterPrimitive : p.BodyMachineStep body primitive := by
        apply BodyMachineStep.graph
        simp [body, primitive, factoryBody, bodyMachineNext, startStatement]
      have trace : p.SequentialExecutionWithObjects
          ⟨state, .push rest ⟨current, fullFrames⟩,
            .invoke implementation.method receiver definingClass message⟩
          primitive :=
        (methodInvocation_is_objectExecution invocation).trans
          ((bodyMachine_is_objectExecution enterBody).trans
            (bodyMachine_is_objectExecution enterPrimitive))
      let activation := p.methodActivationDefinition allocation.2
        implementation.method receiver definingClass message (some current)
      refine ⟨allocation.1, factoryRest, allocation.2, activation,
        .push .empty (.sequence (.methodBody receiver) []),
        ?_, ?_, rfl, rfl, ?_, ?_, ?_⟩
      · simpa [message, fullFrames, primitive] using trace
      · simpa [allocation, activation] using
          p.allocateMethodActivation_installs state implementation.method
            receiver definingClass message (some current)
      · simp [allocation, allocateMethodActivation, Heap.installActivation]
      · simp [allocation, allocateMethodActivation, Heap.installActivation]
      · simp [allocation, allocateMethodActivation]

/-- The ordinary send produced by successful object-literal class allocation
    reaches the internal factory primitive through public request completion,
    method invocation, empty-local entry, and return-frame installation. -/
theorem allocatedObjectLiteral_dispatchesToPrimitive (p : Program)
    (state : AllocationState) (descriptor : ObjectLiteralDescriptor)
    (instanceMixin : MixinDef) (superclass : ClassId)
    (enclosingObject : ObjRef) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack)
    (implementation :
      ObjectLiteralFactoryImplementation p descriptor instanceMixin)
    (dispatchWellFormed : SequentialWellFormed p
      (let allocation := p.allocateClassPair state
        (.expression (.objectLiteral descriptor.declaration))
        descriptor.instanceMixin descriptor.classMixin superclass
        enclosingObject (objectLiteralFactory descriptor instanceMixin)
      ⟨allocation.1, .push rest ⟨current, frames⟩,
        .dispatch (.ordinary (.classObject allocation.2.1))
          (objectLiteralNewMessage instanceMixin)⟩)) :
    let allocation := p.allocateClassPair state
      (.expression (.objectLiteral descriptor.declaration))
      descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
      (objectLiteralFactory descriptor instanceMixin)
    ∃ factoryState factoryRest factoryActivation factoryActivationDef
        factoryFrames,
      p.SequentialExecutionWithObjects
        ⟨allocation.1, .push rest ⟨current, frames⟩,
          .dispatch (.ordinary (.classObject allocation.2.1))
            (objectLiteralNewMessage instanceMixin)⟩
        ⟨factoryState,
          .push factoryRest
            ⟨factoryActivation, .push factoryFrames .returnFrame⟩,
          .evaluate
            (.newInstanceCurrent instanceMixin.initializerSelector [])⟩ ∧
      factoryState.heap.activations factoryActivation =
        some factoryActivationDef ∧
      factoryActivationDef.currentReceiver = .classObject allocation.2.1 ∧
      factoryActivationDef.currentClass = some allocation.2.2 ∧
      factoryState.heap.classes = allocation.1.heap.classes ∧
      factoryState.heap.objects = allocation.1.heap.objects ∧
      factoryState.nextObject = allocation.1.nextObject := by
  let allocation := p.allocateClassPair state
    (.expression (.objectLiteral descriptor.declaration))
    descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
    (objectLiteralFactory descriptor instanceMixin)
  have request := p.allocatedObjectLiteral_dispatchesToPrimaryFactory state
    descriptor instanceMixin superclass enclosingObject rest current frames
    implementation dispatchWellFormed.heap
  rcases dispatchWellFormed.stack with
    ⟨restLive, currentDef, currentLive⟩
  have invocation := p.objectLiteralFactoryInvocation_reachesPrimitive
    allocation.1 rest current frames currentDef descriptor instanceMixin
    implementation (.classObject allocation.2.1) allocation.2.2 currentLive
  rcases invocation with
    ⟨factoryState, factoryRest, factoryActivation, factoryActivationDef,
      factoryFrames, invocationTrace, activationLive, receiver, currentClass,
      classesUnchanged, objectsUnchanged, nextObjectUnchanged⟩
  refine ⟨factoryState, factoryRest, factoryActivation, factoryActivationDef,
    factoryFrames, ?_, activationLive, receiver, currentClass,
    classesUnchanged, objectsUnchanged, nextObjectUnchanged⟩
  exact (requestCompletion_is_objectExecution request).trans invocationTrace

/-- The complete synthesized-factory path for an allocated object literal.
    Ordinary public dispatch enters the synthesized method, evaluates its
    static Factory-New primitive, and allocates the instance at the unchanged
    object-supply frontier with its full nil-initialized layout. -/
theorem allocatedObjectLiteral_factoryNew_allocatesFreshInstance (p : Program)
    (state : AllocationState) (descriptor : ObjectLiteralDescriptor)
    (instanceMixin : MixinDef) (superclass : ClassId)
    (enclosingObject : ObjRef) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack)
    (implementation :
      ObjectLiteralFactoryImplementation p descriptor instanceMixin)
    (layout : List SlotId)
    (layoutWitness :
      let allocation := p.allocateClassPair state
        (.expression (.objectLiteral descriptor.declaration))
        descriptor.instanceMixin descriptor.classMixin superclass
        enclosingObject (objectLiteralFactory descriptor instanceMixin)
      p.InstanceLayout allocation.1.heap allocation.2.1 layout)
    (dispatchWellFormed : SequentialWellFormed p
      (let allocation := p.allocateClassPair state
        (.expression (.objectLiteral descriptor.declaration))
        descriptor.instanceMixin descriptor.classMixin superclass
        enclosingObject (objectLiteralFactory descriptor instanceMixin)
      ⟨allocation.1, .push rest ⟨current, frames⟩,
        .dispatch (.ordinary (.classObject allocation.2.1))
          (objectLiteralNewMessage instanceMixin)⟩)) :
    let allocation := p.allocateClassPair state
      (.expression (.objectLiteral descriptor.declaration))
      descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
      (objectLiteralFactory descriptor instanceMixin)
    ∃ after object,
      p.SequentialExecutionWithObjects
        ⟨allocation.1, .push rest ⟨current, frames⟩,
          .dispatch (.ordinary (.classObject allocation.2.1))
            (objectLiteralNewMessage instanceMixin)⟩ after ∧
      object = (⟨state.nextObject⟩ : ObjectId) ∧
      state.heap.objects object = none ∧
      after.allocation.heap.objects object = some
        { classId := allocation.2.1
          slots := slotsInitializedTo layout p.nilObject
          nestedClasses := FiniteStore.empty ClassDeclId ClassId } := by
  let allocation := p.allocateClassPair state
    (.expression (.objectLiteral descriptor.declaration))
    descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
    (objectLiteralFactory descriptor instanceMixin)
  have primitive := p.allocatedObjectLiteral_dispatchesToPrimitive state
    descriptor instanceMixin superclass enclosingObject rest current frames
    implementation dispatchWellFormed
  rcases primitive with
    ⟨factoryState, factoryRest, factoryActivation, factoryActivationDef,
      factoryFrames, primitiveTrace, activationLive, receiver, currentClass,
      classesUnchanged, objectsUnchanged, nextObjectUnchanged⟩
  have instanceInstalled := (p.allocateClassPair_installs state
    (.expression (.objectLiteral descriptor.declaration))
    descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
    (objectLiteralFactory descriptor instanceMixin)).1
  let classDef : ClassDef :=
    { mixin := descriptor.instanceMixin
      superclass := superclass
      enclosingObject := enclosingObject
      metaclass := allocation.2.2
      origin := .expression (.objectLiteral descriptor.declaration)
      primaryFactory := some (objectLiteralFactory descriptor instanceMixin) }
  have classLive : factoryState.heap.classes allocation.2.1 = some classDef := by
    rw [classesUnchanged]
    simpa [allocation, classDef] using instanceInstalled
  have layoutAtFactory :
      p.InstanceLayout factoryState.heap allocation.2.1 layout :=
    layoutWitness.of_classes_eq classesUnchanged
  let after := p.factoryNewResult factoryState factoryRest factoryActivation
    factoryFrames allocation.2.1 layout
    (objectLiteralFactory descriptor instanceMixin)
    (objectLiteralNewMessage instanceMixin)
  have newStep : p.FactoryNewStep
      ⟨factoryState,
        .push factoryRest
          ⟨factoryActivation, .push factoryFrames .returnFrame⟩,
        .evaluate
          (.newInstanceCurrent instanceMixin.initializerSelector [])⟩
      after := by
    apply FactoryNewStep.allocate activationLive receiver classLive
    · rfl
    · rfl
    · rfl
    · simp [activationParameterValues]
    · exact layoutAtFactory
  have primitiveWellFormed :=
    primitiveTrace.preserves_wellFormed dispatchWellFormed
  let object : ObjectId := ⟨factoryState.nextObject⟩
  have objectAtOriginalFrontier : object = (⟨state.nextObject⟩ : ObjectId) := by
    apply congrArg (fun index => (⟨index⟩ : ObjectId))
    exact nextObjectUnchanged.trans (by rfl)
  have objectFreshInFactory : factoryState.heap.objects object = none :=
    primitiveWellFormed.supplies.2.2.2.1 object (by simp [object])
  have objectFreshInitially : state.heap.objects object = none := by
    rw [objectsUnchanged] at objectFreshInFactory
    simpa [allocation, allocateClassPair, Heap.installClass] using
      objectFreshInFactory
  have objectInstalled : after.allocation.heap.objects object = some
      { classId := allocation.2.1
        slots := slotsInitializedTo layout p.nilObject
        nestedClasses := FiniteStore.empty ClassDeclId ClassId } := by
    simpa [after, object, factoryNewResult] using
      p.allocateInitialInstance_installs_object factoryState allocation.2.1
        layout (objectLiteralFactory descriptor instanceMixin)
        (objectLiteralNewMessage instanceMixin) (some factoryActivation)
  refine ⟨after, object, primitiveTrace.trans
    (factoryNew_is_objectExecution newStep), objectAtOriginalFrontier,
    objectFreshInitially, objectInstalled⟩

/-- End-to-end successful object-literal creation, beginning before
    Object-Commit.  This theorem composes class-pair allocation, public
    factory lookup, ordinary method invocation and body entry, Factory-New,
    and fresh instance allocation. -/
theorem objectLiteralCommit_allocatesFreshInstance (p : Program)
    (state : AllocationState) (descriptor : ObjectLiteralDescriptor)
    (instanceMixin : MixinDef) (superclass : ClassId)
    (enclosingObject : ObjRef) (rest : ActivationStack)
    (current : ActivationId) (frames : EvalStack)
    (implementation :
      ObjectLiteralFactoryImplementation p descriptor instanceMixin)
    (inheritanceValid : inheritanceError state.heap (.classObject superclass)
      descriptor.superclassMessage = none)
    (topValid : p.validTopSuperclass enclosingObject
      descriptor.superclassSyntax superclass = true)
    (mixinFound : p.mixins descriptor.instanceMixin = some instanceMixin)
    (initializerMatches : instanceMixin.initializerDeclaration =
      descriptor.initializerDeclaration)
    (nullary : instanceMixin.initializerParameters = [])
    (allocationWellFormed :
      let allocation := p.allocateClassPair state
        (.expression (.objectLiteral descriptor.declaration))
        descriptor.instanceMixin descriptor.classMixin superclass
        enclosingObject (objectLiteralFactory descriptor instanceMixin)
      p.WellFormed allocation.1.heap)
    (layout : List SlotId)
    (layoutWitness :
      let allocation := p.allocateClassPair state
        (.expression (.objectLiteral descriptor.declaration))
        descriptor.instanceMixin descriptor.classMixin superclass
        enclosingObject (objectLiteralFactory descriptor instanceMixin)
      p.InstanceLayout allocation.1.heap allocation.2.1 layout)
    (beforeWellFormed : SequentialWellFormed p
      ⟨state, .push rest
        ⟨current, .push frames
          (.makeObjectLiteral descriptor enclosingObject)⟩,
        .object (.classObject superclass)⟩) :
    let allocation := p.allocateClassPair state
      (.expression (.objectLiteral descriptor.declaration))
      descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
      (objectLiteralFactory descriptor instanceMixin)
    ∃ after object,
      p.SequentialExecutionWithObjects
        ⟨state, .push rest
          ⟨current, .push frames
            (.makeObjectLiteral descriptor enclosingObject)⟩,
          .object (.classObject superclass)⟩ after ∧
      object = (⟨state.nextObject⟩ : ObjectId) ∧
      state.heap.objects object = none ∧
      after.allocation.heap.objects object = some
        { classId := allocation.2.1
          slots := slotsInitializedTo layout p.nilObject
          nestedClasses := FiniteStore.empty ClassDeclId ClassId } := by
  let allocation := p.allocateClassPair state
    (.expression (.objectLiteral descriptor.declaration))
    descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
    (objectLiteralFactory descriptor instanceMixin)
  let before : SequentialConfig :=
    ⟨state, .push rest
      ⟨current, .push frames (.makeObjectLiteral descriptor enclosingObject)⟩,
      .object (.classObject superclass)⟩
  let dispatched : SequentialConfig :=
    ⟨allocation.1, .push rest ⟨current, frames⟩,
      .dispatch (.ordinary (.classObject allocation.2.1))
        (objectLiteralNewMessage instanceMixin)⟩
  have commit : p.ObjectLiteralStep before dispatched := by
    apply ObjectLiteralStep.commit inheritanceValid topValid mixinFound
      initializerMatches nullary rfl
    exact allocationWellFormed
  have commitTrace : p.SequentialExecutionWithObjects before dispatched :=
    objectLiteral_is_objectExecution commit
  have dispatchedWellFormed : SequentialWellFormed p dispatched :=
    objectLiteralStep_preserves_wellFormed beforeWellFormed commit
  have remaining :=
    p.allocatedObjectLiteral_factoryNew_allocatesFreshInstance state descriptor
      instanceMixin superclass enclosingObject rest current frames
      implementation layout layoutWitness dispatchedWellFormed
  rcases remaining with
    ⟨after, object, remainingTrace, objectAtFrontier, objectFresh,
      objectInstalled⟩
  refine ⟨after, object, commitTrace.trans remainingTrace,
    objectAtFrontier, objectFresh, objectInstalled⟩

/-- The class half of object-literal freshness, kept separate from the
    end-to-end instance theorem above so it can also be used before executing
    the synthesized factory.  The allocated instance class reuses exactly the
    declaration's instance-side mixin identity. -/
theorem objectLiteralClassPair_fresh_and_reuses_mixin (p : Program)
    (state : AllocationState) (fresh : state.ClassSupplyFresh)
    (descriptor : ObjectLiteralDescriptor) (instanceMixin : MixinDef)
    (superclass : ClassId) (enclosingObject : ObjRef) :
    let allocation := p.allocateClassPair state
      (.expression (.objectLiteral descriptor.declaration))
      descriptor.instanceMixin descriptor.classMixin superclass enclosingObject
      (objectLiteralFactory descriptor instanceMixin)
    state.heap.classes allocation.2.1 = none ∧
      state.heap.classes allocation.2.2 = none ∧
      allocation.2.1 ≠ allocation.2.2 ∧
      allocation.1.heap.classes allocation.2.1 = some
        { mixin := descriptor.instanceMixin
          superclass := superclass
          enclosingObject := enclosingObject
