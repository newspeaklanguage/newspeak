Newspeak3
'Root'
class CounterUI usingPlatform: p = Object new (
	|
		private Subject = p hopscotch Subject.
		private Presenter = p hopscotch Presenter.
	|
) (
	public class Counter new = Object new (
		|
			public count <Integer> ::= 0.
		|
	) (
	) : ()
	class CounterPresenter onSubject: s <CounterSubject> = Presenter onSubject: s (
	) (
		definition = (
			^row: {label: subject count. mediumBlank. button: 'increment'
					action: [ updateGUI: [ subject increment ] ]. button: 'decrement'
					action: [ updateGUI: [ subject decrement ] ]. button: 'reset'
					action: [ updateGUI: [ subject clear ] ]. }
		)
		public isKindOfCounterPresenter = (
			^true
		)
		isMyKind: other = (
			^other isKindOfCounterPresenter
		)
	) : ()
	public class CounterSubject onModel: m <Counter> = Subject onModel: m (
	) (
		public clear = (
			model count: 0
		)
		public count ^<Integer> = (
			^model count
		)
		createPresenter ^<CounterPresenter> = (
			^CounterPresenter onSubject: self
		)
		public decrement = (
			model count: count - 1
		)
		public increment = (
			model count: count + 1
		)
		public isKindOfCounterSubject = (
			^true
		)
		isMyKind: other = (
			^other isKindOfCounterSubject
		)
	) : ()
) : ()
