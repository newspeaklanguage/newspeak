Newspeak3
'Eurasia'
class EurasiaCompilerProbe usingPlatform: platform = (
	(* M6 step 1 (EURASIA_M6_REFLECTION_DESIGN_2026-11-18.md section 4.1): the V5 compiler compiles a class from source on Eurasia, and a small builder, which builds the mixins as the genesis packager does, makes it into program objects (Method new, InstanceMixin new, ClassMixin new, unfrozen until installed), applies them and runs the class. The genesis packager packages this application as if nested in EurasiaKernel and fills the module slots below; eurasia/scripts/reflection-tests.sh checks what it prints. *)
	
	|
		Kernel
		CollectionsForPrimordialSoup
		EurasiaActors
		EurasiaRuntime
		NewspeakASTs
		NewspeakPredictiveParsing
		IntermediatesForPrimordialSoup
		NewspeakCompilation
		NewspeakBytecodeCompilation
		Newspeak2V5BytecodeCompilation
		internalKernel
	|
) (
	buildMixinFor: decl enclosing: enclosingMixin platform: platform = (
		(* The instance-side mixin of a compiled class declaration, with its class-side mixin, as the genesis packager builds them: compiled methods, lazy-slot methods, nested-class accessors, the factory or initializers, and slot accessors whose indices are relative to the mixin. *)
		
		| mixin classMixin nested |
		mixin:: InstanceMixin new.
		classMixin:: ClassMixin new.
		nested:: decl instanceSide nestedClasses collect: [:n |
				buildMixinFor: n enclosing: mixin platform: platform
			].
		mixin _name: decl simpleName.
		mixin _enclosingMixin: enclosingMixin.
		mixin _slots: (decl instanceSide assembleSlots collect: [:s | s name ]) asArray.
		mixin _classMixin: classMixin.
		mixin _library: {nested asArray. decl accessModifier. decl factoryName. }.
		mixin _methods: (methodsFor: decl instanceSide mixin: mixin platform: platform).
		classMixin _name: decl simpleName.
		classMixin _enclosingMixin: enclosingMixin.
		classMixin _slotNames: {}.
		classMixin _methods: (methodsFor: decl classSide
				mixin: classMixin
				platform: platform).
		^mixin
	)
	public main: platform args: args = (
		| asts parsing intermediates compilation compiler decl mixin class probe |
		asts:: NewspeakASTs usingPlatform: platform.
		parsing:: NewspeakPredictiveParsing usingPlatform: platform asts: asts.
		intermediates:: IntermediatesForPrimordialSoup usingPlatform: platform
			internalKernel: internalKernel.
		compilation:: (Newspeak2V5BytecodeCompilation mixinApply: (NewspeakBytecodeCompilation mixinApply: NewspeakCompilation)) usingPlatform: platform
			asts: asts
			newspeakParser: parsing
			intermediates: intermediates.
		compiler:: compilation Compiler new.
		decl:: compiler compileClassSource: 'Newspeak3
''Probe''
class Probe new = (
	| public count ::= 3. |
) (
	public answer = ( ^count * 14 )
	public bump = ( count:: count + 1 )
	public shout: s = ( ^s , ''!'' )
) : (
	public tag = ( ^''class side'' )
)'
			within: nil.
		vm print: 'compiled ' , decl simpleName.
		mixin:: buildMixinFor: decl enclosing: nil platform: platform.
		class:: vm applyMixin: mixin superclass: Object enclosingObject: nil.
		probe:: class new.
		vm print: probe answer printString.
		probe bump.
		vm print: probe answer printString.
		vm print: (probe shout: 'built at run time').
		vm print: class tag.
		vm print: 'done'
	)
	methodsFor: side mixin: m platform: platform = (
		| compiled methods slots has |
		compiled:: platform collections List new.
		compiled addAll: side methods.
		side lazySlots do: [:lazySlot | lazySlot addMethodsTo: compiled ].
		side isMeta ifTrue: [
				nil = side declaration factory ifFalse: [
						compiled add: side declaration factory
					]
			]
			ifFalse: [
				side nestedClasses do: [:n | compiled add: n accessor ].
				nil = side declaration initializers ifFalse: [
						compiled addAll: side declaration initializers
					]
			].
		methods:: platform collections List new.
		compiled do: [:ir |
				| method |
				method:: ir compiledMethod.
				method mixin: m.
				methods add: method
			].
		has:: [:selector |
			(methods detect: [:x | x selector = selector ] ifNone: [ nil ]) isNil not
		].
		slots:: side assembleSlots.
		1 to: slots size
			do: [:i |
				| slot = slots at: i. |
				(has value: slot name) ifFalse: [
						methods add: ((Method newGetterForSlot: slot name
								at: i
								accessModifier: slot accessModifier) mixin: m;
								yourself)
					].
				methods add: ((Method newInitializerForSlot: slot name at: i) mixin: m;
						yourself).
				(slot isMutable and: [ (has value: slot name , ':') not ]) ifTrue: [
						methods add: ((Method newSetterForSlot: slot name
								at: i
								accessModifier: slot accessModifier) mixin: m;
								yourself)
					]
			].
		^methods asArray
	)
	public platformOver: ik = (
		internalKernel:: ik.
		^(EurasiaRuntime kernel: Kernel
			collections: CollectionsForPrimordialSoup
			actors: EurasiaActors) Platform internalKernel: ik
	)
) : ()
