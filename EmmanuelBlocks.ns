	public class LibraryBlock new = DocumentBlock new (
		(* The behaviour the library's blocks share: the rules of Section 6.
Subclasses give their state (stateName, stateValues), content class,
content model, and rendering (htmlTag, htmlStyle, presenterOn:), and
override free:, with:value:hostState:, and relabel: for the messages that
change their fields.

A block's stylesheet (Section 6) gives the styles it understands beyond the
core's; a block makes the blocks it pushes, leaves, and mutates with its
own. No stylesheet is the default one. *)
		
		|
			public stylesheet ::= nil.
		|
	) (
		adopt: block = (
			(* block, with this block's stylesheet. *)
			
			block stylesheet: stylesheet.
			^block
		)
		public contentClass = (
			^#flow
		)
		depth = (
			^Error signal: 'no depth: ' , stateName
		)
		displays = (
			^{'verbatim:'. 'codeBlock:'. 'codeBlock:language:'. 'html:'. 'amplet:'. 'hline'. }
		)
		effect: kind hostState: chi = (
			^emmanuel Effect kind: kind block: nil hostState: chi
		)
		public effectOf: x args: vs hostState: chi machine: m = (
			(understands: x) ifFalse: [ ^effect: #notUnderstood hostState: chi ].
			((inlineArgs includes: x) and: [ vs size = 1 ]) ifTrue: [
					^inline: x argument: vs first hostState: chi machine: m
				].
			^plain: x args: vs hostState: chi
		)
		public enterPriority = (
			(* Enter splits the innermost list item, making a new item, and where
there is none the innermost paragraph. *)
			
			stateName = 'item' ifTrue: [ ^2 ].
			stateName = 'para' ifTrue: [ ^1 ].
			^0
		)
		fieldFor: v selector: x messages: messages = (
			(* The field of a value set by the message x, if it is set. *)
			
			v isNil ifTrue: [ ^{} ].
			^{emmanuel Field value: v
				statement: (withSelector: x in: messages) first
				index: 0. }
		)
		flowContent = (
			^displays , {'paragraph'. 'list'. 'numberedList'. 'quote'. 'table'. 'figure'. } , sheet flowOpeners
		)
		free: x = (
			^true
		)
		public htmlStyle = (
			^''
		)
		public htmlTag = (
			^'div'
		)
		inline: x argument: v hostState: chi machine: m = (
			(* Lib-Inline: a markup literal is interpreted with an inline root; a
string is taken as it is; anything else is refused. *)
			
			| done |
			(free: x) ifFalse: [ ^effect: #refuse hostState: chi ].
			v isKindOfMarkupLiteral ifTrue: [
					done:: m interpretLiteral: v root: (adopt: InlineRoot new) hostState: chi.
					done isKindOfRaised ifTrue: [ ^done ].
					^with: x
						value: (emmanuel TreeValue literal: v tree: done tree)
						hostState: done hostState
				].
			(v isKindOfTreeValue or: [ v isKindOfString ]) ifTrue: [
					^with: x value: v hostState: chi
				].
			^effect: #refuse hostState: chi
		)
		inlineArgs = (
			^{'section:'. 'title:'. 'subtitle:'. 'author:'. 'attribution:'. 'caption:'. }
		)
		inlineContent = (
			^{'emphasis'. 'strong'. 'strikethrough'. 'subscript'. 'superscript'. 'code'. 'newline'. 'amplet:'. 'link:'. } , sheet inlineOpeners
		)
		isHostValue: v = (
			(* Whether v is a host value: not a literal, a tree, a string, a
number, or nil. The Newspeak host's closures are host values. *)
			
			^(v isNil or: [
					v isKindOfString or: [
							v isKindOfInteger or: [
									v isKindOfMarkupLiteral or: [ v isKindOfTreeValue ]
								]
						]
				]) not
		)
		public isLabelled = (
			^false
		)
		public joins = (
			^({'para'. 'emph'. 'strong'. 'strikethrough'. 'subscript'. 'superscript'. 'code'. 'link'. 'list'. 'numbered'. 'item'. } includes: stateName) or: [
					sheet isStyle: stateName
				]
		)
		leaf: block hostState: chi = (
			^emmanuel Effect kind: #leaf block: (adopt: block) hostState: chi
		)
		public model = (
			^{}
		)
		mutate: block hostState: chi = (
			^emmanuel Effect kind: #mutate block: (adopt: block) hostState: chi
		)
		public offersStyle: x = (
			(* Whether x is a style of inline content here: the core's or the
stylesheet's. *)
			
			^inlineContent includes: x
		)
		plain: x args: vs hostState: chi = (
			| v |
			(sheet isStyle: x) ifTrue: [
					^
					(* A style of the stylesheet: its arguments are strings. *)
					(vs allSatisfy: [:a | a isKindOfString ]) ifTrue: [
							push: (StyledBlock spec: (sheet specOf: x) args: vs) hostState: chi
						]
						ifFalse: [ effect: #refuse hostState: chi ]
				].
			(vs isEmpty and: [ sheet closers includes: x ]) ifTrue: [
					^effect: #pop hostState: chi
				].
			vs isEmpty ifTrue: [
					(openers includes: x) ifTrue: [ ^push: (opened: x) hostState: chi ].
					(closers includes: x) ifTrue: [ ^effect: #pop hostState: chi ].
					x = 'newline' ifTrue: [ ^leaf: Newline new hostState: chi ].
					x = 'hline' ifTrue: [ ^leaf: HorizontalLine new hostState: chi ]
				].
			vs size = 1 ifTrue: [
					v:: vs first.
					x = 'verbatim:' ifTrue: [
							^v isKindOfString ifTrue: [ leaf: (Verbatim text: v) hostState: chi ]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'html:' ifTrue: [
							^v isKindOfString ifTrue: [ leaf: (Html text: v) hostState: chi ]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'codeBlock:' ifTrue: [
							^v isKindOfString ifTrue: [
									leaf: (CodeDisplay text: v language: 'newspeak') hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'link:' ifTrue: [
							^v isKindOfString ifTrue: [ push: (Link target: v) hostState: chi ]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'amplet:' ifTrue: [
							^(isHostValue: v) ifTrue: [
									leaf: (Amplet code: v inline: contentClass ~= #flow) hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'label:' ifTrue: [
							^(isLabelled and: [ label isNil and: [ v isKindOfString ] ]) ifTrue: [
									mutate: (relabel: v) hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						]
				].
			(vs size = 2 and: [ x = 'codeBlock:language:' ]) ifTrue: [
					^(vs first isKindOfString and: [ vs last isKindOfString ]) ifTrue: [
							leaf: (CodeDisplay text: vs first language: vs last) hostState: chi
						]
						ifFalse: [ effect: #refuse hostState: chi ]
				].
			^effect: #refuse hostState: chi
		)
		public presenterOn: s = (
			^BlockPresenter onSubject: s
		)
		push: block hostState: chi = (
			^emmanuel Effect kind: #push block: (adopt: block) hostState: chi
		)
		public sheet = (
			(* The stylesheet: this block's, or the default one. *)
			
			^stylesheet isNil ifTrue: [ defaultStylesheet ] ifFalse: [ stylesheet ]
		)
		public understands: x = (
			^model includes: x
		)
		with: x value: v hostState: chi = (
			x = 'section:' ifTrue: [
					^push: (Section depth: depth + 1 heading: v label: nil) hostState: chi
				].
			^Error signal: 'no field for ' , x
		)
		withSelector: x in: messages = (
			(* The messages that are sends of x. *)
			
			^(messages select: [:s | s isComment not and: [ s selector = x ] ]) asArray
		)
	) : ()
	public class Link target: u = LibraryBlock new (
		(* A link (Section 6): an inline block whose target is a string, and
whose text is inline content, without links. *)
		
		|
			public target = u.
		|
	) (
		public contentClass = (
			^#inline
		)
		public fields: messages = (
			^{emmanuel Field value: target statement: messages first index: 0. }
		)
		public htmlTag = (
			^'a'
		)
		public model = (
			^(inlineContent reject: [:x | x = 'link:' ]) , {'endLink'. }
		)
		public presenterOn: s = (
			^LinkPresenter onSubject: s
		)
		public stateName = (
			^'link'
		)
		public stateValues = (
			^{target. }
		)
	) : ()
	public class LinkPresenter onSubject: s = BlockPresenter onSubject: s (
		(* A link shows its text, linked to its target. *)
		
	) (
		definition = (
			| f = super definition. |
			f attributes: f attributes , {{'href'. block target. }. }.
			^f
		)
	) : ()
	public class Newline new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'br'
		)
		public stateName = (
			^'newline'
		)
	) : ()
	public class NumberedList new = LibraryBlock new (
	) (
		public htmlTag = (
			^'ol'
		)
		public model = (
			^{'item'. 'endNumberedList'. }
		)
		public stateName = (
			^'numbered'
		)
	) : ()
	public class Paragraph new = LibraryBlock new (
	) (
		public contentClass = (
			^#para
		)
		public htmlStyle = (
			^sheet lookOf: #paragraph
		)
		public htmlTag = (
			^'p'
		)
		public model = (
			^inlineContent , {'endParagraph'. }
		)
		public stateName = (
			^'para'
		)
	) : ()
	public class Presentation new = (
		(* The presentation operations (the design notes'): what a style of a
stylesheet does to the look of its content, as CSS. A stylesheet's styles
are defined with them; markup never reaches them. A value that could break
out of its CSS declaration is ignored. *)
		
		|
			public css ::= ''.
		|
	) (
		public align: a = (
			({'left'. 'center'. 'right'. 'justify'. } includes: a) ifTrue: [
					declare: 'text-align' value: a
				]
		)
		public backgroundColor: c = (
			declare: 'background-color' value: c
		)
		declare: property value: v = (
			(v isKindOfString and: [ isSafe: v ]) ifTrue: [
					css:: css , ' ' , property , ': ' , v , ';'
				]
		)
		isSafe: v = (
			^(emmanuel codePointsOf: v) allSatisfy: [:c |
					({59. 34. 39. 60. 62. 123. 125. 92. } includes: c) not
				]
		)
		public slant: s = (
			declare: 'font-style' value: s
		)
		public textColor: c = (
			declare: 'color' value: c
		)
		public typeface: f = (
			declare: 'font-family' value: f
		)
		public weight: w = (
			declare: 'font-weight' value: w
		)
	) : ()
	public class Quote attribution: a = LibraryBlock new (
		|
			public attribution = a.
		|
	) (
		public fields: messages = (
			^fieldFor: attribution selector: 'attribution:' messages: messages
		)
		free: x = (
			x = 'attribution:' ifTrue: [ ^attribution isNil ].
			^true
		)
		public htmlTag = (
			^'blockquote'
		)
		public model = (
			^flowContent , {'attribution:'. 'endQuote'. }
		)
		public presenterOn: s = (
			^QuotePresenter onSubject: s
		)
		public stateName = (
			^'quote'
		)
		public stateValues = (
			^{attribution. }
		)
		with: x value: v hostState: chi = (
			x = 'attribution:' ifTrue: [ ^mutate: (Quote attribution: v) hostState: chi ].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^attribution: nil
		)
	)
	public class QuotePresenter onSubject: s = BlockPresenter onSubject: s (
	) (
		trailingFragments = (
			block attribution isNil ifTrue: [ ^{} ].
			^{ElementFragment tag: 'footer'
				style: ''
				children: {noEdit: (ElementFragment tag: 'span'
						style: ''
						children: {'— '. }). field: block attribution tag: 'span' style: ''. }. }
		)
	) : ()
	public class Row new = LibraryBlock new (
	) (
		public htmlTag = (
			^'tr'
		)
		public model = (
			^{'cell'. 'endRow'. }
		)
		public stateName = (
			^'row'
		)
	) : ()
	public class Section depth: d heading: h label: l = LibraryBlock new (
		(* A section: its depth (1 at the top), heading, and label. *)
		
		|
			public depth = d.
			public heading = h.
			public label = l.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: heading statement: messages first index: 0. }
		)
		public htmlTag = (
			^'section'
		)
		public isLabelled = (
			^true
		)
		public model = (
			^flowContent , {'section:'. 'label:'. 'endSection'. }
		)
		public presenterOn: s = (
			^SectionPresenter onSubject: s
		)
		public relabel: v = (
			^Section depth: depth heading: heading label: v
		)
		public stateName = (
			^'section'
		)
		public stateValues = (
			^{depth. heading. label. }
		)
	) : ()
	public class SectionPresenter onSubject: s = BlockPresenter onSubject: s (
		(* A section shows its heading, at its depth. *)
		
	) (
		leadingFragments = (
			^{field: block heading
				tag: 'h' , (block depth + 1 min: 6) printString
				style: (block sheet lookOf: #heading). }
		)
	) : ()
	public class Strong new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'strong'
		)
		public model = (
			^inlineContent , {'endStrong'. }
		)
		public stateName = (
			^'strong'
		)
	) : ()
	public class StyledBlock spec: sp args: vs = LibraryBlock new (
		(* A block of a style of the stylesheet: its state is its opener and
its arguments. *)
		
		|
			public spec = sp.
			public args = vs.
		|
	) (
		public contentClass = (
			^spec contentClass
		)
		public htmlStyle = (
			^spec cssFor: args
		)
		public htmlTag = (
			^spec tag
		)
		public model = (
			^(spec contentClass = #inline ifTrue: [ inlineContent ]
				ifFalse: [ flowContent ]) , {spec closer. }
		)
		public stateName = (
			^spec opener
		)
		public stateValues = (
			^args
		)
	) : ()
	public class Stylesheet styles: ss = (
		(* A stylesheet (Section 6): the styles a document's template offers
beyond the core library's, and the looks of the document's parts: CSS for
#document (its text), #title, #subtitle, #author, #paragraph, #heading, and
#item. *)
		
		|
			public styles = ss.
			public looks ::= {}.
		|
	) (
		public closers = (
			^styles collect: [:sp | sp closer ]
		)
		public flowOpeners = (
			^((styles select: [:sp | sp contentClass = #flow ]) collect: [:sp |
					sp opener
				]) asArray
		)
		public inlineOpeners = (
			^((styles select: [:sp | sp contentClass = #inline ]) collect: [:sp |
					sp opener
				]) asArray
		)
		public isStyle: x = (
			^styles anySatisfy: [:sp | sp opener = x ]
		)
		public lookOf: part = (
			(* The CSS this stylesheet gives the part of a document, or none. *)
			
			looks do: [:l | (l at: 1) = part ifTrue: [ ^l at: 2 ] ].
			^''
		)
		public root = (
			(* The root block of a document with this stylesheet. *)
			
			| r = DocumentRoot new. |
			r stylesheet: self.
			^r
		)
		public specOf: x = (
			^styles detect: [:sp | sp opener = x ] ifNone: [ nil ]
		)
		public withLooks: ls = (
			(* This stylesheet, with the looks ls too: pairs of a part and its
CSS. *)
			
			| s = Stylesheet styles: styles. |
			s looks: looks , ls.
			^s
		)
	) : ()
	public class StyleSpec opener: x closer: c contentClass: q tag: t presentation: blk = (
		(* A style of a stylesheet (Section 6): its opener and closer, its
content class (#inline or #flow), the HTML tag that shows it, and what it
does to the look of its content, a block taking a Presentation and the
style's arguments. *)
		
		|
			public opener = x.
			public closer = c.
			public contentClass = q.
			public tag = t.
			private presentation = blk.
		|
	) (
		public cssFor: args = (
			| p = Presentation new. |
			presentation value: p value: args.
			^p css
		)
	) : ()
	public class Table label: l = LibraryBlock new (
		|
			public label = l.
		|
	) (
		public htmlStyle = (
			^'border-collapse: collapse;'
		)
		public htmlTag = (
			^'table'
		)
		public isLabelled = (
			^true
		)
		public model = (
			^{'headerRow'. 'row'. 'label:'. 'endTable'. }
		)
		public relabel: v = (
			^Table label: v
		)
		public stateName = (
			^'table'
		)
		public stateValues = (
			^{label. }
		)
	) : (
		public new = (
			^label: nil
		)
	)
	public class TextBlockPresenter onSubject: s = BlockPresenter onSubject: s (
		(* verbatim: and codeBlock: show their text as it is. *)
		
	) (
		childFragments = (
			^{block text. }
		)
		definition = (
			^noEdit: super definition
		)
	) : ()
	public class TextStyle named: x tag: t = LibraryBlock new (
		(* strikethrough, subscript, and superscript (Section 6): inline
styles, as emphasis is, each closed by its own closer. x is the
opener, which names the state; t is the HTML tag that shows it. *)
		
		|
			public stateName = x.
			public htmlTag = t.
		|
	) (
		public contentClass = (
			^#inline
		)
		public model = (
			^inlineContent , {closerOf: stateName. }
		)
	) : ()
	public class TreeSubject onModel: tree = Subject onModel: tree (
		(* The subject of a block's presenter: the block's tree, and its path
from the root of the document (steps: 'i3' into child 3, 'f0' into field 0),
which the editor reads from the rendering. *)
		
		|
			public steps ::= {}.
			public amplets ::= nil.
		|
	) (
		public ampletFragmentFor: code = (
			(* What an amplet shows: the fragment its amplets runner computes for
its code, or, with none, the code itself. *)
			
			amplets isNil ifTrue: [ ^code code ].
			^amplets fragmentFor: code
		)
		createPresenter = (
			^model state presenterOn: self
		)
		public isKindOfEmmanuelTreeSubject = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelTreeSubject
		)
		public tree = (
			^model
		)
	) : ()
	public class Verbatim text: t = LibraryBlock new (
		(* verbatim:, a leaf. *)
		
		|
			public text = t.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: text statement: messages first index: 0. }
		)
		public htmlTag = (
			^'pre'
		)
		public presenterOn: s = (
			^TextBlockPresenter onSubject: s
		)
		public stateName = (
			^'verbatim'
		)
		public stateValues = (
			^{text. }
		)
	) : ()
	public closerOf: x = (
		x = 'paragraph' ifTrue: [ ^'endParagraph' ].
		x = 'emphasis' ifTrue: [ ^'endEmphasis' ].
		x = 'strong' ifTrue: [ ^'endStrong' ].
		x = 'strikethrough' ifTrue: [ ^'endStrikethrough' ].
		x = 'subscript' ifTrue: [ ^'endSubscript' ].
		x = 'superscript' ifTrue: [ ^'endSuperscript' ].
		x = 'code' ifTrue: [ ^'endCode' ].
		x = 'list' ifTrue: [ ^'endList' ].
		x = 'numberedList' ifTrue: [ ^'endNumberedList' ].
		x = 'item' ifTrue: [ ^'endItem' ].
		x = 'quote' ifTrue: [ ^'endQuote' ].
		x = 'headerRow' ifTrue: [ ^'endRow' ].
		x = 'row' ifTrue: [ ^'endRow' ].
		x = 'cell' ifTrue: [ ^'endCell' ].
		x = 'figure' ifTrue: [ ^'endFigure' ].
		(defaultStylesheet isStyle: x) ifTrue: [
				^(defaultStylesheet specOf: x) closer
			].
		^Error signal: 'no closer: ' , x
	)
	closers = (
		^{'endParagraph'. 'endEmphasis'. 'endStrong'. 'endStrikethrough'. 'endSubscript'. 'endSuperscript'. 'endCode'. 'endSection'. 'endList'. 'endNumberedList'. 'endItem'. 'endQuote'. 'endTable'. 'endRow'. 'endCell'. 'endFigure'. 'endLink'. }
	)
	public errorFragment: description = (
		(* A fragment that reports what kept a source from being shown. *)
		
		^ElementFragment tag: 'div' style: 'color: red;' children: {description. }
	)
	errorSpan: text = (
		^ElementFragment tag: 'span'
			style: 'color: red; text-decoration: underline wavy red;'
			children: {text. }
	)
	fragmentsOfItems: items steps: ss amplets: amplets = (
		(* The fragments of a tree's children: text runs, the presenters of
the subtrees, and markers for the error leaves, each marked with its index
for the editor. Notes and mutations render nothing. ss is the path of the
tree. *)
		
		| out = List new. |
		items keysAndValuesDo: [:i :g |
				| j = (i - 1) printString. |
				g kind = #run ifTrue: [
						out add: (item: j
								fragment: (ElementFragment tag: 'span'
									style: ''
									children: {emmanuel stringOfCodePoints: g chars. }))
					].
				g kind = #stray ifTrue: [
						out add: (item: j
								fragment: (noEdit: (errorSpan: (emmanuel stringOfCodePoints: g chars))))
					].
				g kind = #sub ifTrue: [
						| s = TreeSubject onModel: g ref. |
						s steps: ss , {'i' , j. }.
						s amplets: amplets.
						out add: s presenter
					].
				({#dnu. #refused. #rootPop. } includes: g kind) ifTrue: [
						out add: (item: j
								fragment: (noEdit: (errorSpan: '⚠' , g statement selector)))
					]
			].
		^out asArray
	)
	fragmentsOfValue: v steps: ss amplets: amplets = (
		(* What a field shows: the children of a tree, or a string. *)
		
		v isKindOfTreeValue ifTrue: [
				^fragmentsOfItems: v tree items steps: ss amplets: amplets
			].
		v isKindOfString ifTrue: [ ^{v. } ].
		^{v printString. }
	)
	item: j fragment: f = (
		f attributes: f attributes , {{'data-item'. j. }. }.
		^f
	)
	join: strings with: separator = (
		| out ::= ''. |
		strings keysAndValuesDo: [:i :s |
				i > 1 ifTrue: [ out:: out , separator ].
				out:: out , s
			].
		^out
	)
	public libErrors: tree = (
		(* libErrors(tree) (Section 6): the errors of a tree, as the core's
errors(tree), together with those of the trees its blocks' fields hold, in
document order. *)
		
		| out = List new. |
		libErrorsOf: tree into: out.
		^out asArray
	)
	libErrorsOf: tree into: out = (
		tree flag = #unclosed ifTrue: [
				out add: (emmanuel MarkupError kind: #unclosedBlock data: tree messages)
			].
		tree flag = #rejected ifTrue: [
				out add: (emmanuel MarkupError kind: #rejectedBlock data: tree messages)
			].
		tree state stateValues do: [:v |
				v isKindOfTreeValue ifTrue: [ libErrorsOf: v tree into: out ]
			].
		tree items do: [:g |
				g kind = #sub ifTrue: [ libErrorsOf: g ref into: out ]
					ifFalse: [
						({#dnu. #stray. #rootPop. #refused. } includes: g kind) ifTrue: [
								out add: (emmanuel MarkupError kind: #errorLeaf data: g)
							]
					]
			]
	)
	noEdit: f = (
		(* f, which the editor does not let one type into. *)
		
		f attributes: f attributes , {{'contenteditable'. 'false'. }. }.
		^f
	)
	opened: x = (
		x = 'paragraph' ifTrue: [ ^Paragraph new ].
		x = 'emphasis' ifTrue: [ ^Emphasis new ].
		x = 'strong' ifTrue: [ ^Strong new ].
		x = 'strikethrough' ifTrue: [ ^TextStyle named: x tag: 's' ].
		x = 'subscript' ifTrue: [ ^TextStyle named: x tag: 'sub' ].
		x = 'superscript' ifTrue: [ ^TextStyle named: x tag: 'sup' ].
		x = 'code' ifTrue: [ ^InlineCode new ].
		x = 'list' ifTrue: [ ^BulletList new ].
		x = 'numberedList' ifTrue: [ ^NumberedList new ].
		x = 'item' ifTrue: [ ^Item new ].
		x = 'quote' ifTrue: [ ^Quote new ].
		x = 'table' ifTrue: [ ^Table new ].
		x = 'headerRow' ifTrue: [ ^HeaderRow new ].
		x = 'row' ifTrue: [ ^Row new ].
		x = 'cell' ifTrue: [ ^Cell new ].
		^Figure new
	)
	public openers = (
		^{'paragraph'. 'emphasis'. 'strong'. 'strikethrough'. 'subscript'. 'superscript'. 'code'. 'list'. 'numberedList'. 'item'. 'quote'. 'table'. 'headerRow'. 'row'. 'cell'. 'figure'. }
	)
	public pageMaxWidth: page = (
		(* The widest the view may lay a document out whose page is page (a
string, or nil for the window): a CSS width, or nil for no limit. *)
		
		page isNil ifTrue: [ ^nil ].
		page = 'screen' ifTrue: [ ^nil ].
		page = 'letter' ifTrue: [ ^'8.5in' ].
		page = 'a4' ifTrue: [ ^'210mm' ].
		page = 'slide' ifTrue: [ ^'1080px' ].
		((emmanuel codePointsOf: page) allSatisfy: [:c |
				(c between: 48 and: 57) or: [
						(c between: 97 and: 122) or: [ c = 46 or: [ c = 37 ] ]
					]
			]) ifTrue: [ ^page ].
		^nil
	)
	public pageStyleOf: page = (
		(* The CSS that lays a document out for its page: at most its width,
centered; paper with its margins, on a sheet; a slide a canvas 1080
pixels wide and at least 675 high (16:10), longer when its content is, which
the presenter zooms down to fit. *)
		
		| w = pageMaxWidth: page. |
		w isNil ifTrue: [ ^'' ].
		page = 'letter' ifTrue: [
				^' max-width: 8.5in; padding: 1in; box-sizing: border-box; margin: 0 auto; background-color: white; box-shadow: 0 0 6px #999;'
			].
		page = 'a4' ifTrue: [
				^' max-width: 210mm; padding: 25mm; box-sizing: border-box; margin: 0 auto; background-color: white; box-shadow: 0 0 6px #999;'
			].
		page = 'slide' ifTrue: [
				^' width: 1080px; min-height: 675px; padding: 12px 20px; box-sizing: border-box; flex: none;'
			].
		^' max-width: ' , w , '; margin: 0 auto;'
	)
	public styleClose: x = (
		(* The statement that closes the style x (Section 7.9). *)
		
		^unary: (closerOf: x)
	)
	public styleOpen: x = (
		(* The statement that opens the style x: emphasis, strong, underline,
strikethrough, subscript, superscript, or code. *)
		
		^unary: x
	)
	public template: x = (
		(* The items of the template of the opener x before the view's
caret: the opener, and for a table, a row of one cell. *)
		
		x = 'table' ifTrue: [ ^unaryItems: {'table'. 'row'. 'cell'. } ].
		^unaryItems: {x. }
	)
	public templateAfter: x = (
		(* The items of the template of x after the caret: its closer. *)
		
		x = 'table' ifTrue: [ ^unaryItems: {'endCell'. 'endRow'. 'endTable'. } ].
		^unaryItems: {closerOf: x. }
	)
	unary: x = (
		(* A unary send with no source: its span is [0, 0). *)
		
		^emmanuel SendStatement comments: {}
			selector: x
			arguments: {}
			span: (emmanuel Span from: 0 to: 0)
	)
	unaryItems: selectors = (
		^selectors collect: [:x |
				emmanuel Item text: nil span: nil statement: (unary: x)
			]
	)
) : ()
