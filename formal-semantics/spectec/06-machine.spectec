;; Section 7: the operational rules. Allocation is fresh-choice relational;
;; no deterministic allocator/counter is silently imposed on the LaTeX.

;; @equation eq:request-resolution
relation RequestResolution: (runtimeProgram, runtimeHeap, actid) |- (request, message) => (dispatchresult)
rule RequestResolution/ordinary:
  (RP, RH, a) |- (ORDINARYREQUEST o, mu) => (dr)
  -- if ~$closureCall(RH, o, mu)
  -- OrdinaryDispatch: ($lookupProgramView(RP), $lookupHeapView(RP, RH)) |- (o, mu) => (dr)
rule RequestResolution/implicit:
  (RP, RH, a) |- (IMPLICITREQUEST binding D, mu) => (dr)
  -- ImplicitDispatch: ($lookupProgramView(RP), $lookupHeapView(RP, RH), a, D) |- (binding, mu) => (dr)
rule RequestResolution/outer:
  (RP, RH, a) |- (OUTERREQUEST D_t D_0, mu) => (dr)
  -- OuterDispatch: ($lookupProgramView(RP), $lookupHeapView(RP, RH), a) |- (D_t, D_0, mu) => (dr)
rule RequestResolution/self:
  (RP, RH, a) |- (SELFREQUEST D, mu) => (dr)
  -- SelfDispatch: ($lookupProgramView(RP), $lookupHeapView(RP, RH), a) |- (D, mu) => (dr)
rule RequestResolution/super:
  (RP, RH, a) |- (SUPERREQUEST, mu) => (dr)
  -- SuperDispatch: ($lookupProgramView(RP), $lookupHeapView(RP, RH), a) |- (mu) => (dr)

relation MachineStep: (runtimeProgram) |- (machine) => (machine)
;; @rule Send-Receiver
rule MachineStep/Send-Receiver:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL SEND e s e'* }) =>
           ({ HEAP RH, STACK AS (a, pi (RECVFRAME s e'*)), CONTROL e })
;; @rule Send-No-Args
rule MachineStep/Send-No-Args:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL e }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL DISPATCH theta (s eps) })
  -- if $isRequestExpression(e)
  -- if $constructRequest(e) = (theta, s, eps)
;; @rule Send-First-Arg
rule MachineStep/Send-First-Arg:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL e_s }) =>
           ({ HEAP RH, STACK AS (a, pi (ARGSFRAME theta s eps e'*)), CONTROL e })
  -- if $isRequestExpression(e_s)
  -- if $constructRequest(e_s) = (theta, s, e e'*)
;; @equation eq:receiver-continuations
rule MachineStep/receiver-empty:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (RECVFRAME s eps)), CONTROL VALUE o }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL DISPATCH (ORDINARYREQUEST o) (s eps) })
;; @equation eq:receiver-continuations
rule MachineStep/receiver-first:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (RECVFRAME s (e e'*))), CONTROL VALUE o }) =>
           ({ HEAP RH, STACK AS (a, pi (ARGSFRAME (ORDINARYREQUEST o) s eps e'*)), CONTROL e })
;; @equation eq:argument-continuations
rule MachineStep/argument-next:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (ARGSFRAME theta s o* (e e'*))), CONTROL VALUE o' }) =>
           ({ HEAP RH, STACK AS (a, pi (ARGSFRAME theta s (o* o') e'*)), CONTROL e })
;; @equation eq:argument-continuations
rule MachineStep/argument-last:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (ARGSFRAME theta s o* eps)), CONTROL VALUE o' }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL DISPATCH theta (s (o* o')) })
;; @rule Self-Value
rule MachineStep/Self-Value:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL SELF }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL VALUE $runtimeActivationAt(RH, a).RECEIVER })
;; @rule Resolve
rule MachineStep/Resolve:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL DISPATCH theta mu }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL dt })
  -- RequestResolution: (RP, RH, a) |- (theta, mu) => ($dispatchControlView(dt))
  -- if dt = $captureDispatch(RP, RH, $dispatchControlView(dt))
;; @rule Closure-Value
rule MachineStep/Closure-Value:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL DISPATCH (ORDINARYREQUEST (CLOSUREREF c)) mu }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL CALLCLOSURE c mu })
  -- if $closureCall(RH, CLOSUREREF c, mu)

;; Lift the DNU rule's heap change into the sequential configuration.
rule MachineStep/dnu-step:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL MISSINGCONTROL o C_0 mu }) =>
           ({ HEAP RH', STACK AS (a, pi), CONTROL t })
  -- if t = CALLMETHOD mf o C_f ("doesNotUnderstand:" (MIRRORREF g))
  -- DnuAllocation: (RP, RH) |- (o, C_0, mu, g) => (RH', t)
;; @rule Closure-New
rule MachineStep/Closure-New:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CLOSURELITERAL q param* lg* st* }) =>
           ({ HEAP RH', STACK AS (a, pi), CONTROL VALUE (CLOSUREREF c) })
  -- if ~$runtimeLive(RH, CLOSUREREF c)
  -- if RH' = $putClosure(RH, c, $captureClosure(RH, a, q, param*, lg*, st*))

;; @rule Invoke-NonTail
rule MachineStep/Invoke-NonTail:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CALLMETHOD mf o C mu }) =>
           ({ HEAP RH', STACK AS (a, pi) (a', eps),
              CONTROL INITIALIZE a' mf.LOCALS mf.BODY (METHODBODY o) })
  -- if pi =/= eps
  -- if ~$runtimeLive(RH, ACTIVATIONREF a')
  -- if $methodMessageCompatible(mf, mu)
  -- if RH' = $newMethodActivation(RH, a', mf, o, C, mu, $calleeContinuation(RH, a, pi))
;; @rule Invoke-Tail
rule MachineStep/Invoke-Tail:
  (RP) |- ({ HEAP RH, STACK AS (a, eps), CONTROL CALLMETHOD mf o C mu }) =>
           ({ HEAP RH', STACK AS (a', eps),
              CONTROL INITIALIZE a' mf.LOCALS mf.BODY (METHODBODY o) })
  -- if ~$runtimeLive(RH, ACTIVATIONREF a')
  -- if $methodMessageCompatible(mf, mu)
  -- if RH' = $newMethodActivation(RH, a', mf, o, C, mu, $calleeContinuation(RH, a, eps))
;; @rule Closure-Invoke-NonTail
rule MachineStep/Closure-Invoke-NonTail:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CALLCLOSURE c (s o*) }) =>
           ({ HEAP RH', STACK AS (a, pi) (a', eps), CONTROL t })
  -- if pi =/= eps
  -- if ~$runtimeLive(RH, ACTIVATIONREF a')
  -- if $closureCall(RH, CLOSUREREF c, (s o*))
  -- if rb = $checkedClosureCall(RH, c, (s o*))
  -- if |rb.FORMALS| = |o*|
  -- if t = INITIALIZE a' rb.LOCALS rb.BODY CLOSUREBODY
  -- if RH' = $newClosureActivation(RH, a', c, o*, $calleeContinuation(RH, a, pi))
;; @rule Closure-Invoke-Tail
rule MachineStep/Closure-Invoke-Tail:
  (RP) |- ({ HEAP RH, STACK AS (a, eps), CONTROL CALLCLOSURE c (s o*) }) =>
           ({ HEAP RH', STACK AS (a', eps), CONTROL t })
  -- if ~$runtimeLive(RH, ACTIVATIONREF a')
  -- if $closureCall(RH, CLOSUREREF c, (s o*))
  -- if rb = $checkedClosureCall(RH, c, (s o*))
  -- if |rb.FORMALS| = |o*|
  -- if t = INITIALIZE a' rb.LOCALS rb.BODY CLOSUREBODY
  -- if RH' = $newClosureActivation(RH, a', c, o*, $calleeContinuation(RH, a, eps))

;; Sequential declarations; simultaneous expansion is in 08-class-machine.
;; @equation eq:local-init-empty
rule MachineStep/local-init-empty:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITIALIZE a eps st* tau }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL BODYCONTROL tau st* })
def $eagerLocalExpression(localdecl) : coreexpr
def $eagerLocalExpression(LOCALIMMUTABLE j e) = e
def $eagerLocalExpression(LOCALMUTABLE j e) = e
def $nilInitializedLocal(localdecl) : bool
def $nilInitializedLocal(LOCALUNINITIALIZED j) = true
def $nilInitializedLocal(LOCALLAZYIMMUTABLE j e) = true
def $nilInitializedLocal(LOCALLAZYMUTABLE j e) = true
def $nilInitializedLocal(LOCALIMMUTABLE j e) = false
def $nilInitializedLocal(LOCALMUTABLE j e) = false
;; @equation eq:local-init-start
rule MachineStep/local-init-start:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITIALIZE a ((LOCALSEQUENTIAL ld) lg*) st* tau }) =>
           ({ HEAP RH, STACK AS (a, pi (INITFRAME $localIdentity(ld) lg* st* tau)), CONTROL e })
  -- if ~$nilInitializedLocal(ld)
  -- if e = $eagerLocalExpression(ld)
;; @equation eq:local-init-commit
rule MachineStep/local-init-commit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (INITFRAME j lg* st* tau)), CONTROL VALUE o }) =>
           ({ HEAP $writeLocalValue(RH, a, j, o), STACK AS (a, pi), CONTROL INITIALIZE a lg* st* tau })
;; @equation eq:local-init-nil
rule MachineStep/local-init-nil:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITIALIZE a ((LOCALSEQUENTIAL ld) lg*) st* tau }) =>
           ({ HEAP $writeLocalValue(RH, a, $localIdentity(ld), $nilValue(RP)),
              STACK AS (a, pi), CONTROL INITIALIZE a lg* st* tau })
  -- if $nilInitializedLocal(ld)
;; @equation eq:local-slot-operations
rule MachineStep/local-read:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL READLOCAL a_0 j }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL VALUE o })
  -- if $readLocalValue(RH, a_0, j) = LOCALVALUE o
;; @equation eq:local-slot-operations
rule MachineStep/local-write-start:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL WRITELOCAL a_0 j e }) =>
           ({ HEAP RH, STACK AS (a, pi (LOCALWRITEFRAME a_0 j)), CONTROL e })
;; @equation eq:local-slot-operations
rule MachineStep/local-write-commit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (LOCALWRITEFRAME a_0 j)), CONTROL VALUE o }) =>
           ({ HEAP $writeLocalValue(RH, a_0, j, o), STACK AS (a, pi), CONTROL VALUE o })

;; @equation eq:empty-body
rule MachineStep/empty-body:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL BODYCONTROL tau eps }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL FINISH $emptyBodyResult(RP, tau) })
;; @equation eq:nonempty-body
rule MachineStep/nonempty-body:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL BODYCONTROL tau (st st'*) }) =>
           ({ HEAP RH, STACK AS (a, pi'), CONTROL e })
  -- if $startStatement(pi (SEQFRAME tau st'*), st) = (pi', e)
;; @equation eq:statement-continuations
rule MachineStep/statement-last:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (SEQFRAME tau eps)), CONTROL VALUE o }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL FINISH $lastBodyResult(tau, o) })
;; @equation eq:statement-continuations
rule MachineStep/statement-next:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (SEQFRAME tau (st st'*))), CONTROL VALUE o }) =>
           ({ HEAP RH, STACK AS (a, pi'), CONTROL e })
  -- if $startStatement(pi (SEQFRAME tau st'*), st) = (pi', e)
;; @rule Return-Value
rule MachineStep/Return-Value:
  (RP) |- ({ HEAP RH, STACK AS (a, pi RETURNFRAME), CONTROL VALUE o }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL TRANSFER $returnTarget(RH, a) o })
;; @rule Finish-Resume
rule MachineStep/Finish-Resume:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL FINISH o }) =>
           ({ HEAP $severContinuation(RH, a), STACK AS', CONTROL VALUE o })
  -- if $runtimeActivationAt(RH, a).CONTINUATION = CONT a_c
  -- if AS' = $resumeStack(AS (a, pi), a_c)
;; @rule Finish-Halt
rule MachineStep/Finish-Halt:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL FINISH o }) =>
           ({ HEAP $severContinuation(RH, a), STACK eps, CONTROL HALT o })
  -- if $runtimeActivationAt(RH, a).CONTINUATION = NOCONT

;; Save the target's continuation BEFORE marking all its heap dependents.
;; Marking includes suspended/off-stack activations, not just a stack suffix.
;; @rule Return-Transfer
rule MachineStep/Return-Transfer:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL TRANSFER (CONT a_t) o }) =>
           ({ HEAP $markUncontinuable(RH, a_t), STACK AS', CONTROL VALUE o })
  -- if CONT a_t = $returnTarget(RH, a)
  -- if $runtimeActivationAt(RH, a_t).CONTINUATION = CONT a_c
  -- if AS' = $resumeStack(AS (a, pi), a_c)
;; @partial Return-Cannot
rule MachineStep/Return-Cannot:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL TRANSFER (CONT a_t) o }) =>
           ({ HEAP $markUncontinuable(RH, a_t), STACK AS (a, pi), CONTROL CANNOTRETURN })
  -- if CONT a_t = $returnTarget(RH, a)
  -- if $runtimeActivationAt(RH, a_t).CONTINUATION = NOCONT
;; TRANSFER NOCONT (a top-created closure without a method home) remains an
;; explicit boundary obligation, not a fabricated nil activation record.
