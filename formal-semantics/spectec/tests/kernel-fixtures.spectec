;; Non-normative test catalog for the kernel layer. A real VM supplies its own
;; NativeTransform rules; these three exist only to exercise the three outcomes.
;; NID 0 answers its receiver, NID 1 tail-sends "echo" to its argument, and
;; NID 2 fails with WRONGKIND 1.
rule NativeTransform/test-answer-receiver:
  (RP, RH) |- (NID 0, o, eps) => (NATIVEANSWER RH o)
rule NativeTransform/test-forward-echo:
  (RP, RH) |- (NID 1, o, o') => (NATIVETAILSEND RH o' ("echo" eps))
rule NativeTransform/test-fail:
  (RP, RH) |- (NID 2, o, o') => (NATIVEFAIL (WRONGKIND 1))

def $nativeMethod(methodid, selector, parameterid*, nativeid) : fullmethod
def $nativeMethod(i, s, param*, nu) = {
  ID i, SELECTOR s, ACCESS PUBLIC, FORMALS param*, LOCALS eps,
  BODY (NATIVESTMT nu), OWNER CD 1
}
def $nativeAnswer : fullmethod
def $nativeAnswer = $nativeMethod(MD 50, "yourself", eps, NID 0)
def $nativeForward : fullmethod
def $nativeForward = $nativeMethod(MD 51, "forward:", PID 0, NID 1)
def $nativeFailing : fullmethod
def $nativeFailing = $nativeMethod(MD 52, "fail:", PID 0, NID 2)
