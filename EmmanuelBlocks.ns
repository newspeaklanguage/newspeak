Newspeak3
'Emmanuel'
class EmmanuelBlocks usingPlatform: p emmanuel: em = (
	(* The standard block library of Emmanuel (Section 6 of the specification,
formal-semantics/emmanuel/spectec/library/07-library.spectec): one
DocumentBlock subclass per kind of block, and, for each, the Hopscotch
presenter that renders it.

A block's protocol is its content model: model lists the messages it
understands. Receiving one answers an effect: openers push a new block,
closers pop, newline and the displays (verbatim:, codeBlock:, html:) add
leaves, and the inline-argument messages (section:, title:, subtitle:,
author:, attribution:, caption:) take a markup literal, interpreted with an
inline root, or a string.

A symbol is a string literal, so labels and languages, written as symbols
(#intro), are Strings like any other string argument.

Rendering: a block names its presenter (presenterOn:). A presenter renders
its tree as an ElementFragment, an HTML element whose children are text and
the presenters of the subtrees. *)
	
	|
		private List = p collections List.
		private emmanuel = em.
		private DocumentBlock = em DocumentBlock.
		private Fragment = p hopscotch Fragment.
		private Presenter = p hopscotch Presenter.
		private Subject = p hopscotch Subject.
		private domDocument = p js global at: #document.
	|
) (
	public class BlockPresenter onSubject: s = Presenter onSubject: s (
		(* Renders a tree: an element with the block's tag and style, holding the
tree's children. Subclasses add what the block's fields show. *)
		
	) (
		block = (
			^tree state
		)
		childFragments = (
			^fragmentsOfItems: tree items
		)
		definition = (
			^ElementFragment tag: block htmlTag
				style: (styleOf: block)
				children: leadingFragments , childFragments , trailingFragments
		)
		public isKindOfEmmanuelBlockPresenter = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelBlockPresenter
		)
		leadingFragments = (
			^{}
		)
		styleOf: b = (
			tree flag = #unclosed ifTrue: [ ^b htmlStyle , ' outline: 1px dashed red;' ].
			tree flag = #rejected ifTrue: [ ^b htmlStyle , ' outline: 1px solid red;' ].
			^b htmlStyle
		)
		trailingFragments = (
			^{}
		)
		tree = (
			^subject tree
		)
	) : ()
	public class BulletList new = LibraryBlock new (
	) (
		public htmlTag = (
			^'ul'
		)
		public model = (
			^{'item'. 'endList'. }
		)
		public stateName = (
			^'list'
		)
	) : ()
	public class Cell new = LibraryBlock new (
	) (
		public contentClass = (
			^#cell
		)
		public htmlTag = (
			^'td'
		)
		public model = (
			^flowContent , inlineContent , {'endCell'. }
		)
		public stateName = (
			^'cell'
		)
	) : ()
	public class CodeDisplay text: t language: l = LibraryBlock new (
		(* codeBlock: and codeBlock:language:, a leaf. *)
		
		|
			public text = t.
			public language = l.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: text statement: messages first index: 0. }
		)
		public htmlTag = (
			^'pre'
		)
		public presenterOn: s = (
			^TextBlockPresenter onSubject: s
		)
		public stateName = (
			^'codeBlock'
		)
		public stateValues = (
			^{text. language. }
		)
	) : ()
	public class DocumentPresenter onSubject: s = BlockPresenter onSubject: s (
		(* A document shows its title, subtitle, and authors before its body. *)
		
	) (
		leadingFragments = (
			| out = List new. |
			block title isNil ifFalse: [
					out add: (ElementFragment tag: 'h1'
							style: ''
							children: (fragmentsOfValue: block title))
				].
			block subtitle isNil ifFalse: [
					out add: (ElementFragment tag: 'h2'
							style: 'font-weight: normal;'
							children: (fragmentsOfValue: block subtitle))
				].
			block authors do: [:a |
					out add: (ElementFragment tag: 'div'
							style: 'font-style: italic;'
							children: (fragmentsOfValue: a))
				].
			^out asArray
		)
	) : ()
	public class DocumentRoot title: t subtitle: st authors: as = LibraryBlock new (
		(* The root block of a document: its title, subtitle, and authors. *)
		
		|
			public title = t.
			public subtitle = st.
			public authors = as.
		|
	) (
		authorFields: messages = (
			(* A field for each author, from the author: messages in order. *)
			
			| sends = withSelector: 'author:' in: messages. |
			^(1 to: authors size) asArray collect: [:i |
					emmanuel Field value: (authors at: i) statement: (sends at: i) index: 0
				]
		)
		depth = (
			^0
		)
		public fields: messages = (
			^(fieldFor: title selector: 'title:' messages: messages) , (fieldFor: subtitle
				selector: 'subtitle:'
				messages: messages) , (authorFields: messages)
		)
		free: x = (
			x = 'title:' ifTrue: [ ^title isNil ].
			x = 'subtitle:' ifTrue: [ ^subtitle isNil ].
			^true
		)
		public htmlTag = (
			^'article'
		)
		public model = (
			^flowContent , {'section:'. 'title:'. 'subtitle:'. 'author:'. }
		)
		public presenterOn: s = (
			^DocumentPresenter onSubject: s
		)
		public stateName = (
			^'doc'
		)
		public stateValues = (
			^{title. subtitle. } , authors
		)
		with: x value: v hostState: chi = (
			x = 'title:' ifTrue: [
					^mutate: (DocumentRoot title: v subtitle: subtitle authors: authors)
						hostState: chi
				].
			x = 'subtitle:' ifTrue: [
					^mutate: (DocumentRoot title: title subtitle: v authors: authors)
						hostState: chi
				].
			x = 'author:' ifTrue: [
					^mutate: (DocumentRoot title: title
							subtitle: subtitle
							authors: (authors copyWith: v))
						hostState: chi
				].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^title: nil subtitle: nil authors: {}
		)
	)
	public class ElementFragment tag: t style: st children: cs = Fragment new (
		(* An HTML element with a tag and a style, whose children are text
(Strings) and fragments. Unlike an HTMLFragment it is not wrapped in a
document body, so it can be inline. *)
		
		|
			public tag = t.
			public style = st.
			public children = cs.
			public rawHTML ::= nil.
		|
	) (
		public childrenDo: action = (
			children do: [:c | c isKindOfString ifFalse: [ action value: c ] ]
		)
		createVisual = (
			| element = domDocument createElement: tag. |
			(style isNil or: [ style isEmpty ]) ifFalse: [
					element setAttribute: 'style' to: style
				].
			rawHTML isNil ifFalse: [ element at: 'innerHTML' put: rawHTML ].
			children do: [:c |
					c isKindOfString ifTrue: [
							element appendChild: (domDocument createTextNode: c)
						]
						ifFalse: [
							c parent: self.
							element appendChild: c visual
						]
				].
			^element
		)
		public isKindOfEmmanuelElementFragment = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelElementFragment
		)
		updateVisualsFromSameKind: oldFragment = (
			(* Rendering is read-only for now: a new element replaces the old. *)
			
			^replaceVisual: oldFragment visual with: visual
		)
	) : ()
	public class Emphasis new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'em'
		)
		public model = (
			^inlineContent , {'endEmphasis'. }
		)
		public stateName = (
			^'emph'
		)
	) : ()
	public class Figure caption: c label: l = LibraryBlock new (
		|
			public caption = c.
			public label = l.
		|
	) (
		public fields: messages = (
			^fieldFor: caption selector: 'caption:' messages: messages
		)
		free: x = (
			x = 'caption:' ifTrue: [ ^caption isNil ].
			^true
		)
		public htmlTag = (
			^'figure'
		)
		public isLabelled = (
			^true
		)
		public model = (
			^displays , {'caption:'. 'label:'. 'endFigure'. }
		)
		public presenterOn: s = (
			^FigurePresenter onSubject: s
		)
		public relabel: v = (
			^Figure caption: caption label: v
		)
		public stateName = (
			^'figure'
		)
		public stateValues = (
			^{caption. label. }
		)
		with: x value: v hostState: chi = (
			x = 'caption:' ifTrue: [
					^mutate: (Figure caption: v label: label) hostState: chi
				].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^caption: nil label: nil
		)
	)
	public class FigurePresenter onSubject: s = BlockPresenter onSubject: s (
	) (
		trailingFragments = (
			block caption isNil ifTrue: [ ^{} ].
			^{ElementFragment tag: 'figcaption'
				style: ''
				children: (fragmentsOfValue: block caption). }
		)
	) : ()
	public class HeaderRow new = LibraryBlock new (
	) (
		public htmlStyle = (
			^'font-weight: bold;'
		)
		public htmlTag = (
			^'tr'
		)
		public model = (
			^{'cell'. 'endRow'. }
		)
		public stateName = (
			^'headerRow'
		)
	) : ()
	public class Html text: t = LibraryBlock new (
		(* html:, a leaf. *)
		
		|
			public text = t.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: text statement: messages first index: 0. }
		)
		public presenterOn: s = (
			^HtmlPresenter onSubject: s
		)
		public stateName = (
			^'html'
		)
		public stateValues = (
			^{text. }
		)
	) : ()
	public class HtmlPresenter onSubject: s = BlockPresenter onSubject: s (
	) (
		definition = (
			^(ElementFragment tag: 'div' style: '' children: {}) rawHTML: block text;
				yourself
		)
	) : ()
	public class InlineCode new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'code'
		)
		public model = (
			^inlineContent , {'endCode'. }
		)
		public stateName = (
			^'code'
		)
	) : ()
	public class InlineRoot new = LibraryBlock new (
		(* The root of an inline argument, such as a title. *)
		
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'span'
		)
		public model = (
			^inlineContent
		)
		public stateName = (
			^'inline'
		)
	) : ()
	public class Item new = LibraryBlock new (
	) (
		public htmlTag = (
			^'li'
		)
		public model = (
			^flowContent , {'endItem'. }
		)
		public stateName = (
			^'item'
		)
	) : ()
	public class LibraryBlock new = DocumentBlock new (
		(* The behaviour the library's blocks share: the rules of Section 6.
Subclasses give their state (stateName, stateValues), content class,
content model, and rendering (htmlTag, htmlStyle, presenterOn:), and
override free:, with:value:hostState:, and relabel: for the messages that
change their fields. *)
		
	) (
		public contentClass = (
			^#flow
		)
		depth = (
			^Error signal: 'no depth: ' , stateName
		)
		displays = (
			^{'verbatim:'. 'codeBlock:'. 'codeBlock:language:'. 'html:'. }
		)
		effect: kind hostState: chi = (
			^emmanuel Effect kind: kind block: nil hostState: chi
		)
		public effectOf: x args: vs hostState: chi machine: m = (
			(understands: x) ifFalse: [ ^effect: #notUnderstood hostState: chi ].
			((inlineArgs includes: x) and: [ vs size = 1 ]) ifTrue: [
					^inline: x argument: vs first hostState: chi machine: m
				].
			^plain: x args: vs hostState: chi
		)
		fieldFor: v selector: x messages: messages = (
			(* The field of a value set by the message x, if it is set. *)
			
			v isNil ifTrue: [ ^{} ].
			^{emmanuel Field value: v
				statement: (withSelector: x in: messages) first
				index: 0. }
		)
		flowContent = (
			^displays , {'paragraph'. 'list'. 'numberedList'. 'quote'. 'table'. 'figure'. }
		)
		free: x = (
			^true
		)
		public htmlStyle = (
			^''
		)
		public htmlTag = (
			^'div'
		)
		inline: x argument: v hostState: chi machine: m = (
			(* Lib-Inline: a markup literal is interpreted with an inline root; a
string is taken as it is; anything else is refused. *)
			
			| done |
			(free: x) ifFalse: [ ^effect: #refuse hostState: chi ].
			v isKindOfMarkupLiteral ifTrue: [
					done:: m interpretLiteral: v root: InlineRoot new hostState: chi.
					done isKindOfRaised ifTrue: [ ^done ].
					^with: x
						value: (emmanuel TreeValue literal: v tree: done tree)
						hostState: done hostState
				].
			(v isKindOfTreeValue or: [ v isKindOfString ]) ifTrue: [
					^with: x value: v hostState: chi
				].
			^effect: #refuse hostState: chi
		)
		inlineArgs = (
			^{'section:'. 'title:'. 'subtitle:'. 'author:'. 'attribution:'. 'caption:'. }
		)
		inlineContent = (
			^{'emphasis'. 'strong'. 'code'. 'newline'. }
		)
		public isLabelled = (
			^false
		)
		public joins = (
			^{'para'. 'emph'. 'strong'. 'code'. 'list'. 'numbered'. 'item'. } includes: stateName
		)
		leaf: block hostState: chi = (
			^emmanuel Effect kind: #leaf block: block hostState: chi
		)
		public model = (
			^{}
		)
		mutate: block hostState: chi = (
			^emmanuel Effect kind: #mutate block: block hostState: chi
		)
		plain: x args: vs hostState: chi = (
			| v |
			vs isEmpty ifTrue: [
					(openers includes: x) ifTrue: [
							^emmanuel Effect kind: #push block: (opened: x) hostState: chi
						].
					(closers includes: x) ifTrue: [ ^effect: #pop hostState: chi ].
					x = 'newline' ifTrue: [ ^leaf: Newline new hostState: chi ]
				].
			vs size = 1 ifTrue: [
					v:: vs first.
					x = 'verbatim:' ifTrue: [
							^v isKindOfString ifTrue: [ leaf: (Verbatim text: v) hostState: chi ]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'html:' ifTrue: [
							^v isKindOfString ifTrue: [ leaf: (Html text: v) hostState: chi ]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'codeBlock:' ifTrue: [
							^v isKindOfString ifTrue: [
									leaf: (CodeDisplay text: v language: 'newspeak') hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'label:' ifTrue: [
							^(isLabelled and: [ label isNil and: [ v isKindOfString ] ]) ifTrue: [
									mutate: (relabel: v) hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						]
				].
			(vs size = 2 and: [ x = 'codeBlock:language:' ]) ifTrue: [
					^(vs first isKindOfString and: [ vs last isKindOfString ]) ifTrue: [
							leaf: (CodeDisplay text: vs first language: vs last) hostState: chi
						]
						ifFalse: [ effect: #refuse hostState: chi ]
				].
			^effect: #refuse hostState: chi
		)
		public presenterOn: s = (
			^BlockPresenter onSubject: s
		)
		public splitsAtEnter = (
			^{'para'. 'item'. } includes: stateName
		)
		public understands: x = (
			^model includes: x
		)
		with: x value: v hostState: chi = (
			x = 'section:' ifTrue: [
					^emmanuel Effect kind: #push
						block: (Section depth: depth + 1 heading: v label: nil)
						hostState: chi
				].
			^Error signal: 'no field for ' , x
		)
		withSelector: x in: messages = (
			(* The messages that are sends of x. *)
			
			^(messages select: [:s | s isComment not and: [ s selector = x ] ]) asArray
		)
	) : ()
	public class Newline new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'br'
		)
		public stateName = (
			^'newline'
		)
	) : ()
	public class NumberedList new = LibraryBlock new (
	) (
		public htmlTag = (
			^'ol'
		)
		public model = (
			^{'item'. 'endNumberedList'. }
		)
		public stateName = (
			^'numbered'
		)
	) : ()
	public class Paragraph new = LibraryBlock new (
	) (
		public contentClass = (
			^#para
		)
		public htmlTag = (
			^'p'
		)
		public model = (
			^inlineContent , {'endParagraph'. }
		)
		public stateName = (
			^'para'
		)
	) : ()
	public class Quote attribution: a = LibraryBlock new (
		|
			public attribution = a.
		|
	) (
		public fields: messages = (
			^fieldFor: attribution selector: 'attribution:' messages: messages
		)
		free: x = (
			x = 'attribution:' ifTrue: [ ^attribution isNil ].
			^true
		)
		public htmlTag = (
			^'blockquote'
		)
		public model = (
			^flowContent , {'attribution:'. 'endQuote'. }
		)
		public presenterOn: s = (
			^QuotePresenter onSubject: s
		)
		public stateName = (
			^'quote'
		)
		public stateValues = (
			^{attribution. }
		)
		with: x value: v hostState: chi = (
			x = 'attribution:' ifTrue: [ ^mutate: (Quote attribution: v) hostState: chi ].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^attribution: nil
		)
	)
	public class QuotePresenter onSubject: s = BlockPresenter onSubject: s (
	) (
		trailingFragments = (
			block attribution isNil ifTrue: [ ^{} ].
			^{ElementFragment tag: 'footer'
				style: ''
				children: {'— '. } , (fragmentsOfValue: block attribution). }
		)
	) : ()
	public class Row new = LibraryBlock new (
	) (
		public htmlTag = (
			^'tr'
		)
		public model = (
			^{'cell'. 'endRow'. }
		)
		public stateName = (
			^'row'
		)
	) : ()
	public class Section depth: d heading: h label: l = LibraryBlock new (
		(* A section: its depth (1 at the top), heading, and label. *)
		
		|
			public depth = d.
			public heading = h.
			public label = l.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: heading statement: messages first index: 0. }
		)
		public htmlTag = (
			^'section'
		)
		public isLabelled = (
			^true
		)
		public model = (
			^flowContent , {'section:'. 'label:'. 'endSection'. }
		)
		public presenterOn: s = (
			^SectionPresenter onSubject: s
		)
		public relabel: v = (
			^Section depth: depth heading: heading label: v
		)
		public stateName = (
			^'section'
		)
		public stateValues = (
			^{depth. heading. label. }
		)
	) : ()
	public class SectionPresenter onSubject: s = BlockPresenter onSubject: s (
		(* A section shows its heading, at its depth. *)
		
	) (
		leadingFragments = (
			^{ElementFragment tag: 'h' , (block depth + 1 min: 6) printString
				style: ''
				children: (fragmentsOfValue: block heading). }
		)
	) : ()
	public class Strong new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'strong'
		)
		public model = (
			^inlineContent , {'endStrong'. }
		)
		public stateName = (
			^'strong'
		)
	) : ()
	public class Table label: l = LibraryBlock new (
		|
			public label = l.
		|
	) (
		public htmlStyle = (
			^'border-collapse: collapse;'
		)
		public htmlTag = (
			^'table'
		)
		public isLabelled = (
			^true
