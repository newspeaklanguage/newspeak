Newspeak3
'NS2PrimordialSoup'
class BodyPrintProbe packageUsing: manifest = Object new (
	(* Print a class BODY read from a file, via prettyPrintClassBody: -- the
   entry point Documents>>classSource uses on every save.

   Usage: BodyPrintProbe <file-holding-a-class-body>

   Lets a document's class body be printed without a browser, so that what a
   save would store can be diffed against what is stored now. Not built by
   tool/build.sh; from the primordialsoup directory:

     ./out/ReleaseX64/primordialsoup ./out/snapshots/WebCompiler.vfuel \
       ./newspeak/*.ns $NEWSPEAK/NewspeakASTs.ns \
       $NEWSPEAK/NewspeakPrettyPrinter.ns $NEWSPEAK/tool/BodyPrintProbe.ns \
       RuntimeWithMirrorsForPrimordialSoup BodyPrintProbe \
       ./out/snapshots/BodyPrintProbe.vfuel *)
	
	|
		NewspeakASTs = manifest NewspeakASTs.
		NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
		MetadataParsing = manifest MetadataParsing.
		NewspeakPrettyPrinter = manifest NewspeakPrettyPrinter.
	|
) (
	decodeUtf8: bytes = (
		^String withAll: bytes
	)
	public main: platform args: args = (
		| asts parser cp md pp |
		asts:: NewspeakASTs usingPlatform: platform.
		parser:: NewspeakPredictiveParsing usingPlatform: platform asts: asts.
		cp:: parser CommonParser new.
		md:: MetadataParsing usingPlatform: platform scannerClass: parser Scanner.
		pp:: NewspeakPrettyPrinter usingPlatform: platform
			ast: asts
			parser: cp
			metadata: md
			memberOrder: [:a :b | platform mirrors memberNameLessOrEqual: a than: b ].
		(pp prettyPrintClassBody: (readFileAsString: (args at: 1))) out
	)
	readFileAsBytes: filename = (
		(* :literalmessage: primitive: 130 *)
		
		halt
	)
	readFileAsString: path = (
		^decodeUtf8: (readFileAsBytes: path)
	)
) : ()
