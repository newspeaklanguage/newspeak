Newspeak3
'Newspeak'
class NewspeakTypecheckerTestingConfiguration packageTestsUsing: manifest = Object new (
	(* Testing configuration of NS typechecker. *)
	
	|
		NewspeakASTs = manifest NewspeakASTs.
		NewspeakTypechecker = manifest NewspeakTypechecker.
		NewspeakTypecheckerTesting = manifest NewspeakTypecheckerTesting.
		manifest_namespace = manifest asMap.
	|
) (
	public testModulesUsingPlatform: platform <Platform> minitest: minitest <Minitest> ^<{NewspeakTypecheckerTesting}> = (
		(* Hand the test module a typechecker FACTORY rather than an instance, so each
	   test can build its own over its own namespace. *)
		
		| astModule <NewspeakASTs> = NewspeakASTs usingPlatform: platform. namespace <Map[Symbol, Behavior]> = manifest_namespace select: [:e |
				e isKindOfBehavior
			]. |
		^{NewspeakTypecheckerTesting usingPlatform: platform
			typecheckerFactory: [:ns <Map> |
				NewspeakTypechecker usingPlatform: platform ast: astModule namespace: ns
			]
			namespace: namespace
			testFramework: minitest. }
	)
) : ()