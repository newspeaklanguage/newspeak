Newspeak3
'Emmanuel'
class EmmanuelDeckProbeApp packageUsing: manifest = (
	(* Boots the IDE in the page, for tool/emmanuel-deck-probe.py, which loads
document zips into it in headless Chrome and drives them.

It defines two JavaScript functions: deckLoad(jszip, name) loads a document
zip as the IDE does and leaves 'loaded NAME' or 'failed ...' in the global
deckResult; deckOpen(name) shows the document in the IDE's window. *)
	
	|
		private ideApp = manifest HopscotchWebIDE packageUsing: manifest.
	|
) (
	public main: platform args: args = (
		| global = platform js global. ide = ideApp ideUsingPlatform: platform. |
		ideApp augmentNamespace: ide namespacing Root withPlatform: platform local.
		ide setupNames.
		ide launch: ide browsing HomeSubject new.
		global at: #deckLoad
			put: [:jsz :n |
				| ns = ide browsing NamespaceSubject onModel: ide namespacing Root
					key: 'probe'. |
				ide documents loadDocument: jsz
					named: n
					into: ns
					ifSuccess: [
						global at: #deckResult put: 'loaded ' , n.
						nil
					]
					ifFailure: [:e |
						global at: #deckResult put: 'failed ' , e printString.
						nil
					].
				nil
			].
		global at: #deckOpen
			put: [:n |
				ide browsing navigateTo: (ide documents DocumentSubject onModel: (ide namespacing Root at: n)).
				nil
			].
		(global at: #console) log: 'deck-probe-ready'
	)
) : ()
