Newspeak3
'Root'
class HopscotchListPlanningTesting usingPlatform: p minitest: m hopscotchClass: HopscotchClass = Object new (
	(* Headless tests for SequencePlanning, which holds the decisions behind
Hopscotch's sequence composers: which elements of a refreshed sequence
correspond to which of the old, which of them therefore need moving in the DOM,
and which slice of a long sequence a virtualized column should realize.

Hopscotch itself cannot run headlessly - it needs a document, a window and a
graphics platform. SequencePlanning needs none of those, which is exactly why it
is a separate class. We still have to instantiate the module to reach it, so we
hand HopscotchForHTML5 a stub platform: every eager slot in that module only
extracts a class, and the two that call anything (Color white, Color gray:) are
satisfied by a stub that answers itself to everything. Collections must be real,
since the algorithms build actual Lists, Maps and Sets.

What this suite deliberately does NOT cover: anything that touches a visual.
Insertion order in a real container, spacer heights, IntersectionObserver
behaviour, measurement and pinning all need a browser, and are covered by the
scripted IDE test plan instead. *)
	
	|
		private TestContext = m TestContext.
		private List = p collections List.
		private hopscotch = HopscotchClass usingPlatform: (StubPlatform realPlatform: p)
			images: Stub new
			ducts: Stub new
			voiceControlClass: Stub new.
	|
) (
	class Stub new = Object new (
		(* Answers itself to every message, so a chain like `platform fonts Font`
       yields something harmless without our having to know what is asked for. *)
		
	) (
		public doesNotUnderstand: aMessage = (
			^self
		)
	) : ()
	class StubPlatform realPlatform: real = Object new (
		(* Real collections and kernel, because the code under test builds genuine
       Lists, Maps and Sets. Everything else is scenery. *)
		
		|
			private realPlatform = real.
			private stub = Stub new.
		|
	) (
		public collections = (
			^realPlatform collections
		)
		public kernel = (
			^realPlatform kernel
		)
		public actors = (
			^stub
		)
		public aiAccess = (
			^stub
		)
		public fonts = (
			^stub
		)
		public graphics = (
			^stub
		)
		public js = (
			^stub
		)
		public text = (
			^stub
		)
		public transcript = (
			^stub
		)
	) : ()
	public class ReuseMapTests new = TestContext new (
		(* #reuseMapFrom:to: answers, for each new position, the old position
       carrying the same key - or 0 when the key is new - and answers nil to
       decline keyed reconciliation entirely. *)
		
		|
			planner = hopscotch SequencePlanning new.
		|
	) (
		reuseFrom: oldKeys to: newKeys = (
			^planner reuseMapFrom: (listOf: oldKeys) to: (listOf: newKeys)
		)
		public test_unchangedSequenceMapsOntoItself = (
			| reuse = reuseFrom: {#a. #b. #c. } to: {#a. #b. #c. }. |
			assert: reuse size equals: 3.
			assert: (reuse at: 1) equals: 1.
			assert: (reuse at: 2) equals: 2.
			assert: (reuse at: 3) equals: 3
		)
		public test_insertionAtFrontReusesEverythingElse = (
			(* The case positional matching handles worst: today every row shifts
	   against the wrong predecessor. *)
			
			| reuse = reuseFrom: {#b. #c. } to: {#a. #b. #c. }. |
			assert: reuse size equals: 3.
			assert: (reuse at: 1) equals: 0.
			assert: (reuse at: 2) equals: 1.
			assert: (reuse at: 3) equals: 2
		)
		public test_deletionFromMiddleKeepsSurvivors = (
			| reuse = reuseFrom: {#a. #b. #c. } to: {#a. #c. }. |
			assert: reuse size equals: 2.
			assert: (reuse at: 1) equals: 1.
			assert: (reuse at: 2) equals: 3
		)
		public test_reorderingIsRecognised = (
			| reuse = reuseFrom: {#a. #b. #c. } to: {#c. #a. #b. }. |
			assert: reuse size equals: 3.
			assert: (reuse at: 1) equals: 3.
			assert: (reuse at: 2) equals: 1.
			assert: (reuse at: 3) equals: 2
		)
		public test_appendingReusesThePrefix = (
			| reuse = reuseFrom: {#a. #b. } to: {#a. #b. #c. }. |
			assert: reuse size equals: 3.
			assert: (reuse at: 3) equals: 0
		)
		public test_nilKeyDeclines = (
			(* nil is the documented opt-out. *)
			
			assert: (reuseFrom: {#a. #b. } to: {#a. nil. }) isNil.
			assert: (reuseFrom: {#a. nil. } to: {#a. #b. }) isNil
		)
		public test_duplicateKeysDecline = (
			(* A repeated key does not identify one element, so two positions would
	   claim the same visual. ToggleComposer's empty default tag makes this
	   a real case, not a hypothetical one. *)
			
			assert: (reuseFrom: {#a. #a. } to: {#a. #b. }) isNil.
			assert: (reuseFrom: {#a. #b. } to: {#a. #a. }) isNil
		)
		public test_completelyDisjointKeysDecline = (
			(* Sharing nothing means the keys are not stable across refreshes.
	   Rebuilding every element would be worse than matching positionally,
	   so we decline and let the caller do that. *)
			
			assert: (reuseFrom: {#a. #b. } to: {#c. #d. }) isNil
		)
		public test_emptySequencesDecline = (
			assert: (reuseFrom: {} to: {#a. }) isNil.
			assert: (reuseFrom: {#a. } to: {}) isNil
		)
	) : (
		TEST_CONTEXT = (
		)
	)
	public class StationaryIndexTests new = TestContext new (
		(* #stationaryIndicesIn: answers the new indices that need no DOM move: the
       longest run of reused elements already in increasing old-index order. *)
		
		|
			planner = hopscotch SequencePlanning new.
		|
	) (
		stationaryFor: reuse = (
			^planner stationaryIndicesIn: (listOf: reuse)
		)
		public test_unchangedOrderMovesNothing = (
			| stationary = stationaryFor: {1. 2. 3. }. |
			assert: stationary size equals: 3.
			assert: (stationary includes: 1).
			assert: (stationary includes: 2).
			assert: (stationary includes: 3)
		)
		public test_appendMovesNothingThatExisted = (
			(* Appending must not disturb the elements already present: the new
	   element is the only insertion. *)
			
			| stationary = stationaryFor: {1. 2. 0. }. |
			assert: stationary size equals: 2.
			assert: (stationary includes: 1).
			assert: (stationary includes: 2).
			deny: (stationary includes: 3)
		)
		public test_insertionAtFrontMovesOnlyTheNewElement = (
			| stationary = stationaryFor: {0. 1. 2. }. |
			assert: stationary size equals: 2.
			deny: (stationary includes: 1).
			assert: (stationary includes: 2).
			assert: (stationary includes: 3)
		)
		public test_singleElementMovedToFrontLeavesTheRestAlone = (
			(* {3. 1. 2}: the run (1, 2) is longest, so only the element that moved
	   is reinserted - one DOM operation, not three. *)
			
			| stationary = stationaryFor: {3. 1. 2. }. |
			assert: stationary size equals: 2.
			deny: (stationary includes: 1).
			assert: (stationary includes: 2).
			assert: (stationary includes: 3)
		)
		public test_fullReversalKeepsOneAnchor = (
			| stationary = stationaryFor: {3. 2. 1. }. |
			assert: stationary size equals: 1
		)
		public test_allNewElementsAreAllInsertions = (
			| stationary = stationaryFor: {0. 0. 0. }. |
			assert: stationary isEmpty
		)
		public test_emptyPlanIsEmpty = (
			assert: (stationaryFor: {}) isEmpty
		)
	) : (
		TEST_CONTEXT = (
		)
	)
	public class VirtualWindowTests new = TestContext new (
		(* #windowFor:viewport:rowHeight:count:overscan: answers the inclusive range
       of indices a lazy column should realize. {1. 0} means realize nothing. *)
		
		|
			planner = hopscotch SequencePlanning new.
		|
	) (
		windowAt: offset height: rowHeight count: n overscan: overscan = (
			^planner windowFor: offset
				viewport: 100
				rowHeight: rowHeight
				count: n
				overscan: overscan
		)
		public test_emptySequenceRealizesNothing = (
			| bounds = windowAt: 0 height: 10 count: 0 overscan: 0. |
			assert: (bounds at: 1) equals: 1.
			assert: (bounds at: 2) equals: 0
		)
		public test_unmeasuredRowHeightRealizesNothing = (
			(* Height is 0 until the first row has been laid out and measured; until
	   then the bootstrap window is what is on screen and this must not
	   claim otherwise. *)
			
			| bounds = windowAt: 0 height: 0 count: 500 overscan: 0. |
			assert: (bounds at: 1) equals: 1.
			assert: (bounds at: 2) equals: 0
		)
		public test_topOfSequenceStartsAtTheFirstRow = (
			| bounds = windowAt: 0 height: 10 count: 1000 overscan: 0. |
			assert: (bounds at: 1) equals: 1.
			assert: (bounds at: 2) equals: 11
		)
		public test_scrolledIntoTheMiddleRealizesOnlyThatNeighbourhood = (
			(* The whole point: index 51 of 1000, not 1 through 1000. *)
			
			| bounds = windowAt: 500 height: 10 count: 1000 overscan: 0. |
			assert: (bounds at: 1) equals: 51.
			assert: (bounds at: 2) equals: 61
		)
		public test_overscanWidensTheWindowBothWays = (
			| bounds = windowAt: 500 height: 10 count: 1000 overscan: 100. |
			assert: (bounds at: 1) equals: 41.
			assert: (bounds at: 2) equals: 71
		)
		public test_overscanCannotRunOffTheTop = (
			| bounds = windowAt: 0 height: 10 count: 1000 overscan: 100. |
			assert: (bounds at: 1) equals: 1
		)
		public test_windowIsClampedToTheEnd = (
			| bounds = windowAt: 990 height: 10 count: 100 overscan: 0. |
			assert: (bounds at: 2) equals: 100
		)
		public test_scrolledPastTheEndRealizesNothing = (
			(* Can happen transiently while the sequence shrinks under a stale
	   scroll position; it must answer an empty range rather than a
	   backwards one. *)
			
			| bounds = windowAt: 100000 height: 10 count: 100 overscan: 0. |
			assert: (bounds at: 1) equals: 1.
			assert: (bounds at: 2) equals: 0
		)
	) : (
		TEST_CONTEXT = (
		)
	)
	listOf: elements = (
		| result = List new. |
		elements do: [:each | result add: each ].
		^result
	)
) : ()
