			check: {'print-literal-blocks'. 'value'. 'char*'. '$print("[" "\\" "t" "i" "t" "l" "e" ":" " " "[" "\\" "[" "\\" "e" "m" "p" "h" "a" "s" "i" "s" "\\" "]" "H" "a" "m" "l" "e" "t" "[" "\\" "e" "n" "d" "E" "m" "p" "h" "a" "s" "i" "s" "\\" "]" "\\" "]" "\\" "]", (TREE (STATE "doc" eps) ((MUT (SEND (eps) "title:" ((HOSTEXPR 2 ((MARKUP "doc" ((BLOCK (eps) (SPAN 11 11) ((SEND (eps) "emphasis" (eps) (SPAN 13 21))) (SPAN 11 23)) (BLOCK ("H" "a" "m" "l" "e" "t") (SPAN 23 29) ((SEND (eps) "endEmphasis" (eps) (SPAN 31 42))) (SPAN 23 44))) (SPAN 9 46))))) (SPAN 2 46)))) ((SEND (eps) "title:" ((HOSTEXPR 2 ((MARKUP "doc" ((BLOCK (eps) (SPAN 11 11) ((SEND (eps) "emphasis" (eps) (SPAN 13 21))) (SPAN 11 23)) (BLOCK ("H" "a" "m" "l" "e" "t") (SPAN 23 29) ((SEND (eps) "endEmphasis" (eps) (SPAN 31 42))) (SPAN 23 44))) (SPAN 9 46))))) (SPAN 2 46))) CLOSED))'. '"[" "\\" "t" "i" "t" "l" "e" ":" " " "[" "\\" "[" "\\" "e" "m" "p" "h" "a" "s" "i" "s" "\\" "]" "H" "a" "m" "l" "e" "t" "[" "\\" "e" "n" "d" "E" "m" "p" "h" "a" "s" "i" "s" "\\" "]" "\\" "]" "\\" "]"'. }
