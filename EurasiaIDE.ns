Newspeak3
'Eurasia'
class EurasiaIDE usingPlatform: platform = (
	(* The Newspeak IDE (HopscotchWebIDE) on Eurasia's web host: generated by eurasia/scripts/generate-ide-entry.py from the IDE's manifest references. The genesis packager packages it as if nested in InternalKernel and fills the module slots below. Genesis builds the platform (platformOver:): Eurasia's base platform with mirrors and Hopscotch. In a browser, main:args: starts the IDE with a manifest answering its modules by name, and its image resources as the files the page serves. *)
	
	|
		Kernel
		Actors
		Runtime
		Mirrors
		RuntimeWithMirrors
		WebRuntime
		Ducts
		GraphicsForHTML5
		FontsForHTML5
		TextModule
		HopscotchForHTML5
		VoiceController
		AIAccess
		NewspeakASTs
		NewspeakPredictiveParsing
		IntermediatesForPrimordialSoup
		NewspeakCompilation
		NewspeakBytecodeCompilation
		Newspeak2V5BytecodeCompilation
		MetadataParsing
		HopscotchWebIDE
		AI_IDE_Support
		AccessModifierTesting
		AccessModifierTestingConfiguration
		ActivationMirrorTesting
		ActivationMirrorTestingConfiguration
		Browsing
		BuildInfo
		BytecodeSimulatorForJS
		CombinatorialParsing
		Debugging
		DeploymentManager
		DocumentHolder
		Documents
		Emmanuel
		EmmanuelBlocks
		EmmanuelDocuments
		EmmanuelEdit
		EmmanuelFromHTML
		EmmanuelIncremental
		EmmanuelLiveEditor
		EmmanuelNewspeakHost
		EmmanuelView
		HopscotchForCroquet
		Host
		HostForCroquet
		JSForCroquet
		JSON
		JSTesting
		JSTestingConfiguration
		JavascriptGeneration
		KernelTests
		KernelTestsConfiguration
		MemoryHoleTesting
		MemoryHoleTestingConfiguration
		Minitest
		MinitestTests
		MinitestTestsConfiguration
		MinitestUI
		MirrorBuilderTesting
		MirrorBuilderTestingConfiguration
		MirrorGroups
		MirrorTesting
		MirrorTestingConfiguration
		MirrorTestingModel
		Namespacing
		Newspeak2JSCompilation
		NewspeakColorization
		NewspeakGrammar
		NewspeakParsing
		NewspeakPrettyPrinter
		NewspeakPrettyPrinterTesting
		NewspeakPrettyPrinterTestingConfiguration
		NewspeakTypechecker
		NewspeakTypecheckerTesting
		NewspeakTypecheckerTestingConfiguration
		Repositories
		Streams
		V5BytecodeSimulation
		VCSCore
		VCSDiffing
		VCSIsomorphicGitBackendProvider
		VCSLib
		VCSSourceMirrors
		WebCompiler
		WebFiles
		WorkspaceHolder
		WorkspaceManager
		JSActors
		JSAliens
		JSCollections
		JSCroquetRuntime
		JSInternalKernel
		JSMirrors
		JSRuntime
		JSRuntimeWithMirrors
		PrimordialSoupActors
		PrimordialSoupAliens
		PrimordialSoupCollections
		PrimordialSoupInternalKernel
		PrimordialSoupMirrors
		PrimordialSoupRuntime
		PrimordialSoupRuntimeWithMirrors
		PrimordialSoupWebRuntime
		internalKernel
	|
) (
	class Manifest new = (
		(* The IDE's manifest: its modules by name, and its image resources as file names. *)
		
	) (
		doesNotUnderstand: message = (
			| name = message selector. |
			'AIAccess' = name ifTrue: [ ^outer EurasiaIDE AIAccess ].
			'AI_IDE_Support' = name ifTrue: [ ^outer EurasiaIDE AI_IDE_Support ].
			'AccessModifierTesting' = name ifTrue: [
					^outer EurasiaIDE AccessModifierTesting
				].
			'AccessModifierTestingConfiguration' = name ifTrue: [
					^outer EurasiaIDE AccessModifierTestingConfiguration
				].
			'ActivationMirrorTesting' = name ifTrue: [
					^outer EurasiaIDE ActivationMirrorTesting
				].
			'ActivationMirrorTestingConfiguration' = name ifTrue: [
					^outer EurasiaIDE ActivationMirrorTestingConfiguration
				].
			'Browsing' = name ifTrue: [ ^outer EurasiaIDE Browsing ].
			'BuildInfo' = name ifTrue: [ ^outer EurasiaIDE BuildInfo ].
			'BytecodeSimulatorForJS' = name ifTrue: [
					^outer EurasiaIDE BytecodeSimulatorForJS
				].
			'CombinatorialParsing' = name ifTrue: [
					^outer EurasiaIDE CombinatorialParsing
				].
			'Debugging' = name ifTrue: [ ^outer EurasiaIDE Debugging ].
			'DeploymentManager' = name ifTrue: [ ^outer EurasiaIDE DeploymentManager ].
			'DocumentHolder' = name ifTrue: [ ^outer EurasiaIDE DocumentHolder ].
			'Documents' = name ifTrue: [ ^outer EurasiaIDE Documents ].
			'Emmanuel' = name ifTrue: [ ^outer EurasiaIDE Emmanuel ].
			'EmmanuelBlocks' = name ifTrue: [ ^outer EurasiaIDE EmmanuelBlocks ].
			'EmmanuelDocuments' = name ifTrue: [ ^outer EurasiaIDE EmmanuelDocuments ].
			'EmmanuelEdit' = name ifTrue: [ ^outer EurasiaIDE EmmanuelEdit ].
			'EmmanuelFromHTML' = name ifTrue: [ ^outer EurasiaIDE EmmanuelFromHTML ].
			'EmmanuelIncremental' = name ifTrue: [ ^outer EurasiaIDE EmmanuelIncremental ].
			'EmmanuelLiveEditor' = name ifTrue: [ ^outer EurasiaIDE EmmanuelLiveEditor ].
			'EmmanuelNewspeakHost' = name ifTrue: [
					^outer EurasiaIDE EmmanuelNewspeakHost
				].
			'EmmanuelView' = name ifTrue: [ ^outer EurasiaIDE EmmanuelView ].
			'HopscotchForCroquet' = name ifTrue: [ ^outer EurasiaIDE HopscotchForCroquet ].
			'Host' = name ifTrue: [ ^outer EurasiaIDE Host ].
			'HostForCroquet' = name ifTrue: [ ^outer EurasiaIDE HostForCroquet ].
			'IntermediatesForPrimordialSoup' = name ifTrue: [
					^outer EurasiaIDE IntermediatesForPrimordialSoup
				].
			'JSForCroquet' = name ifTrue: [ ^outer EurasiaIDE JSForCroquet ].
			'JSON' = name ifTrue: [ ^outer EurasiaIDE JSON ].
			'JSTesting' = name ifTrue: [ ^outer EurasiaIDE JSTesting ].
			'JSTestingConfiguration' = name ifTrue: [
					^outer EurasiaIDE JSTestingConfiguration
				].
			'JavascriptGeneration' = name ifTrue: [
					^outer EurasiaIDE JavascriptGeneration
				].
			'KernelTests' = name ifTrue: [ ^outer EurasiaIDE KernelTests ].
			'KernelTestsConfiguration' = name ifTrue: [
					^outer EurasiaIDE KernelTestsConfiguration
				].
			'MemoryHoleTesting' = name ifTrue: [ ^outer EurasiaIDE MemoryHoleTesting ].
			'MemoryHoleTestingConfiguration' = name ifTrue: [
					^outer EurasiaIDE MemoryHoleTestingConfiguration
				].
			'MetadataParsing' = name ifTrue: [ ^outer EurasiaIDE MetadataParsing ].
			'Minitest' = name ifTrue: [ ^outer EurasiaIDE Minitest ].
			'MinitestTests' = name ifTrue: [ ^outer EurasiaIDE MinitestTests ].
			'MinitestTestsConfiguration' = name ifTrue: [
					^outer EurasiaIDE MinitestTestsConfiguration
				].
			'MinitestUI' = name ifTrue: [ ^outer EurasiaIDE MinitestUI ].
			'MirrorBuilderTesting' = name ifTrue: [
					^outer EurasiaIDE MirrorBuilderTesting
				].
			'MirrorBuilderTestingConfiguration' = name ifTrue: [
					^outer EurasiaIDE MirrorBuilderTestingConfiguration
				].
			'MirrorGroups' = name ifTrue: [ ^outer EurasiaIDE MirrorGroups ].
			'MirrorTesting' = name ifTrue: [ ^outer EurasiaIDE MirrorTesting ].
			'MirrorTestingConfiguration' = name ifTrue: [
					^outer EurasiaIDE MirrorTestingConfiguration
				].
			'MirrorTestingModel' = name ifTrue: [ ^outer EurasiaIDE MirrorTestingModel ].
			'Namespacing' = name ifTrue: [ ^outer EurasiaIDE Namespacing ].
			'Newspeak2JSCompilation' = name ifTrue: [
					^outer EurasiaIDE Newspeak2JSCompilation
				].
			'Newspeak2V5BytecodeCompilation' = name ifTrue: [
					^outer EurasiaIDE Newspeak2V5BytecodeCompilation
				].
			'NewspeakASTs' = name ifTrue: [ ^outer EurasiaIDE NewspeakASTs ].
			'NewspeakBytecodeCompilation' = name ifTrue: [
					^outer EurasiaIDE NewspeakBytecodeCompilation
				].
			'NewspeakColorization' = name ifTrue: [
					^outer EurasiaIDE NewspeakColorization
				].
			'NewspeakCompilation' = name ifTrue: [ ^outer EurasiaIDE NewspeakCompilation ].
			'NewspeakGrammar' = name ifTrue: [ ^outer EurasiaIDE NewspeakGrammar ].
			'NewspeakParsing' = name ifTrue: [ ^outer EurasiaIDE NewspeakParsing ].
			'NewspeakPredictiveParsing' = name ifTrue: [
					^outer EurasiaIDE NewspeakPredictiveParsing
				].
			'NewspeakPrettyPrinter' = name ifTrue: [
					^outer EurasiaIDE NewspeakPrettyPrinter
				].
			'NewspeakPrettyPrinterTesting' = name ifTrue: [
					^outer EurasiaIDE NewspeakPrettyPrinterTesting
				].
			'NewspeakPrettyPrinterTestingConfiguration' = name ifTrue: [
					^outer EurasiaIDE NewspeakPrettyPrinterTestingConfiguration
				].
			'NewspeakTypechecker' = name ifTrue: [ ^outer EurasiaIDE NewspeakTypechecker ].
			'NewspeakTypecheckerTesting' = name ifTrue: [
					^outer EurasiaIDE NewspeakTypecheckerTesting
				].
			'NewspeakTypecheckerTestingConfiguration' = name ifTrue: [
					^outer EurasiaIDE NewspeakTypecheckerTestingConfiguration
				].
			'Repositories' = name ifTrue: [ ^outer EurasiaIDE Repositories ].
			'Streams' = name ifTrue: [ ^outer EurasiaIDE Streams ].
			'V5BytecodeSimulation' = name ifTrue: [
					^outer EurasiaIDE V5BytecodeSimulation
				].
			'VCSCore' = name ifTrue: [ ^outer EurasiaIDE VCSCore ].
			'VCSDiffing' = name ifTrue: [ ^outer EurasiaIDE VCSDiffing ].
			'VCSIsomorphicGitBackendProvider' = name ifTrue: [
					^outer EurasiaIDE VCSIsomorphicGitBackendProvider
				].
			'VCSLib' = name ifTrue: [ ^outer EurasiaIDE VCSLib ].
			'VCSSourceMirrors' = name ifTrue: [ ^outer EurasiaIDE VCSSourceMirrors ].
			'WebCompiler' = name ifTrue: [ ^outer EurasiaIDE WebCompiler ].
			'WebFiles' = name ifTrue: [ ^outer EurasiaIDE WebFiles ].
			'WorkspaceHolder' = name ifTrue: [ ^outer EurasiaIDE WorkspaceHolder ].
			'WorkspaceManager' = name ifTrue: [ ^outer EurasiaIDE WorkspaceManager ].
			'Collections' = name ifTrue: [ ^outer EurasiaIDE PrimordialSoupCollections ].
			'JS' = name ifTrue: [ ^PlatformManifest named: 'JS' ].
			'PrimordialSoup' = name ifTrue: [ ^PlatformManifest named: 'PrimordialSoup' ].
			({'addImage'. 'ampleforthDocument'. 'classImage'. 'classPresenterImage'. 'classUnknownImage'. 'collapseImage'. 'expandImage'. 'privateImage'. 'protectedImage'. 'publicImage'. 'saveImage'. 'sectionImage'. } includes: name) ifTrue: [
					^name , '.png'
				].
			^super doesNotUnderstand: message
		)
	) : ()
	class PlatformManifest named: p = (
		(* Another platform's modules, manifest P X: the slot named PX. *)
		
		|
			platform = p.
		|
	) (
		doesNotUnderstand: message = (
			| name = message selector. |
			('JS' = platform and: [ 'Actors' = name ]) ifTrue: [
					^outer EurasiaIDE JSActors
				].
			('JS' = platform and: [ 'Aliens' = name ]) ifTrue: [
					^outer EurasiaIDE JSAliens
				].
			('JS' = platform and: [ 'Collections' = name ]) ifTrue: [
					^outer EurasiaIDE JSCollections
				].
			('JS' = platform and: [ 'CroquetRuntime' = name ]) ifTrue: [
					^outer EurasiaIDE JSCroquetRuntime
				].
			('JS' = platform and: [ 'InternalKernel' = name ]) ifTrue: [
					^outer EurasiaIDE JSInternalKernel
				].
			('JS' = platform and: [ 'Mirrors' = name ]) ifTrue: [
					^outer EurasiaIDE JSMirrors
				].
			('JS' = platform and: [ 'Runtime' = name ]) ifTrue: [
					^outer EurasiaIDE JSRuntime
				].
			('JS' = platform and: [ 'RuntimeWithMirrors' = name ]) ifTrue: [
					^outer EurasiaIDE JSRuntimeWithMirrors
				].
			('PrimordialSoup' = platform and: [ 'Actors' = name ]) ifTrue: [
					^outer EurasiaIDE PrimordialSoupActors
				].
			('PrimordialSoup' = platform and: [ 'Aliens' = name ]) ifTrue: [
					^outer EurasiaIDE PrimordialSoupAliens
				].
			('PrimordialSoup' = platform and: [ 'Collections' = name ]) ifTrue: [
					^outer EurasiaIDE PrimordialSoupCollections
				].
			('PrimordialSoup' = platform and: [ 'InternalKernel' = name ]) ifTrue: [
					^outer EurasiaIDE PrimordialSoupInternalKernel
				].
			('PrimordialSoup' = platform and: [ 'Mirrors' = name ]) ifTrue: [
					^outer EurasiaIDE PrimordialSoupMirrors
				].
			('PrimordialSoup' = platform and: [ 'Runtime' = name ]) ifTrue: [
					^outer EurasiaIDE PrimordialSoupRuntime
				].
			('PrimordialSoup' = platform and: [ 'RuntimeWithMirrors' = name ]) ifTrue: [
					^outer EurasiaIDE PrimordialSoupRuntimeWithMirrors
				].
			('PrimordialSoup' = platform and: [ 'WebRuntime' = name ]) ifTrue: [
					^outer EurasiaIDE PrimordialSoupWebRuntime
				].
			^super doesNotUnderstand: message
		)
	) : ()
	public main: platform args: args = (
		(HopscotchWebIDE packageUsing: Manifest new) main: platform args: args
	)
	public platformOver: ik = (
		| base reflective |
		internalKernel:: ik.
		base:: (Runtime kernel: Kernel
			collections: PrimordialSoupCollections
			actors: Actors) Platform internalKernel: ik.
		reflective:: (RuntimeWithMirrors mirrors: Mirrors
			asts: NewspeakASTs
			parsing: NewspeakPredictiveParsing
			intermediates: IntermediatesForPrimordialSoup
			compilation: (Newspeak2V5BytecodeCompilation mixinApply: (NewspeakBytecodeCompilation mixinApply: NewspeakCompilation))
			metadataParsing: MetadataParsing) Platform over: base internalKernel: ik.
		^((WebRuntime internalKernel: (reflective mirrors ObjectMirror reflecting: ik) getClass reflectee
			hopscotch: HopscotchForHTML5
			ducts: Ducts
			graphics: GraphicsForHTML5
			fonts: FontsForHTML5
			text: TextModule
			voiceController: VoiceController
			aiAccess: AIAccess) Platform over: reflective) buildInfo: BuildInfo;
			hostModule: Host;
			yourself
	)
) : ()
