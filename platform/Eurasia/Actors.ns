	public whenRestored: action <[]> = (
		(* Run action, in a turn of its own, after the image is restored into a new host (M7; contract design, section 6, rule 3): a checkpoint continued in a new page or process, where the host objects the program created (DOM nodes, timers) are gone, and the program rebuilds them from its own model. Lazy slots holding host objects look them up again by themselves. Replaces an earlier action. *)
		
		imageHandler action: action.
		setRole: 40 to: imageHandler
	)
	private wrapArgument: argument from: sourceActor to: targetActor = (
		(* [argument] lives in [sourceActor], answer the corresponding proxy that lives in [targetActor] *)
		
		sourceActor = targetActor ifTrue: [ halt ].
		
		(* We can't tell which side a near reference belongs to here, so we must have decided this earlier. *)
		^(asInternalRef: argument) wrapFor: targetActor
	)
	private wrapArguments: arguments from: sourceActor to: targetActor = (
		^arguments collect: [:argument |
				wrapArgument: argument from: sourceActor to: targetActor
			]
	)
