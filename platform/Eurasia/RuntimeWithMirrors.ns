Newspeak3
'Eurasia'
class RuntimeWithMirrors mirrors: mirrorsModule asts: astsModule parsing: parsingModule intermediates: intermediatesModule compilation: compilationModule metadataParsing: metadataParsingModule = (
	(* A platform with mirrors on Eurasia (EURASIA_M6_REFLECTION_DESIGN_2026-11-18.md), as RuntimeWithMirrorsForPrimordialSoup's is on psoup: Eurasia's base platform (Runtime) and the mirrors (Mirrors, derived from psoup's by eurasia/kernel/fork-mirrors.py), over a namespace of the modules the mirrors build their compiler from. compilationModule is the V5 compilation, already applied to NewspeakBytecodeCompilation and NewspeakCompilation. *)
	
	|
		private Mirrors = mirrorsModule.
		private NewspeakASTs = astsModule.
		private NewspeakPredictiveParsing = parsingModule.
		private Intermediates = intermediatesModule.
		private Newspeak2V5BytecodeCompilation = compilationModule.
		private MetadataParsing = metadataParsingModule.
	|
) (
	class Namespace new = (
		(* The modules the mirrors ask for by name. *)
		
	) (
		public Intermediates = (
			^outer RuntimeWithMirrors Intermediates
		)
		public MetadataParsing = (
			^outer RuntimeWithMirrors MetadataParsing
		)
		public Newspeak2V5BytecodeCompilation = (
			^outer RuntimeWithMirrors Newspeak2V5BytecodeCompilation
		)
		public NewspeakASTs = (
			^outer RuntimeWithMirrors NewspeakASTs
		)
		public NewspeakPredictiveParsing = (
			^outer RuntimeWithMirrors NewspeakPredictiveParsing
		)
	) : ()
	public class Platform over: basePlatform internalKernel: ik = (
		|
			public kernel = basePlatform kernel.
			public collections = basePlatform collections.
			public victoryFuel = basePlatform victoryFuel.
			public actors = basePlatform actors.
			public js = basePlatform js.
			public mirrors = Mirrors usingPlatform: self
				internalKernel: ik
				namespace: Namespace new.
		|
	) (
	) : ()
) : ()
