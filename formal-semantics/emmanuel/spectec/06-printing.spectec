;; Section 5: printing and the canonical form used by the round trip.

;; @equation eq:escape
def $esc(char*) : char*
def $esc(eps) = eps
def $esc("\\" u*) = "\\" "\\" $esc(u*)
def $esc("[" u*) = "\\" "[" $esc(u*)
def $esc(c u*) = c $esc(u*)
  -- if c =/= "\\" /\ c =/= "["

;; W[s]: the source of a span. Head-recursive drop and take.
def $drop(nat, char*) : char*
def $drop(0, w*) = w*
def $drop(k, eps) = eps
  -- if k > 0
def $drop(k, c w*) = $drop($(k - 1), w*)
  -- if k > 0

def $take(nat, char*) : char*
def $take(0, w*) = eps
def $take(k, eps) = eps
  -- if k > 0
def $take(k, c w*) = c $take($(k - 1), w*)
  -- if k > 0

def $slice(char*, span) : char*
def $slice(w*, SPAN i j) = $take($(j - i), $drop(i, w*))

;; @equation eq:print-message
;; The host prints the code; the core prints the literals in its holes.
def $show(char*, ppiece*) : char*
def $showLit(char*, markupliteral) : char*
def $showNodes(char*, node*) : char*
def $show(w*, eps) = eps
def $show(w*, (PCODE (u*)) pp*) = u* $show(w*, pp*)
def $show(w*, (PLIT L) pp*) = $showLit(w*, L) $show(w*, pp*)
def $showLit(w*, MARKUP nm (n*) s) = $openSeq $showNodes(w*, n*) $closeSeq
def $showNodes(w*, eps) = eps
def $showNodes(w*, (BLOCK (u*) s' (sigma*) s) n*) =
  $esc(u*) $openSeq $show(w*, $hostPrint(w*, sigma*)) $closeSeq $showNodes(w*, n*)
def $showNodes(w*, (FINAL (u*) s) n*) = $esc(u*) $showNodes(w*, n*)

def $br(char*, stmt) : char*
def $br(w*, sigma) = $openSeq $show(w*, $hostPrint(w*, sigma)) $closeSeq

;; @equation eq:print-tree
;; The LaTeX's closer matches the last message, a suffix; the transcription
;; takes it with the head-recursive $lastStmt.
def $lastStmt(stmt*) : stmt
def $lastStmt(sigma) = sigma
def $lastStmt(sigma sigma' sigma''*) = $lastStmt(sigma' sigma''*)

def $print(char*, tree) : char*
def $printItems(char*, titem*) : char*
def $item(char*, titem) : char*
def $closer(char*, stmt*, flag) : char*

def $print(w*, TREE kappa (ti*) (sigma*) f) = $printItems(w*, ti*)
def $printItems(w*, eps) = eps
def $printItems(w*, ti ti'*) = $item(w*, ti) $printItems(w*, ti'*)
def $item(w*, RUN (u*) s) = $esc(u*)
def $item(w*, STRAY (u*) s) = $esc(u*)
def $item(w*, NOTE s) = $br(w*, COMMENT s)
def $item(w*, MUT sigma) = $br(w*, sigma)
def $item(w*, DNU sigma) = $br(w*, sigma)
def $item(w*, ROOTPOP sigma) = $br(w*, sigma)
def $item(w*, REFUSED sigma) = $br(w*, sigma)
def $item(w*, SUB (TREE kappa (ti*) (sigma sigma'*) f)) =
  $br(w*, sigma) $printItems(w*, ti*) $closer(w*, sigma'*, f)
def $closer(w*, sigma*, UNCLOSED) = eps
def $closer(w*, eps, f) = eps
  -- if f = CLOSED \/ f = REJECTED
def $closer(w*, sigma sigma'*, f) = $br(w*, $lastStmt(sigma sigma'*))
  -- if f = CLOSED \/ f = REJECTED

;; @equation eq:canonical
;; Erasure replaces every span by SPAN 0 0. On host data it is the host's;
;; on the transcription's carriers it is defined here.
def $z : span
def $z = SPAN 0 0

def $eSpans(span*) : span*
def $eSpans(eps) = eps
def $eSpans(s s'*) = $z $eSpans(s'*)

def $eStmt(stmt) : stmt
def $eStmts(stmt*) : stmt*
def $eExpr(hostexpr) : hostexpr
def $eExprs(hostexpr*) : hostexpr*
def $eLit(markupliteral) : markupliteral
def $eLits(markupliteral*) : markupliteral*
def $eNode(node) : node
def $eNodes(node*) : node*
def $eValue(value) : value
def $eValues(value*) : value*
def $eState(blockstate) : blockstate
def $canon(tree) : tree
def $canonItem(titem) : titem
def $canonItems(titem*) : titem*

def $eStmt(SEND (s'*) x (eta*) s) = SEND ($eSpans(s'*)) x ($eExprs(eta*)) $z
def $eStmt(COMMENT s) = COMMENT $z
def $eStmts(eps) = eps
def $eStmts(sigma sigma'*) = $eStmt(sigma) $eStmts(sigma'*)
def $eExpr(HOSTEXPR k (L*)) = HOSTEXPR k ($eLits(L*))
def $eExprs(eps) = eps
def $eExprs(eta eta'*) = $eExpr(eta) $eExprs(eta'*)
def $eLit(MARKUP nm (n*) s) = MARKUP nm ($eNodes(n*)) $z
def $eLits(eps) = eps
def $eLits(L L'*) = $eLit(L) $eLits(L'*)
def $eNode(BLOCK (u*) s' (sigma*) s) = BLOCK (u*) $z ($eStmts(sigma*)) $z
def $eNode(FINAL (u*) s) = FINAL (u*) $z
def $eNodes(eps) = eps
def $eNodes(n n'*) = $eNode(n) $eNodes(n'*)
def $eValue(LITV L) = LITV $eLit(L)
def $eValue(TREEV L tr) = TREEV $eLit(L) $canon(tr)
def $eValue(HOSTV k) = HOSTV k
def $eValue(STRV (u*)) = STRV (u*)
def $eValue(SYMV x) = SYMV x
def $eValue(INTV k) = INTV k
def $eValue(NILV) = NILV
def $eValues(eps) = eps
def $eValues(v v'*) = $eValue(v) $eValues(v'*)
def $eState(STATE x (v*)) = STATE x ($eValues(v*))

def $canon(TREE kappa (ti*) (sigma*) f) =
  TREE $eState(kappa) ($mergeKids($canonItems(ti*))) ($eStmts(sigma*)) f
def $canonItems(eps) = eps
def $canonItems(ti ti'*) = $canonItem(ti) $canonItems(ti'*)
def $canonItem(RUN (u*) s) = RUN (u*) $z
def $canonItem(SUB tr) = SUB $canon(tr)
def $canonItem(NOTE s) = NOTE $z
def $canonItem(MUT sigma) = MUT $eStmt(sigma)
def $canonItem(DNU sigma) = DNU $eStmt(sigma)
def $canonItem(STRAY (u*) s) = STRAY (u*) $z
def $canonItem(ROOTPOP sigma) = ROOTPOP $eStmt(sigma)
def $canonItem(REFUSED sigma) = REFUSED $eStmt(sigma)

;; @equation eq:merge
def $isRunT(titem) : bool
def $isRunT(RUN (u*) s) = true
def $isRunT(SUB tr) = false
def $isRunT(NOTE s) = false
def $isRunT(MUT sigma) = false
def $isRunT(DNU sigma) = false
def $isRunT(STRAY (u*) s) = false
def $isRunT(ROOTPOP sigma) = false
def $isRunT(REFUSED sigma) = false

def $isStrayT(titem) : bool
def $isStrayT(STRAY (u*) s) = true
def $isStrayT(RUN (u*) s) = false
def $isStrayT(SUB tr) = false
def $isStrayT(NOTE s) = false
def $isStrayT(MUT sigma) = false
def $isStrayT(DNU sigma) = false
def $isStrayT(ROOTPOP sigma) = false
def $isStrayT(REFUSED sigma) = false

def $sameText(titem, titem) : bool
def $sameText(ti, ti') = ($isRunT(ti) /\ $isRunT(ti')) \/ ($isStrayT(ti) /\ $isStrayT(ti'))

def $mergeKids(titem*) : titem*
def $mergeKids(eps) = eps
def $mergeKids(ti) = ti
def $mergeKids((RUN (u*) s) (RUN (u'*) s') ti*) = $mergeKids((RUN ($collapse(u* u'*)) s) ti*)
def $mergeKids((STRAY (u*) s) (STRAY (u'*) s') ti*) = $mergeKids((STRAY (u* u'*) s) ti*)
def $mergeKids(ti ti' ti''*) = ti $mergeKids(ti' ti''*)
  -- if ~$sameText(ti, ti')
