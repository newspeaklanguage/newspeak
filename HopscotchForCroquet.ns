			public isMyKind: otherPresenter ^<Boolean> = (
				^otherPresenter isKindOfNonSyncingPresenter
			)
			public isKindOfNonSyncingPresenter ^<Boolean> = (
				^true
			)
		) : ()
		lazy coordinatedFetchPending <Map[String, List]> = Map new.
		lazy coordinatedFetchers <Map[String, [:[:Alien[ArrayBuffer] | Object] :[:String | Object] | Object]]> = Map new.
		lazy coordinatedFetchSubscribed <Map[String, Boolean]> = Map new.
		lazy coordinatedFetchInline <Map[String, Boolean]> = Map new.
		lazy mintLedgerOn <Boolean> = [ (js global at: 'nsMintLedgerOn') = true ] on: Exception
			do: [:e | false ].
		newImageButtonId ^<String> = (
			^newIdFor: 'imageButton'
		)
		public coordinatedFetch: key <String> via: fetcher <[:[:Alien[ArrayBuffer] | Object] :[:String | Object] | Object]> ifSuccess: sb <[:Alien[ArrayBuffer] | Object]> ifFailure: fb <[:String | Object]> = (
			(* Synchronized override of the once-per-session IO primitive (see the base
	   method in HopscotchForHTML5). Every client wanting the bytes for key
	   publishes a coordinatedFetch_request carrying its view id. The root model
	   elects the FIRST requester - reflector ordering is the election - and
	   answers model_coordinatedFetch_fetch naming the elected view; only that
	   client runs its own stored fetcher block, stores the resulting bytes with
	   the session Data API, and publishes coordinatedFetch_loaded with the
	   handle. The model records only loaded answers in its event history, so
	   every client - including late joiners replaying that history - consumes
	   the SAME bytes, rather than re-running IO against a possibly changed
	   source. A request arriving after the bytes are stored is answered with a
	   fresh recorded loaded event. A fetch failure is recorded the same way: the
	   model keeps the entry as failed, and every client - and every late joiner
	   replaying - meets the failure where the original did, rather than a
	   vacancy it could be elected to fill (which is what let a joiner fetch
	   afresh, 2026-09-13). A retry is a new request under a new key; the host
	   mints one per attempt. *)
			
			(coordinatedFetchPending at: key ifAbsentPut: [ List new ]) add: {sb. fb. }.
			coordinatedFetchers at: key put: fetcher.
			subscribeCoordinatedFetchEventsFor: key.
			publish: 'nscoordfetch_'
				event: #coordinatedFetch_request
				data: (js global newspeakFragmentData: (coordinatedFetchEventKeyFor: key)
					data: (rootView at: #viewId))
		)
		public coordinatedText: key <String> via: fetcher <[:[:String | Object] :[:String | Object] | Object]> ifSuccess: sb <[:String | Object]> ifFailure: fb <[:String | Object]> = (
			(* The text-result form (see the base method). The election is identical;
	   only the carriage of the answer differs. The elected client publishes the
	   TEXT as the loaded event's own data instead of storing it and publishing a
	   Data API handle.

	   That is what puts the answer in order. Every Newspeak handler runs through
	   the dispatch chain in nsSubscribe, so handlers are serialized and replay
	   sees them in the recorded order - but the Data API read that the bytes
	   form does is a separate round trip OUTSIDE that chain, so its completion
	   floats free of it. A client replaying a history could therefore reach a
	   handler that READS the answer before the answer had arrived: the concrete
	   case was a joining client building a model-picker menu from the static
	   fallback list, then replaying a click on a discovered model that its menu
	   did not contain. Carried as event data the answer is resolved inside the
	   chain - nsPublish detours it through the file server if it is too big for
	   the reflector, and nsResolvePayload awaits that detour in the chain - so
	   ordering holds either way. *)
			
			coordinatedFetchInline at: key put: true.
			coordinatedFetch: key via: fetcher ifSuccess: sb ifFailure: fb
		)
		public synchronizedInbox: topic <String> do: handler <[:String | Object]> = (
			(* Synchronized override (see the base method). A delivery is a RECORDED
		   event, so the handler is subscribed through subscribeFragment: - counted,
		   keeping the replay cursor exact - under a scope named by the topic.
		   Subscribe at startup, before any replay: a recorded delivery whose
		   subscriber has not appeared within the replay's wait is skipped for
		   good. *)
			
			subscribeFragment: topic
				scope: 'nssyncinbox_' , topic
				eventSpec: #model_syncInbox_deliver
				handler: [:text | handler value: text ]
		)
		public synchronizedInbox: topic <String> post: id <String> payload: text <String> = (
			(* Synchronized override (see the base method): publish the post, and
		   let the root model record ONE delivery per (topic, id) however many
		   clients post it. nsSyncInboxPost (croquet-post.js) carries the id
		   beside the envelope, where the model can read it even when the payload
		   itself has been detoured through the file server for size. *)
			
			js global nsSyncInboxPost: topic id: id text: text
		)
		public awaitCoordinatedText: key <String> ifSuccess: sb <[:String | Object]> ifFailure: fb <[:String | Object]> = (
			(* Synchronized override of the base method: register as a waiter for this
	   key and subscribe to its events, but do NOT publish a request. The
	   election is over the requesters, so a client that abstains here cannot be
	   elected - it simply consumes the recorded answer, live or under replay,
	   exactly as a losing requester does.

	   No fetcher is registered, which is the backstop: were this client somehow
	   elected, runCoordinatedFetcherFor: publishes a failure naming the key
	   rather than doing something undefined.

	   The caller must still have minted the key the same way an initiator would
	   - the ordinal is a per-client count of calls per digest, so a client that
	   waits without counting would disagree with everyone else from then on.

	   The await event is what makes a LATE waiter work. A Croquet broadcast
	   reaches whoever is subscribed at that instant, and the replay stash covers
	   only a client walking recorded history - so a client that starts waiting
	   after the answer was published would wait forever. The model answers an
	   await from an already-loaded entry, and ignores it otherwise (the loaded
	   broadcast is still to come, and this client is now subscribed for it).

	   Two things separate an await from a request. It never elects. And its
	   answer is never RECORDED: the asking client may itself be replaying - a
	   joiner catching up through a bus chat asks here - and appending to the
	   history a client is walking skews its cursor and orphans events for
	   everyone, which is why the answer comes back as model_coordinatedFetch_
	   awaited rather than as another loaded. *)
			
			coordinatedFetchInline at: key put: true.
			(coordinatedFetchPending at: key ifAbsentPut: [ List new ]) add: {sb. fb. }.
			subscribeCoordinatedFetchEventsFor: key.
			publish: 'nscoordfetch_'
				event: #coordinatedFetch_await
				data: (js global newspeakFragmentData: (coordinatedFetchEventKeyFor: key)
					data: (rootView at: #viewId))
		)
		coordinatedFetchEventKeyFor: key <String> ^<String> = (
			(* Croquet rejects subscription scopes containing ':' (its internal
	   scope:event separator), and the recorded fid must match the subscription
	   scope suffix for replay lookup, so the key is sanitized ONCE here and used
	   for ALL event traffic (the scope suffix and the fid). The raw key stays
	   local: the pending list, the fetcher registry and the handler closures are
	   keyed by it. Distinct raw keys that sanitize alike would collide in the
	   model - do not choose keys differing only by ':' vs '.'. *)
			
			^((js global at: #String) new: key) replaceAll: ':' with: '.'
		)
		subscribeCoordinatedFetchEventsFor: key <String> = (
			(* One-time per-key subscriptions for the coordinated fetch (see
	   coordinatedFetch:via:ifSuccess:ifFailure:). The loaded and failed events
	   are RECORDED in the model's history, so their handlers must go through
	   subscribeFragment: - whose wrapper counts processed events to keep the
	   replay cursor exact. The fetch, awaited and awaitedFailure events are
	   never recorded, so they must NOT be counted: they are subscribed directly
	   via nsSubscribe.

	   awaited and awaitedFailure answer an await (see awaitCoordinatedText:).
	   Same payloads as loaded and failed, delivered the same way, but off the
	   record - the client asking may itself be REPLAYING, and appending to the
	   history a client is walking skews its cursor and orphans events for
	   everyone. *)
			
			| scope = 'nscoordfetch_' , (coordinatedFetchEventKeyFor: key). |
			(coordinatedFetchSubscribed at: key ifAbsent: [ false ]) ifTrue: [ ^self ].
			coordinatedFetchSubscribed at: key put: true.
			js global nsSubscribe: scope
				eventSpec: #model_coordinatedFetch_fetch
				handler: [:electedViewId |
					electedViewId = (rootView at: #viewId) ifTrue: [
							runCoordinatedFetcherFor: key
						].
					nil
				].
			js global nsSubscribe: scope
				eventSpec: #model_coordinatedFetch_awaited
				handler: [:handle |
					deliverCoordinatedFetchBytes: key handle: handle.
					nil
				].
			js global nsSubscribe: scope
				eventSpec: #model_coordinatedFetch_awaitedFailure
				handler: [:msg |
					deliverCoordinatedFetchFailure: key message: msg.
					nil
				].
			subscribeFragment: key
				scope: scope
				eventSpec: #model_coordinatedFetch_loaded
				handler: [:handle | deliverCoordinatedFetchBytes: key handle: handle ].
			subscribeFragment: key
				scope: scope
				eventSpec: #model_coordinatedFetch_failed
				handler: [:msg | deliverCoordinatedFetchFailure: key message: msg ]
		)
		runCoordinatedFetcherFor: key <String> = (
			(* This client won the election: run the fetcher block it registered for
	   this key, store the resulting bytes with the session Data API, and publish
	   the handle for everyone; the model records it. Failures are broadcast so
	   all waiting clients report them, and clear the model's entry so a retry
	   can re-elect. *)
			
			| fetcher = coordinatedFetchers at: key ifAbsent: [ nil ]. eventKey = coordinatedFetchEventKeyFor: key. |
			fetcher isNil ifTrue: [
					^publish: 'nscoordfetch_'
						event: #coordinatedFetch_failed
						data: (js global newspeakFragmentData: eventKey
							data: 'No fetcher registered for ' , key , ' on the elected client')
				].
			fetcher value: [:result |
					(coordinatedFetchInline at: key ifAbsent: [ false ]) ifTrue: [
							publish: 'nscoordfetch_'
								event: #coordinatedFetch_loaded
								data: (js global newspeakFragmentData: eventKey data: result)
						]
						ifFalse: [
							(rootView storedData store: result) then: [:handle |
									publish: 'nscoordfetch_'
										event: #coordinatedFetch_loaded
										data: (js global newspeakFragmentData: eventKey data: handle).
									nil
								]
								onError: [:ex |
									publish: 'nscoordfetch_'
										event: #coordinatedFetch_failed
										data: (js global newspeakFragmentData: eventKey
											data: 'Storing ' , key , ' failed: ' , ex printString).
									nil
								]
						]
				]
				value: [:msg |
					publish: 'nscoordfetch_'
						event: #coordinatedFetch_failed
						data: (js global newspeakFragmentData: eventKey data: msg)
				]
		)
		deliverCoordinatedFetchBytes: key <String> handle: h <Alien[CroquetHandle] | String> = (
			(* A recorded loaded answer arrived. If no request is pending locally (a
	   repeat answer to some other client's late request, or replay after this
	   client already consumed the answer) there is nothing to do - skip the
	   fetch entirely.

	   For an inline (text) key the answer IS h: it travelled in the event and
	   has already been resolved by the dispatch chain, so it is handed to the
	   waiters here and now, at this position in the replay. For a bytes key it
	   is a Data API handle and must be fetched - a round trip outside the chain,
	   which is why anything a synchronized handler reads should use the text
	   form. *)
			
			| pending = coordinatedFetchPending at: key ifAbsent: [ nil ]. |
			pending isNil ifTrue: [ ^self ].
			pending isEmpty ifTrue: [ ^self ].
			coordinatedFetchPending at: key put: List new.
			(coordinatedFetchInline at: key ifAbsent: [ false ]) ifTrue: [
					^pending do: [:pair | (pair at: 1) value: h ]
				].
			(rootView storedData fetch: h) then: [:bytes |
					pending do: [:pair | (pair at: 1) value: bytes ].
					nil
				]
				onError: [:ex |
					pending do: [:pair |
							(pair at: 2) value: 'Fetching stored bytes for ' , key , ' failed: ' , ex printString
						].
					nil
				]
		)
		deliverCoordinatedFetchFailure: key <String> message: msg <String> = (
			| pending = coordinatedFetchPending at: key ifAbsent: [ nil ]. |
			pending isNil ifTrue: [ ^self ].
			pending isEmpty ifTrue: [ ^self ].
			coordinatedFetchPending at: key put: List new.
			pending do: [:pair | (pair at: 2) value: msg ]
		)
		newRadioButtonId ^<String> = (
			^newIdFor: 'radioButton'
		)
