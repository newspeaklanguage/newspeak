Newspeak3
'Eurasia'
class EurasiaKernelSmokeTest usingPlatform: platform = (
	(* The base image's application while Eurasia's kernel is brought up: the genesis packager packages it as if nested in InternalKernel, so kernel classes (and the kernel's VM mirror, vm) are visible lexically, and fills the slots below with the packaged modules. Genesis builds its platform (platformOver:); the message loop then delivers main:args:. Each line printed is checked by eurasia/scripts/genesis.sh. *)
	
	|
		Kernel
		CollectionsForPrimordialSoup
		Actors
		Runtime
		EurasiaValueProbe
		EurasiaSpawnProbe
	|
) (
	checkActors: platform = (
		(* VM actors (EURASIA_ACTORS_DESIGN_2026-11-17.md): a spawned module runs in an actor of its own and is reached by a far reference; a mutable object crosses as a far reference, which refuses immediate sends and comes home as itself; the actor's own state survives a collection. *)
		
		| Promise probe mine |
		Promise:: platform actors Promise.
		probe:: vm spawn: (vm slotOf: EurasiaSpawnProbe at: 1).
		vm print: 'spawned ' , (vm isFarReference: probe) printString.
		probe:: probe <-: new.
		mine:: {1. 2. 3. }.
		Promise when: probe <-: answer
			fulfilled: [:a |
				vm print: 'spawned answer ' , a printString.
				Promise when: (probe <-: echo: mine)
					fulfilled: [:e |
						vm print: 'came home ' , (e == mine) printString.
						Promise when: (probe <-: sizeOf: mine)
							fulfilled: [:s | vm print: 'leaked ' , s printString ]
							broken: [:problem |
								vm print: 'isolated'.
								vm garbageCollect.
								Promise when: probe <-: heldFirst
									fulfilled: [:h | vm print: 'kept ' , h printString ]
							]
					]
			]
	)
	checkValues = (
		(* The value rules (EURASIA_ACTORS_DESIGN_2026-11-17.md section 5), one line each. *)
		
		| probe |
		probe:: EurasiaValueProbe new.
		vm print: 'values: ' , (vm isValue: 'abc') printString , ' ' , (vm isValue: probe) printString , ' ' , (vm isValue: (probe Point x: 3
					y: 4)) printString , ' ' , (vm isValue: probe Box new) printString.
		vm print: ([
				probe Counter new.
				'made'
			] on: Exception do: [:e | e messageText ]).
		vm print: ([
				probe Holder new.
				'made'
			] on: Exception do: [:e | e messageText ]).
		vm print: ([
				probe Box new Inner new.
				'made'
			] on: Exception do: [:e | e messageText ])
	)
	failDeeper = (
		^nil bar
	)
	failDeeply = (
		^self failDeeper
	)
	public main: platform args: args = (
		| log |
		(args isEmpty not and: [ (args at: 1) = 'unhandled' ]) ifTrue: [
				^self failDeeply
			].
		vm print: (3 + 4) printString.
		vm print: (1 << 100) printString.
		vm print: ({1. 2. 3. } collect: [:x | x * x ]) printString.
		vm print: 'abc' , 'def'.
		vm print: ([:x | x + 1 ] value: 41) printString.
		vm print: ([ nil foo ] on: MessageNotUnderstood do: [:e | 'caught DNU' ]).
		vm print: ([ 1 // 0 ] on: NativeFailure do: [:e | e messageText ]).
		log:: 'start'.
		[ log:: log , ' body' ] ensure: [ log:: log , ' ensure' ].
		vm print: log.
		vm print: self returnThroughEnsure printString.
		(platform actors Promise when: 6 <-: * 7
			fulfilled: [:product | vm print: 'eventually ' , product printString ]) isNil.
		checkValues.
		checkActors: platform.
		vm print: 'done'
	)
	public platformOver: internalKernel = (
		^(Runtime kernel: Kernel
			collections: CollectionsForPrimordialSoup
			actors: Actors) Platform internalKernel: internalKernel
	)
	returnThroughEnsure = (
		[ ^42 ] ensure: [].
		^0
	)
) : ()
