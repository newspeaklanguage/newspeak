;; Test helpers for the library regressions. Hand-written, non-normative.

;; Parse a source and interpret it with the library's top-level block.
relation LibDoc: (hoststate, char*) => (interpresult)
rule LibDoc:
  (chi, w*) => (psi)
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (chi, $docState, n*) => (psi)

;; The canonical tree of a source, so expected trees need no spans.
relation LibTree: (hoststate, char*) => (tree)
rule LibTree:
  (chi, w*) => ($canon(tr))
  -- LibDoc: (chi, w*) => (DONE chi' tr)

;; The library's errors, and the core's, of the canonical tree.
relation LibErrors: (hoststate, char*) => (markuperror*, markuperror*)
rule LibErrors:
  (chi, w*) => ($libErrors($canon(tr)), $errors($canon(tr)))
  -- LibDoc: (chi, w*) => (DONE chi' tr)

;; As RoundTrip in tests/signature-fixtures.spectec, for the library.
relation LibRoundTrip: (hoststate, char*) => (char*, bool, bool)
rule LibRoundTrip:
  (chi, w*) => (w'*, $canon(tr) = $canon(tr') /\ chi'' = chi', $print(w'*, tr') = w'*)
  -- LibDoc: (chi, w*) => (DONE chi' tr)
  -- if w'* = $print(w*, tr)
  -- LibDoc: (chi, w'*) => (DONE chi'' tr')

;; Editing (Section 7): what the edit layer computes for a source, so the
;; examples of Section 7 are checked.
relation LibAnchor: (char*, point) => (anchor)
rule LibAnchor:
  (w*, pt) => ($anchor(n*, $nav(DOCM "doc", tr, $steps(pt)), pt))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

relation LibLoc: (char*, step*, nat) => (rng*)
rule LibLoc:
  (w*, pi*, j) => ($rangesOf(n*, $tiAt($kidsOf($navBlock($nav(DOCM "doc", tr, pi*))), j)))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

relation LibIsPoint: (char*, point) => (bool)
rule LibIsPoint:
  (w*, pt) => ($isPoint(DOCM "doc", tr, pt))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

relation LibBackspace: (char*, step*, nat) => (edit)
rule LibBackspace:
  (w*, pi*, j) => ($backspace(DOCM "doc", tr, pi*, j))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

relation LibEnter: (char*, caret) => (edit)
rule LibEnter:
  (w*, ca) => ($enter(DOCM "doc", tr, ca))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

relation LibInsertable: (char*, point, text) => (bool)
rule LibInsertable:
  (w*, pt, x) => ($understands($stateOfT($navBlock($nav(DOCM "doc", tr, $steps(pt)))), x))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

relation LibInsert: (char*, caret, text) => (edit)
rule LibInsert:
  (w*, ca, x) => ($insertAt(DOCM "doc", tr, ca, x))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

;; Carets: where an anchor is placed, whether a caret is well formed, and
;; the caret after an edit of the document "doc" (pi* is the path to the
;; markup the edit is in).
relation LibPlace: (char*, anchor) => (point)
rule LibPlace:
  (w*, a) => ($place(n*, tr, a))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

relation LibCaretOK: (char*, caret) => (bool)
rule LibCaretOK:
  (w*, ca) => ($caretOK(n*, tr, eps, ca))
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (HOSTSTATE 0, $docState, n*) => (DONE chi tr)

relation LibEditCaret: (char*, edit, step*) => (caret)
rule LibEditCaret:
  (w*, ed, pi*) => (ca)
  -- Edit: ((ENTRY "doc" (w*)), "doc", HOSTSTATE 0, $docState, ed) => (EDITED "doc" (w'*) (CARETAT k))
  -- Caret: ((ENTRY "doc" (w'*)), "doc", HOSTSTATE 0, $docState, pi*, k) => (ca)
