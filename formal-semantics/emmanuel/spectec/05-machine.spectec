;; Sections 4.3-4.6: block store, configurations, argument evaluation,
;; steps, and results.

;; @equation eq:block-store
syntax mark = RECOK | RECREJECTED
syntax blockrec = REC blockstate (kid*) (stmt*) mark
var m : mark
syntax store = blockrec*
syntax item = ITEXT (char*) span | ISTMT stmt
syntax config = CONF hoststate store (nat*) (item*) | RAISE hoststate exception
var B : blockrec
var Sigma : store
var beta : nat
var omega : item
var C : config

;; @equation eq:items
def $items(node*) : item*
def $items(eps) = eps
def $items((BLOCK (u*) s' (sigma*) s) n*) = (ITEXT (u*) s') (ISTMT sigma)* $items(n*)
def $items((FINAL (u*) s) n*) = (ITEXT (u*) s) $items(n*)

;; Store operations. Indexing and update are head-recursive functions.
def $at(store, nat) : blockrec
def $at(B B'*, 0) = B
def $at(B B'*, k) = $at(B'*, $(k - 1))
  -- if k > 0

def $put(store, nat, blockrec) : store
def $put(B B'*, 0, B'') = B'' B'*
def $put(B B'*, k, B'') = B $put(B'*, $(k - 1), B'')
  -- if k > 0

def $size(store) : nat
def $size(Sigma) = |Sigma|

def $snoc(store, blockrec) : store
def $snoc(B*, B') = B* B'

def $withKid(blockrec, kid) : blockrec
def $withKid(REC kappa (g*) (sigma*) m, g') = REC kappa (g* g') (sigma*) m
def $withMsg(blockrec, stmt) : blockrec
def $withMsg(REC kappa (g*) (sigma*) m, sigma') = REC kappa (g*) (sigma* sigma') m
def $withState(blockrec, blockstate) : blockrec
def $withState(REC kappa (g*) (sigma*) m, kappa') = REC kappa' (g*) (sigma*) m

def $addKid(store, nat, kid) : store
def $addKid(Sigma, beta, g) = $put(Sigma, beta, $withKid($at(Sigma, beta), g))
def $recv(store, nat, stmt) : store
def $recv(Sigma, beta, sigma) = $put(Sigma, beta, $withMsg($at(Sigma, beta), sigma))
def $setState(store, nat, blockstate) : store
def $setState(Sigma, beta, kappa) = $put(Sigma, beta, $withState($at(Sigma, beta), kappa))
def $withReject(blockrec) : blockrec
def $withReject(REC kappa (g*) (sigma*) m) = REC kappa (g*) (sigma*) RECREJECTED
def $reject(store, nat) : store
def $reject(Sigma, beta) = $put(Sigma, beta, $withReject($at(Sigma, beta)))

;; @equation eq:close
def $close(store, nat) : store
def $closeRec(store, nat, blockrec) : store
;; Block children and inline children of a cell, in a store.
def $stateOf(blockrec) : blockstate
def $stateOf(REC kappa (g*) (sigma*) m) = kappa
def $isBlockKid(store, kid) : bool
def $isBlockKid(Sigma, BLK beta) = $cls($stateOf($at(Sigma, beta))) =/= INLINE
def $isBlockKid(Sigma, g) = false
  -- if $isBlk(g) = false
def $isInlineKid(store, kid) : bool
def $isInlineKid(Sigma, BLK beta) = $cls($stateOf($at(Sigma, beta))) = INLINE
def $isInlineKid(Sigma, g) = false
  -- if $isBlk(g) = false
def $isBlk(kid) : bool
def $isBlk(BLK beta) = true
def $isBlk(RUN (u*) s) = false
def $isBlk(NOTE s) = false
def $isBlk(MUT sigma) = false
def $isBlk(DNU sigma) = false
def $isBlk(STRAY (u*) s) = false
def $isBlk(ROOTPOP sigma) = false
def $isBlk(REFUSED sigma) = false
def $hasBlockKid(store, kid*) : bool
def $hasBlockKid(Sigma, eps) = false
def $hasBlockKid(Sigma, g g'*) = $isBlockKid(Sigma, g) \/ $hasBlockKid(Sigma, g'*)
def $hasTextKid(store, kid*) : bool
def $hasTextKid(Sigma, eps) = false
def $hasTextKid(Sigma, g g'*) = $isRun(g) \/ $isInlineKid(Sigma, g) \/ $hasTextKid(Sigma, g'*)
def $dropSpaces(kid*) : kid*
def $dropSpaces(eps) = eps
def $dropSpaces(g g'*) = $dropSpaces(g'*)
  -- if $isSpaceRun(g)
def $dropSpaces(g g'*) = g $dropSpaces(g'*)
  -- if ~$isSpaceRun(g)
;; Runs are collapsed and never empty, so a run that one stripped space
;; empties is the white-space run.
def $isSpaceRun(kid) : bool
def $isSpaceRun(RUN (u*) s) = ($lstrip(u*) = eps)
def $isSpaceRun(g) = false
  -- if $isRun(g) = false
def $cellMark(store, kid*, mark) : mark
def $cellMark(Sigma, g*, m) = RECREJECTED
  -- if $hasTextKid(Sigma, g*)
def $cellMark(Sigma, g*, m) = m
  -- if ~$hasTextKid(Sigma, g*)

def $close(Sigma, beta) = $closeRec(Sigma, beta, $at(Sigma, beta))
def $closeRec(Sigma, beta, REC kappa (g*) (sigma*) m) = $put(Sigma, beta, REC kappa ($trim(g*)) (sigma*) m)
  -- if $cls(kappa) = PARA \/ ($cls(kappa) = CELL /\ ~$hasBlockKid(Sigma, g*))
def $closeRec(Sigma, beta, REC kappa (g*) (sigma*) m) =
  $put(Sigma, beta, REC kappa ($dropSpaces(g*)) (sigma*) $cellMark(Sigma, $dropSpaces(g*), m))
  -- if $cls(kappa) = CELL /\ $hasBlockKid(Sigma, g*)
def $closeRec(Sigma, beta, REC kappa (g*) (sigma*) m) = Sigma
  -- if $cls(kappa) =/= PARA /\ $cls(kappa) =/= CELL

;; Argument evaluation.
syntax argsoutcome = VALS hoststate (value*) | EXNA hoststate exception
relation Args: (hoststate, hostexpr*) => (argsoutcome)

;; @equation eq:args-nil
;; @rule Args-Nil
rule Args/Args-Nil:
  (chi, eps) => (VALS chi eps)

;; @equation eq:args-cons
;; @rule Args-Cons
rule Args/Args-Cons:
  (chi, eta eta'*) => (VALS chi'' v v'*)
  -- Eval: (chi, eta) => (VAL chi' v)
  -- Args: (chi', eta'*) => (VALS chi'' v'*)

;; @equation eq:args-raise-head
;; @rule Args-Raise-Head
rule Args/Args-Raise-Head:
  (chi, eta eta'*) => (EXNA chi' xi)
  -- Eval: (chi, eta) => (EXN chi' xi)

;; @equation eq:args-raise-tail
;; @rule Args-Raise-Tail
rule Args/Args-Raise-Tail:
  (chi, eta eta'*) => (EXNA chi'' xi)
  -- Eval: (chi, eta) => (VAL chi' v)
  -- Args: (chi', eta'*) => (EXNA chi'' xi)

;; Steps. Each send rule destructures sigma and reads the ToS record.
relation Step: (config) => (config)

;; @equation eq:step-text
;; @rule Step-Text
rule Step/Step-Text:
  (CONF chi Sigma (beta beta'*) ((ITEXT (u*) s) omega*)) =>
    (CONF chi $addKid(Sigma, beta, g) (beta beta'*) omega*)
  -- if $at(Sigma, beta) = REC kappa (g'*) (sigma*) m
  -- if $child($cls(kappa), u*, s) = CHILD g

;; @equation eq:step-text-none
;; @rule Step-Text-None
rule Step/Step-Text-None:
  (CONF chi Sigma (beta beta'*) ((ITEXT (u*) s) omega*)) =>
    (CONF chi Sigma (beta beta'*) omega*)
  -- if $at(Sigma, beta) = REC kappa (g'*) (sigma*) m
  -- if $child($cls(kappa), u*, s) = NOCHILD

;; @equation eq:step-comment
;; @rule Step-Comment
rule Step/Step-Comment:
  (CONF chi Sigma (beta beta'*) ((ISTMT (COMMENT s)) omega*)) =>
    (CONF chi $addKid(Sigma, beta, NOTE s) (beta beta'*) omega*)

;; @equation eq:step-pop
;; @rule Step-Pop
rule Step/Step-Pop:
  (CONF chi Sigma (beta beta' beta''*) ((ISTMT sigma) omega*)) =>
    (CONF chi'' $close($recv(Sigma, beta, sigma), beta) (beta' beta''*) omega*)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EFF chi'' POP)

;; @equation eq:step-pop-reject
;; @rule Step-Pop-Reject
rule Step/Step-Pop-Reject:
  (CONF chi Sigma (beta beta' beta''*) ((ISTMT sigma) omega*)) =>
    (CONF chi'' $reject($close($recv(Sigma, beta, sigma), beta), beta) (beta' beta''*) omega*)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EFF chi'' POPREJECT)

;; @equation eq:step-root-pop
;; @rule Step-Root-Pop
rule Step/Step-Root-Pop:
  (CONF chi Sigma (beta) ((ISTMT sigma) omega*)) =>
    (CONF chi'' $addKid(Sigma, beta, ROOTPOP sigma) (beta) omega*)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EFF chi'' ep)
  -- if ep = POP \/ ep = POPREJECT

;; @equation eq:step-leaf
;; @rule Step-Leaf
rule Step/Step-Leaf:
  (CONF chi Sigma (beta beta'*) ((ISTMT sigma) omega*)) =>
    (CONF chi'' $snoc($addKid(Sigma, beta, BLK $size(Sigma)), REC kappa' eps sigma RECOK) (beta beta'*) omega*)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EFF chi'' (LEAF kappa'))

;; @equation eq:step-push
;; @rule Step-Push
rule Step/Step-Push:
  (CONF chi Sigma (beta beta'*) ((ISTMT sigma) omega*)) =>
    (CONF chi'' $snoc($addKid(Sigma, beta, BLK $size(Sigma)), REC kappa' eps sigma RECOK) ($size(Sigma) beta beta'*) omega*)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EFF chi'' (PUSH kappa'))

;; @equation eq:step-mutate
;; @rule Step-Mutate
rule Step/Step-Mutate:
  (CONF chi Sigma (beta beta'*) ((ISTMT sigma) omega*)) =>
    (CONF chi'' $addKid($recv($setState(Sigma, beta, kappa'), beta, sigma), beta, MUT sigma) (beta beta'*) omega*)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EFF chi'' (MUTATE kappa'))

;; @equation eq:step-dnu
;; @rule Step-Dnu
rule Step/Step-Dnu:
  (CONF chi Sigma (beta beta'*) ((ISTMT sigma) omega*)) =>
    (CONF chi'' $addKid(Sigma, beta, DNU sigma) (beta beta'*) omega*)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EFF chi'' NOTUNDERSTOOD)

;; @equation eq:step-refuse
;; @rule Step-Refuse
rule Step/Step-Refuse:
  (CONF chi Sigma (beta beta'*) ((ISTMT sigma) omega*)) =>
    (CONF chi'' $addKid(Sigma, beta, REFUSED sigma) (beta beta'*) omega*)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EFF chi'' REFUSE)

;; @equation eq:step-arg-raise
;; @rule Step-Arg-Raise
rule Step/Step-Arg-Raise:
  (CONF chi Sigma (beta beta'*) ((ISTMT sigma) omega*)) => (RAISE chi' xi)
  -- if sigma = SEND (s'*) x (eta*) s
  -- Args: (chi, eta*) => (EXNA chi' xi)

;; @equation eq:step-effect-raise
;; @rule Step-Effect-Raise
rule Step/Step-Effect-Raise:
  (CONF chi Sigma (beta beta'*) ((ISTMT sigma) omega*)) => (RAISE chi'' xi)
  -- if sigma = SEND (s'*) x (eta*) s
  -- if $at(Sigma, beta) = REC kappa (g*) (sigma'*) m
  -- Args: (chi, eta*) => (VALS chi' v*)
  -- Effect: (chi', kappa, x, v*) => (EXNS chi'' xi)

;; Results.
;; @equation eq:read-tree
def $flag(nat, nat*, mark) : flag
def $flag(beta, beta'*, m) = UNCLOSED
  -- if beta <- beta'*
def $flag(beta, beta'*, RECREJECTED) = REJECTED
  -- if ~(beta <- beta'*)
def $flag(beta, beta'*, RECOK) = CLOSED
  -- if ~(beta <- beta'*)

def $tree(store, nat*, nat) : tree
def $treeOf(store, nat*, nat, blockrec) : tree
def $titems(store, nat*, kid*) : titem*
def $titem(store, nat*, kid) : titem
def $tree(Sigma, beta'*, beta) = $treeOf(Sigma, beta'*, beta, $at(Sigma, beta))
def $treeOf(Sigma, beta'*, beta, REC kappa (g*) (sigma*) m) =
  TREE kappa ($titems(Sigma, beta'*, g*)) (sigma*) $flag(beta, beta'*, m)
def $titems(Sigma, beta'*, eps) = eps
def $titems(Sigma, beta'*, g g'*) = $titem(Sigma, beta'*, g) $titems(Sigma, beta'*, g'*)
def $titem(Sigma, beta'*, BLK beta) = SUB $tree(Sigma, beta'*, beta)
def $titem(Sigma, beta'*, RUN (u*) s) = RUN (u*) s
def $titem(Sigma, beta'*, NOTE s) = NOTE s
def $titem(Sigma, beta'*, MUT sigma) = MUT sigma
def $titem(Sigma, beta'*, DNU sigma) = DNU sigma
def $titem(Sigma, beta'*, STRAY (u*) s) = STRAY (u*) s
def $titem(Sigma, beta'*, ROOTPOP sigma) = ROOTPOP sigma
def $titem(Sigma, beta'*, REFUSED sigma) = REFUSED sigma

;; @equation eq:interp-results
syntax interpresult = DONE hoststate tree | RAISED hoststate exception
var psi : interpresult

relation Run: (config) => (interpresult)

;; @equation eq:interp-done
;; @rule Interp-Done
rule Run/Interp-Done:
  (CONF chi Sigma (beta'* 0) eps) => (DONE chi $tree(Sigma, beta'*, 0))

;; @equation eq:interp-step
;; @rule Interp-Step
rule Run/Interp-Step:
  (C) => (psi)
  -- Step: (C) => (CONF chi' Sigma' (beta'*) omega'*)
  -- Run: (CONF chi' Sigma' (beta'*) omega'*) => (psi)

;; @equation eq:interp-raise
;; @rule Interp-Raise
rule Run/Interp-Raise:
  (C) => (RAISED chi' xi)
  -- Step: (C) => (RAISE chi' xi)

relation Interp: (hoststate, blockstate, node*) => (interpresult)

;; @equation eq:interpret
;; @rule Interpret
rule Interp/Interpret:
  (chi, kappa, n*) => (psi)
  -- Run: (CONF chi (REC kappa eps eps RECOK) (0) $items(n*)) => (psi)

;; @equation eq:interpret-with
def $markupNodes(markupliteral) : node*
def $markupNodes(MARKUP nm (n*) s) = n*
relation InterpretWith: (hoststate, markupliteral, blockstate) => (interpresult)
rule InterpretWith:
  (chi, L, kappa) => (psi)
  -- Interp: (chi, kappa, $markupNodes(L)) => (psi)

;; @equation eq:errors
syntax markuperror = UNCLOSEDBLOCK (stmt*) | REJECTEDBLOCK (stmt*) | ERRORLEAF titem
def $errors(tree) : markuperror*
def $errorsOf(titem*) : markuperror*
def $errorsItem(titem) : markuperror*
def $flagErrors(flag, stmt*) : markuperror*
def $errors(TREE kappa (ti*) (sigma*) f) = $flagErrors(f, sigma*) $errorsOf(ti*)
def $flagErrors(UNCLOSED, sigma*) = UNCLOSEDBLOCK (sigma*)
def $flagErrors(REJECTED, sigma*) = REJECTEDBLOCK (sigma*)
def $flagErrors(CLOSED, sigma*) = eps
def $errorsOf(eps) = eps
def $errorsOf(ti ti'*) = $errorsItem(ti) $errorsOf(ti'*)
def $errorsItem(SUB tr) = $errors(tr)
def $errorsItem(DNU sigma) = ERRORLEAF (DNU sigma)
def $errorsItem(STRAY (u*) s) = ERRORLEAF (STRAY (u*) s)
def $errorsItem(ROOTPOP sigma) = ERRORLEAF (ROOTPOP sigma)
def $errorsItem(REFUSED sigma) = ERRORLEAF (REFUSED sigma)
def $errorsItem(RUN (u*) s) = eps
def $errorsItem(NOTE s) = eps
def $errorsItem(MUT sigma) = eps
