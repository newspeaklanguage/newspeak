Newspeak3
'Emmanuel'
class EmmanuelLiveEditor usingPlatform: p emmanuel: EmmanuelClass newspeakHost: HostClass blocks: BlocksClass edit: EditClass incremental: IncrementalClass parsing: ParsingClass asts: ASTsClass = (
	(* A live editing view of an Emmanuel source: the reference editor of the
prototype plan's milestone M3. It shows the document as the block
presenters render it, and turns what one types into the edits of Section 7
(EmmanuelEdit): each keystroke edits the source, which is reinterpreted
whole, and the view is rendered again with the caret where the edit put it.

  (EmmanuelLiveEditor usingPlatform: platform
      emmanuel: Emmanuel
      newspeakHost: EmmanuelNewspeakHost
      blocks: EmmanuelBlocks
      edit: EmmanuelEdit
      incremental: EmmanuelIncremental
      parsing: NewspeakPredictiveParsing
      asts: NewspeakASTs)
          editorOn: '[\paragraph\]Hello[\endParagraph\]'

answers the editor, a fragment; its session holds the source.

The presenters mark their rendering with each block's path (data-steps)
and each child's index (data-item); the editor maps the browser's selection
to points through them, and points back to the selection. Typing, deleting,
Enter, Shift-Enter (a newline), bold and italic (Cmd-B, Cmd-I), and pasting
plain text are edits; anything else is ignored. The editor keeps its key and input
events to itself, so that an editable page around it (an Ampleforth
document's) does not see them. An edit the edit layer
refuses changes nothing. *)
	
	|
		private List = p collections List.
		private Fragment = p hopscotch Fragment.
		private domDocument = p js global at: #document.
		private console = p js global at: #console.
		private window = p js global.
		private clock = p js global at: #performance.
		private emmanuel = EmmanuelClass usingPlatform: p.
		private parsing = ParsingClass usingPlatform: p
			asts: (ASTsClass usingPlatform: p).
		private hosts = HostClass usingPlatform: p emmanuel: emmanuel parsing: parsing.
		public blocks = BlocksClass usingPlatform: p emmanuel: emmanuel.
		public edits = EditClass usingPlatform: p emmanuel: emmanuel library: blocks.
		private incremental = IncrementalClass usingPlatform: p emmanuel: emmanuel.
	|
) (
	public class EditorFragment session: s = Fragment new (
		(* The editor: a contenteditable element holding the rendering of the
session's tree. *)
		
		|
			public session = s.
			root
			content
			typed
		|
	) (
		backspaceAt: c = (
			(* The edit that deletes the character before a caret, or joins its
block with the one before it. *)
			
			| pt = c point. kids prev ss |
			pt isGap ifFalse: [
					^edits replace: (edits exact: (pt offset = 1 ifTrue: [
									edits gap: pt steps at: pt child
								]
								ifFalse: [ edits in: pt steps at: pt child offset: pt offset - 1 ]))
						to: c
						items: {}
						after: {}
				].
			pt child > 0 ifTrue: [
					kids:: kidsAt: pt steps.
					prev:: kids at: pt child.
					prev kind = #run ifTrue: [
							^edits replace: (edits exact: (prev chars size = 1 ifTrue: [
											edits gap: pt steps at: pt child - 1
										]
										ifFalse: [
											edits in: pt steps at: pt child - 1 offset: prev chars size - 1
										]))
								to: c
								items: {}
								after: {}
						].
					(isLeaf: prev) ifTrue: [ ^deleteChild: pt child - 1 at: pt steps caret: c ].
					prev kind = #sub ifTrue: [
							ss:: pt steps , {edits into: pt child - 1. }.
							^backspaceAt: (edits exact: (edits gap: ss at: (kidsAt: ss) size))
						].
					^nil
				].
			ss:: pt steps.
			[ ss isEmpty not and: [ ss last isField not and: [ ss last index = 0 ] ] ] whileTrue: [
					ss:: ss copyFrom: 1 to: ss size - 1
				].
			(ss isEmpty or: [ ss last isField ]) ifTrue: [ ^nil ].
			kids:: kidsAt: (ss copyFrom: 1 to: ss size - 1).
			(ss last index > 0 and: [ isLeaf: (kids at: ss last index) ]) ifTrue: [
					^deleteChild: ss last index - 1
						at: (ss copyFrom: 1 to: ss size - 1)
						caret: c
				].
			^edits backspace: markup
				tree: session tree
				steps: (ss copyFrom: 1 to: ss size - 1)
				index: ss last index
		)
		caretFor: pt = (
			(* The caret at a point: the session's caret when it is there, since
its anchor may lie in white space the view does not show. *)
			
			(session caret isNil not and: [
					(emmanuel termStringOf: session caret point) = (emmanuel termStringOf: pt)
				]) ifTrue: [ ^session caret ].
			^edits exact: pt
		)
		public childrenDo: action = (
		)
		createVisual = (
			root:: domDocument createElement: 'div'.
			root setAttribute: 'contenteditable' to: 'true'.
			root setAttribute: 'style'
				to: 'white-space: pre-wrap; outline: none; padding: 4px; min-height: 2em;'.
			root addEventListener: 'beforeinput'
				action: [:event |
					event stopPropagation.
					[ handle: event ] on: Error
						do: [:e | console log: 'Emmanuel editor: ' , e messageText printString ].
					nil
				].
			{'keyup'. 'keypress'. 'input'. 'paste'. 'cut'. 'drop'. } do: [:type |
					root addEventListener: type
						action: [:event |
							event stopPropagation.
							nil
						]
				].
			root appendChild: styleSheet.
			root addEventListener: 'click'
				action: [:event |
					[ handleClick: event ] on: Error
						do: [:e | console log: 'Emmanuel editor: ' , e messageText printString ].
					nil
				].
			root addEventListener: 'keydown'
				action: [:event |
					event stopPropagation.
					[ handleKey: event ] on: Error
						do: [:e | console log: 'Emmanuel editor: ' , e messageText printString ].
					nil
				].
			render.
			^root
		)
		dataAttribute: name of: node = (
			(node at: #nodeType) = 1 ifFalse: [ ^nil ].
			^node getAttribute: name
		)
		deleteChild: j at: ss caret: c = (
			(* The edit that deletes the child j of the block at ss, a leaf. *)
			
			^edits replace: (edits exact: (edits gap: ss at: j))
				to: (edits exact: (edits gap: ss at: j + 1))
				items: {}
				after: {}
		)
		deleteForwardAt: c = (
			(* The edit that deletes the character after a caret, or joins the
next block to its block. *)
			
			| pt = c point. kids next ss |
			kids:: kidsAt: pt steps.
			pt isGap ifFalse: [
					next:: kids at: pt child + 1.
					^edits replace: c
						to: (edits exact: (pt offset + 1 = next chars size ifTrue: [
									edits gap: pt steps at: pt child + 1
								]
								ifFalse: [ edits in: pt steps at: pt child offset: pt offset + 1 ]))
						items: {}
						after: {}
				].
			pt child < kids size ifTrue: [
					next:: kids at: pt child + 1.
					next kind = #run ifTrue: [
							^edits replace: c
								to: (edits exact: (next chars size = 1 ifTrue: [
											edits gap: pt steps at: pt child + 1
										]
										ifFalse: [ edits in: pt steps at: pt child offset: 1 ]))
								items: {}
								after: {}
						].
					(isLeaf: next) ifTrue: [ ^deleteChild: pt child at: pt steps caret: c ].
					next kind = #sub ifTrue: [
							^deleteForwardAt: (edits exact: (edits gap: pt steps , {edits into: pt child. }
										at: 0))
						].
					^nil
				].
			ss:: pt steps.
			(ss isEmpty or: [ ss last isField ]) ifTrue: [ ^nil ].
			kids:: kidsAt: (ss copyFrom: 1 to: ss size - 1).
			(ss last index + 2 <= kids size and: [ isLeaf: (kids at: ss last index + 2) ]) ifTrue: [
					^deleteChild: ss last index + 1
						at: (ss copyFrom: 1 to: ss size - 1)
						caret: c
				].
			^edits backspace: markup
				tree: session tree
				steps: (ss copyFrom: 1 to: ss size - 1)
				index: ss last index + 1
		)
		edit: makeEdit = (
			(* Apply the edit makeEdit makes from the selection (its start and
end carets, and whether it is collapsed); then render again and place the
caret. *)
			
			| selection = domDocument getSelection. range a b collapsed e caret |
			typed:: nil.
			session tree isNil ifTrue: [ ^self ].
			(selection at: #rangeCount) = 0 ifTrue: [ ^self ].
			range:: selection getRangeAt: 0.
			collapsed:: range at: #collapsed.
			((root contains: (range at: #startContainer)) and: [
					root contains: (range at: #endContainer)
				]) ifFalse: [ ^self ].
			a:: caretFor: (pointAt: (range at: #startContainer)
					offset: (range at: #startOffset)).
			b:: collapsed ifTrue: [ a ]
				ifFalse: [
					edits exact: (pointAt: (range at: #endContainer)
							offset: (range at: #endOffset))
				].
			e:: makeEdit value: a value: b value: collapsed.
			e isNil ifTrue: [ ^self ].
			caret:: session apply: e typed: typed.
			caret isNil ifTrue: [ ^self ].
			render.
			place: caret point
		)
		editFor: type event: event caret: a caret: b collapsed: collapsed = (
			| text |
			(type = 'insertText' or: [ type = 'insertReplacementText' ]) ifTrue: [
					text:: event at: #data.
					text isNil ifTrue: [ ^nil ].
					^typing: text from: a to: b
				].
			type = 'insertFromPaste' ifTrue: [
					^typing: ((event at: #dataTransfer) getData: 'text/plain') from: a to: b
				].
			type = 'insertParagraph' ifTrue: [
					collapsed ifFalse: [ ^edits replace: a to: b items: {} after: {} ].
					^edits enter: markup tree: session tree caret: a
				].
			type = 'insertLineBreak' ifTrue: [
					^edits replace: a
						to: b
						items: {emmanuel Item text: nil
							span: nil
							statement: (blocks styleOpen: 'newline'). }
						after: {}
				].
			type = 'deleteContentBackward' ifTrue: [
					collapsed ifFalse: [ ^edits replace: a to: b items: {} after: {} ].
					^backspaceAt: a
				].
			type = 'deleteContentForward' ifTrue: [
					collapsed ifFalse: [ ^edits replace: a to: b items: {} after: {} ].
					^deleteForwardAt: a
				].
			(type = 'deleteByCut' or: [ type = 'deleteContent' ]) ifTrue: [
					^edits replace: a to: b items: {} after: {}
				].
			(type = 'formatBold' and: [ collapsed not ]) ifTrue: [
					^styleFrom: a to: b style: 'strong'
				].
			(type = 'formatItalic' and: [ collapsed not ]) ifTrue: [
					^styleFrom: a to: b style: 'emphasis'
				].
			^nil
		)
		elementAt: ss = (
			| key = stepsString: ss. |
			^root querySelector: '[data-steps="' , key , '"]'
		)
		handle: event = (
			(* An input event: its edit, applied. *)
			
			| type = event at: #inputType. |
			event preventDefault.
			edit: [:a :b :collapsed |
					editFor: type event: event caret: a caret: b collapsed: collapsed
				]
		)
		handleClick: event = (
			(* Cmd-click (Ctrl-click elsewhere) on a link opens its target. *)
			
			| anchor |
			((event at: #metaKey) or: [ event at: #ctrlKey ]) ifFalse: [ ^self ].
			anchor:: (event at: #target) closest: 'a[href]'.
			anchor isNil ifTrue: [ ^self ].
			event preventDefault.
			window open: (anchor getAttribute: 'href') with: '_blank'
		)
		handleKey: event = (
			(* Cmd-B and Cmd-I (Ctrl on other platforms) style the selection. *)
			
			| key = event at: #key. style |
			((event at: #metaKey) or: [ event at: #ctrlKey ]) ifFalse: [ ^self ].
			key = 'b' ifTrue: [ style:: 'strong' ].
			key = 'i' ifTrue: [ style:: 'emphasis' ].
			style isNil ifTrue: [ ^self ].
			event preventDefault.
			edit: [:a :b :collapsed |
					collapsed ifTrue: [ nil ] ifFalse: [ styleFrom: a to: b style: style ]
				]
		)
		indexOf: node in: parent = (
			(* The index of a child node. The DOM decides identity: two aliens of
one node are not ==. *)
			
			| kids = parent at: #childNodes. |
			0 to: (kids at: #length) - 1
				do: [:i | ((kids at: i) isSameNode: node) ifTrue: [ ^i ] ].
			^0
		)
		public isKindOfEmmanuelEditorFragment = (
			^true
		)
		isLeaf: g = (
			(* Whether a child is a leaf block (an amplet, a newline): one the
caret does not go into, which Backspace and Delete delete whole. *)
			
			^g kind = #sub and: [
					g ref messages size = 1 and: [ g ref flag ~= #unclosed ]
				]
		)
		isMyKind: other = (
			^other isKindOfEmmanuelEditorFragment
		)
		isRunElement: element = (
			^(element at: #nodeType) = 1 and: [
					(element at: #tagName) = 'SPAN' and: [
							(element getAttribute: 'contenteditable') isNil and: [
									((element at: #childNodes) at: #length) = 1
								]
						]
				]
		)
		itemElementsOf: element = (
			(* The children of a block's element that render its children, by
their index. *)
			
			| out = List new. kids = element at: #childNodes. |
			0 to: (kids at: #length) - 1
				do: [:i |
					| k = kids at: i. j = dataAttribute: 'data-item' of: k. |
					j isNil ifFalse: [ out add: {Integer parse: j radix: 10. k. } ]
				].
			^out asArray
		)
		kidsAt: ss = (
			^(edits nav: markup tree: session tree steps: ss) block items
		)
		markup = (
			^edits Markup document: 'doc' literal: nil
		)
		place: pt = (
			(* Put the browser's caret at a point. *)
			
			| element = elementAt: pt steps. items range child before node offset |
			element isNil ifTrue: [ ^self ].
			items:: itemElementsOf: element.
			child:: items detect: [:x | (x at: 1) = pt child ] ifNone: [ nil ].
			before:: items detect: [:x | (x at: 1) = (pt child - 1) ] ifNone: [ nil ].
			pt isGap ifTrue: [
					(child isNil not and: [ isRunElement: (child at: 2) ]) ifTrue: [
							node:: (child at: 2) at: #firstChild.
							offset:: 0
						]
						ifFalse: [
							(before isNil not and: [ isRunElement: (before at: 2) ]) ifTrue: [
									node:: (before at: 2) at: #firstChild.
									offset:: node at: #length
								]
								ifFalse: [
									node:: element.
									offset:: child isNil ifTrue: [ (element at: #childNodes) at: #length ]
										ifFalse: [ indexOf: (child at: 2) in: element ]
								]
						]
				]
				ifFalse: [
					child isNil ifTrue: [ ^self ].
					node:: (child at: 2) at: #firstChild.
					offset:: pt offset
				].
			range:: domDocument createRange.
			range setStart: node offset: offset.
			range collapse: true.
			domDocument getSelection removeAllRanges.
			domDocument getSelection addRange: range
		)
		pointAt: node offset: o = (
			(* The point of a position in the rendering. *)
			
			| parent steps j length items next |
			(node at: #nodeType) = 3 ifTrue: [
					parent:: node at: #parentNode.
					j:: dataAttribute: 'data-item' of: parent.
					j isNil ifTrue: [
							^pointAt: parent offset: (o > 0 ifTrue: [ 1 ] ifFalse: [ 0 ])
						].
					steps:: stepsOf: (parent at: #parentNode).
					j:: Integer parse: j radix: 10.
					length:: node at: #length.
					o = 0 ifTrue: [ ^edits gap: steps at: j ].
					o >= length ifTrue: [ ^edits gap: steps at: j + 1 ].
					^edits in: steps at: j offset: o
				].
			(dataAttribute: 'data-steps' of: node) isNil ifFalse: [
					steps:: stepsOf: node.
					items:: itemElementsOf: node.
					next:: items detect: [:x | (indexOf: (x at: 2) in: node) >= o ]
						ifNone: [ nil ].
					next isNil ifTrue: [ ^edits gap: steps at: (kidsAt: steps) size ].
					^edits gap: steps at: (next at: 1)
				].
			(node isSameNode: root) ifTrue: [
					^edits gap: {} at: (o = 0 ifTrue: [ 0 ] ifFalse: [ (kidsAt: {}) size ])
				].
			j:: dataAttribute: 'data-item' of: node.
			parent:: node at: #parentNode.
			parent isNil ifTrue: [ ^nil ].
			j isNil ifFalse: [
					steps:: stepsOf: parent.
					^edits gap: steps
						at: (Integer parse: j radix: 10) + (o > 0 ifTrue: [ 1 ] ifFalse: [ 0 ])
				].
			^pointAt: parent
				offset: (indexOf: node in: parent) + (o > 0 ifTrue: [ 1 ] ifFalse: [ 0 ])
		)
		render = (
			(* Render the session's tree in place of the previous rendering. *)
			
			| subject presenter visual start |
			session tree isNil ifTrue: [ ^renderUnparsable ].
			subject:: blocks TreeSubject onModel: session tree.
			subject amplets: session amplets.
			presenter:: subject presenter.
			presenter parent: self.
			session amplets beginRender.
			start:: clock now.
			visual:: presenter visual.
			session timings: session timings , ', render ' , (clock now - start) printString.
			session amplets endRender.
			session failed ifTrue: [ visual setAttribute: 'style' to: 'opacity: 0.5;' ].
			content isNil ifTrue: [ root appendChild: visual ]
				ifFalse: [ root replaceChild: visual with: content ].
			content:: visual
		)
		renderUnparsable = (
			(* A source that has never interpreted has no tree to show: its text
is shown, dimmed, until it does. *)
			
			| visual = domDocument createElement: 'div'. |
			visual setAttribute: 'style' to: 'opacity: 0.5;'.
			visual at: #textContent put: session sourceString.
			content isNil ifTrue: [ root appendChild: visual ]
				ifFalse: [ root replaceChild: visual with: content ].
			content:: visual
		)
		public replaceSelectionWith: items after: afterItems = (
			(* Replace the selection with items, the caret after them and before
afterItems; for commands, such as a toolbar's. *)
			
			edit: [:a :b :collapsed |
					edits replace: a to: b items: items after: afterItems
				]
		)
		public selectedText = (
			^domDocument getSelection toString
		)
		public source: w = (
			(* Make the string w the source, as when the raw view changes it: it
is reinterpreted, and shown again. While it does not interpret, the last
tree that did is shown, dimmed, and typing in it does nothing. *)
			
			session reinterpret: (emmanuel codePointsOf: w).
			root isNil ifFalse: [ render ]
		)
		stepsOf: element = (
			| s = dataAttribute: 'data-steps' of: element. |
			s isNil ifTrue: [ ^{} ].
			^(words: s) collect: [:w |
					| cps = emmanuel codePointsOf: w. j = Integer parse: (emmanuel stringOfCodePoints: (cps copyFrom: 2
								to: cps size))
						radix: 10. |
					cps first = 102 ifTrue: [ edits fieldOf: j ] ifFalse: [ edits into: j ]
				]
		)
		stepsString: ss = (
			| out ::= ''. |
			ss keysAndValuesDo: [:i :s |
					i > 1 ifTrue: [ out:: out , ' ' ].
					out:: out , (s isField ifTrue: [ 'f' ] ifFalse: [ 'i' ]) , s index printString
				].
			^out
		)
		styleFrom: a to: b style: x = (
			^edits Edit kind: #style
				caret: a
				caret: b
				items: nil
				after: nil
				level: nil
				style: x
				steps: nil
				index: nil
				chars: nil
		)
		public styleSelection: x = (
			(* Style the selection: emphasis, strong, or code. *)
			
			edit: [:a :b :collapsed |
					collapsed ifTrue: [ nil ] ifFalse: [ styleFrom: a to: b style: x ]
				]
		)
		styleSheet = (
			(* Empty blocks keep a height, so that the caret can be put in them. *)
			
			| s = domDocument createElement: 'style'. |
			s at: #textContent
				put: '[data-steps]:empty { min-height: 1.2em; } span[data-steps]:empty, em[data-steps]:empty, strong[data-steps]:empty, code[data-steps]:empty, a[data-steps]:empty { display: inline-block; min-width: 1px; }'.
			^s
		)
		typing: text from: a to: b = (
			typed:: emmanuel codePointsOf: text.
			^edits replace: a
				to: b
				items: {emmanuel Item text: (emmanuel codePointsOf: text)
					span: (emmanuel Span from: 0 to: 0)
					statement: nil. }
				after: {}
		)
		updateVisualsFromSameKind: oldFragment = (
			^replaceVisual: oldFragment visual with: visual
		)
		words: s = (
			| out = List new. word = List new. |
			(emmanuel codePointsOf: s) do: [:c |
					c = 32 ifTrue: [
							word isEmpty ifFalse: [
									out add: (emmanuel stringOfCodePoints: word asArray).
									word removeAll
								]
						]
						ifFalse: [ word add: c ]
				].
			word isEmpty ifFalse: [ out add: (emmanuel stringOfCodePoints: word asArray) ].
			^out asArray
		)
	) : ()
	public class Session source: w evaluator: ev = (
		(* An edited source: its text, its nodes and tree (the last that
interpreted, when the source does not), and the caret of the last edit. *)
		
		|
			public source ::= emmanuel codePointsOf: w.
			public host = hosts Host evaluator: ev.
			public amplets = blocks AmpletRunner evaluator: ev.
			public nodes
			public tree
			public failed ::= false.
			public caret
			public timings ::= ''.
			public changeHandler ::= nil.
		|
		interpret.
	) (
		public agreesWithWholeParse = (
			(* Whether the nodes, kept incrementally, are those of parsing the
whole source; for tests. *)
			
			| whole = emmanuel parse: 'doc'
				source: source
				host: (hosts Host evaluator: nil). |
			(whole isNil or: [ whole isKindOfParsed not ]) ifTrue: [ ^failed ].
			whole nodes size = nodes size ifFalse: [ ^false ].
			1 to: nodes size
				do: [:i |
					(emmanuel termStringOf: (whole nodes at: i)) = (emmanuel termStringOf: (nodes at: i)) ifFalse: [
							^false
						]
				].
			^true
		)
		public apply: e = (
			^apply: e typed: nil
		)
		public apply: e typed: typed = (
			(* Apply an edit: answers the caret after it, or nil when the edit
was refused or changed another source. When the edit types the code points
typed, a space among them that white space beside it would collapse away
becomes a no-break space, so that what one types is what one sees. *)
			
			| t0 = clock now. t1 t2 result |
			failed ifTrue: [ ^nil ].
			result:: edits edit: e
				image: image
				name: 'doc'
				document: {nodes. tree. }
				host: host.
			t1:: clock now.
			(result isNil or: [ result isRefused ]) ifTrue: [ ^nil ].
			result sourceName = 'doc' ifFalse: [ ^nil ].
			reinterpret: (typed isNil ifTrue: [ result chars ]
					ifFalse: [ keepSpaces: typed in: result chars before: result caret ]).
			changeHandler isNil ifFalse: [ changeHandler value: sourceString ].
			t2:: clock now.
			timings:: 'edit ' , (t1 - t0) printString , ', interpret ' , (t2 - t1) printString.
			result caret isNil ifTrue: [ ^caret ].
			caret:: failed ifTrue: [ nil ]
				ifFalse: [
					edits caretIn: image
						name: 'doc'
						document: {nodes. tree. }
						steps: (markupSteps: e)
						offset: result caret
				].
			timings:: timings , ', caret ' , (clock now - t2) printString.
			^caret
		)
		image = (
			^{{'doc'. source. }. }
		)
		interpret = (
			| doc = edits document: image
				name: 'doc'
				hostState: nil
				root: blocks DocumentRoot new
				host: host. |
			doc isNil ifTrue: [
					failed:: true.
					^self
				].
			failed:: false.
			nodes:: doc at: 1.
			tree:: doc at: 2
		)
		keepSpaces: typed in: w before: k = (
			(* w, a source in which typed ends at offset k, with each space of
typed that has white space beside it made a no-break space. *)
			
			| out = w copy. n = typed size. |
			(k isNil or: [ k < n or: [ k > w size ] ]) ifTrue: [ ^w ].
			1 to: n do: [:i | (w at: k - n + i) = (typed at: i) ifFalse: [ ^w ] ].
			k - n + 1 to: k
				do: [:i |
					((out at: i) = 32 and: [
							(i > 1 and: [ emmanuel isWS: (out at: i - 1) ]) or: [
									i < out size and: [ emmanuel isWS: (out at: i + 1) ]
								]
						]) ifTrue: [ out at: i put: 160 ]
				].
			^out
		)
		markupSteps: e = (
			(* The path to the markup an edit is in: its point's path, up to the
last field it enters. *)
			
			| ss = e first point steps. k ::= 0. |
			ss keysAndValuesDo: [:i :s | s isField ifTrue: [ k:: i ] ].
			^ss copyFrom: 1 to: k
		)
		public reinterpret: w = (
			(* Make w the source: reparse only what the edit damaged
(EmmanuelIncremental), or, when that will not do, all of it; then
interpret. *)
			
			| old = source. reparsed done |
			source:: w.
			failed ifTrue: [ ^interpret ].
			reparsed:: incremental reparse: nodes old: old new: w name: 'doc' host: host.
			reparsed isNil ifTrue: [ ^interpret ].
			done:: (emmanuel Machine host: host) interpret: reparsed
				root: blocks DocumentRoot new
				hostState: nil.
			done isKindOfDone ifFalse: [
					failed:: true.
					^self
				].
			nodes:: reparsed.
			tree:: done tree
		)
		public sourceString = (
			^emmanuel stringOfCodePoints: source
		)
	) : ()
	public codeItem: selector code: code = (
		(* The item of a send of selector to an argument, the Newspeak code. *)
		
		^sendItem: selector
			argument: (hosts HostExpr ast: nil
				text: code
				literals: {}
				placeholder: false
				span: (emmanuel Span from: 0 to: 0))
	)
	public editorOn: source = (
		(* An editor of a source; computed arguments are an error. *)
		
		^editorOn: source evaluator: nil
	)
	public editorOn: source evaluator: ev = (
		^EditorFragment session: (Session source: source evaluator: ev)
	)
	public markupItem: selector text: u = (
		(* The item of a send of selector to a markup literal of the text u. *)
		
		| zero = emmanuel Span from: 0 to: 0. literal = emmanuel MarkupLiteral source: 'doc'
			nodes: {emmanuel FinalNode contents: (emmanuel codePointsOf: u) span: zero. }
			span: zero. |
		^sendItem: selector
			argument: (hosts HostExpr ast: nil
				text: ''
				literals: {literal. }
				placeholder: true
				span: zero)
	)
	public profile: source = (
		(* The time, in milliseconds, of each stage of a full pass over a
source: lexing, tokens, the structural parse, resolution (the host's
parsing of the brackets) with a fresh host and again with the same one,
interpretation, printing, and rendering. *)
		
		| w = emmanuel codePointsOf: source. host = hosts Host evaluator: nil. t lexed toks markup nodes done out |
		t:: clock now.
		lexed:: emmanuel lex: w.
		out:: 'lex ' , (clock now - t) printString.
		t:: clock now.
		toks:: emmanuel tokens: lexed located.
		out:: out , ', tokens ' , (clock now - t) printString.
		t:: clock now.
		emmanuel fastTokens: w.
		out:: out , ', fast tokens ' , (clock now - t) printString.
		t:: clock now.
		markup:: emmanuel parseMarkup: toks from: 1.
		out:: out , ', structure ' , (clock now - t) printString.
		t:: clock now.
		nodes:: emmanuel resolve: 'doc' nodes: (markup at: 1) host: host.
		out:: out , ', resolve ' , (clock now - t) printString.
		t:: clock now.
		emmanuel resolve: 'doc' nodes: (markup at: 1) host: host.
		out:: out , ', resolve again ' , (clock now - t) printString.
		t:: clock now.
		done:: (emmanuel Machine host: host) interpret: nodes
			root: blocks DocumentRoot new
			hostState: nil.
		out:: out , ', interpret ' , (clock now - t) printString.
		t:: clock now.
		emmanuel print: done tree source: w host: host.
		out:: out , ', print ' , (clock now - t) printString.
		t:: clock now.
		(blocks TreeSubject onModel: done tree) presenter visual.
		^out , ', render ' , (clock now - t) printString
	)
	sendItem: selector argument: e = (
		^emmanuel Item text: nil
			span: nil
			statement: (emmanuel SendStatement comments: {}
				selector: selector
				arguments: {e. }
				span: (emmanuel Span from: 0 to: 0))
	)
	public textItem: u = (
		^emmanuel Item text: (emmanuel codePointsOf: u)
			span: (emmanuel Span from: 0 to: 0)
			statement: nil
	)
	public unaryItem: selector = (
		^emmanuel Item text: nil span: nil statement: (blocks styleOpen: selector)
	)
) : ()
