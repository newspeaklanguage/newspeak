Newspeak3
'Emmanuel'
class EmmanuelIncrementalTestingConfiguration packageTestsUsing: manifest = (
	(* Tests of the incremental pipeline against the reference. From tool/:
  ./run-tests.sh EmmanuelIncrementalTestingConfiguration ../Emmanuel.ns ../EmmanuelNewspeakHost.ns ../EmmanuelIncremental.ns ../EmmanuelIncrementalTesting.ns ../NewspeakASTs.ns ../../primordialsoup/newspeak/NewspeakPredictiveParsing.ns *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelIncremental = manifest EmmanuelIncremental.
		private EmmanuelIncrementalTesting = manifest EmmanuelIncrementalTesting.
		private EmmanuelNewspeakHost = manifest EmmanuelNewspeakHost.
		private NewspeakASTs = manifest NewspeakASTs.
		private NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
	|
) (
	public testModulesUsingPlatform: p minitest: m = (
		| emmanuel = Emmanuel usingPlatform: p. parsing = NewspeakPredictiveParsing usingPlatform: p
			asts: (NewspeakASTs usingPlatform: p). |
		^{EmmanuelIncrementalTesting usingPlatform: p
			minitest: m
			emmanuel: emmanuel
			host: (EmmanuelNewspeakHost usingPlatform: p
				emmanuel: emmanuel
				parsing: parsing)
			incremental: (EmmanuelIncremental usingPlatform: p emmanuel: emmanuel). }
	)
) : ()
