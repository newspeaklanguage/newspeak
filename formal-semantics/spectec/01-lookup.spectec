;; Sections 4 and 5: inference rules, not an ordered search algorithm.

relation Unrestricted: (lookupProgram, lookupHeap) |- (selector, classid) => (lookupresult)
relation Defining: (lookupProgram, lookupHeap) |- (selector, classid) => (classresult)
relation Public: (lookupProgram, lookupHeap) |- (selector, classid) => (lookupresult)
relation Protected: (lookupProgram, lookupHeap) |- (selector, classid) => (lookupresult)

;; @rule U-Top
rule Unrestricted/U-Top:
  (P, H) |- (s, P.TOP) => (ABSENT)

;; Top guards expose the LaTeX invariant that Top has no direct methods.
;; They prevent conflicting derivations even on an invalid projected state.
;; @rule U-Here
rule Unrestricted/U-Here:
  (P, H) |- (s, C) => (FOUND f C)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = METHODFOUND f

;; @rule U-Super
rule Unrestricted/U-Super:
  (P, H) |- (s, C) => (r)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = NOMETHOD
  -- Unrestricted: (P, H) |- (s, $superclass(H, C)) => (r)

;; @rule Defining-Top
rule Defining/Defining-Top:
  (P, H) |- (s, P.TOP) => (NOCLASS)

;; @rule Defining-Here
rule Defining/Defining-Here:
  (P, H) |- (s, C) => (CLASSFOUND C)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = METHODFOUND f

;; @rule Defining-Super
rule Defining/Defining-Super:
  (P, H) |- (s, C) => (cr)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = NOMETHOD
  -- Defining: (P, H) |- (s, $superclass(H, C)) => (cr)

;; @rule Pub-Top
rule Public/Pub-Top:
  (P, H) |- (s, P.TOP) => (ABSENT)

;; @rule Pub-Hit
rule Public/Pub-Hit:
  (P, H) |- (s, C) => (FOUND f C)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = METHODFOUND f
  -- if f.ACCESS = PUBLIC

;; @rule Pub-Protected-Barrier
rule Public/Pub-Protected-Barrier:
  (P, H) |- (s, C) => (ABSENT)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = METHODFOUND f
  -- if f.ACCESS = PROTECTED

;; Disjunction in Pub-Super is split into two Horn-shaped rules.
;; @rule Pub-Super
rule Public/Pub-Super-absent:
  (P, H) |- (s, C) => (r)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = NOMETHOD
  -- Public: (P, H) |- (s, $superclass(H, C)) => (r)

;; @rule Pub-Super
rule Public/Pub-Super-private:
  (P, H) |- (s, C) => (r)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = METHODFOUND f
  -- if f.ACCESS = PRIVATE
  -- Public: (P, H) |- (s, $superclass(H, C)) => (r)

;; @rule Prot-Top
rule Protected/Prot-Top:
  (P, H) |- (s, P.TOP) => (ABSENT)

;; @rule Prot-Hit
rule Protected/Prot-Hit-public:
  (P, H) |- (s, C) => (FOUND f C)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = METHODFOUND f
  -- if f.ACCESS = PUBLIC

;; @rule Prot-Hit
rule Protected/Prot-Hit-protected:
  (P, H) |- (s, C) => (FOUND f C)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = METHODFOUND f
  -- if f.ACCESS = PROTECTED

;; @rule Prot-Super
rule Protected/Prot-Super-absent:
  (P, H) |- (s, C) => (r)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = NOMETHOD
  -- Protected: (P, H) |- (s, $superclass(H, C)) => (r)

;; @rule Prot-Super
rule Protected/Prot-Super-private:
  (P, H) |- (s, C) => (r)
  -- if C =/= P.TOP
  -- if $direct(P, H, C, s) = METHODFOUND f
  -- if f.ACCESS = PRIVATE
  -- Protected: (P, H) |- (s, $superclass(H, C)) => (r)

;; @equation eq:class-chain
;; The graph of chain_H. Inductive derivability makes chains finite without
;; a fuel parameter; malformed cyclic heaps have no such derivation.
relation ClassChain: (lookupProgram, lookupHeap) |- (classid) => (classid*)
rule ClassChain/top:
  (P, H) |- (P.TOP) => (P.TOP)
rule ClassChain/step:
  (P, H) |- (C) => (C C'*)
  -- if C =/= P.TOP
  -- ClassChain: (P, H) |- ($superclass(H, C)) => (C'*)

def $incrementOptional(natoption) : natoption
def $incrementOptional(NOINDEX) = NOINDEX
def $incrementOptional(INDEXFOUND n) = INDEXFOUND $(n + 1)

def $firstClassIndex(classid*, classid) : natoption
def $firstClassIndex(eps, C) = NOINDEX
def $firstClassIndex(C_1 C'*, C) = INDEXFOUND 0 -- if C_1 = C
def $firstClassIndex(C_1 C'*, C) = $incrementOptional($firstClassIndex(C'*, C))
  -- if C_1 =/= C

;; @equation eq:class-membership-depth
relation ClassDepth: (lookupProgram, lookupHeap) |- (classid, classid) => (nat)
rule ClassDepth/index:
  (P, H) |- (C, C_0) => (n)
  -- ClassChain: (P, H) |- (C_0) => (C'*)
  -- if $firstClassIndex(C'*, C) = INDEXFOUND n

;; @equation eq:class-membership-depth
relation ClassMember: (lookupProgram, lookupHeap) |- (classid, classid)
rule ClassMember/member:
  (P, H) |- (C, C_0)
  -- ClassDepth: (P, H) |- (C, C_0) => (n)
