Newspeak3
'Eurasia'
class EurasiaSpawnProbe new = (
	(* A module for the actor checks in eurasia/scripts/genesis.sh (EURASIA_ACTORS_DESIGN_2026-11-17.md): the smoke test spawns its mixin into an actor of its own (vm spawn:), whose class has a nil enclosing object, so its code names nothing outside itself. *)
	
	|
		held ::= {7. }.
	|
) (
	public answer = (
		^42
	)
	public echo: x = (
		^x
	)
	public heldFirst = (
		^held at: 1
	)
	public sizeOf: x = (
		^x size
	)
) : ()
