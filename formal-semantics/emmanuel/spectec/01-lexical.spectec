;; Section 2: the lexing relation, the readers, runs, and tokens.

def $beginsWith(char*, char*) : bool
def $beginsWith(w*, eps) = true
def $beginsWith(eps, c w*) = false
def $beginsWith(c w*, c' w'*) = $beginsWith(w*, w'*)
  -- if c = c'
def $beginsWith(c w*, c' w'*) = false
  -- if c =/= c'

;; A reader result: the rest of the literal (closing delimiter included)
;; and the input after it, or UNCLOSED for the LaTeX's bottom.
syntax scan = SCANNED char* REST char* | UNCLOSED

def $prepend(char*, scan) : scan
def $prepend(u*, SCANNED u'* REST w*) = SCANNED u* u'* REST w*
def $prepend(u*, UNCLOSED) = UNCLOSED

;; @equation eq:string-reader
def $lit(char*) : scan
def $lit("'" "'" w*) = $prepend("'" "'", $lit(w*))
def $lit("'" w*) = SCANNED "'" REST w*
  -- if $beginsWith(w*, "'") = false
def $lit(c w*) = $prepend(c, $lit(w*))
  -- if c =/= "'"
def $lit(eps) = UNCLOSED

;; @equation eq:comment-reader
def $com(nat, char*) : scan
def $com(1, "*" ")" w*) = SCANNED "*" ")" REST w*
def $com(d, "*" ")" w*) = $prepend("*" ")", $com($(d - 1), w*))
  -- if d > 1
def $com(d, "(" "*" w*) = $prepend("(" "*", $com($(d + 1), w*))
def $com(d, c w*) = $prepend(c, $com(d, w*))
  -- if $beginsWith(c w*, "(" "*") = false
  -- if $beginsWith(c w*, "*" ")") = false
def $com(d, eps) = UNCLOSED

;; The lexing step <mu, w> ~~lambda~~> <mu', w'> of section 2.4.
relation LexStep: (modestack, char*) => (lexeme, modestack, char*)

;; @equation eq:lex-open-messages
;; @rule Lex-Open-Messages
rule LexStep/Lex-Open-Messages:
  (mu* TEXTMODE, $openSeq w*) => (OPENMESSAGES, mu* TEXTMODE CODEMODE, w*)

;; @equation eq:lex-close-markup
;; @rule Lex-Close-Markup
rule LexStep/Lex-Close-Markup:
  (mu* CODEMODE TEXTMODE, $closeSeq w*) => (CLOSEMARKUP, mu* CODEMODE, w*)

;; @equation eq:lex-escape-backslash
;; @rule Lex-Escape-Backslash
rule LexStep/Lex-Escape-Backslash:
  (mu* TEXTMODE, $backslashEscape w*) => (CHAR "\\", mu* TEXTMODE, w*)

;; @equation eq:lex-escape-bracket
;; @rule Lex-Escape-Bracket
rule LexStep/Lex-Escape-Bracket:
  (mu* TEXTMODE, $bracketEscape w*) => (CHAR "[", mu* TEXTMODE, w*)

;; @equation eq:lex-text-char
;; @rule Lex-Text-Char
rule LexStep/Lex-Text-Char:
  (mu* TEXTMODE, c w*) => (CHAR c, mu* TEXTMODE, w*)
  -- if $beginsWith(c w*, $openSeq) = false
  -- if $beginsWith(c w*, $closeSeq) = false
  -- if $beginsWith(c w*, $backslashEscape) = false
  -- if $beginsWith(c w*, $bracketEscape) = false

;; @equation eq:lex-open-markup
;; @rule Lex-Open-Markup
rule LexStep/Lex-Open-Markup:
  (mu* CODEMODE, $openSeq w*) => (OPENMARKUP, mu* CODEMODE TEXTMODE, w*)

;; @equation eq:lex-close-messages
;; @rule Lex-Close-Messages
rule LexStep/Lex-Close-Messages:
  (mu* TEXTMODE CODEMODE, $closeSeq w*) => (CLOSEMESSAGES, mu* TEXTMODE, w*)

;; @equation eq:lex-code-string
;; @rule Lex-Code-String
rule LexStep/Lex-Code-String:
  (mu* CODEMODE, "'" w*) => (CODE ("'" u*), mu* CODEMODE, w'*)
  -- if $lit(w*) = SCANNED u* REST w'*

;; @equation eq:lex-code-comment
;; @rule Lex-Code-Comment
rule LexStep/Lex-Code-Comment:
  (mu* CODEMODE, "(" "*" w*) => (CODE ("(" "*" u*), mu* CODEMODE, w'*)
  -- if $com(1, w*) = SCANNED u* REST w'*

;; @equation eq:lex-code-char
;; @rule Lex-Code-Char
rule LexStep/Lex-Code-Char:
  (mu* CODEMODE, c w*) => (CODE c, mu* CODEMODE, w*)
  -- if c =/= "'"
  -- if $beginsWith(c w*, $openSeq) = false
  -- if $beginsWith(c w*, $closeSeq) = false
  -- if $beginsWith(c w*, "(" "*") = false

;; The run judgment <mu, i, w> || r of section 2.6. The LaTeX's two
;; consumption-length side conditions are the same `j` equation.
relation LexRun: (modestack, nat, char*) => (lexresult)

;; @equation eq:run-end
;; @rule Run-End
rule LexRun/Run-End:
  (TEXTMODE, i, eps) => (LEXED eps)

;; @equation eq:run-step
;; @rule Run-Step
rule LexRun/Run-Step:
  (mu*, i, w*) => (LEXED (LOC lambda (SPAN i j)) l*)
  -- LexStep: (mu*, w*) => (lambda, mu'*, w'*)
  -- if j = $(i + |w*| - |w'*|)
  -- LexRun: (mu'*, j, w'*) => (LEXED l*)

;; @equation eq:run-step-error
;; @rule Run-Step-Error
rule LexRun/Run-Step-Error:
  (mu*, i, w*) => (LEXERROR e i')
  -- LexStep: (mu*, w*) => (lambda, mu'*, w'*)
  -- if j = $(i + |w*| - |w'*|)
  -- LexRun: (mu'*, j, w'*) => (LEXERROR e i')

;; @equation eq:run-stray-close
;; @rule Run-Stray-Close
rule LexRun/Run-Stray-Close:
  (TEXTMODE, i, $closeSeq w*) => (LEXERROR STRAYCLOSE i)

;; @equation eq:run-unclosed-string
;; @rule Run-Unclosed-String
rule LexRun/Run-Unclosed-String:
  (mu* CODEMODE, i, "'" w*) => (LEXERROR UNCLOSEDLITERAL i)
  -- if $lit(w*) = UNCLOSED

;; @equation eq:run-unclosed-comment
;; @rule Run-Unclosed-Comment
rule LexRun/Run-Unclosed-Comment:
  (mu* CODEMODE, i, "(" "*" w*) => (LEXERROR UNCLOSEDLITERAL i)
  -- if $com(1, w*) = UNCLOSED

;; @equation eq:run-unclosed-bracket
;; @rule Run-Unclosed-Bracket
rule LexRun/Run-Unclosed-Bracket:
  (mu*, i, eps) => (LEXERROR UNCLOSEDBRACKET i)
  -- if mu* =/= TEXTMODE

;; @equation eq:lex-source
relation Lexes: (char*) => (lexresult)
rule Lexes/source:
  (w*) => (r)
  -- LexRun: (TEXTMODE, 0, w*) => (r)

;; Coalescing lexemes into tokens.
syntax tokenclass = TEXTCLASS | CODECLASS | BRACKETCLASS

def $tokenClass(token) : tokenclass
def $tokenClass(TEXT u*) = TEXTCLASS
def $tokenClass(CODE w*) = CODECLASS
def $tokenClass(OPENMESSAGES) = BRACKETCLASS
def $tokenClass(CLOSEMESSAGES) = BRACKETCLASS
def $tokenClass(OPENMARKUP) = BRACKETCLASS
def $tokenClass(CLOSEMARKUP) = BRACKETCLASS

def $mergeable(spantoken, spantoken) : bool
def $mergeable(TOK tau (SPAN i j), TOK tau' (SPAN i' j')) =
  $tokenClass(tau) = $tokenClass(tau') /\ $tokenClass(tau) =/= BRACKETCLASS

;; @equation eq:coalesce
def $tok(located) : spantoken
def $tok(LOC (CHAR c) (SPAN i j)) = TOK (TEXT c) (SPAN i j)
def $tok(LOC (CODE w*) (SPAN i j)) = TOK (CODE w*) (SPAN i j)
def $tok(LOC OPENMESSAGES (SPAN i j)) = TOK OPENMESSAGES (SPAN i j)
def $tok(LOC CLOSEMESSAGES (SPAN i j)) = TOK CLOSEMESSAGES (SPAN i j)
def $tok(LOC OPENMARKUP (SPAN i j)) = TOK OPENMARKUP (SPAN i j)
def $tok(LOC CLOSEMARKUP (SPAN i j)) = TOK CLOSEMARKUP (SPAN i j)

;; @equation eq:coalesce
def $merge(spantoken*) : spantoken*
def $merge(eps) = eps
def $merge(t) = t
def $merge((TOK (TEXT u*) (SPAN i j)) (TOK (TEXT u'*) (SPAN j' k)) t'*) =
  $merge((TOK (TEXT u* u'*) (SPAN i k)) t'*)
  -- if j = j'
def $merge((TOK (CODE w*) (SPAN i j)) (TOK (CODE w'*) (SPAN j' k)) t'*) =
  $merge((TOK (CODE w* w'*) (SPAN i k)) t'*)
  -- if j = j'
def $merge(t_1 t_2 t'*) = t_1 $merge(t_2 t'*)
  -- if $mergeable(t_1, t_2) = false

;; @equation eq:coalesce
def $tokens(located*) : spantoken*
def $tokens(l*) = $merge($tok(l)*)
