;; Section 13: the optional VM kernel layer (kernel-semantics.tex).
;; This module transcribes native methods. Their catalog is a parameter: the
;; relation NativeTransform has no rules here. A concrete VM supplies them; the
;; regressions supply a three-entry test catalog in tests/kernel-fixtures.spectec.
;; Host calls, callbacks, restore and replay labels need the actor layer, which
;; is not transcribed yet.

syntax nativeid = NID nat
var nu : nativeid

;; @equation eq:native-body
syntax statement/kernel = ... | NATIVESTMT nativeid

syntax resource = MEMORYRESOURCE | STACKRESOURCE | NESTINGRESOURCE | HANDLERESOURCE
syntax failurereason =
  | WRONGKIND nat | OUTOFRANGE nat | ZERODIVIDE | ARITY | NOTINSTANTIABLE
  | DEAD | EXHAUSTED resource | HOSTFAILURE objref | UNSUPPORTED
var reason : failurereason

;; The runtimeError(nativeFailure(...)) control term of Native-Fail. Like
;; CONSTRUCTIONERROR, it waits for the exception-library boundary, which is
;; not transcribed yet.
syntax control/kernel = ... | NATIVEFAILURE nativeid objref objref* failurereason

;; @equation eq:native-outcome
syntax nativeoutcome =
  | NATIVEANSWER runtimeHeap objref
  | NATIVETAILSEND runtimeHeap objref message
  | NATIVEFAIL failurereason

relation NativeTransform: (runtimeProgram, runtimeHeap) |- (nativeid, objref, objref*) => (nativeoutcome)

;; @equation eq:native-invoke-restriction
;; A body is native exactly when its first statement is a native statement.
;; The base Invoke rules require NONATIVE, so a native method never allocates
;; an activation and exactly one family of rules applies to each method.
syntax nativeoption = NATIVEFOUND nativeid | NONATIVE
def $nativeOf(statement*) : nativeoption
def $nativeOf(eps) = NONATIVE
def $nativeOf((EXPRSTMT e) st*) = NONATIVE
def $nativeOf((RETURNSTMT e) st*) = NONATIVE
def $nativeOf((NATIVESTMT nu) st*) = NATIVEFOUND nu

;; @rule Native-Answer
rule MachineStep/Native-Answer:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CALLMETHOD mf o C (s o_arg*) }) =>
           ({ HEAP RH', STACK AS (a, pi), CONTROL VALUE o' })
  -- if $nativeOf(mf.BODY) = NATIVEFOUND nu
  -- if $methodMessageCompatible(mf, s o_arg*)
  -- NativeTransform: (RP, RH) |- (nu, o, o_arg*) => (NATIVEANSWER RH' o')
;; @rule Native-Tail
rule MachineStep/Native-Tail:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CALLMETHOD mf o C (s o_arg*) }) =>
           ({ HEAP RH', STACK AS (a, pi), CONTROL DISPATCH (ORDINARYREQUEST o') mu })
  -- if $nativeOf(mf.BODY) = NATIVEFOUND nu
  -- if $methodMessageCompatible(mf, s o_arg*)
  -- NativeTransform: (RP, RH) |- (nu, o, o_arg*) => (NATIVETAILSEND RH' o' mu)
;; @rule Native-Fail
rule MachineStep/Native-Fail:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CALLMETHOD mf o C (s o_arg*) }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL NATIVEFAILURE nu o o_arg* reason })
  -- if $nativeOf(mf.BODY) = NATIVEFOUND nu
  -- if $methodMessageCompatible(mf, s o_arg*)
  -- NativeTransform: (RP, RH) |- (nu, o, o_arg*) => (NATIVEFAIL reason)
