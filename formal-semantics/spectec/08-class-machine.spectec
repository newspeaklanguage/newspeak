;; Class expressions do not evaluate deferred initializer arguments.
;; @equation eq:class-forms
;; @rule Class-Super
rule MachineStep/Class-Super:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CLASSBODY bodyd e }) =>
           ({ HEAP RH, STACK AS (a, pi (MAKEBODYFRAME bodyd $classEnclosingObject(RP, RH, a, bodyd.DECL))), CONTROL e })
;; @rule Class-Commit
rule MachineStep/Class-Commit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MAKEBODYFRAME bodyd o)), CONTROL VALUE (CLASSREF C_s) }) =>
           ({ HEAP RH', STACK AS (a, pi), CONTROL VALUE (CLASSREF C) })
  -- if $inheritanceError(RH, CLASSREF C_s, bodyd.SUPERMESSAGE) = NOINHERITANCEERROR
  -- if o =/= $nilValue(RP) \/ (bodyd.SUPERKIND = IMPLICITSUPERCLASS /\ C_s = $platformClass(RP, "Object"))
  -- if $initializerAt(RP, bodyd.MIXIN).SELECTOR = bodyd.SELECTOR
  -- if $initializerAt(RP, bodyd.MIXIN).FORMALS = bodyd.FORMALS
  -- if $runtimeLive(RH', CLASSREF C)
  -- if C_m = $runtimeClassAt(RH', C).METACLASS
  -- if C =/= C_m
  -- if ~$runtimeLive(RH, CLASSREF C) /\ ~$runtimeLive(RH, CLASSREF C_m)
  -- if $publicFactoryPresent(RP, bodyd.CLASSMIXIN, $bodyFactory(RP, bodyd))
  -- if RH' = $allocateClass(RP, RH, C, C_m, EXPRESSIONORIGIN bodyd.DECL,
    bodyd.MIXIN, C_s, o, bodyd.CLASSMIXIN, $bodyFactory(RP, bodyd))
;; @equation eq:inheritance-error-step
rule MachineStep/inheritance-error:
  (RP) |- ({ HEAP RH, STACK AS (a, pi CF), CONTROL VALUE o }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL CONSTRUCTIONERROR ierr })
  -- if $inheritanceError(RH, o, $constructionTemplate(CF)) = INHERITANCEERROR ierr
;; @equation eq:top-superclass-error
rule MachineStep/top-superclass-error:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MAKEBODYFRAME bodyd o)), CONTROL VALUE (CLASSREF C_s) }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL CONSTRUCTIONERROR TOPSUPERCLASS })
  -- if $inheritanceError(RH, CLASSREF C_s, bodyd.SUPERMESSAGE) = NOINHERITANCEERROR
  -- if o = $nilValue(RP)
  -- if bodyd.SUPERKIND =/= IMPLICITSUPERCLASS \/ C_s =/= $platformClass(RP, "Object")
;; @equation eq:mixin-start
rule MachineStep/mixin-start:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL MIXINAPPLY appd e_S e_M }) =>
           ({ HEAP RH, STACK AS (a, pi (MIXLEFTFRAME appd e_M)), CONTROL e_S })
;; @equation eq:mixin-right
rule MachineStep/mixin-right:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MIXLEFTFRAME appd e)), CONTROL VALUE (CLASSREF C_s) }) =>
           ({ HEAP RH, STACK AS (a, pi (MIXRIGHTFRAME appd C_s)), CONTROL e })
  -- if $inheritanceError(RH, CLASSREF C_s, appd.SUPERMESSAGE) = NOINHERITANCEERROR
;; @rule Mixin-Commit
rule MachineStep/Mixin-Commit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MIXRIGHTFRAME appd C_s)), CONTROL VALUE (CLASSREF C_R) }) =>
           ({ HEAP RH', STACK AS (a, pi), CONTROL VALUE (CLASSREF C) })
  -- if $inheritanceError(RH, CLASSREF C_R, appd.MIXINMESSAGE) = NOINHERITANCEERROR
  -- if $factorySelector(RH, C_R) = appd.SELECTOR
  -- if $initializerAt(RP, $runtimeClassAt(RH, C_R).MIXIN).SELECTOR = appd.SELECTOR
  -- if $runtimeLive(RH', CLASSREF C)
  -- if C_m = $runtimeClassAt(RH', C).METACLASS
  -- if C =/= C_m
  -- if ~$runtimeLive(RH, CLASSREF C) /\ ~$runtimeLive(RH, CLASSREF C_m)
  -- if $publicFactoryPresent(RP, appd.CLASSMIXIN, $applicationFactory(appd))
  -- if RH' = $allocateClass(RP, RH, C, C_m, EXPRESSIONORIGIN appd.DECL,
    $runtimeClassAt(RH, C_R).MIXIN, C_s, $runtimeClassAt(RH, C_R).ENCLOSING,
    appd.CLASSMIXIN, $applicationFactory(appd))
;; The distinct primary-selector mismatch is stated immediately after Mixin-Commit.
;; @equation eq:inheritance-error-step
rule MachineStep/mixin-primary-selector-error:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MIXRIGHTFRAME appd C_s)), CONTROL VALUE (CLASSREF C_R) }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL CONSTRUCTIONERROR WRONGFACTORY })
  -- if $inheritanceError(RH, CLASSREF C_R, appd.MIXINMESSAGE) = NOINHERITANCEERROR
  -- if $factorySelector(RH, C_R) =/= appd.SELECTOR

;; @equation eq:message-evaluation
rule MachineStep/message-empty:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL MESSAGECONTROL (TEMPLATE s eps) }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL MESSAGEVALUE (s eps) })
;; @equation eq:message-evaluation
rule MachineStep/message-first:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL MESSAGECONTROL (TEMPLATE s (e e'*)) }) =>
           ({ HEAP RH, STACK AS (a, pi (MSGARGSFRAME s eps e'*)), CONTROL e })
;; @equation eq:message-evaluation
rule MachineStep/message-next:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MSGARGSFRAME s o* (e e'*))), CONTROL VALUE o' }) =>
           ({ HEAP RH, STACK AS (a, pi (MSGARGSFRAME s (o* o') e'*)), CONTROL e })
;; @equation eq:message-evaluation
rule MachineStep/message-last:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MSGARGSFRAME s o* eps)), CONTROL VALUE o' }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL MESSAGEVALUE (s (o* o')) })

;; NEWINSTANCECURRENT's binding occurrences are core sends produced by elaboration,
;; not direct parameter-map reads. Evaluate them with the ordinary message protocol.
;; @partial eq:primary-factory-body
rule MachineStep/factory-message-start:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL NEWINSTANCECURRENT s e* }) =>
           ({ HEAP RH, STACK AS (a, pi NEWINSTANCEFRAME), CONTROL MESSAGECONTROL (TEMPLATE s e*) })
rule MachineStep/factory-message-ready:
  (RP) |- ({ HEAP RH, STACK AS (a, pi NEWINSTANCEFRAME), CONTROL MESSAGEVALUE mu }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL NEWINSTANCECONTROL mu })
;; @rule Factory-New
rule MachineStep/Factory-New:
  (RP) |- ({ HEAP RH, STACK AS (a, pi RETURNFRAME), CONTROL NEWINSTANCECONTROL mu }) =>
           ({ HEAP RH', STACK AS (a, pi RETURNFRAME) (a_I, eps), CONTROL INITCLASS C oid mu })
  -- if $runtimeActivationAt(RH, a).RECEIVER = CLASSREF C
  -- if $factoryMessageCompatible(RH, C, mu)
  -- if ~$runtimeLive(RH, OBJECTREF oid) /\ ~$runtimeLive(RH, ACTIVATIONREF a_I)
  -- if RH' = $newInstanceInitializer($allocateInstance(RP, RH, oid, C), a_I, C, oid, mu, CONT a)

;; @equation eq:init-frames
;; @equation eq:init-class
rule MachineStep/init-class-root:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITCLASS C oid mu }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL OWNINIT C oid mu })
  -- if $runtimeClassAt(RH, C).SUPER = $platformClass(RP, "Top")
;; @equation eq:init-class
rule MachineStep/init-class-super:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITCLASS C oid mu }) =>
           ({ HEAP RH, STACK AS (a, pi (SUPERMSGFRAME C oid mu)),
              CONTROL MESSAGECONTROL $superTemplate($factoryValue($runtimeClassAt(RH, C).FACTORY).PLAN) })
  -- if $runtimeClassAt(RH, C).SUPER =/= $platformClass(RP, "Top")
;; @rule Init-Super
rule MachineStep/Init-Super:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (SUPERMSGFRAME C oid mu)), CONTROL MESSAGEVALUE mu_S }) =>
           ({ HEAP RH', STACK AS (a, pi (AFTERSUPERFRAME C oid mu)) (a_S, eps), CONTROL INITCLASS C_S oid mu_S })
  -- if C_S = $runtimeClassAt(RH, C).SUPER
  -- if $factoryMessageCompatible(RH, C_S, mu_S)
  -- if ~$runtimeLive(RH, ACTIVATIONREF a_S)
  -- if RH' = $newInstanceInitializer(RH, a_S, C_S, oid, mu_S, CONT a)
rule MachineStep/init-super-wrong-factory:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (SUPERMSGFRAME C oid mu)), CONTROL MESSAGEVALUE mu_S }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL CONSTRUCTIONERROR WRONGFACTORY })
  -- if ~$factoryMessageCompatible(RH, $runtimeClassAt(RH, C).SUPER, mu_S)
;; @equation eq:after-super
rule MachineStep/after-super:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (AFTERSUPERFRAME C oid mu)), CONTROL VALUE (OBJECTREF oid) }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL OWNINIT C oid mu })
;; @equation eq:body-own-init
rule MachineStep/body-own-init:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL OWNINIT C oid mu }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL t })
  -- if fd = $factoryValue($runtimeClassAt(RH, C).FACTORY)
  -- if fd.PLAN = BODYINITIALIZER messagetemplate
  -- if ii = $initializerAt(RP, $runtimeClassAt(RH, C).MIXIN)
  -- if (fd.ID, fd.SELECTOR, fd.FORMALS) = (ii.ID, ii.SELECTOR, ii.FORMALS)
  -- if t = INITGROUPS oid ii.GROUPS ii.BODY
;; @equation eq:applied-own-init
rule MachineStep/applied-own-init:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL OWNINIT C oid mu }) =>
           ({ HEAP RH, STACK AS (a, pi (MIXINMSGFRAME C oid)), CONTROL MESSAGECONTROL messagetemplate_M })
  -- if $factoryValue($runtimeClassAt(RH, C).FACTORY).PLAN = APPLIEDINITIALIZER messagetemplate_S messagetemplate_M
;; @rule Init-Applied-Mixin
rule MachineStep/Init-Applied-Mixin:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MIXINMSGFRAME C oid)), CONTROL MESSAGEVALUE mu_M }) =>
           ({ HEAP RH', STACK AS (a, pi (AFTERMIXINFRAME C oid)) (a_M, eps), CONTROL t })
  -- if M = $runtimeClassAt(RH, C).MIXIN
  -- if ii = $initializerAt(RP, M)
  -- if $initializerMessageCompatible(ii, mu_M)
  -- if ~$runtimeLive(RH, ACTIVATIONREF a_M)
  -- if RH' = $newMixinInitializer(RP, RH, a_M, M, C, oid, mu_M, CONT a)
  -- if t = INITGROUPS oid ii.GROUPS ii.BODY
rule MachineStep/init-mixin-wrong-factory:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (MIXINMSGFRAME C oid)), CONTROL MESSAGEVALUE mu_M }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL CONSTRUCTIONERROR WRONGFACTORY })
  -- if ~$initializerMessageCompatible($initializerAt(RP, $runtimeClassAt(RH, C).MIXIN), mu_M)
;; @equation eq:after-mixin
rule MachineStep/after-mixin:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (AFTERMIXINFRAME C oid)), CONTROL VALUE (OBJECTREF oid) }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL FINISH (OBJECTREF oid) })

;; @equation eq:slot-frames
;; @equation eq:slot-operations
rule MachineStep/slot-read:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL READSLOT oid pslot }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL VALUE $readObjectSlot(RH, oid, pslot) })
;; @equation eq:slot-operations
rule MachineStep/slot-write-start:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL WRITESLOT oid pslot e }) =>
           ({ HEAP RH, STACK AS (a, pi (SLOTWRITEFRAME oid pslot)), CONTROL e })
;; @equation eq:slot-operations
rule MachineStep/slot-write-commit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (SLOTWRITEFRAME oid pslot)), CONTROL VALUE o }) =>
           ({ HEAP $writeObjectSlot(RH, oid, pslot, o), STACK AS (a, pi), CONTROL VALUE o })
;; @equation eq:init-groups-empty
rule MachineStep/init-groups-empty:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITGROUPS oid eps st* }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL BODYCONTROL (METHODBODY (OBJECTREF oid)) st* })
;; @equation eq:init-group-sequential
rule MachineStep/init-group-sequential:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITGROUPS oid ((SLOTSEQUENTIAL sd*) sg*) st* }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL INITSEQUENTIAL oid sd* sg* st* })
;; @equation eq:init-sequential
rule MachineStep/init-sequential-uninitialized:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITSEQUENTIAL oid ((SLOTUNINITIALIZED slot) sd*) sg* st* }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL INITSEQUENTIAL oid sd* sg* st* })
;; @equation eq:init-sequential
rule MachineStep/init-sequential-start:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITSEQUENTIAL oid (sd sd'*) sg* st* }) =>
           ({ HEAP RH, STACK AS (a, pi (SLOTSTOREFRAME oid (PHYSICALSLOT $currentApplication(RH, a) $slotIdentity(sd)) sd'* sg* st*)), CONTROL e })
  -- if ~$uninitializedSlot(sd)
  -- if e = $eagerSlotExpression(sd)
;; @equation eq:init-sequential
rule MachineStep/init-sequential-commit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (SLOTSTOREFRAME oid pslot sd* sg* st*)), CONTROL VALUE o }) =>
           ({ HEAP $writeObjectSlot(RH, oid, pslot, o), STACK AS (a, pi), CONTROL INITSEQUENTIAL oid sd* sg* st* })
;; @equation eq:init-sequential
rule MachineStep/init-sequential-empty:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITSEQUENTIAL oid eps sg* st* }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL INITGROUPS oid sg* st* })
;; @equation eq:init-group-simultaneous
rule MachineStep/init-group-simultaneous:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITGROUPS oid ((SLOTSIMULTANEOUS sd*) sg*) st* }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL INTERNALSEQUENCE $expandedSlotGroup(RP, RH, a, oid, sd*) (INITGROUPS oid sg* st*) })
;; @equation eq:local-simultaneous-start
rule MachineStep/local-simultaneous-start:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INITIALIZE a ((LOCALSIMULTANEOUS ld*) lg*) st* tau }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL INTERNALSEQUENCE $simultaneousLocalCode(RP, RH, a, ld*) (INITIALIZE a lg* st* tau) })
;; @equation eq:internal-sequence
rule MachineStep/internal-empty:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INTERNALSEQUENCE eps t }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL t })
;; @equation eq:internal-sequence
rule MachineStep/internal-first:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL INTERNALSEQUENCE (e e'*) t }) =>
           ({ HEAP RH, STACK AS (a, pi (INTERNALFRAME e'* t)), CONTROL e })
;; @equation eq:internal-sequence
rule MachineStep/internal-next:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (INTERNALFRAME e* t)), CONTROL VALUE o }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL INTERNALSEQUENCE e* t })

;; @equation eq:current-slot-operations
rule MachineStep/current-read:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CURRENTREAD slot }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL READSLOT oid (PHYSICALSLOT $currentApplication(RH, a) slot) })
  -- if $runtimeActivationAt(RH, a).RECEIVER = OBJECTREF oid
;; @equation eq:current-slot-operations
rule MachineStep/current-write:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CURRENTWRITE slot e }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL WRITESLOT oid (PHYSICALSLOT $currentApplication(RH, a) slot) e })
  -- if $runtimeActivationAt(RH, a).RECEIVER = OBJECTREF oid
;; @equation eq:lazy-read
rule MachineStep/lazy-read-hit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL LAZYREAD slot e }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL VALUE o })
  -- if $runtimeActivationAt(RH, a).RECEIVER = OBJECTREF oid
  -- if $readObjectSlot(RH, oid, (PHYSICALSLOT $currentApplication(RH, a) slot)) = o /\ o =/= $nilValue(RP)
;; @equation eq:lazy-read
rule MachineStep/lazy-read-start:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL LAZYREAD slot e }) =>
           ({ HEAP RH, STACK AS (a, pi (LAZYSTOREFRAME oid (PHYSICALSLOT $currentApplication(RH, a) slot))), CONTROL e })
  -- if $runtimeActivationAt(RH, a).RECEIVER = OBJECTREF oid
  -- if $readObjectSlot(RH, oid, (PHYSICALSLOT $currentApplication(RH, a) slot)) = $nilValue(RP)
;; @equation eq:lazy-read
rule MachineStep/lazy-read-commit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (LAZYSTOREFRAME oid pslot)), CONTROL VALUE o }) =>
           ({ HEAP $writeObjectSlot(RH, oid, pslot, o), STACK AS (a, pi), CONTROL VALUE o })

;; @equation eq:nested-class-cache
rule MachineStep/nested-cache-hit:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL NESTEDCLASS D e }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL VALUE (CLASSREF C) })
  -- if $runtimeActivationAt(RH, a).RECEIVER = OBJECTREF oid
  -- if $nestedCacheEntry(RH, oid, (NESTEDCACHE $currentApplication(RH, a) D)) = C
;; @equation eq:nested-class-cache
rule MachineStep/nested-cache-miss:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL NESTEDCLASS D e }) =>
           ({ HEAP RH, STACK AS (a, pi (NESTEDSTOREFRAME oid (NESTEDCACHE $currentApplication(RH, a) D))), CONTROL CLASSWITHEO e (OBJECTREF oid) })
  -- if $runtimeActivationAt(RH, a).RECEIVER = OBJECTREF oid
  -- if $nestedCacheEntry(RH, oid, (NESTEDCACHE $currentApplication(RH, a) D)) = eps
;; @equation eq:nested-class-cache
rule MachineStep/nested-cache-store:
  (RP) |- ({ HEAP RH, STACK AS (a, pi (NESTEDSTOREFRAME oid ncache)), CONTROL VALUE (CLASSREF C) }) =>
           ({ HEAP $cacheNestedClass(RH, oid, ncache, C), STACK AS (a, pi), CONTROL VALUE (CLASSREF C) })
;; @equation eq:class-with-enclosing-object
rule MachineStep/class-with-eo-body:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CLASSWITHEO (CLASSBODY bodyd e) o }) =>
           ({ HEAP RH, STACK AS (a, pi (MAKEBODYFRAME bodyd o)), CONTROL e })
;; @equation eq:class-with-enclosing-object
rule MachineStep/class-with-eo-application:
  (RP) |- ({ HEAP RH, STACK AS (a, pi), CONTROL CLASSWITHEO (MIXINAPPLY appd e_S e_M) o }) =>
           ({ HEAP RH, STACK AS (a, pi), CONTROL MIXINAPPLY appd e_S e_M })
