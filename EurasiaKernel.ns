		public + x <def X> ^<Y> where { Y :: returnType of (addFromInteger: message of (arg 1)) } = (
			^x addFromInteger: self
		)
		public - x <def X> ^<Y> where { Y :: returnType of (subtractFromInteger: message of (arg 1)) } = (
