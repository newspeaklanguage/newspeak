;; Section 6. Missing records a DNU request; it does not allocate its mirror.
;; Section 6.5's allocation-bearing DNU transition is in 05-machine-support.

relation OrdinaryDispatch: (lookupProgram, lookupHeap) |- (objref, message) => (dispatchresult)
relation OuterDispatch: (lookupProgram, lookupHeap, actid) |- (classdecl, classdecl, message) => (dispatchresult)
relation SelfDispatch: (lookupProgram, lookupHeap, actid) |- (classdecl, message) => (dispatchresult)
relation SuperDispatch: (lookupProgram, lookupHeap, actid) |- (message) => (dispatchresult)
;; @equation eq:implicit-judgment
relation ImplicitDispatch: (lookupProgram, lookupHeap, actid, classdecl) |- (scopeoption, message) => (dispatchresult)

;; @rule Send-Public
rule OrdinaryDispatch/Send-Public:
  (P, H) |- (o, (s o'*)) => (INVOKE f o C (s o'*))
  -- Public: (P, H) |- (s, $classOf(H, o)) => (FOUND f C)

;; @rule Send-Missing
rule OrdinaryDispatch/Send-Missing:
  (P, H) |- (o, mu) => (MISSING o $classOf(H, o) mu)
  -- if mu = s o'*
  -- Public: (P, H) |- (s, $classOf(H, o)) => (ABSENT)

;; @rule Outer-Private
rule OuterDispatch/Outer-Private:
  (P, H, a) |- (D_t, D_0, (s o'*)) => (INVOKE f o_t C_t (s o'*))
  -- LexicalDepth: (P) |- (D_t, D_0) => (n)
  -- Enclosing: (P, H) |- ($activationAt(H, a).RECEIVER, $activationAt(H, a).CURRENT, n) => (o_t)
  -- TargetApplication: (P, H) |- (o_t, D_t) => (CLASSFOUND C_t)
  -- if $privateMethod(P, D_t, s) = METHODFOUND f

;; @rule Outer-Protected
rule OuterDispatch/Outer-Protected:
  (P, H, a) |- (D_t, D_0, (s o'*)) => (INVOKE f o_t C_f (s o'*))
  -- LexicalDepth: (P) |- (D_t, D_0) => (n)
  -- Enclosing: (P, H) |- ($activationAt(H, a).RECEIVER, $activationAt(H, a).CURRENT, n) => (o_t)
  -- if $privateMethod(P, D_t, s) = NOMETHOD
  -- Protected: (P, H) |- (s, $classOf(H, o_t)) => (FOUND f C_f)

;; @rule Outer-Missing
rule OuterDispatch/Outer-Missing:
  (P, H, a) |- (D_t, D_0, (s o'*)) => (MISSING o_t $classOf(H, o_t) (s o'*))
  -- LexicalDepth: (P) |- (D_t, D_0) => (n)
  -- Enclosing: (P, H) |- ($activationAt(H, a).RECEIVER, $activationAt(H, a).CURRENT, n) => (o_t)
  -- if $privateMethod(P, D_t, s) = NOMETHOD
  -- Protected: (P, H) |- (s, $classOf(H, o_t)) => (ABSENT)

;; @equation eq:self-send-derived
rule SelfDispatch/derived:
  (P, H, a) |- (D_0, mu) => (dr)
  -- OuterDispatch: (P, H, a) |- (D_0, D_0, mu) => (dr)

;; The receiver remains the current instance; lookup starts at the current
;; class's SUPER, and so does DNU if lookup fails.
;; @rule Super-Hit
rule SuperDispatch/Super-Hit:
  (P, H, a) |- ((s o'*)) => (INVOKE f $activationAt(H, a).RECEIVER C_f (s o'*))
  -- if $activationAt(H, a).CURRENT = C
  -- if C =/= P.OBJECT /\ C =/= P.TOP
  -- Protected: (P, H) |- (s, $superclass(H, C)) => (FOUND f C_f)

;; @rule Super-Missing
rule SuperDispatch/Super-Missing:
  (P, H, a) |- ((s o'*)) => (MISSING $activationAt(H, a).RECEIVER C_s (s o'*))
  -- if $activationAt(H, a).CURRENT = C
  -- if C =/= P.OBJECT /\ C =/= P.TOP
  -- if C_s = $superclass(H, C)
  -- Protected: (P, H) |- (s, C_s) => (ABSENT)

;; @rule Super-Object-Error
rule SuperDispatch/Super-Object-Error:
  (P, H, a) |- (mu) => (INVALIDSUPER P.OBJECT)
  -- if $activationAt(H, a).CURRENT = P.OBJECT

;; @rule Super-Top-Error
rule SuperDispatch/Super-Top-Error:
  (P, H, a) |- (mu) => (INVALIDSUPER P.TOP)
  -- if $activationAt(H, a).CURRENT = P.TOP

;; @rule Implicit-Class
rule ImplicitDispatch/Implicit-Class:
  (P, H, a, D_0) |- (SCOPEFOUND D_t, mu) => (dr)
  -- OuterDispatch: (P, H, a) |- (D_t, D_0, mu) => (dr)

;; @rule Implicit-Literal
rule ImplicitDispatch/Implicit-Literal:
  (P, H, a, D_0) |- (SCOPEFOUND L, (s o'*)) => (INVOKE f o_L C_f (s o'*))
  -- if $mapGet(scopedecl, objref, $activationAt(H, a).SCOPES, L) = o_L
  -- Unrestricted: (P, H) |- (s, $classOf(H, o_L)) => (FOUND f C_f)
  -- if $declaration(P, H, C_f) = L

;; @rule Implicit-Activation
rule ImplicitDispatch/Implicit-Activation:
  (P, H, a, D_0) |- (SCOPEFOUND q, mu) => (dr)
  -- if $mapGet(scopedecl, objref, $activationAt(H, a).SCOPES, q) = (ACTIVATIONREF a_q)
  -- OrdinaryDispatch: (P, H) |- ((ACTIVATIONREF a_q), mu) => (dr)

;; @rule Implicit-Self
rule ImplicitDispatch/Implicit-Self:
  (P, H, a, D_0) |- (NOSCOPE, mu) => (dr)
  -- OuterDispatch: (P, H, a) |- (D_0, D_0, mu) => (dr)
