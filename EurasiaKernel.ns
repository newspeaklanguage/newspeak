		public headerForAccessModifier: am primitive: prim numArgs: numArgs = (
			| ami |
			#public = am ifTrue: [ ami:: 0 ].
			#protected = am ifTrue: [ ami:: 1 ].
			#private = am ifTrue: [ ami:: 2 ].
			^ami << 28 | (prim << 16) | numArgs
