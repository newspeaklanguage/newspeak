;; A fixture block signature and host evaluator for the Section 4
;; regressions. Hand-written and non-normative: a toy instance in the shape
;; of the standard library, small enough to read in full.

var y : text

def $cls(STATE "doc" v*) = FLOW
def $cls(STATE "section" v*) = FLOW
def $cls(STATE "para" v*) = PARA
def $cls(STATE "emph" v*) = INLINE
def $cls(STATE "inline" v*) = INLINE
def $cls(STATE "newline" v*) = INLINE

;; Which block classes understand which selectors.
syntax fixpair = PAIR text text
def $understood : fixpair*
def $understood =
  (PAIR "doc" "paragraph") (PAIR "doc" "section:") (PAIR "doc" "title:")
  (PAIR "section" "paragraph") (PAIR "section" "section:") (PAIR "section" "endSection")
  (PAIR "para" "emphasis") (PAIR "para" "newline") (PAIR "para" "endParagraph") (PAIR "para" "boom")
  (PAIR "para" "refuseMe") (PAIR "para" "endBad") (PAIR "doc" "endBad")
  (PAIR "emph" "emphasis") (PAIR "emph" "newline") (PAIR "emph" "endEmphasis")
  (PAIR "inline" "emphasis") (PAIR "inline" "newline")

def $understands(blockstate, text) : bool
def $understands(STATE y v*, x) = (PAIR y x) <- $understood

def $isEnd(text) : bool
def $isEnd(x) = x = "endSection" \/ x = "endParagraph" \/ x = "endEmphasis"

rule Effect/fx-paragraph:
  (chi, kappa, "paragraph", eps) => (EFF chi (PUSH (STATE "para" eps)))
  -- if $understands(kappa, "paragraph")

rule Effect/fx-section:
  (chi, kappa, "section:", v) => (EFF chi (PUSH (STATE "section" v)))
  -- if $understands(kappa, "section:")

rule Effect/fx-emphasis:
  (chi, kappa, "emphasis", eps) => (EFF chi (PUSH (STATE "emph" eps)))
  -- if $understands(kappa, "emphasis")

rule Effect/fx-newline:
  (chi, kappa, "newline", eps) => (EFF chi (LEAF (STATE "newline" eps)))
  -- if $understands(kappa, "newline")

rule Effect/fx-end:
  (chi, kappa, x, eps) => (EFF chi POP)
  -- if $understands(kappa, x)
  -- if $isEnd(x)

;; title: interprets its literal with an inline root and stores the tree.
rule Effect/fx-title:
  (chi, STATE "doc" v*, "title:", LITV L) => (EFF chi' (MUTATE (STATE "doc" (TREEV L tr))))
  -- InterpretWith: (chi, L, STATE "inline" eps) => (DONE chi' tr)

rule Effect/fx-boom:
  (chi, kappa, "boom", eps) => (EXNS chi (EXCEPTION 7))
  -- if $understands(kappa, "boom")

rule Effect/fx-refuse:
  (chi, kappa, "refuseMe", eps) => (EFF chi REFUSE)
  -- if $understands(kappa, "refuseMe")

rule Effect/fx-pop-reject:
  (chi, kappa, "endBad", eps) => (EFF chi POPREJECT)
  -- if $understands(kappa, "endBad")

rule Effect/fx-dnu:
  (chi, kappa, x, v*) => (EFF chi NOTUNDERSTOOD)
  -- if ~$understands(kappa, x)

;; Test helper: parse a source and interpret it with the top-level block.
relation Doc: (hoststate, char*) => (interpresult)
rule Doc:
  (chi, w*) => (psi)
  -- Parses: ("doc", w*) => (PARSED (n*))
  -- Interp: (chi, STATE "doc" eps, n*) => (psi)

;; Test helper for Section 5: interpret, print, reinterpret the printed
;; source from the same host state, and report the printed source, whether
;; the two trees and host states agree up to canonical form, and whether
;; printing the second tree reproduces the printed source.
relation RoundTrip: (hoststate, char*) => (char*, bool, bool)
rule RoundTrip:
  (chi, w*) => (w'*, $canon(tr) = $canon(tr') /\ chi'' = chi', $print(w'*, tr') = w'*)
  -- Doc: (chi, w*) => (DONE chi' tr)
  -- if w'* = $print(w*, tr)
  -- Doc: (chi, w'*) => (DONE chi'' tr')
