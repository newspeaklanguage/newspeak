Newspeak3
'Emmanuel'
class EmmanuelIncremental usingPlatform: p emmanuel: em = (
	(* The incremental pipeline of Emmanuel (the prototype plan's milestone
M4): it recomputes after an edit only what the edit damaged, and reuses the
rest. Each stage answers what the reference (Emmanuel.ns) would, which the
tests check it against.

Parsing. Between two top-level nodes the lexer is in the text mode, so the
nodes an edit touches can be lexed, parsed and resolved again on their own:
from the start of the first node the damage touches to the end of the last.
The region grows while it ends in text that would join the next node, or
does not lex or parse into whole nodes. The nodes before it are kept as
they are; those after it, whose source is unchanged but has moved, are
copied with their spans moved. When the region cannot be parsed alone,
reparse: answers nil, and the caller parses the whole source. *)
	
	|
		private emmanuel = em.
	|
) (
	commonPrefix: w with: w2 = (
		| n = w size min: w2 size. k ::= 0. |
		[ k < n and: [ (w at: k + 1) = (w2 at: k + 1) ] ] whileTrue: [ k:: k + 1 ].
		^k
	)
	commonSuffix: w with: w2 limit: limit = (
		| k ::= 0. |
		[ k < limit and: [ (w at: w size - k) = (w2 at: w2 size - k) ] ] whileTrue: [
				k:: k + 1
			].
		^k
	)
	public reparse: nodes old: w new: w2 name: y host: host = (
		(* The nodes of the source w2, given the nodes of w, from which an edit
made it; nil when only parsing the whole of w2 will do (it does not parse,
for instance). *)
		
		| p = commonPrefix: w with: w2. q = commonSuffix: w
			with: w2
			limit: (w size min: w2 size) - p. d = w2 size - w size. damageEnd = w size - q. i j start end toks markup raws resolved |
		nodes isEmpty ifTrue: [ ^nil ].
		i:: (1 to: nodes size) detect: [:k | (nodes at: k) span end >= p ]
			ifNone: [ nodes size ].
		j:: i.
		[ j < nodes size and: [ (nodes at: j + 1) span start <= damageEnd ] ] whileTrue: [
				j:: j + 1
			].
		[
			start:: (nodes at: i) span start.
			end:: (nodes at: j) span end + d.
			toks:: end < start ifTrue: [ nil ]
				ifFalse: [ emmanuel fastTokens: w2 from: start + 1 to: end ].
			markup:: toks isNil ifFalse: [ emmanuel parseMarkup: toks from: 1 ].
			raws:: (markup isNil not and: [ (markup at: 2) = (toks size + 1) ]) ifTrue: [
					markup at: 1
				].
			(raws isNil not and: [
					raws isEmpty or: [ raws last isRawFinal not or: [ j = nodes size ] ]
				]) ifTrue: [
					resolved:: emmanuel resolve: y nodes: raws host: host.
					resolved isKindOfFailure ifTrue: [ ^nil ].
					^(nodes copyFrom: 1 to: i - 1) , resolved , ((nodes copyFrom: j + 1
						to: nodes size) collect: [:n | emmanuel shifted: n by: d ])
				].
			j = nodes size ifTrue: [ ^nil ].
			j:: j + 1
		] repeat
	)
) : ()
