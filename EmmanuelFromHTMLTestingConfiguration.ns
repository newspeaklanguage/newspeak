Newspeak3
'Emmanuel'
class EmmanuelFromHTMLTestingConfiguration packageTestsUsing: manifest = (
	(* Tests of the HTML converter, EmmanuelFromHTML. From tool/:
  ./run-tests.sh EmmanuelFromHTMLTestingConfiguration ../Emmanuel.ns ../EmmanuelNewspeakHost.ns ../EmmanuelBlocks.ns ../AmpleforthView.ns ../EmmanuelFromHTML.ns ../EmmanuelFromHTMLTesting.ns ../NewspeakASTs.ns ../../primordialsoup/newspeak/NewspeakPredictiveParsing.ns

The tests run headless, where the platform has no GUI. The converter and
the view are built
on a stub platform with the real collections and kernel; its Hopscotch and
JavaScript are stubs, which the tests never use, since they look at trees
and never render them. *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelBlocks = manifest EmmanuelBlocks.
		private EmmanuelNewspeakHost = manifest EmmanuelNewspeakHost.
		private EmmanuelFromHTML = manifest EmmanuelFromHTML.
		private EmmanuelFromHTMLTesting = manifest EmmanuelFromHTMLTesting.
		private AmpleforthView = manifest AmpleforthView.
		private NewspeakASTs = manifest NewspeakASTs.
		private NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
	|
) (
	class Stub new = (
		(* Answers itself to every message. *)
		
	) (
		public doesNotUnderstand: message = (
			^self
		)
	) : ()
	class StubPlatform realPlatform: real = (
		(* The real collections and kernel; anything else is a Stub. *)
		
		|
			private realPlatform = real.
			private stub = Stub new.
		|
	) (
		public collections = (
			^realPlatform collections
		)
		public doesNotUnderstand: message = (
			^stub
		)
		public kernel = (
			^realPlatform kernel
		)
	) : ()
	public testModulesUsingPlatform: p minitest: m = (
		| stub = StubPlatform realPlatform: p. |
		^{EmmanuelFromHTMLTesting usingPlatform: p
			minitest: m
			converter: (EmmanuelFromHTML usingPlatform: stub
				emmanuel: (Emmanuel usingPlatform: p))
			view: (AmpleforthView usingPlatform: stub
				emmanuel: Emmanuel
				newspeakHost: EmmanuelNewspeakHost
				blocks: EmmanuelBlocks
				parsing: NewspeakPredictiveParsing
				asts: NewspeakASTs). }
	)
) : ()
