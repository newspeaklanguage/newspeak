Newspeak3
'Emmanuel'
class EmmanuelSyncTesting usingPlatform: p minitest: m editor: ed = (
	(* Headless tests of what the live editor's Session does for the views of
an Emmanuel document, with the Newspeak host and the block library: the sync
between the raw view and the live view (issue #114), the point of the view
that shows an offset of the source and the offset of the source of a point
of the view; alignment, the source with the blocks at a selection
aligned; sections, opened and ended at the caret; and the edit layer's
styles with a value, as the size menu applies them. *)
	
	|
		private TestContext = m TestContext.
		private editor = ed.
	|
) (
	public class AlignTests new = TestContext new (
	) (
		align: a in: source at: x = (
			^align: a in: source from: x to: x
		)
		align: a in: source from: x to: y = (
			(* The source after aligning to a the blocks from the first x to the
first y of source, which must interpret afterwards; nil when there is
nothing there to align. *)
			
			| s = session: source. r = s align: a
				from: (s pointAtSourceOffset: (offsetOf: x in: source))
				to: (s pointAtSourceOffset: (offsetOf: y in: source)). out |
			r isNil ifTrue: [ ^nil ].
			out:: String fromRunes: (r at: 1).
			deny: (session: out) failed.
			^out
		)
		offsetOf: x in: source = (
			^(source indexOf: x) - 1
		)
		session: source = (
			^editor Session source: source evaluator: nil
		)
		public test_aHeadingIsNotAligned = (
			assert: (align: 'center'
					in: '[\section: [\Heading\]. paragraph\]Body[\endParagraph. endSection\]'
					at: 'ead') isNil
		)
		public test_alignedBlocksAreRealigned = (
			assert: (align: 'right'
					in: '[\align: ''center''. paragraph\]Hi[\endParagraph. endAlign\]'
					at: 'Hi')
				equals: '[\align: ''right''. paragraph\]Hi[\endParagraph. endAlign\]'
		)
		public test_caretStaysInItsText = (
			| source = '[\paragraph\]Hello[\endParagraph\]'. s = session: source. k = offsetOf: 'llo'
				in: source. r = s align: 'center'
				from: (s pointAtSourceOffset: k)
				to: (s pointAtSourceOffset: k). out = String fromRunes: (r at: 1). |
			assert: (r at: 2) equals: (offsetOf: 'llo' in: out)
		)
		public test_leftInsideAnAlignmentNests = (
			assert: (align: 'left'
					in: '[\align: ''center''. paragraph\]A[\endParagraph. paragraph\]B[\endParagraph. endAlign\]'
					at: 'B')
				equals: '[\align: ''center''. paragraph\]A[\endParagraph. align: ''left''. paragraph\]B[\endParagraph. endAlign. endAlign\]'
		)
		public test_leftRemovesAnAlignment = (
			assert: (align: 'left'
					in: '[\align: ''center''. paragraph\]Hi[\endParagraph. endAlign\]'
					at: 'Hi')
				equals: '[\paragraph\]Hi[\endParagraph\]'
		)
		public test_leftRemovesBracketsOfTheirOwn = (
			assert: (align: 'left'
					in: '[\align: ''center''\]
[\paragraph\]Hi[\endParagraph\]
[\endAlign\]'
					at: 'Hi')
				equals: '
[\paragraph\]Hi[\endParagraph\]
'
		)
		public test_leftWithNoAlignmentChangesNothing = (
			| source = '[\paragraph\]Hi[\endParagraph\]'. |
			assert: (align: 'left' in: source at: 'Hi') equals: source
		)
		public test_paragraphIsWrapped = (
			assert: (align: 'center' in: '[\paragraph\]Hello[\endParagraph\]' at: 'ell')
				equals: '[\align: ''center''. paragraph\]Hello[\endParagraph. endAlign\]'
		)
		public test_paragraphsInASectionAreWrappedTogether = (
			assert: (align: 'right'
					in: '[\section: [\S\]. paragraph\]A[\endParagraph. paragraph\]B[\endParagraph. endSection\]'
					from: 'A'
					to: 'B')
				equals: '[\section: [\S\]. align: ''right''. paragraph\]A[\endParagraph. paragraph\]B[\endParagraph. endAlign. endSection\]'
		)
	) : (
		TEST_CONTEXT = (
		)
	)
	public class SectionTests new = TestContext new (
	) (
		end: source at: x = (
			^run: [:s :pt | s endSectionAt: pt ] in: source at: x
		)
		offsetOf: x in: source = (
			^(source indexOf: x) - 1
		)
		open: source after: x = (
			(* A new section with the caret just after the first x of source. *)
			
			| s = session: source. r = s openSectionAt: (s pointAtSourceOffset: (offsetOf: x
						in: source) + x size). out |
			r isNil ifTrue: [ ^nil ].
			out:: String fromRunes: (r at: 1).
			deny: (session: out) failed.
			^{out. r at: 2. }
		)
		open: source at: x = (
			^run: [:s :pt | s openSectionAt: pt ] in: source at: x
		)
		run: op in: source at: x = (
			(* What op does at the first x of source: {the new source, which must
interpret. its offset}; nil when it does nothing. *)
			
			| s = session: source. r = op value: s
				value: (s pointAtSourceOffset: (offsetOf: x in: source)). out |
			r isNil ifTrue: [ ^nil ].
			out:: String fromRunes: (r at: 1).
			deny: (session: out) failed.
			^{out. r at: 2. }
		)
		session: source = (
			^editor Session source: source evaluator: nil
		)
		public test_endInHeadingMovesItAllOut = (
			assert: ((end: '[\section: [\A\]. paragraph\]x[\endParagraph. endSection\]'
					at: 'A') at: 1)
				equals: '[\section: [\A\]. endSection. paragraph\]x[\endParagraph\]'
		)
		public test_endMidSectionMovesTheRestUp = (
			| r = end: '[\section: [\A\]. paragraph\]x[\endParagraph. paragraph\]y[\endParagraph. endSection\]'
				at: 'x'. |
			assert: (r at: 1)
				equals: '[\section: [\A\]. paragraph\]x[\endParagraph. endSection. paragraph\]y[\endParagraph\]'.
			assert: (r at: 2) equals: (offsetOf: '\]y' in: (r at: 1))
		)
		public test_endOfASectionAddsAParagraphAfterIt = (
			| r = end: '[\section: [\A\]. paragraph\]x[\endParagraph. endSection\]'
				at: 'x'. s pt |
			assert: (r at: 1)
				equals: '[\section: [\A\]. paragraph\]x[\endParagraph. endSection. paragraph\][\endParagraph\]'.
			s:: session: (r at: 1).
			pt:: s pointAtSourceOffset: (r at: 2).
			assert: pt steps size equals: 1.
			assert: pt steps first index equals: 1
		)
		public test_endOutsideASectionDoesNothing = (
			assert: (end: '[\paragraph\]x[\endParagraph\]' at: 'x') isNil
		)
		public test_endPutsTheCaretInWhatMovedUp = (
			(* The caret goes to the text of what moved up a level: here, the
heading of a section that was a subsection. *)
			
			| r = end: '[\section: [\A\]. paragraph\]x[\endParagraph. section: [\B\]. paragraph\]y[\endParagraph. endSection. endSection\]'
				at: 'x'. s pt |
			s:: session: (r at: 1).
			pt:: s pointAtSourceOffset: (r at: 2).
			assert: (pt steps anySatisfy: [:st | st isField ]).
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'B\]' in: (r at: 1))
		)
		public test_endTwiceClimbsTwoLevels = (
			| inner = '[\section: [\A\]. section: [\B\]. paragraph\]x[\endParagraph. endSection. endSection\]'. once = end: inner
				at: 'x'. s twice |
			s:: session: (once at: 1).
			twice:: s endSectionAt: (s pointAtSourceOffset: (once at: 2)).
			assert: (String fromRunes: (twice at: 1))
				equals: '[\section: [\A\]. section: [\B\]. paragraph\]x[\endParagraph. endSection. paragraph\][\endParagraph. endSection. paragraph\][\endParagraph\]'
		)
		public test_openAfterTheCaretsParagraph = (
			| r = open: '[\section: [\A\]. paragraph\]wx[\endParagraph. paragraph\]y[\endParagraph. endSection\]'
				after: 'wx'. |
			assert: (r at: 1)
				equals: '[\section: [\A\]. paragraph\]wx[\endParagraph. section: [\Heading\]. paragraph\][\endParagraph. endSection. paragraph\]y[\endParagraph. endSection\]'.
			assert: (r at: 2) equals: (offsetOf: 'Heading' in: (r at: 1))
		)
		public test_openAtTheStartOfABlockGoesBeforeIt = (
			| r = open: '[\section: [\A\]. paragraph\]x[\endParagraph. paragraph\] yes[\endParagraph. endSection\]'
				at: 'yes'. |
			assert: (r at: 1)
				equals: '[\section: [\A\]. paragraph\]x[\endParagraph. section: [\Heading\]. paragraph\][\endParagraph. endSection. paragraph\] yes[\endParagraph. endSection\]'.
			assert: (r at: 2) equals: (offsetOf: 'Heading' in: (r at: 1))
		)
		public test_openInAHeadingStartsTheSection = (
			assert: ((open: '[\section: [\A\]. paragraph\]x[\endParagraph. endSection\]'
					at: 'A') at: 1)
				equals: '[\section: [\A\]. section: [\Heading\]. paragraph\][\endParagraph. endSection. paragraph\]x[\endParagraph. endSection\]'
		)
		public test_openInAnAlignmentGoesAfterIt = (
			(* An align: cannot hold a section: the new one follows the align:. *)
			
			assert: ((open: '[\align: ''center''. paragraph\]wx[\endParagraph. endAlign\]'
					after: 'wx') at: 1)
				equals: '[\align: ''center''. paragraph\]wx[\endParagraph. endAlign. section: [\Heading\]. paragraph\][\endParagraph. endSection\]'
		)
		public test_openInTheMiddleSplitsTheBlock = (
			| r = open: '[\section: [\A\]. paragraph\]one two[\endParagraph. endSection\]'
				at: 'two'. |
			assert: (r at: 1)
				equals: '[\section: [\A\]. paragraph\]one [\endParagraph. section: [\Heading\]. paragraph\][\endParagraph. endSection. paragraph\]two[\endParagraph. endSection\]'.
			assert: (r at: 2) equals: (offsetOf: 'Heading' in: (r at: 1))
		)
		public test_openIsDeeperThanItsSection = (
			| r = open: '[\section: [\A\]. paragraph\]x[\endParagraph. endSection\]'
				at: 'x'. s pt |
			s:: session: (r at: 1).
			pt:: s pointAtSourceOffset: (r at: 2).
			assert: (pt steps select: [:st | st isField not ]) size equals: 2
		)
	) : (
		TEST_CONTEXT = (
		)
	)
	public class StyleTests new = TestContext new (
		(* Styles with a value (size: #large), applied, removed, and replaced
by the edit layer's style edits, and unstyle; and the styles without one,
as before. *)
		
	) (
		edit: kind style: x in: source from: a to: b = (
			(* The source after the edit of kind (#style, #vstyle, or #unstyle)
with the style x on the range from the offset of the first a in source to
the end of the first b; it must interpret. *)
			
			| s = session: source. e = editor edits Edit kind: kind
				caret: (editor edits exact: (s pointAtSourceOffset: (offsetOf: a in: source)))
				caret: (editor edits exact: (s pointAtSourceOffset: (offsetOf: b in: source) + b size))
				items: nil
				after: nil
				level: nil
				style: x
				steps: nil
				index: nil
				chars: nil. |
			s apply: e.
			deny: s failed.
			^s sourceString
		)
		offsetOf: x in: source = (
			^(source indexOf: x) - 1
		)
		session: source = (
			^editor Session source: source evaluator: nil
		)
		size: step = (
			^(editor codeItem: 'size:' code: '#' , step) statement
		)
		public test_aDifferentSizeReplacesTheOld = (
			assert: (edit: #vstyle
					style: (size: 'small')
					in: '[\paragraph\]Hello [\size: #large\]world[\endSize. endParagraph\]'
					from: 'world'
					to: 'world')
				equals: '[\paragraph\]Hello [\size: #small\]world[\endSize\][\endParagraph\]'
		)
		public test_aSizeIsApplied = (
			assert: (edit: #vstyle
					style: (size: 'large')
					in: '[\paragraph\]Hello world[\endParagraph\]'
					from: 'world'
					to: 'world')
				equals: '[\paragraph\]Hello [\size: #large\]world[\endSize\][\endParagraph\]'
		)
		public test_partOfASizedRunTakesTheNewSize = (
			assert: (edit: #vstyle
					style: (size: 'small')
					in: '[\paragraph\]Hello [\size: #large\]world[\endSize. endParagraph\]'
					from: 'wor'
					to: 'wor')
				equals: '[\paragraph\]Hello [\size: #small\]wor[\endSize. size: #large\]ld[\endSize. endParagraph\]'
		)
		public test_theSameSizeAgainRemovesIt = (
			assert: (edit: #vstyle
					style: (size: 'large')
					in: '[\paragraph\]Hello [\size: #large\]world[\endSize. endParagraph\]'
					from: 'world'
					to: 'world')
				equals: '[\paragraph\]Hello world[\endParagraph\]'
		)
		public test_unaryStylesStillToggle = (
			| styled = edit: #style
				style: 'emphasis'
				in: '[\paragraph\]Hello world[\endParagraph\]'
				from: 'world'
				to: 'world'. |
			assert: styled
				equals: '[\paragraph\]Hello [\emphasis\]world[\endEmphasis\][\endParagraph\]'.
			assert: (edit: #style style: 'emphasis' in: styled from: 'world' to: 'world')
				equals: '[\paragraph\]Hello world[\endParagraph\]'
		)
		public test_unstyleOfPlainTextChangesNothing = (
			| source = '[\paragraph\]Hello world[\endParagraph\]'. |
			assert: (edit: #unstyle style: 'size:' in: source from: 'world' to: 'world')
				equals: source
		)
		public test_unstyleRemovesASizeWhateverItIs = (
			assert: (edit: #unstyle
					style: 'size:'
					in: '[\paragraph\]Hello [\size: #xLarge\]world[\endSize. endParagraph\]'
					from: 'world'
					to: 'world')
				equals: '[\paragraph\]Hello world[\endParagraph\]'
		)
	) : (
		TEST_CONTEXT = (
		)
	)
	public class SyncTests new = TestContext new (
	) (
		assertRoundTripsIn: source from: a to: b = (
			(* Each offset of source from a to b, which is text, goes to a point
that goes back to it. *)
			
			| s = session: source. |
			a to: b
				do: [:k | assert: (s sourceOffsetAt: (s pointAtSourceOffset: k)) equals: k ]
		)
		offsetOf: x in: source = (
			(* The offset, from 0, of the first occurrence of x in source; the
sources here are ASCII, so its code points are its bytes. *)
			
			^(source indexOf: x) - 1
		)
		session: source = (
			^editor Session source: source evaluator: nil
		)
		public test_bracketGoesToTheTextAfterIt = (
			(* An offset in a bracket, in no message that creates or closes a
block (a mutating one, here), is the start of the text after the bracket. *)
			
			| source = '[\section: [\Intro\]. label: #intro. paragraph\]Body[\endParagraph. endSection\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'intro.'
					in: source). |
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'Body' in: source)
		)
		public test_closingMessageGoesAfterItsBlock = (
			| source = '[\paragraph\]Body[\endParagraph. paragraph\]Next[\endParagraph\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'endParagraph'
					in: source) + 3. |
			assert: pt isGap.
			assert: pt child equals: 1.
			assert: pt steps isEmpty.
			assert: (s sourceOffsetAt: pt)
				equals: (offsetOf: 'paragraph\]Next' in: source)
		)
		public test_creatingMessageGoesBeforeItsBlock = (
			(* An offset in the message that creates a block is just before the
block, which goes back to the start of the message. *)
			
			| source = '[\section: [\Intro\]. paragraph\]Body[\endParagraph. endSection\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'paragraph'
					in: source) + 2. |
			assert: pt isGap.
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'paragraph' in: source)
		)
		public test_escapesCountAsOneCharacter = (
			(* An escape is two code points of the source and one character of
the view, so the offsets after it differ by one. *)
			
			| source = '[\paragraph\]a\\b c[\endParagraph\]'. s = session: source. after = offsetOf: 'c'
				in: source. pt = s pointAtSourceOffset: after. |
			assert: pt offset equals: 4.
			assert: (s sourceOffsetAt: pt) equals: after
		)
		public test_headingOffsetsAreInItsField = (
			(* An offset in a section's heading, a markup literal, is a point in
the heading's field, and goes back to the same offset. *)
			
			| source = '[\section: [\Intro\]. paragraph\]Body[\endParagraph. endSection\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'tro'
					in: source). |
			assert: (pt steps anySatisfy: [:st | st isField ]).
			assertRoundTripsIn: source
				from: (offsetOf: 'Intro' in: source) + 1
				to: (offsetOf: 'Intro' in: source) + 4
		)
		public test_leafInABracketOfItsOwn = (
			(* As NS101 has it: a leaf in a bracket of its own, after a newline;
the point before it is at its message, not at the newline. *)
			
			| source = '[\paragraph\]a[\endParagraph\]
[\html: ''<h2>big</h2>''\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'big'
					in: source). |
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'html:' in: source)
		)
		public test_leafStringGoesBeforeTheLeaf = (
			(* An offset in the string of an html: display, a leaf, is just
before the leaf. *)
			
			| source = '[\paragraph\]a[\endParagraph. html: ''<h2>big</h2>''\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'big'
					in: source). |
			assert: pt isGap.
			assert: pt child equals: 1.
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'html:' in: source)
		)
		public test_paragraphTextRoundTrips = (
			| source = '[\paragraph\]Hello world[\endParagraph\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'world'
					in: source). |
			assert: pt isGap not.
			assert: pt offset equals: 6.
			assertRoundTripsIn: source
				from: (offsetOf: 'Hello' in: source) + 1
				to: (offsetOf: 'world' in: source) + 4
		)
		public test_textOfUnclosedBlocksRoundTrips = (
			(* As the user's E_Manual ends: a paragraph and its section that the
source never closes; their text is still theirs. *)
			
			| source = '[\section: [\A\]. paragraph\][\endParagraph.  amplet: [3].  \][\paragraph\]Body text'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'text'
					in: source). |
			assert: pt isGap not.
			assert: pt steps size equals: 2.
			assertRoundTripsIn: source
				from: (offsetOf: 'Body' in: source) + 1
				to: (offsetOf: 'text' in: source) + 3
		)
		public test_uninterpretableSourceHasNoSync = (
			| s = session: '[\paragraph\]never closed [\'. |
			assert: (s pointAtSourceOffset: 3) isNil
		)
	) : (
		TEST_CONTEXT = (
		)
	)
) : ()
