;; Section 8: class/instance allocation, layouts, and initializer expansion.
var bodyd : bodydescriptor
var appd : applicationdescriptor
var fd : factorydescriptor
var ii : initializer
var sg : slotgroup
var sd : slotdecl
var origin : classorigin
var CF : constructionframe
syntax inheritanceerror = NOINHERITANCEERROR | INHERITANCEERROR constructionerror
var ierr : constructionerror

def $ownerAt(runtimeProgram, classbodydecl) : classowner
def $ownerAt(RP, K) = $require(classowner, $mapGet(classbodydecl, classowner, RP.OWNERS, K))
;; @equation eq:class-enclosing-object
def $classEnclosingObject(runtimeProgram, runtimeHeap, actid, classdecl) : objref
def $classEnclosingObject(RP, RH, a, D) = ACTIVATIONREF a
  -- if $ownerAt(RP, D) = ACTIVATIONOWNER
def $classEnclosingObject(RP, RH, a, D) = $runtimeActivationAt(RH, a).RECEIVER
  -- if $ownerAt(RP, D) = CLASSOWNER \/ $ownerAt(RP, D) = LITERALOWNER
def $classEnclosingObject(RP, RH, a, D) = $nilValue(RP)
  -- if $ownerAt(RP, D) = TOPOWNER

def $runtimeIsClass(runtimeHeap, objref) : bool
def $runtimeIsClass(RH, CLASSREF C) = $runtimeLive(RH, CLASSREF C)
def $runtimeIsClass(RH, OBJECTREF oid) = false
def $runtimeIsClass(RH, ACTIVATIONREF a) = false
def $runtimeIsClass(RH, CLOSUREREF c) = false
def $runtimeIsClass(RH, MIRRORREF g) = false
def $runtimeIsClass(RH, MIXINREF M) = false
def $runtimeIsClass(RH, ACTORREF actorid) = false
def $factoryValue(factoryoption) : factorydescriptor
def $factoryValue(FACTORY fd) = fd
def $hasFactory(runtimeHeap, classid) : bool
def $hasFactory(RH, C) = $runtimeClassAt(RH, C).FACTORY =/= NOFACTORY
;; @equation eq:factory-selector
def $factorySelector(runtimeHeap, classid) : selector
def $factorySelector(RH, C) = $factoryValue($runtimeClassAt(RH, C).FACTORY).SELECTOR
def $templateSelector(messagetemplate) : selector
def $templateSelector(TEMPLATE s e*) = s
;; @equation eq:inheritance-error
def $inheritanceError(runtimeHeap, objref, messagetemplate) : inheritanceerror
def $inheritanceError(RH, o, messagetemplate) = INHERITANCEERROR CLASSEXPECTED
  -- if ~$runtimeIsClass(RH, o)
def $inheritanceError(RH, CLASSREF C, messagetemplate) = INHERITANCEERROR CLASSNOTINSTANTIABLE
  -- if $runtimeIsClass(RH, CLASSREF C) /\ ~$hasFactory(RH, C)
def $inheritanceError(RH, CLASSREF C, messagetemplate) = INHERITANCEERROR WRONGFACTORY
  -- if $runtimeIsClass(RH, CLASSREF C) /\ $hasFactory(RH, C)
  -- if $templateSelector(messagetemplate) =/= $factorySelector(RH, C)
def $inheritanceError(RH, CLASSREF C, messagetemplate) = NOINHERITANCEERROR
  -- if $runtimeIsClass(RH, CLASSREF C) /\ $hasFactory(RH, C)
  -- if $templateSelector(messagetemplate) = $factorySelector(RH, C)

def $putClass(runtimeHeap, classid, classrecord) : runtimeHeap
def $putClass(RH, C, rc) = RH[.CLASSES = $mapPut(classid, classrecord, RH.CLASSES, C, rc)]
def $putObject(runtimeHeap, objectid, objectrecord) : runtimeHeap
def $putObject(RH, oid, ro) = RH[.OBJECTS = $mapPut(objectid, objectrecord, RH.OBJECTS, oid, ro)]
def $publicFactoryEntries(fullmethod*, factorydescriptor) : bool
def $publicFactoryEntries(eps, fd) = false
def $publicFactoryEntries(mf, fd) = mf.ACCESS = PUBLIC /\ mf.SELECTOR = fd.SELECTOR /\ mf.FORMALS = fd.FORMALS
def $publicFactoryPresent(runtimeProgram, mixinid, factorydescriptor) : bool
def $publicFactoryPresent(RP, M, fd) = $publicFactoryEntries(
  $mapGet(selector, fullmethod, $runtimeMixinAt(RP, M).METHODS, fd.SELECTOR), fd)
;; @equation eq:allocate-class
def $allocateClass(runtimeProgram, runtimeHeap, classid, classid, classorigin, mixinid, classid, objref, mixinid, factorydescriptor) : runtimeHeap
def $allocateClass(RP, RH, C, C_m, origin, M, C_s, o, M_c, fd) =
  $putClass($putClass(RH, C_m, {
    MIXIN M_c, SUPER $platformClass(RP, "Class"), ENCLOSING o,
    METACLASS $platformClass(RP, "Metaclass"), FACTORY NOFACTORY, ORIGIN origin
  }), C, {
    MIXIN M, SUPER C_s, ENCLOSING o, METACLASS C_m, FACTORY FACTORY fd, ORIGIN origin
  })
  -- if C =/= C_m
  -- if ~$runtimeLive(RH, CLASSREF C) /\ ~$runtimeLive(RH, CLASSREF C_m)
  -- if $runtimeIsClass(RH, CLASSREF C_s)
  -- if $publicFactoryPresent(RP, M_c, fd)
def $initializerAt(runtimeProgram, mixinid) : initializer
def $initializerAt(RP, M) = $runtimeMixinAt(RP, M).INITIALIZER
def $bodyFactory(runtimeProgram, bodydescriptor) : factorydescriptor
def $bodyFactory(RP, bodyd) = {
  ID $initializerAt(RP, bodyd.MIXIN).ID, SELECTOR bodyd.SELECTOR,
  FORMALS bodyd.FORMALS, PLAN BODYINITIALIZER bodyd.SUPERMESSAGE
}
def $applicationFactory(applicationdescriptor) : factorydescriptor
def $applicationFactory(appd) = {
  ID appd.INITIALIZERID, SELECTOR appd.SELECTOR, FORMALS appd.FORMALS,
  PLAN APPLIEDINITIALIZER appd.SUPERMESSAGE appd.MIXINMESSAGE
}
def $constructionTemplate(constructionframe) : messagetemplate
def $constructionTemplate(MAKEBODYFRAME bodyd o) = bodyd.SUPERMESSAGE
def $constructionTemplate(MIXLEFTFRAME appd e) = appd.SUPERMESSAGE
def $constructionTemplate(MIXRIGHTFRAME appd C) = appd.MIXINMESSAGE

;; @equation eq:own-slots
def $physicalIdentity(physicaldecl) : slotid
def $physicalIdentity(PHYSICALIMMUTABLE slot access e) = slot
def $physicalIdentity(PHYSICALMUTABLE slot access e) = slot
def $physicalIdentity(PHYSICALUNINITIALIZED slot access) = slot
def $physicalIdentity(PHYSICALLAZYIMMUTABLE slot access e) = slot
def $physicalIdentity(PHYSICALLAZYMUTABLE slot access e) = slot
;; @equation eq:own-slots
def $ownSlotIdentities(physicaldecl*) : slotid*
def $ownSlotIdentities(eps) = eps
def $ownSlotIdentities(physicaldecl physicaldecl'*) = $physicalIdentity(physicaldecl) $ownSlotIdentities(physicaldecl'*)
;; @equation eq:slot-layout
def $slotLayout(runtimeProgram, runtimeHeap, classid) : physicalslot*
def $slotLayout(RP, RH, C) = eps -- if C = $platformClass(RP, "Top")
def $slotLayout(RP, RH, C) =
  $slotLayout(RP, RH, $runtimeClassAt(RH, C).SUPER)
  $applicationSlots(C, $ownSlotIdentities($runtimeMixinAt(RP, $runtimeClassAt(RH, C).MIXIN).SLOTS))
  -- if C =/= $platformClass(RP, "Top")
def $applicationSlots(classid, slotid*) : physicalslot*
def $applicationSlots(C, slot*) = (PHYSICALSLOT C slot)*
def $nilSlots(runtimeProgram, physicalslot*) : (physicalslot, objref)*
def $nilSlots(RP, pslot*) = (pslot, $nilValue(RP))*
def $allocateInstance(runtimeProgram, runtimeHeap, objectid, classid) : runtimeHeap
def $allocateInstance(RP, RH, oid, C) = $putObject(RH, oid,
  { CLASS C, SLOTS $nilSlots(RP, $slotLayout(RP, RH, C)), NESTED eps })
  -- if ~$runtimeLive(RH, OBJECTREF oid)
def $factoryMessageCompatible(runtimeHeap, classid, message) : bool
def $factoryMessageCompatible(RH, C, (s o*)) =
  $factoryOptionMessageMatch($runtimeClassAt(RH, C).FACTORY, (s o*))
def $factoryOptionMessageMatch(factoryoption, message) : bool
def $factoryOptionMessageMatch(NOFACTORY, mu) = false
def $factoryOptionMessageMatch(FACTORY fd, mu) = $factoryParametersMatch(fd, mu)
def $factoryParametersMatch(factorydescriptor, message) : bool
def $factoryParametersMatch(fd, (s o*)) = s = fd.SELECTOR /\ |o*| = |fd.FORMALS|
;; @equation eq:instance-initializer-activation
def $newInstanceInitializer(runtimeHeap, actid, classid, objectid, message, continuation) : runtimeHeap
def $newInstanceInitializer(RH, a, C, oid, mu, kont) =
  $installInitializerActivation(RH, a, $factoryValue($runtimeClassAt(RH, C).FACTORY), C, oid, mu, kont)
  -- if ~$runtimeLive(RH, ACTIVATIONREF a)
  -- if $factoryMessageCompatible(RH, C, mu)
def $installInitializerActivation(runtimeHeap, actid, factorydescriptor, classid, objectid, message, continuation) : runtimeHeap
def $installInitializerActivation(RH, a, fd, C, oid, (s o*), kont) = $putActivation(RH, a, {
  PROVENANCE fd.ID, PARAMETERS $parameterBindings(fd.FORMALS, o*), LOCALS eps,
  RECEIVER OBJECTREF oid, CURRENT CLASSFOUND C, CONTINUATION kont, HOME CONT a,
  CONTINUABLE true, SCOPES (fd.ID, ACTIVATIONREF a)
})
def $superTemplate(factoryplan) : messagetemplate
def $superTemplate(BODYINITIALIZER messagetemplate) = messagetemplate
def $superTemplate(APPLIEDINITIALIZER messagetemplate messagetemplate') = messagetemplate
def $initializerMessageCompatible(initializer, message) : bool
def $initializerMessageCompatible(ii, (s o*)) = s = ii.SELECTOR /\ |o*| = |ii.FORMALS|
;; @equation eq:mixin-initializer-activation
def $newMixinInitializer(runtimeProgram, runtimeHeap, actid, mixinid, classid, objectid, message, continuation) : runtimeHeap
def $newMixinInitializer(RP, RH, a, M, C, oid, mu, kont) =
  $installMixinInitializer(RH, a, $initializerAt(RP, M), C, oid, mu, kont)
  -- if ~$runtimeLive(RH, ACTIVATIONREF a)
  -- if $initializerMessageCompatible($initializerAt(RP, M), mu)
def $installMixinInitializer(runtimeHeap, actid, initializer, classid, objectid, message, continuation) : runtimeHeap
def $installMixinInitializer(RH, a, ii, C, oid, (s o*), kont) = $putActivation(RH, a, {
  PROVENANCE ii.ID, PARAMETERS $parameterBindings(ii.FORMALS, o*), LOCALS eps,
  RECEIVER OBJECTREF oid, CURRENT CLASSFOUND C, CONTINUATION kont, HOME CONT a,
  CONTINUABLE true, SCOPES (ii.ID, ACTIVATIONREF a)
})

;; Direct writes never invoke overridable getters or setters.
def $readObjectSlot(runtimeHeap, objectid, physicalslot) : objref
def $readObjectSlot(RH, oid, pslot) = $require(objref,
  $mapGet(physicalslot, objref, $runtimeObjectAt(RH, oid).SLOTS, pslot))
def $writeObjectSlot(runtimeHeap, objectid, physicalslot, objref) : runtimeHeap
def $writeObjectSlot(RH, oid, pslot, o) = $putObject(RH, oid,
  $runtimeObjectAt(RH, oid)[.SLOTS = $mapPut(physicalslot, objref, $runtimeObjectAt(RH, oid).SLOTS, pslot, o)])
def $nestedCacheEntry(runtimeHeap, objectid, nestedcacheid) : classid*
def $nestedCacheEntry(RH, oid, ncache) = $mapGet(nestedcacheid, classid, $runtimeObjectAt(RH, oid).NESTED, ncache)
def $cacheNestedClass(runtimeHeap, objectid, nestedcacheid, classid) : runtimeHeap
def $cacheNestedClass(RH, oid, ncache, C) = $putObject(RH, oid,
  $runtimeObjectAt(RH, oid)[.NESTED = $mapPut(nestedcacheid, classid, $runtimeObjectAt(RH, oid).NESTED, ncache, C)])
def $currentApplication(runtimeHeap, actid) : classid
def $currentApplication(RH, a) = $classResultValue($runtimeActivationAt(RH, a).CURRENT)
def $slotIdentity(slotdecl) : slotid
def $slotIdentity(SLOTIMMUTABLE slot e q) = slot
def $slotIdentity(SLOTMUTABLE slot e q) = slot
def $slotIdentity(SLOTUNINITIALIZED slot) = slot
def $eagerSlotExpression(slotdecl) : coreexpr
def $eagerSlotExpression(SLOTIMMUTABLE slot e q) = e
def $eagerSlotExpression(SLOTMUTABLE slot e q) = e
def $uninitializedSlot(slotdecl) : bool
def $uninitializedSlot(SLOTUNINITIALIZED slot) = true
def $uninitializedSlot(SLOTIMMUTABLE slot e q) = false
def $uninitializedSlot(SLOTMUTABLE slot e q) = false

;; These are derived source annotations keyed by the *lexical* activation
;; declaration, not dynamic class lookup or a global PastFuture object.
def $activationDeclaration(runtimeHeap, actid) : actdecl
def $activationDeclaration(RH, a) = $provenanceDeclaration(RH, $runtimeActivationAt(RH, a).PROVENANCE)
def $provenanceDeclaration(runtimeHeap, provenance) : actdecl
def $provenanceDeclaration(RH, methodid) = methodid
def $provenanceDeclaration(RH, c) = $runtimeClosureAt(RH, c).DECL
def $provenanceDeclaration(RH, INITIALIZERPROVENANCE q) = q
def $futureExpression(runtimeProgram, runtimeHeap, actid) : coreexpr
def $futureExpression(RP, RH, a) = $require(coreexpr,
  $mapGet(actdecl, coreexpr, RP.FUTUREEXPRESSIONS, $activationDeclaration(RH, a)))
def $localThunkDeclaration(runtimeProgram, runtimeHeap, actid, localslotid) : actdecl
def $localThunkDeclaration(RP, RH, a, j) = $require(actdecl,
  $mapGet(localthunkkey, actdecl, RP.LOCALTHUNKS, LOCALTHUNKKEY $activationDeclaration(RH, a) j))
;; @equation eq:simultaneous-expansion
def $simultaneousSlotCode(coreexpr, objectid, classid, slotdecl*) : coreexpr*
def $simultaneousSlotCode(e_F, oid, C, sd*) = $slotInstallations(e_F, oid, C, sd*) $slotResolutions(oid, C, sd*)
def $hasEagerSlot(slotdecl*) : bool
def $hasEagerSlot(eps) = false
def $hasEagerSlot((SLOTUNINITIALIZED slot) sd*) = $hasEagerSlot(sd*)
def $hasEagerSlot((SLOTIMMUTABLE slot e q) sd*) = true
def $hasEagerSlot((SLOTMUTABLE slot e q) sd*) = true
def $expandedSlotGroup(runtimeProgram, runtimeHeap, actid, objectid, slotdecl*) : coreexpr*
def $expandedSlotGroup(RP, RH, a, oid, sd*) = eps -- if ~$hasEagerSlot(sd*)
def $expandedSlotGroup(RP, RH, a, oid, sd*) = $simultaneousSlotCode($futureExpression(RP, RH, a), oid, $currentApplication(RH, a), sd*)
  -- if $hasEagerSlot(sd*)
def $slotInstallations(coreexpr, objectid, classid, slotdecl*) : coreexpr*
def $slotInstallations(e_F, oid, C, eps) = eps
def $slotInstallations(e_F, oid, C, (SLOTUNINITIALIZED slot) sd*) = $slotInstallations(e_F, oid, C, sd*)
def $slotInstallations(e_F, oid, C, (SLOTIMMUTABLE slot e q) sd*) =
  (WRITESLOT oid (PHYSICALSLOT C slot) (SEND e_F "computing:" (CLOSURELITERAL q eps eps (EXPRSTMT e)))) $slotInstallations(e_F, oid, C, sd*)
def $slotInstallations(e_F, oid, C, (SLOTMUTABLE slot e q) sd*) =
  (WRITESLOT oid (PHYSICALSLOT C slot) (SEND e_F "computing:" (CLOSURELITERAL q eps eps (EXPRSTMT e)))) $slotInstallations(e_F, oid, C, sd*)
def $slotResolutions(objectid, classid, slotdecl*) : coreexpr*
def $slotResolutions(oid, C, eps) = eps
def $slotResolutions(oid, C, (SLOTUNINITIALIZED slot) sd*) = $slotResolutions(oid, C, sd*)
def $slotResolutions(oid, C, (SLOTIMMUTABLE slot e q) sd*) =
  (SEND (READSLOT oid (PHYSICALSLOT C slot)) "resolve" eps) $slotResolutions(oid, C, sd*)
def $slotResolutions(oid, C, (SLOTMUTABLE slot e q) sd*) =
  (SEND (READSLOT oid (PHYSICALSLOT C slot)) "resolve" eps) $slotResolutions(oid, C, sd*)
;; @equation eq:local-simultaneous-install
def $localInstallation(runtimeProgram, runtimeHeap, actid, localdecl) : coreexpr
def $localInstallation(RP, RH, a, ld) = WRITELOCAL a $localIdentity(ld) (VALUE $nilValue(RP))
  -- if $nilInitializedLocal(ld)
def $localInstallation(RP, RH, a, ld) = WRITELOCAL a $localIdentity(ld)
  (SEND $futureExpression(RP, RH, a) "computing:" (CLOSURELITERAL $localThunkDeclaration(RP, RH, a, $localIdentity(ld)) eps eps (EXPRSTMT $eagerLocalExpression(ld))))
  -- if ~$nilInitializedLocal(ld)
def $localInstallations(runtimeProgram, runtimeHeap, actid, localdecl*) : coreexpr*
def $localInstallations(RP, RH, a, eps) = eps
def $localInstallations(RP, RH, a, ld ld'*) =
  $localInstallation(RP, RH, a, ld) $localInstallations(RP, RH, a, ld'*)
def $localResolutions(actid, localdecl*) : coreexpr*
def $localResolutions(a, eps) = eps
def $localResolutions(a, ld ld'*) = $localResolutions(a, ld'*) -- if $nilInitializedLocal(ld)
def $localResolutions(a, ld ld'*) =
  (SEND (READLOCAL a $localIdentity(ld)) "resolve" eps) $localResolutions(a, ld'*)
  -- if ~$nilInitializedLocal(ld)
;; @equation eq:local-simultaneous-expansion
def $simultaneousLocalCode(runtimeProgram, runtimeHeap, actid, localdecl*) : coreexpr*
def $simultaneousLocalCode(RP, RH, a, ld*) =
  $localInstallations(RP, RH, a, ld*) $localResolutions(a, ld*)
