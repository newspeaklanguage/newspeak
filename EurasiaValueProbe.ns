Newspeak3
'Eurasia'
class EurasiaValueProbe new = Value new (
	(* A value module for the value checks in eurasia/scripts/genesis.sh (EURASIA_ACTORS_DESIGN_2026-11-17.md section 5). The module is a value class, so its instances are values and its nested classes may be value classes; each nested class exercises one rule of mixin application on Value. *)
	
) (
	public class Box new = (
		(* Not a value: a value class nested in one has a non-value enclosing object. *)
		
		|
			public contents
		|
	) (
		public class Inner new = Value new (
		) (
		) : ()
	) : ()
	public class Counter new = Value new (
		(* A mutable slot: not allowed in a value class. *)
		
		|
			public count ::= 0.
		|
	) (
	) : ()
	public class Holder new = Value new (
		(* A non-value slot value: refused as it is stored. *)
		
		|
			public contents = Array new: 1.
		|
	) (
	) : ()
	public class Point x: ax y: ay = Value new (
		|
			public x = ax.
			public y = ay.
		|
	) (
	) : ()
) : ()
