Newspeak3
'Eurasia'
class EurasiaBenchmarkApp usingPlatform: platform = (
	(* BenchmarkRunner's benchmarks on Eurasia, measured as BenchmarkRunner>>report does: a 500 ms warm-up, then the median of three 1000 ms windows, in runs per second. Arguments name the benchmarks to run (all when none). *)
	
	|
		Kernel
		PrimordialSoupCollections
		Actors
		Runtime
		ClosureDefFibonacci
		ClosureFibonacci
		DeltaBlue
		MethodFibonacci
		NLRImmediate
		NLRLoop
		ParserCombinators
		Richards
		SlotRead
		SlotWrite
		Splay
	|
) (
	public main: platform args: args = (
		| all |
		all:: {{'ClosureDefFibonacci'. ClosureDefFibonacci. }. {'ClosureFibonacci'. ClosureFibonacci. }. {'DeltaBlue'. DeltaBlue. }. {'MethodFibonacci'. MethodFibonacci. }. {'NLRImmediate'. NLRImmediate. }. {'NLRLoop'. NLRLoop. }. {'ParserCombinators'. ParserCombinators. }. {'Richards'. Richards. }. {'SlotRead'. SlotRead. }. {'SlotWrite'. SlotWrite. }. {'Splay'. Splay. }. }.
		all do: [:pair |
				(args isEmpty or: [ args includes: (pair at: 1) ]) ifTrue: [
						| b s1 s2 s3 lo hi |
						b:: (pair at: 2) usingPlatform: platform.
						measure: [ b bench ] forAtLeast: 500.
						s1:: measure: [ b bench ] forAtLeast: 1000.
						s2:: measure: [ b bench ] forAtLeast: 1000.
						s3:: measure: [ b bench ] forAtLeast: 1000.
						lo:: (s1 min: s2) min: s3.
						hi:: (s1 max: s2) max: s3.
						vm print: (pair at: 1) , ': ' , (s1 + s2 + s3 - lo - hi) printString
					]
			].
		vm print: 'done'
	)
	measure: block forAtLeast: milliseconds = (
		| runs stopwatch elapsed |
		runs:: 0.
		stopwatch:: Stopwatch new start.
		[
			block value.
			runs:: runs + 1.
			elapsed:: stopwatch elapsedMilliseconds.
			elapsed < milliseconds
		] whileTrue.
		^(runs * 10000 // elapsed) asFloat / 10
	)
	public platformOver: internalKernel = (
		^(Runtime kernel: Kernel collections: PrimordialSoupCollections actors: Actors) Platform internalKernel: internalKernel
	)
) : ()
