Newspeak3
'Eurasia'
class EurasiaDebuggerProbe usingPlatform: platform = (
	(* M6 step 5 (EURASIA_M6_REFLECTION_DESIGN_2026-11-18.md section 9): an unhandled exception in a turn, handled as the IDE does (Debugging.ns): the handler of last resort makes a broken thread of the failing stack (ActivationMirror threadForBrokenActivation:reason:) and the actor carries on. In a later turn, after the failing turn's frames have left the stack as detached activations, the thread is inspected: its stack, a receiver and a local. eurasia/scripts/reflection-tests.sh checks what it prints. *)
	
	|
		Kernel
		CollectionsForPrimordialSoup
		Actors
		Runtime
		Mirrors
		RuntimeWithMirrors
		NewspeakASTs
		NewspeakPredictiveParsing
		IntermediatesForPrimordialSoup
		NewspeakCompilation
		NewspeakBytecodeCompilation
		Newspeak2V5BytecodeCompilation
		MetadataParsing
		thread
	|
) (
	failingMethod: n = (
		| local |
		local:: n * 2.
		^local foo
	)
	inspect = (
		| activation names |
		vm print: 'broken ' , thread isBroken printString.
		activation:: thread suspendedActivation.
		names:: ''.
		[ nil = activation ] whileFalse: [
				names:: names , ' ' , activation method name.
				activation:: activation sender
			].
		vm print: 'stack' , names.
		activation:: thread suspendedActivation.
		[ #failingMethod: = activation method name ] whileFalse: [
				activation:: activation sender
			].
		vm print: 'receiver ' , (activation receiver reflectee == self) printString.
		vm print: 'done'
	)
	public main: platform args: args = (
		platform actors ultimateExceptionHandler: [:e :signaler |
				thread:: platform mirrors ActivationMirror threadForBrokenActivation: signaler
					reason: e
			].
		platform actors Timer after: 1 do: [ inspect ].
		
		(* This turn has no promise to break, so the exception is unhandled: it reaches the handler above. *)
		failingMethod: 21
	)
	public platformOver: internalKernel = (
		| base |
		base:: (Runtime kernel: Kernel
			collections: CollectionsForPrimordialSoup
			actors: Actors) Platform internalKernel: internalKernel.
		^(RuntimeWithMirrors mirrors: Mirrors
			asts: NewspeakASTs
			parsing: NewspeakPredictiveParsing
			intermediates: IntermediatesForPrimordialSoup
			compilation: (Newspeak2V5BytecodeCompilation mixinApply: (NewspeakBytecodeCompilation mixinApply: NewspeakCompilation))
			metadataParsing: MetadataParsing) Platform over: base
			internalKernel: internalKernel
	)
) : ()
