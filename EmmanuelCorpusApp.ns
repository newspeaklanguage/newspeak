Newspeak3
'Emmanuel'
class EmmanuelCorpusApp packageUsing: manifest = (
	(* Converts documents from HTML to Emmanuel in a browser, for the corpus
conversion of tool/emmanuel-corpus.py, which drives it in headless Chrome.

It defines a JavaScript function, emmanuelConvert(html): it converts the
document html with EmmanuelFromHTML, interprets the Emmanuel source with the
block library and the Newspeak host, and leaves a JSON report in the global
emmanuelResult: the source, the losses, whether the source interpreted and
how many errors its tree has, and the time each stage took, in milliseconds.

Build, from out/ (tool/emmanuel-corpus.py does it):

  $PRIMORDIALSOUP/out/ReleaseX64/primordialsoup $PRIMORDIALSOUP/out/snapshots/WebCompiler.vfuel \
    ./*.ns ../Emmanuel*.ns ./*.png RuntimeForHopscotchForHTML EmmanuelCorpusApp EmmanuelCorpus.vfuel *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelBlocks = manifest EmmanuelBlocks.
		private EmmanuelFromHTML = manifest EmmanuelFromHTML.
		private EmmanuelNewspeakHost = manifest EmmanuelNewspeakHost.
		private EmmanuelView = manifest EmmanuelView.
		private NewspeakASTs = manifest NewspeakASTs.
		private NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
	|
) (
	class Session usingPlatform: platform = (
		(* The converter, the view, and the browser's clock and JSON. *)
		
		|
			private emmanuel = Emmanuel usingPlatform: platform.
			private converter = EmmanuelFromHTML usingPlatform: platform
				emmanuel: emmanuel.
			private view = EmmanuelView usingPlatform: platform
				emmanuel: Emmanuel
				newspeakHost: EmmanuelNewspeakHost
				blocks: EmmanuelBlocks
				parsing: NewspeakPredictiveParsing
				asts: NewspeakASTs.
			private clock = platform js global at: #performance.
			private json = platform js global at: #JSON.
		|
	) (
		public convert: html = (
			(* The JSON report of the conversion of html. *)
			
			| t0 t1 t2 t3 root conversion done errors |
			^[
				t0:: clock now.
				root:: converter fromHTML: html.
				t1:: clock now.
				conversion:: converter convertDocument: root.
				t2:: clock now.
				done:: view treeOf: conversion source.
				t3:: clock now.
				errors:: done isKindOfDone ifTrue: [
						(view blocks libErrors: done tree) size
					]
					ifFalse: [ -1 ].
				'{"parse": ' , (t1 - t0) printString , ', "convert": ' , (t2 - t1) printString , ', "interpret": ' , (t3 - t2) printString , ', "done": ' , done isKindOfDone printString , ', "errors": ' , errors printString , ', "source": ' , (string: conversion source) , ', "losses": [' , (lossesJSON: conversion losses) , ']}'
			] on: Error
				do: [:e | '{"failure": ' , (string: e messageText printString) , '}' ]
		)
		lossesJSON: losses = (
			| out ::= ''. |
			losses keysAndValuesDo: [:i :l |
					i > 1 ifTrue: [ out:: out , ', ' ].
					out:: out , '[' , (string: l kind) , ', ' , (string: (l detail isNil ifTrue: [
								''
							]
							ifFalse: [ l detail ])) , ']'
				].
			^out
		)
		string: s = (
			(* s as a JSON string. *)
			
			^json stringify: s
		)
	) : ()
	public main: platform args: args = (
		| global = platform js global. session = Session usingPlatform: platform. |
		global at: #emmanuelConvert
			put: [:html |
				global at: #emmanuelResult put: (session convert: html).
				nil
			].
		(global at: #console) log: 'emmanuel-corpus-ready'
	)
) : ()
