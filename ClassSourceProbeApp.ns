Newspeak3
'NS2PrimordialSoup'
class ClassSourceProbeApp packageUsing: manifest = Object new (
	(* CLI probe: print a class the way the IDE SAVES it.

   Usage: ClassSourceProbeApp <file.ns>

   Not built by tool/build.sh -- it is a diagnostic, not part of the system.
   Build it from the primordialsoup directory with:

     ./out/ReleaseX64/primordialsoup ./out/snapshots/WebCompiler.vfuel \
       ./newspeak/*.ns $NEWSPEAK/ClassSourceProbeApp.ns \
       RuntimeWithMirrorsForPrimordialSoup ClassSourceProbeApp \
       ./out/snapshots/ClassSourceProbeApp.vfuel

   The IDE does not store files. It compiles a class, keeps each member's
   own source, and on save reassembles the file from those
   (MirrorsForPrimordialSoup writeClassDeclaration). This app drives that
   exact path -- compile the unit, ask the resulting declaration for its
   source -- so its output can be diffed against tool/pretty-print.sh's.
   The two agreeing is the whole point of canonical member order; this is
   how to check it without a browser. *)
	
) (
	decodeUtf8: bytes = (
		^String withAll: bytes
	)
	public main: platform args: args = (
		| sourceFile sourceText builder |
		args size < 1 ifTrue: [
				'Usage: ClassSourceProbeApp <file.ns>' out.
				^nil
			].
		sourceFile:: args at: 1.
		[ sourceText:: readFileAsString: sourceFile ] on: Error
			do: [:ex |
				'Could not read ' , sourceFile , ': ' , ex messageText out.
				^nil
			].
		[
			builder:: platform mirrors ClassDeclarationBuilder fromUnitSource: sourceText.
			builder source out
		] on: Error
			do: [:ex |
				'Class source error in ' , sourceFile , ': ' , ex messageText out.
				^nil
			]
	)
	readFileAsBytes: filename = (
		(* :literalmessage: primitive: 130 *)
		
		halt
	)
	readFileAsString: path = (
		^decodeUtf8: (readFileAsBytes: path)
	)
) : ()
