Newspeak3
'Root'
class HopscotchListPlanningTestingConfiguration packageTestsUsing: manifest = Object new (
	|
		private HopscotchListPlanningTesting = manifest HopscotchListPlanningTesting.
		private HopscotchForHTML5 = manifest HopscotchForHTML5.
	|
) (
	public testModulesUsingPlatform: p minitest: m = (
		^{HopscotchListPlanningTesting usingPlatform: p
			minitest: m
			hopscotchClass: HopscotchForHTML5. }
	)
) : ()
