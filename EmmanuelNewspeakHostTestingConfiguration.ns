Newspeak3
'Emmanuel'
class EmmanuelNewspeakHostTestingConfiguration packageTestsUsing: manifest = (
	(* From tool/:
  ./run-tests.sh EmmanuelNewspeakHostTestingConfiguration ../Emmanuel.ns ../NewspeakASTs.ns ../../primordialsoup/newspeak/NewspeakPredictiveParsing.ns *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelNewspeakHost = manifest EmmanuelNewspeakHost.
		private EmmanuelNewspeakHostTesting = manifest EmmanuelNewspeakHostTesting.
		private NewspeakASTs = manifest NewspeakASTs.
		private NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
	|
) (
	public testModulesUsingPlatform: p minitest: m = (
		| em = Emmanuel usingPlatform: p. parsing = NewspeakPredictiveParsing usingPlatform: p
			asts: (NewspeakASTs usingPlatform: p). |
		^{EmmanuelNewspeakHostTesting usingPlatform: p
			minitest: m
			emmanuel: em
			host: (EmmanuelNewspeakHost usingPlatform: p emmanuel: em parsing: parsing). }
	)
) : ()
