Newspeak3
'Emmanuel'
class EmmanuelFromHTMLTesting usingPlatform: p minitest: m converter: c view: v = (
	(* Tests of EmmanuelFromHTML. Each converts a tree of Elements and Texts,
checks the Emmanuel source it gives and what was lost, and checks that the
source interprets, with the Newspeak host and the block library, to a tree
without errors. *)
	
	|
		private TestContext = m TestContext.
		private converter = c.
		private view = v.
	|
) (
	public class ConversionTests new = TestContext new (
	) (
		a: href with: children = (
			^converter Element tag: 'a'
				attributes: {{'href'. href. }. }
				children: children
		)
		assertClean: source = (
			| done = view treeOf: source. |
			assert: done isKindOfDone.
			assert: (view blocks libErrors: done tree) isEmpty
		)
		check: nodes gives: expected = (
			^check: nodes gives: expected losing: {}
		)
		check: nodes gives: expected losing: kinds = (
			(* Convert nodes; the source must be expected, the kinds of the losses
kinds, and the source must interpret without errors. *)
			
			| conversion = converter convert: nodes. |
			assert: conversion source equals: expected.
			assert: (conversion losses collect: [:l | l kind ]) asArray printString
				equals: kinds printString.
			assertClean: conversion source.
			^conversion
		)
		e: tag = (
			^e: tag with: {}
		)
		e: tag attributes: as with: children = (
			^converter Element tag: tag attributes: as children: children
		)
		e: tag with: children = (
			^converter Element tag: tag attributes: {} children: children
		)
		lines: ls = (
			(* The lines ls, each ended by a newline. *)
			
			| out ::= ''. nl = String fromRunes: {10. }. |
			ls do: [:l | out:: out , l , nl ].
			^out
		)
		t: s = (
			^converter Text text: s
		)
		public test_ampletBecomesAnAmpletBlock = (
			| amplet = e: 'div'
				attributes: {{'class'. 'ampleforth'. }. {'name'. 'section: ''X'' titled: ''Y'''. }. {'ampletid'. '3'. }. }
				with: {}. |
			check: {amplet. }
				gives: (lines: {'[\amplet: [section: ''X'' titled: ''Y'']\]'. })
		)
		public test_ampletInACellIsInline = (
			| amplet = e: 'div'
				attributes: {{'class'. 'ampleforth'. }. {'name'. 'x'. }. }
				with: {}. |
			check: {e: 'table'
					with: {e: 'tr' with: {e: 'td' with: {amplet. t: ' edge'. }. }. }. }
				gives: (lines: {'[\table. row. cell. paragraph. amplet: [x]\] edge[\endParagraph. endCell. endRow. endTable\]'. })
		)
		public test_centeredBlocksAreAligned = (
			(* A center element, or a block whose style aligns its text, is an
align: container; one that shows nothing is not. *)
			
			check: {e: 'center' with: {e: 'i' with: {t: 'Teva'. }. }. e: 'center'
					with: {e: 'br'. }. e: 'div'
					attributes: {{'style'. 'color: red; text-align: right'. }. }
					with: {t: 'x'. }. }
				gives: (lines: {'[\align: ''center''. paragraph. emphasis\]Teva[\endEmphasis. endParagraph. endAlign\]'. '[\align: ''right''. paragraph\]x[\endParagraph. endAlign\]'. })
		)
		public test_centeredTitleIsALook = (
			(* A centered title: the conversion's looks center it. A centered
section heading cannot be: it is a loss. *)
			
			| c = check: {e: 'h1' with: {e: 'center' with: {t: 'Dinner'. }. }. e: 'h2'
					with: {e: 'center' with: {t: 'Credits'. }. }. }
				gives: (lines: {'[\title: [\Dinner\]\]'. '[\section: [\Credits\]\]'. }) , '[\endSection\]'
				losing: {'centered heading'. }. |
			assert: c looks printString
				equals: {{#title. 'text-align: center;'. }. } printString.
			assert: (converter convert: {e: 'h1' with: {t: 'Dinner'. }. }) looks isEmpty
		)
		public test_divInAHeadingIsALine = (
			check: {e: 'h2' with: {t: 'One'. e: 'div' with: {t: 'Two'. }. }. }
				gives: (lines: {'[\section: [\One[\newline\]Two\]\]'. }) , '[\endSection\]'
		)
		public test_divLinesAndBreaks = (
			check: {e: 'div' with: {t: 'a'. e: 'br'. t: 'b'. }. e: 'div'
					with: {e: 'br'. }. e: 'div' with: {t: 'c'. }. }
				gives: (lines: {'[\paragraph\]a[\newline\]b[\endParagraph\]'. '[\paragraph\]c[\endParagraph\]'. })
		)
		public test_documentBodyIsFound = (
			| doc = e: 'div'
				with: {e: 'div'
					attributes: {{'class'. 'ampleforthDocumentClass'. }. }
					with: {}. e: 'div'
					attributes: {{'class'. 'ampleforthDocumentBody'. }. }
					with: {e: 'div'
						attributes: {{'class'. 'self_ampleforth'. }. {'contenteditable'. 'true'. }. }
						with: {e: 'h1' with: {t: 'T'. }. }. }. }. conversion = converter convertDocument: doc. |
			assert: conversion source equals: (lines: {'[\title: [\T\]\]'. })
		)
		public test_documentStyleGivesTheBackground = (
			(* A slide's style element sets its background image; the style is
otherwise dropped. *)
			
			| doc = e: 'div'
				attributes: {{'class'. 'self_ampleforth'. }. }
				with: {e: 'style'
					with: {t: '.telescreenSlide { background-image: url(''peeking-eye-16-10.png''); background-repeat: no-repeat; font-size: 36px }'. }. e: 'div'
					attributes: {{'class'. 'telescreenSlide'. }. }
					with: {e: 'h1' with: {t: 'T'. }. }. }. conversion = converter convertDocument: doc. |
			assert: conversion source
				equals: '[\background: ''peeking-eye-16-10.png''\]' , (lines: {'[\title: [\T\]\]'. }).
			assert: (conversion losses collect: [:l | l kind ]) asArray printString
				equals: {'style'. } printString.
			assertClean: conversion source
		)
		public test_documentWithoutBackground = (
			| doc = e: 'div'
				attributes: {{'class'. 'self_ampleforth'. }. }
				with: {e: 'style' with: {t: 'p { color: red; background: blue }'. }. e: 'p'
					with: {t: 'x'. }. }. |
			assert: (converter convertDocument: doc) source
				equals: (lines: {'[\paragraph\]x[\endParagraph\]'. })
		)
		public test_doubleBreakEndsTheParagraph = (
			check: {e: 'div' with: {t: 'one'. e: 'br'. e: 'br'. t: 'two'. }. }
				gives: (lines: {'[\paragraph\]one[\endParagraph\]'. '[\paragraph\]two[\endParagraph\]'. })
		)
		public test_escapes = (
			check: {e: 'p' with: {t: 'a [\ b \ c'. }. }
				gives: (lines: {'[\paragraph\]a \[\\ b \\ c[\endParagraph\]'. })
		)
		public test_externalImageIsKeptAsHtml = (
			check: {e: 'p'
					with: {t: 'a '. e: 'img'
						attributes: {{'src'. 'http://x/y.png'. }. }
						with: {}. t: ' b'. }. }
				gives: (lines: {'[\paragraph\]a[\endParagraph\]'. '[\html: ''<img src="http://x/y.png">''\]'. '[\paragraph\]b[\endParagraph\]'. })
				losing: {'img'. }
		)
		public test_headingsNest = (
			check: {e: 'h1' with: {t: 'Doc'. }. e: 'p' with: {t: 'intro'. }. e: 'h2'
					with: {t: 'One'. }. e: 'p' with: {t: 'a'. }. e: 'h3' with: {t: 'Sub'. }. e: 'p'
					with: {t: 'b'. }. e: 'h2' with: {t: 'Two'. }. e: 'p' with: {t: 'c'. }. }
				gives: (lines: {'[\title: [\Doc\]\]'. '[\paragraph\]intro[\endParagraph\]'. '[\section: [\One\]\]'. '[\paragraph\]a[\endParagraph\]'. '[\section: [\Sub\]\]'. '[\paragraph\]b[\endParagraph\]'. '[\endSection. endSection. section: [\Two\]\]'. '[\paragraph\]c[\endParagraph\]'. }) , '[\endSection\]'
		)
		public test_headingWithMarkup = (
			check: {e: 'h2' with: {t: 'The '. e: 'i' with: {t: 'Play'. }. }. }
				gives: (lines: {'[\section: [\The [\emphasis\]Play[\endEmphasis\]\]\]'. }) , '[\endSection\]'
		)
		public test_inlineAmpletStaysInTheParagraph = (
			| amplet = e: 'span'
				attributes: {{'class'. 'ampleforth'. }. {'name'. 'ampleforthLink: ''a'' labeled: ''b'''. }. }
				with: {}. |
			check: {e: 'p' with: {t: 'see '. amplet. t: ' now'. }. }
				gives: (lines: {'[\paragraph\]see [\amplet: [ampleforthLink: ''a'' labeled: ''b'']\] now[\endParagraph\]'. })
		)
		public test_inlineStyles = (
			check: {e: 'p'
					with: {t: 'Hi '. e: 'i' with: {t: 'all'. }. t: ' '. e: 'b'
						with: {t: 'bold'. }. t: ' and '. e: 'code' with: {t: 'x'. }. }. }
				gives: (lines: {'[\paragraph\]Hi [\emphasis\]all[\endEmphasis\] [\strong\]bold[\endStrong\] and [\code\]x[\endCode. endParagraph\]'. })
		)
		public test_lineStyles = (
			check: {e: 'p'
					with: {e: 'u' with: {t: 'a'. }. e: 's' with: {t: 'b'. }. e: 'strike'
						with: {t: 'c'. }. t: 'H'. e: 'sub' with: {t: '2'. }. t: 'O x'. e: 'sup'
						with: {t: '2'. }. }. }
				gives: (lines: {'[\paragraph. underline\]a[\endUnderline. strikethrough\]b[\endStrikethrough. strikethrough\]c[\endStrikethrough\]H[\subscript\]2[\endSubscript\]O x[\superscript\]2[\endSuperscript. endParagraph\]'. })
		)
		public test_linkInALinkKeepsItsText = (
			check: {e: 'p'
					with: {a: 'http://x' with: {t: 'a '. a: 'http://y' with: {t: 'b'. }. }. }. }
				gives: (lines: {'[\paragraph. link: ''http://x''\]a b[\endLink. endParagraph\]'. })
				losing: {'link in a link'. }
		)
		public test_links = (
			check: {e: 'p'
					with: {t: 'see '. a: 'http://x'
						with: {t: 'the '. e: 'i' with: {t: 'site'. }. }. t: ' and '. e: 'a'
						with: {t: 'anchor'. }. }. }
				gives: (lines: {'[\paragraph\]see [\link: ''http://x''\]the [\emphasis\]site[\endEmphasis. endLink\] and anchor[\endParagraph\]'. })
		)
		public test_listInListGetsAnItem = (
			check: {e: 'ul'
					with: {e: 'li' with: {t: 'a'. }. e: 'ul' with: {e: 'li' with: {t: 'b'. }. }. }. }
				gives: (lines: {'[\list. item. paragraph\]a[\endParagraph. endItem. item. list. item. paragraph\]b[\endParagraph. endItem. endList. endItem. endList\]'. })
				losing: {'list content outside an item'. }
		)
		public test_listsNest = (
			check: {e: 'ul'
					with: {e: 'li' with: {t: 'a'. }. e: 'li'
						with: {t: 'b'. e: 'ol' with: {e: 'li' with: {t: 'c'. }. }. }. }. }
				gives: (lines: {'[\list. item. paragraph\]a[\endParagraph. endItem. item. paragraph\]b[\endParagraph. numberedList. item. paragraph\]c[\endParagraph. endItem. endNumberedList. endItem. endList\]'. })
		)
		public test_loadedMediaImagesAreMediaAmplets = (
			(* In a document the IDE has loaded, a media image's source is a
blob: URL, and its name attribute names its file: a media amplet still. A
blob: image with no name cannot be found again: it is kept, and lost. *)
			
			check: {e: 'img'
					attributes: {{'src'. 'blob:http://localhost:8080/a8a1'. }. {'name'. 'IMG_1637.jpg'. }. {'style'. 'max-width: 600px;'. }. }
					with: {}. }
				gives: (lines: {'[\amplet: [mediaFromFileNamed: ''IMG_1637.jpg'' type: ''image/jpeg'']\]'. }).
			check: {e: 'img'
					attributes: {{'src'. 'blob:http://localhost:8080/a8a1'. }. }
					with: {}. }
				gives: (lines: {'[\html: ''<img src="blob:http://localhost:8080/a8a1">''\]'. })
				losing: {'img'. }
		)
		public test_mediaImagesAreMediaAmplets = (
			| img = e: 'img'
				attributes: {{'src'. './images/goya.jpg'. }. {'name'. 'goya.jpg'. }. {'style'. 'width:321px'. }. }
				with: {}. |
			check: {img. e: 'p'
					with: {t: 'see '. a: 'http://x'
						with: {e: 'img'
							attributes: {{'src'. './images/i.png'. }. {'name'. 'i.png'. }. }
							with: {}. }. }. }
				gives: (lines: {'[\amplet: [mediaFromFileNamed: ''goya.jpg'' type: ''image/jpeg'' width: ''321px'']\]'. '[\paragraph\]see [\link: ''http://x''. amplet: [mediaFromFileNamed: ''i.png'' type: ''image/png'']. endLink. endParagraph\]'. })
		)
		public test_preformatted = (
			| nl = String fromRunes: {10. }. |
			check: {e: 'pre' with: {t: 'x := 1' , nl , '  y'. }. e: 'pre'
					with: {e: 'code' with: {t: 'a ''b'''. }. }. }
				gives: (lines: {'[\verbatim: ''x := 1' , nl , '  y''\]'. '[\codeBlock: ''a ''''b''''''\]'. })
		)
		public test_quote = (
			check: {e: 'blockquote' with: {t: 'To be.'. }. }
				gives: (lines: {'[\quote. paragraph\]To be.[\endParagraph. endQuote\]'. })
		)
		public test_ruleInBoldIsLost = (
			check: {e: 'p' with: {e: 'b' with: {t: 'a'. e: 'hr'. t: 'b'. }. }. }
				gives: (lines: {'[\paragraph. strong\]a[\newline\]b[\endStrong. endParagraph\]'. })
				losing: {'block in inline content'. }
		)
		public test_ruleIsAHorizontalLine = (
			check: {e: 'p' with: {t: 'a'. }. e: 'hr'. e: 'p'
					with: {t: 'b'. e: 'hr'. t: 'c'. }. }
				gives: (lines: {'[\paragraph\]a[\endParagraph\]'. '[\hline\]'. '[\paragraph\]b[\endParagraph\]'. '[\hline\]'. '[\paragraph\]c[\endParagraph\]'. })
		)
		public test_scriptsAreDropped = (
			check: {e: 'script' with: {t: 'x()'. }. e: 'p' with: {t: 'x'. }. }
				gives: (lines: {'[\paragraph\]x[\endParagraph\]'. })
				losing: {'script'. }
		)
		public test_slideFrameIsASlidePage = (
			(* A slide's frame has a fixed height: page: 'slide'. A document's
frame width alone is the editor's and is dropped. *)
			
			| slide = e: 'div'
				attributes: {{'class'. 'self_ampleforth'. }. {'style'. 'border: 2px solid blue; width: 1080px; height: 640px;'. }. }
				with: {e: 'p' with: {t: 'x'. }. }. doc = e: 'div'
				attributes: {{'class'. 'self_ampleforth'. }. {'style'. 'border: 2px solid blue; width: 40em;'. }. }
				with: {e: 'p' with: {t: 'x'. }. }. |
			assert: (converter convertDocument: slide) source
				equals: '[\page: ''slide''\]' , (lines: {'[\paragraph\]x[\endParagraph\]'. }).
			assert: (converter convertDocument: doc) source
				equals: (lines: {'[\paragraph\]x[\endParagraph\]'. })
		)
		public test_table = (
			check: {e: 'table'
					with: {e: 'tbody'
						with: {e: 'tr'
							with: {e: 'th' with: {t: 'A'. }. e: 'th' with: {t: 'B'. }. }. e: 'tr'
							with: {e: 'td' with: {t: 'x'. }. e: 'td' with: {t: 'y'. }. }. }. }. }
				gives: (lines: {'[\table. headerRow. cell. paragraph\]A[\endParagraph. endCell. cell. paragraph\]B[\endParagraph. endCell. endRow. row. cell. paragraph\]x[\endParagraph. endCell. cell. paragraph\]y[\endParagraph. endCell. endRow. endTable\]'. })
		)
	) : (
		TEST_CONTEXT = (
		)
	)
) : ()
