;; Non-normative full-record states, never imported into generated semantics.
def $fullEcho : fullmethod
def $fullEcho = {
  ID MD 1, SELECTOR "echo", ACCESS PUBLIC, FORMALS eps,
  LOCALS (LOCALSEQUENTIAL (LOCALLAZYIMMUTABLE (LSID 0) SELF)),
  BODY (EXPRSTMT (VALUE (OBJECTREF OID 1))), OWNER CD 1
}
def $fullDnu : fullmethod
def $fullDnu = {
  ID MD 2, SELECTOR "doesNotUnderstand:", ACCESS PRIVATE,
  FORMALS (PID 0), LOCALS eps, BODY (RETURNSTMT SELF), OWNER CD 1
}
def $runtimeMixinFixture(classbodydecl, (selector, fullmethod)*) : runtimemixin
def $runtimeMixinFixture(K, mfMap) = {
  DECL K, METHODS mfMap, SLOTS eps, NESTED eps,
  INITIALIZER { ID MD 90, SELECTOR "new", FORMALS eps, GROUPS eps, BODY eps }
}
def $runtimeProgramFixture : runtimeProgram
def $runtimeProgramFixture = {
  MIXINS
    (MID 0, $runtimeMixinFixture(CD 0, eps))
    (MID 1, $runtimeMixinFixture(CD 1, (("echo", $fullEcho) ("doesNotUnderstand:", $fullDnu))))
    (MID 2, $runtimeMixinFixture(CD 2, eps)),
  DECLMIXINS (CD 0, MID 0) (CD 1, MID 1) (CD 2, MID 2),
  LEXPARENTS eps, ACTIVATIONMEMBERS eps, SCOPECHAINS eps, OWNERS eps,
  ATOMS (NILATOM, OBJECTREF OID 2),
  PLATFORM ("Top", CLASSREF CID 0) ("Object", CLASSREF CID 1)
    ("Activation", CLASSREF CID 9) ("Closure", CLASSREF CID 9)
    ("MessageMirror", CLASSREF CID 9),
  FUTUREEXPRESSIONS eps, LOCALTHUNKS eps
}
def $runtimeClassFixture(mixinid, classid) : classrecord
def $runtimeClassFixture(M, C) = {
  MIXIN M, SUPER C, ENCLOSING OBJECTREF OID 1, METACLASS CID 9,
  FACTORY NOFACTORY, ORIGIN EXPRESSIONORIGIN CD 0
}
def $senderActivation : activationrecord
def $senderActivation = {
  PROVENANCE MD 77, PARAMETERS eps, LOCALS (LSID 0, UNINITCELL),
  RECEIVER OBJECTREF OID 0, CURRENT CLASSFOUND CID 3,
  CONTINUATION CONT AID 1, HOME CONT AID 0, CONTINUABLE true,
  SCOPES (MD 77, ACTIVATIONREF AID 0) (BLOCKDECL 8, ACTIVATIONREF AID 0)
}
def $topActivationFixture : activationrecord
def $topActivationFixture = {
  PROVENANCE TOPPROVENANCE, PARAMETERS eps, LOCALS eps,
  RECEIVER OBJECTREF OID 2, CURRENT NOCLASS, CONTINUATION NOCONT,
  HOME NOCONT, CONTINUABLE true, SCOPES eps
}
def $closureFixture : closurerecord
def $closureFixture = {
  DECL BLOCKDECL 8, FORMALS eps, LOCALS eps, BODY (EXPRSTMT SELF),
  DEFINING AID 0, RECEIVER OBJECTREF OID 0, CURRENT CLASSFOUND CID 3,
  HOME CONT AID 0
}
def $runtimeHeapFixture : runtimeHeap
def $runtimeHeapFixture = {
  OBJECTS
    (OID 0, { CLASS CID 3, SLOTS eps, NESTED eps })
    (OID 1, { CLASS CID 2, SLOTS eps, NESTED eps })
    (OID 2, { CLASS CID 1, SLOTS eps, NESTED eps }),
  CLASSES
    (CID 0, $runtimeClassFixture(MID 0, CID 0))
    (CID 1, $runtimeClassFixture(MID 0, CID 0))
    (CID 2, $runtimeClassFixture(MID 1, CID 1))
    (CID 3, $runtimeClassFixture(MID 2, CID 2))
    (CID 9, $runtimeClassFixture(MID 0, CID 1)),
  ACTIVATIONS (AID 0, $senderActivation) (AID 1, $topActivationFixture),
  CLOSURES (CLID 0, $closureFixture), MIRRORS eps,
  MIXINOBJECTS eps, ACTOROBJECTS eps
}
def $state(runtimeHeap, (actid, frame*)*, control) : machine
def $state(RH, AS, t) = { HEAP RH, STACK AS, CONTROL t }
def $dnuHeapFixture : runtimeHeap
def $dnuHeapFixture = $putMessageMirror($runtimeHeapFixture, GID 0,
  { CLASS CID 9, MESSAGE "unknown:" (OBJECTREF OID 1) })
def $methodHeapFixture(continuation) : runtimeHeap
def $methodHeapFixture(kont) = $newMethodActivation($runtimeHeapFixture, AID 2,
  $fullEcho, OBJECTREF OID 0, CID 2, ("echo" eps), kont)
def $closureHeapFixture(continuation) : runtimeHeap
def $closureHeapFixture(kont) = $newClosureActivation($runtimeHeapFixture, AID 2, CLID 0, eps, kont)
;; A dependent outside the dynamic stack is still invalidated by explicit return.
def $offStackHeap : runtimeHeap
def $offStackHeap = $putActivation($methodHeapFixture(CONT AID 0), AID 3,
  $topActivationFixture[.CONTINUATION = CONT AID 2])
;; Generic matcher regressions, unrelated to Newspeak semantics.
relation StackSuffixFixture: ((actid, frame*)*) => (actid)
rule StackSuffixFixture/last: (AS (a, pi)) => (a)
def $editedEchoProgram : runtimeProgram
def $editedEchoProgram = $runtimeProgramFixture[.MIXINS = $mapPut(mixinid, runtimemixin,
  $runtimeProgramFixture.MIXINS, MID 1,
  $runtimeMixinFixture(CD 1, (("echo", $fullEcho[.BODY = (EXPRSTMT SELF)]) ("doesNotUnderstand:", $fullDnu))))]
