;; Section 5 and the static equations of section 6.4.

def $lexParent(lookupProgram, classdecl) : decloption
def $lexParent(P, D) = $declOption($mapGet(classdecl, classdecl, P.LEXPARENTS, D))

def $declValue(decloption) : classdecl
def $declValue(DECLFOUND D) = D

;; @equation eq:lex-ancestor
def $lexAncestor(lookupProgram, classdecl, nat) : decloption
def $lexAncestor(P, D, 0) = DECLFOUND D
def $lexAncestor(P, D, n) = $lexAncestor(P, $declValue($lexParent(P, D)), $(n - 1))
  -- if n > 0
  -- if $lexParent(P, D) =/= NODECL
def $lexAncestor(P, D, n) = NODECL
  -- if n > 0
  -- if $lexParent(P, D) = NODECL

;; Finite lexical chains are explicit witnesses rather than hidden fuel.
relation LexicalChain: (lookupProgram) |- (classdecl) => (classdecl*)
rule LexicalChain/root:
  (P) |- (D) => (D)
  -- if $lexParent(P, D) = NODECL
rule LexicalChain/parent:
  (P) |- (D) => (D D'*)
  -- if $lexParent(P, D) = DECLFOUND D_1
  -- LexicalChain: (P) |- (D_1) => (D'*)

def $firstDeclIndex(classdecl*, classdecl) : natoption
def $firstDeclIndex(eps, D) = NOINDEX
def $firstDeclIndex(D_1 D'*, D) = INDEXFOUND 0 -- if D_1 = D
def $firstDeclIndex(D_1 D'*, D) = $incrementOptional($firstDeclIndex(D'*, D))
  -- if D_1 =/= D

;; @equation eq:lex-depth
relation LexicalDepth: (lookupProgram) |- (classdecl, classdecl) => (nat)
rule LexicalDepth/index:
  (P) |- (D_t, D_0) => (n)
  -- LexicalChain: (P) |- (D_0) => (D'*)
  -- if $firstDeclIndex(D'*, D_t) = INDEXFOUND n

;; @equation eq:application-indices
;; Increasing sequence represents the finite set of eligible chain indices.
def $applicationIndices(lookupProgram, lookupHeap, classid*, classdecl, nat) : nat*
def $applicationIndices(P, H, eps, D, n) = eps
def $applicationIndices(P, H, C C'*, D, n) =
  $applicationIndices(P, H, C'*, D, $(n + 1))
  -- if C = P.TOP
def $applicationIndices(P, H, C C'*, D, n) =
  n $applicationIndices(P, H, C'*, D, $(n + 1))
  -- if C =/= P.TOP
  -- if $declaration(P, H, C) = D
def $applicationIndices(P, H, C C'*, D, n) =
  $applicationIndices(P, H, C'*, D, $(n + 1))
  -- if C =/= P.TOP
  -- if $declaration(P, H, C) =/= D

relation ApplicationIndices: (lookupProgram, lookupHeap) |- (classid, classdecl) => (nat*)
rule ApplicationIndices/chain:
  (P, H) |- (C, D) => ($applicationIndices(P, H, C'*, D, 0))
  -- ClassChain: (P, H) |- (C) => (C'*)

;; @equation eq:nearest-application
relation NearestApplication: (lookupProgram, lookupHeap) |- (classid, classdecl) => (classresult)
rule NearestApplication/found:
  (P, H) |- (C, D) => (CLASSFOUND C'*[n])
  -- ClassChain: (P, H) |- (C) => (C'*)
  -- if $applicationIndices(P, H, C'*, D, 0) = n n'*
rule NearestApplication/absent:
  (P, H) |- (C, D) => (NOCLASS)
  -- ClassChain: (P, H) |- (C) => (C'*)
  -- if $applicationIndices(P, H, C'*, D, 0) = eps

;; @equation eq:target-application
relation TargetApplication: (lookupProgram, lookupHeap) |- (objref, classdecl) => (classresult)
rule TargetApplication/class:
  (P, H) |- (o, D) => (copt)
  -- NearestApplication: (P, H) |- ($classOf(H, o), D) => (copt)

relation Enclosing: (lookupProgram, lookupHeap) |- (objref, classid, nat) => (objref)

;; @rule Enc-Zero
rule Enclosing/Enc-Zero:
  (P, H) |- (o, C, 0) => (o)
  -- ClassMember: (P, H) |- (C, $classOf(H, o))

;; @rule Enc-One
rule Enclosing/Enc-One:
  (P, H) |- (o, C, 1) => ($classAt(H, C).ENCLOSING)
  -- ClassMember: (P, H) |- (C, $classOf(H, o))

;; @rule Enc-Step
rule Enclosing/Enc-Step:
  (P, H) |- (o, C, n) => ($classAt(H, C_1).ENCLOSING)
  -- if n > 1
  -- Enclosing: (P, H) |- (o, C, $(n - 1)) => (o_1)
  -- if $declaration(P, H, C) = D
  -- if $lexAncestor(P, D, $(n - 1)) = DECLFOUND D_1
  -- NearestApplication: (P, H) |- ($classOf(H, o_1), D_1) => (CLASSFOUND C_1)

def $declMethods(lookupProgram, classbodydecl) : (selector, methodview)*
def $declMethods(P, K) = $methods(P,
  $require(mixinid, $mapGet(classbodydecl, mixinid, P.DECLMIXINS, K)))

def $privateProjection(methodoption) : methodoption
def $privateProjection(NOMETHOD) = NOMETHOD
def $privateProjection(METHODFOUND f) = METHODFOUND f -- if f.ACCESS = PRIVATE
def $privateProjection(METHODFOUND f) = NOMETHOD -- if f.ACCESS =/= PRIVATE

;; @equation eq:private-method
def $privateMethod(lookupProgram, classdecl, selector) : methodoption
def $privateMethod(P, D, s) =
  $privateProjection($methodOption($mapGet(selector, methodview, $declMethods(P, D), s)))

;; @equation eq:declares
def $declares(lookupProgram, scopedecl, selector) : bool
def $declares(P, K, s) = $mapGet(selector, methodview, $declMethods(P, K), s) =/= eps
def $declares(P, q, s) = s <-
  $require(selector*, $mapGet(actdecl, selector*, P.ACTIVATIONMEMBERS, q))

;; @equation eq:scope-chain
def $scopeChain(lookupProgram, siteid) : scopedecl*
def $scopeChain(P, z) =
  $require(scopedecl*, $mapGet(siteid, scopedecl*, P.SCOPECHAINS, z))

;; @equation eq:lexical-binding
def $bindScopes(lookupProgram, scopedecl*, selector) : scopeoption
def $bindScopes(P, eps, s) = NOSCOPE
def $bindScopes(P, d d'*, s) = SCOPEFOUND d -- if $declares(P, d, s)
def $bindScopes(P, d d'*, s) = $bindScopes(P, d'*, s)
  -- if ~$declares(P, d, s)

def $bind(lookupProgram, siteid, selector) : scopeoption
def $bind(P, z, s) = $bindScopes(P, $scopeChain(P, z), s)

;; @equation eq:class-scan
relation ClassScan: (lookupProgram) |- (classdecl, selector) => (decloption)
rule ClassScan/hit:
  (P) |- (D, s) => (DECLFOUND D)
  -- if $declares(P, D, s)
rule ClassScan/parent:
  (P) |- (D, s) => (dopt)
  -- if ~$declares(P, D, s)
  -- if $lexParent(P, D) = DECLFOUND D_1
  -- ClassScan: (P) |- (D_1, s) => (dopt)
rule ClassScan/absent:
  (P) |- (D, s) => (NODECL)
  -- if ~$declares(P, D, s)
  -- if $lexParent(P, D) = NODECL

;; @equation eq:implicit-receiver
relation ImplicitReceiver: (lookupProgram, lookupHeap) |- (objref, classid, classdecl, selector) => (objref, decloption)
rule ImplicitReceiver/found:
  (P, H) |- (o, C, D, s) => (o_t, DECLFOUND D_t)
  -- ClassScan: (P) |- (D, s) => (DECLFOUND D_t)
  -- LexicalDepth: (P) |- (D_t, D) => (n)
  -- Enclosing: (P, H) |- (o, C, n) => (o_t)
rule ImplicitReceiver/absent:
  (P, H) |- (o, C, D, s) => (o, NODECL)
  -- ClassScan: (P) |- (D, s) => (NODECL)
