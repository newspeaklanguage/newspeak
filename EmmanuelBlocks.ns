Newspeak3
'Emmanuel'
class EmmanuelBlocks usingPlatform: p emmanuel: em = (
	(* The standard block library of Emmanuel (Section 6 of the specification,
formal-semantics/emmanuel/spectec/library/07-library.spectec): one
DocumentBlock subclass per kind of block, and, for each, the Hopscotch
presenter that renders it.

A block's protocol is its content model: model lists the messages it
understands. Receiving one answers an effect: openers push a new block,
closers pop, newline and the displays (verbatim:, codeBlock:, html:) add
leaves, and the inline-argument messages (section:, title:, subtitle:,
author:, attribution:, caption:) take a markup literal, interpreted with an
inline root, or a string.

A symbol is a string literal, so labels and languages, written as symbols
(#intro), are Strings like any other string argument.

The core library is semantic. Presentation is a stylesheet's (Stylesheet,
StyleSpec): the styles a document's template offers beyond the core, each
an inline style or a flow container whose look is given with the
presentation operations (Presentation). A block carries the stylesheet of
the document it is in (none: defaultStylesheet, which offers underline,
color:, highlight:, and align:); coreStylesheet offers nothing, a paper's.
A stylesheet also gives the looks of a document's parts (lookOf:): its
text, title, subtitle, authors, paragraphs, headings, and items; a slide's
(slideStylesheet) is large text on a slide. A document's page (page:)
bounds the width it is laid out to (pageMaxWidth:, pageStyleOf:); a slide
is a fixed canvas, zoomed to the space it has.

Rendering: a block names its presenter (presenterOn:). A presenter renders
its tree as an ElementFragment, an HTML element whose children are text and
the presenters of the subtrees. *)
	
	|
		private List = p collections List.
		private Map = p collections Map.
		private emmanuel = em.
		private DocumentBlock = em DocumentBlock.
		private Fragment = p hopscotch Fragment.
		private Presenter = p hopscotch Presenter.
		private Subject = p hopscotch Subject.
		private window = p js global.
	|
) (
	lazy public coreStylesheet = Stylesheet styles: {}.
	lazy public defaultStylesheet = Stylesheet styles: {StyleSpec opener: 'underline'
			closer: 'endUnderline'
			contentClass: #inline
			tag: 'u'
			presentation: [:p :as |]. StyleSpec opener: 'color:'
			closer: 'endColor'
			contentClass: #inline
			tag: 'span'
			presentation: [:p :as | p textColor: as first ]. StyleSpec opener: 'highlight:'
			closer: 'endHighlight'
			contentClass: #inline
			tag: 'span'
			presentation: [:p :as | p backgroundColor: as first ]. StyleSpec opener: 'align:'
			closer: 'endAlign'
			contentClass: #flow
			tag: 'div'
			presentation: [:p :as | p align: as first ]. }.
	lazy private domDocument = (* A host object: a lazy slot, so that a restore into a new host (Eurasia) looks it up again. *) window at: #document.
	lazy public slideStylesheet = (* The default stylesheet's styles, with a slide's looks: large text (a slide's text was 36 pixels), a title twice its size, and paragraphs close together. *) defaultStylesheet withLooks: {{#document. 'font-size: 36px; line-height: 1.25;'. }. {#title. 'font-size: 2em; margin: 0 0 0.3em 0;'. }. {#subtitle. 'font-size: 1.3em; margin: 0 0 0.3em 0;'. }. {#author. 'font-size: 0.6em;'. }. {#paragraph. 'margin: 0.3em 0;'. }. {#heading. 'font-size: 1.3em; margin: 0.4em 0 0.2em 0;'. }. {#item. 'margin: 0.15em 0;'. }. }.
	public class Amplet code: v inline: b = LibraryBlock new (
		(* An amplet (Section 6): live content the view computes by running v,
the host value of the amplet's code (in the Newspeak host, a closure). In
flow content it is a display; elsewhere, an inline leaf. *)
		
		|
			public code = v.
			public isInline = b.
		|
	) (
		public contentClass = (
			^isInline ifTrue: [ #inline ] ifFalse: [ #flow ]
		)
		public htmlTag = (
			^isInline ifTrue: [ 'span' ] ifFalse: [ 'div' ]
		)
		public presenterOn: s = (
			^AmpletPresenter onSubject: s
		)
		public stateName = (
			^isInline ifTrue: [ 'inlineAmplet' ] ifFalse: [ 'amplet' ]
		)
		public stateValues = (
			^{code. }
		)
	) : ()
	public class AmpletPresenter onSubject: s = BlockPresenter onSubject: s (
		(* Shows an amplet: what running its code answers, which the session
the tree is rendered in computes and keeps; with no session, its code. *)
		
	) (
		childFragments = (
			^{subject ampletFragmentFor: block code. }
		)
		definition = (
			^noEdit: super definition
		)
	) : ()
	public class AmpletRunner evaluator: ev = (
		(* Runs the amplets of the trees a view renders, and keeps what they
answer: an amplet is run once, and its result kept while its code is
unchanged. A result is keyed by the amplet's code and its occurrence among
the amplets with that code in one rendering; a rendering is bracketed by
beginRender and endRender, which drops the results it did not use.

ev evaluate: aString answers the value of the code aString in the
document's scope; an amplet's code is a block, which is then run. With no
evaluator, an amplet shows its code. *)
		
		|
			private evaluator = ev.
			private cache ::= Map new.
			private next ::= Map new.
			private counts ::= Map new.
		|
	) (
		public adopt: other = (
			(* Take over the results other keeps, as a new rendering of a
document does from the one it replaces. *)
			
			cache:: other keptResults
		)
		public beginRender = (
			next:: Map new.
			counts:: Map new
		)
		codeOfKey: key = (
			(* The code of a key of the cache: the key less its occurrence suffix. *)
			
			^key copyFrom: 1 to: (key lastIndexOf: '#') - 2
		)
		public endRender = (
			cache:: next
		)
		public fragmentFor: closure = (
			(* What the amplet whose code's value is closure shows. *)
			
			| code = closure code. n = (counts at: code ifAbsent: [ 0 ]) + 1. key = code , ' #' , n printString. result |
			counts at: code put: n.
			result:: cache at: key ifAbsent: [ run: code ].
			next at: key put: result.
			^result
		)
		public keptResults = (
			^cache
		)
		public refresh = (
			(* Run the kept amplets that answered fragments again, as an
Ampleforth document's amplets run again on each refresh of the GUI
(updateGUI:), and reconcile each new fragment with the one it replaces, so
that it takes over its visual and state: a presenter whose subject changed
shows the change (a presentation's next slide). Other results are kept. *)
			
			| fresh = Map new. |
			cache keysAndValuesDo: [:key :old |
					| new ::= old. |
					old isKindOfFragment ifTrue: [
							new:: run: (codeOfKey: key).
							(new isKindOfFragment and: [ old hasVisual ]) ifTrue: [
									new parent: old parent.
									new updateVisualsFrom: old
								]
						].
					fresh at: key put: new
				].
			cache:: fresh
		)
		run: code = (
			| value |
			evaluator isNil ifTrue: [ ^code ].
			value:: [ (evaluator evaluate: code) value ] on: Error
				do: [:e | ^errorFragment: 'The amplet failed: ' , e messageText printString ].
			value isKindOfFragment ifTrue: [ ^value ].
			value isKindOfString ifTrue: [ ^value ].
			^value printString
		)
		public urlOfImage: name = (
			(* The URL of the image a document names: the evaluator's answer
(an image of the document, or name as a URL); with no evaluator, name. *)
			
			evaluator isNil ifTrue: [ ^name ].
			^evaluator urlOfImage: name
		)
	) : ()
	public class BlockPresenter onSubject: s = Presenter onSubject: s (
		(* Renders a tree: an element with the block's tag and style, holding the
tree's children. Subclasses add what the block's fields show. *)
		
	) (
		annotated: fragment = (
			(* The fragment of the block, marked for the editor: its path, and
its index among its parent's children. *)
			
			| ss = subject steps. last |
			fragment attributes: fragment attributes , {{'data-steps'. join: ss with: ' '. }. }.
			ss isEmpty ifFalse: [
					last:: emmanuel codePointsOf: ss last.
					last first = 105 ifTrue: [
							fragment attributes: fragment attributes , {{'data-item'. emmanuel stringOfCodePoints: (last copyFrom: 2
										to: last size). }. }
						]
				].
			^fragment
		)
		block = (
			^tree state
		)
		childFragments = (
			^fragmentsOfItems: tree items steps: subject steps amplets: subject amplets
		)
		definition = (
			^annotated: (ElementFragment tag: block htmlTag
					style: (styleOf: block)
					children: leadingFragments , childFragments , trailingFragments)
		)
		field: v tag: tag style: st = (
			(* The element that shows the field v: editable text when it holds
markup, marked with the path into the field; a string as it is. *)
			
			| f = ElementFragment tag: tag
				style: st
				children: (fragmentsOfValue: v
					steps: (fieldSteps: v)
					amplets: subject amplets). |
			v isKindOfTreeValue ifTrue: [
					f attributes: {{'data-steps'. join: (fieldSteps: v) with: ' '. }. }
				]
				ifFalse: [ f attributes: {{'contenteditable'. 'false'. }. } ].
			^f
		)
		fieldSteps: v = (
			| fields = block fields: tree messages. |
			fields keysAndValuesDo: [:i :phi |
					phi value == v ifTrue: [ ^subject steps , {'f' , (i - 1) printString. } ]
				].
			^subject steps
		)
		public isKindOfEmmanuelBlockPresenter = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelBlockPresenter
		)
		leadingFragments = (
			^{}
		)
		styleOf: b = (
			tree flag = #unclosed ifTrue: [ ^b htmlStyle , ' outline: 1px dashed red;' ].
			tree flag = #rejected ifTrue: [ ^b htmlStyle , ' outline: 1px solid red;' ].
			^b htmlStyle
		)
		trailingFragments = (
			^{}
		)
		tree = (
			^subject tree
		)
	) : ()
	public class BulletList new = LibraryBlock new (
	) (
		public htmlTag = (
			^'ul'
		)
		public model = (
			^{'item'. 'endList'. }
		)
		public stateName = (
			^'list'
		)
	) : ()
	public class Cell new = LibraryBlock new (
	) (
		public contentClass = (
			^#cell
		)
		public htmlTag = (
			^'td'
		)
		public model = (
			^flowContent , inlineContent , {'endCell'. }
		)
		public stateName = (
			^'cell'
		)
	) : ()
	public class CodeDisplay text: t language: l = LibraryBlock new (
		(* codeBlock: and codeBlock:language:, a leaf. *)
		
		|
			public text = t.
			public language = l.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: text statement: messages first index: 0. }
		)
		public htmlTag = (
			^'pre'
		)
		public presenterOn: s = (
			^TextBlockPresenter onSubject: s
		)
		public stateName = (
			^'codeBlock'
		)
		public stateValues = (
			^{text. language. }
		)
	) : ()
	public class DocumentPresenter onSubject: s = BlockPresenter onSubject: s (
		(* A document shows its title, subtitle, and authors before its body,
all on its background image, if it has one. A slide is laid out at its own
size and zoomed to the space it has, so its text, images, and layout shrink
or grow together. *)
		
	) (
		backgroundStyle = (
			| url |
			block background isNil ifTrue: [ ^'' ].
			url:: subject amplets isNil ifTrue: [ block background ]
				ifFalse: [ subject amplets urlOfImage: block background ].
			^' background-image: url("' , url , '"); background-repeat: no-repeat;'
		)
		definition = (
			| f = super definition. |
			block page = 'slide' ifTrue: [ f onVisual: [:e | fitSlide: e ] ].
			^f
		)
		fitSlide: element = (
			(* Zoom the slide element whenever it, the space around it, or the
window changes size. *)
			
			[
				| observer = (window at: 'ResizeObserver') new: [:entries :obs |
						| p = element at: 'parentElement'. |
						p isNil ifFalse: [
								obs observe: p.
								zoomSlide: element in: p
							].
						nil
					]. |
				observer observe: element.
				observer observe: ((window at: #document) at: 'documentElement')
			] on: Exception do: [:e | nil ]
		)
		leadingFragments = (
			| out = List new. |
			block title isNil ifFalse: [
					out add: (field: block title tag: 'h1' style: (block sheet lookOf: #title))
				].
			block subtitle isNil ifFalse: [
					out add: (field: block subtitle
							tag: 'h2'
							style: 'font-weight: normal;' , (block sheet lookOf: #subtitle))
				].
			block authors do: [:a |
					out add: (field: a
							tag: 'div'
							style: 'font-style: italic;' , (block sheet lookOf: #author))
				].
			^out asArray
		)
		styleOf: b = (
			^(super styleOf: b) , (block sheet lookOf: #document) , backgroundStyle , (pageStyleOf: block page)
		)
		zoomSlide: element in: p = (
			(* Zoom the slide to the width it has, the editor's frame or the
window to its right: smaller where it has less than its own 1080 pixels,
never larger. *)
			
			| left = element getBoundingClientRect at: 'left'. avail s |
			avail:: (window at: 'innerWidth') - left - 16.
			(p hasAttribute: 'contenteditable') ifTrue: [
					avail:: avail min: (p at: 'clientWidth') - 8
				].
			s:: avail asFloat / 1080 min: 1.
			s <= 0 ifTrue: [ ^self ].
			(element getAttribute: 'data-scale') = s printString ifTrue: [ ^self ].
			element setAttribute: 'data-scale' to: s printString.
			(element at: 'style') at: 'zoom' put: s printString
		)
	) : ()
	public class DocumentRoot title: t subtitle: st background: b page: pg authors: as = LibraryBlock new (
		(* The root block of a document: its title, subtitle, background (a
string naming an image, set by background:), page (a string naming what it
is laid out for, set by page:), and authors. *)
		
		|
			public title = t.
			public subtitle = st.
			public background = b.
			public page = pg.
			public authors = as.
		|
	) (
		authorFields: messages = (
			(* A field for each author, from the author: messages in order. *)
			
			| sends = withSelector: 'author:' in: messages. |
			^(1 to: authors size) asArray collect: [:i |
					emmanuel Field value: (authors at: i) statement: (sends at: i) index: 0
				]
		)
		depth = (
			^0
		)
		public fields: messages = (
			^(fieldFor: title selector: 'title:' messages: messages) , (fieldFor: subtitle
				selector: 'subtitle:'
				messages: messages) , (authorFields: messages)
		)
		free: x = (
			x = 'title:' ifTrue: [ ^title isNil ].
			x = 'subtitle:' ifTrue: [ ^subtitle isNil ].
			^true
		)
		public htmlTag = (
			^'article'
		)
		public model = (
			^flowContent , {'section:'. 'title:'. 'subtitle:'. 'author:'. 'background:'. 'page:'. }
		)
		plain: x args: vs hostState: chi = (
			(* background: and page: each set their field once, to a string. *)
			
			(x = 'background:' and: [ vs size = 1 ]) ifTrue: [
					^(background isNil and: [ vs first isKindOfString ]) ifTrue: [
							mutate: (DocumentRoot title: title
									subtitle: subtitle
									background: vs first
									page: page
									authors: authors)
								hostState: chi
						]
						ifFalse: [ effect: #refuse hostState: chi ]
				].
			(x = 'page:' and: [ vs size = 1 ]) ifTrue: [
					^(page isNil and: [ vs first isKindOfString ]) ifTrue: [
							mutate: (DocumentRoot title: title
									subtitle: subtitle
									background: background
									page: vs first
									authors: authors)
								hostState: chi
						]
						ifFalse: [ effect: #refuse hostState: chi ]
				].
			^super plain: x args: vs hostState: chi
		)
		public presenterOn: s = (
			^DocumentPresenter onSubject: s
		)
		public stateName = (
			^'doc'
		)
		public stateValues = (
			^{title. subtitle. background. page. } , authors
		)
		with: x value: v hostState: chi = (
			x = 'title:' ifTrue: [
					^mutate: (DocumentRoot title: v
							subtitle: subtitle
							background: background
							page: page
							authors: authors)
						hostState: chi
				].
			x = 'subtitle:' ifTrue: [
					^mutate: (DocumentRoot title: title
							subtitle: v
							background: background
							page: page
							authors: authors)
						hostState: chi
				].
			x = 'author:' ifTrue: [
					^mutate: (DocumentRoot title: title
							subtitle: subtitle
							background: background
							page: page
							authors: (authors copyWith: v))
						hostState: chi
				].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^title: nil subtitle: nil background: nil page: nil authors: {}
		)
	)
	public class ElementFragment tag: t style: st children: cs = Fragment new (
		(* An HTML element with a tag and a style, whose children are text
(Strings) and fragments. Unlike an HTMLFragment it is not wrapped in a
document body, so it can be inline. *)
		
		|
			public tag = t.
			public style = st.
			public children = cs.
			public rawHTML ::= nil.
			public attributes ::= {}.
			public onVisual ::= nil.
		|
	) (
		public childrenDo: action = (
			children do: [:c | c isKindOfString ifFalse: [ action value: c ] ]
		)
		createVisual = (
			| element = domDocument createElement: tag. |
			(style isNil or: [ style isEmpty ]) ifFalse: [
					element setAttribute: 'style' to: style
				].
			attributes do: [:a | element setAttribute: (a at: 1) to: (a at: 2) ].
			rawHTML isNil ifFalse: [ element at: 'innerHTML' put: rawHTML ].
			children do: [:c |
					c isKindOfString ifTrue: [
							element appendChild: (domDocument createTextNode: c)
						]
						ifFalse: [
							c parent: self.
							element appendChild: c visual
						]
				].
			onVisual isNil ifFalse: [ onVisual value: element ].
			^element
		)
		public isKindOfEmmanuelElementFragment = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelElementFragment
		)
		updateVisualsFromSameKind: oldFragment = (
			(* Rendering is read-only for now: a new element replaces the old. *)
			
			^replaceVisual: oldFragment visual with: visual
		)
	) : ()
	public class Emphasis new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'em'
		)
		public model = (
			^inlineContent , {'endEmphasis'. }
		)
		public stateName = (
			^'emph'
		)
	) : ()
	public class Figure caption: c label: l = LibraryBlock new (
		|
			public caption = c.
			public label = l.
		|
	) (
		public fields: messages = (
			^fieldFor: caption selector: 'caption:' messages: messages
		)
		free: x = (
			x = 'caption:' ifTrue: [ ^caption isNil ].
			^true
		)
		public htmlTag = (
			^'figure'
		)
		public isLabelled = (
			^true
		)
		public model = (
			^displays , {'caption:'. 'label:'. 'endFigure'. }
		)
		public presenterOn: s = (
			^FigurePresenter onSubject: s
		)
		public relabel: v = (
			^Figure caption: caption label: v
		)
		public stateName = (
			^'figure'
		)
		public stateValues = (
			^{caption. label. }
		)
		with: x value: v hostState: chi = (
			x = 'caption:' ifTrue: [
					^mutate: (Figure caption: v label: label) hostState: chi
				].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^caption: nil label: nil
		)
	)
	public class FigurePresenter onSubject: s = BlockPresenter onSubject: s (
	) (
		trailingFragments = (
			block caption isNil ifTrue: [ ^{} ].
			^{field: block caption tag: 'figcaption' style: ''. }
		)
	) : ()
