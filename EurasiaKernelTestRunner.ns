Newspeak3
'Eurasia'
class EurasiaKernelTestRunner usingPlatform: platform = (
	(* The kernel test suites on Eurasia, compared with psoup by eurasia/scripts/kernel-tests.sh (EurasiaKernelTestReference runs them there). The genesis packager packages this application as if nested in EurasiaKernel (so the kernel's VM mirror, vm, is visible lexically), fills the slots below that are named after packaged modules with their classes, and testCatalog with their tests. Genesis builds the platform (platformOver:); the message loop delivers main:args:. Each test runs as Minitest's TestCase>>runAsyncUsing: runs it, in a turn of its own, and the next starts when its promise settles; one line is printed per test: Context>>selector, then success, failure or error, and a description. Minitest finds tests with mirrors, which Eurasia does not have yet (M6), so the tests come from the packager's catalog and Minitest serves only for TestContext. *)
	
	|
		Kernel
		CollectionsForPrimordialSoup
		EurasiaActors
		EurasiaRuntime
		Minitest
		KernelTests
		AccessModifierTesting
		KernelWeakTests
		ActorsTesting
		TestActor
		JSTesting
		EurasiaHostTesting
		testCatalog
	|
) (
	describe: exception = (
		^[ exception messageText printString ] on: Exception do: [:e | '?' ]
	)
	public main: platform args: args = (
		| minitest tests |
		minitest:: Minitest usingPlatform: platform.
		platform actors ultimateExceptionHandler: [:e :activation |
				vm print: 'Unhandled in a turn: ' , (describe: e)
			].
		tests:: platform collections List new.
		testCatalog do: [:entry |
				| module |
				(entry at: 2) isEmpty ifFalse: [
						module:: testModuleNamed: (entry at: 1)
							platform: platform
							minitest: minitest
					].
				(entry at: 2) do: [:context |
						(context at: 2) do: [:selector |
								tests add: {module. context at: 1. selector. }
							]
					]
			].
		run: tests from: 1 platform: platform
	)
	outcomeOf: problem = (
		(* A failed assertion (Minitest's TestFailureException, private to it, so recognized by name) is a failure, any other problem an error. (In this kernel Error is Exception.) *)
		
		^((vm slotOf: (vm classOf: problem) at: 4) = 'TestFailureException' ifTrue: [
				'failure '
			]
			ifFalse: [ 'error ' ]) , (describe: problem)
	)
	public platformOver: internalKernel = (
		^(EurasiaRuntime kernel: Kernel
			collections: CollectionsForPrimordialSoup
			actors: EurasiaActors) Platform internalKernel: internalKernel
	)
	run: tests from: index platform: platform = (
		| test name |
		index > tests size ifTrue: [ ^vm print: 'done' ].
		test:: tests at: index.
		name:: (test at: 2) , '>>' , (test at: 3).
		platform actors Promise when: [
				| context |
				context:: ((Message selector: (test at: 2) arguments: {}) sendTo: (test at: 1)) new.
				(Message selector: (test at: 3) arguments: {}) sendTo: context
			] <-: value
			fulfilled: [:result |
				vm print: name , ' success'.
				run: tests from: index + 1 platform: platform
			]
			broken: [:problem |
				vm print: name , ' ' , ([ outcomeOf: problem ] on: Exception
						do: [:e | 'error (unreportable: ' , e printString , ')' ]).
				run: tests from: index + 1 platform: platform
			]
	)
	testModuleNamed: name platform: platform minitest: minitest = (
		name = 'KernelTests' ifTrue: [
				^KernelTests usingPlatform: platform testFramework: minitest
			].
		name = 'AccessModifierTesting' ifTrue: [
				^AccessModifierTesting usingPlatform: platform testFramework: minitest
			].
		name = 'KernelWeakTests' ifTrue: [
				^KernelWeakTests usingPlatform: platform
					minitest: minitest
					gcAction: [ platform kernel garbageCollect ]
			].
		name = 'ActorsTesting' ifTrue: [
				^ActorsTesting usingPlatform: platform
					actors: platform actors
					testActor: TestActor
					minitest: minitest
			].
		name = 'EurasiaHostTesting' ifTrue: [
				^EurasiaHostTesting usingPlatform: platform testFramework: minitest
			].
		name = 'JSTesting' ifTrue: [
				^JSTesting usingPlatform: platform testFramework: minitest
			].
		^Error signal: 'No test module ' , name
	)
) : ()
