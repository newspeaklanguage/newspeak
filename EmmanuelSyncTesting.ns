Newspeak3
'Emmanuel'
class EmmanuelSyncTesting usingPlatform: p minitest: m editor: ed = (
	(* Headless tests of the sync between the raw view and the live view of
an Emmanuel document (issue #114): the point of the view that shows an
offset of the source, and the offset of the source of a point of the view,
through the live editor's Session, with the Newspeak host and the block
library. *)
	
	|
		private TestContext = m TestContext.
		private editor = ed.
	|
) (
	public class SyncTests new = TestContext new (
	) (
		assertRoundTripsIn: source from: a to: b = (
			(* Each offset of source from a to b, which is text, goes to a point
that goes back to it. *)
			
			| s = session: source. |
			a to: b
				do: [:k | assert: (s sourceOffsetAt: (s pointAtSourceOffset: k)) equals: k ]
		)
		offsetOf: x in: source = (
			(* The offset, from 0, of the first occurrence of x in source; the
sources here are ASCII, so its code points are its bytes. *)
			
			^(source indexOf: x) - 1
		)
		session: source = (
			^editor Session source: source evaluator: nil
		)
		public test_bracketGoesToTheTextAfterIt = (
			(* An offset in a bracket, in no message that creates or closes a
block (a mutating one, here), is the start of the text after the bracket. *)
			
			| source = '[\section: [\Intro\]. label: #intro. paragraph\]Body[\endParagraph. endSection\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'intro.'
					in: source). |
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'Body' in: source)
		)
		public test_closingMessageGoesAfterItsBlock = (
			| source = '[\paragraph\]Body[\endParagraph. paragraph\]Next[\endParagraph\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'endParagraph'
					in: source) + 3. |
			assert: pt isGap.
			assert: pt child equals: 1.
			assert: pt steps isEmpty.
			assert: (s sourceOffsetAt: pt)
				equals: (offsetOf: 'paragraph\]Next' in: source)
		)
		public test_creatingMessageGoesBeforeItsBlock = (
			(* An offset in the message that creates a block is just before the
block, which goes back to the start of the message. *)
			
			| source = '[\section: [\Intro\]. paragraph\]Body[\endParagraph. endSection\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'paragraph'
					in: source) + 2. |
			assert: pt isGap.
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'paragraph' in: source)
		)
		public test_escapesCountAsOneCharacter = (
			(* An escape is two code points of the source and one character of
the view, so the offsets after it differ by one. *)
			
			| source = '[\paragraph\]a\\b c[\endParagraph\]'. s = session: source. after = offsetOf: 'c'
				in: source. pt = s pointAtSourceOffset: after. |
			assert: pt offset equals: 4.
			assert: (s sourceOffsetAt: pt) equals: after
		)
		public test_headingOffsetsAreInItsField = (
			(* An offset in a section's heading, a markup literal, is a point in
the heading's field, and goes back to the same offset. *)
			
			| source = '[\section: [\Intro\]. paragraph\]Body[\endParagraph. endSection\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'tro'
					in: source). |
			assert: (pt steps anySatisfy: [:st | st isField ]).
			assertRoundTripsIn: source
				from: (offsetOf: 'Intro' in: source) + 1
				to: (offsetOf: 'Intro' in: source) + 4
		)
		public test_leafInABracketOfItsOwn = (
			(* As NS101 has it: a leaf in a bracket of its own, after a newline;
the point before it is at its message, not at the newline. *)
			
			| source = '[\paragraph\]a[\endParagraph\]
[\html: ''<h2>big</h2>''\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'big'
					in: source). |
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'html:' in: source)
		)
		public test_leafStringGoesBeforeTheLeaf = (
			(* An offset in the string of an html: display, a leaf, is just
before the leaf. *)
			
			| source = '[\paragraph\]a[\endParagraph. html: ''<h2>big</h2>''\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'big'
					in: source). |
			assert: pt isGap.
			assert: pt child equals: 1.
			assert: (s sourceOffsetAt: pt) equals: (offsetOf: 'html:' in: source)
		)
		public test_paragraphTextRoundTrips = (
			| source = '[\paragraph\]Hello world[\endParagraph\]'. s = session: source. pt = s pointAtSourceOffset: (offsetOf: 'world'
					in: source). |
			assert: pt isGap not.
			assert: pt offset equals: 6.
			assertRoundTripsIn: source
				from: (offsetOf: 'Hello' in: source) + 1
				to: (offsetOf: 'world' in: source) + 4
		)
		public test_uninterpretableSourceHasNoSync = (
			| s = session: '[\paragraph\]never closed [\'. |
			assert: (s pointAtSourceOffset: 3) isNil
		)
	) : (
		TEST_CONTEXT = (
		)
	)
) : ()
