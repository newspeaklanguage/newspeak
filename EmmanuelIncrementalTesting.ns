Newspeak3
'Emmanuel'
class EmmanuelIncrementalTesting usingPlatform: p minitest: m emmanuel: em host: hostModule incremental: inc = (
	(* Tests of EmmanuelIncremental against the reference: every edit of a
set of sources (inserting a character, deleting one, and inserting the
brackets [\ and \] at every position) is reparsed incrementally and
parsed whole, and the two must agree; where the whole source does not
parse, the incremental parse must answer nil. *)
	
	|
		private TestContext = m TestContext.
		private emmanuel = em.
		private hosts = hostModule.
		private incremental = inc.
	|
) (
	public class ReparseTests new = TestContext new (
		|
			host = hosts Host evaluator: nil.
			reused ::= 0.
			parsable ::= 0.
		|
	) (
		check: w edit: w2 = (
			(* The incremental parse of w2 agrees with the whole one. *)
			
			| old = emmanuel parse: 'doc' source: w host: host. whole = emmanuel parse: 'doc'
				source: w2
				host: host. nodes |
			nodes:: incremental reparse: old nodes old: w new: w2 name: 'doc' host: host.
			(whole isNil not and: [ whole isKindOfParsed ]) ifTrue: [
					parsable:: parsable + 1
				].
			nodes isNil ifTrue: [ ^self ].
			reused:: reused + 1.
			assert: (whole isNil not and: [ whole isKindOfParsed ])
				description: 'reparsed what does not parse: ' , (emmanuel stringOfCodePoints: w2).
			assert: (same: nodes as: whole nodes)
				description: 'disagrees on: ' , (emmanuel stringOfCodePoints: w2)
		)
		edits: source = (
			(* Every edit of a source, checked. *)
			
			| w = emmanuel codePointsOf: source. |
			0 to: w size
				do: [:k |
					| before = w copyFrom: 1 to: k. after = w copyFrom: k + 1 to: w size. |
					check: w edit: before , {120. } , after.
					check: w edit: before , {91. 92. } , after.
					check: w edit: before , {92. 93. } , after.
					k < w size ifTrue: [
							check: w edit: before , (after copyFrom: 2 to: after size)
						]
				]
		)
		same: nodes as: others = (
			nodes size = others size ifFalse: [ ^false ].
			1 to: nodes size
				do: [:i | (sameNode: (nodes at: i) as: (others at: i)) ifFalse: [ ^false ] ].
			^true
		)
		sameNode: n as: n2 = (
			(* As terms, and the spans of the arguments, which terms omit. *)
			
			(emmanuel termStringOf: n) = (emmanuel termStringOf: n2) ifFalse: [ ^false ].
			n statements with: n2 statements
				do: [:s :s2 |
					s isComment ifFalse: [
							s arguments with: s2 arguments
								do: [:e :e2 |
									e span = e2 span ifFalse: [ ^false ].
									e lits with: e2 lits
										do: [:l :l2 | (same: l nodes as: l2 nodes) ifFalse: [ ^false ] ]
								]
						]
				].
			^true
		)
		public test_everyEditAgreesWithTheWholeParse = (
			{'[\paragraph\]Hello [\emphasis\]world[\endEmphasis. endParagraph\]'. '[\title: [\The [\emphasis\]Play[\endEmphasis\]\]. author: ''Ham''\]Text[\paragraph\]x[\endParagraph\]'. '[\(* note *) paragraph\]a \[ b \\ c[\endParagraph\]tail'. '[\verbatim: ''x \] y''. amplet: [section: ''S'' titled: ''T'']\][\paragraph\]é[\endParagraph\]'. 'a[\paragraph\]x[\endParagraph\]b[\section: ''S''. label: #l\]c[\title: [\T\]\]d[\endSection\]'. 'plain text only'. ''. } do: [:s |
					edits: s
				].
			assert: reused * 10 >= (parsable * 9)
				description: 'incremental for ' , reused printString , ' of the ' , parsable printString , ' edits that parse'
		)
	) : (
		TEST_CONTEXT = (
		)
	)
) : ()
