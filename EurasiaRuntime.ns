Newspeak3
'Eurasia'
class EurasiaRuntime kernel: kernelModule collections: collectionsModule actors: actorsModule = (
	(* The platform on Eurasia, as RuntimeForPrimordialSoup is on psoup: psoup's public kernel, collections and actors modules over the internal kernel (EurasiaKernel). An application packaged with the genesis packager builds it in platformOver:, which the genesis entry calls; what Eurasia does not have yet (mirrors, M6; serialization between VMs, which ports and spawn need) is a stand-in whose classes are nil. *)
	
	|
		private Kernel = kernelModule.
		private Collections = collectionsModule.
		private Actors = actorsModule.
	|
) (
	public class Platform internalKernel: ik = (
		|
			public kernel = Kernel wrapping: ik.
			public collections = Collections usingInternalKernel: ik.
			public victoryFuel = Unavailable new.
			public mirrors = Unavailable new.
			public actors = Actors usingPlatform: self.
		|
	) (
	) : ()
	class Unavailable new = (
		(* Stands in for a module Eurasia does not have yet; its users only store these classes. *)
		
	) (
		public ClassMirror = (
			^nil
		)
		public Deserializer = (
			^nil
		)
		public ObjectMirror = (
			^nil
		)
		public Serializer = (
			^nil
		)
	) : ()
) : ()
