Newspeak3
'Eurasia'
class EurasiaDeployProbe packageUsing: manifest = (
	(* A command-line application that deploys itself from what is running (EURASIA_BUILD_AND_DEPLOY_DESIGN_2026-11-21.md, section 4.2): with the arguments deploy <file>, it writes a genesis image of itself (platform mirrors genesisImageOfApplicationReplacing:keepingSources:), which genesis turns into a base image like the one it runs from; with none, it says so and counts its runs, to show the copy starts afresh. eurasia/scripts/reflection-tests.sh runs it. *)
	
	|
		runs ::= 0.
	|
) (
	public main: platform args: args = (
		| bytes |
		runs:: runs + 1.
		(args size = 2 and: [ (args at: 1) = 'deploy' ]) ifTrue: [
				bytes:: platform mirrors genesisImageOfApplicationReplacing: {}
					keepingSources: true.
				writeBytes: bytes toFileNamed: (args at: 2).
				^('deployed ' , bytes size printString , ' bytes') out
			].
		('running, run ' , runs printString) out
	)
	writeBytes: bytes toFileNamed: filename = (
		(* Eurasia: a native (VmWriteFile), by the natives table. *)
		
		halt
	)
) : ()
