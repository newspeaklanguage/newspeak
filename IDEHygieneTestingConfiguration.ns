Newspeak3
'Root'
class IDEHygieneTestingConfiguration packageTestsUsing: manifest = Object new (
	(* Test configuration for IDE-wide hygiene checks (IDEHygieneTesting). *)
	
	|
		private IDEHygieneTesting = manifest IDEHygieneTesting.
		private manifestNamespace = manifest asMap.
	|
) (
	public testModulesUsingPlatform: platform <Platform> minitest: minitest <Minitest> = (
		^{IDEHygieneTesting usingPlatform: platform
			namespace: manifestNamespace
			minitest: minitest. }
	)
) : ()