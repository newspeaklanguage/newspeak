;; Base runtime data. The complete source/PEG program image is still pending;
;; runtimeProgram is explicitly its operational projection, not a new P.

syntax parameterid = PID nat
syntax localslotid = LSID nat
syntax slotid = SID nat
syntax physicalslot = PHYSICALSLOT classid slotid
syntax nestedcacheid = NESTEDCACHE classid classdecl
var pslot : physicalslot
var ncache : nestedcacheid
syntax localthunkkey = LOCALTHUNKKEY actdecl localslotid
syntax continuation = NOCONT | CONT actid
syntax provenance = TOPPROVENANCE | methodid | closureid | INITIALIZERPROVENANCE actdecl

;; @equation eq:class-origin
syntax classorigin = EXPRESSIONORIGIN classbodydecl | ACTORORIGIN classbodydecl
;; @equation eq:atom-payload
syntax atompayload =
  | INTEGERATOM int | FIXEDATOM rat | BOOLEANATOM bool
  | NILATOM | STRINGATOM text | SYMBOLATOM text

;; Forward declarations permit genuinely recursive bodies and closures.
syntax coreexpr
syntax corepattern
syntax statement
syntax localdecl
syntax localgroup
syntax slotdecl
syntax slotgroup
syntax bodydescriptor
syntax applicationdescriptor
syntax literaldescriptor
syntax messagetemplate

;; @partial eq:core-expressions
;; D0 on implicit/pattern nodes makes the judgment's static context explicit.
;; It is DECLFOUND D0 in class code and NODECL at top level. Super has no D0.
syntax coreexpr =
  | VALUE objref | SELF | ATOM atompayload | TUPLE coreexpr*
  | PATTERN corepattern scopeoption decloption
  | OBJECTLITERAL literaldescriptor coreexpr
  | CLOSURELITERAL actdecl parameterid* localgroup* statement*
  | SEND coreexpr selector coreexpr*
  | IMPLICITSEND selector coreexpr* scopeoption decloption
  | SELFSEND selector coreexpr* classdecl
  | OUTERSEND selector coreexpr* classdecl classdecl
  | SUPERSEND selector coreexpr*
  | ASYNCSEND coreexpr selector coreexpr*
  | CLASSBODY bodydescriptor coreexpr
  | MIXINAPPLY applicationdescriptor coreexpr coreexpr
  | CASCADE coreexpr messagetemplate*
  | READLOCAL actid localslotid | WRITELOCAL actid localslotid coreexpr
  | READSLOT objectid physicalslot | WRITESLOT objectid physicalslot coreexpr
  | CURRENTREAD slotid | CURRENTWRITE slotid coreexpr
  | LAZYREAD slotid coreexpr | NESTEDCLASS classdecl coreexpr
  | NEWINSTANCECURRENT selector coreexpr*

syntax corepattern =
  | WILDCARDPATTERN | LITERALPATTERN coreexpr | VARIABLEPATTERN siteid
  | NESTEDPATTERN corepattern | KEYWORDPATTERN (selector, corepattern)*
syntax statement = EXPRSTMT coreexpr | RETURNSTMT coreexpr

;; @equation eq:local-declaration
syntax localdecl =
  | LOCALIMMUTABLE localslotid coreexpr
  | LOCALMUTABLE localslotid coreexpr
  | LOCALUNINITIALIZED localslotid
  | LOCALLAZYIMMUTABLE localslotid coreexpr
  | LOCALLAZYMUTABLE localslotid coreexpr
;; @equation eq:local-declaration-sequence
syntax localgroup = LOCALSEQUENTIAL localdecl | LOCALSIMULTANEOUS localdecl*

;; @equation eq:slot-group
syntax slotdecl =
  | SLOTIMMUTABLE slotid coreexpr actdecl
  | SLOTMUTABLE slotid coreexpr actdecl
  | SLOTUNINITIALIZED slotid
syntax slotgroup = SLOTSEQUENTIAL slotdecl* | SLOTSIMULTANEOUS slotdecl*
;; Physical declaration metadata retains lazy backing slots too; initializer
;; groups contain only eager/uninitialized declarations, as in the LaTeX.
syntax physicaldecl =
  | PHYSICALIMMUTABLE slotid access coreexpr
  | PHYSICALMUTABLE slotid access coreexpr
  | PHYSICALUNINITIALIZED slotid access
  | PHYSICALLAZYIMMUTABLE slotid access coreexpr
  | PHYSICALLAZYMUTABLE slotid access coreexpr

;; @equation eq:method-definition
syntax fullmethod = {
  ID methodid, SELECTOR selector, ACCESS access,
  FORMALS parameterid*, LOCALS localgroup*, BODY statement*, OWNER classbodydecl
}
;; @equation eq:mixin-initializer
syntax initializer = {
  ID methodid, SELECTOR selector, FORMALS parameterid*, GROUPS slotgroup*, BODY statement*
}
;; @equation eq:mixin-record
syntax runtimemixin = {
  DECL classbodydecl, METHODS (selector, fullmethod)*,
  SLOTS physicaldecl*, NESTED classdecl*, INITIALIZER initializer
}
;; @equation eq:message-template-domain
syntax messagetemplate = TEMPLATE selector coreexpr*
syntax superclassannotation = IMPLICITSUPERCLASS | EXPLICITSUPERCLASS
;; @equation eq:body-descriptor
syntax bodydescriptor = {
  DECL classdecl, NAME text, SUPERKIND superclassannotation,
  SELECTOR selector, FORMALS parameterid*, MIXIN mixinid, CLASSMIXIN mixinid,
  SUPERMESSAGE messagetemplate
}
;; @equation eq:application-descriptor
syntax applicationdescriptor = {
  DECL classdecl, NAME text, SELECTOR selector, FORMALS parameterid*,
  CLASSMIXIN mixinid, INITIALIZERID methodid,
  SUPERMESSAGE messagetemplate, MIXINMESSAGE messagetemplate
}
;; @equation eq:object-literal-descriptor
syntax literaldescriptor = {
  DECL literaldecl, SUPERKIND superclassannotation,
  MIXIN mixinid, CLASSMIXIN mixinid, SUPERMESSAGE messagetemplate
}
;; @equation eq:factory-descriptor
syntax factoryplan =
  | BODYINITIALIZER messagetemplate
  | APPLIEDINITIALIZER messagetemplate messagetemplate
syntax factorydescriptor = {
  ID methodid, SELECTOR selector, FORMALS parameterid*, PLAN factoryplan
}
syntax factoryoption = NOFACTORY | FACTORY factorydescriptor
syntax classowner = ACTIVATIONOWNER | CLASSOWNER | LITERALOWNER | TOPOWNER

;; @partial eq:program-definition
;; SOURCE/UNIT/source BODY AST/actor seeds/pattern-variable AST remain in the
;; source-program image to be transcribed with the front end. No opaque AST
;; stand-in is introduced here. All method bodies below are actual core code.
syntax runtimeProgram = {
  MIXINS (mixinid, runtimemixin)*,
  DECLMIXINS (classbodydecl, mixinid)*,
  LEXPARENTS (classdecl, classdecl)*,
  ACTIVATIONMEMBERS (actdecl, selector*)*,
  SCOPECHAINS (siteid, scopedecl*)*,
  OWNERS (classbodydecl, classowner)*,
  ATOMS (atompayload, objref)*, PLATFORM (text, objref)*,
  ;; Derived elaboration annotations, not hardwired PastFuture platform access.
  FUTUREEXPRESSIONS (actdecl, coreexpr)*,
  LOCALTHUNKS (localthunkkey, actdecl)*
}

syntax localcell = UNINITCELL | LOCALVALUE objref
;; @equation eq:heap-records
syntax objectrecord = {
  CLASS classid, SLOTS (physicalslot, objref)*, NESTED (nestedcacheid, classid)*
}
;; @equation eq:heap-records
syntax classrecord = {
  MIXIN mixinid, SUPER classid, ENCLOSING objref, METACLASS classid,
  FACTORY factoryoption, ORIGIN classorigin
}
;; @equation eq:heap-records
;; NOCLASS/NOCONT represent the nil class/home of a top activation too.
syntax activationrecord = {
  PROVENANCE provenance, PARAMETERS (parameterid, objref)*,
  LOCALS (localslotid, localcell)*, RECEIVER objref, CURRENT classresult,
  CONTINUATION continuation, HOME continuation, CONTINUABLE bool,
  SCOPES (scopedecl, objref)*
}
;; @equation eq:heap-records
syntax closurerecord = {
  DECL actdecl, FORMALS parameterid*, LOCALS localgroup*, BODY statement*,
  DEFINING actid, RECEIVER objref, CURRENT classresult, HOME continuation
}
;; Message mirrors are the allocation-bearing DNU payload. Authority-bearing
;; mirror records and their VM/rights protocol are added in the reflection layer.
syntax messagemirror = { CLASS classid, MESSAGE message }
syntax runtimeHeap = {
  OBJECTS (objectid, objectrecord)*, CLASSES (classid, classrecord)*,
  ACTIVATIONS (actid, activationrecord)*, CLOSURES (closureid, closurerecord)*,
  MIRRORS (mirrorid, messagemirror)*,
  MIXINOBJECTS (mixinid, classid)*, ACTOROBJECTS (actorid, classid)*
}

var RP : runtimeProgram
var RH : runtimeHeap
var mf : fullmethod
var rm : runtimemixin
var rc : classrecord
var ra : activationrecord
var ro : objectrecord
var rb : closurerecord
var mm : messagemirror
var c : closureid
var g : mirrorid
var oid : objectid
var param : parameterid
var j : localslotid
var slot : slotid
var e : coreexpr
var st : statement
var ld : localdecl
var lg : localgroup
var kont : continuation
var mfMap : (selector, fullmethod)*

;; Finite-map update replaces, rather than duplicates, an existing key.
def $mapPut(syntax X, syntax Y, (X, Y)*, X, Y) : (X, Y)*
def $mapPut(syntax X, syntax Y, eps, x, y) = (x, y)
def $mapPut(syntax X, syntax Y, (x, y) (x', y')*, x_0, y_0) = (x_0, y_0) (x', y')*
  -- if x = x_0
def $mapPut(syntax X, syntax Y, (x, y) (x', y')*, x_0, y_0) =
  (x, y) $mapPut(X, Y, (x', y')*, x_0, y_0)
  -- if x =/= x_0

def $platformValue(runtimeProgram, text) : objref
def $platformValue(RP, text) = $require(objref, $mapGet(text, objref, RP.PLATFORM, text))
def $classReferenceValue(objref) : classid
def $classReferenceValue(CLASSREF C) = C
def $platformClass(runtimeProgram, text) : classid
def $platformClass(RP, text) = $classReferenceValue($platformValue(RP, text))
def $nilValue(runtimeProgram) : objref
def $nilValue(RP) = $require(objref, $mapGet(atompayload, objref, RP.ATOMS, NILATOM))

def $runtimeMixinAt(runtimeProgram, mixinid) : runtimemixin
def $runtimeMixinAt(RP, M) = $require(runtimemixin, $mapGet(mixinid, runtimemixin, RP.MIXINS, M))
def $runtimeClassAt(runtimeHeap, classid) : classrecord
def $runtimeClassAt(RH, C) = $require(classrecord, $mapGet(classid, classrecord, RH.CLASSES, C))
def $runtimeActivationAt(runtimeHeap, actid) : activationrecord
def $runtimeActivationAt(RH, a) = $require(activationrecord, $mapGet(actid, activationrecord, RH.ACTIVATIONS, a))
def $runtimeClosureAt(runtimeHeap, closureid) : closurerecord
def $runtimeClosureAt(RH, c) = $require(closurerecord, $mapGet(closureid, closurerecord, RH.CLOSURES, c))
def $runtimeObjectAt(runtimeHeap, objectid) : objectrecord
def $runtimeObjectAt(RH, oid) = $require(objectrecord, $mapGet(objectid, objectrecord, RH.OBJECTS, oid))

;; @equation eq:method-projections
def $projectMethod(fullmethod) : methodview
def $projectMethod(mf) = { ID mf.ID, SELECTOR mf.SELECTOR, ACCESS mf.ACCESS, OWNER mf.OWNER }
def $projectMethodMap((selector, fullmethod)*) : (selector, methodview)*
def $projectMethodMap(eps) = eps
def $projectMethodMap((s, mf) mfMap) = (s, $projectMethod(mf)) $projectMethodMap(mfMap)
def $projectMixin(runtimemixin) : mixinview
def $projectMixin(rm) = { DECL rm.DECL, METHODS $projectMethodMap(rm.METHODS) }
def $projectMixins((mixinid, runtimemixin)*) : (mixinid, mixinview)*
def $projectMixins((M, rm)*) = (M, $projectMixin(rm))*
def $projectClass(classrecord) : classview
def $projectClass(rc) = { MIXIN rc.MIXIN, SUPER rc.SUPER, ENCLOSING rc.ENCLOSING }
def $projectClasses((classid, classrecord)*) : (classid, classview)*
def $projectClasses((C, rc)*) = (C, $projectClass(rc))*

def $classResultValue(classresult) : classid
def $classResultValue(CLASSFOUND C) = C
def $projectActivationEntries((actid, activationrecord)*) : (actid, activationview)*
def $projectActivationEntries(eps) = eps
def $projectActivationEntries((a, ra) (a', ra')*) = $projectActivationEntries((a', ra')*)
  -- if ra.CURRENT = NOCLASS
def $projectActivationEntries((a, ra) (a', ra')*) =
  (a, { RECEIVER ra.RECEIVER, CURRENT $classResultValue(ra.CURRENT), SCOPES ra.SCOPES })
  $projectActivationEntries((a', ra')*)
  -- if ra.CURRENT =/= NOCLASS

;; TYPEOF is derived, never an independently mutable map. Platform classes
;; supply activation/closure representations; a class object's class is its
;; own fresh metaclass, not its superclass or the distinguished Class object.
def $runtimeTypes(runtimeProgram, runtimeHeap) : (objref, classid)*
def $runtimeTypes(RP, RH) =
  $objectTypes(RH.OBJECTS) $classTypes(RH.CLASSES)
  $activationTypes(RP, RH.ACTIVATIONS) $closureTypes(RP, RH.CLOSURES)
  $mirrorTypes(RH.MIRRORS) $mixinObjectTypes(RH.MIXINOBJECTS)
  $actorObjectTypes(RH.ACTOROBJECTS)

def $objectTypes((objectid, objectrecord)*) : (objref, classid)*
def $objectTypes((oid, ro)*) = (OBJECTREF oid, ro.CLASS)*
def $classTypes((classid, classrecord)*) : (objref, classid)*
def $classTypes((C, rc)*) = (CLASSREF C, rc.METACLASS)*
def $activationTypes(runtimeProgram, (actid, activationrecord)*) : (objref, classid)*
def $activationTypes(RP, (a, ra)*) = (ACTIVATIONREF a, $platformClass(RP, "Activation"))*
def $closureTypes(runtimeProgram, (closureid, closurerecord)*) : (objref, classid)*
def $closureTypes(RP, (c, rb)*) = (CLOSUREREF c, $platformClass(RP, "Closure"))*
def $mirrorTypes((mirrorid, messagemirror)*) : (objref, classid)*
def $mirrorTypes((g, mm)*) = (MIRRORREF g, mm.CLASS)*
def $mixinObjectTypes((mixinid, classid)*) : (objref, classid)*
def $mixinObjectTypes((M, C)*) = (MIXINREF M, C)*
def $actorObjectTypes((actorid, classid)*) : (objref, classid)*
def $actorObjectTypes((actorid, C)*) = (ACTORREF actorid, C)*

def $lookupProgramView(runtimeProgram) : lookupProgram
def $lookupProgramView(RP) = {
  TOP $platformClass(RP, "Top"), OBJECT $platformClass(RP, "Object"),
  MIXINS $projectMixins(RP.MIXINS), DECLMIXINS RP.DECLMIXINS,
  LEXPARENTS RP.LEXPARENTS, ACTIVATIONMEMBERS RP.ACTIVATIONMEMBERS,
  SCOPECHAINS RP.SCOPECHAINS
}
def $lookupHeapView(runtimeProgram, runtimeHeap) : lookupHeap
def $lookupHeapView(RP, RH) = {
  CLASSES $projectClasses(RH.CLASSES), TYPEOF $runtimeTypes(RP, RH),
  ACTIVATIONS $projectActivationEntries(RH.ACTIVATIONS)
}

;; Recover the FULL method in this P epoch, and verify its selected view.
;; The later machine control carries mf, not just its ID or a body lookup.
def $checkedSelectedMethod(methodview, fullmethod) : fullmethod
def $checkedSelectedMethod(f, mf) = mf -- if $projectMethod(mf) = f
def $recoverMethod(runtimeProgram, runtimeHeap, methodview, classid) : fullmethod
def $recoverMethod(RP, RH, f, C) = $checkedSelectedMethod(f,
  $require(fullmethod, $mapGet(selector, fullmethod,
    $runtimeMixinAt(RP, $runtimeClassAt(RH, C).MIXIN).METHODS, f.SELECTOR)))

def $runtimeLive(runtimeHeap, objref) : bool
def $runtimeLive(RH, OBJECTREF oid) = $mapGet(objectid, objectrecord, RH.OBJECTS, oid) =/= eps
def $runtimeLive(RH, CLASSREF C) = $mapGet(classid, classrecord, RH.CLASSES, C) =/= eps
def $runtimeLive(RH, ACTIVATIONREF a) = $mapGet(actid, activationrecord, RH.ACTIVATIONS, a) =/= eps
def $runtimeLive(RH, CLOSUREREF c) = $mapGet(closureid, closurerecord, RH.CLOSURES, c) =/= eps
def $runtimeLive(RH, MIRRORREF g) = $mapGet(mirrorid, messagemirror, RH.MIRRORS, g) =/= eps
def $runtimeLive(RH, MIXINREF M) = $mapGet(mixinid, classid, RH.MIXINOBJECTS, M) =/= eps
def $runtimeLive(RH, ACTORREF actorid) = $mapGet(actorid, classid, RH.ACTOROBJECTS, actorid) =/= eps
