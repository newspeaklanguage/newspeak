Newspeak3
'Emmanuel'
class Emmanuel usingPlatform: p = (
	(* The reference implementation of the Emmanuel core: lexing, the
structural parse and resolution, interpretation, and printing, transcribed
from the formal specification (formal-semantics/emmanuel/emmanuel-semantics.tex,
Sections 2 to 5, and its SpecTec transcription in formal-semantics/emmanuel/spectec).

Every layer processes a whole source and caches nothing: this module is the
oracle that the incremental implementation is checked against, so it follows
the structure of the specification rather than aiming for speed.

A character is a Unicode scalar value. Sources arrive as Strings, which in
this system are UTF-8 bytes, and are decoded to Arrays of code points at the
edges (codePointsOf: and stringOfCodePoints:); spans count code points.

The parameters of the specification are objects:
- the host (parse:, eval:hostState:, print:source:) parses brackets,
  evaluates arguments, and prints statements;
- the block signature is the protocol of DocumentBlock, whose subclasses are
  the kinds of block.

Every datum can print itself as a SpecTec term (printTermOn:), which is how
the conformance tests compare results with the specification's regressions,
and how canonical forms are compared. *)
	
	|
		private List = p collections List.
		private StringBuilder = p kernel StringBuilder.
	|
) (
	public class BlockNode contents: u contentSpan: cs statements: ss span: s = (
		(* A node with a bracket: its text, the span of that text, the statements
of its bracket, and the span of the whole node. *)
		
		|
			public contents = u.
			public contentSpan = cs.
			public statements = ss.
			public span = s.
		|
	) (
		public isKindOfBlockNode = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'BLOCK';
				chars: contents;
				term: contentSpan;
				list: statements;
				term: span;
				close
		)
	) : ()
	public class BlockRecord state: k = (
		(* A record of the block store: the block's state, its children, the
messages it received, and whether it was rejected. Mutable; the reference
machine updates records in place. *)
		
		|
			public state ::= k.
			public kids = List new.
			public messages = List new.
			public rejected ::= false.
		|
	) (
	) : ()
	public class Child kind: k chars: u span: s statement: st ref: r = (
		(* A child of a block. Kinds: #run, #stray (text with a span), #note
(a comment's span), #mut, #dnu, #rootPop, #refused (a statement), #blk (in
the store, a block index from 0), and #sub (in a tree, a subtree). *)
		
		|
			public kind = k.
			public chars = u.
			public span = s.
			public statement = st.
			public ref = r.
		|
	) (
		public isKindOfChild = (
			^true
		)
		public isRun = (
			^kind = #run
		)
		public printTermOn: t = (
			t open.
			kind = #run ifTrue: [
					t atom: 'RUN';
						chars: chars;
						term: span
				].
			kind = #stray ifTrue: [
					t atom: 'STRAY';
						chars: chars;
						term: span
				].
			kind = #note ifTrue: [
					t atom: 'NOTE';
						term: span
				].
			kind = #mut ifTrue: [
					t atom: 'MUT';
						term: statement
				].
			kind = #dnu ifTrue: [
					t atom: 'DNU';
						term: statement
				].
			kind = #rootPop ifTrue: [
					t atom: 'ROOTPOP';
						term: statement
				].
			kind = #refused ifTrue: [
					t atom: 'REFUSED';
						term: statement
				].
			kind = #blk ifTrue: [
					t atom: 'BLK';
						nat: ref
				].
			kind = #sub ifTrue: [
					t atom: 'SUB';
						term: ref
				].
			t close
		)
	) : ()
	public class CommentStatement span: s = (
		(* A comment that is a statement of its own. *)
		
		|
			public span = s.
		|
	) (
		public erased = (
			^CommentStatement span: zeroSpan
		)
		public isComment = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'COMMENT';
				term: span;
				close
		)
	) : ()
	public class DocumentBlock new = (
		(* The state of a block, and its part of the block signature. Each kind
of block is a subclass. A state is a value: a message that changes it
answers a MUTATE effect with a new state, never updating this one.

The signature has two parts. contentClass answers #flow, #para, #cell, or
#inline. effectOf:args:hostState:machine: answers what receiving a message
does to the block: an Effect, or a Raised when the block raises. The machine
argument lets a block interpret a markup literal it receives (as a title
does), by sending it interpretLiteral:root:hostState:.

stateName and stateValues give the state as the specification writes it,
STATE name (values), for printing and canonical comparison.

The block side of the field interface of Section 7: fields: answers the
fields a block displays (Fields), given the messages it received; joins,
whether two adjacent blocks of its kind join when the text between them is
deleted; splitsAtEnter, whether Enter splits it. By default a block has no
fields and neither joins nor splits. *)
		
	) (
		public contentClass = (
			^Error signal: 'DocumentBlock>>contentClass: a subclass responsibility'
		)
		public effectOf: selector args: values hostState: chi machine: m = (
			^Error signal: 'DocumentBlock>>effectOf:args:hostState:machine: a subclass responsibility'
		)
		public fields: messages = (
			^{}
		)
		public isKindOfDocumentBlock = (
			^true
		)
		public joins = (
			^false
		)
		public printTermOn: t = (
			t open;
				atom: 'STATE';
				string: stateName.
			stateValues do: [:v | printValue: v on: t ].
			stateValues isEmpty ifTrue: [ t atom: 'eps' ].
			t close
		)
		public splitsAtEnter = (
			^false
		)
		public stateName = (
			^Error signal: 'DocumentBlock>>stateName: a subclass responsibility'
		)
		public stateValues = (
			^{}
		)
	) : ()
	public class Done state: chi tree: tr = (
		(* An interpretation that finished, with the final host state. *)
		
		|
			public hostState = chi.
			public tree = tr.
		|
	) (
		public isKindOfDone = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'DONE';
				term: hostState;
				term: tree;
				close
		)
	) : ()
	public class Effect kind: k block: b hostState: chi = (
		(* What a message does to the block that receives it: #pop,
#popReject, #leaf, #push, #mutate (with the new block state), #refuse,
or #notUnderstood. *)
		
		|
			public kind = k.
			public block = b.
			public hostState = chi.
		|
	) (
		public isKindOfEffect = (
			^true
		)
	) : ()
	public class ErasedState name: x values: vs = (
		(* A block state with the spans in its values erased: the state of a
tree in canonical form. *)
		
		|
			public stateName = x.
			public stateValues = vs.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: 'STATE';
				string: stateName.
			stateValues do: [:v | printValue: v on: t ].
			stateValues isEmpty ifTrue: [ t atom: 'eps' ].
			t close
		)
	) : ()
	public class Evaluated state: chi value: v = (
		(* An argument the host evaluated. *)
		
		|
			public hostState = chi.
			public value = v.
		|
	) (
		public isKindOfEvaluated = (
			^true
		)
	) : ()
	public class Failure span: s = (
		(* A host syntax error, at a span. *)
		
		|
			public span = s.
		|
	) (
		public isKindOfFailure = (
			^true
		)
	) : ()
	public class Field value: v statement: s index: k = (
		(* A field a block displays (Section 7): its value, and the statement
and the index of the argument it came from. *)
		
		|
			public value = v.
			public statement = s.
			public index = k.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: 'FIELD'.
			printValue: value on: t.
			t term: statement;
				nat: index;
				close
		)
	) : ()
	public class FinalNode contents: u span: s = (
		(* The text after the last bracket. *)
		
		|
			public contents = u.
			public span = s.
		|
	) (
		public contentSpan = (
			^span
		)
		public isKindOfFinalNode = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'FINAL';
				chars: contents;
				term: span;
				close
		)
		public statements = (
			^{}
		)
	) : ()
	public class HolePiece nodes: rs span: s = (
		(* A markup expression inside a bracket, not yet resolved. *)
		
		|
			public nodes = rs.
			public span = s.
		|
	) (
		public isHole = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'HOLE';
				list: nodes;
				term: span;
				close
		)
	) : ()
	public class HostHole literal: l = (
		(* A resolved markup literal, as the host parser receives it. *)
		
		|
			public literal = l.
		|
	) (
		public isHole = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'HHOLE';
				term: literal;
				close
		)
	) : ()
	public class HostSource chars: w span: s = (
		(* Code, as the host parser receives it. *)
		
		|
			public chars = w.
			public span = s.
		|
	) (
		public isHole = (
			^false
		)
		public printTermOn: t = (
			t open;
				atom: 'HSRC';
				chars: chars;
				term: span;
				close
		)
	) : ()
	public class Item text: u span: s statement: st = (
		(* An item of the machine: a text (with its span), or a statement. *)
		
		|
			public text = u.
			public span = s.
			public statement = st.
		|
	) (
		public isText = (
			^statement isNil
		)
		public printTermOn: t = (
			statement isNil ifTrue: [
					^t open;
						atom: 'ITEXT';
						chars: text;
						term: span;
						close
				].
			t open;
				atom: 'ISTMT';
				term: statement;
				close
		)
	) : ()
	public class Lexed located: ls = (
		(* A successful lexing: the located lexemes. *)
		
		|
			public located = ls.
		|
	) (
		public isKindOfLexed = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'LEXED'.
			located do: [:l | t term: l ].
			located isEmpty ifTrue: [ t atom: 'eps' ].
			t close
		)
	) : ()
	public class Lexeme kind: k chars: cs = (
		(* A lexeme: #char (one character), #code (characters of code),
#openMessages, #closeMessages, #openMarkup, or #closeMarkup. *)
		
		|
			public kind = k.
			public chars = cs.
		|
	) (
		public printTermOn: t = (
			kind = #char ifTrue: [
					^t open;
						atom: 'CHAR';
						char: (chars at: 1);
						close
				].
			kind = #code ifTrue: [
					^t open;
						atom: 'CODE';
						chars: chars;
						close
				].
			t atom: (bracketAtom: kind)
		)
	) : ()
	public class LexError kind: k at: i = (
		(* A lexical error, #strayClose, #unclosedLiteral, or
#unclosedBracket, at a position. *)
		
		|
			public kind = k.
			public position = i.
		|
	) (
		public isKindOfLexError = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'LEXERROR';
				atom: (lexErrorAtom: kind);
				nat: position;
				close
		)
	) : ()
	public class LexFail error: e = (
		(* A parse that failed in the lexer. *)
		
		|
			public error = e.
		|
	) (
		public isKindOfLexFail = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'LEXFAIL';
				atom: (lexErrorAtom: error kind);
				nat: error position;
				close
		)
	) : ()
	public class LexStepResult lexeme: l modes: ms next: k = (
		(* One lexing step: the lexeme, the new mode stack, and the index of the
next character. *)
		
		|
			public lexeme = l.
			public modes = ms.
			public next = k.
		|
	) (
	) : ()
	public class Located lexeme: l span: s = (
		(* A lexeme with its span. *)
		
		|
			public lexeme = l.
			public span = s.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: 'LOC';
				term: lexeme;
				term: span;
				close
		)
	) : ()
	public class Machine host: h = (
		(* The interpretation machine of Section 4: a store of block records, a
stack of indices of the open ones (the top last), and the items left. *)
		
		|
			public host = h.
		|
	) (
		addKid: kid to: record = (
			record kids add: kid
		)
		close: record in: store = (
			(* close(Sigma, beta): a para block, or a cell with no block child,
is trimmed; a cell with a block child loses its white-space runs, and is
rejected if text or an inline child remains. *)
			
			| q = record state contentClass. hasBlock |
			hasBlock:: record kids anySatisfy: [:g | isBlockKid: g in: store ].
			(q = #para or: [ q = #cell and: [ hasBlock not ] ]) ifTrue: [
					^replaceKids: record with: (trim: record kids asArray)
				].
			(q = #cell and: [ hasBlock ]) ifTrue: [
					| kept = record kids asArray reject: [:g | isSpaceRun: g ]. |
					replaceKids: record with: kept.
					(kept anySatisfy: [:g | g isRun or: [ isInlineKid: g in: store ] ]) ifTrue: [
							record rejected: true
						]
				]
		)
		evaluate: args hostState: chi = (
			(* Args: evaluate the arguments left to right, threading the host
state. Answers an Evaluated whose value is the Array of values, or the
Raised of the first argument that raises. *)
			
			| state ::= chi. values = List new. |
			args do: [:eta |
					| outcome = host eval: eta hostState: state. |
					outcome isKindOfRaised ifTrue: [ ^outcome ].
					state:: outcome hostState.
					values add: outcome value
				].
			^Evaluated state: state value: values asArray
		)
		public interpret: nodes root: block hostState: chi = (
			(* Interp: interpret the items of the nodes with a root of the given
state. Answers a Done or a Raised. *)
			
			^run: (itemsOf: nodes) root: block hostState: chi
		)
		public interpretLiteral: literal root: block hostState: chi = (
			(* InterpretWith: interpret a markup literal with the given root. *)
			
			^interpret: literal nodes root: block hostState: chi
		)
		isBlockKid: g in: store = (
			^g kind = #blk and: [
					((store at: g ref + 1) state contentClass = #inline) not
				]
		)
		isInlineKid: g in: store = (
			^g kind = #blk and: [ (store at: g ref + 1) state contentClass = #inline ]
		)
		isSpaceRun: g = (
			^g isRun and: [ (lstrip: g chars) isEmpty ]
		)
		replaceKids: record with: kids = (
			record kids removeAll.
			record kids addAll: kids
		)
		run: items root: block hostState: chi = (
			| store = List new. stack = List new. state ::= chi. outcome |
			store add: (BlockRecord state: block).
			stack add: 0.
			items do: [:item |
					outcome:: step: item store: store stack: stack hostState: state.
					outcome isKindOfRaised ifTrue: [ ^outcome ].
					state:: outcome
				].
			^Done state: state
				tree: (treeOf: 0
					store: store
					open: (stack asArray copyFrom: 2 to: stack size))
		)
		send: sigma store: store stack: stack hostState: chi = (
			| top = stack last. record = store at: top + 1. args outcome effect kind |
			args:: evaluate: sigma arguments hostState: chi.
			args isKindOfRaised ifTrue: [ ^args ].
			outcome:: record state effectOf: sigma selector
				args: args value
				hostState: args hostState
				machine: self.
			outcome isKindOfRaised ifTrue: [ ^outcome ].
			effect:: outcome.
			kind:: effect kind.
			(kind = #pop or: [ kind = #popReject ]) ifTrue: [
					stack size = 1 ifTrue: [
							addKid: (Child kind: #rootPop
									chars: nil
									span: nil
									statement: sigma
									ref: nil)
								to: record.
							^effect hostState
						].
					record messages add: sigma.
					close: record in: store.
					kind = #popReject ifTrue: [ record rejected: true ].
					stack removeLast.
					^effect hostState
				].
			(kind = #leaf or: [ kind = #push ]) ifTrue: [
					| child = BlockRecord state: effect block. index = store size. |
					child messages add: sigma.
					store add: child.
					addKid: (Child kind: #blk chars: nil span: nil statement: nil ref: index)
						to: record.
					kind = #push ifTrue: [ stack add: index ].
					^effect hostState
				].
			kind = #mutate ifTrue: [
					record state: effect block.
					record messages add: sigma.
					addKid: (Child kind: #mut chars: nil span: nil statement: sigma ref: nil)
						to: record.
					^effect hostState
				].
			kind = #notUnderstood ifTrue: [
					addKid: (Child kind: #dnu chars: nil span: nil statement: sigma ref: nil)
						to: record.
					^effect hostState
				].
			kind = #refuse ifTrue: [
					addKid: (Child kind: #refused
							chars: nil
							span: nil
							statement: sigma
							ref: nil)
						to: record.
					^effect hostState
				].
			^Error signal: 'unknown effect ' , kind
		)
		step: item store: store stack: stack hostState: chi = (
			(* One step: answers the new host state, or a Raised. *)
			
			| record = store at: stack last + 1. kid |
			item isText ifTrue: [
					kid:: child: record state contentClass chars: item text span: item span.
					kid isNil ifFalse: [ addKid: kid to: record ].
					^chi
				].
			item statement isComment ifTrue: [
					addKid: (Child kind: #note
							chars: nil
							span: item statement span
							statement: nil
							ref: nil)
						to: record.
					^chi
				].
			^send: item statement store: store stack: stack hostState: chi
		)
		treeOf: index store: store open: open = (
			| record = store at: index + 1. flag items |
			flag:: (open includes: index) ifTrue: [ #unclosed ]
				ifFalse: [ record rejected ifTrue: [ #rejected ] ifFalse: [ #closed ] ].
			items:: record kids asArray collect: [:g |
					g kind = #blk ifTrue: [
							Child kind: #sub
								chars: nil
								span: nil
								statement: nil
								ref: (treeOf: g ref store: store open: open)
						]
						ifFalse: [ g ]
				].
			^Tree state: record state
				items: items
				messages: record messages asArray
				flag: flag
		)
	) : ()
	public class MarkupError kind: k data: d = (
		(* An error of a tree: #unclosedBlock and #rejectedBlock (with the
block's messages), or #errorLeaf (with the child). *)
		
		|
			public kind = k.
			public data = d.
		|
	) (
		public printTermOn: t = (
			t open.
			kind = #unclosedBlock ifTrue: [
					t atom: 'UNCLOSEDBLOCK';
						list: data
				].
			kind = #rejectedBlock ifTrue: [
					t atom: 'REJECTEDBLOCK';
						list: data
				].
			kind = #errorLeaf ifTrue: [
					t atom: 'ERRORLEAF';
						term: data
				].
			t close
		)
	) : ()
	public class MarkupLiteral source: x nodes: ns span: s = (
		(* A markup literal: the name of the source it is in, its nodes, and its
span, which includes its brackets. As an argument it evaluates to itself. *)
		
		|
			public sourceName = x.
			public nodes = ns.
			public span = s.
		|
	) (
		public erased = (
			^MarkupLiteral source: sourceName
				nodes: (nodes collect: [:n | eraseNode: n ])
				span: zeroSpan
		)
		public isKindOfMarkupLiteral = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'MARKUP';
				string: sourceName;
				list: nodes;
				term: span;
				close
		)
	) : ()
	public class Parsed nodes: ns = (
		(* A successful parse: the nodes of the document. *)
		
		|
			public nodes = ns.
		|
	) (
		public isKindOfParsed = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'PARSED';
				list: nodes;
				close
		)
	) : ()
	public class ParseFailure span: s = (
		(* A parse that failed with a host syntax error. *)
		
		|
			public span = s.
		|
	) (
		public isKindOfSyntaxError = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'SYNTAXERROR';
				term: span;
				close
		)
	) : ()
	public class PrintedCode chars: u = (
		(* What the host printer gives: code. *)
		
		|
			public chars = u.
		|
	) (
		public isLiteral = (
			^false
		)
	) : ()
	public class PrintedLiteral literal: l = (
		(* What the host printer gives: a markup literal, for the core to
print. *)
		
		|
			public literal = l.
		|
	) (
		public isLiteral = (
			^true
		)
	) : ()
	public class Raised state: chi exception: x = (
		(* A raise, from the host evaluator, an effect, or an interpretation. *)
		
		|
			public hostState = chi.
			public exception = x.
		|
	) (
		public isKindOfRaised = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'RAISED';
				term: hostState;
				term: exception;
				close
		)
	) : ()
	public class RawBlock contents: u contentSpan: cs pieces: ps span: s = (
		(* A node of the structural parse, whose bracket is not yet parsed. *)
		
		|
			public contents = u.
			public contentSpan = cs.
			public pieces = ps.
			public span = s.
		|
	) (
		public isRawFinal = (
			^false
		)
		public printTermOn: t = (
			t open;
				atom: 'RBLOCK';
				chars: contents;
				term: contentSpan;
				list: pieces;
				term: span;
				close
		)
	) : ()
	public class RawFinal contents: u span: s = (
		(* The final text of the structural parse. *)
		
		|
			public contents = u.
			public span = s.
		|
	) (
		public isRawFinal = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'RFINAL';
				chars: contents;
				term: span;
				close
		)
	) : ()
	public class SendStatement comments: cs selector: x arguments: es span: s = (
		(* A message send: the spans of its comments, its selector, its
arguments (host expressions), and its span. *)
		
		|
			public comments = cs.
			public selector = x.
			public arguments = es.
			public span = s.
		|
	) (
		public erased = (
			^SendStatement comments: (comments collect: [:c | zeroSpan ])
				selector: selector
				arguments: (arguments collect: [:e | e erased ])
				span: zeroSpan
		)
		public isComment = (
			^false
		)
		public printTermOn: t = (
			t open;
				atom: 'SEND';
				list: comments;
				string: selector;
				list: arguments;
				term: span;
				close
		)
	) : ()
	public class SourcePiece chars: w span: s = (
		(* Code inside a bracket, not yet parsed. *)
		
		|
			public chars = w.
			public span = s.
		|
	) (
		public isHole = (
			^false
		)
		public printTermOn: t = (
			t open;
				atom: 'SRC';
				chars: chars;
				term: span;
				close
		)
	) : ()
	public class Span from: i to: j = (
		(* A half-open interval [i, j) of positions in a source, counted in
characters from 0. *)
		
		|
			public start = i.
			public end = j.
		|
	) (
		public = other = (
			^other isKindOfSpan and: [ start = other start and: [ end = other end ] ]
		)
		public hash = (
			^start hash bitXor: end hash
		)
		public isKindOfSpan = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'SPAN';
				nat: start;
				nat: end;
				close
		)
	) : ()
	public class TermWriter new = (
		(* Writes SpecTec terms, as a sequence of tokens: atoms, numbers, quoted
strings, and parentheses. A list is written as its elements in parentheses,
or (eps) when it is empty. *)
		
		|
			public tokens = List new.
		|
	) (
		public asString = (
			| b = StringBuilder new. |
			tokens do: [:x | b add: x ] separatedBy: [ b add: ' ' ].
			^b asString
		)
		public atom: x = (
			tokens add: x
		)
		public char: cp = (
			tokens add: (quoteCodePoint: cp)
		)
		public chars: cps = (
			open.
			cps isEmpty ifTrue: [ atom: 'eps' ].
			cps do: [:cp | char: cp ].
			close
		)
		public close = (
			tokens add: ')'
		)
		public list: xs = (
			open.
			xs isEmpty ifTrue: [ atom: 'eps' ].
			xs do: [:x | term: x ].
			close
		)
		public nat: n = (
			tokens add: n printString
		)
		public open = (
			tokens add: '('
		)
		public string: s = (
			tokens add: '"' , s , '"'
		)
		public term: x = (
			x printTermOn: self
		)
	) : ()
	public class Token kind: k chars: cs span: s = (
		(* A token: #text and #code (with their characters), or one of the four
brackets, with its span. *)
		
		|
			public kind = k.
			public chars = cs.
			public span = s.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: 'TOK'.
			kind = #text ifTrue: [
					t open;
						atom: 'TEXT';
						chars: chars;
						close
				]
				ifFalse: [
					kind = #code ifTrue: [
							t open;
								atom: 'CODE';
								chars: chars;
								close
						]
						ifFalse: [ t atom: (bracketAtom: kind) ]
				].
			t term: span;
				close
		)
	) : ()
	public class Tree state: k items: gs messages: ms flag: f = (
		(* A finished block: its state, its children, the messages it received,
and #closed, #unclosed, or #rejected. *)
		
		|
			public state = k.
			public items = gs.
			public messages = ms.
			public flag = f.
		|
	) (
		public isKindOfTree = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'TREE';
				term: state;
				list: items;
				list: messages;
				atom: (flagAtom: flag);
				close
		)
	) : ()
	public class TreeValue literal: l tree: tr = (
		(* A value that is a markup literal together with the tree it was
interpreted to. *)
		
		|
			public literal = l.
			public tree = tr.
		|
	) (
		public isKindOfTreeValue = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'TREEV';
				term: literal;
				term: tree;
				close
		)
	) : ()
	backslash = (
		^92
	)
	backslashEscape = (
		^{92. 92. }
	)
	begins: w at: k with: prefix = (
		(* Whether w, from index k, begins with prefix. *)
		
		k + prefix size - 1 > w size ifTrue: [ ^false ].
		1 to: prefix size
			do: [:i | (w at: k + i - 1) = (prefix at: i) ifFalse: [ ^false ] ].
		^true
	)
	bracketAtom: kind = (
		kind = #openMessages ifTrue: [ ^'OPENMESSAGES' ].
		kind = #closeMessages ifTrue: [ ^'CLOSEMESSAGES' ].
		kind = #openMarkup ifTrue: [ ^'OPENMARKUP' ].
		kind = #closeMarkup ifTrue: [ ^'CLOSEMARKUP' ].
		^Error signal: 'not a bracket: ' , kind printString
	)
	bracketEscape = (
		^{92. 91. }
	)
	public canon: tree = (
		(* The canonical form of a tree: spans erased, adjacent runs and adjacent
strays merged. *)
		
		^Tree state: (eraseState: tree state)
			items: (mergeKids: (tree items collect: [:g | canonItem: g ]))
			messages: (tree messages collect: [:s | s erased ])
			flag: tree flag
	)
	canonItem: g = (
		g kind = #sub ifTrue: [
				^Child kind: #sub chars: nil span: nil statement: nil ref: (canon: g ref)
			].
		(g kind = #run or: [ g kind = #stray ]) ifTrue: [
				^Child kind: g kind chars: g chars span: zeroSpan statement: nil ref: nil
			].
		g kind = #note ifTrue: [
				^Child kind: #note chars: nil span: zeroSpan statement: nil ref: nil
			].
		^Child kind: g kind
			chars: nil
			span: nil
			statement: g statement erased
			ref: nil
	)
	public child: q chars: u span: s = (
		(* child(q, u, s): the child that the text u adds to a block of content
class q, or nil when it adds none. *)
		
		| c = collapse: u. |
		c isEmpty ifTrue: [ ^nil ].
		(c size = 1 and: [ (c at: 1) = 32 ]) ifTrue: [
				q = #flow ifTrue: [ ^nil ].
				^Child kind: #run chars: {32. } span: s statement: nil ref: nil
			].
		q = #flow ifTrue: [
				^Child kind: #stray chars: u span: s statement: nil ref: nil
			].
		^Child kind: #run chars: c span: s statement: nil ref: nil
	)
	closeSeq = (
		^{92. 93. }
	)
	public codePointsOf: string = (
		(* Decode a UTF-8 String to an Array of code points. *)
		
		| out = List new. i ::= 1. b n cp |
		[ i <= string size ] whileTrue: [
				b:: string at: i.
				b < 128 ifTrue: [
						cp:: b.
						n:: 0
					]
					ifFalse: [
						b < 224 ifTrue: [
								cp:: b bitAnd: 31.
								n:: 1
							]
							ifFalse: [
								b < 240 ifTrue: [
										cp:: b bitAnd: 15.
										n:: 2
									]
									ifFalse: [
										cp:: b bitAnd: 7.
										n:: 3
									]
							]
					].
				1 to: n do: [:k | cp:: cp << 6 bitOr: ((string at: i + k) bitAnd: 63) ].
				out add: cp.
				i:: i + n + 1
			].
		^out asArray
	)
	codeStep: modes chars: w at: k = (
		| e |
		(begins: w at: k with: openSeq) ifTrue: [
				^LexStepResult lexeme: (Lexeme kind: #openMarkup chars: {})
					modes: (modes copyWith: #text)
					next: k + 2
			].
		(begins: w at: k with: closeSeq) ifTrue: [
				(modes size >= 2 and: [ (modes at: modes size - 1) = #text ]) ifFalse: [
						^nil
					].
				^LexStepResult lexeme: (Lexeme kind: #closeMessages chars: {})
					modes: (modes copyFrom: 1 to: modes size - 1)
					next: k + 2
			].
		(w at: k) = 39 ifTrue: [
				e:: scanString: w from: k + 1.
				e isNil ifTrue: [ ^nil ].
				^LexStepResult lexeme: (Lexeme kind: #code chars: (w copyFrom: k to: e - 1))
					modes: modes
					next: e
			].
		(begins: w at: k with: commentOpen) ifTrue: [
				e:: scanComment: w from: k + 2 depth: 1.
				e isNil ifTrue: [ ^nil ].
				^LexStepResult lexeme: (Lexeme kind: #code chars: (w copyFrom: k to: e - 1))
					modes: modes
					next: e
			].
		^LexStepResult lexeme: (Lexeme kind: #code chars: {w at: k. })
			modes: modes
			next: k + 1
	)
	public collapse: u = (
		(* collapse(u): every maximal run of white space becomes one space. *)
		
		| out = List new. k ::= 1. |
		[ k <= u size ] whileTrue: [
				(isWS: (u at: k)) ifTrue: [
						out add: 32.
						[ k <= u size and: [ isWS: (u at: k) ] ] whileTrue: [ k:: k + 1 ]
					]
					ifFalse: [
						out add: (u at: k).
						k:: k + 1
					]
			].
		^out asArray
	)
	commentClose = (
		^{42. 41. }
	)
	commentOpen = (
		^{40. 42. }
	)
	public encodeCodePoint: cp on: out = (
		cp < 128 ifTrue: [ ^out add: cp ].
		cp < 2048 ifTrue: [
				out add: (192 bitOr: cp >> 6).
				^out add: (128 bitOr: (cp bitAnd: 63))
			].
		cp < 65536 ifTrue: [
				out add: (224 bitOr: cp >> 12).
				out add: (128 bitOr: (cp >> 6 bitAnd: 63)).
				^out add: (128 bitOr: (cp bitAnd: 63))
			].
		out add: (240 bitOr: cp >> 18).
		out add: (128 bitOr: (cp >> 12 bitAnd: 63)).
		out add: (128 bitOr: (cp >> 6 bitAnd: 63)).
		out add: (128 bitOr: (cp bitAnd: 63))
	)
	eraseNode: n = (
		n isKindOfFinalNode ifTrue: [ ^FinalNode contents: n contents span: zeroSpan ].
		^BlockNode contents: n contents
			contentSpan: zeroSpan
			statements: (n statements collect: [:s | s erased ])
			span: zeroSpan
	)
	eraseState: k = (
		^ErasedState name: k stateName
			values: (k stateValues collect: [:v | eraseValue: v ])
	)
	eraseValue: v = (
		v isKindOfMarkupLiteral ifTrue: [ ^v erased ].
		v isKindOfTreeValue ifTrue: [
				^TreeValue literal: v literal erased tree: (canon: v tree)
			].
		^v
	)
	public errors: tree = (
		(* errors(tree): the errors of a tree, in document order. *)
		
		| out = List new. |
		errorsOf: tree into: out.
		^out asArray
	)
	errorsOf: tree into: out = (
		tree flag = #unclosed ifTrue: [
				out add: (MarkupError kind: #unclosedBlock data: tree messages)
			].
		tree flag = #rejected ifTrue: [
				out add: (MarkupError kind: #rejectedBlock data: tree messages)
			].
		tree items do: [:g |
				g kind = #sub ifTrue: [ errorsOf: g ref into: out ]
					ifFalse: [
						({#dnu. #stray. #rootPop. #refused. } includes: g kind) ifTrue: [
								out add: (MarkupError kind: #errorLeaf data: g)
							]
					]
			]
	)
	public esc: u = (
		(* esc(u): escape every backslash and opening bracket. *)
		
		| out = List new. |
		u do: [:c |
				(c = 92 or: [ c = 91 ]) ifTrue: [ out add: 92 ].
				out add: c
			].
		^out asArray
	)
	public fastTokens: w = (
		(* tokens(lex(w)), computed directly, without the lexemes: the same
tokens as the reference (tokens: and lex:), which the tests check it
against. Answers nil where the reference does not answer tokens (a lexical
error, or a stuck lexer); parse: then asks the reference. *)
		
		| out = List new. run = List new. modes = List new. k ::= 1. runKind runStart e c |
		modes add: #text.
		[ k <= w size ] whileTrue: [
				c:: w at: k.
				(c ~= 91 and: [
						c ~= 92 and: [
								runKind == modes last and: [
										runKind == #text or: [ c ~= 39 and: [ c ~= 40 ] ]
									]
							]
					]) ifTrue: [
						run add: c.
						k:: k + 1
					]
					ifFalse: [
						modes last = #text ifTrue: [
								(begins: w at: k with: openSeq) ifTrue: [
										runKind:: flushRun: run kind: runKind from: runStart to: k - 1 on: out.
										out add: (Token kind: #openMessages
												chars: {}
												span: (Span from: k - 1 to: k + 1)).
										modes add: #code.
										k:: k + 2
									]
									ifFalse: [
										(begins: w at: k with: closeSeq) ifTrue: [
												(modes size >= 2 and: [ (modes at: modes size - 1) = #code ]) ifFalse: [
														^nil
													].
												runKind:: flushRun: run
													kind: runKind
													from: runStart
													to: k - 1
													on: out.
												out add: (Token kind: #closeMarkup
														chars: {}
														span: (Span from: k - 1 to: k + 1)).
												modes removeLast.
												k:: k + 2
											]
											ifFalse: [
												runKind = #text ifFalse: [
														runKind:: flushRun: run
															kind: runKind
															from: runStart
															to: k - 1
															on: out.
														runKind:: #text.
														runStart:: k - 1
													].
												((begins: w at: k with: backslashEscape) or: [
														begins: w at: k with: bracketEscape
													]) ifTrue: [
														run add: (w at: k + 1).
														k:: k + 2
													]
													ifFalse: [
														run add: (w at: k).
														k:: k + 1
													]
											]
									]
							]
							ifFalse: [
								(begins: w at: k with: openSeq) ifTrue: [
										runKind:: flushRun: run kind: runKind from: runStart to: k - 1 on: out.
										out add: (Token kind: #openMarkup
												chars: {}
												span: (Span from: k - 1 to: k + 1)).
										modes add: #text.
										k:: k + 2
									]
									ifFalse: [
										(begins: w at: k with: closeSeq) ifTrue: [
												(modes size >= 2 and: [ (modes at: modes size - 1) = #text ]) ifFalse: [
														^nil
													].
												runKind:: flushRun: run
													kind: runKind
													from: runStart
													to: k - 1
													on: out.
												out add: (Token kind: #closeMessages
														chars: {}
														span: (Span from: k - 1 to: k + 1)).
												modes removeLast.
												k:: k + 2
											]
											ifFalse: [
												runKind = #code ifFalse: [
														runKind:: flushRun: run
															kind: runKind
															from: runStart
															to: k - 1
															on: out.
														runKind:: #code.
														runStart:: k - 1
													].
												e:: k + 1.
												(w at: k) = 39 ifTrue: [ e:: scanString: w from: k + 1 ].
												(begins: w at: k with: commentOpen) ifTrue: [
														e:: scanComment: w from: k + 2 depth: 1
													].
												e isNil ifTrue: [ ^nil ].
												k to: e - 1 do: [:i | run add: (w at: i) ].
												k:: e
											]
									]
							]
					]
			].
		(modes size = 1 and: [ modes first = #text ]) ifFalse: [ ^nil ].
		flushRun: run kind: runKind from: runStart to: w size on: out.
		^out asArray
	)
	flagAtom: f = (
		f = #closed ifTrue: [ ^'CLOSED' ].
		f = #unclosed ifTrue: [ ^'UNCLOSED' ].
		^'REJECTED'
	)
	flushRun: run kind: kind from: start to: end on: out = (
		(* The token of the run of text or code being gathered, if any;
answers the new run's kind, none. *)
		
		kind isNil ifTrue: [ ^nil ].
		out add: (Token kind: kind chars: run asArray span: (Span from: start to: end)).
		run removeAll.
		^nil
	)
	public isModeStack: modes = (
		(* ModeStack: a nonempty stack whose bottom is text mode. *)
		
		^modes isEmpty not and: [ modes first = #text ]
	)
	public isWS: c = (
		(* The white space characters: TAB, LF, VT, FF, CR, SP. *)
		
		^(c between: 9 and: 13) or: [ c = 32 ]
	)
	public itemsOf: nodes = (
		(* items(n): each node's text, then the statements of its bracket. *)
		
		| out = List new. |
		nodes do: [:n |
				out add: (Item text: n contents span: n contentSpan statement: nil).
				n statements do: [:s | out add: (Item text: nil span: nil statement: s) ]
			].
		^out asArray
	)
	join: arrays = (
		| out = List new. |
		arrays do: [:a | out addAll: a ].
		^out asArray
	)
	public lex: source = (
		(* Lexes: lex a source (an Array of code points) from position 0. *)
		
		^lexRun: {#text. } offset: 0 chars: source
	)
	lexErrorAtom: kind = (
		kind = #strayClose ifTrue: [ ^'STRAYCLOSE' ].
		kind = #unclosedLiteral ifTrue: [ ^'UNCLOSEDLITERAL' ].
		^'UNCLOSEDBRACKET'
	)
	lexErrorFor: modes chars: w at: k offset: i = (
		(* The error when no lexing step applies at index k. *)
		
		(modes size = 1 and: [ begins: w at: k with: closeSeq ]) ifTrue: [
				^LexError kind: #strayClose at: i + k - 1
			].
		modes last = #code ifTrue: [
				(w at: k) = 39 ifTrue: [ ^LexError kind: #unclosedLiteral at: i + k - 1 ].
				(begins: w at: k with: commentOpen) ifTrue: [
						^LexError kind: #unclosedLiteral at: i + k - 1
					]
			].
		^nil
	)
	public lexRun: initialModes offset: i chars: w = (
		(* LexRun: lex w, which starts at position i, from the mode stack given
(an Array, the top last). Answers a Lexed, a LexError, or nil when the
lexer is stuck. *)
		
		| modes ::= initialModes. k ::= 1. out = List new. stepped |
		[ k <= w size ] whileTrue: [
				stepped:: lexStep: modes chars: w at: k.
				stepped isNil ifTrue: [ ^lexErrorFor: modes chars: w at: k offset: i ].
				out add: (Located lexeme: stepped lexeme
						span: (Span from: i + k - 1 to: i + stepped next - 1)).
				modes:: stepped modes.
				k:: stepped next
			].
		(modes size = 1 and: [ modes first = #text ]) ifTrue: [
				^Lexed located: out asArray
			].
		^LexError kind: #unclosedBracket at: i + w size
	)
	public lexStep: modes chars: w at: k = (
		(* LexStep: one lexeme from index k of w. Answers a LexStepResult, or nil
when no rule applies. *)
		
		k > w size ifTrue: [ ^nil ].
		modes last = #text ifTrue: [ ^textStep: modes chars: w at: k ].
		^codeStep: modes chars: w at: k
	)
	public lstrip: u = (
		(* Remove one leading space. *)
		
		(u isEmpty not and: [ (u at: 1) = 32 ]) ifTrue: [ ^u copyFrom: 2 to: u size ].
		^u
	)
	mergeKids: items = (
		| out = List new. last g |
		items do: [:each |
				g:: each.
				out isEmpty ifFalse: [
						last:: out last.
						(last kind = #run and: [ g kind = #run ]) ifTrue: [
								out removeLast.
								g:: Child kind: #run
									chars: (collapse: last chars , g chars)
									span: last span
									statement: nil
									ref: nil
							].
						(last kind = #stray and: [ g kind = #stray ]) ifTrue: [
								out removeLast.
								g:: Child kind: #stray
									chars: last chars , g chars
									span: last span
									statement: nil
									ref: nil
							]
					].
				out add: g
			].
		^out asArray
	)
	openSeq = (
		^{91. 92. }
	)
	public parse: sourceName source: w host: host = (
		(* Parses: lex, parse structurally, and resolve. Answers a Parsed, a
LexFail, a ParseFailure, or nil when the structural parse is stuck. *)
		
		| lexed toks markup resolved |
		toks:: fastTokens: w.
		toks isNil ifTrue: [
				lexed:: lex: w.
				lexed isNil ifTrue: [ ^nil ].
				lexed isKindOfLexError ifTrue: [ ^LexFail error: lexed ].
				toks:: tokens: lexed located
			].
		markup:: parseMarkup: toks from: 1.
		markup isNil ifTrue: [ ^nil ].
		(markup at: 2) = (toks size + 1) ifFalse: [ ^nil ].
		resolved:: resolve: sourceName nodes: (markup at: 1) host: host.
		resolved isKindOfFailure ifTrue: [ ^ParseFailure span: resolved span ].
		^Parsed nodes: resolved
	)
	public parseMarkup: toks from: start = (
		(* Markup: a DocumentMarkup from index start of the tokens. Answers
{rawNodes. index of the first token not consumed}, or nil when stuck. *)
		
		| k ::= start. nodes = List new. t m next |
		[ true ] whileTrue: [
				k > toks size ifTrue: [ ^{nodes asArray. k. } ].
				t:: toks at: k.
				t kind = #closeMarkup ifTrue: [ ^{nodes asArray. k. } ].
				t kind = #text ifTrue: [
						k = toks size ifTrue: [
								nodes add: (RawFinal contents: t chars span: t span).
								^{nodes asArray. k + 1. }
							].
						next:: toks at: k + 1.
						next kind = #closeMarkup ifTrue: [
								nodes add: (RawFinal contents: t chars span: t span).
								^{nodes asArray. k + 1. }
							].
						(next kind = #openMessages and: [ next span start = t span end ]) ifFalse: [
								^nil
							].
						m:: parseMessages: toks from: k + 2.
						m isNil ifTrue: [ ^nil ].
						nodes add: (RawBlock contents: t chars
								contentSpan: t span
								pieces: (m at: 1)
								span: (Span from: t span start to: (m at: 2) end)).
						k:: m at: 3
					]
					ifFalse: [
						t kind = #openMessages ifFalse: [ ^nil ].
						m:: parseMessages: toks from: k + 1.
						m isNil ifTrue: [ ^nil ].
						nodes add: (RawBlock contents: {}
								contentSpan: (Span from: t span start to: t span start)
								pieces: (m at: 1)
								span: (Span from: t span start to: (m at: 2) end)).
						k:: m at: 3
					]
			]
	)
	public parseMessages: toks from: start = (
		(* Messages: the pieces of a bracket, through its closeMessages. Answers
{pieces. span of the closeMessages. next index}, or nil when stuck. *)
		
		| k ::= start. pieces = List new. t m close |
		[ k <= toks size ] whileTrue: [
				t:: toks at: k.
				t kind = #closeMessages ifTrue: [ ^{pieces asArray. t span. k + 1. } ].
				t kind = #code ifTrue: [
						pieces add: (SourcePiece chars: t chars span: t span).
						k:: k + 1
					]
					ifFalse: [
						t kind = #openMarkup ifFalse: [ ^nil ].
						m:: parseMarkup: toks from: k + 1.
						m isNil ifTrue: [ ^nil ].
						(m at: 2) > toks size ifTrue: [ ^nil ].
						close:: toks at: (m at: 2).
						close kind = #closeMarkup ifFalse: [ ^nil ].
						pieces add: (HolePiece nodes: (m at: 1)
								span: (Span from: t span start to: close span end)).
						k:: (m at: 2) + 1
					]
			].
		^nil
	)
	public print: tree source: w host: host = (
		(* print_W(tree): the source of a tree, from the source W it was
interpreted from. *)
		
		^join: (tree items collect: [:g | printItem: g source: w host: host ])
	)
	printBracket: statement source: w host: host = (
		^join: {openSeq. show: (host print: {statement. } source: w)
				source: w
				host: host. closeSeq. }
	)
	printCloserOf: tr source: w host: host = (
		tr flag = #unclosed ifTrue: [ ^{} ].
		tr messages size < 2 ifTrue: [ ^{} ].
		^printBracket: tr messages last source: w host: host
	)
	printItem: g source: w host: host = (
		(g kind = #run or: [ g kind = #stray ]) ifTrue: [ ^esc: g chars ].
		g kind = #note ifTrue: [
				^printBracket: (CommentStatement span: g span) source: w host: host
			].
		g kind = #sub ifTrue: [
				| tr = g ref. |
				^join: {printBracket: tr messages first source: w host: host. print: tr
						source: w
						host: host. printCloserOf: tr source: w host: host. }
			].
		^printBracket: g statement source: w host: host
	)
	public printValue: v on: t = (
		(* A value as the specification writes it. Literals and trees are the
core's; any other value prints itself. *)
		
		v isKindOfMarkupLiteral ifTrue: [
				^t open;
					atom: 'LITV';
					term: v;
					close
			].
		v isNil ifTrue: [ ^t atom: 'NILV' ].
		v isKindOfString ifTrue: [
				^t open;
					atom: 'STRV';
					chars: (codePointsOf: v);
					close
			].
		v isKindOfInteger ifTrue: [
				^t open;
					atom: 'INTV';
					nat: v;
					close
			].
		v printTermOn: t
	)
	quoteCodePoint: cp = (
		(* A character as a SpecTec string literal. *)
		
		| bytes = List new. |
		cp = 92 ifTrue: [ ^'"\\"' ].
		cp = 10 ifTrue: [ ^'"\n"' ].
		cp = 9 ifTrue: [ ^'"\t"' ].
		cp = 13 ifTrue: [ ^'"\r"' ].
		cp = 11 ifTrue: [ ^'"\u{0B}"' ].
		cp = 12 ifTrue: [ ^'"\u{0C}"' ].
		encodeCodePoint: cp on: bytes.
		^'"' , (String withAll: bytes asArray) , '"'
	)
	public resolve: sourceName nodes: raws host: host = (
		(* resolve: resolve each raw node, innermost brackets first, through
the host parser. Answers an Array of nodes, or the Failure of the first
bracket that does not parse. *)
		
		| out = List new. n |
		raws do: [:raw |
				n:: resolveNode: raw source: sourceName host: host.
				n isKindOfFailure ifTrue: [ ^n ].
				out add: n
			].
		^out asArray
	)
	resolveNode: raw source: sourceName host: host = (
		| pieces = List new. inner parsed |
		raw isRawFinal ifTrue: [ ^FinalNode contents: raw contents span: raw span ].
		raw pieces do: [:piece |
				piece isHole ifTrue: [
						inner:: resolve: sourceName nodes: piece nodes host: host.
						inner isKindOfFailure ifTrue: [ ^inner ].
						pieces add: (HostHole literal: (MarkupLiteral source: sourceName
									nodes: inner
									span: piece span))
					]
					ifFalse: [ pieces add: (HostSource chars: piece chars span: piece span) ]
			].
		parsed:: host parse: pieces asArray.
		parsed isKindOfFailure ifTrue: [ ^parsed ].
		^BlockNode contents: raw contents
			contentSpan: raw contentSpan
			statements: parsed
			span: raw span
	)
	public rstrip: u = (
		(* Remove one trailing space. *)
		
		(u isEmpty not and: [ (u at: u size) = 32 ]) ifTrue: [
				^u copyFrom: 1 to: u size - 1
			].
		^u
	)
	public scanComment: w from: start depth: d = (
		(* com(d, w): from index start, inside d nested comments. Answers the
index just after the comment's end, or nil when it is unclosed. *)
		
		| k ::= start. depth ::= d. |
		[ k <= w size ] whileTrue: [
				(begins: w at: k with: commentClose) ifTrue: [
						depth = 1 ifTrue: [ ^k + 2 ].
						depth:: depth - 1.
						k:: k + 2
					]
					ifFalse: [
						(begins: w at: k with: commentOpen) ifTrue: [
								depth:: depth + 1.
								k:: k + 2
							]
							ifFalse: [ k:: k + 1 ]
					]
			].
		^nil
	)
	public scanString: w from: start = (
		(* lit(w): from index start, just after an opening quote. Answers the
index just after the closing quote, or nil when the literal is unclosed. A
doubled quote is a quote. *)
		
		| k ::= start. |
		[ k <= w size ] whileTrue: [
				(w at: k) = 39 ifTrue: [
						(k < w size and: [ (w at: k + 1) = 39 ]) ifTrue: [ k:: k + 2 ]
							ifFalse: [ ^k + 1 ]
					]
					ifFalse: [ k:: k + 1 ]
			].
		^nil
	)
	public show: printed source: w host: host = (
		(* show_W: the code the host printed, with the literals in its holes
printed by the core. *)
		
		^join: (printed collect: [:pp |
					pp isLiteral ifTrue: [ showLiteral: pp literal source: w host: host ]
						ifFalse: [ pp chars ]
				])
	)
	showLiteral: literal source: w host: host = (
		| parts = List new. |
		parts add: openSeq.
		literal nodes do: [:n |
				parts add: (esc: n contents).
				n isKindOfBlockNode ifTrue: [
						parts add: openSeq.
						parts add: (show: (host print: n statements source: w)
								source: w
								host: host).
						parts add: closeSeq
					]
			].
		parts add: closeSeq.
		^join: parts asArray
	)
	public slice: w span: s = (
		(* W[s]: the source of a span. *)
		
		^w copyFrom: s start + 1 to: s end
	)
	public stringOfCodePoints: cps = (
		(* Encode an Array of code points as a UTF-8 String. *)
		
		| bytes = List new. |
		cps do: [:cp | encodeCodePoint: cp on: bytes ].
		^String withAll: bytes asArray
	)
	public termStringOf: x = (
		(* A datum as a SpecTec term. *)
		
		| t = TermWriter new. |
		x printTermOn: t.
		^t asString
	)
	textStep: modes chars: w at: k = (
		(begins: w at: k with: openSeq) ifTrue: [
				^LexStepResult lexeme: (Lexeme kind: #openMessages chars: {})
					modes: (modes copyWith: #code)
					next: k + 2
			].
		(begins: w at: k with: closeSeq) ifTrue: [
				(modes size >= 2 and: [ (modes at: modes size - 1) = #code ]) ifFalse: [
						^nil
					].
				^LexStepResult lexeme: (Lexeme kind: #closeMarkup chars: {})
					modes: (modes copyFrom: 1 to: modes size - 1)
					next: k + 2
			].
		(begins: w at: k with: backslashEscape) ifTrue: [
				^LexStepResult lexeme: (Lexeme kind: #char chars: {92. })
					modes: modes
					next: k + 2
			].
		(begins: w at: k with: bracketEscape) ifTrue: [
				^LexStepResult lexeme: (Lexeme kind: #char chars: {91. })
					modes: modes
					next: k + 2
			].
		^LexStepResult lexeme: (Lexeme kind: #char chars: {w at: k. })
			modes: modes
			next: k + 1
	)
	tokenOf: l = (
		| k = l lexeme kind. |
		k = #char ifTrue: [ ^Token kind: #text chars: l lexeme chars span: l span ].
		^Token kind: k chars: l lexeme chars span: l span
	)
	public tokens: located = (
		(* tokens: coalesce lexemes into tokens; adjacent characters make one
text token and adjacent code one code token. A run's characters are
gathered and its token made once, so this is linear. *)
		
		| out = List new. run = List new. kind start end t |
		located do: [:l |
				t:: tokenOf: l.
				(kind isNil not and: [ kind = t kind and: [ end = t span start ] ]) ifTrue: [
						run addAll: t chars.
						end:: t span end
					]
					ifFalse: [
						kind isNil ifFalse: [
								out add: (Token kind: kind
										chars: run asArray
										span: (Span from: start to: end))
							].
						run removeAll.
						(t kind = #text or: [ t kind = #code ]) ifTrue: [
								kind:: t kind.
								start:: t span start.
								end:: t span end.
								run addAll: t chars
							]
							ifFalse: [
								out add: t.
								kind:: nil
							]
					]
			].
		kind isNil ifFalse: [
				out add: (Token kind: kind
						chars: run asArray
						span: (Span from: start to: end))
			].
		^out asArray
	)
	public trim: kids = (
		(* trim: one space off the start of a first run and the end of a last
run; a run that becomes empty is dropped. *)
		
		| out = List new. first last |
		out addAll: kids.
		out isEmpty ifTrue: [ ^{} ].
		first:: out first.
		first isRun ifTrue: [
				out removeFirst.
				(lstrip: first chars) isEmpty ifFalse: [
						out addFirst: (Child kind: #run
								chars: (lstrip: first chars)
								span: first span
								statement: nil
								ref: nil)
					]
			].
		out isEmpty ifTrue: [ ^{} ].
		last:: out last.
		last isRun ifTrue: [
				out removeLast.
				(rstrip: last chars) isEmpty ifFalse: [
						out addLast: (Child kind: #run
								chars: (rstrip: last chars)
								span: last span
								statement: nil
								ref: nil)
					]
			].
		^out asArray
	)
	zeroSpan = (
		^Span from: 0 to: 0
	)
) : ()
