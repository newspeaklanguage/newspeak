Newspeak3
'Emmanuel'
class EmmanuelDeckProbeApp packageUsing: manifest = (
	(* Boots the IDE in the page, for tool/emmanuel-deck-probe.py, which loads
document zips into it in headless Chrome and drives them.

It defines three JavaScript functions: deckLoad(jszip, name) loads a
document zip as the IDE does and leaves 'loaded NAME' or 'failed ...' in the
global deckResult; deckConvert(name) converts the HTML document NAME to an
Emmanuel one, NAMEEmmanuel, as the document menu's Convert to Emmanuel does,
and leaves its class's source, ' SOURCE ', and its source (or 'failed ...')
in deckResult; deckSource(name)
leaves the document's source in deckResult; deckOpen(name) shows the
document in the IDE's window; deckView(name) shows its read-only viewer; deckHome() shows the home page
instead; deckOutlets(name) leaves in deckResult how many outlets the
document's contentsChanged duct has (each a presentation that refreshes when
the document changes);
deckUpdateGUI() makes the window's presenter send updateGUI:, as any change
does (leaving 'none', or the error, in deckError). *)
	
	|
		private ideApp = manifest HopscotchWebIDE packageUsing: manifest.
	|
) (
	public main: platform args: args = (
		| global = platform js global. ide = ideApp ideUsingPlatform: platform. |
		ideApp augmentNamespace: ide namespacing Root withPlatform: platform local.
		ide setupNames.
		ide launch: ide browsing HomeSubject new.
		global at: #deckLoad
			put: [:jsz :n |
				| ns = ide browsing NamespaceSubject onModel: ide namespacing Root
					key: 'probe'. |
				ide documents loadDocument: jsz
					named: n
					into: ns
					ifSuccess: [
						global at: #deckResult put: 'loaded ' , n.
						nil
					]
					ifFailure: [:e |
						global at: #deckResult put: 'failed ' , e printString.
						nil
					].
				nil
			].
		global at: #deckConvert
			put: [:n |
				[
					| new = ide documents emmanuel convert: (ide namespacing Root at: n). |
					global at: #deckResult
						put: new mirror getClass mixin declaration source , ' SOURCE ' , new contents
				] on: Error
					do: [:e |
						global at: #deckResult put: 'failed ' , e messageText printString
					].
				nil
			].
		global at: #deckSource
			put: [:n |
				global at: #deckResult put: (ide namespacing Root at: n) contents.
				nil
			].
		global at: #deckUpdateGUI
			put: [:ignored |
				[
					| presenter = ((platform mirrors ObjectMirror reflecting: ide browsing) evaluate: 'currentWindow') result reflectee currentPresenter. r |
					r:: (platform mirrors ObjectMirror reflecting: presenter) evaluate: 'updateGUI: [ ]'.
					r isKindOfObjectMirror ifFalse: [
							^global at: #deckError put: 'evaluate failed: ' , r printString
						].
					global at: #deckError put: 'none'
				] on: Error do: [:e | global at: #deckError put: e messageText printString ].
				nil
			].
		global at: #deckHome
			put: [:ignored |
				ide browsing navigateTo: ide browsing HomeSubject new.
				nil
			].
		global at: #deckView
			put: [:n |
				ide browsing navigateTo: (ide documents DocumentViewerSubject onModel: (ide namespacing Root at: n)).
				nil
			].
		global at: #deckOutlets
			put: [:n |
				[
					| duct = (ide namespacing Root at: n) contentsChanged. r = (platform mirrors ObjectMirror reflecting: duct) evaluate: 'outlets size'. |
					global at: #deckResult
						put: (r isFulfilled ifTrue: [ r result reflectee printString ]
							ifFalse: [ 'failed ' , r printString ])
				] on: Error
					do: [:e |
						global at: #deckResult put: 'failed ' , e messageText printString
					].
				nil
			].
		global at: #deckOpen
			put: [:n |
				ide browsing navigateTo: (ide documents DocumentSubject onModel: (ide namespacing Root at: n)).
				nil
			].
		(global at: #console) log: 'deck-probe-ready'
	)
) : ()
