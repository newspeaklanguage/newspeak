;; Non-normative, concrete states for regression tests.

def $publicMethod : methodview
def $publicMethod = { ID MD 1, SELECTOR "echo", ACCESS PUBLIC, OWNER CD 1 }
def $protectedMethod : methodview
def $protectedMethod = { ID MD 2, SELECTOR "echo", ACCESS PROTECTED, OWNER CD 2 }
def $privateMethodFixture : methodview
def $privateMethodFixture = { ID MD 3, SELECTOR "echo", ACCESS PRIVATE, OWNER CD 3 }

def $fixtureProgram : lookupProgram
def $fixtureProgram = {
  TOP CID 0, OBJECT CID 1,
  MIXINS
    (MID 0, { DECL CD 0, METHODS eps })
    (MID 1, { DECL CD 1, METHODS ("echo", $publicMethod) })
    (MID 2, { DECL CD 2, METHODS ("echo", $protectedMethod) })
    (MID 3, { DECL CD 3, METHODS ("echo", $privateMethodFixture) })
    (MID 4, { DECL CD 4, METHODS eps }),
  DECLMIXINS (CD 0, MID 0) (CD 1, MID 1) (CD 2, MID 2) (CD 3, MID 3) (CD 4, MID 4),
  LEXPARENTS (CD 3, CD 1) (CD 2, CD 1) (CD 4, CD 1),
  ACTIVATIONMEMBERS (MD 7, ("p")),
  SCOPECHAINS
    (SITE 0, ((CD 3) (CD 1)))
    (SITE 1, ((MD 7) (CD 3) (CD 1)))
    (SITE 2, ((CD 4) (CD 1)))
}

def $fixtureHeap : lookupHeap
def $fixtureHeap = {
  CLASSES
    (CID 0, { MIXIN MID 0, SUPER CID 0, ENCLOSING OBJECTREF OID 1 })
    (CID 1, { MIXIN MID 0, SUPER CID 0, ENCLOSING OBJECTREF OID 1 })
    (CID 2, { MIXIN MID 1, SUPER CID 1, ENCLOSING OBJECTREF OID 1 })
    (CID 3, { MIXIN MID 2, SUPER CID 2, ENCLOSING OBJECTREF OID 1 })
    (CID 4, { MIXIN MID 3, SUPER CID 2, ENCLOSING OBJECTREF OID 2 })
    (CID 5, { MIXIN MID 3, SUPER CID 3, ENCLOSING OBJECTREF OID 1 })
    (CID 6, { MIXIN MID 4, SUPER CID 2, ENCLOSING OBJECTREF OID 1 })
    (CID 7, { MIXIN MID 3, SUPER CID 4, ENCLOSING OBJECTREF OID 1 }),
  TYPEOF
    (OBJECTREF OID 0, CID 7) (OBJECTREF OID 1, CID 2)
    (OBJECTREF OID 2, CID 2) (OBJECTREF OID 3, CID 3)
    (OBJECTREF OID 4, CID 5) (OBJECTREF OID 5, CID 6)
    (ACTIVATIONREF AID 0, CID 2),
  ACTIVATIONS
    (AID 0, { RECEIVER OBJECTREF OID 0, CURRENT CID 4, SCOPES eps })
    (AID 1, { RECEIVER OBJECTREF OID 3, CURRENT CID 3, SCOPES eps })
    (AID 2, { RECEIVER OBJECTREF OID 1, CURRENT CID 1, SCOPES eps })
    (AID 3, { RECEIVER OBJECTREF OID 1, CURRENT CID 0, SCOPES eps })
    (AID 4, { RECEIVER OBJECTREF OID 4, CURRENT CID 5, SCOPES eps })
}
