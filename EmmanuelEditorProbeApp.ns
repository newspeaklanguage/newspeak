Newspeak3
'Emmanuel'
class EmmanuelEditorProbeApp packageUsing: manifest = (
	(* Mounts an EmmanuelLiveEditor in the page, for tool/emmanuel-editor-probe.py,
which types into it in headless Chrome and checks the sources it edits.

It defines two JavaScript functions: emmanuelLoad(source) replaces the page
with an editor of source, and emmanuelRead() leaves the editor's source in
the global emmanuelSource, and the number of times amplets ran in
emmanuelRuns. The editor's evaluator is a stand-in (the probe has no
compiler): the code of an amplet evaluates to a block that answers
'ran ' followed by the code, and counts its runs. *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelBlocks = manifest EmmanuelBlocks.
		private EmmanuelEdit = manifest EmmanuelEdit.
		private EmmanuelIncremental = manifest EmmanuelIncremental.
		private EmmanuelLiveEditor = manifest EmmanuelLiveEditor.
		private EmmanuelNewspeakHost = manifest EmmanuelNewspeakHost.
		private NewspeakASTs = manifest NewspeakASTs.
		private NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
	|
) (
	class StandInEvaluator new = (
		(* Evaluates code to a block that answers 'ran ' and the code. *)
		
		|
			public runs ::= 0.
			public codeEditor ::= nil.
			public stylesheet ::= nil.
		|
	) (
		public evaluate: code = (
			(* The amplet [codeEditor] shows a code editor (codeEditor value). *)
			
			code = '[codeEditor]' ifTrue: [ ^codeEditor ].
			^[
				runs:: runs + 1.
				'ran ' , code
			]
		)
		public urlOfImage: name = (
			^name
		)
	) : ()
	public main: platform args: args = (
		| global = platform js global. body = (global at: #document) at: #body. editors = EmmanuelLiveEditor usingPlatform: platform
			emmanuel: Emmanuel
			newspeakHost: EmmanuelNewspeakHost
			blocks: EmmanuelBlocks
			edit: EmmanuelEdit
			incremental: EmmanuelIncremental
			parsing: NewspeakPredictiveParsing
			asts: NewspeakASTs. current ::= nil. evaluator ::= nil. |
		global at: #emmanuelLoad
			put: [:source |
				evaluator:: StandInEvaluator new.
				evaluator codeEditor: [ platform hopscotch CodeMirrorFragment onText: 'abc' ].
				current:: editors editorOn: source evaluator: evaluator.
				body at: #innerHTML put: ''.
				body appendChild: current visual.
				nil
			].
		global at: #emmanuelLoadPaper
			put: [:source |
				
				(* Load source as a paper: the core stylesheet, no presentation. *)
				evaluator:: StandInEvaluator new.
				evaluator stylesheet: editors blocks coreStylesheet.
				current:: editors editorOn: source evaluator: evaluator.
				body at: #innerHTML put: ''.
				body appendChild: current visual.
				nil
			].
		global at: #emmanuelSetPage
			put: [:p |
				current source: (current sourceWithPage: p).
				nil
			].
		global at: #emmanuelFrameWidth
			put: [:ignored |
				global at: #emmanuelFrame put: current session frameWidth.
				global at: #emmanuelFrameHeight put: current session frameHeight.
				nil
			].
		global at: #emmanuelSetSource
			put: [:source |
				current source: source.
				nil
			].
		global at: #emmanuelRead
			put: [:ignored |
				global at: #emmanuelSource put: current session sourceString.
				global at: #emmanuelRuns put: evaluator runs.
				global at: #emmanuelTimings put: current session timings.
				global at: #emmanuelAgrees put: current session agreesWithWholeParse.
				global at: #emmanuelFailed put: current session failed.
				nil
			].
		global at: #emmanuelCodeMirrorWrite
			put: [:old :new |
				| f = 
				(* Write new over old in a raw view's code editor, as the live view
does, and leave what the code editor then holds in emmanuelCodeMirrorText. *)
				platform hopscotch CodeMirrorFragment onText: old. |
				body appendChild: f visual.
				f text: new origin: 'liveview'.
				global at: #emmanuelCodeMirrorText put: f textBeingAccepted.
				nil
			].
		global at: #emmanuelView
			put: [:source :asHTML |
				
				(* Replace the page with a document viewer's rendering of source:
the read-only view (viewOn:evaluator:), or, when asHTML, the source as HTML,
as a viewer rendered an Emmanuel document before; leave its text in
emmanuelViewText. *)
				evaluator:: StandInEvaluator new.
				body at: #innerHTML put: ''.
				asHTML ifTrue: [ body at: #innerHTML put: source ]
					ifFalse: [
						body appendChild: (editors viewOn: source evaluator: evaluator) visual
					].
				global at: #emmanuelViewText put: (body at: #innerText).
				nil
			].
		global at: #emmanuelProfile
			put: [:source |
				global at: #emmanuelProfileResult put: (editors profile: source).
				nil
			].
		(global at: #console) log: 'emmanuel-editor-ready'
	)
) : ()
