Newspeak3
'Eurasia'
class EurasiaKernelTestRunner usingPlatform: platform = (
	(* The kernel test suites on Eurasia, compared with psoup by eurasia/scripts/kernel-tests.sh (EurasiaKernelTestReference runs them there). The genesis packager packages this application as if nested in EurasiaKernel, fills the slots below that are named after packaged modules with their classes, and testCatalog with their tests. The runner builds a platform over the kernel and prints one line per test: Context>>selector, then success, failure or error, and a description. Minitest finds tests with mirrors and runs them with promises, which Eurasia does not have yet (M6, M4), so Minitest serves here only for TestContext, and the runner does what Minitest's TestCase>>runUsing: does. *)
	
	|
		Kernel
		CollectionsForPrimordialSoup
		Minitest
		KernelTests
		AccessModifierTesting
		KernelWeakTests
		testCatalog
	|
) (
	class Platform internalKernel: ik = (
		|
			public kernel = Kernel wrapping: ik.
			public collections = CollectionsForPrimordialSoup usingInternalKernel: ik.
			public actors = Unavailable new.
			public mirrors = Unavailable new.
		|
	) (
	) : ()
	class Unavailable new = (
		(* Stands in for the actors and mirrors modules, which Eurasia does not have yet; Minitest only stores their classes. *)
		
	) (
		public ClassMirror = (
			^nil
		)
		public ObjectMirror = (
			^nil
		)
		public Promise = (
			^nil
		)
	) : ()
	describe: exception = (
		^[ exception messageText printString ] on: Exception do: [:e | '?' ]
	)
	public main: vm args: args = (
		| platform minitest |
		platform:: Platform internalKernel: eurasiaInternalKernel.
		minitest:: Minitest usingPlatform: platform.
		testCatalog do: [:entry |
				| module |
				(entry at: 2) isEmpty ifFalse: [
						module:: testModuleNamed: (entry at: 1)
							platform: platform
							minitest: minitest
					].
				(entry at: 2) do: [:context |
						(context at: 2) do: [:selector |
								vm print: (context at: 1) , '>>' , selector , ' ' , (outcomeOf: selector
										in: (context at: 1)
										of: module
										vm: vm)
							]
					]
			].
		vm print: 'done'
	)
	outcomeOf: selector in: contextName of: module vm: vm = (
		(* As in Minitest's TestCase>>runUsing:, a failed assertion (Minitest's TestFailureException) is a failure and any other exception an error. That class is private to Minitest, so it is recognized by name. (In this kernel Error is Exception.) *)
		
		^[
			| context |
			context:: ((Message selector: contextName arguments: {}) sendTo: module) new.
			(Message selector: selector arguments: {}) sendTo: context.
			'success'
		] on: Exception
			do: [:e |
				((vm slotOf: (vm classOf: e) at: 4) = 'TestFailureException' ifTrue: [
						'failure '
					]
					ifFalse: [ 'error ' ]) , (describe: e)
			]
	)
	testModuleNamed: name platform: platform minitest: minitest = (
		name = 'KernelTests' ifTrue: [
				^KernelTests usingPlatform: platform testFramework: minitest
			].
		name = 'AccessModifierTesting' ifTrue: [
				^AccessModifierTesting usingPlatform: platform testFramework: minitest
			].
		name = 'KernelWeakTests' ifTrue: [
				^KernelWeakTests usingPlatform: platform
					minitest: minitest
					gcAction: [ platform kernel garbageCollect ]
			].
		^Error signal: 'No test module ' , name
	)
) : ()
