		private raisedToInteger: exponent <Integer> ^<Integer | Fraction> = (
			| result base e |
			exponent < 0 ifTrue: [ ^1 / (self raisedToInteger: 0 - exponent) ].
			result:: 1.
			base:: self.
			e:: exponent.
			[ e > 0 ] whileTrue: [
					(e bitAnd: 1) = 0 ifFalse: [ result:: result * base ].
					e:: e >> 1.
					base:: base * base
				].
