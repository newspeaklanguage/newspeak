	public class Metaclass new = Behavior new (
		|
			private thisClass <Class> (* Eurasia contract field 4. *)
			private library (* Eurasia contract field 5: the mirror library's. *)
		|
	) (
		public name ^<String> = (
			^thisClass name , ' class'
		)
		public printString ^<String> = (
			^thisClass printString , ' class'
		)
	) : ()
	public class Method new = (
		|
			public literals <Array> (* Eurasia contract field 1. *)
			public mixin <AbstractMixin> (* Eurasia contract field 2. *)
			public selector <Symbol> (* Eurasia contract field 3. *)
			public metadata <String | MethodMetadata | DebugInfo | Nil> (* Eurasia contract field 4: source. *)
			public library (* Eurasia contract field 5: the mirror library's. *)
		|
	) (
		public accessModifier ^<Symbol> = (
			| ac <Integer> = header >> 28. |
			0 = ac ifTrue: [ ^#public ].
			1 = ac ifTrue: [ ^#protected ].
			2 = ac ifTrue: [ ^#private ].
			halt
		)
		public bytecode = (
			^nil
		)
		public header ^<Integer> = (
			(* Eurasia keeps method headers in the VM; decoding them through a mirror arrives with M6. Until then every method reads as public, with no arguments, temps or primitive. *)
			
			^0
		)
		public isLazySlotMethod ^<Boolean> = (
			^(nil = metadata or: [ metadata isKindOfString ]) ifTrue: [ false ]
				ifFalse: [ metadata isLazy ]
		)
		public isPrivate ^<Boolean> = (
			^#private = accessModifier
		)
		public isProtected ^<Boolean> = (
			^#protected = accessModifier
		)
		public isPublic ^<Boolean> = (
			^#public = accessModifier
		)
		public isSynthetic ^<Boolean> = (
			^nil = metadata or: [
					metadata isKindOfString ifTrue: [ false ] ifFalse: [ metadata isLazy ]
				]
		)
		public numArgs ^<Integer> = (
			^header >> 0 bitAnd: 255
		)
		public numTemps ^<Integer> = (
			^header >> 8 bitAnd: 255
		)
		public primitive ^<Integer> = (
			^header >> 16 bitAnd: 1023
		)
		public source = (
			metadata isNil ifTrue: [ ^nil ].
			metadata isKindOfString ifFalse: [ ^metadata source ].
			^metadata
		)
		public source: s = (
			(* Can be removed after next bootstrap compiler update. *)
			
			metadata: s
		)
