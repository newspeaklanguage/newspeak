Newspeak3
'Emmanuel'
class EmmanuelFromHTML usingPlatform: p emmanuel: em = (
	(* Converts HTML, such as the body of an Ampleforth document, to an Emmanuel
source that uses the standard block library (EmmanuelBlocks).

The converter reads a tree of Elements and Texts. fromDOM: builds one from
a browser DOM node, and fromHTML: from a string, with the browser's own HTML
parser; tests build trees directly.

The mapping. Headings become the title (an h1 before any other content) and
sections, nested by heading level; p, and runs of inline content in other
blocks, become paragraphs; i and em become emphasis, b and strong strong,
u underline, s, strike and del strikethrough, sub subscript, sup
superscript, code, tt, kbd and samp inline code; br is a newline, and two or more in a
row end the paragraph. ul and ol become lists, blockquote a quote, table a
table (a row of th cells is a header row), pre a verbatim display (or a code
block when it holds code), hr a horizontal line (hline). div and the other presentational containers are
transparent; a block that aligns its content (center, an align attribute,
or text-align in its style) becomes an align: container (the default
stylesheet's) around it. A title so centered makes the conversion's looks
center the title (looks, which a document's class body gives its
stylesheet); a section heading or inline content so aligned is a Loss. An anchor with a target becomes a link around its text. An anchor with an id
(or a name) labels the section whose heading comes next, before any text,
and a link whose target is just such an id, as hand-written HTML often has
it without its #, links to #id; an id no heading follows is a Loss. A
document whose style elements give a background image (background-image:
url(...), as decks' slides and the blog pages do) gets background: with its
URL (convertDocument:).

An amplet becomes amplet: with its expression in a block, which the view
runs: a display in flow content, an inline leaf in a paragraph.

What the library has no block for is never silently dropped: it is reported
as a Loss. Images, rules, and unknown elements are kept as html: displays of
their HTML; a text color or background color of inline content (a style's
color and background-color, a font element's color) becomes color: or
highlight: around it, unless it is the default (black text, a white or no
background), and other presentational styling is dropped; scripts and styles are dropped. The report tells which of these the
documents use, and how often. *)
	
	|
		private List = p collections List.
		private Map = p collections Map.
		private emmanuel = em.
		private DOMParser = p hopscotch DOMParser.
	|
) (
	public class Conversion source: s losses: ls = (
		(* The result of a conversion: the Emmanuel source, what was lost, and
the looks its document's stylesheet should give its parts (pairs of a part
and its CSS, as Stylesheet withLooks: takes them), such as a centered
title's. *)
		
		|
			public source = s.
			public losses = ls.
			public looks ::= {}.
		|
	) (
		public looksSource = (
			(* The looks as the source of a literal, as a stylesheet method in
a document's class body gives them to withLooks:; nil when there are none. *)
			
			| out ::= '{'. |
			looks isEmpty ifTrue: [ ^nil ].
			looks do: [:l |
					out:: out , '{#' , (l at: 1) , '. ' , (stringLiteral: (l at: 2)) , '. }. '
				].
			^out , '}'
		)
		public report = (
			(* The number of losses of each kind. *)
			
			| counts = Map new. |
			losses do: [:l |
					counts at: l kind put: (counts at: l kind ifAbsent: [ 0 ]) + 1
				].
			^counts
		)
	) : ()
	class Converter literal: isLiteral = (
		(* The state of one conversion. Statements are collected in pending
and written as one bracket when text, or the end, follows. A literal
conversion is of the inline content of a markup literal, such as a
heading's: it never ends a paragraph or writes a display. *)
		
		|
			out = List new.
			pending = List new.
			public losses = List new.
			inParagraph ::= isLiteral.
			paragraphEmpty ::= true.
			breaks ::= 0.
			inlineDepth ::= 0.
			flowDepth ::= 0.
			cellDepth ::= -1.
			inLink ::= false.
			anchors ::= {}.
			pendingLabel ::= nil.
			sections = List new.
			titleTaken ::= false.
			contentSeen ::= false.
			textAtEnd ::= false.
			literal = isLiteral.
			public titleCentered ::= false.
		|
	) (
		aligned: n to: a = (
			(* The block n, which aligns its content to a: its content in an
align: container. *)
			
			closeParagraph.
			send: 'align: ' , (stringLiteral: a).
			contentSeen:: true.
			flowDepth:: flowDepth + 1.
			n tag = 'p' ifTrue: [ inlineChildren: n ] ifFalse: [ flow: n children ].
			closeParagraph.
			flowDepth:: flowDepth - 1.
			send: 'endAlign'.
			lineBreak
		)
		amplet: n = (
			(* An amplet in flow content: a display; directly in a table cell,
where an amplet is inline, it goes in a paragraph. *)
			
			| s = ampletStatement: n. |
			s isNil ifTrue: [ ^self ].
			flowDepth = cellDepth ifTrue: [ ^inlineAmplet: n ].
			closeParagraph.
			send: s.
			contentSeen:: true.
			lineBreak
		)
		ampletStatement: n = (
			(* amplet: with the amplet's expression in a block, which the view
runs; nil, and a loss, when it has no expression. *)
			
			| code = (isMediaImage: n) ifTrue: [ mediaCode: n ]
				ifFalse: [ n attribute: 'name' ]. |
			(code isNil or: [ isBlank: code ]) ifTrue: [
					lose: 'amplet without code' detail: (detailOf: n).
					^nil
				].
			^'amplet: [' , code , ']'
		)
		anchorIdsIn: nodes into: ids = (
			(* The ids (or names) of the anchors among nodes and in them. *)
			
			nodes do: [:n |
					n isText ifFalse: [
							(n tag = 'a' and: [ (anchorOf: n) isNil not ]) ifTrue: [
									ids add: (anchorOf: n)
								].
							anchorIdsIn: n children into: ids
						]
				]
		)
		anchorOf: n = (
			(* The id of the anchor n, or its name; nil when it has neither. *)
			
			| id ::= n attribute: 'id'. |
			(id isNil or: [ isBlank: id ]) ifTrue: [ id:: n attribute: 'name' ].
			(id isNil or: [ isBlank: id ]) ifTrue: [ ^nil ].
			^id
		)
		applyBreaks = (
			(* Before content: one pending br is a newline; two or more end
the paragraph, unless it cannot end here. *)
			
			| n = breaks. |
			breaks:: 0.
			n = 0 ifTrue: [ ^self ].
			(n >= 2 and: [ inlineDepth = 0 and: [ literal not ] ]) ifTrue: [
					closeParagraph.
					^openParagraph
				].
			n timesRepeat: [ send: 'newline' ]
		)
		block: n = (
			(* A block-level element in flow content. *)
			
			| tag = n tag. a = alignmentOf: n. |
			(isAmplet: n) ifTrue: [ ^amplet: n ].
			(a isNil not and: [
					(tag = 'p' or: [ transparentBlocks includes: tag ]) and: [ hasContent: n ]
				]) ifTrue: [ ^aligned: n to: a ].
			tag = 'p' ifTrue: [
					closeParagraph.
					inlineChildren: n.
					^closeParagraph
				].
			({'h1'. 'h2'. 'h3'. 'h4'. 'h5'. 'h6'. } includes: tag) ifTrue: [
					^heading: n level: (headingLevel: tag)
				].
			tag = 'ul' ifTrue: [ ^list: n opener: 'list' closer: 'endList' ].
			tag = 'ol' ifTrue: [
					^list: n opener: 'numberedList' closer: 'endNumberedList'
				].
			tag = 'blockquote' ifTrue: [
					^container: n opener: 'quote' closer: 'endQuote'
				].
			tag = 'pre' ifTrue: [ ^pre: n ].
			tag = 'table' ifTrue: [ ^table: n ].
			tag = 'hr' ifTrue: [
					closeParagraph.
					send: 'hline'.
					contentSeen:: true.
					^lineBreak
				].
			(transparentBlocks includes: tag) ifTrue: [
					closeParagraph.
					flow: n children.
					^closeParagraph
				].
			(droppedTags includes: tag) ifTrue: [ ^lose: tag detail: (detailOf: n) ].
			keep: n as: tag detail: (detailOf: n)
		)
		closeParagraph = (
			(inParagraph not or: [ literal ]) ifTrue: [ ^self ].
			(pending isEmpty and: [ textAtEnd ]) ifTrue: [ trimTrailingSpace ].
			send: 'endParagraph'.
			inParagraph:: false.
			breaks:: 0.
			lineBreak
		)
		colored: n = (
			(* The inline content of n, in color: and highlight: when n gives its
text a color or a background color other than the default (textColorOf:,
highlightOf:). *)
			
			| c = textColorOf: n. h = highlightOf: n. |
			c isNil ifFalse: [
					send: 'color: ' , (stringLiteral: c).
					inlineDepth:: inlineDepth + 1
				].
			h isNil ifFalse: [
					send: 'highlight: ' , (stringLiteral: h).
					inlineDepth:: inlineDepth + 1
				].
			inlineChildren: n.
			(c isNil and: [ h isNil ]) ifTrue: [ ^self ].
			breaks:: 0.
			h isNil ifFalse: [
					inlineDepth:: inlineDepth - 1.
					send: 'endHighlight'
				].
			c isNil ifFalse: [
					inlineDepth:: inlineDepth - 1.
					send: 'endColor'
				]
		)
		container: n opener: o closer: c = (
			closeParagraph.
			send: o.
			contentSeen:: true.
			flowDepth:: flowDepth + 1.
			flow: n children.
			closeParagraph.
			flowDepth:: flowDepth - 1.
			send: c.
			lineBreak
		)
		display: html = (
			closeParagraph.
			send: 'html: ' , (stringLiteral: html).
			contentSeen:: true.
			lineBreak
		)
		dropLabel = (
			(* Content came before a heading the pending anchor could label: it
is lost. *)
			
			pendingLabel isNil ifTrue: [ ^self ].
			lose: 'anchor' detail: pendingLabel.
			pendingLabel:: nil
		)
		emitText: s = (
			| cps ::= emmanuel collapse: (emmanuel codePointsOf: s). |
			(paragraphEmpty or: [ inParagraph not ]) ifTrue: [ cps:: stripLeading: cps ].
			cps isEmpty ifTrue: [ ^self ].
			(isBlank: s) ifFalse: [ dropLabel ].
			ensureParagraph.
			applyBreaks.
			flush.
			out add: (emmanuel stringOfCodePoints: (emmanuel esc: cps)).
			paragraphEmpty:: false.
			contentSeen:: true.
			textAtEnd:: true
		)
		ensureParagraph = (
			inParagraph ifTrue: [ ^self ].
			openParagraph
		)
		flow: nodes = (
			nodes do: [:n | flowNode: n ]
		)
		flowNode: n = (
			n isText ifTrue: [
					((isBlank: n text) and: [ inParagraph not ]) ifTrue: [ ^self ].
					^emitText: n text
				].
			n tag = 'br' ifTrue: [
					inParagraph ifTrue: [ breaks:: breaks + 1 ].
					^self
				].
			((isAmplet: n) and: [ inParagraph ]) ifTrue: [ ^inlineAmplet: n ].
			((inlineTags includes: n tag) and: [ (isAmplet: n) not ]) ifTrue: [
					^inline: n
				].
			block: n
		)
		flush = (
			pending isEmpty ifTrue: [ ^self ].
			out add: '[\' , (join: pending asArray with: '. ') , '\]'.
			pending removeAll.
			textAtEnd:: false
		)
		heading: n level: level = (
			| arg = headingArgument: n. |
			arg isNil ifTrue: [ ^self ].
			(flowDepth > 0 or: [ literal ]) ifTrue: [
					dropLabel.
					lose: 'heading in a block' detail: (detailOf: n).
					closeParagraph.
					ensureParagraph.
					wrap: n opener: 'strong' closer: 'endStrong'.
					^closeParagraph
				].
			closeParagraph.
			(level = 1 and: [ titleTaken not and: [ contentSeen not ] ]) ifTrue: [
					dropLabel.
					titleTaken:: true.
					titleCentered:: isCentered: n.
					send: 'title: ' , arg.
					contentSeen:: true.
					^lineBreak
				].
			[ sections isEmpty not and: [ sections last >= level ] ] whileTrue: [
					send: 'endSection'.
					sections removeLast
				].
			(isCentered: n) ifTrue: [ lose: 'centered heading' detail: (detailOf: n) ].
			send: 'section: ' , arg.
			pendingLabel isNil ifFalse: [
					send: 'label: ' , (stringLiteral: pendingLabel).
					pendingLabel:: nil
				].
			sections add: level.
			contentSeen:: true.
			lineBreak
		)
		headingArgument: n = (
			(* The argument of title: or section:: a markup literal, which the
live view can edit as text; nil when the heading is empty. *)
			
			| inner = Converter literal: true. text |
			(n children allSatisfy: [:c | c isText or: [ c tag = 'br' ] ]) ifTrue: [
					text:: stripTrailing: (stripLeading: (emmanuel collapse: (emmanuel codePointsOf: (textOf: n)))).
					text isEmpty ifTrue: [ ^nil ].
					^'[\' , (emmanuel stringOfCodePoints: (emmanuel esc: text)) , '\]'
				].
			inner inlineChildren: n.
			losses addAll: inner losses.
			(isBlank: inner source) ifTrue: [ ^nil ].
			^'[\' , inner source , '\]'
		)
		inline: n = (
			(* An inline element. *)
			
			| tag = n tag. |
			(tag = 'a' and: [ (anchorOf: n) isNil not ]) ifTrue: [
					dropLabel.
					pendingLabel:: anchorOf: n
				].
			(isEmptyInline: n) ifTrue: [ ^self ].
			ensureParagraph.
			({'i'. 'em'. } includes: tag) ifTrue: [
					^wrap: n opener: 'emphasis' closer: 'endEmphasis'
				].
			({'b'. 'strong'. } includes: tag) ifTrue: [
					^wrap: n opener: 'strong' closer: 'endStrong'
				].
			({'code'. 'tt'. 'kbd'. 'samp'. } includes: tag) ifTrue: [
					^wrap: n opener: 'code' closer: 'endCode'
				].
			tag = 'u' ifTrue: [ ^wrap: n opener: 'underline' closer: 'endUnderline' ].
			({'s'. 'strike'. 'del'. } includes: tag) ifTrue: [
					^wrap: n opener: 'strikethrough' closer: 'endStrikethrough'
				].
			tag = 'sub' ifTrue: [ ^wrap: n opener: 'subscript' closer: 'endSubscript' ].
			tag = 'sup' ifTrue: [
					^wrap: n opener: 'superscript' closer: 'endSuperscript'
				].
			tag = 'a' ifTrue: [ ^link: n ].
			tag = 'mark' ifTrue: [ lose: tag detail: (detailOf: n) ].
			(hasOtherStyle: n) ifTrue: [ lose: 'style attribute' detail: (detailOf: n) ].
			colored: n
		)
		inlineAmplet: n = (
			(* An amplet in inline content: an inline leaf of the paragraph. *)
			
			| s = ampletStatement: n. |
			s isNil ifTrue: [ ^self ].
			ensureParagraph.
			applyBreaks.
			send: s.
			paragraphEmpty:: false.
			contentSeen:: true
		)
		public inlineChildren: n = (
			n children do: [:c | inlineNode: c ]
		)
		inlineNode: n = (
			n isText ifTrue: [ ^emitText: n text ].
			n tag = 'br' ifTrue: [
					breaks:: breaks + 1.
					^self
				].
			((inlineTags includes: n tag) and: [ (isAmplet: n) not ]) ifTrue: [
					^inline: n
				].
			(isAmplet: n) ifTrue: [ ^inlineAmplet: n ].
			(inlineDepth = 0 and: [ literal not ]) ifTrue: [ ^block: n ].
			(transparentBlocks includes: n tag) ifFalse: [
					lose: 'block in inline content' detail: (detailOf: n)
				].
			(literal not and: [ (alignmentOf: n) isNil not and: [ hasContent: n ] ]) ifTrue: [
					lose: 'alignment in inline content' detail: (detailOf: n)
				].
			paragraphEmpty ifFalse: [ breaks:: breaks max: 1 ].
			inlineChildren: n
		)
		keep: n as: kind detail: d = (
			(* What has no block: an html: display of its HTML, and a Loss. *)
			
			lose: kind detail: d.
			(inlineDepth > 0 or: [ literal ]) ifTrue: [ ^self ].
			display: (htmlOf: n)
		)
		lineBreak = (
			(* A line break in the source between blocks, for readability; it
is white space in flow content, so it adds nothing. *)
			
			flowDepth = 0 ifFalse: [ ^self ].
			literal ifTrue: [ ^self ].
			flush.
			out add: (emmanuel stringOfCodePoints: {10. }).
			textAtEnd:: false
		)
		link: n = (
			(* An anchor: a link around its text when it has a target; inside
another link, only its text. A target that is an id of the document's
anchors links to it within the page. *)
			
			| href ::= n attribute: 'href'. |
			(href isNil or: [ isBlank: href ]) ifTrue: [ ^inlineChildren: n ].
			(anchors includes: href) ifTrue: [ href:: '#' , href ].
			inLink ifTrue: [
					lose: 'link in a link' detail: href.
					^inlineChildren: n
				].
			inLink:: true.
			wrap: n opener: 'link: ' , (stringLiteral: href) closer: 'endLink'.
			inLink:: false
		)
		list: n opener: o closer: c = (
			closeParagraph.
			send: o.
			contentSeen:: true.
			flowDepth:: flowDepth + 1.
			n children do: [:child |
					child isText ifTrue: [
							(isBlank: child text) ifFalse: [
									lose: 'list content outside an item' detail: child text.
									listItem: {child. }
								]
						]
						ifFalse: [
							child tag = 'li' ifTrue: [ listItem: child children ]
								ifFalse: [
									lose: 'list content outside an item' detail: (detailOf: child).
									listItem: {child. }
								]
						]
				].
			flowDepth:: flowDepth - 1.
			send: c.
			lineBreak
		)
		listItem: nodes = (
			send: 'item'.
			flow: nodes.
			closeParagraph.
			send: 'endItem'
		)
		lose: kind detail: d = (
			losses add: (Loss kind: kind detail: d)
		)
		openParagraph = (
			send: 'paragraph'.
			inParagraph:: true.
			paragraphEmpty:: true
		)
		pre: n = (
			| text = textOf: n. code = n children anySatisfy: [:c |
					c isText not and: [ c tag = 'code' ]
				]. |
			closeParagraph.
			text isEmpty ifTrue: [ ^self ].
			send: (code ifTrue: [ 'codeBlock: ' ] ifFalse: [ 'verbatim: ' ]) , (stringLiteral: text).
			contentSeen:: true.
			lineBreak
		)
		public root: nodes = (
			(* Convert the flow content of a document. *)
			
			| ids = List new. |
			anchorIdsIn: nodes into: ids.
			anchors:: ids asArray.
			flow: nodes.
			dropLabel.
			closeParagraph.
			[ sections isEmpty ] whileFalse: [
					send: 'endSection'.
					sections removeLast
				].
			flush
		)
		send: statement = (
			pending add: statement
		)
		public source = (
			flush.
			^join: out asArray with: ''
		)
		table: n = (
			closeParagraph.
			send: 'table'.
			contentSeen:: true.
			flowDepth:: flowDepth + 1.
			(rowsOf: n) do: [:row |
					| cells = row children reject: [:c | c isText ]. header = cells isEmpty not and: [
							cells allSatisfy: [:c | c tag = 'th' ]
						]. |
					send: (header ifTrue: [ 'headerRow' ] ifFalse: [ 'row' ]).
					cells do: [:cell |
							({'td'. 'th'. } includes: cell tag) ifTrue: [
									| saved = cellDepth. |
									send: 'cell'.
									cellDepth:: flowDepth.
									flow: cell children.
									cellDepth:: saved.
									closeParagraph.
									send: 'endCell'
								]
								ifFalse: [
									lose: 'table content outside a cell' detail: (detailOf: cell)
								]
						].
					send: 'endRow'
				].
			flowDepth:: flowDepth - 1.
			send: 'endTable'.
			lineBreak
		)
		trimTrailingSpace = (
			| last = emmanuel codePointsOf: out last. trimmed = stripTrailing: last. |
			trimmed size = last size ifTrue: [ ^self ].
			out removeLast.
			trimmed isEmpty ifFalse: [ out add: (emmanuel stringOfCodePoints: trimmed) ]
		)
		wrap: n opener: o closer: c = (
			send: o.
			inlineDepth:: inlineDepth + 1.
			inlineChildren: n.
			breaks:: 0.
			inlineDepth:: inlineDepth - 1.
			send: c
		)
	) : ()
	public class Element tag: t attributes: as children: cs = (
		(* An HTML element: its tag (in lower case), its attributes (pairs of
name and value, in order), and its children (Elements and Texts). *)
		
		|
			public tag = t.
			public attributes = as.
			public children = cs.
		|
	) (
		public attribute: name = (
			attributes do: [:a | (a at: 1) = name ifTrue: [ ^a at: 2 ] ].
			^nil
		)
		public isText = (
			^false
		)
	) : ()
	public class Loss kind: k detail: d = (
		(* A construct that has no block in the library: its kind (a tag, or
a description) and a detail, such as an amplet's expression or a link's
target. *)
		
		|
			public kind = k.
			public detail = d.
		|
	) (
	) : ()
	public class Text text: s = (
		(* A text node. *)
		
		|
			public text = s.
		|
	) (
		public isText = (
			^true
		)
	) : ()
	addTableBordersIn: nodes to: borders = (
		(* Record in borders, {table's. cells'.}, the borders that the style
elements among nodes give tables and their cells, or that a table's border
attribute gives them. *)
		
		nodes do: [:n |
				n isText ifFalse: [
						n tag = 'style' ifTrue: [ addTableBordersOf: (textOf: n) to: borders ].
						(n tag = 'table' and: [ hasBorderAttribute: n ]) ifTrue: [
								(borders at: 1) isNil ifTrue: [ borders at: 1 put: '1px solid' ].
								(borders at: 2) isNil ifTrue: [ borders at: 2 put: '1px solid' ]
							].
						addTableBordersIn: n children to: borders
					]
			]
	)
	addTableBordersOf: css to: borders = (
		(* Record in borders, {table's. cells'.}, the border declarations of
the rules of the style sheet css whose selectors include table, or td or th. *)
		
		| cps = emmanuel codePointsOf: css. start ::= 1. selectors ::= nil. |
		1 to: cps size
			do: [:i |
				(cps at: i) = 123 ifTrue: [
						selectors:: cps copyFrom: start to: i - 1.
						start:: i + 1
					].
				(cps at: i) = 125 ifTrue: [
						| border |
						selectors isNil ifFalse: [
								border:: borderIn: (cps copyFrom: start to: i - 1).
								border isNil ifFalse: [
										(selectorsIn: selectors) do: [:s |
												s = 'table' ifTrue: [ borders at: 1 put: border ].
												(s = 'td' or: [ s = 'th' ]) ifTrue: [ borders at: 2 put: border ]
											]
									]
							].
						selectors:: nil.
						start:: i + 1
					]
			]
	)
	alignmentOf: n = (
		(* How the element n aligns its content: 'center', 'right', or
'justify', as a center element, an align attribute, or text-align in its
style say; nil for the default (left, start). *)
		
		| a |
		n isText ifTrue: [ ^nil ].
		n tag = 'center' ifTrue: [ ^'center' ].
		a:: n attribute: 'align'.
		a isNil ifTrue: [ a:: styleValue: 'text-align' of: n ].
		a isNil ifTrue: [ ^nil ].
		({'center'. '-webkit-center'. 'middle'. } includes: a) ifTrue: [ ^'center' ].
		({'right'. '-webkit-right'. 'end'. } includes: a) ifTrue: [ ^'right' ].
		a = 'justify' ifTrue: [ ^'justify' ].
		^nil
	)
	backgroundIn: nodes = (
		(* The background image the style elements among nodes give, as a
deck's slides and the blog pages set it (background-image: url(...) in a
style element); nil when they give none. *)
		
		nodes do: [:n |
				| image |
				n isText ifFalse: [
						image:: n tag = 'style' ifTrue: [ backgroundOf: (textOf: n) ]
							ifFalse: [ backgroundIn: n children ].
						image isNil ifFalse: [ ^image ]
					]
			].
		^nil
	)
	backgroundOf: css = (
		(* The URL of the first background declaration with a url(...) in the
style sheet css, unquoted; nil when there is none. *)
		
		| cps = emmanuel codePointsOf: css. start ::= 1. |
		1 to: cps size + 1
			do: [:i |
				(i > cps size or: [ {59. 123. 125. } includes: (cps at: i) ]) ifTrue: [
						| decl = stripLeading: (cps copyFrom: start to: i - 1). url |
						url:: (startsWith: 'background' in: decl) ifTrue: [ urlIn: decl ].
						url isNil ifFalse: [ ^url ].
						start:: i + 1
					]
			].
		^nil
	)
	borderIn: cps = (
		(* The value of the border declaration among the declarations cps (a
rule's, between its braces), or nil. *)
		
		| start ::= 1. |
		1 to: cps size + 1
			do: [:i |
				(i > cps size or: [ (cps at: i) = 59 ]) ifTrue: [
						| decl = stripLeading: (cps copyFrom: start to: i - 1). colon ::= 0. |
						1 to: decl size
							do: [:k | (colon = 0 and: [ (decl at: k) = 58 ]) ifTrue: [ colon:: k ] ].
						(colon > 0 and: [
								(emmanuel stringOfCodePoints: (stripTrailing: (decl copyFrom: 1
											to: colon - 1))) = 'border'
							]) ifTrue: [
								^emmanuel stringOfCodePoints: (stripTrailing: (stripLeading: (decl copyFrom: colon + 1
												to: decl size)))
							].
						start:: i + 1
					]
			].
		^nil
	)
	public convert: nodes = (
		(* The conversion of a sequence of nodes, as flow content. Its looks
center a centered title, and draw tables and their cells with the borders the
original drew them with (tableBordersIn:). *)
		
		| c = Converter literal: false. r borders = tableBordersIn: nodes. looks = List new. |
		c root: nodes.
		r:: Conversion source: c source losses: c losses asArray.
		c titleCentered ifTrue: [ looks add: {#title. 'text-align: center;'. } ].
		(borders at: 1) isNil ifFalse: [
				looks add: {#table. 'border: ' , (borders at: 1) , ';'. }
			].
		(borders at: 2) isNil ifFalse: [
				looks add: {#cell. 'border: ' , (borders at: 2) , ';'. }
			].
		r looks: looks asArray.
		^r
	)
	public convertDocument: root = (
		(* The conversion of an Ampleforth document: the content of its
self_ampleforth element, or of root when it has none. A background image
its style elements give becomes background:; a slide (an editable frame of
fixed height as well as width, as Telescreen's slides have) gets page:
'slide'. Other frame widths were the editor's, not the document's, and are
dropped. *)
		
		| body = findClass: 'self_ampleforth' in: root. nodes = body isNil ifTrue: [
				root children
			]
			ifFalse: [ body children ]. c = convert: nodes. image = backgroundIn: nodes. head ::= ''. r |
		image isNil ifFalse: [
				head:: '[\background: ' , (stringLiteral: image) , '\]'
			].
		(body isNil not and: [ isSlideFrame: body ]) ifTrue: [
				head:: head , '[\page: ''slide''\]'
			].
		head isEmpty ifTrue: [ ^c ].
		r:: Conversion source: head , c source losses: c losses.
		r looks: c looks.
		^r
	)
	detailOf: n = (
		| h = htmlOf: n. |
		h size > 80 ifTrue: [ ^(h copyFrom: 1 to: 80) , '...' ].
		^h
	)
	dotsAsSpaces: s = (
		^emmanuel stringOfCodePoints: ((emmanuel codePointsOf: s) collect: [:c |
					c = 46 ifTrue: [ 32 ] ifFalse: [ c ]
				])
	)
	droppedTags = (
		^{'script'. 'style'. 'link'. 'meta'. 'title'. 'head'. 'noscript'. 'template'. }
	)
	escapeHTML: s attribute: inAttribute = (
		| out = List new. |
		(emmanuel codePointsOf: s) do: [:c |
				c = 38 ifTrue: [ out addAll: (emmanuel codePointsOf: '&amp;') ]
					ifFalse: [
						c = 60 ifTrue: [ out addAll: (emmanuel codePointsOf: '&lt;') ]
							ifFalse: [
								c = 62 ifTrue: [ out addAll: (emmanuel codePointsOf: '&gt;') ]
									ifFalse: [
										(inAttribute and: [ c = 34 ]) ifTrue: [
												out addAll: (emmanuel codePointsOf: '&quot;')
											]
											ifFalse: [ out add: c ]
									]
							]
					]
			].
		^emmanuel stringOfCodePoints: out asArray
	)
	findClass: name in: n = (
		| found |
		n isText ifTrue: [ ^nil ].
		(hasClass: name in: n) ifTrue: [ ^n ].
		n children do: [:c |
				found:: findClass: name in: c.
				found isNil ifFalse: [ ^found ]
			].
		^nil
	)
	public fromDOM: node = (
		(* The Element or Text of a DOM node, or nil for other nodes, such as
comments. *)
		
		| type = node at: #nodeType. attrs jsAttrs jsChildren kids |
		type = 3 ifTrue: [ ^Text text: (node at: #nodeValue) ].
		type = 1 ifFalse: [ ^nil ].
		jsAttrs:: node at: #attributes.
		attrs:: (0 to: (jsAttrs at: #length) - 1) asArray collect: [:i |
				| a = jsAttrs at: i. |
				{a at: #name. a at: #value. }
			].
		jsChildren:: node at: #childNodes.
		kids:: List new.
		0 to: (jsChildren at: #length) - 1
			do: [:i |
				| k = fromDOM: (jsChildren at: i). |
				k isNil ifFalse: [ kids add: k ]
			].
		^Element tag: (node at: #localName) attributes: attrs children: kids asArray
	)
	public fromHTML: html = (
		(* The Element of the body of an HTML string, parsed by the browser. *)
		
		^fromDOM: ((DOMParser new parseFromString: html mimeType: 'text/html') at: #body)
	)
	hasBorderAttribute: table = (
		(* Whether a table element has a border, by its border attribute: one
present and not 0, as an empty one is (a border of 1). *)
		
		| b = table attribute: 'border'. |
		^b isNil not and: [ (b = '0') not ]
	)
	hasClass: name in: n = (
		| classes = n attribute: 'class'. |
		classes isNil ifTrue: [ ^false ].
		^(words: classes) includes: name
	)
	hasContent: n = (
		(* Whether n shows anything: text that is not blank, or an amplet,
image, or rule. *)
		
		n isText ifTrue: [ ^(isBlank: n text) not ].
		(isAmplet: n) ifTrue: [ ^true ].
		({'img'. 'hr'. 'table'. 'iframe'. 'video'. } includes: n tag) ifTrue: [ ^true ].
		^n children anySatisfy: [:c | hasContent: c ]
	)
	hasOtherStyle: n = (
		(* Whether the style attribute of n declares anything but the colors
the conversion keeps (color, background-color). *)
		
		^(stylePropertiesOf: n) anySatisfy: [:x |
				({'color'. 'background-color'. } includes: x) not
			]
	)
	headingLevel: tag = (
		^(emmanuel codePointsOf: tag) last - 48
	)
	highlightOf: n = (
		(* The background color n gives its text: its style's
background-color, unless that is the default (white, or none); nil when
there is none. *)
		
		| v = styleValue: 'background-color' of: n. |
		(v isNil or: [
				{'transparent'. 'white'. '#fff'. '#ffffff'. 'rgb(255,255,255)'. 'rgba(0,0,0,0)'. 'inherit'. 'initial'. } includes: (normalColor: v)
			]) ifTrue: [ ^nil ].
		^v
	)
	public htmlOf: n = (
		(* The HTML of a node. *)
		
		| out ::= ''. |
		n isText ifTrue: [ ^escapeHTML: n text attribute: false ].
		out:: '<' , n tag.
		n attributes do: [:a |
				out:: out , ' ' , (a at: 1) , '="' , (escapeHTML: (a at: 2) attribute: true) , '"'
			].
		out:: out , '>'.
		(voidTags includes: n tag) ifTrue: [ ^out ].
		n children do: [:c | out:: out , (htmlOf: c) ].
		^out , '</' , n tag , '>'
	)
	inlineTags = (
		^{'i'. 'em'. 'b'. 'strong'. 'code'. 'tt'. 'kbd'. 'samp'. 'span'. 'font'. 'a'. 'u'. 's'. 'strike'. 'sub'. 'sup'. 'small'. 'big'. 'mark'. 'abbr'. 'cite'. 'q'. 'var'. 'label'. }
	)
	isAmplet: n = (
		(* An amplet, or an image of the document's media, which is one. *)
		
		^(hasClass: 'ampleforth' in: n) or: [ isMediaImage: n ]
	)
	isBlank: s = (
		^(emmanuel codePointsOf: s) allSatisfy: [:c | isWhiteSpace: c ]
	)
	isCentered: n = (
		(* Whether the heading n is centered: by its own style, or by the one
element that holds all it shows. *)
		
		| shown |
		(alignmentOf: n) = 'center' ifTrue: [ ^true ].
		shown:: n children select: [:c | hasContent: c ].
		^shown size = 1 and: [ (alignmentOf: shown first) = 'center' ]
	)
	isEmptyInline: n = (
		(* An inline element with no text and nothing visible in it. *)
		
		n isText ifTrue: [ ^isBlank: n text ].
		({'br'. 'img'. } includes: n tag) ifTrue: [ ^false ].
		(isAmplet: n) ifTrue: [ ^false ].
		^n children allSatisfy: [:c | isEmptyInline: c ]
	)
	isMediaImage: n = (
		(* An image of the document's media: Ampleforth's legacy form, an img
whose source is in the document's images folder; or, in a document the IDE
has loaded, an img whose source is a blob: URL the IDE made for one of its
media files, which its name attribute names. *)
		
		| src name |
		n isText ifTrue: [ ^false ].
		n tag = 'img' ifFalse: [ ^false ].
		src:: n attribute: 'src'.
		src isNil ifTrue: [ ^false ].
		((emmanuel codePointsOf: src) size > 9 and: [
				(src copyFrom: 1 to: 9) = './images/'
			]) ifTrue: [ ^true ].
		name:: n attribute: 'name'.
		^(emmanuel codePointsOf: src) size > 5 and: [
				(src copyFrom: 1 to: 5) = 'blob:' and: [
						name isNil not and: [ (isBlank: name) not ]
					]
			]
	)
	isSlideFrame: n = (
		(* Whether the editable frame n has a fixed height, as a slide's has. *)
		
		| style = n attribute: 'style'. |
		style isNil ifTrue: [ ^false ].
		^(words: (semicolonsAsSpaces: style)) anySatisfy: [:part |
				| cps = emmanuel codePointsOf: part. |
				cps size > 7 and: [
						(emmanuel stringOfCodePoints: (cps copyFrom: 1 to: 7)) = 'height:'
					]
			]
	)
	isWhiteSpace: c = (
		^{32. 9. 10. 13. 12. } includes: c
	)
	join: strings with: separator = (
		| out ::= ''. |
		strings keysAndValuesDo: [:i :s |
				i > 1 ifTrue: [ out:: out , separator ].
				out:: out , s
			].
		^out
	)
	mediaCode: n = (
		(* The amplet code of a media image: Ampleforth's preferred form,
mediaFromFileNamed:type: (with width: when it has a width), which finds
the file in the document's media registry: the file its name attribute
names, or else the one its source names in the images folder. *)
		
		| src = n attribute: 'src'. file = n attribute: 'name'. width = widthOf: n. code |
		(file isNil or: [ isBlank: file ]) ifTrue: [
				file:: src copyFrom: 10 to: src size
			].
		code:: 'mediaFromFileNamed: ' , (stringLiteral: file) , ' type: ' , (stringLiteral: (mimeTypeOf: file)).
		width isNil ifFalse: [ code:: code , ' width: ' , (stringLiteral: width) ].
		^code
	)
	mimeTypeOf: file = (
		| w = words: (dotsAsSpaces: file). ext = w isEmpty ifTrue: [ '' ]
			ifFalse: [ w last ]. |
		(ext = 'jpg' or: [ ext = 'jpeg' or: [ ext = 'JPG' or: [ ext = 'JPEG' ] ] ]) ifTrue: [
				^'image/jpeg'
			].
		(ext = 'png' or: [ ext = 'PNG' ]) ifTrue: [ ^'image/png' ].
		(ext = 'gif' or: [ ext = 'GIF' ]) ifTrue: [ ^'image/gif' ].
		ext = 'webp' ifTrue: [ ^'image/webp' ].
		ext = 'svg' ifTrue: [ ^'image/svg+xml' ].
		^'image'
	)
	normalColor: v = (
		(* The CSS color v in lower case without spaces, for comparing. *)
		
		^emmanuel stringOfCodePoints: (((emmanuel codePointsOf: v) reject: [:c |
					c = 32
				]) collect: [:c | (c between: 65 and: 90) ifTrue: [ c + 32 ] ifFalse: [ c ] ])
	)
	rowsOf: table = (
		(* The rows of a table, through its thead, tbody and tfoot. *)
		
		| rows = List new. |
		table children do: [:c |
				c isText ifFalse: [
						c tag = 'tr' ifTrue: [ rows add: c ]
							ifFalse: [
								({'thead'. 'tbody'. 'tfoot'. } includes: c tag) ifTrue: [
										rows addAll: (rowsOf: c)
									]
							]
					]
			].
		^rows asArray
	)
	selectorsIn: cps = (
		(* The selectors of a rule, split at its commas, without white space
around them. *)
		
		| out = List new. start ::= 1. |
		1 to: cps size + 1
			do: [:i |
				(i > cps size or: [ (cps at: i) = 44 ]) ifTrue: [
						out add: (emmanuel stringOfCodePoints: (stripTrailing: (stripLeading: (cps copyFrom: start
											to: i - 1)))).
						start:: i + 1
					]
			].
		^out
	)
	semicolonsAsSpaces: s = (
		(* s with each semicolon a space, and the space after each colon
removed, so that width: 321px is one word. *)
		
		| out = List new. cps = emmanuel codePointsOf: s. k ::= 1. |
		[ k <= cps size ] whileTrue: [
				| c = cps at: k. |
				c = 59 ifTrue: [ out add: 32 ] ifFalse: [ out add: c ].
				(c = 58 and: [ k < cps size and: [ (cps at: k + 1) = 32 ] ]) ifTrue: [
						k:: k + 1
					].
				k:: k + 1
			].
		^emmanuel stringOfCodePoints: out asArray
	)
	startsWith: prefix in: cps = (
		| p = emmanuel codePointsOf: prefix. |
		cps size < p size ifTrue: [ ^false ].
		^(emmanuel stringOfCodePoints: (cps copyFrom: 1 to: p size)) = prefix
	)
	stringLiteral: s = (
		(* A Newspeak string literal of s. *)
		
		| out = List new. |
		out add: 39.
		(emmanuel codePointsOf: s) do: [:c |
				c = 39 ifTrue: [ out add: 39 ].
				out add: c
			].
		out add: 39.
		^emmanuel stringOfCodePoints: out asArray
	)
	stripLeading: cps = (
		| k ::= 1. |
		[ k <= cps size and: [ isWhiteSpace: (cps at: k) ] ] whileTrue: [ k:: k + 1 ].
		^cps copyFrom: k to: cps size
	)
	stripTrailing: cps = (
		| k ::= cps size. |
		[ k >= 1 and: [ isWhiteSpace: (cps at: k) ] ] whileTrue: [ k:: k - 1 ].
		^cps copyFrom: 1 to: k
	)
	stylePropertiesOf: n = (
		(* The properties the style attribute of n declares, in order. *)
		
		| style = n attribute: 'style'. cps start ::= 1. out = List new. |
		style isNil ifTrue: [ ^{} ].
		cps:: emmanuel codePointsOf: style.
		1 to: cps size + 1
			do: [:i |
				(i > cps size or: [ (cps at: i) = 59 ]) ifTrue: [
						| decl = cps copyFrom: start to: i - 1. colon = decl indexOf: 58. |
						colon > 0 ifTrue: [
								out add: (emmanuel stringOfCodePoints: (stripTrailing: (stripLeading: (decl copyFrom: 1
													to: colon - 1))))
							].
						start:: i + 1
					]
			].
		^out asArray
	)
	styleValue: property of: n = (
		(* The value the style attribute of n gives property, without
surrounding space; nil when it gives none. *)
		
		| style = n attribute: 'style'. cps start ::= 1. |
		style isNil ifTrue: [ ^nil ].
		cps:: emmanuel codePointsOf: style.
		1 to: cps size + 1
			do: [:i |
				(i > cps size or: [ (cps at: i) = 59 ]) ifTrue: [
						| decl = cps copyFrom: start to: i - 1. colon = decl indexOf: 58. |
						colon > 0 ifTrue: [
								(emmanuel stringOfCodePoints: (stripTrailing: (stripLeading: (decl copyFrom: 1
												to: colon - 1)))) = property ifTrue: [
										^emmanuel stringOfCodePoints: (stripTrailing: (stripLeading: (decl copyFrom: colon + 1
														to: decl size)))
									]
							].
						start:: i + 1
					]
			].
		^nil
	)
	tableBordersIn: nodes = (
		(* The borders the original drew its tables and their cells with,
{table's. cells'.}, each a CSS border value or nil: the border declarations
of its style elements' rules for table, td and th (a document's style sheet,
as the blog's pages have one), or a table's border attribute (1px solid, the
attribute's drawing in short). They are the document's, not one table's. *)
		
		| borders = Array new: 2. |
		addTableBordersIn: nodes to: borders.
		^borders
	)
	textColorOf: n = (
		(* The color n gives its text: its style's color, or a font element's
color attribute, unless that is the default (black); nil when there is
none. *)
		
		| v ::= styleValue: 'color' of: n. |
		(v isNil and: [ n tag = 'font' ]) ifTrue: [ v:: n attribute: 'color' ].
		(v isNil or: [
				{'black'. '#000'. '#000000'. 'rgb(0,0,0)'. 'inherit'. 'initial'. 'currentcolor'. } includes: (normalColor: v)
			]) ifTrue: [ ^nil ].
		^v
	)
	textOf: n = (
		(* The text of a node and its descendants. *)
		
		| out ::= ''. |
		n isText ifTrue: [ ^n text ].
		n tag = 'br' ifTrue: [ ^emmanuel stringOfCodePoints: {10. } ].
		n children do: [:c | out:: out , (textOf: c) ].
		^out
	)
	transparentBlocks = (
		^{'div'. 'center'. 'section'. 'article'. 'main'. 'header'. 'footer'. 'nav'. 'aside'. 'body'. 'html'. 'li'. 'dl'. 'dt'. 'dd'. 'figure'. 'figcaption'. 'details'. 'summary'. 'form'. }
	)
	urlIn: cps = (
		(* The URL of the first url(...) in the code points cps, without
white space and quotes; nil when there is none or it is empty. *)
		
		| from to url |
		1 to: cps size - 3
			do: [:i |
				(from isNil and: [
						(emmanuel stringOfCodePoints: (cps copyFrom: i to: i + 3)) = 'url('
					]) ifTrue: [ from:: i + 4 ]
			].
		from isNil ifTrue: [ ^nil ].
		to:: from.
		[ to <= cps size and: [ (cps at: to) ~= 41 ] ] whileTrue: [ to:: to + 1 ].
		url:: stripTrailing: (stripLeading: (cps copyFrom: from to: to - 1)).
		(url isEmpty not and: [ {34. 39. } includes: url first ]) ifTrue: [
				url:: url copyFrom: 2 to: url size
			].
		(url isEmpty not and: [ {34. 39. } includes: url last ]) ifTrue: [
				url:: url copyFrom: 1 to: url size - 1
			].
		url isEmpty ifTrue: [ ^nil ].
		^emmanuel stringOfCodePoints: url
	)
	voidTags = (
		^{'br'. 'hr'. 'img'. 'input'. 'meta'. 'link'. 'area'. 'base'. 'col'. 'embed'. 'source'. 'track'. 'wbr'. }
	)
	widthOf: n = (
		(* The width of an image, as CSS: its width attribute in pixels, or the
width in its style; nil when it has none. *)
		
		| w = n attribute: 'width'. style = n attribute: 'style'. i rest |
		(w isNil not and: [ (isBlank: w) not ]) ifTrue: [
				^((emmanuel codePointsOf: w) allSatisfy: [:c | c between: 48 and: 57 ]) ifTrue: [
						w , 'px'
					]
					ifFalse: [ w ]
			].
		style isNil ifTrue: [ ^nil ].
		(words: (semicolonsAsSpaces: style)) do: [:part |
				| cps = emmanuel codePointsOf: part. |
				(cps size > 6 and: [
						(emmanuel stringOfCodePoints: (cps copyFrom: 1 to: 6)) = 'width:'
					]) ifTrue: [ ^emmanuel stringOfCodePoints: (cps copyFrom: 7 to: cps size) ]
			].
		^nil
	)
	words: s = (
		(* The words of s, separated by white space. *)
		
		| out = List new. word = List new. |
		(emmanuel codePointsOf: s) do: [:c |
				(isWhiteSpace: c) ifTrue: [
						word isEmpty ifFalse: [
								out add: (emmanuel stringOfCodePoints: word asArray).
								word removeAll
							]
					]
					ifFalse: [ word add: c ]
			].
		word isEmpty ifFalse: [ out add: (emmanuel stringOfCodePoints: word asArray) ].
		^out asArray
	)
) : ()
