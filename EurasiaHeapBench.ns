Newspeak3
'Eurasia'
class EurasiaHeapBench usingPlatform: platform = (
	(* A large-heap probe: a million small objects, scattered among fillers, walked by their accessors; and the same walking work over a thousand objects, which stay in cache. Prints milliseconds. *)
	
	|
		Kernel
		PrimordialSoupCollections
		Actors
		Runtime
	|
) (
	class Node new = (
		|
			public a
			public b
			public c
			public next
		|
	) (
	) : ()
	build: n fillers: fillers = (
		| head |
		1 to: n
			do: [:i |
				| node |
				node:: Node new.
				node a: i.
				node b: i.
				node c: i.
				node next: head.
				head:: node.
				fillers at: i put: (Array new: 6)
			].
		^head
	)
	public main: platform args: args = (
		| big small sw fillers |
		sw:: Stopwatch new start.
		fillers:: Array new: 1000000.
		big:: build: 1000000 fillers: fillers.
		vm print: 'build 1000000: ' , sw elapsedMilliseconds printString , ' ms'.
		small:: build: 1000 fillers: (Array new: 1000).
		walk: big times: 1.
		walk: small times: 1000.
		1 to: 3
			do: [:k |
				sw:: Stopwatch new start.
				walk: big times: 10.
				vm print: 'walk big (10 x 1000000): ' , sw elapsedMilliseconds printString , ' ms'.
				sw:: Stopwatch new start.
				walk: small times: 10000.
				vm print: 'walk small (10000 x 1000): ' , sw elapsedMilliseconds printString , ' ms'
			].
		vm print: 'done'
	)
	public platformOver: internalKernel = (
		^(Runtime kernel: Kernel collections: PrimordialSoupCollections actors: Actors) Platform internalKernel: internalKernel
	)
	walk: head times: count = (
		| sum |
		sum:: 0.
		count timesRepeat: [
				| p |
				p:: head.
				[ p isNil ] whileFalse: [
						sum:: sum + p a + p b.
						p:: p next
					]
			].
		^sum
	)
) : ()
