Newspeak3
'Eurasia'
class EurasiaCounterApp usingPlatform: platform = (
	(* CounterApp (CounterApp.ns) on Eurasia's web host: the genesis packager packages it as if nested in InternalKernel and fills the slots below with the packaged modules. Genesis builds the platform (platformOver:), Eurasia's base platform extended with Hopscotch (WebRuntime); in a browser the message loop then delivers main:args:, which opens the counter's window. eurasia/scripts/web-tests.sh builds it. *)
	
	|
		Kernel
		PrimordialSoupCollections
		Actors
		Runtime
		Ducts
		GraphicsForHTML5
		FontsForHTML5
		TextModule
		HopscotchForHTML5
		VoiceController
		AIAccess
		WebRuntime
		CounterUI
	|
) (
	public main: platform args: args = (
		| ui = CounterUI usingPlatform: platform. |
		platform hopscotch HopscotchWindow openSubject: (ui CounterSubject onModel: ui Counter new)
	)
	public platformOver: internalKernel = (
		| base |
		base:: (Runtime kernel: Kernel
			collections: PrimordialSoupCollections
			actors: Actors) Platform internalKernel: internalKernel.
		^(WebRuntime internalKernel: nil
			hopscotch: HopscotchForHTML5
			ducts: Ducts
			graphics: GraphicsForHTML5
			fonts: FontsForHTML5
			text: TextModule
			voiceController: VoiceController
			aiAccess: AIAccess) Platform over: base
	)
) : ()
