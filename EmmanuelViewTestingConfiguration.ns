Newspeak3
'Emmanuel'
class EmmanuelViewTestingConfiguration packageTestsUsing: manifest = (
	(* From tool/:
  ./run-tests.sh EmmanuelViewTestingConfiguration ../Emmanuel.ns ../EmmanuelNewspeakHost.ns ../EmmanuelBlocks.ns ../AmpleforthView.ns ../NewspeakASTs.ns ../../primordialsoup/newspeak/NewspeakPredictiveParsing.ns

The tests run headless, where the platform has no GUI. The view is built
on a stub platform with the real collections, kernel, and mirrors (which
find the constructs of templates' libraries); its Hopscotch and
JavaScript are stubs, which the tests never use, since they look at trees
and never render them. *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelBlocks = manifest EmmanuelBlocks.
		private EmmanuelNewspeakHost = manifest EmmanuelNewspeakHost.
		private AmpleforthView = manifest AmpleforthView.
		private EmmanuelViewTesting = manifest EmmanuelViewTesting.
		private NewspeakASTs = manifest NewspeakASTs.
		private NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
	|
) (
	class Stub new = (
		(* Answers itself to every message. *)
		
	) (
		public doesNotUnderstand: message = (
			^self
		)
	) : ()
	class StubPlatform realPlatform: real = (
		(* The real collections, kernel, and mirrors; anything else is a Stub. *)
		
		|
			private realPlatform = real.
			private stub = Stub new.
		|
	) (
		public collections = (
			^realPlatform collections
		)
		public doesNotUnderstand: message = (
			^stub
		)
		public kernel = (
			^realPlatform kernel
		)
		public mirrors = (
			^realPlatform mirrors
		)
	) : ()
	public testModulesUsingPlatform: p minitest: m = (
		^{EmmanuelViewTesting usingPlatform: p
			minitest: m
			view: (AmpleforthView usingPlatform: (StubPlatform realPlatform: p)
				emmanuel: Emmanuel
				newspeakHost: EmmanuelNewspeakHost
				blocks: EmmanuelBlocks
				parsing: NewspeakPredictiveParsing
				asts: NewspeakASTs). }
	)
) : ()
