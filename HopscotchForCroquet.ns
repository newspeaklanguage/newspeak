			^newIdFor: 'hyperlinkImage'
		)
		newToggleComposerId ^<String> = (
			^newIdFor: 'toggleComposer'
		)
		newCheckboxId ^<String> = (
			^newIdFor: 'checkbox'
		)
		newTextEditorId ^<String> = (
			^newIdFor: 'textEditor'
		)
		rootModel ^<Alien[NewspeakCroquetView]> = (
			^rootView model
		)
		newPickerId ^<String> = (
			^newIdFor: 'picker'
		)
		newSliderId ^<String> = (
			^newIdFor: 'slider'
		)
		newColorPickerId ^<String> = (
			^newIdFor: 'colorPicker'
		)
		newDatePickerId ^<String> = (
			^newIdFor: 'datePicker'
		)
		newTimePickerId ^<String> = (
			^newIdFor: 'timePicker'
