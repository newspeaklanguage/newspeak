Newspeak3
'Emmanuel'
class EmmanuelTesting usingPlatform: p emmanuel: em = (
	(* Conformance of the Emmanuel reference implementation (Emmanuel.ns) with
the specification's regressions (formal-semantics/emmanuel/spectec/tests/cases.tsv).

A regression is a row: a name, a kind (relation or value), the relation or
result type, the query, and the expected result or truth. The Driver reads
the query's SpecTec terms into the reference's data, runs the corresponding
part of the reference, prints the result as a SpecTec term, and compares it
with the expected one. Terms are compared as sequences of atoms, numbers, and
strings: parentheses, commas, and eps, which only group, are ignored. A
relation row with truth false passes when the result differs.

The fixtures are those of the regressions: a host parser that is a table of
the brackets they contain (tests/host-fixtures.spectec, handed in by the
generated EmmanuelConformanceTesting), the fixture host evaluator and printer
(tests/host-eval-fixtures.spectec), and the fixture block signature
(tests/signature-fixtures.spectec), whose block states are DocumentBlocks. *)
	
	|
		private List = p collections List.
		private Map = p collections Map.
		private emmanuel = em.
		private DocumentBlock = em DocumentBlock.
	|
) (
	public class Driver hostTable: table constants: cs blocks: b edit: e = (
		(* Runs regression rows. b is the block library (EmmanuelBlocks) the
library's relations interpret documents with, and e the edit layer
(EmmanuelEdit) of the edit relations; the core's relations use the fixture
signature. *)
		
		|
			private host = FixtureHost table: table constants: cs.
			private blocks = b.
			private edit = e.
		|
	) (
		alternating: modes = (
			modes isEmpty ifTrue: [ ^false ].
			modes first = #text ifFalse: [ ^false ].
			2 to: modes size
				do: [:i | (modes at: i) = (modes at: i - 1) ifTrue: [ ^false ] ].
			^true
		)
		bool: b = (
			^b ifTrue: [ 'true' ] ifFalse: [ 'false' ]
		)
		callArgs: toks = (
			(* The argument components of a call $f(...): the tokens between its
parentheses, split at the commas outside any parentheses. *)
			
			| inner = toks copyFrom: 3 to: (matchingClose: toks from: 2) - 1. |
			^splitCommas: inner
		)
		compare: actual with: expected = (
			^(keyOf: actual) = (keyOf: expected)
		)
		docState = (
			^FixtureBlock name: 'doc' values: {}
		)
		editRelation: name readers: r = (
			(* The relations of the edit layer (Section 7, and the library's
helpers in library/tests/library-helpers.spectec). *)
			
			| t = emmanuel TermWriter new. w doc nodes tr mk pt ss result |
			name = 'Edit' ifTrue: [
					^termOf: (edit edit: (r at: 5) editTerm
							image: (r at: 1) image
							name: (r at: 2) string
							hostState: (r at: 3) hostState
							root: blocks DocumentRoot new
							host: host)
				].
			w:: (r at: 1) chars.
			name = 'LibEditCaret' ifTrue: [
					result:: edit edit: (r at: 2) editTerm
						image: {{'doc'. w. }. }
						name: 'doc'
						hostState: (FixtureState count: 0)
						root: blocks DocumentRoot new
						host: host.
					(result isNil or: [ result isRefused or: [ result caret isNil ] ]) ifTrue: [
							^nil
						].
					^termOf: (edit caretIn: {{'doc'. result chars. }. }
							name: 'doc'
							hostState: (FixtureState count: 0)
							root: blocks DocumentRoot new
							steps: (r at: 3) steps
							offset: result caret
							host: host)
				].
			doc:: edit document: {{'doc'. w. }. }
				name: 'doc'
				hostState: (FixtureState count: 0)
				root: blocks DocumentRoot new
				host: host.
			doc isNil ifTrue: [ ^nil ].
			nodes:: doc at: 1.
			tr:: doc at: 2.
			mk:: edit Markup document: 'doc' literal: nil.
			name = 'LibAnchor' ifTrue: [
					pt:: (r at: 2) point.
					^termOf: (edit anchor: nodes
							nav: (edit nav: mk tree: tr steps: pt steps)
							point: pt)
				].
			name = 'LibIsPoint' ifTrue: [
					^bool: (edit isPoint: mk tree: tr point: (r at: 2) point)
				].
			name = 'LibLoc' ifTrue: [
					ss:: (r at: 2) steps.
					t list: (edit rangesOf: nodes
							item: ((edit nav: mk tree: tr steps: ss) block items at: (r at: 3) nat + 1)).
					^t asString
				].
			name = 'LibBackspace' ifTrue: [
					ss:: (r at: 2) steps.
					^termOf: (edit backspace: mk tree: tr steps: ss index: (r at: 3) nat)
				].
			name = 'LibEnter' ifTrue: [
					^termOf: (edit enter: mk tree: tr caret: (r at: 2) caret)
				].
			name = 'LibInsertable' ifTrue: [
					pt:: (r at: 2) point.
					^bool: ((edit nav: mk tree: tr steps: pt steps) block state understands: (r at: 3) string)
				].
			name = 'LibInsert' ifTrue: [
					^termOf: (edit insertAt: mk
							tree: tr
							caret: (r at: 2) caret
							selector: (r at: 3) string)
				].
			name = 'LibPlace' ifTrue: [
					^termOf: (edit place: nodes tree: tr anchor: (r at: 2) anchor)
				].
			name = 'LibCaretOK' ifTrue: [
					^bool: (edit caretOK: nodes tree: tr steps: {} caret: (r at: 2) caret)
				].
			^Error signal: 'unknown edit relation ' , name
		)
		editRelations = (
			^{'Edit'. 'LibAnchor'. 'LibIsPoint'. 'LibLoc'. 'LibBackspace'. 'LibEnter'. 'LibInsertable'. 'LibInsert'. 'LibPlace'. 'LibCaretOK'. 'LibEditCaret'. }
		)
		interpretDoc: w state: chi = (
			^interpretDoc: w state: chi root: docState
		)
		interpretDoc: w state: chi root: k = (
			| parsed = emmanuel parse: 'doc' source: w host: host. |
			(parsed isNil or: [ parsed isKindOfParsed not ]) ifTrue: [ ^nil ].
			^(emmanuel Machine host: host) interpret: parsed nodes root: k hostState: chi
		)
		libDoc: w state: chi = (
			(* LibDoc: a source interpreted with the library's top-level block;
nil unless it finishes. *)
			
			| done = interpretDoc: w state: chi root: blocks DocumentRoot new. |
			(done isNil or: [ done isKindOfDone not ]) ifTrue: [ ^nil ].
			^done
		)
		matchingClose: toks from: k = (
			| depth ::= 0. |
			k to: toks size
				do: [:i |
					(toks at: i) kind = #open ifTrue: [ depth:: depth + 1 ].
					(toks at: i) kind = #close ifTrue: [
							depth:: depth - 1.
							depth = 0 ifTrue: [ ^i ]
						]
				].
			^Error signal: 'unbalanced term'
		)
		reader: toks = (
			^Reader tokens: toks edit: edit
		)
		relation: name query: q = (
			(* The result of a relation query, as a term, or nil when the
reference has none. *)
			
			| toks = tokenize: q. arrow comps r w t chi first second |
			arrow:: (1 to: toks size) detect: [:i | (toks at: i) kind = #arrow ]
				ifNone: [ nil ].
			name = 'ModeStack' ifTrue: [
					^emmanuel isModeStack: (reader: (stripParens: toks)) modes asArray
				].
			comps:: splitCommas: (stripParens: (toks copyFrom: 1 to: arrow - 1)).
			r:: comps collect: [:c | reader: c ].
			t:: emmanuel TermWriter new.
			name = 'Lexes' ifTrue: [ ^termOf: (emmanuel lex: (r at: 1) chars) ].
			name = 'LexRun' ifTrue: [
					^termOf: (emmanuel lexRun: (r at: 1) modes asArray
							offset: (r at: 2) nat
							chars: (r at: 3) chars)
				].
			name = 'LexStep' ifTrue: [
					w:: (r at: 2) chars.
					first:: emmanuel lexStep: (r at: 1) modes asArray chars: w at: 1.
					first isNil ifTrue: [ ^nil ].
					t term: first lexeme.
					first modes do: [:m |
							t atom: (m = #text ifTrue: [ 'TEXTMODE' ] ifFalse: [ 'CODEMODE' ])
						].
					t chars: (w copyFrom: first next to: w size).
					^t asString
				].
			name = 'Markup' ifTrue: [
					w:: (r at: 1) spanTokens asArray.
					first:: emmanuel parseMarkup: w from: 1.
					first isNil ifTrue: [ ^nil ].
					t list: (first at: 1).
					t list: (w copyFrom: (first at: 2) to: w size).
					^t asString
				].
			name = 'Parses' ifTrue: [
					^termOf: (emmanuel parse: (r at: 1) string
							source: (r at: 2) chars
							host: host)
				].
			name = 'Interp' ifTrue: [
					^termOf: ((emmanuel Machine host: host) interpret: (r at: 3) nodes asArray
							root: (r at: 2) blockState
							hostState: (r at: 1) hostState)
				].
			name = 'Doc' ifTrue: [
					^termOf: (interpretDoc: (r at: 2) chars state: (r at: 1) hostState)
				].
			(editRelations includes: name) ifTrue: [ ^editRelation: name readers: r ].
			name = 'LibTree' ifTrue: [
					first:: libDoc: (r at: 2) chars state: (r at: 1) hostState.
					first isNil ifTrue: [ ^nil ].
					^termOf: (emmanuel canon: first tree)
				].
			name = 'LibErrors' ifTrue: [
					first:: libDoc: (r at: 2) chars state: (r at: 1) hostState.
					first isNil ifTrue: [ ^nil ].
					second:: emmanuel canon: first tree.
					t list: (blocks libErrors: second);
						list: (emmanuel errors: second).
					^t asString
				].
			name = 'LibRoundTrip' ifTrue: [
					chi:: (r at: 1) hostState.
					w:: (r at: 2) chars.
					first:: libDoc: w state: chi.
					first isNil ifTrue: [ ^nil ].
					w:: emmanuel print: first tree source: w host: host.
					second:: libDoc: w state: chi.
					second isNil ifTrue: [ ^nil ].
					^roundTripTerm: w first: first second: second
				].
			name = 'RoundTrip' ifTrue: [
					chi:: (r at: 1) hostState.
					w:: (r at: 2) chars.
					first:: interpretDoc: w state: chi.
					(first isNil or: [ first isKindOfDone not ]) ifTrue: [ ^nil ].
					w:: emmanuel print: first tree source: w host: host.
					second:: interpretDoc: w state: chi.
					(second isNil or: [ second isKindOfDone not ]) ifTrue: [ ^nil ].
					^roundTripTerm: w first: first second: second
				].
			^Error signal: 'unknown relation ' , name
		)
		rhsOf: q = (
			| i = q indexOf: '=>'. |
			^q copyFrom: i + 2 to: q size
		)
		roundTripTerm: w first: first second: second = (
			(* The result of RoundTrip: the printed source w, whether its tree and
host state are those of the original, and whether printing it again gives w. *)
			
			| t = emmanuel TermWriter new. |
			t chars: w.
			t atom: (bool: ((emmanuel termStringOf: (emmanuel canon: first tree)) = (emmanuel termStringOf: (emmanuel canon: second tree)) and: [
							second hostState = first hostState
						])).
			t atom: (bool: (emmanuel stringOfCodePoints: (emmanuel print: second tree
							source: w
							host: host)) = (emmanuel stringOfCodePoints: w)).
			^t asString
		)
		public run: row = (
			(* Run a row: answers 'ok', or a description of the failure. *)
			
			| name = row at: 1. kind = row at: 2. what = row at: 3. query = row at: 4. expected = row at: 5. actual matched |
			kind = 'relation' ifTrue: [
					actual:: relation: what query: query.
					what = 'ModeStack' ifTrue: [
							^(bool: actual) = expected ifTrue: [ 'ok' ]
								ifFalse: [ name , ': ModeStack gave ' , (bool: actual) ]
						].
					matched:: actual isNil not and: [ compare: actual with: (rhsOf: query) ].
					matched = (expected = 'true') ifTrue: [ ^'ok' ].
					^name , ': expected ' , (rhsOf: query) , (expected = 'true' ifTrue: [ '' ]
						ifFalse: [ ' NOT to be derived' ]) , ', got ' , actual printString
				].
			actual:: value: query.
			(actual isNil not and: [ compare: actual with: expected ]) ifTrue: [ ^'ok' ].
			^name , ': expected ' , expected , ', got ' , actual printString
		)
		scanTerm: w end: e = (
			| t = emmanuel TermWriter new. |
			e isNil ifTrue: [ ^'UNCLOSED' ].
			t atom: 'SCANNED';
				chars: (w copyFrom: 1 to: e - 1);
				atom: 'REST';
				chars: (w copyFrom: e to: w size).
			^t asString
		)
		splitCommas: toks = (
			| out = List new. depth ::= 0. start ::= 1. |
			1 to: toks size
				do: [:i |
					| t = toks at: i. |
					t kind = #open ifTrue: [ depth:: depth + 1 ].
					t kind = #close ifTrue: [ depth:: depth - 1 ].
					(t kind = #comma and: [ depth = 0 ]) ifTrue: [
							out add: (toks copyFrom: start to: i - 1).
							start:: i + 1
						]
				].
			out add: (toks copyFrom: start to: toks size).
			^out asArray
		)
		stringOfTokens: q after: eq = (
			(* The text of a query after its top-level =; queries of this form are
$f(...) = $g(...), with no = inside the calls. *)
			
			^q copyFrom: (q indexOf: ' = ') + 3 to: q size
		)
		stringOfTokens: q before: eq = (
			^q copyFrom: 1 to: (q indexOf: ' = ') - 1
		)
		stripParens: toks = (
			(* Remove parentheses around the whole of a term. *)
			
			(toks size >= 2 and: [
					(toks at: 1) kind = #open and: [ (matchingClose: toks from: 1) = toks size ]
				]) ifTrue: [ ^stripParens: (toks copyFrom: 2 to: toks size - 1) ].
			^toks
		)
		termOf: x = (
			x isNil ifTrue: [ ^nil ].
			^emmanuel termStringOf: x
		)
		value: q = (
			(* The result of a value query, as a term. *)
			
			| toks = tokenize: q. f args r t w e eq left right |
			eq:: (1 to: toks size) detect: [:i | (toks at: i) kind = #eq ]
				ifNone: [ nil ].
			eq isNil ifFalse: [
					left:: value: (stringOfTokens: q before: eq).
					right:: value: (stringOfTokens: q after: eq).
					^bool: left = right
				].
			f:: (toks at: 1) value.
			args:: callArgs: toks.
			r:: args collect: [:c | reader: c ].
			t:: emmanuel TermWriter new.
			f = '$lit' ifTrue: [
					w:: (r at: 1) chars.
					e:: emmanuel scanString: w from: 1.
					^scanTerm: w end: e
				].
			f = '$com' ifTrue: [
					w:: (r at: 2) chars.
					e:: emmanuel scanComment: w from: 1 depth: (r at: 1) nat.
					^scanTerm: w end: e
				].
			f = '$alternating' ifTrue: [ ^bool: (alternating: (r at: 1) modes asArray) ].
			f = '$tokens' ifTrue: [
					t list: (emmanuel tokens: (r at: 1) located asArray).
					^t asString
				].
			f = '$lits' ifTrue: [
					t list: (r at: 1) hostExpr lits.
					^t asString
				].
			f = '$errors' ifTrue: [
					t list: (emmanuel errors: (r at: 1) tree).
					^t asString
				].
			f = '$print' ifTrue: [
					t chars: (emmanuel print: (r at: 2) tree source: (r at: 1) chars host: host).
					^t asString
				].
			f = '$collapse' ifTrue: [
					t chars: (emmanuel collapse: (r at: 1) chars).
					^t asString
				].
			f = '$child' ifTrue: [
					| kid = emmanuel child: (r at: 1) contentClass
						chars: (r at: 2) chars
						span: (r at: 3) span. |
					kid isNil ifTrue: [ t atom: 'NOCHILD' ]
						ifFalse: [
							t open;
								atom: 'CHILD';
								term: kid;
								close
						].
					^t asString
				].
			f = '$trim' ifTrue: [
					t list: (emmanuel trim: (r at: 1) kids asArray).
					^t asString
				].
			f = '$esc' ifTrue: [
					t chars: (emmanuel esc: (r at: 1) chars).
					^t asString
				].
			f = '$slice' ifTrue: [
					t chars: (emmanuel slice: (r at: 1) chars span: (r at: 2) span).
					^t asString
				].
			f = '$canon' ifTrue: [ ^termOf: (emmanuel canon: (r at: 1) tree) ].
			^Error signal: 'unknown function ' , f
		)
	) : ()
	public class FixtureBlock name: x values: vs = DocumentBlock new (
		(* The block states of the fixture signature: STATE name (values). *)
		
		|
			public stateName = x.
			public stateValues = vs.
		|
	) (
		public contentClass = (
			(stateName = 'doc' or: [ stateName = 'section' ]) ifTrue: [ ^#flow ].
			stateName = 'para' ifTrue: [ ^#para ].
			^#inline
		)
		public effectOf: x args: vs hostState: chi machine: m = (
			| done |
			((understands: x) and: [ x = 'paragraph' and: [ vs isEmpty ] ]) ifTrue: [
					^push: 'para' values: {} state: chi
				].
			((understands: x) and: [ x = 'section:' and: [ vs size = 1 ] ]) ifTrue: [
					^push: 'section' values: vs state: chi
				].
			((understands: x) and: [ x = 'emphasis' and: [ vs isEmpty ] ]) ifTrue: [
					^push: 'emph' values: {} state: chi
				].
			((understands: x) and: [ x = 'newline' and: [ vs isEmpty ] ]) ifTrue: [
					^emmanuel Effect kind: #leaf
						block: (FixtureBlock name: 'newline' values: {})
						hostState: chi
				].
			((understands: x) and: [ (isEnd: x) and: [ vs isEmpty ] ]) ifTrue: [
					^emmanuel Effect kind: #pop block: nil hostState: chi
				].
			(stateName = 'doc' and: [
					x = 'title:' and: [ vs size = 1 and: [ vs first isKindOfMarkupLiteral ] ]
				]) ifTrue: [
					done:: m interpretLiteral: vs first
						root: (FixtureBlock name: 'inline' values: {})
						hostState: chi.
					done isKindOfRaised ifTrue: [ ^done ].
					^emmanuel Effect kind: #mutate
						block: (FixtureBlock name: 'doc'
							values: {emmanuel TreeValue literal: vs first tree: done tree. })
						hostState: done hostState
				].
			((understands: x) and: [ x = 'boom' and: [ vs isEmpty ] ]) ifTrue: [
					^emmanuel Raised state: chi exception: (FixtureException code: 7)
				].
			((understands: x) and: [ x = 'refuseMe' and: [ vs isEmpty ] ]) ifTrue: [
					^emmanuel Effect kind: #refuse block: nil hostState: chi
				].
			((understands: x) and: [ x = 'endBad' and: [ vs isEmpty ] ]) ifTrue: [
					^emmanuel Effect kind: #popReject block: nil hostState: chi
				].
			(understands: x) ifFalse: [
					^emmanuel Effect kind: #notUnderstood block: nil hostState: chi
				].
			^Error signal: 'fixture signature: no rule for ' , x
		)
		isEnd: x = (
			^x = 'endSection' or: [ x = 'endParagraph' or: [ x = 'endEmphasis' ] ]
		)
		push: x values: vs state: chi = (
			^emmanuel Effect kind: #push
				block: (FixtureBlock name: x values: vs)
				hostState: chi
		)
		understands: x = (
			^(understood at: stateName ifAbsent: [ {} ]) includes: x
		)
		understood = (
			| m = Map new. |
			m at: 'doc' put: {'paragraph'. 'section:'. 'title:'. 'endBad'. }.
			m at: 'section' put: {'paragraph'. 'section:'. 'endSection'. }.
			m at: 'para'
				put: {'emphasis'. 'newline'. 'endParagraph'. 'boom'. 'refuseMe'. 'endBad'. }.
			m at: 'emph' put: {'emphasis'. 'newline'. 'endEmphasis'. }.
			m at: 'inline' put: {'emphasis'. 'newline'. }.
			^m
		)
	) : ()
	public class FixtureException code: k = (
		(* EXCEPTION k. *)
		
		|
			public code = k.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: 'EXCEPTION';
				nat: code;
				close
		)
	) : ()
	public class FixtureExpr id: k literals: ls = (
		(* A host expression of the fixture host: HOSTEXPR k (literals). *)
		
		|
			public id = k.
			public lits = ls.
		|
	) (
		public erased = (
			^FixtureExpr id: id literals: (lits collect: [:l | l erased ])
		)
		public printTermOn: t = (
			t open;
				atom: 'HOSTEXPR';
				nat: id;
				list: lits;
				close
		)
	) : ()
	public class FixtureHost table: table constants: cs = (
		(* The fixture host: a parser that is a table, the evaluator of
host-eval-fixtures.spectec, and its printer. cs are the evaluator's
constants, $const(k), as pairs of k and the value's term. *)
		
		|
			private parses = Map new.
			private constants = Map new.
		|
		table do: [:entry | parses at: (keyOf: (entry at: 1)) put: (entry at: 2) ].
		cs do: [:entry | constants at: (entry at: 1) put: (entry at: 2) ].
	) (
		public argSpan: s index: k = (
			(* A keyword send is written x: arg with one space, so its argument
starts after it. *)
			
			^emmanuel Span from: s span start + (emmanuel codePointsOf: s selector) size + 1
				to: s span end
		)
		constant: k = (
			| term = constants at: k
				ifAbsent: [
					^Error signal: 'fixture evaluator: no constant ' , k printString
				]. |
			^(Reader tokens: (tokenize: term) edit: nil) value
		)
		public encode: u = (
			^{39. } , u , {39. }
		)
		public eval: expr hostState: chi = (
			| k = expr id. |
			expr lits size = 1 ifTrue: [
					^emmanuel Evaluated state: chi value: expr lits first
				].
			expr lits isEmpty ifFalse: [
					^Error signal: 'fixture evaluator: several literals'
				].
			k < 900 ifTrue: [ ^emmanuel Evaluated state: chi value: (HostValue id: k) ].
			k = 900 ifTrue: [
					^emmanuel Raised state: chi exception: (FixtureException code: 900)
				].
			k = 901 ifTrue: [
					^emmanuel Evaluated state: (FixtureState count: chi count + 1)
						value: (HostValue id: chi count)
				].
			^emmanuel Evaluated state: chi value: (constant: k)
		)
		public isStringLiteral: s index: k = (
			| e = s arguments at: k + 1. |
			^e lits isEmpty and: [ {1002. 1004. 1007. 1011. 1012. } includes: e id ]
		)
		public parse: pieces = (
			| key = keyOf: (emmanuel termStringOf: (TermList elements: pieces)). result r |
			result:: parses at: key
				ifAbsent: [
					^Error signal: 'fixture host parser: no entry for ' , (emmanuel termStringOf: (TermList elements: pieces))
				].
			r:: Reader tokens: (tokenize: result) edit: nil.
			^r hostResult
		)
		public print: statements source: w = (
			| out = List new. |
			statements keysAndValuesDo: [:i :s |
					i > 1 ifTrue: [ out add: (emmanuel PrintedCode chars: {46. 32. }) ].
					out addAll: (printStatement: s source: w)
				].
			^out asArray
		)
		printStatement: s source: w = (
			| out = List new. |
			s isComment ifTrue: [
					^{emmanuel PrintedCode chars: (emmanuel slice: w span: s span). }
				].
			((s arguments allSatisfy: [:e | e lits isEmpty ]) and: [ (s span = zero) not ]) ifTrue: [
					s comments do: [:c |
							out add: (emmanuel PrintedCode chars: (emmanuel slice: w span: c) , {32. })
						].
					out add: (emmanuel PrintedCode chars: (emmanuel slice: w span: s span)).
					^out asArray
				].
			(s arguments isEmpty and: [ s span = zero ]) ifTrue: [
					^{emmanuel PrintedCode chars: (emmanuel codePointsOf: s selector). }
				].
			(s arguments size = 1 and: [ s arguments first lits size = 1 ]) ifTrue: [
					s comments do: [:c |
							out add: (emmanuel PrintedCode chars: (emmanuel slice: w span: c) , {32. })
						].
					out add: (emmanuel PrintedCode chars: (emmanuel codePointsOf: s selector) , {32. }).
					out add: (emmanuel PrintedLiteral literal: s arguments first lits first).
					^out asArray
				].
			^Error signal: 'fixture printer: no rule'
		)
		public printsValue: v image: image = (
			v isKindOfString ifTrue: [ ^true ].
			v isKindOfTreeValue ifTrue: [
					^image anySatisfy: [:entry | (entry at: 1) = v literal sourceName ]
				].
			^false
		)
		public printValue: v image: image = (
			v isKindOfString ifTrue: [ ^encode: (emmanuel codePointsOf: v) ].
			^emmanuel slice: (sourceIn: image name: v literal sourceName)
				span: v literal span
		)
		sourceIn: image name: y = (
			image do: [:entry | (entry at: 1) = y ifTrue: [ ^entry at: 2 ] ].
			^Error signal: 'no source ' , y
		)
		zero = (
			^emmanuel Span from: 0 to: 0
		)
	) : ()
	public class FixtureState count: n = (
		(* HOSTSTATE n. *)
		
		|
			public count = n.
		|
	) (
		public = other = (
			^other isKindOfFixtureState and: [ count = other count ]
		)
		public hash = (
			^count hash
		)
		public isKindOfFixtureState = (
			^true
		)
		public printTermOn: t = (
			t open;
				atom: 'HOSTSTATE';
				nat: count;
				close
		)
	) : ()
	public class HostValue id: k = (
		(* HOSTV k. *)
		
		|
			public id = k.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: 'HOSTV';
				nat: id;
				close
		)
	) : ()
	public class Reader tokens: ts edit: e = (
		(* Reads SpecTec terms from tokens, directed by the type expected. A
term may be wrapped in any number of parentheses, and a list may be
written as juxtaposed elements, in parentheses, or as eps. The terms of
the edit layer are read into the objects of e, an EmmanuelEdit. *)
		
		|
			private toks = ts.
			private pos ::= 1.
			private edit = e.
		|
	) (
		public anchor = (
			| a = (firstAtomFrom: pos) value. |
			a = 'TXT' ifTrue: [
					^app: 'TXT' do: [ | i = nat. | edit Anchor kind: #txt node: i offset: nat ]
				].
			a = 'CUT' ifTrue: [
					^app: 'CUT' do: [ | i = nat. | edit Anchor kind: #cut node: i offset: nat ]
				].
			^app: 'ENDA' do: [ edit Anchor kind: #end node: nil offset: nil ]
		)
		app: name do: body = (
			(* A constructor application: the atom name, then what body reads. *)
			
			| result |
			peekKind = #open ifTrue: [
					pos:: pos + 1.
					result:: app: name do: body.
					expect: #close.
					^result
				].
			(peekKind = #atom and: [ peek value = name ]) ifFalse: [
					^Error signal: 'expected ' , name , ' at token ' , pos printString
				].
			pos:: pos + 1.
			^body value
		)
		atomNamed = (
			| t = next. |
			t kind = #atom ifFalse: [ ^Error signal: 'expected an atom' ].
			^t value
		)
		atomNamedSkippingParens = (
			| opens ::= 0. a |
			[ peekKind = #open ] whileTrue: [
					pos:: pos + 1.
					opens:: opens + 1
				].
			a:: atomNamed.
			opens timesRepeat: [ expect: #close ].
			^a
		)
		public blockState = (
			^app: 'STATE' do: [ FixtureBlock name: string values: values asArray ]
		)
		bracketKind: a = (
			a = 'OPENMESSAGES' ifTrue: [ ^#openMessages ].
			a = 'CLOSEMESSAGES' ifTrue: [ ^#closeMessages ].
			a = 'OPENMARKUP' ifTrue: [ ^#openMarkup ].
			a = 'CLOSEMARKUP' ifTrue: [ ^#closeMarkup ].
			^Error signal: 'not a bracket: ' , a
		)
		public caret = (
			(firstAtomFrom: pos) value = 'EXACT' ifTrue: [
					^app: 'EXACT' do: [ edit exact: point ]
				].
			^app: 'AT' do: [ | pt = point. | edit Caret point: pt anchor: anchor ]
		)
		public chars = (
			| out = List new. |
			[ true ] whileTrue: [
					peekKind = #string ifTrue: [ out addAll: next value ]
						ifFalse: [
							(peekKind = #atom and: [ peek value = 'eps' ]) ifTrue: [ pos:: pos + 1 ]
								ifFalse: [
									(peekKind = #open and: [
											{#string. #close. } includes: (kindAt: pos + 1)
										]) | (peekKind = #open and: [
											(kindAt: pos + 1) = #atom and: [ (toks at: pos + 1) value = 'eps' ]
										]) ifTrue: [
											pos:: pos + 1.
											out addAll: chars.
											expect: #close
										]
										ifFalse: [ ^out asArray ]
								]
						]
				]
		)
		public contentClass = (
			| a = atomNamed. |
			a = 'FLOW' ifTrue: [ ^#flow ].
			a = 'PARA' ifTrue: [ ^#para ].
			a = 'CELL' ifTrue: [ ^#cell ].
			^#inline
		)
		public editTerm = (
			| a = (firstAtomFrom: pos) value. |
			a = 'REPLACE' ifTrue: [
					^app: 'REPLACE'
						do: [
							| c = caret. c2 = caret. ws = items. |
							edit replace: c to: c2 items: ws after: (app: 'AFTERCARET' do: [ items ])
						]
				].
			a = 'SPLIT' ifTrue: [
					^app: 'SPLIT' do: [ | c = caret. | edit split: c level: nat ]
				].
			a = 'STYLE' ifTrue: [
					^app: 'STYLE'
						do: [
							| c = caret. c2 = caret. |
							edit Edit kind: #style
								caret: c
								caret: c2
								items: nil
								after: nil
								level: nil
								style: string
								steps: nil
								index: nil
								chars: nil
						]
				].
			a = 'SETSTRING' ifTrue: [
					^app: 'SETSTRING'
						do: [
							| ss = steps. j = nat. |
							edit Edit kind: #setString
								caret: nil
								caret: nil
								items: nil
								after: nil
								level: nil
								style: nil
								steps: ss
								index: j
								chars: chars
						]
				].
			^app: 'DETACH'
				do: [
					| ss = steps. |
					edit Edit kind: #detach
						caret: nil
						caret: nil
						items: nil
						after: nil
						level: nil
						style: nil
						steps: ss
						index: nat
						chars: nil
				]
		)
		expect: kind = (
			next kind = kind ifFalse: [
					^Error signal: 'expected ' , kind , ' at token ' , (pos - 1) printString
				]
		)
		firstAtomFrom: k = (
			(* The first token at or after k that is not an opening parenthesis. *)
			
			| i ::= k. |
			[ i <= toks size and: [ (toks at: i) kind = #open ] ] whileTrue: [ i:: i + 1 ].
			^i <= toks size ifTrue: [ toks at: i ] ifFalse: [ nil ]
		)
		public hostExpr = (
			^app: 'HOSTEXPR'
				do: [
					| k = nat. |
					FixtureExpr id: k literals: (seq: {'MARKUP'. } of: [ literal ]) asArray
				]
		)
		public hostResult = (
			| a = firstAtomFrom: pos. |
			a value = 'HOSTFAIL' ifTrue: [
					^app: 'HOSTFAIL' do: [ emmanuel Failure span: span ]
				].
			^app: 'STMTS' do: [ statements asArray ]
		)
		public hostState = (
			^app: 'HOSTSTATE' do: [ FixtureState count: nat ]
		)
		public image = (
			^(seq: {'ENTRY'. } of: [ app: 'ENTRY' do: [ | y = string. | {y. chars. } ] ]) asArray
		)
		public items = (
			^(seq: {'ITEXT'. 'ISTMT'. }
				of: [
					(firstAtomFrom: pos) value = 'ITEXT' ifTrue: [
							app: 'ITEXT'
								do: [ | u = chars. | emmanuel Item text: u span: span statement: nil ]
						]
						ifFalse: [
							app: 'ISTMT'
								do: [ emmanuel Item text: nil span: nil statement: statement ]
						]
				]) asArray
		)
		kid = (
			| a = (firstAtomFrom: pos) value. |
			a = 'BLK' ifTrue: [
					^app: 'BLK'
						do: [
							emmanuel Child kind: #blk chars: nil span: nil statement: nil ref: nat
						]
				].
			^titem
		)
		public kids = (
			^seq: {'RUN'. 'BLK'. 'NOTE'. 'MUT'. 'DNU'. 'STRAY'. 'ROOTPOP'. 'REFUSED'. }
				of: [ kid ]
		)
		kindAt: k = (
			^k <= toks size ifTrue: [ (toks at: k) kind ] ifFalse: [ nil ]
		)
		lexeme = (
			| a = (firstAtomFrom: pos) value. |
			a = 'CHAR' ifTrue: [
					^app: 'CHAR' do: [ emmanuel Lexeme kind: #char chars: chars ]
				].
			a = 'CODE' ifTrue: [
					^app: 'CODE' do: [ emmanuel Lexeme kind: #code chars: chars ]
				].
			^emmanuel Lexeme kind: (bracketKind: atomNamedSkippingParens) chars: {}
		)
		literal = (
			^app: 'MARKUP'
				do: [
					| x = string. ns = nodes asArray. |
					emmanuel MarkupLiteral source: x nodes: ns span: span
				]
		)
		public located = (
			^seq: {'LOC'. }
				of: [
					app: 'LOC' do: [ | l = lexeme. | emmanuel Located lexeme: l span: span ]
				]
		)
		public modes = (
			^seq: {'TEXTMODE'. 'CODEMODE'. }
				of: [ atomNamed = 'TEXTMODE' ifTrue: [ #text ] ifFalse: [ #code ] ]
		)
		public nat = (
			| t result |
			peekKind = #open ifTrue: [
					pos:: pos + 1.
					result:: nat.
					expect: #close.
					^result
				].
			t:: next.
			t kind = #nat ifFalse: [ ^Error signal: 'expected a number' ].
			^t value
		)
		next = (
			| t = toks at: pos. |
			pos:: pos + 1.
			^t
		)
		node = (
			| a = (firstAtomFrom: pos) value. |
			a = 'FINAL' ifTrue: [
					^app: 'FINAL'
						do: [ | u = chars. | emmanuel FinalNode contents: u span: span ]
				].
			^app: 'BLOCK'
				do: [
					| u = chars. cs = span. ss = statements asArray. |
					emmanuel BlockNode contents: u contentSpan: cs statements: ss span: span
				]
		)
		public nodes = (
			^seq: {'BLOCK'. 'FINAL'. } of: [ node ]
		)
		peek = (
			^toks at: pos
		)
		peekKind = (
			^pos <= toks size ifTrue: [ (toks at: pos) kind ] ifFalse: [ nil ]
		)
		public point = (
			(firstAtomFrom: pos) value = 'GAP' ifTrue: [
					^app: 'GAP' do: [ | ss = steps. | edit gap: ss at: nat ]
				].
			^app: 'IN' do: [ | ss = steps. j = nat. | edit in: ss at: j offset: nat ]
		)
		seq: atoms of: element = (
			(* A list whose elements begin with one of the atoms. *)
			
			| out = List new. a |
			[ true ] whileTrue: [
					(peekKind = #atom and: [ peek value = 'eps' ]) ifTrue: [ pos:: pos + 1 ]
						ifFalse: [
							(peekKind = #atom and: [ atoms includes: peek value ]) ifTrue: [
									out add: element value
								]
								ifFalse: [
									peekKind = #open ifFalse: [ ^out ].
									a:: firstAtomFrom: pos.
									(a isNil not and: [
											a kind = #atom and: [
													(atoms includes: a value) or: [ a value = 'eps' ]
												]
										]) | ((kindAt: pos + 1) = #close) ifTrue: [
											pos:: pos + 1.
											out addAll: (seq: atoms of: element).
											expect: #close
										]
										ifFalse: [ ^out ]
								]
						]
				]
		)
		public span = (
			^app: 'SPAN' do: [ | i = nat. | emmanuel Span from: i to: nat ]
		)
		public spanTokens = (
			^seq: {'TOK'. }
				of: [
					app: 'TOK'
						do: [
							| k u |
							(firstAtomFrom: pos) value = 'TEXT' ifTrue: [
									app: 'TEXT' do: [ u:: chars ].
									k:: #text
								]
								ifFalse: [
									(firstAtomFrom: pos) value = 'CODE' ifTrue: [
											app: 'CODE' do: [ u:: chars ].
											k:: #code
										]
										ifFalse: [
											k:: bracketKind: atomNamedSkippingParens.
											u:: {}
										]
								].
							emmanuel Token kind: k chars: u span: span
						]
				]
		)
		statement = (
			| a = (firstAtomFrom: pos) value. |
			a = 'COMMENT' ifTrue: [
					^app: 'COMMENT' do: [ emmanuel CommentStatement span: span ]
				].
			^app: 'SEND'
				do: [
					| cs = (seq: {'SPAN'. } of: [ span ]) asArray. x = string. es = (seq: {'HOSTEXPR'. }
						of: [ hostExpr ]) asArray. |
					emmanuel SendStatement comments: cs selector: x arguments: es span: span
				]
		)
		public statements = (
			^seq: {'SEND'. 'COMMENT'. } of: [ statement ]
		)
		public steps = (
			^(seq: {'INTO'. 'FIELDOF'. }
				of: [
					(firstAtomFrom: pos) value = 'INTO' ifTrue: [
							app: 'INTO' do: [ edit into: nat ]
						]
						ifFalse: [ app: 'FIELDOF' do: [ edit fieldOf: nat ] ]
				]) asArray
		)
		public string = (
			| t result |
			peekKind = #open ifTrue: [
					pos:: pos + 1.
					result:: string.
					expect: #close.
					^result
				].
			t:: next.
			t kind = #string ifFalse: [ ^Error signal: 'expected a string' ].
			^emmanuel stringOfCodePoints: t value
		)
		titem = (
			| a = (firstAtomFrom: pos) value. |
			a = 'RUN' ifTrue: [
					^app: 'RUN'
						do: [
							| u = chars. |
							emmanuel Child kind: #run chars: u span: span statement: nil ref: nil
						]
				].
			a = 'STRAY' ifTrue: [
					^app: 'STRAY'
						do: [
							| u = chars. |
							emmanuel Child kind: #stray chars: u span: span statement: nil ref: nil
						]
				].
			a = 'NOTE' ifTrue: [
					^app: 'NOTE'
						do: [
							emmanuel Child kind: #note chars: nil span: span statement: nil ref: nil
						]
				].
			a = 'SUB' ifTrue: [
					^app: 'SUB'
						do: [
							emmanuel Child kind: #sub chars: nil span: nil statement: nil ref: tree
						]
				].
			a = 'MUT' ifTrue: [
					^app: 'MUT'
						do: [
							emmanuel Child kind: #mut
								chars: nil
								span: nil
								statement: statement
								ref: nil
						]
				].
			a = 'DNU' ifTrue: [
					^app: 'DNU'
						do: [
							emmanuel Child kind: #dnu
								chars: nil
								span: nil
								statement: statement
								ref: nil
						]
				].
			a = 'ROOTPOP' ifTrue: [
					^app: 'ROOTPOP'
						do: [
							emmanuel Child kind: #rootPop
								chars: nil
								span: nil
								statement: statement
								ref: nil
						]
				].
			^app: 'REFUSED'
				do: [
					emmanuel Child kind: #refused
						chars: nil
						span: nil
						statement: statement
						ref: nil
				]
		)
		public tree = (
			^app: 'TREE'
				do: [
					| k = blockState. items = (seq: {'RUN'. 'SUB'. 'NOTE'. 'MUT'. 'DNU'. 'STRAY'. 'ROOTPOP'. 'REFUSED'. }
						of: [ titem ]) asArray. ms = statements asArray. f = atomNamedSkippingParens. |
					emmanuel Tree state: k
						items: items
						messages: ms
						flag: (f = 'CLOSED' ifTrue: [ #closed ]
							ifFalse: [ f = 'UNCLOSED' ifTrue: [ #unclosed ] ifFalse: [ #rejected ] ])
				]
		)
		public value = (
			| a = (firstAtomFrom: pos) value. |
			a = 'LITV' ifTrue: [ ^app: 'LITV' do: [ literal ] ].
			a = 'TREEV' ifTrue: [
					^app: 'TREEV'
						do: [ | l = literal. | emmanuel TreeValue literal: l tree: tree ]
				].
			a = 'HOSTV' ifTrue: [ ^app: 'HOSTV' do: [ HostValue id: nat ] ].
			a = 'STRV' ifTrue: [ ^app: 'STRV' do: [ emmanuel stringOfCodePoints: chars ] ].
			a = 'INTV' ifTrue: [ ^app: 'INTV' do: [ nat ] ].
			^app: 'NILV' do: [ nil ]
		)
		public values = (
			^seq: {'LITV'. 'TREEV'. 'HOSTV'. 'STRV'. 'INTV'. 'NILV'. } of: [ value ]
		)
	) : ()
	public class STok kind: k value: v = (
		(* A token of a SpecTec term: #open, #close, #comma, #arrow, #eq,
#atom, #nat, or #string (whose value is an Array of code points). *)
		
		|
			public kind = k.
			public value = v.
		|
	) (
	) : ()
	public class TermList elements: es = (
		(* A list, printed as a term. *)
		
		|
			public elements = es.
		|
	) (
		public printTermOn: t = (
			t list: elements
		)
	) : ()
	public driver: table constants: cs = (
		(* A driver for the core's regressions. *)
		
		^Driver hostTable: table constants: cs blocks: nil edit: nil
	)
	hexValue: digits = (
		| v ::= 0. |
		digits do: [:c |
				v:: v * 16 + (c <= 57 ifTrue: [ c - 48 ] ifFalse: [ (c bitOr: 32) - 87 ])
			].
		^v
	)
	isDelimiter: c = (
		^{32. 9. 10. 13. 40. 41. 44. 34. } includes: c
	)
	public keyOf: text = (
		(* The comparison key of a term: its atoms, numbers, and strings, in
order; parentheses, commas, and eps only group. The zero span $z is
written out. *)
		
		| key ::= ''. |
		(tokenize: text) do: [:t |
				(t kind = #atom and: [ t value ~= 'eps' ]) ifTrue: [
						key:: key , (t value = '$z' ifTrue: [ 'SPAN 0 0' ] ifFalse: [ t value ]) , ' '
					].
				t kind = #nat ifTrue: [ key:: key , t value printString , ' ' ].
				t kind = #string ifTrue: [
						key:: key , '"' , (emmanuel stringOfCodePoints: t value) , '" '
					]
			].
		^key
	)
	public libraryDriver: table constants: cs blocks: b edit: e = (
		(* A driver for the library's regressions. *)
		
		^Driver hostTable: table constants: cs blocks: b edit: e
	)
	public tokenize: text = (
		(* The tokens of a SpecTec term. *)
		
		| w = emmanuel codePointsOf: text. out = List new. k ::= 1. c start u |
		[ k <= w size ] whileTrue: [
				c:: w at: k.
				({32. 9. 10. 13. } includes: c) ifTrue: [ k:: k + 1 ]
					ifFalse: [
						c = 40 ifTrue: [
								out add: (STok kind: #open value: nil).
								k:: k + 1
							]
							ifFalse: [
								c = 41 ifTrue: [
										out add: (STok kind: #close value: nil).
										k:: k + 1
									]
									ifFalse: [
										c = 44 ifTrue: [
												out add: (STok kind: #comma value: nil).
												k:: k + 1
											]
											ifFalse: [
												(c = 61 and: [ k < w size and: [ (w at: k + 1) = 62 ] ]) ifTrue: [
														out add: (STok kind: #arrow value: nil).
														k:: k + 2
													]
													ifFalse: [
														c = 61 ifTrue: [
																out add: (STok kind: #eq value: nil).
																k:: k + 1
															]
															ifFalse: [
																c = 34 ifTrue: [
																		u:: List new.
																		k:: k + 1.
																		[ (w at: k) = 34 ] whileFalse: [
																				(w at: k) = 92 ifTrue: [
																						| e = w at: k + 1. |
																						e = 110 ifTrue: [
																								u add: 10.
																								k:: k + 2
																							]
																							ifFalse: [
																								e = 116 ifTrue: [
																										u add: 9.
																										k:: k + 2
																									]
																									ifFalse: [
																										e = 114 ifTrue: [
																												u add: 13.
																												k:: k + 2
																											]
																											ifFalse: [
																												e = 117 ifTrue: [
																														start:: k + 3.
																														k:: start.
																														[ (w at: k) = 125 ] whileFalse: [ k:: k + 1 ].
																														u add: (hexValue: (w copyFrom: start to: k - 1)).
																														k:: k + 1
																													]
																													ifFalse: [
																														u add: e.
																														k:: k + 2
																													]
																											]
																									]
																							]
																					]
																					ifFalse: [
																						u add: (w at: k).
																						k:: k + 1
																					]
																			].
																		out add: (STok kind: #string value: u asArray).
																		k:: k + 1
																	]
																	ifFalse: [
																		start:: k.
																		[ k <= w size and: [ (isDelimiter: (w at: k)) not ] ] whileTrue: [
																				k:: k + 1
																			].
																		u:: w copyFrom: start to: k - 1.
																		(u allSatisfy: [:d | d between: 48 and: 57 ]) ifTrue: [
																				out add: (STok kind: #nat
																						value: (Integer parse: (emmanuel stringOfCodePoints: u)
																							radix: 10))
																			]
																			ifFalse: [
																				out add: (STok kind: #atom
																						value: (emmanuel stringOfCodePoints: u))
																			]
																	]
															]
													]
											]
									]
							]
					]
			].
		^out asArray
	)
) : ()
