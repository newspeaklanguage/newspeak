;; Section 7: editing. The image and provenance, the field interface
;; (declared here, defined by a block library), points, anchors, splices,
;; the edits of the live view, tidying, and refusals.

;; ---------------------------------------------------------------------
;; The image and provenance.

;; An image is a list of named sources; a markup is the document or a
;; literal.
;; @equation eq:provenance
syntax srcentry = ENTRY text (char*)
syntax markup = DOCM text | LITM markupliteral
syntax prov = LOCAL | TEMPLATE | COMPUTED
var I : srcentry
var mk : markup

def $source(srcentry*, text) : char*
def $source((ENTRY nm (w*)) I*, y) = w*
  -- if nm = y
def $source((ENTRY nm (w*)) I*, y) = $source(I*, y)
  -- if nm =/= y

def $inImage(srcentry*, text) : bool
def $inImage(eps, y) = false
def $inImage((ENTRY nm (w*)) I*, y) = nm = y \/ $inImage(I*, y)

def $src(markup) : text
def $src(DOCM nm) = nm
def $src(LITM (MARKUP nm (n*) s)) = nm

;; @equation eq:provenance
def $prov(srcentry*, text, markup) : prov
def $prov(I*, y, mk) = LOCAL
  -- if $src(mk) = y
def $prov(I*, y, mk) = TEMPLATE
  -- if $src(mk) =/= y /\ $inImage(I*, $src(mk))
def $prov(I*, y, mk) = COMPUTED
  -- if $src(mk) =/= y /\ ~$inImage(I*, $src(mk))

;; ---------------------------------------------------------------------
;; The field interface: parameters, declared and never defined here.
;; The standard library defines the block-side ones; the host-side ones
;; (argument spans, string literals, printing values) are the host's.

;; @equation eq:fields
syntax field = FIELD value stmt nat
var phi : field
var lv : nat
var hv : nat
var ev : nat
var b : bool
def $fields(blockstate, stmt*) : field*
def $joins(blockstate) : bool
def $styleOpen(text) : stmt
def $styleClose(text) : stmt
def $argSpan(stmt, nat) : span
def $isStrLit(stmt, nat) : bool
def $enc(char*) : char*
def $printsValue(srcentry*, value) : bool
def $printValue(srcentry*, value) : char*

;; ---------------------------------------------------------------------
;; Lists. Head-recursive indexing, as `$at` in 05-machine.

def $tiAt(titem*, nat) : titem
def $tiAt(ti ti'*, 0) = ti
def $tiAt(ti ti'*, i) = $tiAt(ti'*, $(i - 1))
  -- if i > 0

def $trAt(tree*, nat) : tree
def $trAt(tr tr'*, 0) = tr
def $trAt(tr tr'*, i) = $trAt(tr'*, $(i - 1))
  -- if i > 0

def $nAt(node*, nat) : node
def $nAt(n n'*, 0) = n
def $nAt(n n'*, i) = $nAt(n'*, $(i - 1))
  -- if i > 0

def $natAt(nat*, nat) : nat
def $natAt(j j'*, 0) = j
def $natAt(j j'*, i) = $natAt(j'*, $(i - 1))
  -- if i > 0

def $fieldAt(field*, nat) : field
def $fieldAt(phi phi'*, 0) = phi
def $fieldAt(phi phi'*, i) = $fieldAt(phi'*, $(i - 1))
  -- if i > 0

def $takeS(nat, stmt*) : stmt*
def $takeS(0, sigma*) = eps
def $takeS(k, eps) = eps
def $takeS(k, sigma sigma'*) = sigma $takeS($(k - 1), sigma'*)
  -- if k > 0

def $dropS(nat, stmt*) : stmt*
def $dropS(0, sigma*) = sigma*
def $dropS(k, eps) = eps
def $dropS(k, sigma sigma'*) = $dropS($(k - 1), sigma'*)
  -- if k > 0

def $dropNodes(nat, node*) : node*
def $dropNodes(0, n*) = n*
def $dropNodes(k, eps) = eps
def $dropNodes(k, n n'*) = $dropNodes($(k - 1), n'*)
  -- if k > 0

def $takeNodes(nat, node*) : node*
def $takeNodes(0, n*) = eps
def $takeNodes(k, eps) = eps
def $takeNodes(k, n n'*) = n $takeNodes($(k - 1), n'*)
  -- if k > 0

def $posOf(stmt*, stmt, nat) : nat
def $posOf(sigma sigma'*, sigma'', k) = k
  -- if sigma = sigma''
def $posOf(sigma sigma'*, sigma'', k) = $posOf(sigma'*, sigma'', $(k + 1))
  -- if sigma =/= sigma''

def $firstStmt(stmt*) : stmt
def $firstStmt(sigma sigma'*) = sigma

def $stmtItems(stmt*) : item*
def $stmtItems(eps) = eps
def $stmtItems(sigma sigma'*) = (ISTMT sigma) $stmtItems(sigma'*)

def $lenC(char*) : nat
def $lenC(eps) = 0
def $lenC(c u*) = $(1 + $lenC(u*))

def $lenN(nat*) : nat
def $lenN(eps) = 0
def $lenN(j j'*) = $(1 + $lenN(j'*))

def $lenT(titem*) : nat
def $lenT(eps) = 0
def $lenT(ti ti'*) = $(1 + $lenT(ti'*))

;; ---------------------------------------------------------------------
;; Nodes.

def $contentsOf(node) : char*
def $contentsOf(BLOCK (u*) s' (sigma*) s) = u*
def $contentsOf(FINAL (u*) s) = u*

def $cspan(node) : span
def $cspan(BLOCK (u*) s' (sigma*) s) = s'
def $cspan(FINAL (u*) s) = s

def $nspan(node) : span
def $nspan(BLOCK (u*) s' (sigma*) s) = s
def $nspan(FINAL (u*) s) = s

def $stmtsOf(node) : stmt*
def $stmtsOf(BLOCK (u*) s' (sigma*) s) = sigma*
def $stmtsOf(FINAL (u*) s) = eps

def $spanStart(span) : nat
def $spanStart(SPAN i j) = i
def $spanEnd(span) : nat
def $spanEnd(SPAN i j) = j

;; The index of the node whose contents have the span s.
def $ixOf(node*, span) : nat
def $ixFrom(node*, span, nat) : nat
def $ixOf(n*, s) = $ixFrom(n*, s, 0)
def $ixFrom(n n'*, s, i) = i
  -- if $cspan(n) = s
def $ixFrom(n n'*, s, i) = $ixFrom(n'*, s, $(i + 1))
  -- if $cspan(n) =/= s

;; ---------------------------------------------------------------------
;; Points and navigation.

;; @equation eq:points
syntax step = INTO nat | FIELDOF nat
syntax point = GAP (step*) nat | IN (step*) nat nat
var pi : step
var pt : point

def $steps(point) : step*
def $steps(GAP (pi*) i) = pi*
def $steps(IN (pi*) i k) = pi*

;; Following a path gives the markup of the point's tree, the blocks on the
;; path from the root of that tree, their child indices, the block at the
;; end, and the field the path last entered (with the path to the block
;; holding it, and the markup of that block's tree).
syntax fieldref = NOFIELD | INFIELD (step*) nat markup field
syntax nav = NAV markup (tree*) (nat*) tree fieldref
var fr : fieldref
var nv : nav

def $subAt(tree, nat) : tree
def $subOf(titem) : tree
def $subAt(TREE kappa (ti*) (sigma*) f, i) = $subOf($tiAt(ti*, i))
def $subOf(SUB tr) = tr

;; @equation eq:path
def $nav(markup, tree, step*) : nav
def $navAcc(step*, markup, tree*, nat*, tree, step*, fieldref) : nav
def $navField(step*, nat, markup, field, step*) : nav
def $nav(mk, tr, pi*) = $navAcc(eps, mk, tr, eps, tr, pi*, NOFIELD)
def $navAcc(pi'*, mk, tr*, i*, tr', eps, fr) = NAV mk (tr*) (i*) tr' fr
def $navAcc(pi'*, mk, tr*, i*, tr', (INTO j) pi*, fr) =
  $navAcc(pi'* (INTO j), mk, tr* $subAt(tr', j), i* j, $subAt(tr', j), pi*, fr)
def $navAcc(pi'*, mk, tr*, i*, TREE kappa (ti*) (sigma*) f, (FIELDOF j) pi*, fr) =
  $navField(pi'*, j, mk, $fieldAt($fields(kappa, sigma*), j), pi*)
def $navField(pi'*, j, mk, FIELD (TREEV L tr) sigma k, pi*) =
  $navAcc(pi'* (FIELDOF j), LITM L, tr, eps, tr, pi*,
    INFIELD (pi'*) j mk (FIELD (TREEV L tr) sigma k))

def $navMarkup(nav) : markup
def $navMarkup(NAV mk (tr*) (i*) tr' fr) = mk
def $navPath(nav) : tree*
def $navPath(NAV mk (tr*) (i*) tr' fr) = tr*
def $navIdx(nav) : nat*
def $navIdx(NAV mk (tr*) (i*) tr' fr) = i*
def $navBlock(nav) : tree
def $navBlock(NAV mk (tr*) (i*) tr' fr) = tr'
def $navFieldRef(nav) : fieldref
def $navFieldRef(NAV mk (tr*) (i*) tr' fr) = fr

;; The points of a tree: a gap at most after the last child, a point
;; inside text strictly between two of its characters.
;; @equation eq:point-ok
def $isPoint(markup, tree, point) : bool
def $isPoint(mk, tr, GAP (pi*) j) = j <= $lenT($kidsOf($navBlock($nav(mk, tr, pi*))))
def $isPoint(mk, tr, IN (pi*) j k) = $insideText($tiAt($kidsOf($navBlock($nav(mk, tr, pi*))), j), k)
  -- if j < $lenT($kidsOf($navBlock($nav(mk, tr, pi*))))
def $isPoint(mk, tr, IN (pi*) j k) = false
  -- if j >= $lenT($kidsOf($navBlock($nav(mk, tr, pi*))))

def $insideText(titem, nat) : bool
def $insideText(RUN (u*) s, k) = 0 < k /\ k < $lenC(u*)
def $insideText(STRAY (u*) s, k) = 0 < k /\ k < $lenC(u*)
def $insideText(SUB tr, k) = false
def $insideText(NOTE s, k) = false
def $insideText(MUT sigma, k) = false
def $insideText(DNU sigma, k) = false
def $insideText(ROOTPOP sigma, k) = false
def $insideText(REFUSED sigma, k) = false

;; Two points are in one tree when they are in one markup and their paths
;; start at the same root.
def $sameTree(nav, nav) : bool
def $sameTree(NAV mk (tr tr'*) (i*) tr'' fr, NAV mk' (tr_1 tr_1'*) (i'*) tr_1'' fr') =
  mk = mk' /\ tr = tr_1

;; ---------------------------------------------------------------------
;; Located text.

syntax rng = RNG nat nat
var rg : rng

def $wsRun(char*) : nat
def $wsRun(eps) = 0
def $wsRun(c u*) = $(1 + $wsRun(u*))
  -- if $isWS(c)
def $wsRun(c u*) = 0
  -- if ~$isWS(c)

;; col(u): collapse(u), each character with the range of u it came from.
;; @equation eq:col
def $col(char*, nat) : rng*
def $col(eps, k) = eps
def $col(c u*, k) = (RNG k $(k + 1 + $wsRun(u*))) $col($dropWS(u*), $(k + 1 + $wsRun(u*)))
  -- if $isWS(c)
def $col(c u*, k) = (RNG k $(k + 1)) $col(u*, $(k + 1))
  -- if ~$isWS(c)

def $idRanges(char*, nat) : rng*
def $idRanges(eps, k) = eps
def $idRanges(c u*, k) = (RNG k $(k + 1)) $idRanges(u*, $(k + 1))

def $revR(rng*) : rng*
def $revR(eps) = eps
def $revR(rg rg'*) = $revR(rg'*) rg

def $tailR(rng*) : rng*
def $tailR(rg rg'*) = rg'*

def $initR(rng*) : rng*
def $initR(rg*) = $revR($tailR($revR(rg*)))

def $rngAt(rng*, nat) : rng
def $rngAt(rg rg'*, 0) = rg
def $rngAt(rg rg'*, i) = $rngAt(rg'*, $(i - 1))
  -- if i > 0

def $lastR(rng*) : rng
def $lastR(rg*) = $rngAt($revR(rg*), 0)

def $rStart(rng) : nat
def $rStart(RNG i j) = i
def $rEnd(rng) : nat
def $rEnd(RNG i j) = j

;; loc of a run: col of its node's contents, less what trimming removed.
;; @equation eq:loc
def $locRun(char*, char*) : rng*
def $locRun(u*, u'*) = $col(u*, 0)
  -- if $collapse(u*) = u'*
def $locRun(u*, u'*) = $tailR($col(u*, 0))
  -- if $collapse(u*) = " " u'*
def $locRun(u*, u'*) = $initR($col(u*, 0))
  -- if $collapse(u*) = u'* " "
def $locRun(u*, u'*) = $initR($tailR($col(u*, 0)))
  -- if $collapse(u*) = " " u'* " "

def $textSpan(titem) : span
def $textSpan(RUN (u*) s) = s
def $textSpan(STRAY (u*) s) = s

;; @equation eq:loc
def $rangesOf(node*, titem) : rng*
def $rangesOf(n*, RUN (u*) s) = $locRun($contentsOf($nAt(n*, $ixOf(n*, s))), u*)
def $rangesOf(n*, STRAY (u*) s) = $idRanges(u*, 0)

;; ---------------------------------------------------------------------
;; Anchors.

;; @equation eq:anchors
syntax anchor = TXT nat nat | CUT nat nat | ENDA
var a : anchor

;; @equation eq:anchor-after
def $afterStmt(node*, stmt) : anchor
def $afterFrom(node*, stmt, nat) : anchor
def $afterAt(nat, stmt*, node*, nat) : anchor
def $afterStmt(n*, sigma) = $afterFrom(n*, sigma, 0)
def $afterFrom(n n'*, sigma, i) = $afterAt($posOf($stmtsOf(n), sigma, 0), $stmtsOf(n), n'*, i)
  -- if sigma <- $stmtsOf(n)
def $afterFrom(n n'*, sigma, i) = $afterFrom(n'*, sigma, $(i + 1))
  -- if ~(sigma <- $stmtsOf(n))
def $afterAt(k, sigma*, n*, i) = CUT i $(k + 1)
  -- if $(k + 1) < |sigma*|
def $afterAt(k, sigma*, n n'*, i) = TXT $(i + 1) 0
  -- if $(k + 1) = |sigma*|
def $afterAt(k, sigma*, eps, i) = ENDA
  -- if $(k + 1) = |sigma*|

;; The anchor before a statement, used when tidying widens a splice.
;; @equation eq:anchor-before
def $beforeStmt(node*, stmt) : anchor
def $beforeFrom(node*, stmt, nat) : anchor
def $beforeAt(nat, node, nat) : anchor
def $beforeStmt(n*, sigma) = $beforeFrom(n*, sigma, 0)
def $beforeFrom(n n'*, sigma, i) = $beforeAt($posOf($stmtsOf(n), sigma, 0), n, i)
  -- if sigma <- $stmtsOf(n)
def $beforeFrom(n n'*, sigma, i) = $beforeFrom(n'*, sigma, $(i + 1))
  -- if ~(sigma <- $stmtsOf(n))
def $beforeAt(0, n, i) = TXT i $lenC($contentsOf(n))
def $beforeAt(k, n, i) = CUT i k
  -- if k > 0

def $start(node*) : anchor
def $start(eps) = ENDA
def $start(n n'*) = TXT 0 0

;; end(g): the anchor after a child.
;; @equation eq:anchor-end
def $endOf(node*, titem) : anchor
def $endOf(n*, RUN (u*) s) = TXT $ixOf(n*, s) $rEnd($lastR($rangesOf(n*, RUN (u*) s)))
def $endOf(n*, STRAY (u*) s) = TXT $ixOf(n*, s) $lenC(u*)
def $endOf(n*, SUB (TREE kappa (ti*) (sigma sigma' sigma''*) f)) =
  $afterStmt(n*, $lastStmt(sigma sigma' sigma''*))
  -- if f =/= UNCLOSED
;; A leaf has only its creating message: the anchor after it.
def $endOf(n*, SUB (TREE kappa (ti*) (sigma) f)) = $afterStmt(n*, sigma)
  -- if f =/= UNCLOSED
def $endOf(n*, NOTE s) = $afterStmt(n*, COMMENT s)
def $endOf(n*, MUT sigma) = $afterStmt(n*, sigma)
def $endOf(n*, DNU sigma) = $afterStmt(n*, sigma)
def $endOf(n*, REFUSED sigma) = $afterStmt(n*, sigma)
def $endOf(n*, ROOTPOP sigma) = $afterStmt(n*, sigma)

;; @equation eq:anchor-point
def $anchor(node*, nav, point) : anchor
def $anchor(n*, NAV mk (tr*) (i*) (TREE kappa (ti*) (sigma*) f) fr, IN (pi*) j k) =
  TXT $ixOf(n*, $textSpan($tiAt(ti*, j))) $rStart($rngAt($rangesOf(n*, $tiAt(ti*, j)), k))
def $anchor(n*, NAV mk (tr*) eps tr' fr, GAP (pi*) 0) = $start(n*)
def $anchor(n*, NAV mk (tr*) (i i'*) (TREE kappa (ti*) (sigma sigma'*) f) fr, GAP (pi*) 0) =
  $afterStmt(n*, sigma)
def $anchor(n*, NAV mk (tr*) (i*) (TREE kappa (ti*) (sigma*) f) fr, GAP (pi*) j) =
  $endOf(n*, $tiAt(ti*, $(j - 1)))
  -- if j > 0

;; The items between two anchors.
;; @equation eq:anchor-items
def $ixA(anchor) : nat
def $ixA(TXT i k) = i
def $ixA(CUT i k) = i

def $headOf(node, anchor) : item*
def $headOf(n, TXT i k) = ITEXT ($take(k, $contentsOf(n))) $z
def $headOf(n, CUT i k) = (ITEXT ($contentsOf(n)) $z) $stmtItems($takeS(k, $stmtsOf(n)))

def $tailOf(node, anchor) : item*
def $tailOf(n, TXT i k) = (ITEXT ($drop(k, $contentsOf(n))) $z) $stmtItems($stmtsOf(n))
def $tailOf(n, CUT i k) = $stmtItems($dropS(k, $stmtsOf(n)))

def $midOf(node, anchor, anchor) : item*
def $midOf(n, TXT i k, TXT i' k') = ITEXT ($take($(k' - k), $drop(k, $contentsOf(n)))) $z
def $midOf(n, TXT i k, CUT i' k') =
  (ITEXT ($drop(k, $contentsOf(n))) $z) $stmtItems($takeS(k', $stmtsOf(n)))
def $midOf(n, CUT i k, CUT i' k') = $stmtItems($takeS($(k' - k), $dropS(k, $stmtsOf(n))))

def $between(node*, anchor, anchor) : item*
def $between(n*, ENDA, ENDA) = eps
def $between(n*, a, ENDA) =
  $tailOf($nAt(n*, $ixA(a)), a) $items($dropNodes($($ixA(a) + 1), n*))
  -- if a =/= ENDA
def $between(n*, a, a') = $midOf($nAt(n*, $ixA(a)), a, a')
  -- if a =/= ENDA /\ a' =/= ENDA /\ $ixA(a) = $ixA(a')
def $between(n*, a, a') =
  $tailOf($nAt(n*, $ixA(a)), a)
  $items($takeNodes($($ixA(a') - $ixA(a) - 1), $dropNodes($($ixA(a) + 1), n*)))
  $headOf($nAt(n*, $ixA(a')), a')
  -- if a =/= ENDA /\ a' =/= ENDA /\ $ixA(a) < $ixA(a')

;; ---------------------------------------------------------------------
;; Splices.

;; The markup being rewritten: its source name, its nodes, and the end of
;; its contents.
syntax mctx = MCTX text (node*) nat
var mc : mctx

;; @equation eq:splice-bounds
def $mctx(srcentry*, node*, markup) : mctx
def $mctx(I*, n*, DOCM nm) = MCTX nm (n*) $lenC($source(I*, nm))
def $mctx(I*, n*, LITM (MARKUP nm (n'*) (SPAN i j))) = MCTX nm (n'*) $(j - 2)

def $mnodes(mctx) : node*
def $mnodes(MCTX nm (n*) k) = n*

;; @equation eq:splice-bounds
def $lpos(node*, nat, anchor) : nat
def $lpos(n*, k, TXT i j) = $spanStart($cspan($nAt(n*, i)))
def $lpos(n*, k, CUT i j) = $spanEnd($cspan($nAt(n*, i)))
def $lpos(n*, k, ENDA) = k

;; @equation eq:splice-bounds
def $rpos(node*, nat, anchor) : nat
def $rpos(n*, k, TXT i j) = $spanEnd($cspan($nAt(n*, i)))
def $rpos(n*, k, CUT i j) = $spanEnd($nspan($nAt(n*, i)))
def $rpos(n*, k, ENDA) = k

def $bracket(char*, stmt*) : char*
def $bracket(w*, sigma*) = $openSeq $show(w*, $hostPrint(w*, sigma*)) $closeSeq

;; @equation eq:splice
def $left(char*, node*, anchor) : char*
def $left(w*, n*, TXT i k) = $esc($take(k, $contentsOf($nAt(n*, i))))
def $left(w*, n*, CUT i k) = $bracket(w*, $takeS(k, $stmtsOf($nAt(n*, i))))
def $left(w*, n*, ENDA) = eps

;; @equation eq:splice
def $right(char*, node*, anchor) : char*
def $right(w*, n*, TXT i k) = $esc($drop(k, $contentsOf($nAt(n*, i))))
def $right(w*, n*, CUT i k) = $bracket(w*, $dropS(k, $stmtsOf($nAt(n*, i))))
def $right(w*, n*, ENDA) = eps

;; @equation eq:out
def $out(char*, item*) : char*
def $outS(char*, stmt*, item*) : char*
def $out(w*, omega*) = $outS(w*, eps, omega*)
def $outS(w*, eps, eps) = eps
def $outS(w*, sigma sigma'*, eps) = $bracket(w*, sigma sigma'*)
def $outS(w*, sigma*, (ISTMT sigma') omega*) = $outS(w*, sigma* sigma', omega*)
def $outS(w*, eps, (ITEXT (u*) s) omega*) = $esc(u*) $outS(w*, eps, omega*)
def $outS(w*, sigma sigma'*, (ITEXT (u*) s) omega*) =
  $bracket(w*, sigma sigma'*) $esc(u*) $outS(w*, eps, omega*)

;; A splice writes the items before the caret, then those after it, and
;; gives the new source with the offset of the caret in it.
;; @equation eq:splice-def
syntax spliced = SPLICED (char*) nat | UNCHANGED
def $splice(char*, mctx, anchor, anchor, item*, item*) : spliced
def $splice(w*, MCTX nm (n*) k, a, a', omega*, omega'*) =
  SPLICED ($take($lpos(n*, k, a), w*) $left(w*, n*, a) $out(w*, omega*) $out(w*, omega'*)
    $right(w*, n*, a') $drop($rpos(n*, k, a'), w*))
    $($lpos(n*, k, a) + $lenC($left(w*, n*, a)) + $lenC($out(w*, omega*)))
  -- if ~(a = a' /\ omega* = eps /\ omega'* = eps)
def $splice(w*, MCTX nm (n*) k, a, a', omega*, omega'*) = UNCHANGED
  -- if a = a' /\ omega* = eps /\ omega'* = eps

;; ---------------------------------------------------------------------
;; Carets.

;; A caret is the point the view shows and the anchor where text goes; an
;; exact caret's anchor is its point's. The anchor of a caret that is not
;; exact lies in white space the view does not show.
;; @equation eq:carets
syntax caret = EXACT point | AT point anchor
var ca : caret

;; @equation eq:carets
def $caretPt(caret) : point
def $caretPt(EXACT pt) = pt
def $caretPt(AT pt a) = pt

;; @equation eq:carets
def $caretAnchor(node*, nav, caret) : anchor
def $caretAnchor(n*, nv, EXACT pt) = $anchor(n*, nv, pt)
def $caretAnchor(n*, nv, AT pt a) = a

;; The number of characters a source text lexes to: an escape is one.
;; @equation eq:caret-anchor
def $lenU(char*) : nat
def $lenU(eps) = 0
def $lenU("\\") = 1
def $lenU("\\" c u*) = $(1 + $lenU(u*))
  -- if c = "\\" \/ c = "["
def $lenU("\\" c u*) = $(1 + $lenU(c u*))
  -- if c =/= "\\" /\ c =/= "["
def $lenU(c u*) = $(1 + $lenU(u*))
  -- if c =/= "\\"

;; The anchor at the offset k of the source w of a markup with the nodes n*.
;; @equation eq:caret-anchor
def $anchorAt(node*, char*, nat) : anchor
def $anchorFrom(node*, char*, nat, nat) : anchor
def $anchorAt(n*, w*, k) = $anchorFrom(n*, w*, k, 0)
def $anchorFrom(eps, w*, k, i) = ENDA
def $anchorFrom(n n'*, w*, k, i) =
  TXT i $lenU($take($(k - $spanStart($cspan(n))), $drop($spanStart($cspan(n)), w*)))
  -- if $spanStart($cspan(n)) <= k /\ k <= $spanEnd($cspan(n))
def $anchorFrom(n n'*, w*, k, i) = $anchorFrom(n'*, w*, k, $(i + 1))
  -- if ~($spanStart($cspan(n)) <= k /\ k <= $spanEnd($cspan(n)))

;; The text child that the contents with the span s gave, if any.
syntax found = FOUND (step*) nat titem | NOTFOUND
var fd : found
syntax ptopt = SOMEPT point | NOPT
var po : ptopt

def $isSub(titem) : bool
def $isSub(SUB tr) = true
def $isSub(RUN (u*) s) = false
def $isSub(STRAY (u*) s) = false
def $isSub(NOTE s) = false
def $isSub(MUT sigma) = false
def $isSub(DNU sigma) = false
def $isSub(ROOTPOP sigma) = false
def $isSub(REFUSED sigma) = false

def $isTextFrom(titem, span) : bool
def $isTextFrom(RUN (u*) s', s) = s' = s
def $isTextFrom(STRAY (u*) s', s) = s' = s
def $isTextFrom(SUB tr, s) = false
def $isTextFrom(NOTE s', s) = false
def $isTextFrom(MUT sigma, s) = false
def $isTextFrom(DNU sigma, s) = false
def $isTextFrom(ROOTPOP sigma, s) = false
def $isTextFrom(REFUSED sigma, s) = false

;; @equation eq:caret-resolve
def $findText(titem*, step*, nat, span) : found
def $findText(eps, pi*, j, s) = NOTFOUND
def $findText(ti ti'*, pi*, j, s) = FOUND (pi*) j ti
  -- if $isTextFrom(ti, s)
def $findText((SUB tr) ti*, pi*, j, s) =
  $orFound($findText($kidsOf(tr), pi* (INTO j), 0, s), $findText(ti*, pi*, $(j + 1), s))
def $findText(ti ti'*, pi*, j, s) = $findText(ti'*, pi*, $(j + 1), s)
  -- if ~$isTextFrom(ti, s) /\ ~$isSub(ti)

def $orFound(found, found) : found
def $orFound(FOUND (pi*) j ti, fd) = FOUND (pi*) j ti
def $orFound(NOTFOUND, fd) = fd

;; Whether a block was pushed, and whether a statement opens or ends it.
def $isPushed(tree) : bool
def $isPushed(TREE kappa (ti*) (sigma*) f) = f = UNCLOSED \/ |sigma*| >= 2

def $closesIt(tree, stmt) : bool
def $closesIt(TREE kappa (ti*) (sigma sigma' sigma''*) f, sigma''') =
  f =/= UNCLOSED /\ $lastStmt(sigma sigma' sigma''*) = sigma'''
def $closesIt(TREE kappa (ti*) (sigma*) f, sigma') = false
  -- if |sigma*| < 2

def $startsAt(tree, stmt) : bool
def $startsAt(tr, sigma) = $isPushed(tr) /\ sigma = $opOf(tr)

def $endsAt(tree, stmt) : bool
def $endsAt(tr, sigma) = $closesIt(tr, sigma) \/ (~$isPushed(tr) /\ sigma = $opOf(tr))

;; Whether a leaf records a statement.
def $marks(titem, stmt) : bool
def $marks(MUT sigma', sigma) = sigma' = sigma
def $marks(DNU sigma', sigma) = sigma' = sigma
def $marks(REFUSED sigma', sigma) = sigma' = sigma
def $marks(ROOTPOP sigma', sigma) = sigma' = sigma
def $marks(NOTE s, sigma) = sigma = COMMENT s
def $marks(RUN (u*) s, sigma) = false
def $marks(STRAY (u*) s, sigma) = false
def $marks(SUB tr, sigma) = false

;; The gap just after a statement, found where the statement left its mark.
;; @equation eq:caret-resolve
def $gapAfter(titem*, step*, nat, stmt) : ptopt
def $gapAfter(eps, pi*, j, sigma) = NOPT
def $gapAfter((SUB tr) ti*, pi*, j, sigma) = SOMEPT (GAP (pi* (INTO j)) 0)
  -- if $startsAt(tr, sigma)
def $gapAfter((SUB tr) ti*, pi*, j, sigma) = SOMEPT (GAP (pi*) $(j + 1))
  -- if $endsAt(tr, sigma)
def $gapAfter((SUB tr) ti*, pi*, j, sigma) =
  $orPt($gapAfter($kidsOf(tr), pi* (INTO j), 0, sigma), $gapAfter(ti*, pi*, $(j + 1), sigma))
  -- if ~$startsAt(tr, sigma) /\ ~$endsAt(tr, sigma)
def $gapAfter(ti ti'*, pi*, j, sigma) = SOMEPT (GAP (pi*) $(j + 1))
  -- if $marks(ti, sigma)
def $gapAfter(ti ti'*, pi*, j, sigma) = $gapAfter(ti'*, pi*, $(j + 1), sigma)
  -- if ~$isSub(ti) /\ ~$marks(ti, sigma)

def $orPt(ptopt, ptopt) : ptopt
def $orPt(SOMEPT pt, po) = SOMEPT pt
def $orPt(NOPT, po) = po

def $ptOf(ptopt) : point
def $ptOf(SOMEPT pt) = pt

;; How many of the ranges end by the offset k.
def $countEnds(rng*, nat) : nat
def $countEnds(eps, k) = 0
def $countEnds((RNG i j) rg*, k) = $(1 + $countEnds(rg*, k))
  -- if j <= k
def $countEnds((RNG i j) rg*, k) = 0
  -- if j > k

;; The point an anchor resolves to: in the text child of its node, before
;; the first character whose range ends after it; with no such child, just
;; after the statements before it.
;; @equation eq:caret-resolve
def $place(node*, tree, anchor) : point
def $placeTxt(node*, tree, nat, nat, found) : point
def $placeIn(step*, nat, nat, nat) : point
def $afterNode(node*, tree, nat) : point
def $place(n*, tr, TXT i k) =
  $placeTxt(n*, tr, i, k, $findText($kidsOf(tr), eps, 0, $cspan($nAt(n*, i))))
def $place(n*, tr, ENDA) = $afterNode(n*, tr, |n*|)
def $placeTxt(n*, tr, i, k, FOUND (pi*) j ti) =
  $placeIn(pi*, j, $countEnds($rangesOf(n*, ti), k), |$rangesOf(n*, ti)|)
def $placeTxt(n*, tr, i, k, NOTFOUND) = $afterNode(n*, tr, i)
def $placeIn(pi*, j, 0, lv) = GAP (pi*) j
def $placeIn(pi*, j, k, lv) = GAP (pi*) $(j + 1)
  -- if k = lv /\ k > 0
def $placeIn(pi*, j, k, lv) = IN (pi*) j k
  -- if 0 < k /\ k < lv
def $afterNode(n*, tr, 0) = GAP eps 0
def $afterNode(n*, tr, i) =
  $ptOf($gapAfter($kidsOf(tr), eps, 0, $lastStmt($stmtsOf($nAt(n*, $(i - 1))))))
  -- if i > 0 /\ $stmtsOf($nAt(n*, $(i - 1))) =/= eps
def $afterNode(n*, tr, i) = $place(n*, tr, TXT $(i - 1) $lenC($contentsOf($nAt(n*, $(i - 1)))))
  -- if i > 0 /\ $stmtsOf($nAt(n*, $(i - 1))) = eps

;; A point of a markup's tree as a point of the document, below the path
;; pi* to the markup's field.
def $prefixPt(step*, point) : point
def $prefixPt(pi*, GAP (pi'*) j) = GAP (pi* pi'*) j
def $prefixPt(pi*, IN (pi'*) j k) = IN (pi* pi'*) j k

def $prefixOf(fieldref) : step*
def $prefixOf(NOFIELD) = eps
def $prefixOf(INFIELD (pi*) j mk phi) = pi* (FIELDOF j)

;; A caret is well formed when its anchor resolves to its point; n* and tr
;; are the nodes and tree of its markup, pi* the path to that markup.
;; @equation eq:caret-ok
def $caretOK(node*, tree, step*, caret) : bool
def $caretOK(n*, tr, pi*, EXACT pt) = true
def $caretOK(n*, tr, pi*, AT pt (CUT i k)) = false
def $caretOK(n*, tr, pi*, AT pt (TXT i k)) = $prefixPt(pi*, $place(n*, tr, TXT i k)) = pt
def $caretOK(n*, tr, pi*, AT pt ENDA) = $prefixPt(pi*, $place(n*, tr, ENDA)) = pt

;; ---------------------------------------------------------------------
;; Blocks on a path.

;; @equation eq:op-cl
def $opOf(tree) : stmt
def $opOf(TREE kappa (ti*) (sigma sigma'*) f) = sigma

;; @equation eq:op-cl
def $clOf(tree) : stmt
def $clOf(TREE kappa (ti*) (sigma sigma' sigma''*) f) = $lastStmt(sigma sigma' sigma''*)

def $stateOfT(tree) : blockstate
def $stateOfT(TREE kappa (ti*) (sigma*) f) = kappa

def $kidsOf(tree) : titem*
def $kidsOf(TREE kappa (ti*) (sigma*) f) = ti*

def $hasCloser(tree) : bool
def $hasCloser(TREE kappa (ti*) (sigma*) f) = f =/= UNCLOSED /\ |sigma*| >= 2

def $isInlineT(tree) : bool
def $isInlineT(tr) = $cls($stateOfT(tr)) = INLINE

;; B ~ B': the blocks join.
;; @equation eq:edit-join
def $join(tree, tree) : bool
def $join(tr, tr') = $joins($stateOfT(tr)) /\ $eStmt($opOf(tr)) = $eStmt($opOf(tr'))

;; @equation eq:edit-blocks
def $commonLen(nat*, nat*) : nat
def $commonLen(eps, j*) = 0
def $commonLen(i i'*, eps) = 0
def $commonLen(i i'*, j j'*) = $(1 + $commonLen(i'*, j'*))
  -- if i = j
def $commonLen(i i'*, j j'*) = 0
  -- if i =/= j

;; The children of the block at level l on a path that lie after (lo) or
;; before (hi) the point, at its own level or below.
;; @equation eq:edit-muts
def $loAt(nat*, point, nat) : nat
def $loAt(i*, pt, lv) = $($natAt(i*, lv) + 1)
  -- if lv < |i*|
def $loAt(i*, GAP (pi*) j, lv) = j
  -- if lv >= |i*|
def $loAt(i*, IN (pi*) j k, lv) = $(j + 1)
  -- if lv >= |i*|

;; @equation eq:edit-muts
def $hiAt(nat*, point, nat) : nat
def $hiAt(i*, pt, lv) = $natAt(i*, lv)
  -- if lv < |i*|
def $hiAt(i*, GAP (pi*) j, lv) = j
  -- if lv >= |i*|
def $hiAt(i*, IN (pi*) j k, lv) = j
  -- if lv >= |i*|

;; The mutating messages among children lo .. hi-1.
;; @equation eq:edit-muts
def $mutsIn(titem*, nat, nat, nat) : stmt*
def $mutsIn(eps, i, lo, hi) = eps
def $mutsIn((MUT sigma) ti*, i, lo, hi) = sigma $mutsIn(ti*, $(i + 1), lo, hi)
  -- if lo <= i /\ i < hi
def $mutsIn(ti ti'*, i, lo, hi) = $mutsIn(ti'*, $(i + 1), lo, hi)
  -- if ~(lo <= i /\ i < hi /\ $isMut(ti))

def $isMut(titem) : bool
def $isMut(MUT sigma) = true
def $isMut(RUN (u*) s) = false
def $isMut(SUB tr) = false
def $isMut(NOTE s) = false
def $isMut(DNU sigma) = false
def $isMut(STRAY (u*) s) = false
def $isMut(ROOTPOP sigma) = false
def $isMut(REFUSED sigma) = false

def $big : nat
def $big = 1000000

;; M(B) for B on the path of p below D (after p), on the path of q (before
;; q), and for D (between them).
;; @equation eq:edit-muts
def $mLeft(tree*, nat*, point, nat) : stmt*
def $mLeft(tr*, i*, pt, lv) = $mutsIn($kidsOf($trAt(tr*, lv)), 0, $loAt(i*, pt, lv), $big)
def $mRight(tree*, nat*, point, nat) : stmt*
def $mRight(tr*, i*, pt, lv) = $mutsIn($kidsOf($trAt(tr*, lv)), 0, 0, $hiAt(i*, pt, lv))
def $mMid(tree*, nat*, point, nat*, point, nat) : stmt*
def $mMid(tr*, i*, pt, i'*, pt', lv) =
  $mutsIn($kidsOf($trAt(tr*, lv)), 0, $loAt(i*, pt, lv), $hiAt(i'*, pt', lv))

;; ---------------------------------------------------------------------
;; Marked items, for tidying.

;; A marked item opens or closes the block identified by its creating
;; message (with whether it is inline), or is an unmarked item. Its origin
;; says whether it lies before the splice, in it, or after it.
syntax origin = OUTL | INS | OUTR
;; @equation eq:tidy-neighbours
;; The caret marker records where the caret goes.
;; @equation eq:tidy-caret
syntax litem = LOP stmt bool stmt origin | LCL stmt bool stmt origin | LIT item | LCARET
var li : litem
var og : origin

def $markOp(tree, origin) : litem
def $markOp(tr, og) = LOP $opOf(tr) $isInlineT(tr) $opOf(tr) og
def $markCl(tree, origin) : litem
def $markCl(tr, og) = LCL $opOf(tr) $isInlineT(tr) $clOf(tr) og

def $unmarked(item*) : litem*
def $unmarked(eps) = eps
def $unmarked(omega omega'*) = (LIT omega) $unmarked(omega'*)

def $unmarkedS(stmt*) : litem*
def $unmarkedS(sigma*) = $unmarked($stmtItems(sigma*))

;; cl(B_from) ... cl(B_to) and op(B_to) ... op(B_from), with from >= to.
def $closeDown(tree*, nat, nat) : litem*
def $closeDown(tr*, lv, lv') = $markCl($trAt(tr*, lv), INS) $closeDown(tr*, $(lv - 1), lv')
  -- if lv > lv'
def $closeDown(tr*, lv, lv') = $markCl($trAt(tr*, lv), INS)
  -- if lv = lv'
def $closeDown(tr*, lv, lv') = eps
  -- if lv < lv'

def $openUp(tree*, nat, nat) : litem*
def $openUp(tr*, lv, lv') = $markOp($trAt(tr*, lv), INS) $openUp(tr*, $(lv + 1), lv')
  -- if lv < lv'
def $openUp(tr*, lv, lv') = $markOp($trAt(tr*, lv), INS)
  -- if lv = lv'
def $openUp(tr*, lv, lv') = eps
  -- if lv > lv'

;; The marked creating messages just before a point that is the first gap
;; of its block, outermost first; the closing messages just after a point
;; that is the last gap of its block, innermost first.
;; @equation eq:tidy-neighbours
def $leftNb(nav, point) : litem*
def $leftNbAt(tree*, nat*, nat) : litem*
def $leftNb(NAV mk (tr*) (i*) tr' fr, GAP (pi*) 0) = $leftNbAt(tr*, i*, |i*|)
  -- if |i*| > 0
def $leftNb(NAV mk (tr*) (i*) tr' fr, pt) = eps
  -- if ~($isFirstGap(pt) /\ |i*| > 0)
def $leftNbAt(tr*, i*, lv) = $leftNbAt(tr*, i*, $(lv - 1)) $markOp($trAt(tr*, lv), OUTL)
  -- if lv > 1 /\ $natAt(i*, $(lv - 1)) = 0
def $leftNbAt(tr*, i*, lv) = $markOp($trAt(tr*, lv), OUTL)
  -- if ~(lv > 1 /\ $natAt(i*, $(lv - 1)) = 0)

def $isFirstGap(point) : bool
def $isFirstGap(GAP (pi*) j) = j = 0
def $isFirstGap(IN (pi*) j k) = false

;; @equation eq:tidy-neighbours
def $rightNb(nav, point) : litem*
def $rightNbAt(tree*, nat*, nat) : litem*
def $rightNb(NAV mk (tr*) (i*) tr' fr, GAP (pi*) j) = $rightNbAt(tr*, i*, |i*|)
  -- if |i*| > 0 /\ j = $lenT($kidsOf(tr')) /\ $hasCloser(tr')
def $rightNb(NAV mk (tr*) (i*) tr' fr, pt) = eps
  -- if ~($isLastGap(pt, tr') /\ |i*| > 0 /\ $hasCloser(tr'))
def $rightNbAt(tr*, i*, lv) = $markCl($trAt(tr*, lv), OUTR) $rightNbAt(tr*, i*, $(lv - 1))
  -- if lv > 1 /\ $isLastKid(tr*, i*, lv) /\ $hasCloser($trAt(tr*, $(lv - 1)))
def $rightNbAt(tr*, i*, lv) = $markCl($trAt(tr*, lv), OUTR)
  -- if ~(lv > 1 /\ $isLastKid(tr*, i*, lv) /\ $hasCloser($trAt(tr*, $(lv - 1))))

def $isLastGap(point, tree) : bool
def $isLastGap(GAP (pi*) j, tr) = j = $lenT($kidsOf(tr))
def $isLastGap(IN (pi*) j k, tr) = false

def $isLastKid(tree*, nat*, nat) : bool
def $isLastKid(tr*, i*, lv) = $($natAt(i*, $(lv - 1)) + 1) = $lenT($kidsOf($trAt(tr*, $(lv - 1))))

;; Cancelling: an opening of an inline block followed by its closing.
def $revLI(litem*) : litem*
def $revLI(eps) = eps
def $revLI(li li'*) = $revLI(li'*) li

;; @equation eq:tidy-cancel
def $cancels(litem, litem*) : bool
def $cancels(LCL sigma b sigma' og, (LOP sigma'' b' sigma''' og') li*) = sigma = sigma'' /\ b
def $cancels(LCL sigma b sigma' og, (LCL sigma'' b' sigma''' og') li*) = false
def $cancels(LCL sigma b sigma' og, (LIT omega) li*) = false
def $cancels(LCL sigma b sigma' og, eps) = false
def $cancels(LCL sigma b sigma' og, LCARET li*) = false
def $cancels(LOP sigma b sigma' og, li*) = false
def $cancels(LIT omega, li*) = false
def $cancels(LCARET, li*) = false

;; A pair cancels across the caret marker, which stays.
;; @equation eq:tidy-caret
def $cancelsOver(litem, litem*) : bool
def $cancelsOver(li, LCARET li'*) = $cancels(li, li'*)
def $cancelsOver(li, eps) = false
def $cancelsOver(li, li' li''*) = false
  -- if li' =/= LCARET

;; The second argument is the output so far, reversed.
;; @equation eq:tidy-cancel
def $cancel(litem*, litem*) : litem*
def $cancel(eps, li'*) = $revLI(li'*)
def $cancel(li li'*, li'' li'''*) = $cancel(li'*, li'''*)
  -- if $cancels(li, li'' li'''*)
def $cancel(li li'*, LCARET li'' li'''*) = $cancel(li'*, LCARET li'''*)
  -- if $cancels(li, li'' li'''*)
def $cancel(li li'*, li''*) = $cancel(li'*, li li''*)
  -- if ~$cancels(li, li''*) /\ ~$cancelsOver(li, li''*)

def $isEmptyText(litem) : bool
def $isEmptyText(LIT (ITEXT (u*) s)) = u* = eps
def $isEmptyText(LIT (ISTMT sigma)) = false
def $isEmptyText(LOP sigma b sigma' og) = false
def $isEmptyText(LCL sigma b sigma' og) = false
def $isEmptyText(LCARET) = false

;; @equation eq:tidy
def $dropEmpty(litem*) : litem*
def $dropEmpty(eps) = eps
def $dropEmpty(li li'*) = $dropEmpty(li'*)
  -- if $isEmptyText(li)
def $dropEmpty(li li'*) = li $dropEmpty(li'*)
  -- if ~$isEmptyText(li)

def $countOrigin(litem*, origin) : nat
def $countOrigin(eps, og) = 0
def $countOrigin((LOP sigma b sigma' og) li*, og') = $(1 + $countOrigin(li*, og'))
  -- if og = og'
def $countOrigin((LCL sigma b sigma' og) li*, og') = $(1 + $countOrigin(li*, og'))
  -- if og = og'
def $countOrigin(li li'*, og') = $countOrigin(li'*, og')
  -- if ~$hasOrigin(li, og')

def $hasOrigin(litem, origin) : bool
def $hasOrigin(LOP sigma b sigma' og, og') = og = og'
def $hasOrigin(LCL sigma b sigma' og, og') = og = og'
def $hasOrigin(LIT omega, og') = false
def $hasOrigin(LCARET, og') = false

;; The items the splice writes: everything inside it.
;; @equation eq:tidy
def $written(litem*) : item*
def $written(eps) = eps
def $written((LOP sigma b sigma' INS) li*) = (ISTMT sigma') $written(li*)
def $written((LCL sigma b sigma' INS) li*) = (ISTMT sigma') $written(li*)
def $written((LIT omega) li*) = omega $written(li*)
def $written(LCARET li*) = $written(li*)
def $written(li li'*) = $written(li'*)
  -- if $hasOrigin(li, OUTL) \/ $hasOrigin(li, OUTR)

;; The items before and after the caret marker.
;; @equation eq:tidy-caret
def $beforeCaret(litem*) : litem*
def $beforeCaret(eps) = eps
def $beforeCaret(LCARET li*) = eps
def $beforeCaret(li li'*) = li $beforeCaret(li'*)
  -- if li =/= LCARET

;; @equation eq:tidy-caret
def $afterCaret(litem*) : litem*
def $afterCaret(eps) = eps
def $afterCaret(LCARET li*) = li*
def $afterCaret(li li'*) = $afterCaret(li'*)
  -- if li =/= LCARET

;; Whether the items hold nothing but the caret marker.
def $isBare(litem*) : bool
def $isBare(eps) = true
def $isBare(LCARET li*) = $isBare(li*)
def $isBare(li li'*) = false
  -- if li =/= LCARET

def $stmtOfLI(litem) : stmt
def $stmtOfLI(LOP sigma b sigma' og) = sigma'
def $stmtOfLI(LCL sigma b sigma' og) = sigma'

def $liAt(litem*, nat) : litem
def $liAt(li li'*, 0) = li
def $liAt(li li'*, i) = $liAt(li'*, $(i - 1))
  -- if i > 0

;; Tidying, then splicing: the splice is widened over the creating messages
;; removed before it and the closing messages removed after it.
;; @equation eq:tidy
def $tidy(char*, mctx, litem*, litem*, litem*, anchor, anchor) : spliced
def $tidyThen(char*, mctx, litem*, litem*, anchor, anchor, litem*) : spliced
def $tidy(w*, mc, li_1*, li*, li_2*, a, a') =
  $tidyThen(w*, mc, li_1*, li_2*, a, a', $cancel($dropEmpty(li_1* li* li_2*), eps))
  -- if ~(a = a' /\ $isBare(li*))
;; An edit that writes nothing at one anchor changes nothing, so the
;; neighbours of an empty block the document has do not cancel.
def $tidy(w*, mc, li_1*, li*, li_2*, a, a') = UNCHANGED
  -- if a = a' /\ $isBare(li*)
def $tidyThen(w*, mc, li_1*, li_2*, a, a', li*) =
  $splice(w*, mc,
    $widenL($mnodes(mc), li_1*, $countOrigin(li*, OUTL), a),
    $widenR($mnodes(mc), li_2*, $countOrigin(li*, OUTR), a'),
    $written($beforeCaret(li*)), $written($afterCaret(li*)))

;; @equation eq:tidy
def $widenL(node*, litem*, nat, anchor) : anchor
def $widenL(n*, li*, k, a) = a
  -- if k = |li*|
def $widenL(n*, li*, k, a) = $beforeStmt(n*, $stmtOfLI($liAt(li*, k)))
  -- if k < |li*|

;; @equation eq:tidy
def $widenR(node*, litem*, nat, anchor) : anchor
def $widenR(n*, li*, k, a) = a
  -- if k = |li*|
def $widenR(n*, li*, k, a) = $afterStmt(n*, $stmtOfLI($liAt(li*, $(|li*| - k - 1))))
  -- if k < |li*|

;; ---------------------------------------------------------------------
;; The edits.

;; @equation eq:edit-replace
;; replace(c, c', omega, omega'), given the points and anchors of the two
;; carets: c is the depth of D, j how many levels join. The caret goes
;; between omega and omega'.
def $replace(srcentry*, mctx, nav, point, anchor, nav, point, anchor, item*, item*) : spliced
def $replaceC(srcentry*, mctx, nav, point, anchor, nav, point, anchor, item*, item*, nat) : spliced
def $replaceJ(srcentry*, mctx, nav, point, anchor, nav, point, anchor, item*, item*, nat, nat) : spliced
def $replace(I*, mc, nv, pt, a, nv', pt', a', omega*, omega'*) =
  $replaceC(I*, mc, nv, pt, a, nv', pt', a', omega*, omega'*, $commonLen($navIdx(nv), $navIdx(nv')))
def $replaceC(I*, mc, nv, pt, a, nv', pt', a', omega*, omega'*, k) =
  $replaceJ(I*, mc, nv, pt, a, nv', pt', a', omega*, omega'*, k, $joinDepth(nv, pt, nv', pt', k, 0))
def $replaceJ(I*, MCTX nm (n*) ev, nv, pt, a, nv', pt', a', omega*, omega'*, k, j) =
  $tidy($source(I*, nm), MCTX nm (n*) ev,
    $leftNb(nv, pt),
    $unmarked(omega*) LCARET $unmarked(omega'*)
    $closeLevels($navPath(nv), $navIdx(nv), pt, $lenN($navIdx(nv)), $(k + j + 1))
    $unmarkedS($mJoin(nv, pt, nv', pt', k, j))
    $openLevels($navPath(nv'), $navIdx(nv'), pt', $(k + j + 1), $lenN($navIdx(nv'))),
    $rightNb(nv', pt'),
    a, a')

;; M(L_l) cl(L_l) for l from the innermost out to `to`.
def $closeLevels(tree*, nat*, point, nat, nat) : litem*
def $closeLevels(tr*, i*, pt, lv, lv') =
  $unmarkedS($mLeft(tr*, i*, pt, lv)) $markCl($trAt(tr*, lv), INS) $closeLevels(tr*, i*, pt, $(lv - 1), lv')
  -- if lv >= lv' /\ lv > 0
def $closeLevels(tr*, i*, pt, lv, lv') = eps
  -- if ~(lv >= lv' /\ lv > 0)

;; op(R_l) M(R_l) for l from `from` in to the innermost.
def $openLevels(tree*, nat*, point, nat, nat) : litem*
def $openLevels(tr*, i*, pt, lv, lv') =
  $markOp($trAt(tr*, lv), INS) $unmarkedS($mRight(tr*, i*, pt, lv)) $openLevels(tr*, i*, pt, $(lv + 1), lv')
  -- if lv <= lv'
def $openLevels(tr*, i*, pt, lv, lv') = eps
  -- if lv > lv'

;; M_j: M(D) if no level joins, else M(L_j) M(R_j).
;; @equation eq:edit-join
def $mJoin(nav, point, nav, point, nat, nat) : stmt*
def $mJoin(nv, pt, nv', pt', k, 0) =
  $mMid($navPath(nv), $navIdx(nv), pt, $navIdx(nv'), pt', k)
def $mJoin(nv, pt, nv', pt', k, j) =
  $mLeft($navPath(nv), $navIdx(nv), pt, $(k + j)) $mRight($navPath(nv'), $navIdx(nv'), pt', $(k + j))
  -- if j > 0

;; The largest j: level j+1 joins when L_{j+1} ~ R_{j+1} and the messages
;; of level j (D for j = 0) are empty.
;; @equation eq:edit-join
def $joinDepth(nav, point, nav, point, nat, nat) : nat
def $joinDepth(nv, pt, nv', pt', k, j) = $joinDepth(nv, pt, nv', pt', k, $(j + 1))
  -- if $canJoin(nv, pt, nv', pt', k, j)
def $joinDepth(nv, pt, nv', pt', k, j) = j
  -- if ~$canJoin(nv, pt, nv', pt', k, j)

;; @equation eq:edit-join
def $canJoin(nav, point, nav, point, nat, nat) : bool
def $canJoin(nv, pt, nv', pt', k, j) =
  $(k + j + 1) <= $lenN($navIdx(nv)) /\ $(k + j + 1) <= $lenN($navIdx(nv'))
  /\ $join($trAt($navPath(nv), $(k + j + 1)), $trAt($navPath(nv'), $(k + j + 1)))
  /\ $mJoin(nv, pt, nv', pt', k, j) = eps

;; @equation eq:edit-split
def $split(srcentry*, mctx, nav, point, anchor, nat) : spliced
def $split(I*, MCTX nm (n*) ev, nv, pt, a, lv) =
  $tidy($source(I*, nm), MCTX nm (n*) ev, $leftNb(nv, pt),
    $closeDown($navPath(nv), $lenN($navIdx(nv)), lv) $openUp($navPath(nv), lv, $lenN($navIdx(nv))) LCARET,
    $rightNb(nv, pt), a, a)

;; @equation eq:edit-split
def $closedFrom(tree*, nat, nat) : bool
def $closedFrom(tr*, lv, lv') = $hasCloser($trAt(tr*, lv)) /\ $closedFrom(tr*, $(lv + 1), lv')
  -- if lv <= lv'
def $closedFrom(tr*, lv, lv') = true
  -- if lv > lv'

;; @equation eq:edit-unstyle
;; @equation eq:edit-restyle
;; @equation eq:edit-style
;; The innermost block on both paths, at depth <= k, that is the style x:
;; its depth, or none.
syntax depthopt = ATDEPTH nat | NODEPTH
def $styled(tree*, nat, text) : depthopt
def $styled(tr*, lv, x) = ATDEPTH lv
  -- if $isInlineT($trAt(tr*, lv)) /\ $eStmt($opOf($trAt(tr*, lv))) = $eStmt($styleOpen(x))
def $styled(tr*, lv, x) = $styled(tr*, $(lv - 1), x)
  -- if ~($isInlineT($trAt(tr*, lv)) /\ $eStmt($opOf($trAt(tr*, lv))) = $eStmt($styleOpen(x))) /\ lv > 0
def $styled(tr*, 0, x) = NODEPTH
  -- if ~($isInlineT($trAt(tr*, 0)) /\ $eStmt($opOf($trAt(tr*, 0))) = $eStmt($styleOpen(x)))

def $style(srcentry*, mctx, nav, point, anchor, nav, point, anchor, text) : spliced
def $styleC(srcentry*, mctx, nav, point, anchor, nav, point, anchor, text, nat) : spliced
def $styleB(srcentry*, mctx, nav, point, anchor, nav, point, anchor, text, nat, depthopt) : spliced
def $style(I*, mc, nv, pt, a, nv', pt', a', x) =
  $styleC(I*, mc, nv, pt, a, nv', pt', a', x, $commonLen($navIdx(nv), $navIdx(nv')))
def $styleC(I*, mc, nv, pt, a, nv', pt', a', x, k) =
  $styleB(I*, mc, nv, pt, a, nv', pt', a', x, k, $styled($navPath(nv), k, x))
def $styleB(I*, MCTX nm (n*) ev, nv, pt, a, nv', pt', a', x, k, NODEPTH) =
  $tidy($source(I*, nm), MCTX nm (n*) ev, $leftNb(nv, pt),
    $closeDown($navPath(nv), $lenN($navIdx(nv)), $(k + 1))
    (LOP $styleOpen(x) true $styleOpen(x) INS)
    $openUp($navPath(nv), $(k + 1), $lenN($navIdx(nv)))
    $marked($between(n*, a, a'), nv, nv', k) LCARET
    $closeDown($navPath(nv'), $lenN($navIdx(nv')), $(k + 1))
    (LCL $styleOpen(x) true $styleClose(x) INS)
    $openUp($navPath(nv'), $(k + 1), $lenN($navIdx(nv'))),
    $rightNb(nv', pt'), a, a')
def $styleB(I*, MCTX nm (n*) ev, nv, pt, a, nv', pt', a', x, k, ATDEPTH lv) =
  $tidy($source(I*, nm), MCTX nm (n*) ev, $leftNb(nv, pt),
    $closeDown($navPath(nv), $lenN($navIdx(nv)), $(lv + 1))
    $markCl($trAt($navPath(nv), lv), INS)
    $openUp($navPath(nv), $(lv + 1), $lenN($navIdx(nv)))
    $marked($between(n*, a, a'), nv, nv', k) LCARET
    $closeDown($navPath(nv'), $lenN($navIdx(nv')), $(lv + 1))
    $markOp($trAt($navPath(nv), lv), INS)
    $openUp($navPath(nv'), $(lv + 1), $lenN($navIdx(nv'))),
    $rightNb(nv', pt'), a, a')

;; In the items between the anchors, the closing messages of the L_i and
;; the creating messages of the R_i are marked.
def $marked(item*, nav, nav, nat) : litem*
def $marked(eps, nv, nv', k) = eps
def $marked((ISTMT sigma) omega*, nv, nv', k) =
  $markStmt(sigma, $navPath(nv), $(k + 1), $lenN($navIdx(nv)), $navPath(nv'), $lenN($navIdx(nv')))
  $marked(omega*, nv, nv', k)
def $marked((ITEXT (u*) s) omega*, nv, nv', k) = (LIT (ITEXT (u*) s)) $marked(omega*, nv, nv', k)

def $markStmt(stmt, tree*, nat, nat, tree*, nat) : litem
def $markL(stmt, tree*, nat, nat, tree*, nat, nat) : litem
def $markStmt(sigma, tr*, lv, hv, tr'*, hv') = $markL(sigma, tr*, lv, hv, tr'*, lv, hv')
def $markL(sigma, tr*, lv, hv, tr'*, lv', hv') = $markCl($trAt(tr*, lv), INS)
  -- if lv <= hv /\ $hasCloser($trAt(tr*, lv)) /\ sigma = $clOf($trAt(tr*, lv))
def $markL(sigma, tr*, lv, hv, tr'*, lv', hv') = $markL(sigma, tr*, $(lv + 1), hv, tr'*, lv', hv')
  -- if lv <= hv /\ ~($hasCloser($trAt(tr*, lv)) /\ sigma = $clOf($trAt(tr*, lv)))
def $markL(sigma, tr*, lv, hv, tr'*, lv', hv') = $markStmtR(sigma, tr'*, lv', hv')
  -- if lv > hv
def $markStmtR(stmt, tree*, nat, nat) : litem
def $markStmtR(sigma, tr*, lv, hv) = LIT (ISTMT sigma)
  -- if lv > hv
def $markStmtR(sigma, tr*, lv, hv) = $markOp($trAt(tr*, lv), INS)
  -- if lv <= hv /\ sigma = $opOf($trAt(tr*, lv))
def $markStmtR(sigma, tr*, lv, hv) = $markStmtR(sigma, tr*, $(lv + 1), hv)
  -- if lv <= hv /\ sigma =/= $opOf($trAt(tr*, lv))

;; The conditions for styling: D is para, cell, or inline, and the blocks
;; below it on both paths are inline.
def $inlineFrom(tree*, nat, nat) : bool
def $inlineFrom(tr*, lv, lv') = $isInlineT($trAt(tr*, lv)) /\ $inlineFrom(tr*, $(lv + 1), lv')
  -- if lv <= lv'
def $inlineFrom(tr*, lv, lv') = true
  -- if lv > lv'

;; @equation eq:style-ok
def $canStyle(nav, nav) : bool
def $canStyle(nv, nv') = $canStyleAt(nv, nv', $commonLen($navIdx(nv), $navIdx(nv')))
def $canStyleAt(nav, nav, nat) : bool
def $canStyleAt(nv, nv', k) =
  ($cls($stateOfT($trAt($navPath(nv), k))) = PARA \/ $cls($stateOfT($trAt($navPath(nv), k))) = CELL
    \/ $cls($stateOfT($trAt($navPath(nv), k))) = INLINE)
  /\ $inlineFrom($navPath(nv), $(k + 1), $lenN($navIdx(nv)))
  /\ $inlineFrom($navPath(nv'), $(k + 1), $lenN($navIdx(nv')))

;; The keys of the view, as edits. Backspace at the start of the block at
;; the path pi* (INTO i), i > 0, deletes from the end of its predecessor.
;; @equation eq:edit-keys
def $typeText(caret, char*) : edit
def $typeText(ca, u*) = REPLACE ca ca ((ITEXT (u*) $z)) (AFTERCARET eps)
def $deleteRange(caret, caret) : edit
def $deleteRange(ca, ca') = REPLACE ca ca' eps (AFTERCARET eps)
def $backspace(markup, tree, step*, nat) : edit
def $backspace(mk, tr, pi*, i) =
  REPLACE (EXACT (GAP (pi* (INTO $(i - 1))) $lenT($kidsOf($navBlock($nav(mk, tr, pi* (INTO $(i - 1))))))))
    (EXACT (GAP (pi* (INTO i)) 0)) eps (AFTERCARET eps)
  -- if i > 0

;; ---------------------------------------------------------------------
;; Refusals and the edit relation.

;; The items a replacement writes after the caret.
;; @equation eq:edits
syntax aftercaret = AFTERCARET (item*)
;; @equation eq:edits
syntax edit =
  | REPLACE caret caret (item*) aftercaret
  | SPLIT caret nat
  | STYLE caret caret text
  | SETSTRING (step*) nat (char*)
  | DETACH (step*) nat
;; @equation eq:edit-results
syntax offer = OFFERDETACH (step*) nat | GIVEUP
syntax caretpos = CARETAT nat | SAMECARET
syntax editresult = EDITED text (char*) caretpos | REFUSEDEDIT (offer*)
var ed : edit

;; An edit that changed nothing leaves the caret where it was.
;; @equation eq:edit-results
def $result(srcentry*, text, spliced) : editresult
def $result(I*, y, SPLICED (w*) k) = EDITED y (w*) (CARETAT k)
def $result(I*, y, UNCHANGED) = EDITED y ($source(I*, y)) SAMECARET

;; @equation eq:detachable
def $detachable(srcentry*, text, fieldref) : bool
def $detachable(I*, y, NOFIELD) = false
def $detachable(I*, y, INFIELD (pi*) j mk (FIELD v sigma k)) =
  $prov(I*, y, mk) =/= COMPUTED /\ $printsValue(I*, v)

;; @equation eq:detachable
def $offers(srcentry*, text, fieldref) : offer*
def $offers(I*, y, INFIELD (pi*) j mk phi) = (OFFERDETACH (pi*) j) GIVEUP
  -- if $detachable(I*, y, INFIELD (pi*) j mk phi)
def $offers(I*, y, fr) = GIVEUP
  -- if ~$detachable(I*, y, fr)

;; The document: its nodes and its tree.
relation Document: (srcentry*, text, hoststate, blockstate) => (node*, tree)
;; @rule Document
rule Document:
  (I*, nm, chi, kappa) => (n*, tr)
  -- Parses: (nm, $source(I*, nm)) => (PARSED (n*))
  -- Interp: (chi, kappa, n*) => (DONE chi' tr)

relation Edit: (srcentry*, text, hoststate, blockstate, edit) => (editresult)

;; @equation eq:edit-replace
;; @rule Edit-Replace
rule Edit/edit-replace:
  (I*, nm, chi, kappa, REPLACE ca ca' (omega*) (AFTERCARET omega'*)) =>
    ($result(I*, $src(mk), $replace(I*, mc, nv, pt, $caretAnchor($mnodes(mc), nv, ca),
      nv', pt', $caretAnchor($mnodes(mc), nv', ca'), omega*, omega'*)))
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if pt = $caretPt(ca)
  -- if pt' = $caretPt(ca')
  -- if nv = $nav(DOCM nm, tr, $steps(pt))
  -- if nv' = $nav(DOCM nm, tr, $steps(pt'))
  -- if mc = $mctx(I*, n*, $navMarkup(nv))
  -- if mk = $navMarkup(nv)
  -- if $sameTree(nv, nv') /\ $prov(I*, nm, mk) =/= COMPUTED

;; @equation eq:edit-split
;; @rule Edit-Split
rule Edit/edit-split:
  (I*, nm, chi, kappa, SPLIT ca lv) =>
    ($result(I*, $src(mk), $split(I*, mc, nv, pt, $caretAnchor($mnodes(mc), nv, ca), lv)))
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if pt = $caretPt(ca)
  -- if nv = $nav(DOCM nm, tr, $steps(pt))
  -- if mc = $mctx(I*, n*, $navMarkup(nv))
  -- if mk = $navMarkup(nv)
  -- if $prov(I*, nm, mk) =/= COMPUTED /\ lv >= 1 /\ lv <= $lenN($navIdx(nv))
  -- if $closedFrom($navPath(nv), lv, $lenN($navIdx(nv)))

;; @equation eq:edit-style
;; @rule Edit-Style
rule Edit/edit-style:
  (I*, nm, chi, kappa, STYLE ca ca' x) =>
    ($result(I*, $src(mk), $style(I*, mc, nv, pt, $caretAnchor($mnodes(mc), nv, ca),
      nv', pt', $caretAnchor($mnodes(mc), nv', ca'), x)))
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if pt = $caretPt(ca)
  -- if pt' = $caretPt(ca')
  -- if nv = $nav(DOCM nm, tr, $steps(pt))
  -- if nv' = $nav(DOCM nm, tr, $steps(pt'))
  -- if mc = $mctx(I*, n*, $navMarkup(nv))
  -- if mk = $navMarkup(nv)
  -- if $sameTree(nv, nv') /\ $prov(I*, nm, mk) =/= COMPUTED /\ $canStyle(nv, nv')

;; Setting a string: the argument's text is replaced by enc(u).
;; @equation eq:edit-string
;; @rule Edit-Set-String
rule Edit/edit-set-string:
  (I*, nm, chi, kappa, SETSTRING (pi*) j (u*)) =>
    (EDITED $src(mk) ($take($spanStart($argSpan(sigma, k)), w*) $enc(u*) $drop($spanEnd($argSpan(sigma, k)), w*)) SAMECARET)
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if nv = $nav(DOCM nm, tr, pi*)
  -- if mk = $navMarkup(nv)
  -- if FIELD v sigma k = $fieldAt($fields($stateOfT($navBlock(nv)), $msgsOfT($navBlock(nv))), j)
  -- if w* = $source(I*, $src(mk))
  -- if $prov(I*, nm, mk) =/= COMPUTED /\ $isStrLit(sigma, k)

;; Detaching: the argument's text is replaced by the printed value.
;; @rule Edit-Detach
;; @equation eq:edit-string
rule Edit/edit-detach:
  (I*, nm, chi, kappa, DETACH (pi*) j) =>
    (EDITED $src(mk) ($take($spanStart($argSpan(sigma, k)), w*) $printValue(I*, v) $drop($spanEnd($argSpan(sigma, k)), w*)) SAMECARET)
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if nv = $nav(DOCM nm, tr, pi*)
  -- if mk = $navMarkup(nv)
  -- if FIELD v sigma k = $fieldAt($fields($stateOfT($navBlock(nv)), $msgsOfT($navBlock(nv))), j)
  -- if w* = $source(I*, $src(mk))
  -- if $detachable(I*, nm, INFIELD (pi*) j mk (FIELD v sigma k))

;; Refusals.
;; @rule Refuse-Trees
rule Edit/refuse-trees:
  (I*, nm, chi, kappa, ed) => (REFUSEDEDIT GIVEUP)
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if $twoPoints(ed)
  -- if ~$sameTree($nav(DOCM nm, tr, $steps($firstPt(ed))), $nav(DOCM nm, tr, $steps($secondPt(ed))))

;; @rule Refuse-Computed
rule Edit/refuse-computed:
  (I*, nm, chi, kappa, ed) => (REFUSEDEDIT $offers(I*, nm, $navFieldRef(nv)))
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if $isPointEdit(ed)
  -- if nv = $nav(DOCM nm, tr, $steps($firstPt(ed)))
  -- if $prov(I*, nm, $navMarkup(nv)) = COMPUTED
  -- if ~$twoPoints(ed) \/ $sameTree(nv, $nav(DOCM nm, tr, $steps($secondPt(ed))))

;; @rule Refuse-Split
rule Edit/refuse-split:
  (I*, nm, chi, kappa, SPLIT ca lv) => (REFUSEDEDIT GIVEUP)
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if nv = $nav(DOCM nm, tr, $steps($caretPt(ca)))
  -- if $prov(I*, nm, $navMarkup(nv)) =/= COMPUTED
  -- if ~(lv >= 1 /\ lv <= $lenN($navIdx(nv)) /\ $closedFrom($navPath(nv), lv, $lenN($navIdx(nv))))

;; @rule Refuse-Style
rule Edit/refuse-style:
  (I*, nm, chi, kappa, STYLE ca ca' x) => (REFUSEDEDIT GIVEUP)
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if nv = $nav(DOCM nm, tr, $steps($caretPt(ca)))
  -- if nv' = $nav(DOCM nm, tr, $steps($caretPt(ca')))
  -- if $sameTree(nv, nv') /\ $prov(I*, nm, $navMarkup(nv)) =/= COMPUTED /\ ~$canStyle(nv, nv')

;; @rule Refuse-String
rule Edit/refuse-string:
  (I*, nm, chi, kappa, SETSTRING (pi*) j (u*)) =>
    (REFUSEDEDIT $offers(I*, nm, INFIELD (pi*) j mk (FIELD v sigma k)))
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if nv = $nav(DOCM nm, tr, pi*)
  -- if mk = $navMarkup(nv)
  -- if FIELD v sigma k = $fieldAt($fields($stateOfT($navBlock(nv)), $msgsOfT($navBlock(nv))), j)
  -- if ~($prov(I*, nm, mk) =/= COMPUTED /\ $isStrLit(sigma, k))

;; @rule Refuse-Detach
rule Edit/refuse-detach:
  (I*, nm, chi, kappa, DETACH (pi*) j) => (REFUSEDEDIT GIVEUP)
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if nv = $nav(DOCM nm, tr, pi*)
  -- if ~$detachable(I*, nm, INFIELD (pi*) j $navMarkup(nv) $fieldAt($fields($stateOfT($navBlock(nv)), $msgsOfT($navBlock(nv))), j))

def $msgsOfT(tree) : stmt*
def $msgsOfT(TREE kappa (ti*) (sigma*) f) = sigma*

def $twoPoints(edit) : bool
def $twoPoints(REPLACE ca ca' (omega*) (AFTERCARET omega'*)) = true
def $twoPoints(STYLE ca ca' x) = true
def $twoPoints(SPLIT ca lv) = false
def $twoPoints(SETSTRING (pi*) j (u*)) = false
def $twoPoints(DETACH (pi*) j) = false

def $isPointEdit(edit) : bool
def $isPointEdit(REPLACE ca ca' (omega*) (AFTERCARET omega'*)) = true
def $isPointEdit(STYLE ca ca' x) = true
def $isPointEdit(SPLIT ca lv) = true
def $isPointEdit(SETSTRING (pi*) j (u*)) = false
def $isPointEdit(DETACH (pi*) j) = false

def $firstPt(edit) : point
def $firstPt(REPLACE ca ca' (omega*) (AFTERCARET omega'*)) = $caretPt(ca)
def $firstPt(STYLE ca ca' x) = $caretPt(ca)
def $firstPt(SPLIT ca lv) = $caretPt(ca)

def $secondPt(edit) : point
def $secondPt(REPLACE ca ca' (omega*) (AFTERCARET omega'*)) = $caretPt(ca')
def $secondPt(STYLE ca ca' x) = $caretPt(ca')

;; The caret after an edit: the offset k in the new source of the markup at
;; the path pi* (empty for the document), resolved in the new document.
relation Caret: (srcentry*, text, hoststate, blockstate, step*, nat) => (caret)
;; @rule Caret
rule Caret:
  (I*, nm, chi, kappa, pi*, k) => (AT $prefixPt(pi*, $place(n'*, $navBlock(nv), a)) a)
  -- Document: (I*, nm, chi, kappa) => (n*, tr)
  -- if nv = $nav(DOCM nm, tr, pi*)
  -- if n'* = $mnodes($mctx(I*, n*, $navMarkup(nv)))
  -- if a = $anchorAt(n'*, $source(I*, $src($navMarkup(nv))), k)

;; ---------------------------------------------------------------------
;; Section 7.11: the view. What the view does with an edit: the spaces it
;; keeps, and the edits it does not make. (The keys, which need the
;; library's blocks, are the library's: library/07-library.spectec.)

;; Typed text: a space the text puts beside white space is a no-break
;; space, which white-space collapsing keeps. The typed text u* ends at the
;; offset k of the edited source; its characters are taken from left to
;; right, each beside the one before it as it now is and the one after it.
;; @equation eq:view-spaces
def $lastC(char*) : char*
def $lastC(eps) = eps
def $lastC(c) = c
def $lastC(c c' u*) = $lastC(c' u*)

def $firstC(char*) : char*
def $firstC(eps) = eps
def $firstC(c u*) = c

def $anyWS(char*) : bool
def $anyWS(eps) = false
def $anyWS(c) = $isWS(c)

;; @equation eq:view-spaces
def $nb(char*, char, char*) : char*
def $nb(u*, c, u'*) = "\u{A0}"
  -- if c = " " /\ ($anyWS(u*) \/ $anyWS(u'*))
def $nb(u*, c, u'*) = c
  -- if ~(c = " " /\ ($anyWS(u*) \/ $anyWS(u'*)))

def $nbsp(char*, char*, char*) : char*
def $nbsp(u*, eps, u'*) = eps
def $nbsp(u*, c, u'*) = $nb(u*, c, u'*)
def $nbsp(u*, c c' u''*, u'*) = $nb(u*, c, c') $nbsp($nb(u*, c, c'), c' u''*, u'*)

;; @equation eq:view-spaces
def $keepSpaces(char*, char*, caretpos) : char*
def $keepSpacesAt(char*, char*, nat) : char*
def $keepSpaces(u*, w*, SAMECARET) = w*
def $keepSpaces(u*, w*, CARETAT k) = $keepSpacesAt(u*, w*, k)
  -- if $lenC(u*) <= k /\ k <= $lenC(w*)
def $keepSpaces(u*, w*, CARETAT k) = w*
  -- if ~($lenC(u*) <= k /\ k <= $lenC(w*))
def $keepSpacesAt(u*, w*, k) =
  $take($(k - $lenC(u*)), w*) $nbsp($lastC($take($(k - $lenC(u*)), w*)), u*, $firstC($drop(k, w*))) $drop(k, w*)
  -- if $take($lenC(u*), $drop($(k - $lenC(u*)), w*)) = u*
def $keepSpacesAt(u*, w*, k) = w*
  -- if $take($lenC(u*), $drop($(k - $lenC(u*)), w*)) =/= u*

;; An edit in the view: the edited source, with the spaces of the typed text
;; u* kept; or the source as it was (VIEWKEPT) when the edit is refused,
;; changes another source than the view's, or leaves a source that does not
;; parse or whose interpretation raises. The view never goes dead: what it
;; shows always interprets.
;; @equation eq:view-edit
syntax viewresult = VIEWED (char*) caretpos | VIEWKEPT
var oo : offer
var cp : caretpos
var vr : viewresult

relation ViewEdit: (srcentry*, text, hoststate, blockstate, edit, char*) => (viewresult)

;; @equation eq:view-edit
;; @rule View-Edit
rule ViewEdit/view-edit:
  (I*, nm, chi, kappa, ed, u*) => (VIEWED (w'*) cp)
  -- Edit: (I*, nm, chi, kappa, ed) => (EDITED y (w*) cp)
  -- if y = nm
  -- if w'* = $keepSpaces(u*, w*, cp)
  -- Parses: (nm, w'*) => (PARSED (n*))
  -- Interp: (chi, kappa, n*) => (DONE chi' tr)

;; @equation eq:view-edit
;; @rule View-Refused
rule ViewEdit/view-refused:
  (I*, nm, chi, kappa, ed, u*) => (VIEWKEPT)
  -- Edit: (I*, nm, chi, kappa, ed) => (REFUSEDEDIT (oo*))

;; @equation eq:view-edit
;; @rule View-Elsewhere
rule ViewEdit/view-elsewhere:
  (I*, nm, chi, kappa, ed, u*) => (VIEWKEPT)
  -- Edit: (I*, nm, chi, kappa, ed) => (EDITED y (w*) cp)
  -- if y =/= nm

;; @equation eq:view-edit
;; @rule View-Unlexable
rule ViewEdit/view-unlexable:
  (I*, nm, chi, kappa, ed, u*) => (VIEWKEPT)
  -- Edit: (I*, nm, chi, kappa, ed) => (EDITED y (w*) cp)
  -- if y = nm
  -- Parses: (nm, $keepSpaces(u*, w*, cp)) => (LEXFAIL e k)

;; @equation eq:view-edit
;; @rule View-Unparsable
rule ViewEdit/view-unparsable:
  (I*, nm, chi, kappa, ed, u*) => (VIEWKEPT)
  -- Edit: (I*, nm, chi, kappa, ed) => (EDITED y (w*) cp)
  -- if y = nm
  -- Parses: (nm, $keepSpaces(u*, w*, cp)) => (SYNTAXERROR s)

;; @equation eq:view-edit
;; @rule View-Raises
rule ViewEdit/view-raises:
  (I*, nm, chi, kappa, ed, u*) => (VIEWKEPT)
  -- Edit: (I*, nm, chi, kappa, ed) => (EDITED y (w*) cp)
  -- if y = nm
  -- Parses: (nm, $keepSpaces(u*, w*, cp)) => (PARSED (n*))
  -- Interp: (chi, kappa, n*) => (RAISED chi' xi)
