Newspeak3
'Eurasia'
class RuntimeWithMirrors mirrors: mirrorsModule asts: astsModule parsing: parsingModule intermediates: intermediatesModule compilation: compilationModule metadataParsing: metadataParsingModule = (
	(* A platform with mirrors on Eurasia (EURASIA_M6_REFLECTION_DESIGN_2026-11-18.md), as PrimordialSoup/RuntimeWithMirrors's is on psoup: Eurasia's base platform (Runtime) and the mirrors (Mirrors, derived from psoup's by eurasia/kernel/fork-mirrors.py), over a namespace of the modules the mirrors build their compiler from. compilationModule is the V5 compilation, already applied to NewspeakBytecodeCompilation and NewspeakCompilation. *)
	
	|
		private Mirrors = mirrorsModule.
		private NewspeakASTs = astsModule.
		private NewspeakPredictiveParsing = parsingModule.
		private Intermediates = intermediatesModule.
		private Newspeak2V5BytecodeCompilation = compilationModule.
		private MetadataParsing = metadataParsingModule.
		public InternalKernel
		public Kernel
		public Collections
		public Actors
	|
) (
	class Namespace new = (
		(* The modules the mirrors ask for by name. *)
		
	) (
		public Intermediates = (
			^outer RuntimeWithMirrors Intermediates
		)
		public MetadataParsing = (
			^outer RuntimeWithMirrors MetadataParsing
		)
		public Newspeak2V5BytecodeCompilation = (
			^outer RuntimeWithMirrors Newspeak2V5BytecodeCompilation
		)
		public NewspeakASTs = (
			^outer RuntimeWithMirrors NewspeakASTs
		)
		public NewspeakPredictiveParsing = (
			^outer RuntimeWithMirrors NewspeakPredictiveParsing
		)
	) : ()
	public class Platform over: basePlatform internalKernel: ik = (
		|
			public kernel = basePlatform kernel.
			public collections = basePlatform collections.
			public victoryFuel = basePlatform victoryFuel.
			public actors = basePlatform actors.
			public js = basePlatform js.
			public mirrors = Mirrors usingPlatform: self
				internalKernel: ik
				namespace: Namespace new.
			private modulesNoted = outer RuntimeWithMirrors noteInternalKernel: ik
				base: basePlatform
				mirrors: mirrors.
		|
	) (
		public supportsLiveSnapshots ^<Boolean> = (
			(* Whether this platform saves a running image - its state, not only its code - and restores it into a new host (Eurasia: Actors>>saveImage:). After such a restore, Aliens made in the earlier host are dead (Alien isDead). *)
			
			^true
		)
	) : ()
	noteInternalKernel: ik base: basePlatform mirrors: mirrors = (
		(* Records, when the platform is made, the internal kernel's class (slot InternalKernel) and the modules of the base platform's Runtime (slots Kernel, Collections and Actors). psoup's RuntimeWithMirrors has the same slots, from its manifest; tools find the platform's classes through them: the test runner's namespace is the classes in these slots, and the typechecker resolves type paths such as Collections List[String] and the kernel's mixins in that namespace. *)
		
		| runtime = (mirrors ObjectMirror reflecting: basePlatform) getClass enclosingObject. |
		InternalKernel:: (mirrors ObjectMirror reflecting: ik) getClass reflectee.
		Kernel:: (runtime getSlot: #Kernel) reflectee.
		Collections:: (runtime getSlot: #Collections) reflectee.
		Actors:: (runtime getSlot: #Actors) reflectee
	)
) : (
	public keepsSources ^<Boolean> = (
		(* Whether an image of this platform keeps its methods' sources: yes, with mirrors, which show them (EURASIA_BUILD_AND_DEPLOY_DESIGN_2026-11-21.md, section 2.2: sources follow mirrors, as psoup's RuntimeWithMirrorsForPrimordialSoup answered). *)
		
		^true
	)
)
