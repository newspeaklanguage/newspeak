Newspeak3
'Eurasia'
class EurasiaHostTesting usingPlatform: platform testFramework: minitest = (
	(* Callbacks from the host on Eurasia's web host (VM_KERNEL_CONTRACT_DESIGN_2026-11-09.md section 4; VM_KERNEL_OPERATIONS_2026-11-10.md section 10). A Newspeak closure passed to JavaScript becomes a host function (an expat); calling it runs the closure above a boundary frame. These run on wasm only, under eurasia/scripts/web-tests.sh. *)
	
	|
		private js = platform js.
		private TestContext = minitest TestContext.
		private Promise = platform actors Promise.
		private Resolver = platform actors Resolver.
	|
) (
	public class CallbackTests new = TestContext new (
	) (
		nonLocalReturnThroughCallback = (
			(* The closure's ^ would return from this method, below the callback's boundary: it must raise cannotReturn: inside the callback instead, which the host sees as an exception. *)
			
			(js global eval: '(f) => { try { f(); return "ran" } catch (e) { return "refused" } }') callWithArguments: {[
					^'escaped'
				]. }.
			^'stayed'
		)
		public testArgumentsBeyondArityAreDropped = (
			assert: ((js global eval: '(f) => f(1, 2, 3)') callWithArguments: {[:a | a ]. })
				equals: 1
		)
		public testCallbackAnswersTheHost = (
			assert: ((js global eval: '(f) => f(20) + 1') callWithArguments: {[:x |
						x * 2
					]. })
				equals: 41
		)
		public testCallbacksNest = (
			| inner |
			inner:: js global eval: '(h) => h(5)'.
			assert: ((js global eval: '(f) => f() * 10') callWithArguments: {[
						inner callWithArguments: {[:x | x + 1 ]. }
					]. })
				equals: 60
		)
		public testExceptionStopsAtTheBoundary = (
			assert: ((js global eval: '(f) => { try { f(); return "ran" } catch (e) { return "caught" } }') callWithArguments: {[
						nil foo
					]. })
				equals: 'caught'
		)
		public testHostSeesTheException = (
			assert: (((js global eval: '(f) => { try { f(); return "" } catch (e) { return e.message } }') callWithArguments: {[
						Error signal: 'boom'
					]. }) includesSubstring: 'boom')
		)
		public testIdleCallbackStartsATurn = (
			(* A host timer calls the expat when the VM is idle: the callback starts a turn, and the send it makes runs after it. As on psoup, a callback must answer something that can cross to the host, here nil. *)
			
			| r |
			r:: Resolver new.
			js global setTimeout: [
					r fulfill: 6 <-: * 7.
					nil
				]
				with: 0.
			^Promise when: r promise
				fulfilled: [:v | assert: v equals: 42 ]
				broken: [:e | failWithMessage: 'broken: ' , e printString ]
		)
		public testMissingArgumentsAreNil = (
			assert: ((js global eval: '(f) => f()') callWithArguments: {[:a | a ]. })
				equals: nil
		)
		public testNonLocalReturnStopsAtTheBoundary = (
			assert: nonLocalReturnThroughCallback equals: 'stayed'
		)
		public testSortWithANewspeakComparator = (
			| a |
			a:: js global eval: '[3, 1, 2]'.
			a sort: [:x :y | x - y ].
			assert: (a join: ',') equals: '1,2,3'
		)
	) : (
		TEST_CONTEXT = (
		)
	)
) : ()
