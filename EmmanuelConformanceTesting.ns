		public test_print_rich = (
			check: {'print-rich'. 'value'. 'char*'. '$print("[" "\\" "t" "i" "t" "l" "e" ":" " " "[" "\\" "H" "a" "m" "l" "e" "t" "\\" "]" "\\" "]" "\n" "o" "o" "p" "s" "[" "\\" "(" "*" "c" "*" ")" "\\" "]" " " "[" "\\" "(" "*" "n" "*" ")" " " " " "p" "a" "r" "a" "g" "r" "a" "p" "h" "\\" "]" " " "a" "\\" "\\" "b" " " "\\" "[" "x" " " "[" "\\" "i" "t" "l" "a" "i" "c" "\\" "]" "z" "[" "\\" "e" "n" "d" "P" "a" "r" "a" "g" "r" "a" "p" "h" "\\" "]" "\n" "[" "\\" "p" "a" "r" "a" "g" "r" "a" "p" "h" "\\" "]" "e" "n" "d", (TREE (STATE "doc" (TREEV (MARKUP "doc" ((FINAL ("H" "a" "m" "l" "e" "t") (SPAN 11 17))) (SPAN 9 19)) (TREE (STATE "inline" eps) ((RUN ("H" "a" "m" "l" "e" "t") (SPAN 11 17))) (eps) CLOSED))) ((MUT (SEND (eps) "title:" ((HOSTEXPR 1 ((MARKUP "doc" ((FINAL ("H" "a" "m" "l" "e" "t") (SPAN 11 17))) (SPAN 9 19))))) (SPAN 2 19))) (STRAY ("\n" "o" "o" "p" "s") (SPAN 21 26)) (NOTE (SPAN 28 33)) (SUB (TREE (STATE "para" eps) ((RUN ("a" "\\" "b" " " "[" "x" " ") (SPAN 56 66)) (DNU (SEND (eps) "itlaic" (eps) (SPAN 68 74))) (RUN ("z") (SPAN 76 77))) ((SEND ((SPAN 38 43)) "paragraph" (eps) (SPAN 45 54)) (SEND (eps) "endParagraph" (eps) (SPAN 79 91))) CLOSED)) (SUB (TREE (STATE "para" eps) ((RUN ("e" "n" "d") (SPAN 107 110))) ((SEND (eps) "paragraph" (eps) (SPAN 96 105))) UNCLOSED))) ((SEND (eps) "title:" ((HOSTEXPR 1 ((MARKUP "doc" ((FINAL ("H" "a" "m" "l" "e" "t") (SPAN 11 17))) (SPAN 9 19))))) (SPAN 2 19))) CLOSED))'. '"[" "\\" "t" "i" "t" "l" "e" ":" " " "[" "\\" "H" "a" "m" "l" "e" "t" "\\" "]" "\\" "]" "\n" "o" "o" "p" "s" "[" "\\" "(" "*" "c" "*" ")" "\\" "]" "[" "\\" "(" "*" "n" "*" ")" " " "p" "a" "r" "a" "g" "r" "a" "p" "h" "\\" "]" "a" "\\" "\\" "b" " " "\\" "[" "x" " " "[" "\\" "i" "t" "l" "a" "i" "c" "\\" "]" "z" "[" "\\" "e" "n" "d" "P" "a" "r" "a" "g" "r" "a" "p" "h" "\\" "]" "[" "\\" "p" "a" "r" "a" "g" "r" "a" "p" "h" "\\" "]" "e" "n" "d"'. }
