Newspeak3
'Emmanuel'
class EmmanuelEdit usingPlatform: p emmanuel: em library: lib = (
	(* The edit layer of Emmanuel (Section 7 of the specification,
formal-semantics/emmanuel/spectec/08-edit.spectec): points, anchors,
splices, carets, tidying, the edits of the live view, and refusals.

It transcribes the specification definition by definition; a method's
comment names the definition when the name differs. Indices are the
specification's, from 0: a child index j is the (j + 1)th child.

An image is an Array of pairs of a source name and its code points. The
block side of the field interface is the blocks' (DocumentBlock fields:,
joins, enterPriority, understands:) and the library's (lib, which answers
styleOpen:, styleClose:, template:, and templateAfter:); the host side is
the host's (argSpan:index:, isStringLiteral:index:, encode:,
printsValue:image:, printValue:image:). *)
	
	|
		private List = p collections List.
		private emmanuel = em.
		private library = lib.
	|
) (
	public class Anchor kind: k node: i offset: j = (
		(* TXT i k (#txt), CUT i k (#cut), or ENDA (#end). *)
		
		|
			public kind = k.
			public node = i.
			public offset = j.
		|
	) (
		public = other = (
			^other isKindOfAnchor and: [
					kind = other kind and: [ node = other node and: [ offset = other offset ] ]
				]
		)
		public hash = (
			^kind hash
		)
		public isEnd = (
			^kind = #end
		)
		public isKindOfAnchor = (
			^true
		)
		public printTermOn: t = (
			kind = #end ifTrue: [ ^t atom: 'ENDA' ].
			t open;
				atom: (kind = #txt ifTrue: [ 'TXT' ] ifFalse: [ 'CUT' ]);
				nat: node;
				nat: offset;
				close
		)
	) : ()
	public class Caret point: pt anchor: a = (
		(* EXACT pt (a nil) or AT pt a. *)
		
		|
			public point = pt.
			public anchor = a.
		|
	) (
		public isExact = (
			^anchor isNil
		)
		public printTermOn: t = (
			anchor isNil ifTrue: [
					^t open;
						atom: 'EXACT';
						term: point;
						close
				].
			t open;
				atom: 'AT';
				term: point;
				term: anchor;
				close
		)
	) : ()
	public class Edit kind: k caret: c caret: c2 items: ws after: ws2 level: lv style: x steps: ss index: j chars: u = (
		(* An edit: #replace (REPLACE c c2 ws (AFTERCARET ws2)), #split
(SPLIT c lv), #style (STYLE c c2 x), #setString (SETSTRING ss j u), or
#detach (DETACH ss j). *)
		
		|
			public kind = k.
			public first = c.
			public second = c2.
			public items = ws.
			public afterItems = ws2.
			public level = lv.
			public style = x.
			public steps = ss.
			public index = j.
			public chars = u.
		|
	) (
		public printTermOn: t = (
			t open.
			kind = #replace ifTrue: [
					t atom: 'REPLACE';
						term: first;
						term: second;
						list: items;
						open;
						atom: 'AFTERCARET';
						list: afterItems;
						close
				].
			kind = #split ifTrue: [
					t atom: 'SPLIT';
						term: first;
						nat: level
				].
			kind = #style ifTrue: [
					t atom: 'STYLE';
						term: first;
						term: second;
						string: style
				].
			kind = #setString ifTrue: [
					t atom: 'SETSTRING';
						list: steps;
						nat: index;
						chars: chars
				].
			kind = #detach ifTrue: [
					t atom: 'DETACH';
						list: steps;
						nat: index
				].
			t close
		)
	) : ()
	public class EditResult source: y chars: w caret: k offers: os = (
		(* EDITED y w (CARETAT k, or SAMECARET when k is nil), or, when
offers is not nil, REFUSEDEDIT offers. *)
		
		|
			public sourceName = y.
			public chars = w.
			public caret = k.
			public offers = os.
		|
	) (
		public isRefused = (
			^offers isNil not
		)
		public printTermOn: t = (
			offers isNil ifFalse: [
					^t open;
						atom: 'REFUSEDEDIT';
						list: offers;
						close
				].
			t open;
				atom: 'EDITED';
				string: sourceName;
				chars: chars.
			caret isNil ifTrue: [ t atom: 'SAMECARET' ]
				ifFalse: [
					t open;
						atom: 'CARETAT';
						nat: caret;
						close
				].
			t close
		)
	) : ()
	class FieldRef steps: ss index: j markup: mk field: phi = (
		(* INFIELD ss j mk phi: the field a path entered. *)
		
		|
			public steps = ss.
			public index = j.
			public markup = mk.
			public field = phi.
		|
	) (
	) : ()
	class Found steps: ss index: j item: g = (
		(* FOUND ss j g. *)
		
		|
			public steps = ss.
			public index = j.
			public item = g.
		|
	) (
	) : ()
	class LItem kind: k ident: s inline: b statement: s2 origin: o item: w = (
		(* A marked item: LOP s b s2 o (#op), LCL s b s2 o (#cl), LIT w (#it),
or LCARET (#caret). *)
		
		|
			public kind = k.
			public ident = s.
			public inline = b.
			public statement = s2.
			public origin = o.
			public item = w.
		|
	) (
	) : ()
	public class Markup document: y literal: l = (
		(* DOCM y (literal nil) or LITM l. *)
		
		|
			public documentName = y.
			public literal = l.
		|
	) (
		public sourceName = (
			^literal isNil ifTrue: [ documentName ] ifFalse: [ literal sourceName ]
		)
	) : ()
	class Mctx source: y nodes: ns end: k = (
		(* MCTX y ns k: the markup being rewritten. *)
		
		|
			public sourceName = y.
			public nodes = ns.
			public end = k.
		|
	) (
	) : ()
	public class Nav markup: mk path: trs indices: is block: tr fieldRef: fr = (
		(* NAV mk trs is tr fr. *)
		
		|
			public markup = mk.
			public path = trs.
			public indices = is.
			public block = tr.
			public fieldRef = fr.
		|
	) (
		public depth = (
			^indices size
		)
	) : ()
	public class Offer steps: ss index: j = (
		(* OFFERDETACH ss j, or GIVEUP when ss is nil. *)
		
		|
			public steps = ss.
			public index = j.
		|
	) (
		public printTermOn: t = (
			steps isNil ifTrue: [ ^t atom: 'GIVEUP' ].
			t open;
				atom: 'OFFERDETACH';
				list: steps;
				nat: index;
				close
		)
	) : ()
	public class Point steps: ss child: j offset: k = (
		(* GAP ss j (k nil) or IN ss j k. *)
		
		|
			public steps = ss.
			public child = j.
			public offset = k.
		|
	) (
		public isGap = (
			^offset isNil
		)
		public printTermOn: t = (
			offset isNil ifTrue: [
					^t open;
						atom: 'GAP';
						list: steps;
						nat: child;
						close
				].
			t open;
				atom: 'IN';
				list: steps;
				nat: child;
				nat: offset;
				close
		)
	) : ()
	public class Range from: i to: j = (
		(* RNG i j. *)
		
		|
			public start = i.
			public end = j.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: 'RNG';
				nat: start;
				nat: end;
				close
		)
	) : ()
	class Spliced chars: w caret: k = (
		(* SPLICED w k. UNCHANGED is nil. *)
		
		|
			public chars = w.
			public caret = k.
		|
	) (
	) : ()
	public class Step field: b index: j = (
		(* INTO j, or FIELDOF j when b. *)
		
		|
			public isField = b.
			public index = j.
		|
	) (
		public printTermOn: t = (
			t open;
				atom: (isField ifTrue: [ 'FIELDOF' ] ifFalse: [ 'INTO' ]);
				nat: index;
				close
		)
	) : ()
	afterAt: k statements: ss rest: ns node: i = (
		k + 1 < ss size ifTrue: [ ^cut: i at: k + 1 ].
		ns isEmpty ifFalse: [ ^txt: i + 1 at: 0 ].
		^endAnchor
	)
	afterCaret: items = (
		1 to: items size
			do: [:i |
				(items at: i) kind = #caret ifTrue: [ ^items copyFrom: i + 1 to: items size ]
			].
		^{}
	)
	public afterNode: nodes tree: tr index: i = (
		| prev |
		i = 0 ifTrue: [ ^gap: {} at: 0 ].
		prev:: nodes at: i.
		prev statements isEmpty ifFalse: [
				^gapAfter: tr items steps: {} index: 0 statement: prev statements last
			].
		^place: nodes tree: tr anchor: (txt: i - 1 at: prev contents size)
	)
	public afterStmt: nodes statement: s = (
		(* afterStmt(n, sigma): the anchor just after a statement. *)
		
		nodes keysAndValuesDo: [:i :n |
				| k = posOf: s in: n statements. |
				k isNil ifFalse: [
						^afterAt: k
							statements: n statements
							rest: (nodes copyFrom: i + 1 to: nodes size)
							node: i - 1
					]
			].
		^Error signal: 'afterStmt: no node has the statement'
	)
	public anchor: nodes nav: nv point: pt = (
		(* anchor(n, nav, p): the anchor of a point. *)
		
		| kids = nv block items. g |
		pt isGap ifFalse: [
				g:: kids at: pt child + 1.
				^txt: (ixOf: nodes span: g span)
					at: ((rangesOf: nodes item: g) at: pt offset + 1) start
			].
		pt child = 0 ifTrue: [
				nv indices isEmpty ifTrue: [ ^start: nodes ].
				^afterStmt: nodes statement: nv block messages first
			].
		^endOf: nodes item: (kids at: pt child)
	)
	public anchorAt: nodes source: w offset: k = (
		(* anchorAt(n, w, k): the anchor at the offset k of the source w. *)
		
		nodes keysAndValuesDo: [:i :n |
				| s = n contentSpan. |
				(s start <= k and: [ k <= s end ]) ifTrue: [
						^txt: i - 1 at: (lenU: (take: k - s start from: (drop: s start from: w)))
					]
			].
		^endAnchor
	)
	public backspace: mk tree: tr steps: ss index: i = (
		(* backspace(mk, tr, pi, i): delete from the end of the block before
the one at ss (INTO i). *)
		
		| before = ss , {into: i - 1. }. |
		^replace: (exact: (gap: before
					at: (nav: mk tree: tr steps: before) block items size))
			to: (exact: (gap: ss , {into: i. } at: 0))
			items: {}
			after: {}
	)
	beforeCaret: items = (
		| out = List new. |
		items do: [:li |
				li kind = #caret ifTrue: [ ^out asArray ].
				out add: li
			].
		^out asArray
	)
	beforeStmt: nodes statement: s = (
		(* beforeStmt(n, sigma): the anchor just before a statement. *)
		
		nodes keysAndValuesDo: [:i :n |
				| k = posOf: s in: n statements. |
				k isNil ifFalse: [
						k = 0 ifTrue: [ ^txt: i - 1 at: n contents size ].
						^cut: i - 1 at: k
					]
			].
		^Error signal: 'beforeStmt: no node has the statement'
	)
	between: nodes from: a to: b = (
		(* between(n, a, a'): the items between two anchors. *)
		
		| i = a isEnd ifFalse: [ a node ]. j = b isEnd ifFalse: [ b node ]. |
		(a isEnd and: [ b isEnd ]) ifTrue: [ ^{} ].
		b isEnd ifTrue: [
				^(tailOf: (nodes at: i + 1) anchor: a) , (emmanuel itemsOf: (drop: i + 1
						from: nodes))
			].
		i = j ifTrue: [ ^midOf: (nodes at: i + 1) from: a to: b ].
		i < j ifTrue: [
				^(tailOf: (nodes at: i + 1) anchor: a) , (emmanuel itemsOf: (take: j - i - 1
						from: (drop: i + 1 from: nodes))) , (headOf: (nodes at: j + 1) anchor: b)
			].
		^Error signal: 'between: the anchors are out of order'
	)
	bracket: w statements: ss host: host = (
		^openSeq , (emmanuel show: (host print: ss source: w) source: w host: host) , closeSeq
	)
	cancel: items = (
		(* cancel(li, eps): an opening of an inline block followed by its
closing cancels, across the caret marker. *)
		
		| out = List new. |
		items do: [:li |
				(out isEmpty not and: [ cancels: li top: out last ]) ifTrue: [
						out removeLast
					]
					ifFalse: [
						(out size >= 2 and: [
								out last kind = #caret and: [ cancels: li top: (out at: out size - 1) ]
							]) ifTrue: [
								out removeLast.
								out removeLast.
								out add: caretItem
							]
							ifFalse: [ out add: li ]
					]
			].
		^out asArray
	)
	cancels: li top: top = (
		^li kind = #cl and: [
				top kind = #op and: [ li inline and: [ same: li ident as: top ident ] ]
			]
	)
	public canStyle: nv with: nv2 = (
		| k = commonLength: nv indices with: nv2 indices. q = (nv path at: k + 1) state contentClass. |
		^({#para. #cell. #inline. } includes: q) and: [
				(inlineFrom: nv path level: k + 1 to: nv depth) and: [
						inlineFrom: nv2 path level: k + 1 to: nv2 depth
					]
			]
	)
	caretAnchor: nodes nav: nv caret: c = (
		c isExact ifTrue: [ ^anchor: nodes nav: nv point: c point ].
		^c anchor
	)
	public caretIn: image name: y document: doc steps: ss offset: k = (
		(* The Caret relation, given the new document's nodes and tree. *)
		
		| nv nodes a |
		nv:: nav: (docMarkup: y) tree: (doc at: 2) steps: ss.
		nodes:: (mctx: image nodes: (doc at: 1) markup: nv markup) nodes.
		a:: anchorAt: nodes
			source: (source: image name: nv markup sourceName)
			offset: k.
		^Caret point: (prefix: ss point: (place: nodes tree: nv block anchor: a))
			anchor: a
	)
	public caretIn: image name: y hostState: chi root: kappa steps: ss offset: k host: host = (
		(* The Caret relation: the caret at the offset k in the new source of
the markup at the path ss. *)
		
		| doc = document: image name: y hostState: chi root: kappa host: host. |
		doc isNil ifTrue: [ ^nil ].
		^caretIn: image name: y document: doc steps: ss offset: k
	)
	caretItem = (
		^LItem kind: #caret
			ident: nil
			inline: false
			statement: nil
			origin: nil
			item: nil
	)
	public caretOK: nodes tree: tr steps: ss caret: c = (
		| pt |
		c isExact ifTrue: [ ^true ].
		c anchor kind = #cut ifTrue: [ ^false ].
		pt:: prefix: ss point: (place: nodes tree: tr anchor: c anchor).
		^(emmanuel termStringOf: pt) = (emmanuel termStringOf: c point)
	)
	clOf: tr = (
		^tr messages last
	)
	closedFrom: path level: lv to: lv2 = (
		lv to: lv2 do: [:l | (hasCloser: (path at: l + 1)) ifFalse: [ ^false ] ].
		^true
	)
	closeDown: path from: lv to: lv2 = (
		| out = List new. l ::= lv. |
		[ l >= lv2 ] whileTrue: [
				out add: (markCl: (path at: l + 1) origin: #ins).
				l:: l - 1
			].
		^out asArray
	)
	closeLevels: path indices: is point: pt from: lv to: lv2 = (
		(* M(L_l) cl(L_l) for l from the innermost out to lv2. *)
		
		| out = List new. l ::= lv. |
		[ l >= lv2 and: [ l > 0 ] ] whileTrue: [
				out addAll: (unmarkedStatements: (mLeft: path indices: is point: pt level: l)).
				out add: (markCl: (path at: l + 1) origin: #ins).
				l:: l - 1
			].
		^out asArray
	)
	closeSeq = (
		^{92. 93. }
	)
	closesIt: tr statement: s = (
		tr messages size < 2 ifTrue: [ ^false ].
		^tr flag ~= #unclosed and: [ same: tr messages last as: s ]
	)
	col: u from: k0 = (
		(* col(u): collapse(u), each character with the range of u it came from. *)
		
		| out = List new. i ::= 1. k ::= k0. r |
		[ i <= u size ] whileTrue: [
				(emmanuel isWS: (u at: i)) ifTrue: [
						r:: wsRun: u from: i + 1.
						out add: (Range from: k to: k + 1 + r).
						k:: k + 1 + r.
						i:: i + 1 + r
					]
					ifFalse: [
						out add: (Range from: k to: k + 1).
						k:: k + 1.
						i:: i + 1
					]
			].
		^out asArray
	)
	commonLength: is with: js = (
		| k ::= 0. |
		[ k < is size and: [ k < js size and: [ (is at: k + 1) = (js at: k + 1) ] ] ] whileTrue: [
				k:: k + 1
			].
		^k
	)
	countEnds: ranges at: k = (
		| n ::= 0. |
		ranges do: [:r |
				r end <= k ifFalse: [ ^n ].
				n:: n + 1
			].
		^n
	)
	countOrigin: items origin: o = (
		^(items select: [:li |
				(li kind = #op or: [ li kind = #cl ]) and: [ li origin = o ]
			]) size
	)
	cut: i at: k = (
		^Anchor kind: #cut node: i offset: k
	)
	detachable: image name: y fieldRef: fr host: host = (
		fr isNil ifTrue: [ ^false ].
		^(prov: image name: y markup: fr markup) ~= #computed and: [
				host printsValue: fr field value image: image
			]
	)
	docMarkup: y = (
		^Markup document: y literal: nil
	)
	public document: image name: y hostState: chi root: kappa host: host = (
		(* Document: the nodes and the tree of the source y, or nil. *)
		
		| parsed = emmanuel parse: y source: (source: image name: y) host: host. done |
		(parsed isNil or: [ parsed isKindOfParsed not ]) ifTrue: [ ^nil ].
		done:: (emmanuel Machine host: host) interpret: parsed nodes
			root: kappa
			hostState: chi.
		done isKindOfDone ifFalse: [ ^nil ].
		^{parsed nodes. done tree. }
	)
	drop: k from: u = (
		k >= u size ifTrue: [ ^{} ].
		^u copyFrom: k + 1 to: u size
	)
	dropEmpty: items = (
		^(items reject: [:li |
				li kind = #it and: [ li item isText and: [ li item text isEmpty ] ]
			]) asArray
	)
	public edit: e image: image name: y document: doc host: host = (
		(* The Edit relation, given the document's nodes and tree (as document:
answers them). *)
		
		| nodes tr |
		nodes:: doc at: 1.
		tr:: doc at: 2.
		(e kind = #setString or: [ e kind = #detach ]) ifTrue: [
				^editField: e image: image name: y nodes: nodes tree: tr host: host
			].
		^editAtPoints: e image: image name: y nodes: nodes tree: tr host: host
	)
	public edit: e image: image name: y hostState: chi root: kappa host: host = (
		(* The Edit relation: the result of an edit of the document y, or nil
when no rule applies. *)
		
		| doc = document: image name: y hostState: chi root: kappa host: host. |
		doc isNil ifTrue: [ ^nil ].
		^edit: e image: image name: y document: doc host: host
	)
	editAtPoints: e image: image name: y nodes: nodes tree: tr host: host = (
		| pt = e first point. nv = nav: (docMarkup: y) tree: tr steps: pt steps. two = e kind ~= #split. nv2 mc a b lv |
		two ifTrue: [
				nv2:: nav: (docMarkup: y) tree: tr steps: e second point steps.
				(sameTree: nv with: nv2) ifFalse: [ ^refused: {giveUp. } ]
			].
		(prov: image name: y markup: nv markup) = #computed ifTrue: [
				^refused: (offers: image name: y fieldRef: nv fieldRef host: host)
			].
		mc:: mctx: image nodes: nodes markup: nv markup.
		a:: caretAnchor: mc nodes nav: nv caret: e first.
		e kind = #replace ifTrue: [
				b:: caretAnchor: mc nodes nav: nv2 caret: e second.
				^result: image
					name: nv markup sourceName
					spliced: (replace: image
						context: mc
						nav: nv
						point: pt
						anchor: a
						nav: nv2
						point: e second point
						anchor: b
						items: e items
						after: e afterItems
						host: host)
			].
		e kind = #split ifTrue: [
				lv:: e level.
				(lv >= 1 and: [
						lv <= nv depth and: [ closedFrom: nv path level: lv to: nv depth ]
					]) ifFalse: [ ^refused: {giveUp. } ].
				^result: image
					name: nv markup sourceName
					spliced: (split: image
						context: mc
						nav: nv
						point: pt
						anchor: a
						level: lv
						host: host)
			].
		(canStyle: nv with: nv2) ifFalse: [ ^refused: {giveUp. } ].
		b:: caretAnchor: mc nodes nav: nv2 caret: e second.
		^result: image
			name: nv markup sourceName
			spliced: (style: image
				context: mc
				nav: nv
				point: pt
				anchor: a
				nav: nv2
				point: e second point
				anchor: b
				style: e style
				host: host)
	)
	editField: e image: image name: y nodes: nodes tree: tr host: host = (
		(* Setting a string and detaching: the argument's text is replaced. *)
		
		| nv = nav: (docMarkup: y) tree: tr steps: e steps. mk = nv markup. phi = (nv block state fields: nv block messages) at: e index + 1. w = source: image
			name: mk sourceName. fr = FieldRef steps: e steps
			index: e index
			markup: mk
			field: phi. span replacement |
		e kind = #setString ifTrue: [
				((prov: image name: y markup: mk) ~= #computed and: [
						host isStringLiteral: phi statement index: phi index
					]) ifFalse: [ ^refused: (offers: image name: y fieldRef: fr host: host) ].
				replacement:: host encode: e chars
			]
			ifFalse: [
				(detachable: image name: y fieldRef: fr host: host) ifFalse: [
						^refused: {giveUp. }
					].
				replacement:: host printValue: phi value image: image
			].
		span:: host argSpan: phi statement index: phi index.
		^EditResult source: mk sourceName
			chars: (take: span start from: w) , replacement , (drop: span end from: w)
			caret: nil
			offers: nil
	)
	endAnchor = (
		^Anchor kind: #end node: nil offset: nil
	)
	endOf: nodes item: g = (
		(* end(g): the anchor after a child; after a leaf, which has only its
creating message, the anchor after that. *)
		
		| tr |
		g kind = #run ifTrue: [
				^txt: (ixOf: nodes span: g span) at: (rangesOf: nodes item: g) last end
			].
		g kind = #stray ifTrue: [ ^txt: (ixOf: nodes span: g span) at: g chars size ].
		g kind = #sub ifTrue: [
				tr:: g ref.
				(tr messages isEmpty not and: [ tr flag ~= #unclosed ]) ifFalse: [
						^Error signal: 'endOf: an unclosed block'
					].
				^afterStmt: nodes statement: tr messages last
			].
		g kind = #note ifTrue: [
				^afterStmt: nodes statement: (emmanuel CommentStatement span: g span)
			].
		^afterStmt: nodes statement: g statement
	)
	endsAt: tr statement: s = (
		^(closesIt: tr statement: s) or: [
				(isPushed: tr) not and: [ same: s as: (opOf: tr) ]
			]
	)
	public enter: mk tree: tr caret: c = (
		(* enter(mk, tr, ca): Enter splits the innermost block on the point's
path of the highest enter priority (a list item, else a paragraph). *)
		
		| nv = nav: mk tree: tr steps: c point steps. best ::= 0. level ::= nil. |
		1 to: nv depth
			do: [:lv |
				| p = (nv path at: lv + 1) state enterPriority. |
				(p > 0 and: [ p >= best ]) ifTrue: [
						best:: p.
						level:: lv
					]
			].
		level isNil ifTrue: [ ^nil ].
		^split: c level: level
	)
	erasedEqual: s with: s2 = (
		^(emmanuel termStringOf: s erased) = (emmanuel termStringOf: s2 erased)
	)
	public exact: pt = (
		^Caret point: pt anchor: nil
	)
	public fieldOf: j = (
		^Step field: true index: j
	)
	findText: kids steps: ss index: j0 span: s = (
		| j ::= j0. found |
		kids do: [:g |
				((g kind = #run or: [ g kind = #stray ]) and: [ g span = s ]) ifTrue: [
						^Found steps: ss index: j item: g
					].
				g kind = #sub ifTrue: [
						found:: findText: g ref items steps: ss , {into: j. } index: 0 span: s.
						found isNil ifFalse: [ ^found ]
					].
				j:: j + 1
			].
		^nil
	)
	public gap: ss at: j = (
		^Point steps: ss child: j offset: nil
	)
	gapAfter: kids steps: ss index: j0 statement: s = (
		(* gapAfter: the gap just after a statement, where it left its mark. *)
		
		| j ::= j0. found |
		kids do: [:g |
				g kind = #sub ifTrue: [
						(startsAt: g ref statement: s) ifTrue: [ ^gap: ss , {into: j. } at: 0 ].
						(endsAt: g ref statement: s) ifTrue: [ ^gap: ss at: j + 1 ].
						found:: gapAfter: g ref items
							steps: ss , {into: j. }
							index: 0
							statement: s.
						found isNil ifFalse: [ ^found ]
					]
					ifFalse: [ (marks: g statement: s) ifTrue: [ ^gap: ss at: j + 1 ] ].
				j:: j + 1
			].
		^nil
	)
	giveUp = (
		^Offer steps: nil index: nil
	)
	hasCloser: tr = (
		^tr flag ~= #unclosed and: [ tr messages size >= 2 ]
	)
	headOf: n anchor: a = (
		a kind = #txt ifTrue: [ ^{textItem: (take: a offset from: n contents). } ].
		^{textItem: n contents. } , (statementItems: (take: a offset
				from: n statements))
	)
	hiAt: is point: pt level: lv = (
		lv < is size ifTrue: [ ^is at: lv + 1 ].
		^pt child
	)
	idRanges: u from: k = (
		^(1 to: u size) asArray collect: [:i | Range from: k + i - 1 to: k + i ]
	)
	public in: ss at: j offset: k = (
		^Point steps: ss child: j offset: k
	)
	inImage: image name: y = (
		^image anySatisfy: [:entry | (entry at: 1) = y ]
	)
	inlineFrom: path level: lv to: lv2 = (
		lv to: lv2 do: [:l | (isInline: (path at: l + 1)) ifFalse: [ ^false ] ].
		^true
	)
	public insertAt: mk tree: tr caret: c selector: x = (
		(* insertAt(mk, tr, ca, x): the template of the opener x at the caret,
where the block at the point understands it; nil otherwise. *)
		
		| block = (nav: mk tree: tr steps: c point steps) block. |
		(block state understands: x) ifFalse: [ ^nil ].
		^replace: c
			to: c
			items: (library template: x)
			after: (library templateAfter: x)
	)
	insideText: g offset: k = (
		(g kind = #run or: [ g kind = #stray ]) ifFalse: [ ^false ].
		^0 < k and: [ k < g chars size ]
	)
	public into: j = (
		^Step field: false index: j
	)
	isInline: tr = (
		^tr state contentClass = #inline
	)
	public isPoint: mk tree: tr point: pt = (
		| kids = (nav: mk tree: tr steps: pt steps) block items. |
		pt isGap ifTrue: [ ^pt child <= kids size ].
		pt child < kids size ifFalse: [ ^false ].
		^insideText: (kids at: pt child + 1) offset: pt offset
	)
	isPushed: tr = (
		^tr flag = #unclosed or: [ tr messages size >= 2 ]
	)
	ixOf: nodes span: s = (
		(* The index of the node whose contents have the span s. *)
		
		nodes keysAndValuesDo: [:i :n | n contentSpan = s ifTrue: [ ^i - 1 ] ].
		^Error signal: 'ixOf: no node has the span'
	)
	join: tr with: tr2 = (
		(* B ~ B': the blocks join. *)
		
		^tr state joins and: [ erasedEqual: (opOf: tr) with: (opOf: tr2) ]
	)
	joinDepth: nv point: pt nav: nv2 point: pt2 common: k = (
		| j ::= 0. |
		[
			k + j + 1 <= nv depth and: [
					k + j + 1 <= nv2 depth and: [
							(join: (nv path at: k + j + 2) with: (nv2 path at: k + j + 2)) and: [
									(mJoin: nv point: pt nav: nv2 point: pt2 common: k join: j) isEmpty
								]
						]
				]
		] whileTrue: [ j:: j + 1 ].
		^j
	)
	left: w nodes: nodes anchor: a host: host = (
		| n |
		a isEnd ifTrue: [ ^{} ].
		n:: nodes at: a node + 1.
		a kind = #txt ifTrue: [ ^emmanuel esc: (take: a offset from: n contents) ].
		^bracket: w statements: (take: a offset from: n statements) host: host
	)
	leftNeighbours: nv point: pt = (
		(* leftNb: the marked creating messages just before a first gap. *)
		
		| out = List new. lv ::= nv depth. |
		(pt isGap and: [ pt child = 0 and: [ nv depth > 0 ] ]) ifFalse: [ ^{} ].
		out add: (markOp: (nv path at: lv + 1) origin: #outL).
		[ lv > 1 and: [ (nv indices at: lv) = 0 ] ] whileTrue: [
				lv:: lv - 1.
				out addFirst: (markOp: (nv path at: lv + 1) origin: #outL)
			].
		^out asArray
	)
	lenU: u = (
		(* The number of characters a source text lexes to: an escape is one. *)
		
		| n ::= 0. i ::= 1. |
		[ i <= u size ] whileTrue: [
				((u at: i) = 92 and: [
						i < u size and: [ (u at: i + 1) = 92 or: [ (u at: i + 1) = 91 ] ]
					]) ifTrue: [ i:: i + 2 ] ifFalse: [ i:: i + 1 ].
				n:: n + 1
			].
		^n
	)
	litem: w = (
		^LItem kind: #it ident: nil inline: false statement: nil origin: nil item: w
	)
	loAt: is point: pt level: lv = (
		lv < is size ifTrue: [ ^(is at: lv + 1) + 1 ].
		pt isGap ifTrue: [ ^pt child ].
		^pt child + 1
	)
	locRun: u collapsed: u2 = (
		(* loc of a run: col of its node's contents, less what trimming removed. *)
		
		| c = emmanuel collapse: u. ranges = col: u from: 0. |
		(sameChars: c as: u2) ifTrue: [ ^ranges ].
		(sameChars: c as: {32. } , u2) ifTrue: [ ^drop: 1 from: ranges ].
		(sameChars: c as: u2 , {32. }) ifTrue: [ ^take: ranges size - 1 from: ranges ].
		(sameChars: c as: {32. } , u2 , {32. }) ifTrue: [
				^take: ranges size - 2 from: (drop: 1 from: ranges)
			].
		^Error signal: 'locRun: the run is not its contents'
	)
	lpos: nodes end: k anchor: a = (
		a isEnd ifTrue: [ ^k ].
		a kind = #txt ifTrue: [ ^(nodes at: a node + 1) contentSpan start ].
		^(nodes at: a node + 1) contentSpan end
	)
	markCl: tr origin: o = (
		^LItem kind: #cl
			ident: (opOf: tr)
			inline: (isInline: tr)
			statement: (clOf: tr)
			origin: o
			item: nil
	)
	marked: items nav: nv nav: nv2 common: k = (
		(* The closing messages of the L_i and the creating messages of the R_i
among the items, marked. *)
		
		^items collect: [:w |
				w isText ifTrue: [ litem: w ]
					ifFalse: [ markStatement: w statement nav: nv nav: nv2 from: k + 1 ]
			]
	)
	markOp: tr origin: o = (
		^LItem kind: #op
			ident: (opOf: tr)
			inline: (isInline: tr)
			statement: (opOf: tr)
			origin: o
			item: nil
	)
	marks: g statement: s = (
		({#mut. #dnu. #refused. #rootPop. } includes: g kind) ifTrue: [
				^same: g statement as: s
			].
		g kind = #note ifTrue: [ ^s isComment and: [ s span = g span ] ].
		^false
	)
	markStatement: s nav: nv nav: nv2 from: lv = (
		lv to: nv depth
			do: [:l |
				| tr = nv path at: l + 1. |
				((hasCloser: tr) and: [ same: s as: (clOf: tr) ]) ifTrue: [
						^markCl: tr origin: #ins
					]
			].
		lv to: nv2 depth
			do: [:l |
				| tr = nv2 path at: l + 1. |
				(same: s as: (opOf: tr)) ifTrue: [ ^markOp: tr origin: #ins ]
			].
		^litem: (statementItem: s)
	)
	mctx: image nodes: nodes markup: mk = (
		| l = mk literal. |
		l isNil ifTrue: [
				^Mctx source: mk documentName
					nodes: nodes
					end: (source: image name: mk documentName) size
			].
		^Mctx source: l sourceName nodes: l nodes end: l span end - 2
	)
	midOf: n from: a to: b = (
		(a kind = #txt and: [ b kind = #txt ]) ifTrue: [
				^{textItem: (take: b offset - a offset
						from: (drop: a offset from: n contents)). }
			].
		(a kind = #txt and: [ b kind = #cut ]) ifTrue: [
				^{textItem: (drop: a offset from: n contents). } , (statementItems: (take: b offset
						from: n statements))
			].
		(a kind = #cut and: [ b kind = #cut ]) ifTrue: [
				^statementItems: (take: b offset - a offset
						from: (drop: a offset from: n statements))
			].
		^Error signal: 'midOf: the anchors are out of order'
	)
	mJoin: nv point: pt nav: nv2 point: pt2 common: k join: j = (
		j = 0 ifTrue: [
				^mutsIn: (nv path at: k + 1) items
					from: (loAt: nv indices point: pt level: k)
					to: (hiAt: nv2 indices point: pt2 level: k)
			].
		^(mLeft: nv path indices: nv indices point: pt level: k + j) , (mRight: nv2 path
			indices: nv2 indices
			point: pt2
			level: k + j)
	)
	mLeft: path indices: is point: pt level: lv = (
		^mutsIn: (path at: lv + 1) items
			from: (loAt: is point: pt level: lv)
			to: 1000000
	)
	mRight: path indices: is point: pt level: lv = (
		^mutsIn: (path at: lv + 1) items from: 0 to: (hiAt: is point: pt level: lv)
	)
	mutsIn: kids from: lo to: hi = (
		| out = List new. |
		kids keysAndValuesDo: [:i :g |
				(i - 1 >= lo and: [ i - 1 < hi and: [ g kind = #mut ] ]) ifTrue: [
						out add: g statement
					]
			].
		^out asArray
	)
	public nav: mk tree: tr steps: ss = (
		(* nav(mk, tr, pi): follow a path. *)
		
		| markup ::= mk. path ::= List new. indices ::= List new. block ::= tr. fr ::= nil. prefix = List new. phi v |
		path add: tr.
		ss do: [:step |
				step isField ifTrue: [
						phi:: (block state fields: block messages) at: step index + 1.
						v:: phi value.
						v isKindOfTreeValue ifFalse: [
								^Error signal: 'nav: the field holds no markup'
							].
						fr:: FieldRef steps: prefix asArray
							index: step index
							markup: markup
							field: phi.
						markup:: Markup document: nil literal: v literal.
						block:: v tree.
						path:: List new.
						path add: block.
						indices:: List new
					]
					ifFalse: [
						block:: (block items at: step index + 1) ref.
						path add: block.
						indices add: step index
					].
				prefix add: step
			].
		^Nav markup: markup
			path: path asArray
			indices: indices asArray
			block: block
			fieldRef: fr
	)
	offers: image name: y fieldRef: fr host: host = (
		(detachable: image name: y fieldRef: fr host: host) ifTrue: [
				^{Offer steps: fr steps index: fr index. giveUp. }
			].
		^{giveUp. }
	)
	openLevels: path indices: is point: pt from: lv to: lv2 = (
		(* op(R_l) M(R_l) for l from lv in to the innermost. *)
		
		| out = List new. |
		lv to: lv2
			do: [:l |
				out add: (markOp: (path at: l + 1) origin: #ins).
				out addAll: (unmarkedStatements: (mRight: path
							indices: is
							point: pt
							level: l))
			].
		^out asArray
	)
	openSeq = (
		^{91. 92. }
	)
	openUp: path from: lv to: lv2 = (
		^(lv to: lv2) asArray collect: [:l | markOp: (path at: l + 1) origin: #ins ]
	)
	opOf: tr = (
		^tr messages first
	)
	out: w items: items host: host = (
		(* out(w, omega): text escaped, runs of statements as brackets. *)
		
		| result ::= {}. pending = List new. |
		items do: [:i |
				i isText ifTrue: [
						pending isEmpty ifFalse: [
								result:: result , (bracket: w statements: pending asArray host: host).
								pending removeAll
							].
						result:: result , (emmanuel esc: i text)
					]
					ifFalse: [ pending add: i statement ]
			].
		pending isEmpty ifFalse: [
				result:: result , (bracket: w statements: pending asArray host: host)
			].
		^result
	)
	public place: nodes tree: tr anchor: a = (
		(* place(n, tr, a): the point an anchor resolves to. *)
		
		| found ranges count |
		a isEnd ifTrue: [ ^afterNode: nodes tree: tr index: nodes size ].
		a kind = #cut ifTrue: [ ^Error signal: 'place: a cut' ].
		found:: findText: tr items
			steps: {}
			index: 0
			span: (nodes at: a node + 1) contentSpan.
		found isNil ifTrue: [ ^afterNode: nodes tree: tr index: a node ].
		ranges:: rangesOf: nodes item: found item.
		count:: countEnds: ranges at: a offset.
		count = 0 ifTrue: [ ^gap: found steps at: found index ].
		count = ranges size ifTrue: [ ^gap: found steps at: found index + 1 ].
		^in: found steps at: found index offset: count
	)
	posOf: s in: statements = (
		statements keysAndValuesDo: [:i :t | (same: t as: s) ifTrue: [ ^i - 1 ] ].
		^nil
	)
	prefix: ss point: pt = (
		^Point steps: ss , pt steps child: pt child offset: pt offset
	)
	prov: image name: y markup: mk = (
		mk sourceName = y ifTrue: [ ^#local ].
		(inImage: image name: mk sourceName) ifTrue: [ ^#template ].
		^#computed
	)
	public rangesOf: nodes item: g = (
		g kind = #run ifTrue: [
				^locRun: (nodes at: (ixOf: nodes span: g span) + 1) contents
					collapsed: g chars
			].
		^idRanges: g chars from: 0
	)
	refused: offers = (
		^EditResult source: nil chars: nil caret: nil offers: offers
	)
	replace: image context: mc nav: nv point: pt anchor: a nav: nv2 point: pt2 anchor: b items: ws after: ws2 host: host = (
		(* replace(c, c', omega, omega'). *)
		
		| k = commonLength: nv indices with: nv2 indices. j = joinDepth: nv
			point: pt
			nav: nv2
			point: pt2
			common: k. |
		^tidy: (source: image name: mc sourceName)
			context: mc
			left: (leftNeighbours: nv point: pt)
			items: (unmarked: ws) , {caretItem. } , (unmarked: ws2) , (closeLevels: nv path
				indices: nv indices
				point: pt
				from: nv depth
				to: k + j + 1) , (unmarkedStatements: (mJoin: nv
					point: pt
					nav: nv2
					point: pt2
					common: k
					join: j)) , (openLevels: nv2 path
				indices: nv2 indices
				point: pt2
				from: k + j + 1
				to: nv2 depth)
			right: (rightNeighbours: nv2 point: pt2)
			from: a
			to: b
			host: host
	)
	public replace: c to: c2 items: ws after: ws2 = (
		^Edit kind: #replace
			caret: c
			caret: c2
			items: ws
			after: ws2
			level: nil
			style: nil
			steps: nil
			index: nil
			chars: nil
	)
	result: image name: y spliced: sp = (
		sp isNil ifTrue: [
				^EditResult source: y chars: (source: image name: y) caret: nil offers: nil
			].
		^EditResult source: y chars: sp chars caret: sp caret offers: nil
	)
	right: w nodes: nodes anchor: a host: host = (
		| n |
		a isEnd ifTrue: [ ^{} ].
		n:: nodes at: a node + 1.
		a kind = #txt ifTrue: [ ^emmanuel esc: (drop: a offset from: n contents) ].
		^bracket: w statements: (drop: a offset from: n statements) host: host
	)
	rightNeighbours: nv point: pt = (
		(* rightNb: the closing messages just after a last gap. *)
		
		| out = List new. lv ::= nv depth. |
		(pt isGap and: [
				nv depth > 0 and: [
						pt child = nv block items size and: [ hasCloser: nv block ]
					]
			]) ifFalse: [ ^{} ].
		out add: (markCl: (nv path at: lv + 1) origin: #outR).
		[
			lv > 1 and: [
					(nv indices at: lv) + 1 = (nv path at: lv) items size and: [
							hasCloser: (nv path at: lv)
						]
				]
		] whileTrue: [
				lv:: lv - 1.
				out add: (markCl: (nv path at: lv + 1) origin: #outR)
			].
		^out asArray
	)
	rpos: nodes end: k anchor: a = (
		a isEnd ifTrue: [ ^k ].
		a kind = #txt ifTrue: [ ^(nodes at: a node + 1) contentSpan end ].
		^(nodes at: a node + 1) span end
	)
	same: s as: s2 = (
		(* Statements are equal as terms: spans included. *)
		
		s == s2 ifTrue: [ ^true ].
		^(emmanuel termStringOf: s) = (emmanuel termStringOf: s2)
	)
	sameChars: u as: u2 = (
		u size = u2 size ifFalse: [ ^false ].
		1 to: u size do: [:i | (u at: i) = (u2 at: i) ifFalse: [ ^false ] ].
		^true
	)
	sameMarkup: mk as: mk2 = (
		mk literal isNil ifTrue: [
				^mk2 literal isNil and: [ mk documentName = mk2 documentName ]
			].
		mk2 literal isNil ifTrue: [ ^false ].
		^mk literal == mk2 literal or: [
				(emmanuel termStringOf: mk literal) = (emmanuel termStringOf: mk2 literal)
			]
	)
	sameTree: nv with: nv2 = (
		^(sameMarkup: nv markup as: nv2 markup) and: [
				nv path first == nv2 path first
			]
	)
	source: image name: y = (
		image do: [:entry | (entry at: 1) = y ifTrue: [ ^entry at: 2 ] ].
		^Error signal: 'no source ' , y
	)
	splice: w context: mc from: a to: b items: ws after: ws2 host: host = (
		| lp = lpos: mc nodes end: mc end anchor: a. left = left: w
			nodes: mc nodes
			anchor: a
			host: host. before = out: w items: ws host: host. |
		(a = b and: [ ws isEmpty and: [ ws2 isEmpty ] ]) ifTrue: [ ^nil ].
		^Spliced chars: (take: lp from: w) , left , before , (out: w
				items: ws2
				host: host) , (right: w nodes: mc nodes anchor: b host: host) , (drop: (rpos: mc nodes
					end: mc end
					anchor: b)
				from: w)
			caret: lp + left size + before size
	)
	split: image context: mc nav: nv point: pt anchor: a level: lv host: host = (
		^tidy: (source: image name: mc sourceName)
			context: mc
			left: (leftNeighbours: nv point: pt)
			items: (closeDown: nv path from: nv depth to: lv) , (openUp: nv path
				from: lv
				to: nv depth) , {caretItem. }
			right: (rightNeighbours: nv point: pt)
			from: a
			to: a
			host: host
	)
	public split: c level: lv = (
		^Edit kind: #split
			caret: c
			caret: nil
			items: nil
			after: nil
			level: lv
			style: nil
			steps: nil
			index: nil
			chars: nil
	)
	start: nodes = (
		nodes isEmpty ifTrue: [ ^endAnchor ].
		^txt: 0 at: 0
	)
	startsAt: tr statement: s = (
		^(isPushed: tr) and: [ same: s as: (opOf: tr) ]
	)
	statementItem: s = (
		^emmanuel Item text: nil span: nil statement: s
	)
	statementItems: ss = (
		^ss collect: [:s | statementItem: s ]
	)
	style: image context: mc nav: nv point: pt anchor: a nav: nv2 point: pt2 anchor: b style: x host: host = (
		| k = commonLength: nv indices with: nv2 indices. lv = styled: nv path
			level: k
			style: x. between = marked: (between: mc nodes from: a to: b)
			nav: nv
			nav: nv2
			common: k. items |
		lv isNil ifTrue: [
				items:: (closeDown: nv path from: nv depth to: k + 1) , {LItem kind: #op
					ident: (library styleOpen: x)
					inline: true
					statement: (library styleOpen: x)
					origin: #ins
					item: nil. } , (openUp: nv path from: k + 1 to: nv depth) , between , {caretItem. } , (closeDown: nv2 path
					from: nv2 depth
					to: k + 1) , {LItem kind: #cl
					ident: (library styleOpen: x)
					inline: true
					statement: (library styleClose: x)
					origin: #ins
					item: nil. } , (openUp: nv2 path from: k + 1 to: nv2 depth)
			]
			ifFalse: [
				items:: (closeDown: nv path from: nv depth to: lv + 1) , {markCl: (nv path at: lv + 1)
					origin: #ins. } , (openUp: nv path from: lv + 1 to: nv depth) , between , {caretItem. } , (closeDown: nv2 path
					from: nv2 depth
					to: lv + 1) , {markOp: (nv path at: lv + 1) origin: #ins. } , (openUp: nv2 path
					from: lv + 1
					to: nv2 depth)
			].
		^tidy: (source: image name: mc sourceName)
			context: mc
			left: (leftNeighbours: nv point: pt)
			items: items
			right: (rightNeighbours: nv2 point: pt2)
			from: a
			to: b
			host: host
	)
	styled: path level: lv0 style: x = (
		(* The innermost block on the path, at depth <= lv0, that is the style
x: its depth, or nil. *)
		
		| lv ::= lv0. tr |
		[ lv >= 0 ] whileTrue: [
				tr:: path at: lv + 1.
				((isInline: tr) and: [
						tr messages isEmpty not and: [
								erasedEqual: (opOf: tr) with: (library styleOpen: x)
							]
					]) ifTrue: [ ^lv ].
				lv:: lv - 1
			].
		^nil
	)
	tailOf: n anchor: a = (
		a kind = #txt ifTrue: [
				^{textItem: (drop: a offset from: n contents). } , (statementItems: n statements)
			].
		^statementItems: (drop: a offset from: n statements)
	)
	take: k from: u = (
		k >= u size ifTrue: [ ^u ].
		k <= 0 ifTrue: [ ^{} ].
		^u copyFrom: 1 to: k
	)
	textItem: u = (
		^emmanuel Item text: u span: (emmanuel Span from: 0 to: 0) statement: nil
	)
	tidy: w context: mc left: left items: items right: right from: a to: b host: host = (
		(* tidy: cancel, then splice, widened over the creating messages
removed before it and the closing messages removed after it. *)
		
		| tidied |
		(a = b and: [ items allSatisfy: [:li | li kind = #caret ] ]) ifTrue: [ ^nil ].
		tidied:: cancel: (dropEmpty: left , items , right).
		^splice: w
			context: mc
			from: (widenLeft: mc nodes
				items: left
				kept: (countOrigin: tidied origin: #outL)
				anchor: a)
			to: (widenRight: mc nodes
				items: right
				kept: (countOrigin: tidied origin: #outR)
				anchor: b)
			items: (written: (beforeCaret: tidied))
			after: (written: (afterCaret: tidied))
			host: host
	)
	txt: i at: k = (
		^Anchor kind: #txt node: i offset: k
	)
	unmarked: items = (
		^items collect: [:w | litem: w ]
	)
	unmarkedStatements: ss = (
		^unmarked: (statementItems: ss)
	)
	widenLeft: nodes items: left kept: k anchor: a = (
		k = left size ifTrue: [ ^a ].
		^beforeStmt: nodes statement: (left at: k + 1) statement
	)
	widenRight: nodes items: right kept: k anchor: b = (
		k = right size ifTrue: [ ^b ].
		^afterStmt: nodes statement: (right at: right size - k) statement
	)
	written: items = (
		(* The items the splice writes: everything inside it. *)
		
		| out = List new. |
		items do: [:li |
				li kind = #it ifTrue: [ out add: li item ].
				((li kind = #op or: [ li kind = #cl ]) and: [ li origin = #ins ]) ifTrue: [
						out add: (statementItem: li statement)
					]
			].
		^out asArray
	)
	wsRun: u from: i = (
		| n ::= 0. |
		[ i + n <= u size and: [ emmanuel isWS: (u at: i + n) ] ] whileTrue: [
				n:: n + 1
			].
		^n
	)
) : ()
