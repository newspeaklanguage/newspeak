Newspeak3
'Emmanuel'
class EmmanuelViewTesting usingPlatform: p minitest: m view: v = (
	(* Headless tests of the block library (EmmanuelBlocks) through
EmmanuelView's treeOf:, with the Newspeak host: the trees that real sources
give. Rendering needs a browser and is checked in the IDE. *)
	
	|
		private TestContext = m TestContext.
		private view = v.
	|
) (
	class GreetingLibrary usingPlatform: p emmanuel: em = LibraryClass usingPlatform: p
		emmanuel: em (
		(* A template's library: the library, whose blocks also understand
greet:, a construct answering a block of the template's own. *)
		
	) (
		class Greeting to: who = LibraryBlock new (
			|
				public who = who.
			|
		) (
			public model = (
				^{}
			)
			public stateName = (
				^'greeting'
			)
			public stateValues = (
				^{who. }
			)
		) : ()
		class LibraryBlock new = super LibraryBlock new (
		) (
			public greet: who = (
				^Greeting to: who
			)
		) : ()
	) : ()
	public class LibraryTests new = TestContext new (
	) (
		kinds: tree = (
			^tree items collect: [:g | g kind ]
		)
		problemsOf: tree = (
			(* The error leaves and unclosed blocks of a tree, in order. *)
			
			| out ::= ''. |
			tree flag = #closed ifFalse: [
					out:: out , tree state stateName , ':' , tree flag , ' '
				].
			tree items do: [:g |
					({#dnu. #refused. #rootPop. #stray. } includes: g kind) ifTrue: [
							out:: out , g kind , ' '
						].
					g kind = #sub ifTrue: [ out:: out , (problemsOf: g ref) ]
				].
			^out
		)
		root: source = (
			| done = view treeOf: source. |
			assert: done isKindOfDone.
			^done tree
		)
		sampleSource = (
			(* A document that uses every block of the library, without errors. *)
			
			^'[\title: [\Emmanuel [\emphasis\]in[\endEmphasis\] the IDE\]. subtitle: ''A first look''. author: ''Gilad''\]
[\section: ''Inline content''\]
[\paragraph\]Plain, [\emphasis\]emphasised[\endEmphasis\], [\strong\]strong[\endStrong\] and [\code\]x := 3[\endCode\].[\newline\]After a line break.[\endParagraph\]
[\section: [\A [\strong\]nested[\endStrong\] heading\]. label: #nested\]
[\paragraph\]One level deeper.[\endParagraph. endSection. endSection\]
[\section: ''Blocks''\]
[\list. item. paragraph\]Bulleted one[\endParagraph. endItem. item. paragraph\]Bulleted two[\endParagraph. endItem. endList\]
[\numberedList. item. paragraph\]First[\endParagraph. endItem. item. paragraph\]Second[\endParagraph. endItem. endNumberedList\]
[\table. headerRow. cell\]Block[\endCell. cell\]Kind[\endCell. endRow. row. cell\]paragraph[\endCell. cell\]opener[\endCell. endRow. row. cell\]verbatim:[\endCell. cell\]leaf[\endCell. endRow. label: #kinds. endTable\]
[\quote. paragraph\]A mark-edit language.[\endParagraph. attribution: [\The [\emphasis\]spec[\endEmphasis\]\]. endQuote\]
[\figure. codeBlock: ''x := 3 + 4.'' language: #newspeak. caption: ''A code display''. label: #fig. endFigure\]
[\verbatim: ''spaces   kept   here''\]
[\html: ''<b>raw</b> HTML''\]
[\endSection\]'
		)
		stateOf: g = (
			^g ref state
		)
		public test_amplets = (
			| tr = root: '[\amplet: [self intro]. paragraph\]See [\amplet: [self link]\].[\endParagraph\]'. para = tr items last ref. |
			assert: (stateOf: tr items first) stateName equals: 'amplet'.
			assert: (stateOf: tr items first) code code equals: '[self intro]'.
			assert: (stateOf: (para items at: 2)) stateName equals: 'inlineAmplet'.
			assert: (problemsOf: tr) equals: ''
		)
		public test_codeBlockAndVerbatimAreLeaves = (
			| tr = root: '[\codeBlock: ''x := 1'' language: #smalltalk. verbatim: ''a  b''\]'. |
			assert: tr items size equals: 2.
			assert: (stateOf: tr items first) stateName equals: 'codeBlock'.
			assert: (stateOf: tr items first) language equals: 'smalltalk'.
			assert: (stateOf: tr items last) text equals: 'a  b'
		)
		public test_emphasisOutsideAParagraphIsNotUnderstood = (
			| tr = root: '[\emphasis\]'. |
			assert: tr items first kind equals: #dnu
		)
		public test_ideErrorSampleShowsProblems = (
			| done = view treeOf: '[\paragraph\]Oops [\endEmphasis\] and [\frobnicate\][\endParagraph. title: ''late''. emphasis\]x[\endEmphasis. paragraph\]never closed'. |
			assert: done isKindOfDone.
			assert: (problemsOf: done tree)
				equals: 'dnu dnu dnu stray dnu para:unclosed '
		)
		public test_ideSampleIsClean = (
			| done = view treeOf: sampleSource. |
			assert: done isKindOfDone.
			assert: (problemsOf: done tree) equals: ''
		)
		public test_labelOnceThenRefused = (
			| tr = root: '[\section: [\A\]. label: #a. label: #b. endSection\]'. section = tr items first ref. |
			assert: section state label equals: 'a'.
			assert: (section items anySatisfy: [:g | g kind = #refused ])
		)
		public test_paragraphWithEmphasis = (
			| tr = root: '[\paragraph\] Hi [\emphasis\]all[\endEmphasis. endParagraph\]'. para = tr items first ref. |
			assert: tr items size equals: 1.
			assert: para state stateName equals: 'para'.
			assert: (kinds: para) asArray first equals: #run.
			assert: para items first chars size equals: 3.
			assert: (stateOf: para items last) stateName equals: 'emph'.
			assert: tr flag equals: #closed
		)
		public test_sectionsNestWithDepth = (
			| tr = root: '[\section: [\One\]. section: ''Two''. endSection. endSection\]'. top = tr items first ref. inner = top items first ref. |
			assert: top state depth equals: 1.
			assert: inner state depth equals: 2.
			assert: inner state heading equals: 'Two'.
			assert: top state heading isKindOfTreeValue
		)
		public test_stylesheetDecidesTheStyles = (
			(* The default stylesheet has underline and align:; the core one,
a paper's, has neither. align: is flow content, not understood in a
paragraph. *)
			
			| src = '[\paragraph\]a[\underline\]b[\endUnderline. align: ''center''\]c[\endParagraph\][\align: ''center''. paragraph\]d[\endParagraph. endAlign\]'. default = view treeOf: src
				root: view blocks defaultStylesheet root. core = view treeOf: src
				root: view blocks coreStylesheet root. |
			assert: (problemsOf: default tree) equals: 'dnu '.
			assert: (problemsOf: core tree) equals: 'dnu dnu dnu dnu dnu '
		)
		public test_templateConstructs = (
			(* A template's library understands its constructs everywhere, even
after the root changes (title:), and in a paragraph; the shared library does
not; and a public method of the library itself (stylesheet:) is never a
construct. *)
			
			| src = '[\title: [\T\]. greet: ''x''\][\paragraph\]a[\greet: ''y''\]b[\endParagraph\][\stylesheet: ''z''\]'. library = view blocks newLibrary: GreetingLibrary. own = view treeOf: src
				root: library DocumentRoot new. shared = view treeOf: src
				root: view blocks DocumentRoot new. |
			assert: (problemsOf: own tree) equals: 'dnu '.
			assert: (own tree items detect: [:i | i kind = #sub ]) ref state stateName
				equals: 'greeting'.
			assert: (problemsOf: shared tree) equals: 'dnu dnu dnu '
		)
		public test_titleTakesAnInlineLiteral = (
			| tr = root: '[\title: [\The [\emphasis\]Play[\endEmphasis\]\]\]'. title = tr state title. |
			assert: title isKindOfTreeValue.
			assert: title tree items size equals: 2.
			assert: tr items first kind equals: #mut
		)
		public test_titleTwiceIsRefused = (
			| tr = root: '[\title: ''A''. title: ''B''\]'. |
			assert: tr state title equals: 'A'.
			assert: tr items last kind equals: #refused
		)
		public test_unclosedParagraphIsFlagged = (
			| tr = root: '[\paragraph\]abc'. |
			assert: tr items first ref flag equals: #unclosed
		)
	) : (
		TEST_CONTEXT = (
		)
	)
	LibraryClass = (
		(* The library's class, which GreetingLibrary extends. *)
		
		^view blocks moduleClass
	)
) : ()
