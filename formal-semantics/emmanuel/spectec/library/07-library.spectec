;; Section 6: the standard library, the structural core. An instance of the
;; block signature (Section 4.1): it defines $cls and the Effect relation.
;; It is checked together with the core, and regressed in a configuration
;; of its own, without the toy fixture signature (see ../README.md).

var y : text

;; Value kinds the library inspects.
def $isLit(value) : bool
def $isLit(LITV L) = true
def $isLit(TREEV L tr) = false
def $isLit(HOSTV k) = false
def $isLit(STRV (u*)) = false
def $isLit(INTV k) = false
def $isLit(NILV) = false

;; Inline values: strings and trees.
def $isInlineValue(value) : bool
def $isInlineValue(LITV L) = false
def $isInlineValue(TREEV L tr) = true
def $isInlineValue(HOSTV k) = false
def $isInlineValue(STRV (u*)) = true
def $isInlineValue(INTV k) = false
def $isInlineValue(NILV) = false

def $isStr(value) : bool
def $isStr(LITV L) = false
def $isStr(TREEV L tr) = false
def $isStr(HOSTV k) = false
def $isStr(STRV (u*)) = true
def $isStr(INTV k) = false
def $isStr(NILV) = false

;; Taking an argument as inline content.
syntax inlineoutcome = INLVAL hoststate value | INLEXN hoststate exception | INLBAD hoststate
relation Inline: (hoststate, value) => (inlineoutcome)

;; @equation eq:lib-inline-lit
;; @rule Inline-Lit
rule Inline/Inline-Lit:
  (chi, LITV L) => (INLVAL chi' (TREEV L tr))
  -- InterpretWith: (chi, L, STATE "inline" eps) => (DONE chi' tr)

;; @equation eq:lib-inline-raise
;; @rule Inline-Raise
rule Inline/Inline-Raise:
  (chi, LITV L) => (INLEXN chi' xi)
  -- InterpretWith: (chi, L, STATE "inline" eps) => (RAISED chi' xi)

;; @equation eq:lib-inline-value
;; @rule Inline-Value
rule Inline/Inline-Value:
  (chi, v) => (INLVAL chi v)
  -- if $isInlineValue(v)

;; @equation eq:lib-inline-bad
;; @rule Inline-Bad
rule Inline/Inline-Bad:
  (chi, v) => (INLBAD chi)
  -- if ~$isInlineValue(v) /\ ~$isLit(v)

;; @equation eq:lib-states
;; A block state is STATE kind fields. Fields: doc (title subtitle
;; author*), section (INTV depth, heading, label), quote (attribution),
;; table (label), figure (caption, label), verbatim and html (STRV text),
;; codeBlock (STRV text, STRV language), amplet and inlineAmplet (the host
;; value of the amplet's code, a closure), link (STRV target). Absent
;; fields are NILV.
def $cls(STATE "doc" v*) = FLOW
def $cls(STATE "section" v*) = FLOW
def $cls(STATE "list" v*) = FLOW
def $cls(STATE "numbered" v*) = FLOW
def $cls(STATE "item" v*) = FLOW
def $cls(STATE "quote" v*) = FLOW
def $cls(STATE "table" v*) = FLOW
def $cls(STATE "headerRow" v*) = FLOW
def $cls(STATE "row" v*) = FLOW
def $cls(STATE "figure" v*) = FLOW
def $cls(STATE "verbatim" v*) = FLOW
def $cls(STATE "codeBlock" v*) = FLOW
def $cls(STATE "html" v*) = FLOW
def $cls(STATE "amplet" v*) = FLOW
def $cls(STATE "para" v*) = PARA
def $cls(STATE "cell" v*) = CELL
def $cls(STATE "emph" v*) = INLINE
def $cls(STATE "strong" v*) = INLINE
def $cls(STATE "code" v*) = INLINE
def $cls(STATE "inline" v*) = INLINE
def $cls(STATE "newline" v*) = INLINE
def $cls(STATE "inlineAmplet" v*) = INLINE
def $cls(STATE "link" v*) = INLINE

def $docState : blockstate
def $docState = STATE "doc" (NILV NILV)

;; @equation eq:lib-models
def $inlineContent : text*
def $inlineContent = "emphasis" "strong" "code" "newline" "amplet:" "link:"
def $displays : text*
def $displays = "verbatim:" "codeBlock:" "codeBlock:language:" "html:" "amplet:"
def $flowContent : text*
def $flowContent = $displays "paragraph" "list" "numberedList" "quote" "table" "figure"

;; @equation eq:lib-model-table
def $model(text) : text*
def $model("doc") = $flowContent "section:" "title:" "subtitle:" "author:"
def $model("section") = $flowContent "section:" "label:" "endSection"
def $model("para") = $inlineContent "endParagraph"
def $model("emph") = $inlineContent "endEmphasis"
def $model("strong") = $inlineContent "endStrong"
def $model("code") = $inlineContent "endCode"
def $model("link") = "emphasis" "strong" "code" "newline" "amplet:" "endLink"
def $model("inline") = $inlineContent
def $model("list") = "item" "endList"
def $model("numbered") = "item" "endNumberedList"
def $model("item") = $flowContent "endItem"
def $model("quote") = $flowContent "attribution:" "endQuote"
def $model("table") = "headerRow" "row" "label:" "endTable"
def $model("headerRow") = "cell" "endRow"
def $model("row") = "cell" "endRow"
def $model("cell") = $flowContent $inlineContent "endCell"
def $model("figure") = $displays "caption:" "label:" "endFigure"
def $model("verbatim") = eps
def $model("codeBlock") = eps
def $model("html") = eps
def $model("newline") = eps
def $model("amplet") = eps
def $model("inlineAmplet") = eps

def $understands(blockstate, text) : bool
def $understands(STATE y v*, x) = x <- $model(y)

;; @equation eq:lib-openers
def $openers : text*
def $openers = "paragraph" "emphasis" "strong" "code" "list" "numberedList" "item" "quote" "table" "headerRow" "row" "cell" "figure"
def $closers : text*
def $closers = "endParagraph" "endEmphasis" "endStrong" "endCode" "endSection" "endList" "endNumberedList" "endItem" "endQuote" "endTable" "endRow" "endCell" "endFigure" "endLink"

def $opened(text) : blockstate
def $opened("paragraph") = STATE "para" eps
def $opened("emphasis") = STATE "emph" eps
def $opened("strong") = STATE "strong" eps
def $opened("code") = STATE "code" eps
def $opened("list") = STATE "list" eps
def $opened("numberedList") = STATE "numbered" eps
def $opened("item") = STATE "item" eps
def $opened("quote") = STATE "quote" (NILV)
def $opened("table") = STATE "table" (NILV)
def $opened("headerRow") = STATE "headerRow" eps
def $opened("row") = STATE "row" eps
def $opened("cell") = STATE "cell" eps
def $opened("figure") = STATE "figure" (NILV NILV)

;; The inline-argument messages, H.
def $inlineArgs : text*
def $inlineArgs = "section:" "title:" "subtitle:" "author:" "attribution:" "caption:"

;; @equation eq:lib-plain-def
def $plain(blockstate, text, value*) : effect
def $plain(kappa, x, eps) = PUSH $opened(x)
  -- if x <- $openers
def $plain(kappa, x, eps) = POP
  -- if x <- $closers
def $plain(kappa, "newline", eps) = LEAF (STATE "newline" eps)
def $plain(kappa, "verbatim:", v) = $display("verbatim", v)
def $plain(kappa, "codeBlock:", v) = $codeBlock(v, STRV ("n" "e" "w" "s" "p" "e" "a" "k"))
def $plain(kappa, "codeBlock:language:", v v') = $codeBlock(v, v')
def $plain(kappa, "html:", v) = $display("html", v)
def $plain(kappa, "label:", v) = $label(kappa, v)
def $plain(kappa, "amplet:", v) = $amplet(kappa, v)
def $plain(kappa, "link:", v) = $link(v)

def $display(text, value) : effect
def $display(y, v) = LEAF (STATE y v)
  -- if $isStr(v)
def $display(y, v) = REFUSE
  -- if ~$isStr(v)

def $codeBlock(value, value) : effect
def $codeBlock(v, v') = LEAF (STATE "codeBlock" (v v'))
  -- if $isStr(v) /\ $isStr(v')
def $codeBlock(v, v') = REFUSE
  -- if ~($isStr(v) /\ $isStr(v'))

;; Amplets: the argument is the host value of the amplet's code, which the
;; view runs; in flow content it is a display, elsewhere an inline leaf.
;; @equation eq:lib-amplet
def $amplet(blockstate, value) : effect
def $amplet(kappa, v) = LEAF (STATE "amplet" (v))
  -- if $isHostV(v) /\ $cls(kappa) = FLOW
def $amplet(kappa, v) = LEAF (STATE "inlineAmplet" (v))
  -- if $isHostV(v) /\ $cls(kappa) =/= FLOW
def $amplet(kappa, v) = REFUSE
  -- if ~$isHostV(v)

def $isHostV(value) : bool
def $isHostV(LITV L) = false
def $isHostV(TREEV L tr) = false
def $isHostV(HOSTV k) = true
def $isHostV(STRV (u*)) = false
def $isHostV(INTV k) = false
def $isHostV(NILV) = false

;; Links: an inline block whose target is a string, and whose text is
;; inline content (without links).
;; @equation eq:lib-link
def $link(value) : effect
def $link(v) = PUSH (STATE "link" (v))
  -- if $isStr(v)
def $link(v) = REFUSE
  -- if ~$isStr(v)

;; Labels: the label field of a section, a table, or a figure.
def $labelOf(blockstate) : value
def $labelOf(STATE "section" (v v' v'')) = v''
def $labelOf(STATE "table" (v)) = v
def $labelOf(STATE "figure" (v v')) = v'

def $relabel(blockstate, value) : blockstate
def $relabel(STATE "section" (v v' v''), v''') = STATE "section" (v v' v''')
def $relabel(STATE "table" (v), v') = STATE "table" (v')
def $relabel(STATE "figure" (v v'), v'') = STATE "figure" (v v'')

def $label(blockstate, value) : effect
def $label(kappa, v) = MUTATE $relabel(kappa, v)
  -- if $isStr(v) /\ $labelOf(kappa) = NILV
def $label(kappa, v) = REFUSE
  -- if ~($isStr(v) /\ $labelOf(kappa) = NILV)

;; @equation eq:lib-with
def $depth(blockstate) : nat
def $depth(STATE "doc" v*) = 0
def $depth(STATE "section" ((INTV k) v*)) = k

def $free(blockstate, text) : bool
def $free(kappa, "section:") = true
def $free(kappa, "author:") = true
def $free(STATE "doc" (v v' v''*), "title:") = (v = NILV)
def $free(STATE "doc" (v v' v''*), "subtitle:") = (v' = NILV)
def $free(STATE "quote" (v), "attribution:") = (v = NILV)
def $free(STATE "figure" (v v'), "caption:") = (v = NILV)

def $with(blockstate, text, value) : effect
def $with(kappa, "section:", v) = PUSH (STATE "section" ((INTV $($depth(kappa) + 1)) v NILV))
def $with(STATE "doc" (v v' v''*), "title:", v''') = MUTATE (STATE "doc" (v''' v' v''*))
def $with(STATE "doc" (v v' v''*), "subtitle:", v''') = MUTATE (STATE "doc" (v v''' v''*))
def $with(STATE "doc" (v v' v''*), "author:", v''') = MUTATE (STATE "doc" (v v' v''* v'''))
def $with(STATE "quote" (v), "attribution:", v') = MUTATE (STATE "quote" (v'))
def $with(STATE "figure" (v v'), "caption:", v'') = MUTATE (STATE "figure" (v'' v'))

;; @equation eq:lib-plain
;; @rule Lib-Plain
rule Effect/Lib-Plain:
  (chi, kappa, x, v*) => (EFF chi $plain(kappa, x, v*))
  -- if $understands(kappa, x)
  -- if ~(x <- $inlineArgs)

;; @equation eq:lib-dnu
;; @rule Lib-Dnu
rule Effect/Lib-Dnu:
  (chi, kappa, x, v*) => (EFF chi NOTUNDERSTOOD)
  -- if ~$understands(kappa, x)

;; @equation eq:lib-inline
;; @rule Lib-Inline
rule Effect/Lib-Inline:
  (chi, kappa, x, v) => (EFF chi' $with(kappa, x, v'))
  -- if $understands(kappa, x)
  -- if x <- $inlineArgs
  -- if $free(kappa, x)
  -- Inline: (chi, v) => (INLVAL chi' v')

;; @equation eq:lib-inline-taken
;; @rule Lib-Inline-Taken
rule Effect/Lib-Inline-Taken:
  (chi, kappa, x, v) => (EFF chi REFUSE)
  -- if $understands(kappa, x)
  -- if x <- $inlineArgs
  -- if ~$free(kappa, x)

;; @equation eq:lib-inline-refuse
;; @rule Lib-Inline-Refuse
rule Effect/Lib-Inline-Refuse:
  (chi, kappa, x, v) => (EFF chi REFUSE)
  -- if $understands(kappa, x)
  -- if x <- $inlineArgs
  -- if $free(kappa, x)
  -- Inline: (chi, v) => (INLBAD chi)

;; @equation eq:lib-inline-exn
;; @rule Lib-Inline-Raise
rule Effect/Lib-Inline-Raise:
  (chi, kappa, x, v) => (EXNS chi' xi)
  -- if $understands(kappa, x)
  -- if x <- $inlineArgs
  -- if $free(kappa, x)
  -- Inline: (chi, v) => (INLEXN chi' xi)

;; @equation eq:lib-errors
def $libErrors(tree) : markuperror*
def $libErrorsOf(titem*) : markuperror*
def $libErrorsItem(titem) : markuperror*
def $fieldErrors(value*) : markuperror*
def $libErrors(TREE (STATE y v*) (ti*) (sigma*) f) =
  $flagErrors(f, sigma*) $fieldErrors(v*) $libErrorsOf(ti*)
def $fieldErrors(eps) = eps
def $fieldErrors((TREEV L tr) v*) = $libErrors(tr) $fieldErrors(v*)
def $fieldErrors(v v'*) = $fieldErrors(v'*)
  -- if ~$isTree(v)
def $libErrorsOf(eps) = eps
def $libErrorsOf(ti ti'*) = $libErrorsItem(ti) $libErrorsOf(ti'*)
def $libErrorsItem(SUB tr) = $libErrors(tr)
def $libErrorsItem(ti) = $errorsItem(ti)
  -- if ~$isSubT(ti)

def $isTree(value) : bool
def $isTree(LITV L) = false
def $isTree(TREEV L tr) = true
def $isTree(HOSTV k) = false
def $isTree(STRV (u*)) = false
def $isTree(INTV k) = false
def $isTree(NILV) = false

def $isSubT(titem) : bool
def $isSubT(SUB tr) = true
def $isSubT(RUN (u*) s) = false
def $isSubT(NOTE s) = false
def $isSubT(MUT sigma) = false
def $isSubT(DNU sigma) = false
def $isSubT(STRAY (u*) s) = false
def $isSubT(ROOTPOP sigma) = false
def $isSubT(REFUSED sigma) = false

;; ---------------------------------------------------------------------
;; Section 7.9: the standard library's field interface.

;; @equation eq:lib-fields
;; The fields a block displays, each with the message and argument it came
;; from: the first argument of the message that set it. A nil field is
;; not shown; labels and code languages are not displayed.
def $selOf(stmt) : text
def $selOf(SEND (s'*) x (eta*) s) = x
def $selOf(COMMENT s) = ""

def $withSel(text, stmt*) : stmt*
def $withSel(x, eps) = eps
def $withSel(x, sigma sigma'*) = sigma $withSel(x, sigma'*)
  -- if $selOf(sigma) = x
def $withSel(x, sigma sigma'*) = $withSel(x, sigma'*)
  -- if $selOf(sigma) =/= x

def $fieldFor(value, text, stmt*) : field*
def $fieldFor(NILV, x, sigma*) = eps
def $fieldFor(v, x, sigma*) = FIELD v $firstStmt($withSel(x, sigma*)) 0
  -- if v =/= NILV

def $authorFields(value*, stmt*) : field*
def $authorFields(eps, sigma*) = eps
def $authorFields(v v'*, sigma sigma'*) = (FIELD v sigma 0) $authorFields(v'*, sigma'*)

def $fields(STATE "doc" (v v' v''*), sigma*) =
  $fieldFor(v, "title:", sigma*) $fieldFor(v', "subtitle:", sigma*)
  $authorFields(v''*, $withSel("author:", sigma*))
def $fields(STATE "section" (v v' v''), sigma sigma'*) = FIELD v' sigma 0
def $fields(STATE "quote" (v), sigma*) = $fieldFor(v, "attribution:", sigma*)
def $fields(STATE "figure" (v v'), sigma*) = $fieldFor(v, "caption:", sigma*)
def $fields(STATE "verbatim" (v), sigma sigma'*) = FIELD v sigma 0
def $fields(STATE "codeBlock" (v v'), sigma sigma'*) = FIELD v sigma 0
def $fields(STATE "html" (v), sigma sigma'*) = FIELD v sigma 0
def $fields(STATE "link" (v), sigma sigma'*) = FIELD v sigma 0
def $fields(STATE y v*, sigma*) = eps
  -- if ~(y <- "doc" "section" "quote" "figure" "verbatim" "codeBlock" "html" "link")

;; @equation eq:lib-fields
def $joins(STATE y v*) = y <- "para" "emph" "strong" "code" "link" "list" "numbered" "item"

;; @equation eq:lib-fields
;; The styles, with the statements that open and close them. A statement
;; the field interface gives has no source: its span is [0, 0).
def $styleOpen("emphasis") = SEND eps "emphasis" eps $z
def $styleOpen("strong") = SEND eps "strong" eps $z
def $styleOpen("code") = SEND eps "code" eps $z
def $styleClose("emphasis") = SEND eps "endEmphasis" eps $z
def $styleClose("strong") = SEND eps "endStrong" eps $z
def $styleClose("code") = SEND eps "endCode" eps $z

;; The template of an opener: the opener and its closer, with the view's
;; caret between them; a table's holds one row of one cell. A template is
;; inserted only where the block at the point understands its opener.
;; @equation eq:lib-templates
def $closerOf(text) : text
def $closerOf("paragraph") = "endParagraph"
def $closerOf("emphasis") = "endEmphasis"
def $closerOf("strong") = "endStrong"
def $closerOf("code") = "endCode"
def $closerOf("list") = "endList"
def $closerOf("numberedList") = "endNumberedList"
def $closerOf("item") = "endItem"
def $closerOf("quote") = "endQuote"
def $closerOf("headerRow") = "endRow"
def $closerOf("row") = "endRow"
def $closerOf("cell") = "endCell"
def $closerOf("figure") = "endFigure"

def $unaryItems(text*) : item*
def $unaryItems(eps) = eps
def $unaryItems(x x'*) = (ISTMT (SEND eps x eps $z)) $unaryItems(x'*)

def $template(text) : item*
def $template(x) = $unaryItems(x)
  -- if x <- $openers /\ x =/= "table"
def $template("table") = $unaryItems("table" "row" "cell")

;; The items of the template after the caret.
;; @equation eq:lib-templates
def $templateAfter(text) : item*
def $templateAfter(x) = $unaryItems($closerOf(x))
  -- if x <- $openers /\ x =/= "table"
def $templateAfter("table") = $unaryItems("endCell" "endRow" "endTable")

;; @equation eq:lib-templates
def $insertAt(markup, tree, caret, text) : edit
def $insertAt(mk, tr, ca, x) = REPLACE ca ca $template(x) (AFTERCARET $templateAfter(x))
  -- if $understands($stateOfT($navBlock($nav(mk, tr, $steps($caretPt(ca))))), x)

;; Enter splits the innermost paragraph or list item on the point's path.
;; @equation eq:lib-enter
def $enter(markup, tree, caret) : edit
def $enterAt(tree*, nat, caret) : edit
def $enter(mk, tr, ca) =
  $enterAt($navPath($nav(mk, tr, $steps($caretPt(ca)))), $lenN($navIdx($nav(mk, tr, $steps($caretPt(ca))))), ca)
def $enterAt(tr*, lv, ca) = SPLIT ca lv
  -- if lv >= 1 /\ $splitsAtEnter($stateOfT($trAt(tr*, lv)))
def $enterAt(tr*, lv, ca) = $enterAt(tr*, $(lv - 1), ca)
  -- if lv > 1 /\ ~$splitsAtEnter($stateOfT($trAt(tr*, lv)))

def $splitsAtEnter(blockstate) : bool
def $splitsAtEnter(STATE y v*) = y <- "para" "item"
