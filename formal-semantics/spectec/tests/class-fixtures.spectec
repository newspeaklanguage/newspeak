;; Construction fixtures include actual factory methods and initializer bodies.
def $classFactoryMethod : fullmethod
def $classFactoryMethod = {
  ID MD 30, SELECTOR "new", ACCESS PUBLIC, FORMALS eps, LOCALS eps,
  BODY (RETURNSTMT (NEWINSTANCECURRENT "new" eps)), OWNER CD 10
}
def $classRootInitializer : initializer
def $classRootInitializer = { ID MD 10, SELECTOR "new", FORMALS eps, GROUPS eps, BODY eps }
def $classBodyInitializer : initializer
def $classBodyInitializer = {
  ID MD 11, SELECTOR "new", FORMALS eps,
  GROUPS (SLOTSEQUENTIAL ((SLOTIMMUTABLE (SID 1) SELF (BLOCKDECL 101)) (SLOTUNINITIALIZED (SID 2)))),
  BODY (EXPRSTMT SELF)
}
def $classProgramFixture : runtimeProgram
def $classProgramFixture = $runtimeProgramFixture[
  .MIXINS =
    (MID 0, $runtimeMixinFixture(CD 0, eps))
    (MID 10, { DECL CD 10, METHODS eps,
      SLOTS (PHYSICALUNINITIALIZED (SID 0) PUBLIC), NESTED eps, INITIALIZER $classRootInitializer })
    (MID 11, { DECL CD 11, METHODS eps,
      SLOTS (PHYSICALIMMUTABLE (SID 1) PRIVATE SELF) (PHYSICALLAZYIMMUTABLE (SID 2) PROTECTED SELF),
      NESTED eps, INITIALIZER $classBodyInitializer })
    (MID 12, { DECL CD 12, METHODS ("new", $classFactoryMethod), SLOTS eps, NESTED eps,
      INITIALIZER $classRootInitializer })][
  .PLATFORM = ("Top", CLASSREF CID 0) ("Object", CLASSREF CID 1)
    ("Class", CLASSREF CID 9) ("Metaclass", CLASSREF CID 8)
    ("Activation", CLASSREF CID 9) ("Closure", CLASSREF CID 9)
    ("MessageMirror", CLASSREF CID 9)][
  .OWNERS = (CD 10, TOPOWNER) (CD 11, ACTIVATIONOWNER) (CD 12, CLASSOWNER) (CD 13, LITERALOWNER)][
  .FUTUREEXPRESSIONS = (MD 77, IMPLICITSEND "PastFuture" eps NOSCOPE (DECLFOUND CD 3))
    (MD 11, IMPLICITSEND "PastFuture" eps NOSCOPE (DECLFOUND CD 11))][
  .LOCALTHUNKS = (LOCALTHUNKKEY (MD 77) (LSID 0), BLOCKDECL 200) (LOCALTHUNKKEY (MD 77) (LSID 1), BLOCKDECL 201)]
def $rootFactoryFixture : factorydescriptor
def $rootFactoryFixture = { ID MD 10, SELECTOR "new", FORMALS eps, PLAN BODYINITIALIZER (TEMPLATE "new" eps) }
def $bodyDescriptorFixture : bodydescriptor
def $bodyDescriptorFixture = {
  DECL CD 11, NAME "Example", SUPERKIND EXPLICITSUPERCLASS, SELECTOR "new", FORMALS eps,
  MIXIN MID 11, CLASSMIXIN MID 12, SUPERMESSAGE TEMPLATE "new" eps
}
def $applicationDescriptorFixture : applicationdescriptor
def $applicationDescriptorFixture = {
  DECL CD 12, NAME "Applied", SELECTOR "new", FORMALS eps, CLASSMIXIN MID 12,
  INITIALIZERID MD 12, SUPERMESSAGE TEMPLATE "new" eps,
  MIXINMESSAGE TEMPLATE "new" eps
}
def $classHeapFixture : runtimeHeap
def $classHeapFixture = $runtimeHeapFixture[.CLASSES =
  (CID 0, $runtimeClassFixture(MID 0, CID 0))
  (CID 1, $runtimeClassFixture(MID 10, CID 0)[.FACTORY = FACTORY $rootFactoryFixture])
  (CID 2, $runtimeClassFixture(MID 11, CID 1)[.FACTORY = FACTORY $bodyFactory($classProgramFixture, $bodyDescriptorFixture)])
  (CID 3, $runtimeClassFixture(MID 11, CID 2)[.FACTORY = FACTORY $applicationFactory($applicationDescriptorFixture)])
  (CID 8, $runtimeClassFixture(MID 0, CID 9)[.METACLASS = CID 8])
  (CID 9, $runtimeClassFixture(MID 0, CID 1)[.METACLASS = CID 8])]
def $createdBodyHeap : runtimeHeap
def $createdBodyHeap = $allocateClass($classProgramFixture, $classHeapFixture, CID 10, CID 11,
  EXPRESSIONORIGIN CD 11, MID 11, CID 1, ACTIVATIONREF AID 0, MID 12,
  $bodyFactory($classProgramFixture, $bodyDescriptorFixture))
def $createdApplicationHeap : runtimeHeap
def $createdApplicationHeap = $allocateClass($classProgramFixture, $classHeapFixture, CID 10, CID 11,
  EXPRESSIONORIGIN CD 12, MID 11, CID 1, OBJECTREF OID 1, MID 12,
  $applicationFactory($applicationDescriptorFixture))
def $instanceHeapFixture : runtimeHeap
def $instanceHeapFixture = $allocateInstance($classProgramFixture, $classHeapFixture, OID 10, CID 2)
;; Same stateful mixin in CID 2 and CID 3, on ONE most-derived instance.
def $repeatedStorageHeap : runtimeHeap
def $repeatedStorageHeap = $putActivation($putActivation(
  $allocateInstance($classProgramFixture, $classHeapFixture, OID 10, CID 3),
  AID 2, $senderActivation[.RECEIVER = OBJECTREF OID 10][.CURRENT = CLASSFOUND CID 2]),
  AID 3, $senderActivation[.RECEIVER = OBJECTREF OID 10][.CURRENT = CLASSFOUND CID 3])
def $repeatedWrittenHeap : runtimeHeap
def $repeatedWrittenHeap = $writeObjectSlot($writeObjectSlot($repeatedStorageHeap,
  OID 10, PHYSICALSLOT (CID 2) (SID 1), OBJECTREF OID 0),
  OID 10, PHYSICALSLOT (CID 3) (SID 1), OBJECTREF OID 1)
def $repeatedLazyHeap : runtimeHeap
def $repeatedLazyHeap = $writeObjectSlot($repeatedStorageHeap,
  OID 10, PHYSICALSLOT (CID 2) (SID 2), OBJECTREF OID 1)
def $repeatedCachedHeap : runtimeHeap
def $repeatedCachedHeap = $cacheNestedClass($cacheNestedClass($repeatedStorageHeap,
  OID 10, NESTEDCACHE (CID 2) (CD 11), CID 20),
  OID 10, NESTEDCACHE (CID 3) (CD 11), CID 21)
def $factoryHeapFixture : runtimeHeap
def $factoryHeapFixture = $putActivation($classHeapFixture, AID 0,
  $senderActivation[.RECEIVER = CLASSREF CID 2])
def $factoryAllocatedHeap : runtimeHeap
def $factoryAllocatedHeap = $newInstanceInitializer(
  $allocateInstance($classProgramFixture, $factoryHeapFixture, OID 10, CID 2),
  AID 2, CID 2, OID 10, ("new" eps), CONT AID 0)
def $superInitializedHeap : runtimeHeap
def $superInitializedHeap = $newInstanceInitializer($factoryAllocatedHeap, AID 3, CID 1, OID 10, ("new" eps), CONT AID 2)
def $mixinInitializedHeap : runtimeHeap
def $mixinInitializedHeap = $newMixinInitializer($classProgramFixture, $factoryAllocatedHeap,
  AID 3, MID 11, CID 3, OID 10, ("new" eps), CONT AID 2)
def $simSlotDeclarations : slotdecl*
def $simSlotDeclarations =
  (SLOTIMMUTABLE (SID 1) SELF (BLOCKDECL 101))
  (SLOTUNINITIALIZED (SID 2))
  (SLOTMUTABLE (SID 3) (VALUE (OBJECTREF OID 1)) (BLOCKDECL 103))
def $futureFixture : coreexpr
def $futureFixture = IMPLICITSEND "PastFuture" eps NOSCOPE (DECLFOUND CD 3)
def $simLocalDeclarations : localdecl*
def $simLocalDeclarations =
  (LOCALIMMUTABLE (LSID 0) SELF) (LOCALLAZYIMMUTABLE (LSID 2) SELF)
  (LOCALMUTABLE (LSID 1) (VALUE (OBJECTREF OID 1))) (LOCALUNINITIALIZED (LSID 3))

;; Test-only finite trace witnesses check integration between rule families.
relation MachineTraceFixture: (runtimeProgram) |- (machine*)
rule MachineTraceFixture/single: (RP) |- (sigma)
rule MachineTraceFixture/step:
  (RP) |- (sigma sigma' sigma''*)
  -- MachineStep: (RP) |- (sigma) => (sigma')
  -- MachineTraceFixture: (RP) |- (sigma' sigma''*)
def $rootFactoryHeap : runtimeHeap
def $rootFactoryHeap = $putActivation($classHeapFixture, AID 0,
  $senderActivation[.RECEIVER = CLASSREF CID 1])
def $rootAllocatedHeap : runtimeHeap
def $rootAllocatedHeap = $newInstanceInitializer(
  $allocateInstance($classProgramFixture, $rootFactoryHeap, OID 10, CID 1),
  AID 2, CID 1, OID 10, ("new" eps), CONT AID 0)
def $rootFinishedHeap : runtimeHeap
def $rootFinishedHeap = $severContinuation($rootAllocatedHeap, AID 2)
def $rootReturnedHeap : runtimeHeap
def $rootReturnedHeap = $markUncontinuable($rootFinishedHeap, AID 0)
def $topBodyHeapFixture : runtimeHeap
def $topBodyHeapFixture = $allocateClass($classProgramFixture, $classHeapFixture, CID 10, CID 11,
  EXPRESSIONORIGIN CD 11, MID 11, CID 1, OBJECTREF OID 2, MID 12,
  $bodyFactory($classProgramFixture, $bodyDescriptorFixture))
def $rootFactoryTrace : machine*
def $rootFactoryTrace =
  $state($rootFactoryHeap, ((AID 1, (RECVFRAME "inspect" eps)) (AID 0, RETURNFRAME)), NEWINSTANCECONTROL ("new" eps))
  $state($rootAllocatedHeap, ((AID 1, (RECVFRAME "inspect" eps)) (AID 0, RETURNFRAME) (AID 2, eps)), INITCLASS (CID 1) (OID 10) ("new" eps))
  $state($rootAllocatedHeap, ((AID 1, (RECVFRAME "inspect" eps)) (AID 0, RETURNFRAME) (AID 2, eps)), OWNINIT (CID 1) (OID 10) ("new" eps))
  $state($rootAllocatedHeap, ((AID 1, (RECVFRAME "inspect" eps)) (AID 0, RETURNFRAME) (AID 2, eps)), INITGROUPS (OID 10) eps eps)
  $state($rootAllocatedHeap, ((AID 1, (RECVFRAME "inspect" eps)) (AID 0, RETURNFRAME) (AID 2, eps)), BODYCONTROL (METHODBODY (OBJECTREF OID 10)) eps)
  $state($rootAllocatedHeap, ((AID 1, (RECVFRAME "inspect" eps)) (AID 0, RETURNFRAME) (AID 2, eps)), FINISH (OBJECTREF OID 10))
  $state($rootFinishedHeap, ((AID 1, (RECVFRAME "inspect" eps)) (AID 0, RETURNFRAME)), VALUE (OBJECTREF OID 10))
  $state($rootFinishedHeap, ((AID 1, (RECVFRAME "inspect" eps)) (AID 0, eps)), TRANSFER (CONT AID 0) (OBJECTREF OID 10))
  $state($rootReturnedHeap, ((AID 1, (RECVFRAME "inspect" eps))), VALUE (OBJECTREF OID 10))
