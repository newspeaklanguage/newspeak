Newspeak3
'Eurasia'
class EurasiaKernelTestReference packageUsing: manifest = (
	(* The psoup side of the kernel differential tests (eurasia/scripts/kernel-tests.sh): runs the kernel test suites with Minitest and prints one line per test in EurasiaKernelTestRunner's format: Context>>selector, then success, failure or error, and a description. *)
	
	|
		Minitest = manifest Minitest.
		KernelTests = manifest KernelTests.
		AccessModifierTesting = manifest AccessModifierTesting.
	|
) (
	describe: exception = (
		^[ exception messageText printString ] on: Exception do: [:e | '?' ]
	)
	public main: platform args: args = (
		| minitest tester |
		minitest:: Minitest usingPlatform: platform.
		tester:: minitest Tester testModules: {KernelTests usingPlatform: platform
				testFramework: minitest. AccessModifierTesting usingPlatform: platform
				testFramework: minitest. }.
		tester runAll.
		tester successes do: [:r | print: r outcome: 'success' ].
		tester failures do: [:r |
				print: r outcome: 'failure ' , r description printString
			].
		tester errors do: [:r | print: r outcome: 'error ' , (describe: r exception) ].
		'done' out
	)
	print: result outcome: text = (
		(result testCase environment classDeclarationMirror simpleName , '>>' , result testCase selector , ' ' , text) out
	)
) : ()
