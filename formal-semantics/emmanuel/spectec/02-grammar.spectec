;; Section 3: structural parse, abstract syntax, host parser, resolution.

var s : span
var z : nat

;; @equation eq:raw-nodes
syntax piece = SRC (char*) span | HOLE (rawnode*) span
syntax rawnode = RBLOCK (char*) span (piece*) span | RFINAL (char*) span
var p : piece
var rho : rawnode

;; Host argument expressions are abstract. A transcription choice: each
;; carries a host identity and lits(eta), its markup literals in source
;; order, which is all the core observes of it.
;; @equation eq:abstract-syntax
syntax hostexpr = HOSTEXPR nat (markupliteral*)
syntax stmt = SEND (span*) text (hostexpr*) span | COMMENT span
syntax node = BLOCK (char*) span (stmt*) span | FINAL (char*) span
syntax markupliteral = MARKUP text (node*) span
syntax hpiece = HSRC (char*) span | HHOLE markupliteral
var eta : hostexpr
var sigma : stmt
var n : node
var h : hpiece
var x : text

var L : markupliteral
def $lits(hostexpr) : markupliteral*
def $lits(HOSTEXPR k (L*)) = L*

;; The host parser: a parameter, declared here and never defined by the
;; core. Requirements H1-H5 are obligations on its instances.
;; @equation eq:host-parser
syntax hostresult = STMTS (stmt*) | HOSTFAIL span
def $hostParse(hpiece*) : hostresult

;; The structural parse. Markup reads a DocumentMarkup; Messages reads the
;; pieces of a bracket through its closeMessages.
;; The two relations realize the design notes' grammar over tokens.
;; @equation eq:concrete-grammar
relation Markup: (spantoken*) => (rawnode*, spantoken*)
relation Messages: (spantoken*) => (piece*, span, spantoken*)

;; @equation eq:markup-end
;; @rule Markup-End
rule Markup/Markup-End:
  (eps) => (eps, eps)

;; @equation eq:markup-stop
;; @rule Markup-Stop
rule Markup/Markup-Stop:
  ((TOK CLOSEMARKUP s) t*) => (eps, (TOK CLOSEMARKUP s) t*)

;; @equation eq:markup-trailing-end
;; @rule Markup-Trailing-End
rule Markup/Markup-Trailing-End:
  ((TOK (TEXT u*) s)) => ((RFINAL (u*) s), eps)

;; @equation eq:markup-trailing-stop
;; @rule Markup-Trailing-Stop
rule Markup/Markup-Trailing-Stop:
  ((TOK (TEXT u*) s) (TOK CLOSEMARKUP s') t*) =>
    ((RFINAL (u*) s), (TOK CLOSEMARKUP s') t*)

;; Adjacency j' = j is a guard, not a repeated pattern variable.
;; @equation eq:markup-block
;; @rule Markup-Block
rule Markup/Markup-Block:
  ((TOK (TEXT u*) (SPAN i j)) (TOK OPENMESSAGES (SPAN j' k)) t*) =>
    ((RBLOCK (u*) (SPAN i j) (p*) (SPAN i z)) rho*, t''*)
  -- if j' = j
  -- Messages: (t*) => (p*, SPAN k' z, t'*)
  -- Markup: (t'*) => (rho*, t''*)

;; @equation eq:markup-bare-block
;; @rule Markup-Bare-Block
rule Markup/Markup-Bare-Block:
  ((TOK OPENMESSAGES (SPAN j k)) t*) =>
    ((RBLOCK (eps) (SPAN j j) (p*) (SPAN j z)) rho*, t''*)
  -- Messages: (t*) => (p*, SPAN k' z, t'*)
  -- Markup: (t'*) => (rho*, t''*)

;; @equation eq:messages-close
;; @rule Messages-Close
rule Messages/Messages-Close:
  ((TOK CLOSEMESSAGES s) t*) => (eps, s, t*)

;; @equation eq:messages-code
;; @rule Messages-Code
rule Messages/Messages-Code:
  ((TOK (CODE w*) s) t*) => ((SRC (w*) s) p*, s', t'*)
  -- Messages: (t*) => (p*, s', t'*)

;; @equation eq:messages-markup
;; @rule Messages-Markup
rule Messages/Messages-Markup:
  ((TOK OPENMARKUP (SPAN i j)) t*) => ((HOLE (rho*) (SPAN i z)) p*, s', t''*)
  -- Markup: (t*) => (rho*, (TOK CLOSEMARKUP (SPAN k z)) t'*)
  -- Messages: (t'*) => (p*, s', t''*)

;; Resolution. The LaTeX's lifting `v . r` is $consNode / $consPiece.
syntax resolved = RESOLVED (node*) | RESFAIL span
syntax resolvednode = NODEOK node | NODEFAIL span
syntax resolvedpieces = PIECESOK (hpiece*) | PIECESFAIL span

def $consNode(node, resolved) : resolved
def $consNode(n, RESOLVED (n'*)) = RESOLVED (n n'*)
def $consNode(n, RESFAIL s) = RESFAIL s

def $consPiece(hpiece, resolvedpieces) : resolvedpieces
def $consPiece(h, PIECESOK (h'*)) = PIECESOK (h h'*)
def $consPiece(h, PIECESFAIL s) = PIECESFAIL s

;; @equation eq:resolve
;; The LaTeX's guards "if node(rho) = ok(n)" are transcribed as dispatch on
;; the result: the pinned evaluator does not evaluate binding premises in
;; function clauses. Each `...On` function has one equation per LaTeX case.
;; The name nm of the source being parsed is threaded through, and recorded
;; in every literal.
def $resolve(text, rawnode*) : resolved
def $resolveOn(text, resolvednode, rawnode*) : resolved
def $resolveNode(text, rawnode) : resolvednode
def $blockOn(char*, span, span, resolvedpieces) : resolvednode
def $hostOn(char*, span, span, hostresult) : resolvednode
def $resolvePieces(text, piece*) : resolvedpieces
def $holeOn(text, resolved, span, piece*) : resolvedpieces

def $resolve(nm, eps) = RESOLVED eps
def $resolve(nm, rho rho'*) = $resolveOn(nm, $resolveNode(nm, rho), rho'*)
def $resolveOn(nm, NODEOK n, rho'*) = $consNode(n, $resolve(nm, rho'*))
def $resolveOn(nm, NODEFAIL s, rho'*) = RESFAIL s

def $resolveNode(nm, RFINAL (u*) s) = NODEOK (FINAL (u*) s)
def $resolveNode(nm, RBLOCK (u*) s' (p*) s) = $blockOn(u*, s', s, $resolvePieces(nm, p*))
def $blockOn(u*, s', s, PIECESOK (h*)) = $hostOn(u*, s', s, $hostParse(h*))
def $blockOn(u*, s', s, PIECESFAIL s'') = NODEFAIL s''
def $hostOn(u*, s', s, STMTS (sigma*)) = NODEOK (BLOCK (u*) s' (sigma*) s)
def $hostOn(u*, s', s, HOSTFAIL s'') = NODEFAIL s''

def $resolvePieces(nm, eps) = PIECESOK eps
def $resolvePieces(nm, (SRC (w*) s) p*) = $consPiece(HSRC (w*) s, $resolvePieces(nm, p*))
def $resolvePieces(nm, (HOLE (rho*) s) p*) = $holeOn(nm, $resolve(nm, rho*), s, p*)
def $holeOn(nm, RESOLVED (n*), s, p*) = $consPiece(HHOLE (MARKUP nm (n*) s), $resolvePieces(nm, p*))
def $holeOn(nm, RESFAIL s', s, p*) = PIECESFAIL s'

;; @equation eq:parse-results
syntax parseresult = PARSED (node*) | LEXFAIL lexerror nat | SYNTAXERROR span

var nm : text
relation Parses: (text, char*) => (parseresult)

;; @equation eq:parse-lex-error
;; @rule Parse-Lex-Error
rule Parses/Parse-Lex-Error:
  (nm, w*) => (LEXFAIL e i)
  -- Lexes: (w*) => (LEXERROR e i)

;; @equation eq:parse-ok
;; @rule Parse-Ok
rule Parses/Parse-Ok:
  (nm, w*) => (PARSED (n*))
  -- Lexes: (w*) => (LEXED l*)
  -- Markup: ($tokens(l*)) => (rho*, eps)
  -- if $resolve(nm, rho*) = RESOLVED (n*)

;; @equation eq:parse-syntax-error
;; @rule Parse-Syntax-Error
rule Parses/Parse-Syntax-Error:
  (nm, w*) => (SYNTAXERROR s)
  -- Lexes: (w*) => (LEXED l*)
  -- Markup: ($tokens(l*)) => (rho*, eps)
  -- if $resolve(nm, rho*) = RESFAIL s
