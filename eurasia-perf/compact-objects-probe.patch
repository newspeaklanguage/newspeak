 /// An object's contents.
+pub const INLINE_SLOTS: usize = 8;
+#[derive(Clone, Debug)]
+pub enum Slots { Inline(u8, [Value; INLINE_SLOTS]), Spilled(Vec<Value>) }
+impl From<Vec<Value>> for Slots {
+    fn from(v: Vec<Value>) -> Slots {
+        if v.len() <= INLINE_SLOTS {
+            let mut a = [Value::from_bits(0); INLINE_SLOTS];
+            a[..v.len()].copy_from_slice(&v);
+            Slots::Inline(v.len() as u8, a)
+        } else { Slots::Spilled(v) }
+    }
+}
+impl core::ops::Deref for Slots {
+    type Target = [Value];
+    fn deref(&self) -> &[Value] { match self { Slots::Inline(n, a) => &a[..*n as usize], Slots::Spilled(v) => v } }
+}
+impl core::ops::DerefMut for Slots {
+    fn deref_mut(&mut self) -> &mut [Value] { match self { Slots::Inline(n, a) => &mut a[..*n as usize], Slots::Spilled(v) => v } }
+}
