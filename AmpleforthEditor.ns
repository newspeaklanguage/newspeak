Newspeak3
'Ampleforth'
class AmpleforthEditor usingPlatform: p emmanuel: EmmanuelClass newspeakHost: HostClass blocks: BlocksClass edit: EditClass incremental: IncrementalClass parsing: ParsingClass asts: ASTsClass = (
	(* A live editing view of an Emmanuel source: the reference editor of the
prototype plan's milestone M3. It shows the document as the block
presenters render it, and turns what one types into the edits of Section 7
(EmmanuelEdit): each keystroke edits the source, which is reinterpreted
whole, and the view is rendered again with the caret where the edit put it.

  (AmpleforthEditor usingPlatform: platform
      emmanuel: Emmanuel
      newspeakHost: EmmanuelNewspeakHost
      blocks: EmmanuelBlocks
      edit: EmmanuelEdit
      incremental: EmmanuelIncremental
      parsing: NewspeakPredictiveParsing
      asts: NewspeakASTs)
          editorOn: '[\paragraph\]Hello[\endParagraph\]'

answers the editor, a fragment; its session holds the source.

The presenters mark their rendering with each block's path (data-steps)
and each child's index (data-item); the editor maps the browser's selection
to points through them, and points back to the selection. Typing, deleting,
Enter, Shift-Enter (a newline), the styles (Cmd-B, Cmd-I, Cmd-U, Cmd-Shift-X,
Cmd-comma, Cmd-period), and pasting
plain text are edits; anything else is ignored. Cmd-Shift-click follows a
link; Cmd-click alone is the sync with the raw view (issue #114), which the
editor offers (showSourceOffset:, sourceOffsetAtX:y:, and the like) to the
presenter that shows both views. The editor keeps its key and input
events to itself, so that an editable page around it (an Ampleforth
document's) does not see them. An edit the edit layer
refuses changes nothing. *)
	
	|
		private List = p collections List.
		private Fragment = p hopscotch Fragment.
		private window = p js global.
		private emmanuel = EmmanuelClass usingPlatform: p.
		private parsing = ParsingClass usingPlatform: p
			asts: (ASTsClass usingPlatform: p).
		private hosts = HostClass usingPlatform: p emmanuel: emmanuel parsing: parsing.
		public blocks = BlocksClass usingPlatform: p emmanuel: emmanuel.
		public edits = EditClass usingPlatform: p emmanuel: emmanuel library: blocks.
		private incremental = IncrementalClass usingPlatform: p emmanuel: emmanuel.
	|
) (
	lazy private clock = (* A host object: a lazy slot, so that a restore into a new host (Eurasia) looks it up again. *) window at: #performance.
	lazy private console = (* A host object: a lazy slot, so that a restore into a new host (Eurasia) looks it up again. *) window at: #console.
	lazy private domDocument = (* A host object: a lazy slot, so that a restore into a new host (Eurasia) looks it up again. *) window at: #document.
	lazy private JSObject = (* A host object: a lazy slot, so that a restore into a new host (Eurasia) looks it up again. *) window at: #Object.
	public class EditorFragment session: s = Fragment new (
		(* The editor: a contenteditable element holding the rendering of the
session's tree. *)
		
		|
			public session = s.
			root
			content
			typed
			problemBox
			
			(* Whether the raw view follows the caret in this view, and this the
caret in the raw view; nil, as a hot-loaded instance has it, is false. *)
			public following
			
			(* The presenter that shows this editor beside the raw view now, which
syncs the two. *)
			public syncPresenter
			
			(* The selection when focus last left this view, for the commands of
what took it: a menu's item, when clicked, moves the browser's selection into
the menu, so that the selection is no longer here when its action runs. *)
			savedRange
		|
	) (
		public addMedia: file named: name = (
			(* Add the file (a host File, or Blob) to the document's media, under
name, as a dropped image is. *)
			
			session addMedia: file named: name
		)
		caretFor: pt = (
			(* The caret at a point: the session's caret when it is there, since
its anchor may lie in white space the view does not show. *)
			
			(session caret isNil not and: [
					(emmanuel termStringOf: session caret point) = (emmanuel termStringOf: pt)
				]) ifTrue: [ ^session caret ].
			^edits exact: pt
		)
		public childrenDo: action = (
			(* The fragments its amplets show are this view's logical children,
so that Hopscotch's walks of the fragment tree (noticeExposure, refresh,
hasPendingChanges) reach what they show, a document's editor, say, as they
do in an Ampleforth document. *)
			
			session amplets fragmentsDo: action
		)
		commitStringField: element = (
			(* The reader left a string field: its new text replaces the string
(an edit #setString of the field of the block it is in), and the view is
shown again; a string the edit cannot replace is shown as it was. *)
			
			| index = Integer parse: (element getAttribute: 'data-string-field')
				radix: 10. steps = stepsIn: (element getAttribute: 'data-string-steps'). text = emmanuel codePointsOf: (element at: #textContent). e |
			e:: edits Edit kind: #setString
				caret: nil
				caret: nil
				items: nil
				after: nil
				level: nil
				style: nil
				steps: steps
				index: index
				chars: text.
			(element at: #textContent) = (element getAttribute: 'data-string-shown') ifTrue: [
					^self
				].
			[ session apply: e ] on: Error do: [:x | nil ].
			render
		)
		createVisual = (
			(* content is the rendering in the previous visual, if any: one made before the image was restored into a new host is dead. *)
			
			content:: nil.
			root:: domDocument createElement: 'div'.
			root setAttribute: 'contenteditable' to: 'true'.
			root setAttribute: 'style' to: frameStyle.
			root addEventListener: 'mouseup'
				action: [:event |
					rememberFrameWidth.
					nil
				].
			root addEventListener: 'beforeinput'
				action: [:event |
					event stopPropagation.
					(isOwn: event) ifTrue: [
							[ handle: event ] on: Error
								do: [:e | console log: 'Emmanuel editor: ' , e messageText printString ]
						].
					nil
				].
			{'keyup'. 'keypress'. 'input'. 'paste'. 'cut'. 'drop'. } do: [:type |
					root addEventListener: type
						action: [:event |
							event stopPropagation.
							nil
						]
				].
			root appendChild: styleSheet.
			problemBox:: domDocument createElement: 'div'.
			problemBox setAttribute: 'contenteditable' to: 'false'.
			problemBox setAttribute: 'style' to: 'display: none;'.
			root appendChild: problemBox.
			root addEventListener: 'click'
				action: [:event |
					[ handleClick: event ] on: Error
						do: [:e | console log: 'Emmanuel editor: ' , e messageText printString ].
					nil
				].
			root addEventListener: 'keydown'
				action: [:event |
					event stopPropagation.
					(isOwn: event) ifTrue: [
							[ handleKey: event ] on: Error
								do: [:e | console log: 'Emmanuel editor: ' , e messageText printString ]
						]
						ifFalse: [ stringFieldKey: event ].
					nil
				].
			root addEventListener: 'focusout'
				action: [:event |
					| t = event at: #target. |
					saveSelection.
					(isStringField: t) ifTrue: [
							[ commitStringField: t ] on: Error
								do: [:e | console log: 'Emmanuel editor: ' , e messageText printString ]
						].
					nil
				].
			render.
			^root
		)
		dataAttribute: name of: node = (
			(node at: #nodeType) = 1 ifFalse: [ ^nil ].
			^node getAttribute: name
		)
		edit: makeEdit = (
			(* Apply the edit makeEdit makes from the selection (selectionRange). *)
			
			| range = selectionRange. |
			range isNil ifTrue: [ ^self ].
			edit: makeEdit range: range
		)
		edit: makeEdit range: range = (
			(* Apply the edit makeEdit makes from a range of the DOM (its start
and end carets, and whether it is collapsed); then render again and place
the caret. *)
			
			| a b collapsed e caret |
			typed:: nil.
			session tree isNil ifTrue: [ ^self ].
			collapsed:: range at: #collapsed.
			((owns: (range at: #startContainer)) and: [ owns: (range at: #endContainer) ]) ifFalse: [
					^self
				].
			a:: caretFor: (pointAt: (range at: #startContainer)
					offset: (range at: #startOffset)).
			b:: collapsed ifTrue: [ a ]
				ifFalse: [
					edits exact: (pointAt: (range at: #endContainer)
							offset: (range at: #endOffset))
				].
			e:: makeEdit value: a value: b value: collapsed.
			e isNil ifTrue: [ ^self ].
			caret:: session apply: e typed: typed.
			caret isNil ifTrue: [ ^self ].
			render.
			place: caret point
		)
		editFor: type event: event caret: a caret: b collapsed: collapsed = (
			(* The edit an input event makes at the selection from a to b: that
of its key (Section 7.11 of the specification), or nil. *)
			
			| ky = keyFor: type event: event. |
			ky isNil ifTrue: [ ^nil ].
			^keyEdit: ky from: a to: b
		)
		elementAt: ss = (
			(* The element of the block at the path ss: this view's own, not one
of what an amplet in it shows (another document's view, whose blocks have
paths of their own, the same ones); nil when there is none. *)
			
			| all = root querySelectorAll: '[data-steps="' , (stepsString: ss) , '"]'. |
			0 to: (all at: #length) - 1
				do: [:i | | e = all item: i. | (isOwnElement: e) ifTrue: [ ^e ] ].
			^nil
		)
		enableStringFields = (
			(* The string fields of the view can be edited in place, as plain
text: the document's own, not those of what an amplet shows. *)
			
			| fields = root querySelectorAll: '[data-string-field]'. |
			0 to: (fields at: #length) - 1
				do: [:i |
					| f = fields item: i. |
					(isOwnElement: f) ifTrue: [
							f setAttribute: 'contenteditable' to: 'plaintext-only'.
							f setAttribute: 'data-string-shown' to: (f at: #textContent)
						]
				]
		)
		flash: pt center: centered = (
			(* Show the block the point pt is in: scroll it into view (to the
middle, or just into view), and outline it for a moment. *)
			
			| element ::= elementAt: pt steps. options = JSObject new. style |
			element isNil ifTrue: [ element:: root ].
			options at: #block
				put: (centered ifTrue: [ 'center' ] ifFalse: [ 'nearest' ]).
			element scrollIntoView: options.
			style:: element at: #style.
			style at: #boxShadow put: '0 0 0 3px rgba(240, 170, 0, 0.75)'.
			window setTimeout: [
					style at: #boxShadow put: ''.
					nil
				]
				with: 900
		)
		frameMaxWidth = (
			(* The widest the frame may be: what the document's page allows (and
the frame's padding and border), or the space available. *)
			
			| w |
			session tree isNil ifTrue: [ ^'100%' ].
			w:: blocks pageMaxWidth: session tree state page.
			w isNil ifTrue: [ ^'100%' ].
			^'calc(' , w , ' + 12px)'
		)
		frameStyle = (
			(* The live view's frame: a blue border the reader stretches or
shrinks (its bottom right corner), at most as wide as the page allows, and
as high as the reader likes. The size the reader gives it is the session's,
so an image (a Eurasia snapshot) keeps it, but a document opened afresh
fills the width available and is as high as its content. *)
			
			^'white-space: pre-wrap; outline: none; padding: 4px; min-height: 2em; border: 2px solid #4a7bd0; resize: both; overflow: auto; box-sizing: border-box; min-width: 12em; max-width: ' , frameMaxWidth , ';' , (session frameWidth isNil ifTrue: [
					''
				]
				ifFalse: [ ' width: ' , session frameWidth , ';' ]) , (session frameHeight isNil ifTrue: [
					''
				]
				ifFalse: [ ' height: ' , session frameHeight , ';' ])
		)
		handle: event = (
			(* An input event: its edit, applied. The browser gives the range
some edits cover, which need not be the selection: a spelling correction's
word, the word or line a deletion takes. *)
			
			| type = event at: #inputType. make ranges |
			event preventDefault.
			make:: [:a :b :collapsed |
				editFor: type event: event caret: a caret: b collapsed: collapsed
			].
			(rangeTypes includes: type) ifFalse: [ ^edit: make ].
			ranges:: event getTargetRanges.
			(ranges at: #length) = 0 ifTrue: [ ^self ].
			((ranges at: 0) at: #collapsed) ifTrue: [ ^self ].
			edit: make range: (ranges at: 0)
		)
		handleClick: event = (
			(* Cmd-Shift-click (Ctrl-Shift-click elsewhere) on a link follows it: a
link within the page (#label) scrolls to the block with that label, any
other opens its target in a tab. Cmd-click alone is the sync with the raw
view, which the presenter does; it does not follow the link. *)
			
			| anchor href |
			(owns: (event at: #target)) ifFalse: [ ^self ].
			((event at: #metaKey) or: [ event at: #ctrlKey ]) ifFalse: [ ^self ].
			anchor:: (event at: #target) closest: 'a[href]'.
			anchor isNil ifTrue: [ ^self ].
			event preventDefault.
			(event at: #shiftKey) ifFalse: [ ^self ].
			href:: anchor getAttribute: 'href'.
			(href isEmpty not and: [ (href copyFrom: 1 to: 1) = '#' ]) ifTrue: [
					^scrollToLabel: (href copyFrom: 2 to: href size)
				].
			window open: href with: '_blank'
		)
		handleKey: event = (
			(* Cmd-B, Cmd-I, and Cmd-U (Ctrl on other platforms) style the
selection strong, emphasis, and underline; Cmd-Shift-X strikethrough;
Cmd-comma subscript and Cmd-period superscript. *)
			
			| key = event at: #key. style |
			((event at: #metaKey) or: [ event at: #ctrlKey ]) ifFalse: [ ^self ].
			(event at: #shiftKey) ifTrue: [
					(key = 'x' or: [ key = 'X' ]) ifTrue: [ style:: 'strikethrough' ]
				]
				ifFalse: [
					key = 'b' ifTrue: [ style:: 'strong' ].
					key = 'i' ifTrue: [ style:: 'emphasis' ].
					key = 'u' ifTrue: [ style:: 'underline' ].
					key = ',' ifTrue: [ style:: 'subscript' ].
					key = '.' ifTrue: [ style:: 'superscript' ]
				].
			style isNil ifTrue: [ ^self ].
			event preventDefault.
			edit: [:a :b :collapsed |
					keyEdit: (edits Key kind: #style chars: nil style: style) from: a to: b
				]
		)
		indexOf: node in: parent = (
			(* The index of a child node. The DOM decides identity: two aliens of
one node are not ==. *)
			
			| kids = parent at: #childNodes. |
			0 to: (kids at: #length) - 1
				do: [:i | ((kids at: i) isSameNode: node) ifTrue: [ ^i ] ].
			^0
		)
		public insert: statements after: tree = (
			(* Add the statements (source text, such as courseNamed: 'Course'
description: '' wine: '') right after the statement that made tree, in the
same bracket; the view and the raw view are shown again. For the
affordances of templates' blocks. *)
			
			| w = session source. s = tree messages first. new |
			new:: (w copyFrom: 1 to: s span end) , (emmanuel codePointsOf: '. ' , statements) , (w copyFrom: s span end + 1
				to: w size).
			session reinterpret: new.
			session failed ifFalse: [
					session changeHandler isNil ifFalse: [
							session changeHandler value: session sourceString
						]
				].
			render
		)
		public insertNote = (
			(* A new note at the end of the selection, holding the placeholder
Note (an empty note, an inline block, would be tidied away), with the caret
after it. *)
			
			edit: [:a :b :collapsed |
					edits replace: b
						to: b
						items: {unaryItem: 'note'. textItem: 'Note'. }
						after: {unaryItem: 'endNote'. }
				]
		)
		public isKindOfEmmanuelEditorFragment = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelEditorFragment
		)
		isOwn: event = (
			(* Whether an input or key event is the editor's: one whose target
lies in the editor's own editable content, as opposed to an amplet's. The
target may be the editor or any element in it (Chrome targets a cut, a
paste, or a spelling correction at the run's element), so the test is the
nearest element that sets contenteditable: the editor itself, or an amplet
(contenteditable false), whose events, a method presenter's code editor's
say, go to it untouched. *)
			
			| target ::= event at: #target. |
			(target at: #nodeType) = 1 ifFalse: [ target:: target at: #parentElement ].
			target isNil ifTrue: [ ^false ].
			^(target closest: '[contenteditable]') isSameNode: root
		)
		isOwnElement: e = (
			(* Whether the element e is this view's own: in the view, and not
within an amplet of it (an amplet's own element is). An amplet around the
view, when it is shown in another's, is not the view's. *)
			
			| a |
			(root contains: e) ifFalse: [ ^false ].
			a:: (e at: #parentElement) closest: '[data-amplet]'.
			^a isNil or: [ (root contains: a) not ]
		)
		isRunElement: element = (
			^(element at: #nodeType) = 1 and: [
					(element at: #tagName) = 'SPAN' and: [
							(element getAttribute: 'contenteditable') isNil and: [
									((element at: #childNodes) at: #length) = 1
								]
						]
				]
		)
		isStringField: node = (
			node isNil ifTrue: [ ^false ].
			(node at: #nodeType) = 1 ifFalse: [ ^false ].
			^(node hasAttribute: 'data-string-field') and: [
					node hasAttribute: 'data-string-shown'
				]
		)
		itemElementsOf: element = (
			(* The children of a block's element that render its children, by
their index. *)
			
			| out = List new. kids = element at: #childNodes. |
			0 to: (kids at: #length) - 1
				do: [:i |
					| k = kids at: i. j = dataAttribute: 'data-item' of: k. |
					j isNil ifFalse: [ out add: {Integer parse: j radix: 10. k. } ]
				].
			^out asArray
		)
		keyEdit: ky from: a to: b = (
			(* The edit the key ky makes at the selection from a to b, or nil:
edits key:, with what it types kept for the view's spaces. *)
			
			ky kind = #type ifTrue: [ typed:: ky chars ].
			^edits key: ky markup: markup tree: session tree caret: a caret: b
		)
		keyFor: type event: event = (
			(* The key of the view an input event is, or nil. A cut deletes the
selection, as Delete does, and so does a deletion of a word or a line over
the range it covers; a spelling correction types its word over the
misspelled one, and a transposition (Ctrl-T) the two characters it swaps over
them. *)
			
			| text |
			({'insertText'. 'insertReplacementText'. 'insertTranspose'. } includes: type) ifTrue: [
					text:: event at: #data.
					(text isNil and: [ (event at: #dataTransfer) isNil not ]) ifTrue: [
							
							(* A spelling correction's word is in its data transfer. *)
							text:: (event at: #dataTransfer) getData: 'text/plain'
						].
					text isNil ifTrue: [ ^nil ].
					^edits Key kind: #type chars: (emmanuel codePointsOf: text) style: nil
				].
			type = 'insertFromPaste' ifTrue: [
					^edits Key kind: #type
						chars: (emmanuel codePointsOf: ((event at: #dataTransfer) getData: 'text/plain'))
						style: nil
				].
			type = 'insertParagraph' ifTrue: [
					^edits Key kind: #enter chars: nil style: nil
				].
			type = 'insertLineBreak' ifTrue: [
					^edits Key kind: #newline chars: nil style: nil
				].
			type = 'deleteContentBackward' ifTrue: [
					^edits Key kind: #backspace chars: nil style: nil
				].
			(({'deleteContentForward'. 'deleteByCut'. 'deleteContent'. } includes: type) or: [
					rangeTypes includes: type
				]) ifTrue: [ ^edits Key kind: #delete chars: nil style: nil ].
			(styleOfFormat: type) isNil ifFalse: [
					^edits Key kind: #style chars: nil style: (styleOfFormat: type)
				].
			^nil
		)
		kidsAt: ss = (
			^(edits nav: markup tree: session tree steps: ss) block items
		)
		markup = (
			^edits Markup document: 'doc' literal: nil
		)
		public openNoteAtCaret = (
			(* Open the note the caret is in, and select its text, a new note's
placeholder, for typing over. *)
			
			| selection = domDocument getSelection. node element key kids text range |
			(selection at: #rangeCount) = 0 ifTrue: [ ^self ].
			node:: selection at: #focusNode.
			node isNil ifTrue: [ ^self ].
			element:: (node at: #nodeType) = 3 ifTrue: [ node at: #parentElement ]
				ifFalse: [ node ].
			element:: element closest: '[data-note]'.
			element isNil ifTrue: [ ^self ].
			key:: element getAttribute: 'data-note'.
			session amplets openNote: key.
			(element at: #style) at: #backgroundColor put: 'rgba(255, 236, 153, 0.45)'.
			kids:: element at: #children.
			0 to: (kids at: #length) - 1
				do: [:i |
					| k = kids item: i. |
					(k getAttribute: 'data-note-marker') isNil ifTrue: [
							(k at: #style) at: #display put: ''.
							(text isNil and: [ (k at: #firstChild) isNil not ]) ifTrue: [
									text:: k at: #firstChild
								]
						]
				].
			(text isNil or: [ ((text at: #nodeType) = 3) not ]) ifTrue: [ ^self ].
			range:: domDocument createRange.
			range setStart: text offset: 0.
			range setEnd: text offset: (text at: #length).
			selection removeAllRanges.
			selection addRange: range
		)
		owns: node = (
			(* Whether the node node of the page is this view's own: in it, and not
in what an amplet of it shows (another document's editor, say, whose events,
selection, and blocks are its own). *)
			
			| e |
			node isNil ifTrue: [ ^false ].
			e:: (node at: #nodeType) = 1 ifTrue: [ node ]
				ifFalse: [ node at: #parentElement ].
			e isNil ifTrue: [ ^false ].
			^isOwnElement: e
		)
		place: pt = (
			(* Put the browser's caret at a point. *)
			
			| element = elementAt: pt steps. items range child before node offset |
			element isNil ifTrue: [ ^self ].
			items:: itemElementsOf: element.
			child:: items detect: [:x | (x at: 1) = pt child ] ifNone: [ nil ].
			before:: items detect: [:x | (x at: 1) = (pt child - 1) ] ifNone: [ nil ].
			pt isGap ifTrue: [
					(child isNil not and: [ isRunElement: (child at: 2) ]) ifTrue: [
							node:: (child at: 2) at: #firstChild.
							offset:: 0
						]
						ifFalse: [
							(before isNil not and: [ isRunElement: (before at: 2) ]) ifTrue: [
									node:: (before at: 2) at: #firstChild.
									offset:: node at: #length
								]
								ifFalse: [
									node:: element.
									offset:: child isNil ifTrue: [ (element at: #childNodes) at: #length ]
										ifFalse: [ indexOf: (child at: 2) in: element ]
								]
						]
				]
				ifFalse: [
					child isNil ifTrue: [ ^self ].
					node:: (child at: 2) at: #firstChild.
					offset:: pt offset
				].
			range:: domDocument createRange.
			range setStart: node offset: offset.
			range collapse: true.
			domDocument getSelection removeAllRanges.
			domDocument getSelection addRange: range
		)
		pointAt: node offset: o = (
			(* The point of a position in the rendering. *)
			
			| parent steps j length items next |
			(node at: #nodeType) = 3 ifTrue: [
					parent:: node at: #parentNode.
					j:: dataAttribute: 'data-item' of: parent.
					j isNil ifTrue: [
							^pointAt: parent offset: (o > 0 ifTrue: [ 1 ] ifFalse: [ 0 ])
						].
					steps:: stepsOf: (parent at: #parentNode).
					j:: Integer parse: j radix: 10.
					length:: node at: #length.
					o = 0 ifTrue: [ ^edits gap: steps at: j ].
					o >= length ifTrue: [ ^edits gap: steps at: j + 1 ].
					^edits in: steps at: j offset: o
				].
			(dataAttribute: 'data-steps' of: node) isNil ifFalse: [
					steps:: stepsOf: node.
					items:: itemElementsOf: node.
					next:: items detect: [:x | (indexOf: (x at: 2) in: node) >= o ]
						ifNone: [ nil ].
					next isNil ifTrue: [ ^edits gap: steps at: (kidsAt: steps) size ].
					^edits gap: steps at: (next at: 1)
				].
			(node isSameNode: root) ifTrue: [
					^edits gap: {} at: (o = 0 ifTrue: [ 0 ] ifFalse: [ (kidsAt: {}) size ])
				].
			j:: dataAttribute: 'data-item' of: node.
			parent:: node at: #parentNode.
			parent isNil ifTrue: [ ^nil ].
			j isNil ifFalse: [
					steps:: stepsOf: parent.
					^edits gap: steps
						at: (Integer parse: j radix: 10) + (o > 0 ifTrue: [ 1 ] ifFalse: [ 0 ])
				].
			^pointAt: parent
				offset: (indexOf: node in: parent) + (o > 0 ifTrue: [ 1 ] ifFalse: [ 0 ])
		)
		quoted: p = (
			(* p as a string literal. *)
			
			| out = List new. |
			out add: 39.
			(emmanuel codePointsOf: p) do: [:c |
					out add: c.
					c = 39 ifTrue: [ out add: 39 ]
				].
			out add: 39.
			^emmanuel stringOfCodePoints: out asArray
		)
		rangeTypes = (
			(* The input events whose edit covers the range the browser gives
(getTargetRanges), not the selection. Typing it is for a spelling
correction and a transposition; the rest delete. *)
			
			^{'insertReplacementText'. 'insertTranspose'. 'deleteWordBackward'. 'deleteWordForward'. 'deleteSoftLineBackward'. 'deleteSoftLineForward'. 'deleteEntireSoftLine'. 'deleteHardLineBackward'. 'deleteHardLineForward'. 'deleteByDrag'. }
		)
		rememberFrameWidth = (
			(* The reader resized the frame: the session keeps its width and
height. *)
			
			| w = (root at: #style) at: #width. h = (root at: #style) at: #height. |
			(w isNil or: [ w isEmpty ]) ifFalse: [ session frameWidth: w ].
			(h isNil or: [ h isEmpty ]) ifFalse: [ session frameHeight: h ]
		)
		render = (
			(* Render the session's tree in place of the previous rendering. *)
			
			| subject presenter visual start |
			session tree isNil ifTrue: [ ^renderUnparsable ].
			subject:: blocks TreeSubject onModel: session tree.
			subject amplets: session amplets.
			presenter:: subject presenter.
			presenter parent: self.
			session displayedIn: self.
			session amplets beginRender.
			start:: clock now.
			visual:: presenter visual.
			session timings: session timings , ', render ' , (clock now - start) printString.
			session amplets endRender.
			session failed ifTrue: [ visual setAttribute: 'style' to: 'opacity: 0.5;' ].
			content isNil ifTrue: [ root appendChild: visual ]
				ifFalse: [ root replaceChild: visual with: content ].
			content:: visual.
			(root at: #style) at: #maxWidth put: frameMaxWidth.
			enableStringFields.
			showProblem
		)
		renderUnparsable = (
			(* A source that has never interpreted has no tree to show: its text
is shown, dimmed, until it does. *)
			
			| visual = domDocument createElement: 'div'. |
			visual setAttribute: 'style' to: 'opacity: 0.5;'.
			visual at: #textContent put: session sourceString.
			content isNil ifTrue: [ root appendChild: visual ]
				ifFalse: [ root replaceChild: visual with: content ].
			content:: visual.
			showProblem
		)
		public replaceSelectionWith: items after: afterItems = (
			(* Replace the selection with items, the caret after them and before
afterItems; for commands, such as a toolbar's. *)
			
			edit: [:a :b :collapsed |
					edits replace: a to: b items: items after: afterItems
				]
		)
		public revealSourceOffset: k = (
			(* Sync, following: show where this view shows the offset k (in code
points) of the source, leaving the caret where it is. *)
			
			| pt = session pointAtSourceOffset: k. |
			pt isNil ifTrue: [ ^self ].
			flash: pt center: false
		)
		saveSelection = (
			(* Remember the selection, when it is in this view, as focus leaves it. *)
			
			| selection = domDocument getSelection. range |
			(selection at: #rangeCount) = 0 ifTrue: [ ^self ].
			range:: selection getRangeAt: 0.
			(owns: (range at: #startContainer)) ifTrue: [ savedRange:: range cloneRange ]
		)
		scrollToLabel: label = (
			(* Scroll to the block of this view labelled label. *)
			
			| all = root querySelectorAll: '[data-label]'. |
			0 to: (all at: #length) - 1
				do: [:i |
					| x = all item: i. |
					((x getAttribute: 'data-label') = label and: [ isOwnElement: x ]) ifTrue: [
							^x scrollIntoView
						]
				]
		)
		public selectedText = (
			| range = selectionRange. |
			range isNil ifTrue: [ ^'' ].
			^range toString
		)
		selectionRange = (
			(* The range a command acts on. While this view has the focus (typing,
its keys), the selection; otherwise (a command from a menu or a toolbar,
which took the focus) the selection this view had when focus last left it,
while that is still in the view: pressing a menu's item moves the browser's
selection, collapsing it, before the item's action runs. Nil when there is
neither. *)
			
			| selection = domDocument getSelection. saved = savedRange isNil not and: [
					owns: (savedRange at: #startContainer)
				]. range |
			(saved and: [ (owns: (domDocument at: #activeElement)) not ]) ifTrue: [
					^savedRange
				].
			(selection at: #rangeCount) > 0 ifTrue: [
					range:: selection getRangeAt: 0.
					(owns: (range at: #startContainer)) ifTrue: [ ^range ]
				].
			saved ifTrue: [ ^savedRange ].
			^nil
		)
		public selectWordAtCaret = (
			(* Extend the selection from the caret over the word after it, so that
typing replaces it: a new section's heading. *)
			
			domDocument getSelection modify: 'extend' with: 'forward' with: 'word'
		)
		showProblem = (
			(* Above the view, what is wrong with a source that does not
interpret (its lexical or syntax error, where, and the line it is on), while
the view, dimmed, shows the last one that did; nothing when it interprets. *)
			
			| p = session problem. |
			problemBox isNil ifTrue: [ ^self ].
			p isNil ifTrue: [
					problemBox at: #textContent put: ''.
					^problemBox setAttribute: 'style' to: 'display: none;'
				].
			problemBox setAttribute: 'style'
				to: 'color: #8b0000; background-color: #fff0f0; border: 1px solid #e0a0a0; border-radius: 3px; padding: 4px 8px; margin: 0 0 6px 0; font: 12px ui-monospace, Menlo, monospace; white-space: pre; overflow-x: auto;'.
			problemBox at: #textContent put: p
		)
		public showSourceOffset: k = (
			(* Sync, a jump: put the caret where this view shows the offset k (in
code points) of the source, and show it. *)
			
			| pt = session pointAtSourceOffset: k. |
			pt isNil ifTrue: [ ^self ].
			root focus.
			place: pt.
			flash: pt center: true
		)
		public sizeSelection: step = (
			(* Size the selection: step is a named size ('smaller', 'larger',
'small', 'large', 'xLarge'), applied as size: #step (a different size there
is replaced, the same one removed); nil removes any size there. *)
			
			styleSelection: 'size:'
				value: (step isNil ifTrue: [ nil ] ifFalse: [ '#' , step ])
		)
		public source: w = (
			(* Make the string w the source, as when the raw view changes it: it
is reinterpreted, and shown again. While it does not interpret, the last
tree that did is shown, dimmed, and typing in it does nothing. *)
			
			session reinterpret: (emmanuel codePointsOf: w).
			hasVisual ifTrue: [ render ]
		)
		public sourceAligning: a = (
			(* The source with the blocks at the selection aligned to a, and the
offset of the selection's start in it (Session align:from:to:); nil when the
selection is not in this view, or there is nothing there to align. *)
			
			| range = selectionRange. r |
			range isNil ifTrue: [ ^nil ].
			r:: [
				session align: a
					from: (pointAt: (range at: #startContainer)
						offset: (range at: #startOffset))
					to: (pointAt: (range at: #endContainer) offset: (range at: #endOffset))
			] on: Error do: [:e | nil ].
			r isNil ifTrue: [ ^nil ].
			^{emmanuel stringOfCodePoints: (r at: 1). r at: 2. }
		)
		sourceAtCaret: op = (
			(* What op, given the point of the start of the selection, answers: {a
source (code points). an offset}, with the source as a string; nil when the
selection is not in this view, or op answers nil. *)
			
			| range = selectionRange. r |
			range isNil ifTrue: [ ^nil ].
			r:: [
				op value: (pointAt: (range at: #startContainer)
						offset: (range at: #startOffset))
			] on: Error do: [:e | nil ].
			r isNil ifTrue: [ ^nil ].
			^{emmanuel stringOfCodePoints: (r at: 1). r at: 2. }
		)
		public sourceEndingSection = (
			(* The source with the section the caret is in ended after the caret's
block, and the offset of what now follows it (Session endSectionAt:); nil
when there is none. *)
			
			^sourceAtCaret: [:pt | session endSectionAt: pt ]
		)
		public sourceOffsetAtX: x y: y = (
			(* Sync: the offset (in code points) of the source of what this view
shows at the point x, y of the window; nil when there is none. *)
			
			^[
				| range = domDocument caretRangeFromPoint: x y: y. |
				range isNil ifTrue: [ nil ]
					ifFalse: [
						session sourceOffsetAt: (syncPointAt: (range at: #startContainer)
								offset: (range at: #startOffset))
					]
			] on: Error do: [:e | nil ]
		)
		public sourceOffsetOfSelection = (
			(* Sync: the offset (in code points) of the source at the caret in this
view (the focus of the selection); nil when the caret is elsewhere. *)
			
			^[
				| selection = domDocument getSelection. node |
				(selection at: #rangeCount) = 0 ifTrue: [ nil ]
					ifFalse: [
						node:: selection at: #focusNode.
						(owns: node) not ifTrue: [ nil ]
							ifFalse: [
								session sourceOffsetAt: (syncPointAt: node
										offset: (selection at: #focusOffset))
							]
					]
			] on: Error do: [:e | nil ]
		)
		public sourceOpeningSection = (
			(* The source with a new subsection after the caret's block, and the
offset of its heading (Session openSectionAt:); nil when there is none. *)
			
			^sourceAtCaret: [:pt | session openSectionAt: pt ]
		)
		public sourceWithPage: p = (
			(* The source with its page: statement set to p: the statement that
set the page rewritten, or, when there is none, one added at the start. *)
			
			| w = session source. lit = emmanuel codePointsOf: 'page: ' , (quoted: p). s |
			session tree isNil ifTrue: [ ^nil ].
			s:: session tree messages detect: [:m |
					m isComment not and: [ m selector = 'page:' ]
				]
				ifNone: [ nil ].
			s isNil ifTrue: [
					^emmanuel stringOfCodePoints: (emmanuel codePointsOf: '[\') , lit , (emmanuel codePointsOf: '\]') , w
				].
			^emmanuel stringOfCodePoints: (w copyFrom: 1 to: s span start) , lit , (w copyFrom: s span end + 1
					to: w size)
		)
		stepsIn: s = (
			(* The steps the string s (as data-steps holds them) names. *)
			
			(s isNil or: [ s isEmpty ]) ifTrue: [ ^{} ].
			^(words: s) collect: [:w |
					| cps = emmanuel codePointsOf: w. j = Integer parse: (emmanuel stringOfCodePoints: (cps copyFrom: 2
								to: cps size))
						radix: 10. |
					cps first = 102 ifTrue: [ edits fieldOf: j ] ifFalse: [ edits into: j ]
				]
		)
		stepsOf: element = (
			| s = dataAttribute: 'data-steps' of: element. |
			s isNil ifTrue: [ ^{} ].
			^(words: s) collect: [:w |
					| cps = emmanuel codePointsOf: w. j = Integer parse: (emmanuel stringOfCodePoints: (cps copyFrom: 2
								to: cps size))
						radix: 10. |
					cps first = 102 ifTrue: [ edits fieldOf: j ] ifFalse: [ edits into: j ]
				]
		)
		stepsString: ss = (
			| out ::= ''. |
			ss keysAndValuesDo: [:i :s |
					i > 1 ifTrue: [ out:: out , ' ' ].
					out:: out , (s isField ifTrue: [ 'f' ] ifFalse: [ 'i' ]) , s index printString
				].
			^out
		)
		stringFieldKey: event = (
			(* In a string field, Enter commits it and Escape abandons it. *)
			
			| t = event at: #target. |
			(isStringField: t) ifFalse: [ ^self ].
			(event at: #key) = 'Enter' ifTrue: [
					event preventDefault.
					^t blur
				].
			(event at: #key) = 'Escape' ifTrue: [
					event preventDefault.
					render
				]
		)
		styleOfFormat: type = (
			(* The style a formatting input event asks for, or nil. *)
			
			type = 'formatBold' ifTrue: [ ^'strong' ].
			type = 'formatItalic' ifTrue: [ ^'emphasis' ].
			type = 'formatUnderline' ifTrue: [ ^'underline' ].
			type = 'formatStrikeThrough' ifTrue: [ ^'strikethrough' ].
			type = 'formatSubscript' ifTrue: [ ^'subscript' ].
			type = 'formatSuperscript' ifTrue: [ ^'superscript' ].
			^nil
		)
		public styleSelection: x = (
			(* Style the selection: emphasis, strong, underline, strikethrough,
subscript, superscript, or code. *)
			
			edit: [:a :b :collapsed |
					keyEdit: (edits Key kind: #style chars: nil style: x) from: a to: b
				]
		)
		public styleSelection: selector value: code = (
			(* Style the selection with the style selector, which takes a value,
given as the Newspeak code of its argument (size: #large, color:
'crimson'): a different value there is replaced, the same one removed. Nil
code removes the style there, whatever its value. *)
			
			| key = code isNil ifTrue: [
					edits Key kind: #unstyle chars: nil style: selector
				]
				ifFalse: [
					edits Key kind: #style
						chars: nil
						style: (codeItem: selector code: code) statement
				]. |
			edit: [:a :b :collapsed | keyEdit: key from: a to: b ]
		)
		styleSheet = (
			(* Empty blocks keep a height, so that the caret can be put in them. *)
			
			| s = domDocument createElement: 'style'. |
			s at: #textContent
				put: '[data-steps]:empty { min-height: 1.2em; } span[data-steps]:empty, em[data-steps]:empty, strong[data-steps]:empty, u[data-steps]:empty, s[data-steps]:empty, sub[data-steps]:empty, sup[data-steps]:empty, code[data-steps]:empty, a[data-steps]:empty { display: inline-block; min-width: 1px; } span[data-string-field] { min-width: 2em; display: inline-block; } [data-string-field]:empty { min-height: 1.2em; border-bottom: 1px dotted #999; } [data-string-field]:focus { outline: 1px solid #4a7bd0; }'.
			^s
		)
		syncPointAt: node offset: o = (
			(* The point of a position in the rendering, for the sync with the
raw view: as pointAt:offset:, except that a position in text that has no
point of its own (the HTML an html: display shows, a string field), whose
element is neither a child nor a block of the view, is just before the
nearest block around it. A position within what an amplet shows is just
before the amplet. *)
			
			| parent = node at: #parentNode. e ::= parent. ss a |
			a:: ((node at: #nodeType) = 1 ifTrue: [ node ] ifFalse: [ parent ]) closest: '[data-amplet]'.
			[ a isNil not and: [ (isOwnElement: a) not ] ] whileTrue: [
					a:: (a at: #parentElement) closest: '[data-amplet]'
				].
			a isNil ifFalse: [
					ss:: stepsOf: a.
					ss isEmpty ifFalse: [
							^edits gap: (ss copyFrom: 1 to: ss size - 1) at: ss last index
						]
				].
			((node at: #nodeType) = 3 and: [
					parent isNil not and: [
							(dataAttribute: 'data-item' of: parent) isNil and: [
									(dataAttribute: 'data-steps' of: parent) isNil
								]
						]
				]) ifFalse: [ ^pointAt: node offset: o ].
			[ e isNil not and: [ (dataAttribute: 'data-steps' of: e) isNil ] ] whileTrue: [
					e:: e at: #parentNode
				].
			e isNil ifTrue: [ ^pointAt: node offset: o ].
			ss:: stepsOf: e.
			(ss isEmpty or: [ ss last isField ]) ifTrue: [ ^pointAt: node offset: o ].
			^edits gap: (ss copyFrom: 1 to: ss size - 1) at: ss last index
		)
		updateVisualsFromSameKind: oldFragment = (
			(* A refresh of the GUI reaches the editor of a document as the same
fragment, since the document keeps its editor: its amplets are run again
and reconciled, as an Ampleforth document's are, and its source is
interpreted again (from its nodes) and shown again, so that a change to the
document's code, its template's blocks, their presenters, or its
constructs, is live. A refresh reaches only an editor that is shown; on the
largest documents it adds tens of milliseconds. *)
			
			oldFragment == self ifTrue: [
					session amplets refresh.
					session refresh.
					render.
					^visual
				].
			^replaceVisual: oldFragment visual with: visual
		)
		words: s = (
			| out = List new. word = List new. |
			(emmanuel codePointsOf: s) do: [:c |
					c = 32 ifTrue: [
							word isEmpty ifFalse: [
									out add: (emmanuel stringOfCodePoints: word asArray).
									word removeAll
								]
						]
						ifFalse: [ word add: c ]
				].
			word isEmpty ifFalse: [ out add: (emmanuel stringOfCodePoints: word asArray) ].
			^out asArray
		)
	) : ()
	public class Session source: w evaluator: ev = (
		(* An edited source: its text, its nodes and tree (the last that
interpreted, when the source does not), and the caret of the last edit. *)
		
		|
			public source ::= emmanuel codePointsOf: w.
			public host = hosts Host evaluator: ev.
			public amplets = blocks AmpletRunner evaluator: ev.
			private evaluator = ev.
			public nodes
			public tree
			public failed ::= false.
			public caret
			public timings ::= ''.
			public changeHandler ::= nil.
			public frameWidth ::= nil.
			public frameHeight ::= nil.
			public problem ::= nil.
		|
		interpret.
	) (
		public addMedia: file named: name = (
			(* Add the file to the document's media, when there is a document. *)
			
			evaluator isNil ifTrue: [ ^self ].
			evaluator addMedia: file named: name
		)
		public agreesWithWholeParse = (
			(* Whether the nodes, kept incrementally, are those of parsing the
whole source; for tests. *)
			
			| whole = emmanuel parse: 'doc'
				source: source
				host: (hosts Host evaluator: nil). |
			(whole isNil or: [ whole isKindOfParsed not ]) ifTrue: [ ^failed ].
			whole nodes size = nodes size ifFalse: [ ^false ].
			1 to: nodes size
				do: [:i |
					(emmanuel termStringOf: (whole nodes at: i)) = (emmanuel termStringOf: (nodes at: i)) ifFalse: [
							^false
						]
				].
			^true
		)
		public align: a from: p1 to: p2 = (
			(* Alignment: the blocks of flow content from the point p1 to the point
p2 (paragraphs, lists, quotes, tables, displays) aligned to a ('left',
'center', or 'right') with the stylesheet's align: container, as {the new
source (code points). the offset of p1 in it}; the source unchanged when it
is aligned so already; nil when there is nothing there an align: can hold (a
heading, or blocks of different sections). An align: that holds just those
blocks, or that is the one block, is changed: left, where nothing around it
aligns, removes it. Any other blocks are put in an align: of their own, inside
any around them. *)
			
			| s e c path i j parent items target |
			(failed or: [ p1 isNil or: [ p2 isNil ] ]) ifTrue: [ ^nil ].
			s:: flowItemPathOf: p1.
			e:: flowItemPathOf: p2.
			(s isNil or: [ e isNil ]) ifTrue: [ ^nil ].
			c:: 0.
			[ c < s size and: [ c < e size and: [ (s at: c + 1) = (e at: c + 1) ] ] ] whileTrue: [
					c:: c + 1
				].
			(c = s size or: [ c = e size ]) ifTrue: [
					| p = s size <= e size ifTrue: [ s ] ifFalse: [ e ]. |
					path:: p copyFrom: 1 to: p size - 1.
					i:: p last.
					j:: p last
				]
				ifFalse: [
					path:: s copyFrom: 1 to: c.
					i:: (s at: c + 1) min: (e at: c + 1).
					j:: (s at: c + 1) max: (e at: c + 1)
				].
			parent:: treeAt: path.
			items:: parent items copyFrom: i + 1 to: j + 1.
			(items allSatisfy: [:g | g kind ~= #sub or: [ isFlowItem: g ref in: parent ] ]) ifFalse: [
					^nil
				].
			target:: nil.
			((isAlign: parent) and: [
					(parent items select: [:g | g kind = #sub ]) allSatisfy: [:g |
							items includes: g
						]
				]) ifTrue: [ target:: parent ].
			(target isNil and: [ i = j and: [ isAlign: (parent items at: i + 1) ref ] ]) ifTrue: [
					target:: (parent items at: i + 1) ref.
					path:: path , {i. }
				]
				ifFalse: [
					target isNil ifFalse: [ path:: path copyFrom: 1 to: path size - 1 ]
				].
			target isNil ifFalse: [
					^edited: (realign: target to: a around: (alignsAround: path))
						caret: (sourceOffsetAt: p1)
				].
			^edited: (wrap: (parent items at: i + 1) ref
					to: (parent items at: j + 1) ref
					in: a
					around: (alignsAround: path , {i. }))
				caret: (sourceOffsetAt: p1)
		)
		alignsAround: path = (
			(* Whether a block on the path from the root to the block at path, not
counting that block, is an align:. *)
			
			| tr ::= tree. |
			1 to: path size - 1
				do: [:k |
					tr:: (tr items at: (path at: k) + 1) ref.
					(isAlign: tr) ifTrue: [ ^true ]
				].
			^false
		)
		public apply: e = (
			^apply: e typed: nil
		)
		public apply: e typed: typed = (
			(* Apply an edit: answers the caret after it, or nil when the edit
was refused or changed another source. When the edit types the code points
typed, a space among them that white space beside it would collapse away
becomes a no-break space, so that what one types is what one sees. *)
			
			| t0 = clock now. t1 t2 result oldSource = source. oldNodes = nodes. oldTree = tree. |
			failed ifTrue: [ ^nil ].
			result:: edits edit: e
				image: image
				name: 'doc'
				document: {nodes. tree. }
				host: host.
			t1:: clock now.
			(result isNil or: [ result isRefused ]) ifTrue: [ ^nil ].
			result sourceName = 'doc' ifFalse: [ ^nil ].
			reinterpret: (typed isNil ifTrue: [ result chars ]
					ifFalse: [ edits keepSpaces: typed in: result chars caret: result caret ]).
			failed ifTrue: [
					
					(* An edit in the live view must leave a source that
interprets; one that does not is refused, and the source is as it was, so the
view never goes dead under the user's hands. *)
					source:: oldSource.
					nodes:: oldNodes.
					tree:: oldTree.
					failed:: false.
					problem:: nil.
					Error signal: 'an edit that would leave the source uninterpretable was refused'
				].
			changeHandler isNil ifFalse: [ changeHandler value: sourceString ].
			t2:: clock now.
			timings:: 'edit ' , (t1 - t0) printString , ', interpret ' , (t2 - t1) printString.
			result caret isNil ifTrue: [ ^caret ].
			caret:: failed ifTrue: [ nil ]
				ifFalse: [
					edits caretIn: image
						name: 'doc'
						document: {nodes. tree. }
						steps: (markupSteps: e)
						offset: result caret
				].
			timings:: timings , ', caret ' , (clock now - t2) printString.
			^caret
		)
		describeProblemOf: w = (
			(* What is wrong with the source w, which does not interpret, for the
reader: its lexical or syntax error, where, and the line it is on; or what
an argument raised. *)
			
			| parsed = emmanuel parse: 'doc' source: w host: host. done |
			parsed isKindOfLexFail ifTrue: [ ^lexProblem: parsed error in: w ].
			parsed isKindOfSyntaxError ifTrue: [
					^'Syntax error ' , (placeOf: parsed span start in: w) , '.' , (excerptOf: w
						at: parsed span start)
				].
			(parsed isNil or: [ parsed isKindOfParsed not ]) ifTrue: [
					^'The source could not be parsed.'
				].
			done:: (emmanuel Machine host: host) interpret: parsed nodes
				root: rootBlock
				hostState: nil.
			done isKindOfRaised ifTrue: [
					^'An argument raised an error: ' , (emmanuel termStringOf: done exception)
				].
			^'The source could not be interpreted.'
		)
		public displayedIn: fragment = (
			(* The session is shown by fragment, an editor or a viewer: its
evaluator, when it has one, is told, so that a document makes fragment its
parent, as an Ampleforth fragment makes itself its document's. The document
is the receiver of its amplets' code, so code that navigates
(enterSubject:, say) goes through its parent to the shell. *)
			
			evaluator isNil ifFalse: [ evaluator displayedIn: fragment ]
		)
		edited: changes caret: k = (
			(* The source with the changes made, each {start. end. code points}
replacing the source from start to end, in descending order of start; and
the offset k after them. Nil changes leave the source as it is. *)
			
			| w ::= source. caret ::= k isNil ifTrue: [ 0 ] ifFalse: [ k ]. |
			changes isNil ifTrue: [ ^{w. caret. } ].
			changes do: [:ch |
					| p = ch at: 1. q = ch at: 2. ins = ch at: 3. |
					w:: (w copyFrom: 1 to: p) , ins , (w copyFrom: q + 1 to: w size).
					q <= caret ifTrue: [ caret:: caret + ins size - (q - p) ]
						ifFalse: [ p < caret ifTrue: [ caret:: p ] ]
				].
			^{w. caret. }
		)
		public endSectionAt: pt = (
			(* Sections: the section the point pt is in ended just after the block
pt is in, so that what followed it in the section is in the section around
it, or the document, instead; at the end of the section, an empty paragraph
added after it. As {the new source. the offset of the start of what now
follows the section}; nil when pt is in no section. *)
			
			| found sec c close later at |
			failed ifTrue: [ ^nil ].
			found:: sectionChildPathOf: pt.
			found isNil ifTrue: [ ^nil ].
			(found at: 2) ifTrue: [
					sec:: treeAt: (found at: 1).
					c:: -1
				]
				ifFalse: [
					sec:: treeAt: ((found at: 1) copyFrom: 1 to: (found at: 1) size - 1).
					c:: (found at: 1) last
				].
			(sec state stateName = 'section' and: [ sec flag = #closed ]) ifFalse: [
					^nil
				].
			close:: sec messages last.
			later:: (sec items copyFrom: c + 2 to: sec items size) select: [:g |
					g kind = #sub
				].
			later isEmpty ifTrue: [
					^{(edited: {{close span end. close span end. emmanuel codePointsOf: '. paragraph\][\endParagraph'. }. }
						caret: nil) at: 1. close span end + 13. }
				].
			at:: c < 0 ifTrue: [ sec messages first span end ]
				ifFalse: [ (sec items at: c + 1) ref messages last span end ].
			^edited: {(removal: close) , {{}. }. {at. at. emmanuel codePointsOf: '. endSection'. }. }
				caret: (textOffsetOf: later first ref)
		)
		excerptOf: w at: p = (
			(* The line of w that position p is on (at most 60 characters either
side of it), and under it a mark at p. *)
			
			| start ::= p. stop ::= p + 1. from to line marks = List new. |
			[ start > 0 and: [ ((w at: start) = 10) not ] ] whileTrue: [
					start:: start - 1
				].
			[ stop <= w size and: [ ((w at: stop) = 10) not ] ] whileTrue: [
					stop:: stop + 1
				].
			from:: start + 1 max: p + 1 - 60.
			to:: stop - 1 min: p + 60.
			line:: (w copyFrom: from to: to) collect: [:c |
					c = 9 ifTrue: [ 32 ] ifFalse: [ c ]
				].
			p + 1 - from timesRepeat: [ marks add: 32 ].
			marks add: 94.
			^emmanuel stringOfCodePoints: {10. } , line asArray , {10. } , marks asArray
		)
		flowItemPathOf: pt = (
			(* The child indices from the root to the innermost block at the point
pt that an align: can hold; nil when there is none, as in a section's
heading. *)
			
			| tr ::= tree. path = List new. best ::= nil. |
			pt steps do: [:st |
					| child |
					st isField ifTrue: [ ^best ].
					child:: (tr items at: st index + 1) ref.
					path add: st index.
					(isFlowItem: child in: tr) ifTrue: [ best:: path asArray ].
					tr:: child
				].
			^best
		)
		image = (
			^{{'doc'. source. }. }
		)
		interpret = (
			| doc = edits document: image
				name: 'doc'
				hostState: nil
				root: rootBlock
				host: host. |
			doc isNil ifTrue: [
					failed:: true.
					problem:: problemOf: source.
					^self
				].
			failed:: false.
			problem:: nil.
			nodes:: doc at: 1.
			tree:: doc at: 2
		)
		isAlign: tr = (
			^tr state stateName = 'align:'
		)
		isFlowItem: tr in: parent = (
			(* Whether the block tr, a child of parent, is flow content that an
align: there could hold: parent takes an align:, and tr is neither a section
nor inline. *)
			
			^(parent state understands: 'align:') and: [
					tr state stateName ~= 'section' and: [ tr state contentClass ~= #inline ]
				]
		)
		isSpace: c = (
			^{32. 9. 10. 13. } includes: c
		)
		lastRunIn: tr = (
			(* The last run of text in the block tr, in it or in the blocks in
it; nil when it has none. *)
			
			| r ::= nil. |
			tr items do: [:g |
					g kind = #run ifTrue: [ r:: g ].
					g kind = #sub ifTrue: [
							| x = lastRunIn: g ref. |
							x isNil ifFalse: [ r:: x ]
						]
				].
			^r
		)
		lexProblem: e in: w = (
			(* The reader's description of the lexical error e of the source w. *)
			
			| p ::= e position. |
			e kind = #strayClose ifTrue: [
					^'Lexical error ' , (placeOf: p in: w) , ': this \] closes no bracket.' , (excerptOf: w
						at: p)
				].
			e kind = #unclosedLiteral ifTrue: [
					^'Lexical error ' , (placeOf: p in: w) , ': a string or comment begins here and is never closed.' , (excerptOf: w
						at: p)
				].
			p:: unclosedOpenerIn: w.
			p isNil ifTrue: [ ^'Lexical error: a bracket is never closed.' ].
			^'Lexical error ' , (placeOf: p in: w) , ': this [\ is never closed.' , (excerptOf: w
				at: p)
		)
		library = (
			(* The document's block library (its template's, which may add
constructs), as its evaluator gives it; the shared one when there is no
evaluator, or one that gives no library. *)
			
			(evaluator isNil or: [ evaluator blocks isNil ]) ifTrue: [ ^blocks ].
			^evaluator blocks
		)
		markupSteps: e = (
			(* The path to the markup an edit is in: its point's path, up to the
last field it enters. *)
			
			| ss = e first point steps. k ::= 0. |
			ss keysAndValuesDo: [:i :s | s isField ifTrue: [ k:: i ] ].
			^ss copyFrom: 1 to: k
		)
		public openSectionAt: pt = (
			(* Sections: a new section, with the heading Heading and an empty
paragraph, at the point pt, a subsection of the section pt is in. In the
middle of a block's text, the block is split there, and the section goes
between the two halves; at the start of the block, before any of its text,
it goes just before the block; at its end, just after it. When pt is in a
section's heading, the new section starts that section. The block is the
innermost one around pt that a section can follow: one whose parent is the
document or a section. As {the new source. the offset of the new heading};
nil when there is no such block. *)
			
			^openSectionAt: pt splitting: true
		)
		public openSectionAt: pt splitting: splitting = (
			(* openSectionAt:, splitting the block in the middle of its text only
when splitting; public for the session of the split source to answer. *)
			
			| found tr at k last r |
			failed ifTrue: [ ^nil ].
			found:: sectionChildPathOf: pt.
			found isNil ifTrue: [ ^nil ].
			tr:: treeAt: (found at: 1).
			(found at: 2) ifTrue: [ at:: tr messages first span end ]
				ifFalse: [
					k:: sourceOffsetAt: pt.
					(k isNil not and: [
							k <= (sourceOffsetAt: (pointAtSourceOffset: (textOffsetOf: tr)))
						]) ifTrue: [
							at:: tr messages first span start.
							^{(edited: {{at. at. emmanuel codePointsOf: 'section: [\Heading\]. paragraph\][\endParagraph. endSection. '. }. }
								caret: nil) at: 1. at + 11. }
						].
					last:: lastRunIn: tr.
					(splitting and: [
							k isNil not and: [
									last isNil not and: [
											k < (sourceOffsetAt: (pointAtSourceOffset: last span end))
										]
								]
						]) ifTrue: [
							r:: splitAt: pt level: (found at: 1) size.
							r isNil ifFalse: [ ^r ]
						].
					(tr flag = #closed or: [ tr messages size = 1 ]) ifFalse: [ ^nil ].
					at:: tr messages last span end
				].
			^{(edited: {{at. at. emmanuel codePointsOf: '. section: [\Heading\]. paragraph\][\endParagraph. endSection'. }. }
				caret: nil) at: 1. at + 13. }
		)
		placeOf: p in: w = (
			(* Where position p of w is: its line and column, from 1. *)
			
			| line ::= 1. column ::= 1. |
			1 to: (p min: w size)
				do: [:k |
					(w at: k) = 10 ifTrue: [
							line:: line + 1.
							column:: 1
						]
						ifFalse: [ column:: column + 1 ]
				].
			^'at line ' , line printString , ', column ' , column printString
		)
		public pointAtSourceOffset: k = (
			(* Sync: the point of the view that shows what is at the offset k (in
code points) of the source; nil when the source does not interpret, or the
offset has no point. *)
			
			failed ifTrue: [ ^nil ].
			^[ edits pointIn: image name: 'doc' document: {nodes. tree. } offset: k ] on: Error
				do: [:e | nil ]
		)
		problemOf: w = (
			(* What is wrong with the source w, for the reader; describing it
must never stop the source being interpreted. *)
			
			^[ describeProblemOf: w ] on: Error
				do: [:e | 'The source does not interpret.' ]
		)
		realign: tr to: a around: aligned = (
			(* The changes that align the align: tr to a: none when it does
already; removing it for left when nothing around it aligns; otherwise its
alignment rewritten. Nil when it is not closed. *)
			
			| open = tr messages first. close = tr messages last. |
			(tr flag = #closed and: [ tr messages size > 1 ]) ifFalse: [ ^nil ].
			tr state args first = a ifTrue: [ ^nil ].
			(a = 'left' and: [ aligned not ]) ifTrue: [
					^{(removal: close) , {{}. }. (removal: open) , {{}. }. }
				].
			^{{open span start. open span end. emmanuel codePointsOf: 'align: ''' , a , ''''. }. }
		)
		public refresh = (
			(* Interpret the source again, from its nodes, since the document's
code (its blocks, their presenters, its constructs) may have changed; a
source that did not interpret is interpreted afresh. *)
			
			| done |
			library forgetConstructs.
			(failed or: [ nodes isNil ]) ifTrue: [ ^interpret ].
			done:: (emmanuel Machine host: host) interpret: nodes
				root: rootBlock
				hostState: nil.
			done isKindOfDone ifFalse: [
					failed:: true.
					problem:: problemOf: source.
					^self
				].
			problem:: nil.
			tree:: done tree
		)
		public reinterpret: w = (
			(* Make w the source: reparse only what the edit damaged
(EmmanuelIncremental), or, when that will not do, all of it; then
interpret. *)
			
			| old = source. reparsed done |
			source:: w.
			failed ifTrue: [ ^interpret ].
			reparsed:: incremental reparse: nodes old: old new: w name: 'doc' host: host.
			reparsed isNil ifTrue: [ ^interpret ].
			done:: (emmanuel Machine host: host) interpret: reparsed
				root: rootBlock
				hostState: nil.
			done isKindOfDone ifFalse: [
					failed:: true.
					problem:: problemOf: source.
					^self
				].
			problem:: nil.
			nodes:: reparsed.
			tree:: done tree
		)
		removal: s = (
			(* The range of the source to delete to remove the statement s: with
the period that separates it from the next statement, or from the one before;
with its brackets when it is alone in them. *)
			
			| w = source. a = s span start. b = s span end. o ::= b. |
			(o < w size and: [ (w at: o + 1) = 46 ]) ifTrue: [
					o:: o + 1.
					[ o < w size and: [ isSpace: (w at: o + 1) ] ] whileTrue: [ o:: o + 1 ].
					^{a. o. }
				].
			o:: a - 1.
			[ o >= 0 and: [ isSpace: (w at: o + 1) ] ] whileTrue: [ o:: o - 1 ].
			(o >= 0 and: [ (w at: o + 1) = 46 ]) ifTrue: [ ^{o. b. } ].
			(a >= 2 and: [
					(w at: a - 1) = 91 and: [
							(w at: a) = 92 and: [
									b + 2 <= w size and: [ (w at: b + 1) = 92 and: [ (w at: b + 2) = 93 ] ]
								]
						]
				]) ifTrue: [ ^{a - 2. b + 2. } ].
			^{a. b. }
		)
		rootBlock = (
			(* The root block to interpret with: the root of the document's block
library, with its stylesheet, as its evaluator gives them. *)
			
			| r = library DocumentRoot new. |
			evaluator isNil ifFalse: [ r stylesheet: evaluator stylesheet ].
			^r
		)
		sectionChildPathOf: pt = (
			(* The path to the innermost block around the point pt whose parent
takes sections (the document, or a section), and whether pt is in its
heading: {path. inHeading}; nil when there is none. *)
			
			| tr ::= tree. path = List new. best ::= nil. |
			pt steps do: [:st |
					| child |
					st isField ifTrue: [
							^best isNil ifTrue: [ nil ]
								ifFalse: [
									{best. best size = path size and: [ tr state stateName = 'section' ]. }
								]
						].
					child:: (tr items at: st index + 1) ref.
					path add: st index.
					(tr state understands: 'section:') ifTrue: [ best:: path asArray ].
					tr:: child
				].
			^best isNil ifTrue: [ nil ] ifFalse: [ {best. false. } ]
		)
		public sourceOffsetAt: pt = (
			(* Sync: the offset (in code points) of the source of the point pt of
the view; nil when the source does not interpret, or the point has no offset. *)
			
			(failed or: [ pt isNil ]) ifTrue: [ ^nil ].
			^[
				edits sourceOffsetIn: image name: 'doc' document: {nodes. tree. } point: pt
			] on: Error do: [:e | nil ]
		)
		public sourceString = (
			^emmanuel stringOfCodePoints: source
		)
		splitAt: pt level: lv = (
			(* A new section between the two halves of the block at the level lv
of the path to the point pt, split there as Enter splits a paragraph; nil
when the edit layer refuses the split. *)
			
			| r s |
			r:: [
				edits edit: (edits split: (edits exact: pt) level: lv)
					image: image
					name: 'doc'
					document: {nodes. tree. }
					host: host
			] on: Error do: [:e | nil ].
			(r isNil or: [
					r isRefused or: [ r sourceName ~= 'doc' or: [ r caret isNil ] ]
				]) ifTrue: [ ^nil ].
			s:: Session source: (emmanuel stringOfCodePoints: r chars)
				evaluator: evaluator.
			^s openSectionAt: (s pointAtSourceOffset: r caret) splitting: false
		)
		textOffsetOf: tr = (
			(* An offset of the source where a caret shows the block tr: in its
heading, when it has one (a section); otherwise just after the message that
creates it, which is where its text starts. *)
			
			| fields = tr state fields: tr messages. |
			(fields isEmpty not and: [ fields first value isKindOfTreeValue ]) ifTrue: [
					^fields first value literal span start + 2
				].
			^tr messages first span end
		)
		treeAt: path = (
			| tr ::= tree. |
			path do: [:k | tr:: (tr items at: k + 1) ref ].
			^tr
		)
		unclosedOpenerIn: w = (
			(* The position of the innermost bracket of w that is never closed,
matching openers and closers as they come; nil when there is none. *)
			
			| open = List new. k ::= 1. |
			[ k < w size ] whileTrue: [
					((w at: k) = 91 and: [ (w at: k + 1) = 92 ]) ifTrue: [
							open add: k - 1.
							k:: k + 2
						]
						ifFalse: [
							((w at: k) = 92 and: [ (w at: k + 1) = 93 ]) ifTrue: [
									open isEmpty ifFalse: [ open removeLast ].
									k:: k + 2
								]
								ifFalse: [ k:: k + 1 ]
						]
				].
			open isEmpty ifTrue: [ ^nil ].
			^open last
		)
		wrap: first to: last in: a around: aligned = (
			(* The changes that put the blocks from first to last in an align: to
a: none for left when nothing around them aligns; nil when last is not
closed. *)
			
			(a = 'left' and: [ aligned not ]) ifTrue: [ ^nil ].
			(last flag = #closed or: [ last messages size = 1 ]) ifFalse: [ ^nil ].
			^{{last messages last span end. last messages last span end. emmanuel codePointsOf: '. endAlign'. }. {first messages first span start. first messages first span start. emmanuel codePointsOf: 'align: ''' , a , '''. '. }. }
		)
	) : ()
	public class ViewFragment session: s = Fragment new (
		(* A read-only rendering of a session's tree, for a document's viewer.
A refresh of the GUI makes a new one, which takes over the amplet results of
the one it replaces, runs them again and reconciles them (AmpletRunner>>
refresh), so that a presenter in an amplet keeps its state and shows its
changes, as in the editor and in Ampleforth documents. *)
		
		|
			public session = s.
		|
	) (
		public childrenDo: action = (
			(* The fragments its amplets show are this view's logical children,
so that Hopscotch's walks of the fragment tree (noticeExposure, refresh,
hasPendingChanges) reach what they show, a document's editor, say, as they
do in an Ampleforth document. *)
			
			session amplets fragmentsDo: action
		)
		createVisual = (
			| subject = blocks TreeSubject onModel: session tree. presenter result |
			subject amplets: session amplets.
			presenter:: subject presenter.
			presenter parent: self.
			session displayedIn: self.
			session amplets beginRender.
			result:: presenter visual.
			session amplets endRender.
			^result
		)
		public isKindOfEmmanuelViewFragment = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelViewFragment
		)
		updateVisualsFromSameKind: oldFragment = (
			oldFragment == self ifTrue: [
					session amplets refresh.
					^visual
				].
			session amplets adopt: oldFragment session amplets.
			session amplets refresh.
			^replaceVisual: oldFragment visual with: visual
		)
	) : ()
	public codeItem: selector code: code = (
		(* The item of a send of selector to an argument, the Newspeak code. *)
		
		^sendItem: selector
			argument: (hosts HostExpr ast: nil
				text: code
				literals: {}
				placeholder: false
				span: (emmanuel Span from: 0 to: 0))
	)
	public editorOn: source = (
		(* An editor of a source; computed arguments are an error. *)
		
		^editorOn: source evaluator: nil
	)
	public editorOn: source evaluator: ev = (
		^EditorFragment session: (Session source: source evaluator: ev)
	)
	public markupItem: selector text: u = (
		(* The item of a send of selector to a markup literal of the text u. *)
		
		| zero = emmanuel Span from: 0 to: 0. literal = emmanuel MarkupLiteral source: 'doc'
			nodes: {emmanuel FinalNode contents: (emmanuel codePointsOf: u) span: zero. }
			span: zero. |
		^sendItem: selector
			argument: (hosts HostExpr ast: nil
				text: ''
				literals: {literal. }
				placeholder: true
				span: zero)
	)
	public profile: source = (
		(* The time, in milliseconds, of each stage of a full pass over a
source: lexing, tokens, the structural parse, resolution (the host's
parsing of the brackets) with a fresh host and again with the same one,
interpretation, printing, and rendering. *)
		
		| w = emmanuel codePointsOf: source. host = hosts Host evaluator: nil. t lexed toks markup nodes done out |
		t:: clock now.
		lexed:: emmanuel lex: w.
		out:: 'lex ' , (clock now - t) printString.
		t:: clock now.
		toks:: emmanuel tokens: lexed located.
		out:: out , ', tokens ' , (clock now - t) printString.
		t:: clock now.
		emmanuel fastTokens: w.
		out:: out , ', fast tokens ' , (clock now - t) printString.
		t:: clock now.
		markup:: emmanuel parseMarkup: toks from: 1.
		out:: out , ', structure ' , (clock now - t) printString.
		t:: clock now.
		nodes:: emmanuel resolve: 'doc' nodes: (markup at: 1) host: host.
		out:: out , ', resolve ' , (clock now - t) printString.
		t:: clock now.
		emmanuel resolve: 'doc' nodes: (markup at: 1) host: host.
		out:: out , ', resolve again ' , (clock now - t) printString.
		t:: clock now.
		done:: (emmanuel Machine host: host) interpret: nodes
			root: blocks DocumentRoot new
			hostState: nil.
		out:: out , ', interpret ' , (clock now - t) printString.
		t:: clock now.
		emmanuel print: done tree source: w host: host.
		out:: out , ', print ' , (clock now - t) printString.
		t:: clock now.
		(blocks TreeSubject onModel: done tree) presenter visual.
		^out , ', render ' , (clock now - t) printString
	)
	sendItem: selector argument: e = (
		^emmanuel Item text: nil
			span: nil
			statement: (emmanuel SendStatement comments: {}
				selector: selector
				arguments: {e. }
				span: (emmanuel Span from: 0 to: 0))
	)
	public textItem: u = (
		^emmanuel Item text: (emmanuel codePointsOf: u)
			span: (emmanuel Span from: 0 to: 0)
			statement: nil
	)
	public unaryItem: selector = (
		^emmanuel Item text: nil span: nil statement: (blocks styleOpen: selector)
	)
	public viewOn: source evaluator: ev = (
		(* A read-only rendering of a source, as the editor shows it, its
amplets run by ev: a ViewFragment, or an error fragment when the source
does not interpret. For a document's viewer, which a transclusion
embeds. *)
		
		| session = Session source: source evaluator: ev. |
		session tree isNil ifTrue: [
				^blocks errorFragment: 'The source could not be interpreted'
			].
		^ViewFragment session: session
	)
) : ()
