Newspeak3
'Emmanuel'
class EmmanuelView usingPlatform: p emmanuel: EmmanuelClass newspeakHost: HostClass blocks: BlocksClass parsing: ParsingClass asts: ASTsClass = (
	(* A read-only rendering of Emmanuel sources, for use in an amplet:

  (EmmanuelView usingPlatform: platform
      emmanuel: Emmanuel
      newspeakHost: EmmanuelNewspeakHost
      blocks: EmmanuelBlocks
      parsing: NewspeakPredictiveParsing
      asts: NewspeakASTs)
          render: '[\paragraph\]Hello [\emphasis\]world[\endEmphasis. endParagraph\]'

answers a Hopscotch presenter of the document. The module classes it uses
are its factory's arguments: the Emmanuel core, the Newspeak host, the
block library, and the Newspeak parser and its ASTs. render:evaluator: also evaluates computed
arguments: the evaluator answers the value of evaluate: aString (a document,
for instance, so that they are evaluated in its scope), and runs the
amplets. Without one, computed arguments are an error, and amplets show
their code. *)
	
	|
		private emmanuel = EmmanuelClass usingPlatform: p.
		private parsing = ParsingClass usingPlatform: p
			asts: (ASTsClass usingPlatform: p).
		private hosts = HostClass usingPlatform: p emmanuel: emmanuel parsing: parsing.
		public blocks = BlocksClass usingPlatform: p emmanuel: emmanuel.
	|
) (
	describe: failure = (
		failure isKindOfLexFail ifTrue: [
				^'Lexical error at ' , failure error position printString
			].
		failure isKindOfSyntaxError ifTrue: [
				^'Syntax error at ' , failure span start printString , '-' , failure span end printString
			].
		^'The source could not be parsed'
	)
	public render: source = (
		^render: source evaluator: nil
	)
	public render: source evaluator: ev = (
		| host = hosts Host evaluator: ev. parsed result |
		parsed:: emmanuel parse: 'document'
			source: (emmanuel codePointsOf: source)
			host: host.
		(parsed isNil or: [ parsed isKindOfParsed not ]) ifTrue: [
				^blocks errorFragment: (describe: parsed)
			].
		result:: (emmanuel Machine host: host) interpret: parsed nodes
			root: blocks DocumentRoot new
			hostState: nil.
		result isKindOfRaised ifTrue: [
				^blocks errorFragment: 'An argument raised: ' , (emmanuel termStringOf: result exception)
			].
		^(blocks TreeSubject onModel: result tree) amplets: ((blocks AmpletRunner evaluator: ev) beginRender;
				yourself);
			presenter
	)
	public treeOf: source = (
		(* The tree of a source, without rendering it; for tests and debugging. *)
		
		^treeOf: source root: blocks DocumentRoot new
	)
	public treeOf: source root: root = (
		(* The tree of a source interpreted with the root block root, which
gives the stylesheet. *)
		
		| host = hosts Host evaluator: nil. parsed |
		parsed:: emmanuel parse: 'document'
			source: (emmanuel codePointsOf: source)
			host: host.
		(parsed isNil or: [ parsed isKindOfParsed not ]) ifTrue: [ ^parsed ].
		^(emmanuel Machine host: host) interpret: parsed nodes
			root: root
			hostState: nil
	)
) : ()
