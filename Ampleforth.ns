Newspeak3
'Ampleforth'
class Ampleforth usingPlatform: p ide: webIDE emmanuel: EmmanuelClass newspeakHost: HostClass blocks: BlocksClass edit: EditClass incremental: IncrementalClass parsing: ParsingClass asts: ASTsClass liveEditor: LiveEditorClass fromHTML: FromHTMLClass = (
	(* Ampleforth documents whose content is an Emmanuel source, beside the
HTML documents of Documents.ns, until those are converted and retired.

An EmmanuelDocument is a Document whose contents are its Emmanuel source.
Its editor shows the source in the raw view and the live editor
(AmpleforthEditor) in the live view, each updating the other, and the
document toolbar's commands operate on the source. It is saved as a zip
like an HTML document's, but its main file is NAME/NAME.ems, its class body
is NAME/NAME.class, and its media are those of its media registry.
Documents.ns loads such a zip (loadDocument:), and asks the document to
save itself (savesItsOwnFolder).

Documents makes this module on first use (Documents>>emmanuel), from the
Emmanuel modules in Root. *)
	
	|
		private Map = p collections Map.
		private Subject = p hopscotch Subject.
		private Presenter = p hopscotch Presenter.
		private Document = webIDE documents Document.
		private TwoViewEditorSubject = webIDE documents TwoViewEditorSubject.
		private ide = webIDE.
		private window = p js global.
		private editors = LiveEditorClass usingPlatform: p
			emmanuel: EmmanuelClass
			newspeakHost: HostClass
			blocks: BlocksClass
			edit: EditClass
			incremental: IncrementalClass
			parsing: ParsingClass
			asts: ASTsClass.
		private converter = FromHTMLClass usingPlatform: p
			emmanuel: (EmmanuelClass usingPlatform: p).
	|
) (
	lazy private JSObject = (* A host object: a lazy slot, so that a restore into a new host (Eurasia) looks it up again. *) window at: 'Object'.
	lazy private JSString = (* A host object: a lazy slot, so that a restore into a new host (Eurasia) looks it up again. *) window at: 'String'.
	public class EmmanuelDocument named: n contents: s = Document named: n
		contents: s (
		(* A document whose contents are its Emmanuel source. *)
		
		|
			private editor ::= nil.
		|
	) (
		public ampletExpressions = (
			(* The code of the document's amplets, each amplet: [code]: what a
save evaluates to find the documents the document transcludes, and reads
for the classes it uses, as an HTML document's amplets' names are. Found in
the source: each amplet: and the block after it, whose brackets balance,
string literals and comments skipped. *)
			
			| out = Map new. i |
			i:: contents indexOf: 'amplet:'.
			[ i > 0 ] whileTrue: [
					| open = blockOpeningAfter: i + 7. close |
					close:: open isNil ifTrue: [ nil ] ifFalse: [ blockClosingAfter: open ].
					close isNil ifTrue: [ i:: i + 7 ]
						ifFalse: [
							| code = contents copyFrom: open + 1 to: close - 1. |
							out at: code put: code.
							i:: close + 1
						].
					i:: i > contents size ifTrue: [ 0 ]
						ifFalse: [ contents indexOf: 'amplet:' startingAt: i ]
				].
			^out values
		)
		blockClosingAfter: open = (
			(* The index of the bracket that closes the one at open, or nil. *)
			
			| depth i c |
			depth:: 0.
			i:: open.
			[ i <= contents size ] whileTrue: [
					c:: contents copyFrom: i to: i.
					c = '''' ifTrue: [
							i:: contents indexOf: '''' startingAt: i + 1.
							i = 0 ifTrue: [ ^nil ]
						].
					(c = '(' and: [
							i < contents size and: [ (contents copyFrom: i + 1 to: i + 1) = '*' ]
						]) ifTrue: [
							i:: contents indexOf: '*)' startingAt: i + 2.
							i = 0 ifTrue: [ ^nil ].
							i:: i + 1
						].
					c = '[' ifTrue: [ depth:: depth + 1 ].
					c = ']' ifTrue: [
							depth:: depth - 1.
							depth = 0 ifTrue: [ ^i ]
						].
					i:: i + 1
				].
			^nil
		)
		blockOpeningAfter: start = (
			(* The index of the bracket opening the block after start, past
white space, or nil when something else comes first. *)
			
			| i c |
			i:: start.
			[ i <= contents size ] whileTrue: [
					c:: contents copyFrom: i to: i.
					c = '[' ifTrue: [ ^i ].
					({' '. String with: 9. String cr. String lf. } includes: c) ifFalse: [
							^nil
						].
					i:: i + 1
				].
			^nil
		)
		public blocks = (
			(* The block library the document is interpreted with: the shared
one. A template whose documents understand constructs of their own answers
a library of its own, an instance of its subclass of BlocksLibrary that
overrides the library's classes (newLibrary: makes it). *)
			
			^editors blocks
		)
		public BlocksLibrary = (
			(* The block library's class, which a template subclasses. *)
			
			^editors blocks moduleClass
		)
		classBodySource = (
			(* The class body, as the class file holds it: canonical, and not
encoded for HTML. *)
			
			| src = mirror getClass mixin declaration source. body = src copyFrom: (src indexOf: '(')
				to: src size. |
			^[ ide prettyPrinter prettyPrintClassBody: body ] on: Error do: [:e | body ]
		)
		public cloneButDontInstall: newName = (
			(* A copy of this document named newName, not bound in Root: an
Emmanuel document of a class of its own, with this one's class body, source,
and media (a Telescreen deck makes its new slides so, from its master
slide). *)
			
			| src = mirror getClass mixin declaration source. clone = documentNamed: newName
				source: contents
				classBody: (src copyFrom: (src indexOf: '(') to: src size). |
			mediaRegistry keysAndValuesDo: [:k :v | clone mediaRegistry at: k put: v ].
			^clone
		)
		public cloneSuperclass = (
			^'EmmanuelDocument'
		)
		public createFolderWithAncestors: ancestors = (
			(* The zip folder of the document: its source, its class body, its
media, and what the document's own class adds to contents/. *)
			
			| folder = ide webFiles Folder named: name. inner = folder addFolder: 'contents'. |
			folder addTextFile: name , '.ems' contents: contents.
			folder addTextFile: name , '.class' contents: classBodySource.
			mediaRegistry keysAndValuesDo: [:file :blob |
					(folder addFolder: (mediaFolderFor: blob)) file: file contents: blob
				].
			addContentsUsingFolder: inner.
			^folder
		)
		public isKindOfEmmanuelDocument = (
			^true
		)
		public liveEditor = (
			(* The live editor of the source, made when first needed. *)
			
			editor isNil ifTrue: [
					editor:: editors editorOn: contents evaluator: (Evaluator on: self)
				].
			^editor
		)
		mediaFolderFor: blob = (
			| type = blob at: #type. |
			(type isNil not and: [ (type indexOf: 'video') = 1 ]) ifTrue: [ ^'video' ].
			(type isNil not and: [ (type indexOf: 'audio') = 1 ]) ifTrue: [ ^'audio' ].
			^'images'
		)
		public mutateContentsTo: s <String> from: origin = (
			(* Set the source and publish it on contentsChanged. The live editor is
the document's own, so it is brought to the new source here, whoever wrote it
(a tool, a chat, an editor's raw view), unless it holds that source already,
as when it made the change itself. While no editor shows it, it shows the new
source when one next does. *)
			
			contents:: s.
			(editor isNil or: [ editor session sourceString = s ]) ifFalse: [
					editor source: s
				].
			contentsChanged send: {self. origin. }
		)
		public newLibrary: libraryClass = (
			(* A library of the class libraryClass, a template's subclass of
BlocksLibrary. *)
			
			^editors blocks newLibrary: libraryClass
		)
		public offersStyle: x = (
			(* Whether the document's vocabulary has the style x: the core
library's styles, and its stylesheet's. *)
			
			^({'emphasis'. 'strong'. 'strikethrough'. 'subscript'. 'superscript'. 'code'. } includes: x) or: [
					stylesheet isStyle: x
				]
		)
		public paperStylesheet = (
			(* The core library's semantic vocabulary only: a paper's. *)
			
			^editors blocks coreStylesheet
		)
		public savesItsOwnFolder = (
			^true
		)
		public slideStylesheet = (
			(* The default stylesheet's styles with a slide's looks: a slide's
(a master slide's, and so each slide made from it). *)
			
			^editors blocks slideStylesheet
		)
		public sourceFromLiveView: s = (
			sourceFromLiveView: s from: nil
		)
		public sourceFromLiveView: s from: origin = (
			(* The live editor changed the source. It is published on contentsChanged,
as an HTML document's edits are, so that the document's other presentations,
such as its viewer where another document transcludes it, show the change.
origin is the editor presenter the change was made in, or nil. The live
editor holds s already, so it is not brought to it (mutateContentsTo:from:
would compare it with s, at the cost of converting the whole source, at every
keystroke). *)
			
			s = contents ifTrue: [ ^self ].
			contents:: s.
			contentsChanged send: {self. origin. }
		)
		public sourceFromRawView: s = (
			sourceFromRawView: s from: nil
		)
		public sourceFromRawView: s from: origin = (
			(* The raw view changed the source: the live editor shows it
(mutateContentsTo:from:). While the source does not interpret, the editor
shows the last one that did, dimmed. It is published on contentsChanged, as
sourceFromLiveView: is. *)
			
			s = contents ifTrue: [ ^self ].
			mutateContentsTo: s from: origin
		)
		public Stylesheet = (
			(* A stylesheet, for templates that define their own: Stylesheet
styles: {...}. *)
			
			^editors blocks Stylesheet
		)
		public stylesheet = (
			(* The stylesheet the document is interpreted with: the styles it
offers beyond the core library's semantic ones. This, the default
template's, offers presentation (underline, color:, highlight:, align:); a
template overrides it in its class body, as a paper does with
paperStylesheet, or defines its own semantic styles with Stylesheet and
StyleSpec. *)
			
			^editors blocks defaultStylesheet
		)
		public StyleSpec = (
			(* A style of a stylesheet, for templates that define their own:
StyleSpec opener: 'warning' closer: 'endWarning' contentClass: #inline tag:
'span' presentation: [:p :args | p textColor: 'crimson']. *)
			
			^editors blocks StyleSpec
		)
		public twoViewEditorSubject = (
			^EmmanuelEditorSubject onModel: self
		)
		public viewerFragment = (
			(* The read-only rendering of the source, for the document's viewer
(Documents' DocumentViewerPresenter), which renders an HTML document's
contents as HTML. *)
			
			^editors viewOn: contents evaluator: (Evaluator on: self)
		)
	) : ()
	public class EmmanuelEditorPresenter onSubject: s = Presenter onSubject: s (
		(* The raw view, the source in a code editor, beside the live view, the
live editor; and the document toolbar's commands, as edits of the source. *)
		
		|
			private cm
			private live
			private rawView
			
			(* This presenter's outlet on the document's contentsChanged duct, so
that a change made elsewhere (a tool, a chat, another editor) is shown in the
raw view; the document brings the live view up to date itself. *)
			private contentsOutlet ::= nil.
			
			(* Set when a newer generation adopts this presenter's DOM: a retired
presenter must not update. *)
			public retired ::= false.
		|
	) (
		codePointIndexOf: u = (
			(* The offset in code points of the source of the UTF-16 index u,
which CodeMirror counts in. *)
			
			| cps = editor session source. n ::= 0. i ::= 0. |
			[ n < u and: [ i < cps size ] ] whileTrue: [
					n:: n + ((cps at: i + 1) > 65535 ifTrue: [ 2 ] ifFalse: [ 1 ]).
					i:: i + 1
				].
			^i
		)
		definition = (
			| doc = subject document. |
			detachContentsOutlet.
			contentsOutlet:: doc contentsChanged => [:packet |
				(retired or: [ (packet at: 2) == self ]) ifFalse: [
						[ cm text: doc contents ] on: Exception
							do: [:e |
								ide noteSwallowed: e in: 'updating an Emmanuel raw view'.
								nil
							]
					].
				nil
			].
			cm:: codeMirror: doc contents.
			
			(* The raw view's width is fixed, as the HTML editor's is: 40em, but at
most 45% of the window, so that the live view beside it always has more than
half. Its lines wrap to it; without a width it was as wide as its longest
line, and the live view was squeezed out. *)
			(cm visual at: #style) at: 'width' put: 'min(40em, 45vw)';
				at: 'min-width' put: '15em';
				at: 'flex' put: 'none'.
			cm changeResponse: [:ed :event |
					| incoming = ed textBeingAccepted. |
					incoming = doc contents ifFalse: [
							doc sourceFromRawView: incoming from: self
						].
					nil
				];
				acceptResponse: [:ed :event |
						| incoming = ed textBeingAccepted. |
						incoming = doc contents ifFalse: [
								doc sourceFromRawView: incoming from: self
							].
						nil
					].
			
			(* Elastic: a fragment of a row neither grows nor shrinks by default,
so the live view would be as wide as its longest line unwrapped, and the
window would scroll sideways; it takes the width the row has instead, and the
text wraps to it. *)
			live:: (holder: (wired: doc liveEditor)) elasticity: 1.
			rawView:: collapsed: [ nothing ] expanded: [ cm ].
			^row: {rawView. live. }
		)
		public detachContentsOutlet = (
			(* Remove this presenter's outlet from the document's contentsChanged
duct, so that a retired generation stops updating and the duct's outlets stay
bounded. *)
			
			contentsOutlet isNil ifTrue: [ ^self ].
			[ contentsOutlet detachFromAll ] on: Exception
				do: [:e |
					ide noteSwallowed: e in: 'detaching an Emmanuel editor outlet'.
					nil
				].
			contentsOutlet:: nil
		)
		editor = (
			^subject document liveEditor
		)
		public isFollowing = (
			^editor following == true
		)
		public isKindOfEmmanuelEditorPresenter = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelEditorPresenter
		)
		markInRawView: k jump: jump = (
			(* Show the offset k of the source in the raw view, and mark the word
there for a moment; on a jump, put the raw view's cursor there. *)
			
			| ed = cm editor. pos word options mark |
			ed isNil ifTrue: [ ^self ].
			pos:: ed posFromIndex: (utf16IndexOf: k).
			jump ifTrue: [
					ed focus.
					ed setCursor: pos
				].
			ed scrollIntoView: pos margin: 60.
			word:: ed findWordAt: pos.
			options:: JSObject new.
			options at: #css put: 'background-color: rgba(240, 170, 0, 0.45)'.
			mark:: ed markText: (word at: #anchor) to: (word at: #head) options: options.
			window setTimeout: [
					mark clear.
					nil
				]
				with: 900
		)
		public noticeExposure = (
			reclaimLiveEditor.
			wireSync.
			super noticeExposure
		)
		notYet: what = (
			window alert: what , ' is not in Emmanuel yet.'
		)
		rawOffsetOf: ev in: cmi jump: jump = (
			(* The offset in code points of the source in the raw view, the
CodeMirror cmi: where the event ev happened, on a jump; its cursor, while
following. *)
			
			| pos coords |
			jump ifTrue: [
					coords:: JSObject new.
					coords at: #left put: (ev at: #clientX);
						at: #top put: (ev at: #clientY).
					pos:: cmi coordsChar: coords mode: 'window'
				]
				ifFalse: [ pos:: cmi getCursor ].
			^codePointIndexOf: (cmi indexFromPos: pos)
		)
		reclaimLiveEditor = (
			(* The document has one live editor, which all its editor presenters
show, and a visual is in one place at a time: another presentation of the
document (a viewer that transcludes it, say) may have taken it since this
one was made. When this one is shown or updated, it takes the live editor
back, or its live view would be empty. *)
			
			| ed = editor. |
			(live isNil or: [ live hasVisual not ]) ifTrue: [ ^self ].
			(ed hasVisual and: [ live visual contains: ed visual ]) ifTrue: [ ^self ].
			ed parent: live.
			live visual appendChild: ed visual
		)
		replaceSelectionWithAmplet: code = (
			editor replaceSelectionWith: {editors codeItem: 'amplet:'
					code: '[' , code , ']'. }
				after: {}
		)
		respondToAlign: a = (
			(* Align the blocks at the selection to a: left, center, or right. *)
			
			| r = editor sourceAligning: a. src |
			r isNil ifTrue: [
					^window alert: 'Put the caret in, or select, paragraphs or other blocks of one section: a heading cannot be aligned on its own.'
				].
			src:: r at: 1.
			src = subject document contents ifTrue: [ ^self ].
			subject document sourceFromRawView: src from: self.
			cm text: src origin: 'liveview'.
			editor showSourceOffset: (r at: 2)
		)
		public respondToAlignLeft = (
			respondToAlign: 'left'
		)
		public respondToAlignRight = (
			respondToAlign: 'right'
		)
		public respondToCenter = (
			respondToAlign: 'center'
		)
		public respondToDefineIt = (
			| src = editor selectedText. support = TwoViewEditorSubject onModel: subject document. |
			updateGUI: [
					subject document addDefinitionFor: (support parseDefinition: src) from: src
				]
		)
		public respondToMakeAmplet = (
			replaceSelectionWithAmplet: editor selectedText
		)
		public respondToMakeBold = (
			editor styleSelection: 'strong'
		)
		public respondToMakeButton = (
			replaceSelectionWithAmplet: 'makeDoItButton: ' , (stringLiteral: editor selectedText)
		)
		public respondToMakeHeading: tagName = (
			(* A section, with the selection as its heading. *)
			
			| heading = editor selectedText. |
			editor replaceSelectionWith: {editors markupItem: 'section:'
					text: (heading isEmpty ifTrue: [ 'Heading' ] ifFalse: [ heading ]). editors unaryItem: 'paragraph'. }
				after: {editors unaryItem: 'endParagraph'. editors unaryItem: 'endSection'. }
		)
		public respondToMakeItalic = (
			editor styleSelection: 'emphasis'
		)
		public respondToMakeLink = (
			| url = window prompt: 'Link to:' with: 'https://'. text = editor selectedText. |
			(url isNil or: [ url isEmpty ]) ifTrue: [ ^self ].
			editor replaceSelectionWith: {editors codeItem: 'link:'
					code: (stringLiteral: url). editors textItem: (text isEmpty ifTrue: [ url ]
						ifFalse: [ text ]). }
				after: {editors unaryItem: 'endLink'. }
		)
		public respondToMakeList = (
			respondToMakeListOpening: 'list' closing: 'endList'
		)
		respondToMakeListOpening: opener closing: closer = (
			editor replaceSelectionWith: {editors unaryItem: opener. editors unaryItem: 'item'. editors unaryItem: 'paragraph'. editors textItem: editor selectedText. }
				after: {editors unaryItem: 'endParagraph'. editors unaryItem: 'endItem'. editors unaryItem: closer. }
		)
		public respondToMakeOrderedList = (
			respondToMakeListOpening: 'numberedList' closing: 'endNumberedList'
		)
		public respondToMakeSubscript = (
			editor styleSelection: 'subscript'
		)
		public respondToMakeSuperscript = (
			editor styleSelection: 'superscript'
		)
		public respondToSetPage: p = (
			(* Lay the document out for the page p (#screen, #letter, #a4,
#slide): its page: statement, rewritten or added. *)
			
			| src = subject document liveEditor sourceWithPage: p. |
			src isNil ifTrue: [ ^self ].
			subject document sourceFromRawView: src from: self.
			cm text: src origin: 'liveview'
		)
		public respondToShowIt = (
			replaceSelectionWithAmplet: 'label: (evaluate: ' , (stringLiteral: editor selectedText) , ') result reflectee printString'
		)
		public respondToStrikethrough = (
			editor styleSelection: 'strikethrough'
		)
		public respondToUnderline = (
			editor styleSelection: 'underline'
		)
		showInRawView: k jump: jump = (
			(* Show the offset k of the source in the raw view: on a jump, opening
the raw view if it is closed; while following, only when it is open. *)
			
			rawView isExpanded ifTrue: [ ^markInRawView: k jump: jump ].
			jump ifFalse: [ ^self ].
			rawView expand.
			window setTimeout: [
					markInRawView: k jump: jump.
					nil
				]
				with: 50
		)
		stringLiteral: s = (
			^'''' , ((JSString new: s) replaceAll: '''' with: '''''') , ''''
		)
		public syncFrom: ev jump: jump = (
			(* The sync between the two views (issue #114), for the event ev in
this presenter's view. A jump, Cmd-click (Ctrl-click elsewhere) in either
view, puts the other's caret at the same place and shows it there; while
following, a click or a key in either view shows the place of its caret in
the other. *)
			
			| target = ev at: #target. ed = editor. cmElement k |
			jump ifTrue: [
					(((ev at: #metaKey) or: [ ev at: #ctrlKey ]) and: [ (ev at: #shiftKey) not ]) ifFalse: [
							^self
						]
				]
				ifFalse: [ isFollowing ifFalse: [ ^self ] ].
			cmElement:: target closest: '.CodeMirror'.
			cmElement isNil ifFalse: [
					k:: rawOffsetOf: ev in: (cmElement at: #CodeMirror) jump: jump.
					jump ifFalse: [ ^ed revealSourceOffset: k ].
					ev preventDefault.
					ev stopPropagation.
					^ed showSourceOffset: k
				].
			(ed hasVisual and: [ ed visual contains: target ]) ifFalse: [ ^self ].
			jump ifFalse: [
					k:: ed sourceOffsetOfSelection.
					k isNil ifFalse: [ showInRawView: k jump: false ].
					^self
				].
			ev preventDefault.
			k:: ed sourceOffsetAtX: (ev at: #clientX) y: (ev at: #clientY).
			k isNil ifFalse: [ showInRawView: k jump: true ]
		)
		public toggleFollowing = (
			(* Follow the caret between the views, or stop; following opens the
raw view. *)
			
			editor following: isFollowing not.
			(isFollowing and: [ rawView isExpanded not ]) ifTrue: [ rawView expand ]
		)
		public toggleRawView = (
			rawView toggle
		)
		updateVisualsFromSameKind: oldPresenter = (
			(* A newer generation is adopting the old one's DOM: retire the old one
and detach its contentsChanged outlet, so that only the live generation
updates. *)
			
			| result = super updateVisualsFromSameKind: oldPresenter. |
			oldPresenter retired: true.
			oldPresenter detachContentsOutlet.
			reclaimLiveEditor.
			^result
		)
		utf16IndexOf: k = (
			(* The UTF-16 index, which CodeMirror counts in, of the offset k in
code points of the source. *)
			
			| cps = editor session source. n ::= 0. |
			1 to: (k min: cps size)
				do: [:i | n:: n + ((cps at: i) > 65535 ifTrue: [ 2 ] ifFalse: [ 1 ]) ].
			^n
		)
		wired: liveEditor = (
			(* The live editor, its changes copied to the document and the raw view;
this presenter syncs it with the raw view. *)
			
			liveEditor syncPresenter: self.
			liveEditor session changeHandler: [:src |
					subject document sourceFromLiveView: src from: self.
					cm text: src origin: 'liveview'.
					nil
				].
			^liveEditor
		)
		wireSync = (
			(* Listen, once for each element this presenter's view is in, for the
events of the sync between the views. The generations of presenters that
adopt the element come and go; the listeners act through the presenter that
shows the document's live editor now, when the element holds it. *)
			
			| v ed handler |
			hasVisual ifFalse: [ ^self ].
			v:: visual.
			(v at: #emmanuelSync) == true ifTrue: [ ^self ].
			v at: #emmanuelSync put: true.
			ed:: editor.
			handler:: [:ev :jump |
				| p = ed syncPresenter. |
				(p isNil not and: [ ed hasVisual and: [ v contains: ed visual ] ]) ifTrue: [
						[ p syncFrom: ev jump: jump ] on: Error
							do: [:e |
								ide noteSwallowed: e in: 'syncing an Emmanuel document''s views'.
								nil
							]
					].
				nil
			].
			v addEventListener: 'mousedown'
				action: [:ev | handler value: ev value: true ]
				options: true.
			v addEventListener: 'mouseup' action: [:ev | handler value: ev value: false ].
			v addEventListener: 'keyup' action: [:ev | handler value: ev value: false ]
		)
	) : ()
	public class EmmanuelEditorSubject onModel: doc = Subject onModel: doc (
		(* The subject of an Emmanuel document's editor. *)
		
	) (
		createPresenter = (
			^EmmanuelEditorPresenter onSubject: self
		)
		public document = (
			^model
		)
		public isKindOfEmmanuelEditorSubject = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelEditorSubject
		)
	) : ()
	class Evaluator on: d = (
		(* Evaluates a source's computed arguments and amplets in the
document's scope: the value of the code. *)
		
		|
			private document = d.
		|
	) (
		lazy private imageURLs = Map new.
		public addMedia: file named: name = (
			(* Add the file to the document's media, under name. *)
			
			document mediaRegistry at: name put: file
		)
		public blocks = (
			(* The document's block library (its template's). *)
			
			^document blocks
		)
		public displayedIn: fragment = (
			(* An editor or a viewer, fragment, shows the document: it becomes the
document's parent, through which the document's code reaches the shell. *)
			
			document parent: fragment
		)
		public evaluate: code = (
			| t = document evaluate: code. |
			t isBroken ifTrue: [ ^Error signal: t result reflectee printString ].
			^t result reflectee
		)
		public stylesheet = (
			(* The document's stylesheet (its template's). *)
			
			^document stylesheet
		)
		public urlOfImage: name = (
			(* The URL of the image name: a URL of the document's image of that
name, made once; when it has none, name itself, as a URL. *)
			
			| blob = document mediaRegistry at: name ifAbsent: [ nil ]. |
			blob isNil ifTrue: [ ^name ].
			^imageURLs at: name
				ifAbsent: [
					imageURLs at: name put: ((window at: #URL) createObjectURL: blob)
				]
		)
	) : ()
	classBody: body withStylesheet: expression = (
		(* The class body with a stylesheet method answering expression first
on its instance side: after the header's balanced parentheses (string
literals and comments skipped) and the parenthesis that opens the instance
side. A class body that defines a stylesheet already is left as it is.
The body's characters are compared as bytes (String at: answers one):
40 and 41 are parentheses, 42 an asterisk, 39 a quote. *)
		
		| n = body size. i ::= body indexOf: '('. depth ::= 0. c j |
		(includes: 'stylesheet =' in: body) ifTrue: [ ^body ].
		[ i <= n ] whileTrue: [
				c:: body at: i.
				(c = 40 and: [ i < n and: [ (body at: i + 1) = 42 ] ]) ifTrue: [
						i:: i + 2.
						[ i < n and: [ ((body at: i) = 42 and: [ (body at: i + 1) = 41 ]) not ] ] whileTrue: [
								i:: i + 1
							].
						i:: i + 2
					]
					ifFalse: [
						c = 39 ifTrue: [
								i:: i + 1.
								[ i <= n and: [ ((body at: i) = 39) not ] ] whileTrue: [ i:: i + 1 ].
								i:: i + 1
							]
							ifFalse: [
								c = 40 ifTrue: [ depth:: depth + 1 ].
								(c = 41 and: [ (depth:: depth - 1) = 0 ]) ifTrue: [
										j:: i + 1.
										[ j <= n and: [ ((body at: j) = 40) not ] ] whileTrue: [ j:: j + 1 ].
										j > n ifTrue: [ ^body ].
										^(body copyFrom: 1 to: j) , ' public stylesheet = ( ^' , expression , ' ) ' , (body copyFrom: j + 1
											to: n)
									].
								i:: i + 1
							]
					]
			].
		^body
	)
	public convert: doc = (
		(* An Emmanuel document converted from the HTML document doc: its body
converted (EmmanuelFromHTML), with doc's class body and media; named
doc's name followed by Emmanuel, and bound in Root. When the conversion
gives looks (a centered title), the class body gets a stylesheet method
that adds them to the document's stylesheet. *)
		
		| n = (doc name , 'Emmanuel') asSymbol. conversion = converter convertDocument: (converter fromHTML: doc contents). src = doc mirror getClass mixin declaration source. body ::= src copyFrom: (src indexOf: '(')
			to: src size. new |
		conversion looksSource isNil ifFalse: [
				body:: classBody: body
					withStylesheet: 'super stylesheet withLooks: ' , conversion looksSource
			].
		new:: documentNamed: n source: conversion source classBody: body.
		doc mediaRegistry keysAndValuesDo: [:k :v | new mediaRegistry at: k put: v ].
		ide namespacing Root at: n put: new.
		^new
	)
	public documentNamed: n source: source classBody: body = (
		(* A new Emmanuel document, of a class of its own made from body. *)
		
		^(ide documents createDocumentSubclassNamed: n
			body: body
			superclass: 'EmmanuelDocument') contents: source
	)
	public freshDocumentNamed: n = (
		^freshDocumentNamed: n template: #default
	)
	public freshDocumentNamed: n template: t = (
		(* A new document of the template t: #default, whose stylesheet offers
presentation, or #paper, whose class body restricts it to the core
library's semantic vocabulary. *)
		
		^documentNamed: n
			source: '[\title: [\' , n , '\]\][\paragraph\]Start writing here.[\endParagraph\]'
			classBody: (t = #paper ifTrue: [
					'()(public stylesheet = ( ^paperStylesheet ))'
				]
				ifFalse: [ '()()' ])
	)
	includes: needle in: haystack = (
		(* Whether the string haystack holds needle. *)
		
		1 to: haystack size - needle size + 1
			do: [:k |
				(haystack copyFrom: k to: k + needle size - 1) = needle ifTrue: [ ^true ]
			].
		^false
	)
	public templates = (
		(* The templates a new document can have. *)
		
		^{#default. #paper. }
	)
) : ()
