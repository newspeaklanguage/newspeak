Newspeak3
'Emmanuel'
class EmmanuelViewTesting usingPlatform: p minitest: m view: v = (
	(* Headless tests of the block library (EmmanuelBlocks) through
EmmanuelView's treeOf:, with the Newspeak host: the trees that real sources
give. Rendering needs a browser and is checked in the IDE. *)
	
	|
		private TestContext = m TestContext.
		private view = v.
	|
) (
	public class LibraryTests new = TestContext new (
	) (
		kinds: tree = (
			^tree items collect: [:g | g kind ]
		)
		root: source = (
			| done = view treeOf: source. |
			assert: done isKindOfDone.
			^done tree
		)
		stateOf: g = (
			^g ref state
		)
		public test_codeBlockAndVerbatimAreLeaves = (
			| tr = root: '[\codeBlock: ''x := 1'' language: #smalltalk. verbatim: ''a  b''\]'. |
			assert: tr items size equals: 2.
			assert: (stateOf: tr items first) stateName equals: 'codeBlock'.
			assert: (stateOf: tr items first) language equals: 'smalltalk'.
			assert: (stateOf: tr items last) text equals: 'a  b'
		)
		public test_emphasisOutsideAParagraphIsNotUnderstood = (
			| tr = root: '[\emphasis\]'. |
			assert: tr items first kind equals: #dnu
		)
		public test_labelOnceThenRefused = (
			| tr = root: '[\section: [\A\]. label: #a. label: #b. endSection\]'. section = tr items first ref. |
			assert: section state label equals: 'a'.
			assert: (section items anySatisfy: [:g | g kind = #refused ])
		)
		public test_paragraphWithEmphasis = (
			| tr = root: '[\paragraph\] Hi [\emphasis\]all[\endEmphasis. endParagraph\]'. para = tr items first ref. |
			assert: tr items size equals: 1.
			assert: para state stateName equals: 'para'.
			assert: (kinds: para) asArray first equals: #run.
			assert: para items first chars size equals: 3.
			assert: (stateOf: para items last) stateName equals: 'emph'.
			assert: tr flag equals: #closed
		)
		public test_sectionsNestWithDepth = (
			| tr = root: '[\section: [\One\]. section: ''Two''. endSection. endSection\]'. top = tr items first ref. inner = top items first ref. |
			assert: top state depth equals: 1.
			assert: inner state depth equals: 2.
			assert: inner state heading equals: 'Two'.
			assert: top state heading isKindOfTreeValue
		)
		public test_titleTakesAnInlineLiteral = (
			| tr = root: '[\title: [\The [\emphasis\]Play[\endEmphasis\]\]\]'. title = tr state title. |
			assert: title isKindOfTreeValue.
			assert: title tree items size equals: 2.
			assert: tr items first kind equals: #mut
		)
		public test_titleTwiceIsRefused = (
			| tr = root: '[\title: ''A''. title: ''B''\]'. |
			assert: tr state title equals: 'A'.
			assert: tr items last kind equals: #refused
		)
		public test_unclosedParagraphIsFlagged = (
			| tr = root: '[\paragraph\]abc'. |
			assert: tr items first ref flag equals: #unclosed
		)
	) : (
		TEST_CONTEXT = (
		)
	)
) : ()
