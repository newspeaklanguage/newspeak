Newspeak3
'Emmanuel'
class EmmanuelNewspeakHostTesting usingPlatform: p minitest: m emmanuel: em host: hostModule = (
	(* Tests of EmmanuelNewspeakHost, the Newspeak instance of the host:
parsing brackets with the predictive parser, mapping positions back to the
source, comments, syntax errors, evaluation of literal arguments, and
printing. *)
	
	|
		private TestContext = m TestContext.
		private emmanuel = em.
		private hosts = hostModule.
	|
) (
	public class HostTests new = TestContext new (
		|
			host = hosts Host evaluator: nil.
		|
	) (
		agree: source = (
			(* fastTokens: answers the reference's tokens, or nil where the
reference fails. *)
			
			| w = emmanuel codePointsOf: source. lexed = emmanuel lex: w. fast = emmanuel fastTokens: w. reference |
			(lexed isNil or: [ lexed isKindOfLexError ]) ifTrue: [ ^fast isNil ].
			reference:: emmanuel tokens: lexed located.
			fast isNil ifTrue: [ ^false ].
			fast size = reference size ifFalse: [ ^false ].
			1 to: fast size
				do: [:i |
					(emmanuel termStringOf: (fast at: i)) = (emmanuel termStringOf: (reference at: i)) ifFalse: [
							^false
						]
				].
			^true
		)
		nodesOf: source = (
			| parsed = emmanuel parse: 'doc'
				source: (emmanuel codePointsOf: source)
				host: host. |
			assert: parsed isKindOfParsed.
			^parsed nodes
		)
		statementsOf: source = (
			^(nodesOf: source) first statements
		)
		public test_argumentSpans = (
			| src = '[\codeBlock: ''x := 1'' language: #newspeak. title: [\A\]\]'. ss = statementsOf: src. |
			assert: (text: (host argSpan: ss first index: 0) of: src)
				equals: '''x := 1'''.
			assert: (text: (host argSpan: ss first index: 1) of: src) equals: '#newspeak'.
			assert: (text: (host argSpan: ss last index: 0) of: src) equals: '[\A\]'
		)
		public test_blockLiteralIsAClosureThatHasNotRun = (
			| s = (statementsOf: '[\amplet: [section: ''X'' titled: ''Y'']\]') first. v |
			v:: (host eval: s arguments first hostState: nil) value.
			assert: v isKindOfEmmanuelClosure.
			assert: v code equals: '[section: ''X'' titled: ''Y'']'
		)
		public test_commentAfterLastStatementIsAStatement = (
			| src = '[\paragraph (* c *)\]'. ss = statementsOf: src. |
			assert: ss size equals: 2.
			assert: ss last isComment.
			assert: (text: ss last span of: src) equals: '(* c *)'
		)
		public test_commentBelongsToTheNextStatement = (
			| src = '[\(* n *) paragraph\]'. s = (statementsOf: src) first. |
			assert: s comments size equals: 1.
			assert: (text: s comments first of: src) equals: '(* n *)'.
			assert: (text: s span of: src) equals: 'paragraph'
		)
		public test_computedArgumentRaisesWithoutAnEvaluator = (
			| s = (statementsOf: '[\section: self intro\]') first. |
			assert: (host eval: s arguments first hostState: nil) isKindOfRaised
		)
		public test_fastTokensAgreeWithTheReference = (
			{''. 'plain text'. '[\paragraph\]Hello[\endParagraph\]'. 'a \\ b \[ c \x'. '[\title: [\The [\emphasis\]Play[\endEmphasis\]\]. author: ''Ham''\]'. '[\verbatim: ''x \] [\ y''. html: ''<b>''\]'. '[\(* a comment \] (* nested *) *) paragraph\]x'. '[\amplet: [section: ''X'' titled: ''Y'']\]é ü [\code\]z[\endCode\]'. 'x\]'. '[\unclosed'. '[\s: ''open\]'. '[\s: (* open \]'. '[\title: [\x\]'. '\'. 'end\\'. } do: [:s |
					assert: (agree: s) description: s
				]
		)
		public test_literalArgumentsEvaluateToThemselves = (
			| s = (statementsOf: '[\codeBlock: ''x := 1'' language: #smalltalk\]') first. |
			assert: s selector equals: 'codeBlock:language:'.
			assert: (host eval: s arguments first hostState: nil) value equals: 'x := 1'.
			assert: (host eval: s arguments last hostState: nil) value equals: #smalltalk
		)
		public test_markupLiteralIsAPlaceholder = (
			| src = '[\title: [\Ham[\emphasis\]let[\endEmphasis\]\]\]'. s = (statementsOf: src) first. literal |
			assert: s selector equals: 'title:'.
			assert: s arguments first lits size equals: 1.
			literal:: (host eval: s arguments first hostState: nil) value.
			assert: literal isKindOfMarkupLiteral.
			assert: (text: literal span of: src)
				equals: '[\Ham[\emphasis\]let[\endEmphasis\]\]'.
			assert: literal nodes size equals: 2.
			assert: (text: s span of: src)
				equals: 'title: [\Ham[\emphasis\]let[\endEmphasis\]\]'
		)
		public test_nonAsciiPositionsAreCharacters = (
			| src = '[\title: ''é''. paragraph\]'. ss = statementsOf: src. |
			assert: ss size equals: 2.
			assert: (text: ss first span of: src) equals: 'title: ''é'''.
			assert: (text: ss last span of: src) equals: 'paragraph'
		)
		public test_printingIsVerbatim = (
			| src = '[\(* n *)  paragraph.   emphasis\]Hi[\endEmphasis\]'. w = emmanuel codePointsOf: src. nodes = nodesOf: src. printed |
			printed:: emmanuel show: (host print: nodes first statements source: w)
				source: w
				host: host.
			assert: (emmanuel stringOfCodePoints: printed)
				equals: '(* n *) paragraph. emphasis'
		)
		public test_sendToAnotherReceiverIsASyntaxError = (
			| parsed = emmanuel parse: 'doc'
				source: (emmanuel codePointsOf: 'a[\x y\]')
				host: host. |
			assert: parsed isKindOfSyntaxError
		)
		public test_sourcelessKeywordSendsPrint = (
			| w = emmanuel codePointsOf: 'x'. zero = emmanuel Span from: 0 to: 0. literal = emmanuel MarkupLiteral source: 'doc'
				nodes: {emmanuel FinalNode contents: (emmanuel codePointsOf: 'A [ b')
					span: zero. }
				span: zero. section = emmanuel SendStatement comments: {}
				selector: 'section:'
				arguments: {hosts HostExpr ast: nil
					text: ''
					literals: {literal. }
					placeholder: true
					span: zero. }
				span: zero. link = emmanuel SendStatement comments: {}
				selector: 'link:'
				arguments: {hosts HostExpr ast: nil
					text: '''http://x'''
					literals: {}
					placeholder: false
					span: zero. }
				span: zero. printed |
			printed:: emmanuel show: (host print: {section. link. } source: w)
				source: w
				host: host.
			assert: (emmanuel stringOfCodePoints: printed)
				equals: 'section: [\A \[ b\]. link: ''http://x'''
		)
		public test_sourcelessSendsPrintTheirSelectors = (
			| w = emmanuel codePointsOf: 'x'. s = emmanuel SendStatement comments: {}
				selector: 'endStrong'
				arguments: {}
				span: (emmanuel Span from: 0 to: 0). printed |
			printed:: emmanuel show: (host print: {s. s. } source: w)
				source: w
				host: host.
			assert: (emmanuel stringOfCodePoints: printed) equals: 'endStrong. endStrong'
		)
		public test_stringLiterals = (
			| ss = statementsOf: '[\section: ''a''. section: #b. section: [\c\]. section: self d\]'. |
			assert: (host isStringLiteral: (ss at: 1) index: 0).
			assert: (host isStringLiteral: (ss at: 2) index: 0).
			deny: (host isStringLiteral: (ss at: 3) index: 0).
			deny: (host isStringLiteral: (ss at: 4) index: 0).
			assert: (emmanuel stringOfCodePoints: (host encode: (emmanuel codePointsOf: 'it''s')))
				equals: '''it''''s'''
		)
		public test_syntaxErrorFails = (
			| parsed = emmanuel parse: 'doc'
				source: (emmanuel codePointsOf: '[\foo: \]')
				host: host. |
			assert: parsed isKindOfSyntaxError
		)
		public test_unarySend = (
			| src = 'x[\paragraph\]Hi'. nodes = nodesOf: src. s = nodes first statements first. |
			assert: nodes size equals: 2.
			assert: s selector equals: 'paragraph'.
			assert: s span start equals: 3.
			assert: s span end equals: 12
		)
		text: span of: source = (
			^emmanuel stringOfCodePoints: (emmanuel slice: (emmanuel codePointsOf: source)
					span: span)
		)
	) : (
		TEST_CONTEXT = (
		)
	)
) : ()
