Newspeak3
'Newspeak'
class AIAccess usingPlatform: platform = Object new (
	(* Provides AI model access from Newspeak. Supports multiple providers
 via the Provider abstraction. Manages multi-turn conversations with
 tool use (function calling), enabling an AI to query the IDE and vice versa.

 Usage:
   | ai provider session |
   ai:: AIAccess usingPlatform: platform.
   provider:: ai AnthropicProvider apiKey: 'sk-...' model: 'claude-sonnet-4-20250514'.
   session:: ai Session provider: provider tools: {}.
   session systemPrompt:: 'You are a Newspeak programming assistant.'.
   (session sendMessage: 'What is Newspeak?') then: [:reply | transcript show: reply]. *)
	
	(* Only class-imports and the platform handle go in the slot block —
   they must be safe at AIAccess-construction time, which now happens
   during platform construction (Hopscotch reads `p aiAccess` from its
   slot block). The JS-side handles (global, JSON, Promise) are forced
   lazily at module body, so they're only fetched on first actual API
   call — well after primordialsoup snapshot creation, when JS aliens
   are live. *)
	
	|
		private js = platform js.
		private List = platform collections List.
		private Map = platform collections Map.
		
		(* The platform host module (HOST_SERVICES_DESIGN_2026-08-31.md), nil on
   platforms without one - the guard keeps Croquet and older platforms
   constructing. Safe at snapshot time: Host's initializer touches no JS
   values, and its discovery is lazy. *)
		private hostModule = [ platform host ] on: Exception do: [:e | nil ].
		private nsHostToken <String | UndefinedObject>
	|
) (
	public class Tool name: n <String> description: d <String> inputSchema: s <String> handler: h <[:Alien | Object]> = Object new (
		(* A function-callable tool the AI can invoke during a session. The Session
 carries a List[Tool] and translates these into the provider's native
 tool-declaration shape via buildToolsPayload: for each turn.

   name        a stable identifier the model uses to call the tool;
               typically snake_case (e.g. 'get_class_source').
   description prose shown to the model so it understands when to call.
   inputSchema a JSON-Schema *string* describing the tool's arguments.
               Parsed via JSON.parse at translation time. Use a string
               (not a parsed object) so it can be authored as a literal.
   handler     a one-arg block invoked with the parsed input alien (a JS
               object matching inputSchema). May return a String (textual
               tool result), a value whose printString is the result, or
               an Alien[Promise] that resolves to either. May raise; the
               raise is converted to an is_error tool_result. *)
		
		|
			public name <String> = n.
			public description <String> = d.
			public inputSchema <String> = s.
			public handler <[:Alien | Object]> = h.
		|
	) (
	) : ()
	public class Provider new = Object new (
		(* Abstract base for AI providers (Anthropic, Gemini, etc.). Each provider
 owns BOTH the wire protocol (complete:) AND the internal shape of
 conversation history:

   addUserText:toMessages:           append a user-role message
   appendAssistantResponse:          append an assistant-role message
                                     from a complete:-resolved response
   messagesAsRequestPayload:         turn the history into the request
                                     payload that complete: ships
   extractTextFromResponse:          pull plain text out of a response
                                     for the UI's send-promise value
   displayMessagesFromMessages:      translate the history to neutral
                                     {role, text} tuples for the UI

 Session is a thin coordinator that delegates all shape-y work to the
 provider via these methods; it never inspects message internals or
 response internals directly. Adding a new provider therefore means
 implementing this interface against the provider's native shape — the
 Session is provider-agnostic.

 Tool-use support is optional. Providers that don't translate tools
 inherit hasToolUse: ^false and the tool-loop is skipped. Providers
 that do support tools also implement toolUseBlocksFrom:,
 makeToolResult:textResult:media:isError:, buildToolsPayload:, and
 addToolResults:toMessages: (which folds the per-call tool-result
 outcomes into one or more messages in the provider's native shape). *)
		
	) (
		public complete: messages <Alien[Array]> system: systemPrompt <String> tools: tools <Alien[Array] | UndefinedObject> maxTokens: maxTokens <Integer> ^<Alien[Promise]> = (
			(* Ship the request to the provider's API and return a Promise that
	   resolves to the *parsed* response body (whatever native shape the
	   provider returns; the parsing-and-resolving discipline is per
	   provider). The Promise rejects with a String reason on HTTP error
	   or other API failure — rejection MUST be via Promise.reject from
	   inside any then: closure, never via Newspeak Error signal:, to
	   avoid corrupting primordialsoup's JS-Promise alien bridge.
	   messages is whatever the provider's messagesAsRequestPayload:
	   produces. tools is whatever the provider's buildToolsPayload:
	   produces, or nil if no tools / no tool support. *)
			
			subclassResponsibility
		)
		public addUserText: text <String> toMessages: messages <List> = (
			(* Append a user-role message carrying the given text, in the
	   provider's native shape. Returns self. *)
			
			subclassResponsibility
		)
		public appendAssistantResponse: response <Alien> toMessages: messages <List> = (
			(* Given the parsed response from complete:, append an assistant-role
	   entry to the history in the provider's native shape. May raise
	   (within a Session.completeWithToolLoop on:Exception backstop) if
	   the response has no usable content — preferred to silently storing
	   a half-formed entry that poisons subsequent turns. *)
			
			subclassResponsibility
		)
		public messagesAsRequestPayload: messages <List> ^<Alien[Array]> = (
			(* Convert the message history into the JS array that complete: will
	   carry as the request payload. Most providers just JSArray-ify
	   their stored messages, since they're already in native shape. *)
			
			subclassResponsibility
		)
		public extractTextFromResponse: response <Alien> ^<String> = (
			(* Extract the assistant's text from the response, for the user-facing
	   send-promise's resolution value. Should NOT raise on malformed
	   responses (return '' instead); appendAssistantResponse: is where
	   shape validation belongs. *)
			
			subclassResponsibility
		)
		public displayMessagesFromMessages: messages <List> ^<List> = (
			(* Walk the history producing {role <String>, text <String>} tuples
	   for UI rendering. Role is always 'user' or 'assistant' (translate
	   native role names like Gemini's 'model'). Skip entries with no
	   display text (tool results, empty turns). *)
			
			subclassResponsibility
		)
		public hasToolUse: response <Alien> ^<Boolean> = (
			(* True if the response asks us to call one or more tools. Providers
	   without tool-use translation inherit this default of false and the
	   tool loop is bypassed. *)
			
			^false
		)
		public toolUseBlocksFrom: response <Alien> ^<List> = (
			(* Only called when hasToolUse: returns true. Returns a List of
	   provider-native tool-call records (each with at minimum 'id',
	   'name', 'input' fields the Session can hand to executeToolCall:).
	   Providers that support tool use override; others may leave as
	   subclassResponsibility since hasToolUse:'s default prevents the
	   call. *)
			
			subclassResponsibility
		)
		public makeToolResult: id <String> textResult: text <String> media: mediaParts <Alien[Array]> isError: err <Boolean> ^<Object> = (
			(* Build a tool-result outcome in the provider's native shape. The
	   return value is opaque to Session — only this provider's
	   addToolResults:toMessages: knows how to fold it into the message
	   stream. Returning a structured object (rather than a single block
	   or part) lets providers that need to split media across multiple
	   parts or messages (Gemini, OpenAI-compatible) do so without
	   leaking through Session.

	   text is the textual tool result (never empty by the time this is
	   called — Session substitutes 'See attached' when the handler
	   produces only media). mediaParts is a JS array of canonical media
	   objects: each has {mimeType <String>, dataBase64 <String>, name
	   <String> (optional)}. Providers translate to their native
	   image/document/audio/video shape; items with a MIME type the
	   provider can't carry are dropped and noted in the textual result
	   so the model sees the omission rather than receiving silence.

	   Only providers that support tool use need to implement this. *)
			
			subclassResponsibility
		)
		public buildToolsPayload: toolDefs <List[Tool]> ^<Alien | UndefinedObject> = (
			(* Translate the IDE's neutral Tool definitions to the provider's
	   tool-declaration shape, or nil if no tools (or no tool support).
	   Default: nil. *)
			
			^nil
		)
		public addToolResults: results <Alien[Array]> toMessages: messages <List> = (
			(* Fold per-call tool-result outcomes (each produced by
	   makeToolResult:textResult:media:isError:) into one or more
	   messages in the provider's native shape, and append to messages.
	   Called once per tool-loop round, after every executeToolCall:
	   promise has resolved.

	   Providers may emit ≥1 messages: Anthropic and Gemini wrap all
	   outcomes into one user-role message; a future OpenAI-compatible
	   provider may need to emit N tool messages plus a follow-up
	   user-role message carrying media that the OpenAI spec won't
	   accept inside a tool message. The contract is "consume the
	   results array; append whatever messages are needed."

	   Providers that support tool use must implement; tool-less
	   providers never reach this path (hasToolUse: defaults to false). *)
			
			subclassResponsibility
		)
		public enableServerWebToolsMaxUses: n <Integer> = (
			(* Ask the provider to run web search/fetch on ITS OWN infrastructure
	   rather than through our browser, declaring at most n uses per turn
	   (n <= 0 disables). Server-side execution sidesteps CORS entirely:
	   the fetch happens on the provider's servers, so no
	   Access-Control-Allow-Origin header is needed from the target and
	   no proxy has to be run or trusted.

	   Default: a no-op, so a provider with no server-side web tools (or
	   none wired up yet) is unaffected and callers need no type test. *)
			
			^self
		)
		public pendingToolUseIdsIn: messages <List> ^<List[String]> = (
			(* The ids of tool calls at the END of the history that were never
	   answered by a tool_result. Non-empty exactly when a turn died
	   between appendAssistantResponse: and addToolResults:toMessages:,
	   which leaves the history in a shape most APIs reject (an
	   assistant message announcing tool calls with no results
	   following). See repairTrailingToolUseIn:.

	   Only the trailing case is detected, because it is the only one
	   that occurs: addToolResults:toMessages: folds a whole round's
	   results in as a unit, so a partially-answered round is not
	   reachable.

	   Default: empty — a provider that does not override simply gets no
	   repair, which is the pre-existing behaviour rather than a wrong
	   one. GeminiProvider deliberately keeps the default: its tool-call
	   ids are synthesised per round (toolUseBlocksFrom: mints 'gem-N'
	   and remembers the function name under pendingCallNames) and are
	   NOT recoverable from the stored message, whose functionCall parts
	   carry only names. Repairing it would mean guessing at ids. *)
			
			^List new
		)
		public repairTrailingToolUseIn: messages <List> ^<Boolean> = (
			(* Close off any unanswered trailing tool calls by synthesising an
	   is_error tool_result for each, so the history is valid to send
	   again. Answers whether anything was repaired.

	   This is what makes a failed turn recoverable rather than
	   terminal: without it, a turn that dies mid-tool-loop leaves a
	   history that the API rejects on EVERY subsequent request, so the
	   user's only escape is clearing the conversation. The synthesised
	   result tells the model plainly that the call did not run, which
	   is also what we want it to know — it can decide to call the tool
	   again.

	   Implemented once here in terms of the provider's own
	   pendingToolUseIdsIn: / makeToolResult:... / addToolResults:...,
	   so every provider that can identify its unanswered ids gets
	   repair in its native message shape for free. *)
			
			| ids <List[String]> results <Alien[Array]> |
			ids:: pendingToolUseIdsIn: messages.
			ids isEmpty ifTrue: [ ^false ].
			results:: createJSArray.
			ids do: [:id <String> |
					results push: (makeToolResult: id
							textResult: 'Interrupted: this tool call was never executed, because the turn failed before the tool ran. No action was taken. Call the tool again if you still need its result.'
							media: createJSArray
							isError: true)
				].
			addToolResults: results toMessages: messages.
			^true
		)
		public lastMessageRoleIn: messages <List> ^<String | UndefinedObject> = (
			(* The role of the final history entry, normalized to 'user' /
	   'assistant', or nil if unknown. Session uses it to tell a turn
	   that died before the model answered (history ends with a user or
	   tool-result message — re-drivable) from one that died after
	   (history ends with an assistant message — already answered, so
	   re-driving would ask the model to continue its own message).

	   The default reads the 'role' field every provider's stored
	   messages carry, translating Gemini's 'model' to 'assistant'. *)
			
			| role <String | UndefinedObject> |
			messages isEmpty ifTrue: [ ^nil ].
			role:: safeStringAt: (messages at: messages size) field: 'role'.
			role = 'model' ifTrue: [ ^'assistant' ].
			^role
		)
		public supportsFileUploads ^<Boolean> = (
			(* Capability hint: does this provider accept image/PDF/document blocks
	   inside tool_result.content (or its equivalent)? Tools that deliver
	   binary payloads only register on sessions whose provider returns
	   true here. Default false; override per provider. *)
			
			^false
		)
		public availableModels ^<List[String]> = (
			(* Cache-first list of model ids the picker should offer. Reads
	   cachedModels from localStorage; falls back to staticFallbackModels
	   when no cache is present (no API key stored, boot refresh hasn't
	   resolved yet, or the network call failed). Subclasses override
	   staticFallbackModels, not this method. *)
			
			| cached ids |
			cached:: cachedModels.
			cached isNil ifTrue: [ ^staticFallbackModels ].
			ids:: List new.
			cached do: [:entry | ids add: (entry at: 1) ].
			ids isEmpty ifTrue: [ ^staticFallbackModels ].
			^ids
		)
		public displayNameFor: modelId <String> ^<String> = (
			(* Cache-first display name. Each cache entry is a {id. displayName}
	   tuple; if a matching id is found and its displayName is non-empty,
	   return it. Otherwise delegate to staticDisplayNameFor: which
	   subclasses implement as a hardcoded switch. *)
			
			| cached |
			cached:: cachedModels.
			cached isNil ifFalse: [
					cached do: [:entry |
							(entry at: 1) = modelId ifTrue: [
									| dn |
									dn:: entry at: 2.
									(dn isNil or: [ dn isEmpty ]) ifFalse: [ ^dn ]
								]
						]
				].
			^staticDisplayNameFor: modelId
		)
		public staticFallbackModels ^<List[String]> = (
			(* Hardcoded list shipped in this build. Used when localStorage has no
	   cached list yet — keeps the picker usable on first run or when no
	   API key is stored. *)
			
			subclassResponsibility
		)
		public staticDisplayNameFor: modelId <String> ^<String> = (
			(* Hardcoded label lookup, used when the cache doesn't carry a display
	   name for the given id. Default: return the id verbatim. *)
			
			^modelId
		)
		public listModelsEndpoint ^<String> = (
			(* URL of the provider's list-models endpoint. *)
			
			subclassResponsibility
		)
		public fetchAvailableModelsFromAPI ^<Alien[Promise]> = (
			(* Hit listModelsEndpoint with provider-appropriate auth headers and
	   resolve with the *raw* parsed JSON body (provider-specific shape).
	   Rejects with a String reason on HTTP / network failure.

	   This mirrors complete:'s pattern: a single then-block that returns
	   `response json` straight through. Parsing the body into {id.
	   displayName} tuples is done by refreshAvailableModels in a flat
	   second then-stage, NOT nested inside this one — primordialsoup's
	   JS-Promise bridge handles flat chains cleanly but a raise inside a
	   nested `response json then: [...]` can corrupt the alien stack and
	   surface as the next callback receiving document.documentElement. *)
			
			subclassResponsibility
		)
		public parseListModelsResponse: body <Alien> ^<List> = (
			(* Walk the provider-native response body and return a Newspeak List
	   of {id <String>. displayName <String>} 2-tuples. Implementations
	   should be defensive (safeAt:, safeStringAt:) — any raise here
	   surfaces as the chain rejecting via refreshAvailableModels's
	   on:Exception backstop. *)
			
			subclassResponsibility
		)
		public localStorageModelsKey ^<String> = (
			(* Per-provider cache key. `class name` returns the simple class
	   name (e.g. 'AnthropicProvider'). *)
			
			^'ns_ai_models_' , class name
		)
		public cachedModels ^<List | UndefinedObject> = (
			(* Read parsed cache from localStorage. Returns nil if absent,
	   localStorage is unavailable, or the stored value isn't a JSON
	   array of objects with at least an `id` field. Returns a List of
	   {id. displayName} 2-tuples on success. *)
			
			| raw parsed list len |
			raw:: [ js localStorage getItem: localStorageModelsKey ] on: Exception
				do: [:e | nil ].
			raw isNil ifTrue: [ ^nil ].
			(raw isKindOfString and: [ raw isEmpty ]) ifTrue: [ ^nil ].
			parsed:: [ JSON parse: raw ] on: Exception do: [:e | nil ].
			parsed isNil ifTrue: [ ^nil ].
			len:: safeAt: parsed field: 'length'.
			len isNil ifTrue: [ ^nil ].
			list:: List new.
			0 to: len - 1
				do: [:i <Integer> |
					| entry id dn |
					entry:: safeAt: parsed field: i.
					id:: safeStringAt: entry field: 'id'.
					dn:: safeStringAt: entry field: 'displayName'.
					dn isNil ifTrue: [ dn:: '' ].
					id isNil ifFalse: [ list add: {id. dn. } ]
				].
			list isEmpty ifTrue: [ ^nil ].
			^list
		)
		public storeCachedModels: tuples <List> = (
			(* Persist the list of {id. displayName} tuples as a JSON array.
	   Silently no-ops on any storage failure. *)
			
			| arr str |
			arr:: createJSArray.
			tuples do: [:entry |
					| obj |
					obj:: createJSObject.
					obj at: 'id' put: (entry at: 1).
					obj at: 'displayName' put: (entry at: 2).
					arr push: obj
				].
			str:: [ JSON stringify: arr ] on: Exception do: [:e | nil ].
			str isNil ifTrue: [ ^self ].
			[ js localStorage setItem: localStorageModelsKey to: str ] on: Exception
				do: [:e | ]
		)
		public refreshAvailableModels ^<Alien[Promise]> = (
			(* Fetch the raw body, parse into tuples, persist, and resolve. Cache
	   mutates only on success. The parse + store happen in a single flat
	   then-stage with an on:Exception backstop so any raise turns into a
	   clean Promise.reject — keeps the alien bridge from corrupting
	   downstream callbacks.

	   NB: a Newspeak List is NOT a JS-marshallable value, so we must NOT
	   resolve the Promise with `tuples` — doing so makes the alien bridge
	   try to push the List into JS (List >> index doesNotUnderstand) and
	   crash. The parsed list lives in the cache (storeCachedModels:);
	   callers read it from there, not from the Promise value. We resolve
	   with nil. *)
			
			^fetchAvailableModelsFromAPI then: [:body |
					[
						| tuples |
						tuples:: parseListModelsResponse: body.
						storeCachedModels: tuples.
						nil
					] on: Exception
						do: [:e |
							JSPromise reject: 'list-models parse error: ' , (errorDescription: e)
						]
				]
		)
		public stopReasonOf: response <Alien> ^<String | UndefinedObject> = (
			(* The wire-level reason the model stopped, as this provider's raw string
	   (Anthropic 'end_turn'/'max_tokens'/'tool_use', Gemini 'STOP'/'MAX_TOKENS',
	   OpenAI 'stop'/'length'/'tool_calls'), or nil when the response carries
	   none. Base answers nil so an untaught provider degrades to "unknown". *)
			
			^nil
		)
		public wasTruncated: response <Alien> ^<Boolean> = (
			(* Did the model stop because it exhausted the output-token budget? When
	   true, any tool_use blocks in the response are suspect: the model was
	   still emitting when it was cut off, so a call's input may be a prefix
	   of what it meant to send. Session refuses to execute such calls. *)
			
			^false
		)
		public usageOf: response <Alien> ^<Map[Symbol, Integer] | UndefinedObject> = (
			(* Token accounting for one request/response, normalised across providers
	   to the keys #input #output #cacheRead #cacheWrite (absent counts read as
	   0), or nil if the response reports no usage. *)
			
			^nil
		)
		public costOfUsage: u <Map[Symbol, Integer]> ^<Number | UndefinedObject> = (
			(* Estimated US-dollar cost of one request's normalised usage map, or
	   nil when this provider has no price table — the UI then shows token
	   counts without dollars. AnthropicProvider overrides. *)
			
			^nil
		)
		usageInput: i output: o cacheRead: r cacheWrite: w ^<Map[Symbol, Integer]> = (
			| m <Map[Symbol, Integer]> = Map new. |
			m at: #input put: (tokenCountOrZero: i);
				at: #output put: (tokenCountOrZero: o);
				at: #cacheRead put: (tokenCountOrZero: r);
				at: #cacheWrite put: (tokenCountOrZero: w).
			^m
		)
		tokenCountOrZero: v ^<Integer> = (
			(* Usage leaves arrive through the alien bridge as JS numbers — usually a
	   SmallInteger, occasionally a Float — or as undefined (missing field) or
	   nil. Anything that is not a number counts as 0.

	   NB: asInteger, not truncated. In this kernel truncated is defined on
	   Float/Fraction only, so an Integer count raised DNU and was swallowed
	   as 0 — which zeroed every token total while requestCount kept climbing. *)
			
			^[ v isNil ifTrue: [ 0 ] ifFalse: [ v asInteger ] ] on: Exception
				do: [:e | 0 ]
		)
		public complete: messages <Alien[Array]> system: systemPrompt <String> notices: notices <List[String]> tools: tools <Alien[Array] | UndefinedObject> maxTokens: maxTokens <Integer> ^<Alien[Promise]> = (
			(* As complete:system:tools:maxTokens:, with the turn's one-shot system
	   notices passed separately from the stable prompt. Default: fold them
	   into one string — the pre-caching behaviour, correct for every
	   provider. A provider with a prefix cache (Anthropic) overrides this to
	   keep the static prompt byte-stable across turns and ship the notices
	   outside the cached region. *)
			
			^complete: messages
				system: (foldNotices: notices intoSystem: systemPrompt)
				tools: tools
				maxTokens: maxTokens
		)
		foldNotices: notices <List[String]> intoSystem: systemPrompt <String> ^<String> = (
			notices isEmpty ifTrue: [ ^systemPrompt ].
			^systemPrompt , String lf , (noticesText: notices)
		)
		noticesText: notices <List[String]> ^<String> = (
			(* The out-of-band-updates paragraph a turn's pending system notices
	   render to. One line per notice. *)
			
			^notices inject: 'IMPORTANT — out-of-band updates since your last turn:'
				into: [:acc :line | acc , String lf , '- ' , line ]
		)
	) : ()
	public class AnthropicProvider apiKey: key <String> model: mdl <String> = Provider new (
		(* Provider for Anthropic's Messages API (Claude models). Conversation
 messages are stored in Anthropic's native shape:

   user message:      {role: 'user', content: <string> | <array of blocks>}
   assistant message: {role: 'assistant', content: <array of blocks>}

 Content blocks are typed: 'text', 'tool_use' (assistant calling a tool),
 'tool_result' (user providing tool output back). The Messages API
 returns a top-level content array of these blocks plus a stop_reason
 — 'end_turn' for normal completion, 'tool_use' for tool-calling.

 The browser direct-access header is required because we POST from a
 browser; production deployments should proxy via a server. *)
		
		|
			public apiKey <String> = key.
			
			(* Mutable so the chat UI can switch models mid-session. The session's
	   history is untouched — the next turn just goes to the new model. *)
			public model <String> ::= mdl.
			private apiUrl <String> = 'https://api.anthropic.com/v1/messages'.
			private apiVersion <String> = '2023-06-01'.
			
			(* How many provider-run web searches/fetches a turn may make. 0
	   disables them entirely, which is the default — see
	   enableServerWebToolsMaxUses:. The tool DESCRIPTORS are not stored:
	   they depend on the model, which is mutable (the picker can switch
	   it mid-session), so they are computed per request in
	   serverToolSpecs. *)
			public serverWebToolUses <Integer> ::= 0.
		|
	) (
		public staticFallbackModels ^<List[String]> = (
			(* Hardcoded list shipped in this build. Used when no localStorage
	   cache is available — e.g. first run, no API key stored, or the
	   boot-time refresh has not yet resolved. The cache (when present)
	   takes priority via the inherited availableModels. *)
			
			^{'claude-opus-4-7'. 'claude-sonnet-4-6'. 'claude-haiku-4-5'. 'claude-sonnet-4-20250514'. (* legacy default, for back-compat *) }
		)
		public staticDisplayNameFor: modelId <String> ^<String> = (
			modelId = 'claude-opus-4-7' ifTrue: [ ^'Opus 4.7' ].
			modelId = 'claude-sonnet-4-6' ifTrue: [ ^'Sonnet 4.6' ].
			modelId = 'claude-haiku-4-5' ifTrue: [ ^'Haiku 4.5' ].
			modelId = 'claude-sonnet-4-20250514' ifTrue: [ ^'Sonnet 4 (legacy)' ].
			^modelId
		)
		public listModelsEndpoint ^<String> = (
			^'https://api.anthropic.com/v1/models'
		)
		public fetchAvailableModelsFromAPI ^<Alien[Promise]> = (
			(* GET /v1/models with the standard Anthropic auth headers. Returns
	   the raw parsed body Promise (shape {data: [{id, display_name,
	   ...}, ...]}). Same flat then-shape as complete:: status check
	   inside the outer then-block, return `response json` straight
	   through on success. Parsing into tuples is done one level up by
	   refreshAvailableModels, NOT nested here. *)
			
			| headers options |
			headers:: createJSObject.
			headers at: 'x-api-key' put: apiKey.
			headers at: 'anthropic-version' put: apiVersion.
			headers at: 'anthropic-dangerous-direct-browser-access' put: 'true'.
			options:: createJSObject.
			options at: 'method' put: 'GET'.
			options at: 'headers' put: headers.
			^(global fetch: listModelsEndpoint with: options) then: [:response |
					[
						| status statusText |
						status:: safeAt: response field: 'status'.
						statusText:: safeAt: response field: 'statusText'.
						statusText isNil ifTrue: [ statusText:: '' ].
						(status isNil or: [ status >= 400 ]) ifTrue: [
								JSPromise reject: 'Anthropic list-models error: ' , (status isNil ifTrue: [
											'(no status)'
										]
										ifFalse: [ status printString ]) , ' ' , statusText
							]
							ifFalse: [ response json ]
					] on: Exception
						do: [:e |
							JSPromise reject: 'Anthropic list-models error: ' , (errorDescription: e)
						]
				]
		)
		public parseListModelsResponse: body <Alien> ^<List> = (
			(* Walk the data array and build {id, displayName} 2-tuples. *)
			
			| data dlen tuples |
			data:: safeAt: body field: 'data'.
			dlen:: safeAt: data field: 'length'.
			dlen isNil ifTrue: [
					Error signal: 'Anthropic list-models response missing data array'
				].
			tuples:: List new.
			0 to: dlen - 1
				do: [:i <Integer> |
					| entry id dn |
					entry:: safeAt: data field: i.
					id:: safeStringAt: entry field: 'id'.
					dn:: safeStringAt: entry field: 'display_name'.
					dn isNil ifTrue: [ dn:: '' ].
					id isNil ifFalse: [ tuples add: {id. dn. } ]
				].
			^tuples
		)
		public complete: messages <Alien[Array]> system: systemPrompt <String> notices: notices <List[String]> tools: tools <Alien[Array]> maxTokens: maxTokens <Integer> ^<Alien[Promise]> = (
			(* Overrides the base fold-into-one-string version: this provider has a
	   prefix cache, and the request is assembled to actually use it.

	   Two cache_control breakpoints (Anthropic allows four):

	   - The static system prompt is one block with a 1-HOUR breakpoint.
	     Tools render before system on the wire, so this single marker caches
	     tools + system together. 1h rather than the 5-minute default because
	     IDE conversations pause for review-and-return gaps; a cache read
	     refreshes the TTL free of charge, so the long static prefix stays
	     warm through chatter and gaps alike. (Entries with the longer TTL
	     must precede shorter ones — holds, since system renders before the
	     messages breakpoint.)

	   - markMessagesForCache: puts the 5-minute conversation breakpoint on
	     the last content block of the last message, so each request reads
	     the entire prior conversation from cache and pays full input price
	     only for the new tail. Without it the whole history was re-billed
	     uncached on every request — the dominant cost of a long session.

	   The one-shot notices ride a SEPARATE block after the system
	   breakpoint: folding them into the cached block (as the old
	   effectiveSystemPrompt did) re-billed the entire prompt cache on every
	   notice turn. A notice turn still invalidates the conversation cache
	   once — its block sits between system and messages on the wire — but
	   notice turns are the exception, not the rule. *)
			
			| body headers options |
			body:: createJSObject.
			body at: 'model' put: model.
			body at: 'max_tokens' put: maxTokens.
			markMessagesForCache: messages.
			body at: 'messages' put: messages.
			(systemPrompt isEmpty and: [ notices isEmpty ]) ifFalse: [
					| sysArr |
					sysArr:: createJSArray.
					systemPrompt isEmpty ifFalse: [
							| textBlock cacheControl |
							textBlock:: createJSObject.
							textBlock at: 'type' put: 'text'.
							textBlock at: 'text' put: systemPrompt.
							cacheControl:: createJSObject.
							cacheControl at: 'type' put: 'ephemeral'.
							cacheControl at: 'ttl' put: '1h'.
							textBlock at: 'cache_control' put: cacheControl.
							sysArr push: textBlock
						].
					notices isEmpty ifFalse: [
							| noticesBlock |
							noticesBlock:: createJSObject.
							noticesBlock at: 'type' put: 'text'.
							noticesBlock at: 'text' put: (noticesText: notices).
							sysArr push: noticesBlock
						].
					body at: 'system' put: sysArr
				].
			tools isNil ifFalse: [
					(tools at: 'length') > 0 ifTrue: [ body at: 'tools' put: tools ]
				].
			headers:: createJSObject.
			headers at: 'Content-Type' put: 'application/json'.
			headers at: 'x-api-key' put: apiKey.
			headers at: 'anthropic-version' put: apiVersion.
			headers at: 'anthropic-dangerous-direct-browser-access' put: 'true'.
			options:: createJSObject.
			options at: 'method' put: 'POST'.
			options at: 'headers' put: headers.
			options at: 'body' put: (JSON stringify: body).
			^(global fetch: apiUrl with: options) then: [:response |
					[
						| status statusText |
						
						(* See GeminiProvider doRequest: for the rationale on
			   status >= 400 and on returning Promise.reject instead of
			   raising. *)
						status:: safeAt: response field: 'status'.
						statusText:: safeAt: response field: 'statusText'.
						statusText isNil ifTrue: [ statusText:: '' ].
						(status isNil or: [ status >= 400 ]) ifTrue: [
								JSPromise reject: 'Anthropic API error: ' , (status isNil ifTrue: [
											'(no status)'
										]
										ifFalse: [ status printString ]) , ' ' , statusText
							]
							ifFalse: [ response json ]
					] on: Exception
						do: [:e |
							JSPromise reject: 'Anthropic provider error: ' , (errorDescription: e)
						]
				]
		)
		markMessagesForCache: messages <Alien[Array]> = (
			(* Move this request's conversation cache_control breakpoint to the last
	   content block of the LAST message.

	   The marked message and block are COPIES; the stored history entry is
	   never touched. Mutating stored messages would accumulate one marker
	   per request until Anthropic's four-breakpoint limit rejects the
	   request outright. A marker that moves (or vanishes) between requests
	   does not invalidate the prefix: marker position is metadata, not
	   content, so entries written by earlier requests still hit.

	   The last message at request time is always user-role: plain text from
	   addUserText: (an array of text blocks; sessions created before that
	   change may hold a bare string, wrapped here into the equivalent
	   one-block array on the wire) or the tool_result round from
	   addToolResults:toMessages: — and text and tool_result blocks both
	   accept cache_control. Anything unexpected is left unmarked, and the
	   whole method is guarded: it must never break a request it can only
	   make cheaper. *)
			
			[
				| len last content cc msgCopy blocks |
				len:: messages at: 'length'.
				len = 0 ifTrue: [ ^self ].
				last:: messages at: len - 1.
				content:: last at: 'content'.
				cc:: createJSObject.
				cc at: 'type' put: 'ephemeral'.
				blocks:: createJSArray.
				content isKindOfString ifTrue: [
						| blk |
						blk:: createJSObject.
						blk at: 'type' put: 'text'.
						blk at: 'text' put: content.
						blk at: 'cache_control' put: cc.
						blocks push: blk
					]
					ifFalse: [
						| clen lastBlock t blockCopy i |
						clen:: safeAt: content field: 'length'.
						(clen isNil or: [ clen = 0 ]) ifTrue: [ ^self ].
						lastBlock:: safeAt: content field: clen - 1.
						t:: safeStringAt: lastBlock field: 'type'.
						(t = 'text' or: [
								t = 'tool_result' or: [ t = 'image' or: [ t = 'document' ] ]
							]) ifFalse: [ ^self ].
						i:: 0.
						[ i < (clen - 1) ] whileTrue: [
								blocks push: (content at: i).
								i:: i + 1
							].
						blockCopy:: (global at: 'Object') assign: createJSObject with: lastBlock.
						blockCopy at: 'cache_control' put: cc.
						blocks push: blockCopy
					].
				msgCopy:: createJSObject.
				msgCopy at: 'role' put: (last at: 'role').
				msgCopy at: 'content' put: blocks.
				messages at: len - 1 put: msgCopy
			] on: Exception do: [:e | nil ]
		)
		public addUserText: text <String> toMessages: messages <List> = (
			(* The text is stored as an array holding one text block, not as a bare
	   content string, so that the message's wire form is byte-stable whether
	   or not it is currently the last message (markMessagesForCache: marks a
	   block-array copy; a string would flip representation between the
	   marked request and every later one). *)
			
			| userMsg <Alien> blocks <Alien> blk <Alien> |
			blk:: createJSObject.
			blk at: 'type' put: 'text'.
			blk at: 'text' put: text.
			blocks:: createJSArray.
			blocks push: blk.
			userMsg:: createJSObject.
			userMsg at: 'role' put: 'user'.
			userMsg at: 'content' put: blocks.
			messages add: userMsg
		)
		public appendAssistantResponse: response <Alien> toMessages: messages <List> = (
			(* Pull the content array from the response and store it as an
	   assistant entry. Raises on missing content (the on:Exception
	   backstop in Session.completeWithToolLoop converts the raise to
	   a JS Promise rejection). *)
			
			| assistantMsg <Alien> content <Alien | UndefinedObject> sr |
			content:: safeAt: response field: 'content'.
			content isNil ifTrue: [
					sr:: safeAt: response field: 'stop_reason'.
					sr isNil ifTrue: [ sr:: '(absent)' ].
					Error signal: 'Anthropic response missing content. stop_reason: ' , sr printString
				].
			assistantMsg:: createJSObject.
			assistantMsg at: 'role' put: 'assistant'.
			assistantMsg at: 'content' put: content.
			messages add: assistantMsg
		)
		public messagesAsRequestPayload: messages <List> ^<Alien[Array]> = (
			(* apiMessages already holds Anthropic-shaped entries; just JSArray-ify. *)
			
			| arr <Alien[Array]> |
			arr:: createJSArray.
			messages do: [:m | arr push: m ].
			^arr
		)
		public extractTextFromResponse: response <Alien> ^<String> = (
			(* Concatenate text from all 'text' blocks in the content array.
	   Every JS access goes through safeAt:/safeStringAt: so a
	   malformed response — including one with JS undefined leaves —
	   yields '' rather than raising into the user's chat. *)
			
			| content len result <String> text |
			content:: safeAt: response field: 'content'.
			len:: safeAt: content field: 'length'.
			len isNil ifTrue: [ ^'' ].
			result:: ''.
			0 to: len - 1
				do: [:i <Integer> |
					| block |
					block:: safeAt: content field: i.
					(safeStringAt: block field: 'type') = 'text' ifTrue: [
							text:: safeStringAt: block field: 'text'.
							text isNil ifFalse: [ result:: result , text ]
						]
				].
			^result
		)
		public displayMessagesFromMessages: messages <List> ^<List> = (
			(* Walks apiMessages — entries we constructed ourselves via
	   addUserText: / appendAssistantResponse: / the tool loop. We still
	   use safeStringAt: at scalar leaves because the assistant message's
	   content array carries blocks we got from the API, which can
	   include non-text blocks (tool_use, future block types) whose
	   'text' is JS undefined; isNil doesn't catch undefined.

	   For user entries, gather 'text' blocks: addUserText: stores the
	   user's words as an array of text blocks (see its comment), while a
	   tool_result round's array holds no text blocks and so stays hidden
	   from the human reader, as before. Bare-string content (sessions
	   predating the block-array change) still displays directly. For
	   assistant entries, gather only 'text' blocks. *)
			
			| result <List> |
			result:: List new.
			messages do: [:msg <Alien> |
					| role <String> content |
					role:: msg at: 'role'.
					content:: msg at: 'content'.
					role = 'user' ifTrue: [
							content isKindOfString ifTrue: [ result add: {role. content. } ]
								ifFalse: [
									| text <String> len |
									text:: ''.
									len:: safeAt: content field: 'length'.
									len isNil ifFalse: [
											0 to: len - 1
												do: [:i <Integer> |
													| block t |
													block:: safeAt: content field: i.
													(safeStringAt: block field: 'type') = 'text' ifTrue: [
															t:: safeStringAt: block field: 'text'.
															t isNil ifFalse: [ text:: text , t ]
														]
												]
										].
									text isEmpty ifFalse: [ result add: {role. text. } ]
								]
						].
					role = 'assistant' ifTrue: [
							| text <String> len |
							text:: ''.
							len:: safeAt: content field: 'length'.
							len isNil ifFalse: [
									0 to: len - 1
										do: [:i <Integer> |
											| block t |
											block:: safeAt: content field: i.
											(safeStringAt: block field: 'type') = 'text' ifTrue: [
													t:: safeStringAt: block field: 'text'.
													t isNil ifFalse: [ text:: text , t ]
												]
										]
								].
							text isEmpty ifFalse: [ result add: {role. text. } ]
						]
				].
			^result
		)
		public hasToolUse: response <Alien> ^<Boolean> = (
			^(safeAt: response field: 'stop_reason') = 'tool_use'
		)
		public supportsFileUploads ^<Boolean> = (
			(* Anthropic's tool_result.content accepts text, image, document, and
	   search_result blocks, so the upload_file tool can return PDFs and
	   images directly. *)
			
			^true
		)
		public toolUseBlocksFrom: response <Alien> ^<List> = (
			(* Filter the response's content array for blocks of type 'tool_use'.
	   Each such block has 'id', 'name', 'input' fields the Session uses
	   to dispatch the tool call. *)
			
			| content len blocks <List> |
			content:: safeAt: response field: 'content'.
			len:: safeAt: content field: 'length'.
			blocks:: List new.
			len isNil ifTrue: [ ^blocks ].
			0 to: len - 1
				do: [:i <Integer> |
					| block |
					block:: safeAt: content field: i.
					(safeStringAt: block field: 'type') = 'tool_use' ifTrue: [
							blocks add: block
						]
				].
			^blocks
		)
		public makeToolResult: id <String> textResult: text <String> media: mediaParts <Alien[Array]> isError: err <Boolean> ^<Alien> = (
			(* Build a tool_result block for Anthropic, referencing the original
	   tool_use by id. The content array starts with a text block, then
	   one image/document block per supported media item. Anthropic
	   accepts image/* and application/pdf inside tool_result.content;
	   audio/video are not supported there and get dropped with a notice
	   appended to the text so the model sees the omission rather than
	   silent data loss. *)
			
			| block contentArr finalText skippedNotes mediaBlocks mlen textBlock |
			finalText:: text.
			skippedNotes:: ''.
			mediaBlocks:: List new.
			mlen:: safeAt: mediaParts field: 'length'.
			mlen isNil ifTrue: [ mlen:: 0 ].
			0 to: mlen - 1
				do: [:i <Integer> |
					| m mime b64 name mb source label |
					m:: mediaParts at: i.
					mime:: safeStringAt: m field: 'mimeType'.
					mime isNil ifTrue: [ mime:: '' ].
					b64:: safeStringAt: m field: 'dataBase64'.
					b64 isNil ifTrue: [ b64:: '' ].
					name:: safeStringAt: m field: 'name'.
					name isNil ifTrue: [ name:: '' ].
					mime = 'application/pdf' ifTrue: [
							source:: createJSObject.
							source at: 'type' put: 'base64'.
							source at: 'media_type' put: 'application/pdf'.
							source at: 'data' put: b64.
							mb:: createJSObject.
							mb at: 'type' put: 'document'.
							mb at: 'source' put: source.
							name isEmpty ifFalse: [ mb at: 'title' put: name ].
							mediaBlocks add: mb
						]
						ifFalse: [
							(mime startsWith: 'image/') ifTrue: [
									source:: createJSObject.
									source at: 'type' put: 'base64'.
									source at: 'media_type' put: mime.
									source at: 'data' put: b64.
									mb:: createJSObject.
									mb at: 'type' put: 'image'.
									mb at: 'source' put: source.
									mediaBlocks add: mb
								]
								ifFalse: [
									label:: name isEmpty ifTrue: [ mime ]
										ifFalse: [ name , ' (' , mime , ')' ].
									skippedNotes:: skippedNotes isEmpty ifTrue: [ label ]
										ifFalse: [ skippedNotes , ', ' , label ]
								]
						]
				].
			skippedNotes isEmpty ifFalse: [
					finalText:: finalText , String lf , '[note: skipped attachments with media type not supported in Anthropic tool_result: ' , skippedNotes , ']'
				].
			contentArr:: createJSArray.
			finalText isEmpty ifFalse: [
					textBlock:: createJSObject.
					textBlock at: 'type' put: 'text'.
					textBlock at: 'text' put: finalText.
					contentArr push: textBlock
				].
			mediaBlocks do: [:mb | contentArr push: mb ].
			block:: createJSObject.
			block at: 'type' put: 'tool_result'.
			block at: 'tool_use_id' put: id.
			block at: 'content' put: contentArr.
			err ifTrue: [ block at: 'is_error' put: true ].
			^block
		)
		public buildToolsPayload: toolDefs <List[Tool]> ^<Alien[Array] | UndefinedObject> = (
			(* Anthropic's tools-array shape: each entry has name, description,
	   and input_schema (parsed JSON object). Returns nil if no tools, so
	   the request body's 'tools' field is omitted. *)
			
			| arr <Alien[Array]> specs <List[String]> shadowed <List[String]> |
			specs:: serverToolSpecs.
			(toolDefs isEmpty and: [ specs isEmpty ]) ifTrue: [ ^nil ].
			arr:: createJSArray.
			
			(* Server tools first, collecting the names they claim. A server tool
	   and one of ours can carry the SAME name — Anthropic's web_fetch vs
	   our own — and the API rejects a tools array with duplicate names.
	   The server one wins: it does the same job without being subject to
	   the browser's CORS policy, so it is strictly better. Dropping the
	   shadowed client tool here (rather than at the call site) keeps the
	   rule where the collision is knowable. *)
			shadowed:: List new.
			specs do: [:spec <String> |
					| obj <Alien> nm |
					obj:: JSON parse: spec.
					nm:: safeStringAt: obj field: 'name'.
					nm isNil ifFalse: [ shadowed add: nm ].
					arr push: obj
				].
			toolDefs do: [:t <Tool> |
					| obj <Alien> |
					(shadowed includes: t name) ifFalse: [
							obj:: createJSObject.
							obj at: 'name' put: t name.
							obj at: 'description' put: t description.
							obj at: 'input_schema' put: (JSON parse: t inputSchema).
							arr push: obj
						]
				].
			^arr
		)
		public enableServerWebToolsMaxUses: n <Integer> = (
			(* Declare Anthropic's server-run web_search and web_fetch tools. They
	   execute on Anthropic's infrastructure, so they are not subject to
	   the browser's CORS policy the way our own local_fetch tool is —
	   this is what lets the model actually read the web from the IDE.

	   Stores only the cap; the descriptors are built per request, because
	   which tool VERSION is legal depends on the model, and the model can
	   change mid-session via the picker. *)
			
			serverWebToolUses:: n
		)
		effectiveServerWebToolUses ^<Integer> = (
			(* Nil-tolerant: a provider built before this slot existed (schema
	   migration on hot-load) reads nil, not 0. *)
			
			serverWebToolUses isNil ifTrue: [ ^0 ].
			^serverWebToolUses
		)
		supportsDynamicWebTools ^<Boolean> = (
			(* The 20260209 web tools filter results with server-side code
	   execution before they reach the context window, and are accepted
	   only on the models listed here. Older models — Haiku 4.5 and the
	   legacy Sonnet 4 in our own picker among them — must be sent the
	   basic variants instead, or the request is rejected.

	   This list and the version strings in serverToolSpecs are the parts
	   most likely to drift as Anthropic revises these tools; they are
	   deliberately kept together, as data, so updating them is a
	   one-line edit. *)
			
			^{'claude-opus-5'. 'claude-opus-4-8'. 'claude-opus-4-7'. 'claude-opus-4-6'. 'claude-sonnet-5'. 'claude-sonnet-4-6'. 'claude-fable-5'. 'claude-mythos-5'. } inject: false
				into: [:found <Boolean> :prefix <String> |
					found or: [ [ model startsWith: prefix ] on: Exception do: [:e | false ] ]
				]
		)
		serverToolSpecs ^<List[String]> = (
			(* JSON descriptors for the server-run web tools, built for the
	   CURRENT model. Empty when the cap is 0.

	   No anthropic-beta header is involved — these tools are GA. An
	   earlier draft of this code sent one, which is exactly the kind of
	   staleness the model check above guards against.

	   NB: the 20260209 variants run code execution under the hood to
	   filter results, so we must NOT also declare a code_execution tool —
	   a second execution environment confuses the model. *)
			
			| n <Integer> specs <List[String]> searchVersion <String> fetchVersion <String> |
			n:: effectiveServerWebToolUses.
			specs:: List new.
			n > 0 ifFalse: [ ^specs ].
			supportsDynamicWebTools ifTrue: [
					searchVersion:: 'web_search_20260209'.
					fetchVersion:: 'web_fetch_20260209'
				]
				ifFalse: [
					searchVersion:: 'web_search_20250305'.
					fetchVersion:: 'web_fetch_20250910'
				].
			specs add: '{"type": "' , searchVersion , '", "name": "web_search", "max_uses": ' , n printString , '}'.
			specs add: '{"type": "' , fetchVersion , '", "name": "web_fetch", "max_uses": ' , n printString , '}'.
			^specs
		)
		public pendingToolUseIdsIn: messages <List> ^<List[String]> = (
			(* Anthropic: unanswered calls show up as tool_use blocks in a
	   trailing assistant message. Their ids are stored verbatim (see
	   appendAssistantResponse:), so they can be answered exactly. *)
			
			| last <Alien> content len ids <List[String]> |
			ids:: List new.
			messages isEmpty ifTrue: [ ^ids ].
			last:: messages at: messages size.
			(safeStringAt: last field: 'role') = 'assistant' ifFalse: [ ^ids ].
			content:: safeAt: last field: 'content'.
			len:: safeAt: content field: 'length'.
			len isNil ifTrue: [ ^ids ].
			0 to: len - 1
				do: [:i <Integer> |
					| block id |
					block:: safeAt: content field: i.
					(safeStringAt: block field: 'type') = 'tool_use' ifTrue: [
							id:: safeStringAt: block field: 'id'.
							id isNil ifFalse: [ ids add: id ]
						]
				].
			^ids
		)
		public addToolResults: results <Alien[Array]> toMessages: messages <List> = (
			(* Anthropic carries the round's tool_result blocks inside a single
	   user-role message whose content is the array of blocks. *)
			
			| msg <Alien> |
			msg:: createJSObject.
			msg at: 'role' put: 'user'.
			msg at: 'content' put: results.
			messages add: msg
		)
		public addUserText: text <String> documents: docs <List> toMessages: messages <List> = (
			(* Like addUserText:toMessages: but also attaches one document block per
	   entry in docs. Each entry in docs is a two-element tuple:
	     { filename <String>. content <String> }
	   The content is sent as a plain-text document block (type 'document',
	   source type 'text', media_type 'text/plain'). The user's text message
	   is a separate 'text' block prepended in the same content array.
	   If docs is empty this is equivalent to addUserText:toMessages:,
	   though callers should prefer that method when there are no attachments
	   to avoid building the block array unnecessarily. *)
			
			| userMsg <Alien> contentArr <Alien> textBlock <Alien> |
			userMsg:: createJSObject.
			userMsg at: 'role' put: 'user'.
			contentArr:: createJSArray.
			textBlock:: createJSObject.
			textBlock at: 'type' put: 'text'.
			textBlock at: 'text' put: text.
			contentArr push: textBlock.
			docs do: [:doc <Array> |
					| filename <String> fileContent <String> docBlock <Alien> source <Alien> |
					filename:: doc at: 1.
					fileContent:: doc at: 2.
					source:: createJSObject.
					source at: 'type' put: 'text'.
					source at: 'media_type' put: 'text/plain'.
					source at: 'data' put: fileContent.
					docBlock:: createJSObject.
					docBlock at: 'type' put: 'document'.
					docBlock at: 'source' put: source.
					docBlock at: 'title' put: filename.
					contentArr push: docBlock
				].
			userMsg at: 'content' put: contentArr.
			messages add: userMsg
		)
		public stopReasonOf: response <Alien> ^<String | UndefinedObject> = (
			^safeStringAt: response field: 'stop_reason'
		)
		public wasTruncated: response <Alien> ^<Boolean> = (
			^(stopReasonOf: response) = 'max_tokens'
		)
		public usageOf: response <Alien> ^<Map[Symbol, Integer] | UndefinedObject> = (
			| usage m breakdown |
			usage:: safeAt: response field: 'usage'.
			usage isNil ifTrue: [ ^nil ].
			m:: usageInput: (safeAt: usage field: 'input_tokens')
				output: (safeAt: usage field: 'output_tokens')
				cacheRead: (safeAt: usage field: 'cache_read_input_tokens')
				cacheWrite: (safeAt: usage field: 'cache_creation_input_tokens').
			
			(* The cache_creation object splits the write count by TTL. The two
		   are priced differently (1.25x base input for 5-minute entries, 2x
		   for 1-hour), so costOfUsage: wants the split; readers that only
		   care about the total keep using #cacheWrite. *)
			breakdown:: safeAt: usage field: 'cache_creation'.
			breakdown isNil ifFalse: [
					m at: #cacheWrite5m
						put: (tokenCountOrZero: (safeAt: breakdown
								field: 'ephemeral_5m_input_tokens')).
					m at: #cacheWrite1h
						put: (tokenCountOrZero: (safeAt: breakdown
								field: 'ephemeral_1h_input_tokens'))
				].
			^m
		)
		mtokRatesForModel: m <String> ^<Array | UndefinedObject> = (
			(* {input $/MTok. output $/MTok} — Anthropic's published API prices as
	   of 2026-09, matched on the model-family substring so point and dated
	   releases (claude-fable-5-1) price with their family. THE one place to
	   edit when prices change. An unknown family answers nil and the UI
	   shows token counts without dollars. sonnet-5 must be tested before
	   the generic sonnet row, which carries the 4.x price. *)
			
			(m includesSubstring: 'fable') ifTrue: [ ^{10. 50. } ].
			(m includesSubstring: 'mythos') ifTrue: [ ^{10. 50. } ].
			(m includesSubstring: 'opus') ifTrue: [ ^{5. 25. } ].
			(m includesSubstring: 'sonnet-5') ifTrue: [ ^{2. 10. } ].
			(m includesSubstring: 'sonnet') ifTrue: [ ^{3. 15. } ].
			(m includesSubstring: 'haiku') ifTrue: [ ^{1. 5. } ].
			^nil
		)
		public costOfUsage: u <Map[Symbol, Integer]> ^<Number | UndefinedObject> = (
			(* Estimated US-dollar cost of one request's normalised usage map,
	   priced for the CURRENT model — recordUsageFrom: calls this per
	   request, so a mid-session model switch prices each request at the
	   model that actually served it. Cache reads bill at 0.1x the input
	   rate; cache writes at 1.25x (5-minute TTL) and 2x (1-hour) — the
	   split comes from usageOf:'s #cacheWrite5m/#cacheWrite1h when the
	   response carried it, else the whole write count is priced at the
	   5-minute rate. Decimal literals are exact here (Fractions), so the
	   accumulated total carries no float drift; it is an ESTIMATE only
	   because the rate table can lag Anthropic's pricing page. *)
			
			| rates in out w5 w1 |
			rates:: mtokRatesForModel: model.
			rates isNil ifTrue: [ ^nil ].
			in:: rates at: 1.
			out:: rates at: 2.
			w5:: u at: #cacheWrite5m ifAbsent: [ u at: #cacheWrite ifAbsent: [ 0 ] ].
			w1:: u at: #cacheWrite1h ifAbsent: [ 0 ].
			^(u at: #input ifAbsent: [ 0 ]) * in + ((u at: #output ifAbsent: [ 0 ]) * out) + ((u at: #cacheRead
				ifAbsent: [ 0 ]) * in * 0.1) + (w5 * in * 1.25) + (w1 * in * 2) / 1000000
		)
	) : ()
	public class Session provider: p <Provider> tools: toolList <List[Tool]> = Object new (
		(* A multi-turn AI conversation bound to one provider. Holds the message
 history, the available tools, the system prompt, and the on-update
 callback. UI code typically calls sendMessage: to drive a turn and
 displayMessages to read the conversation back for rendering.

 Session is provider-agnostic: every operation that touches message
 internals is delegated to `provider`. The history (apiMessages) is
 stored in whatever native shape `provider` builds — Session never
 inspects it directly. *)
		
		|
			public provider <Provider> = p.
			private toolDefs <List[Tool]> = toolList.
			private toolMap <Map[String, Tool]> = Map new.
			
			(* Conversation history. The shape of each entry is opaque to Session —
	   only `provider` knows what messages look like in its native API. Use
	   provider methods (addUserText:toMessages:, displayMessagesFromMessages:,
	   etc.) to inspect or mutate. *)
			public apiMessages <List[Alien]> = List new.
			public systemPrompt <String> ::= 'You are a helpful Newspeak programming assistant.'.
			
			(* Output-token budget per request. Was 4096, which a single large tool
	   argument (a document body, a class source) exceeds; the model then stops
	   with a truncated tool call. Every model in the providers' fallback lists
	   accepts 16384. *)
			public maxTokens <Integer> ::= 16384.
			
			(* Optional zero-arg callback invoked when conversation state changes
	   (a user message added, an assistant turn appended, an error
	   recorded, a phase change). Used by chat UIs to refresh without polling. *)
			public onUpdate <[Object] | UndefinedObject>
			
			(* One-shot system-context lines shipped with the NEXT turn's requests
		   (passed to the provider's complete:system:notices:tools:maxTokens:,
		   separately from the stable systemPrompt so a notice cannot invalidate
		   the provider's prompt cache), then cleared. See addSystemNotice:. *)
			pendingSystemNotices <List[String]> = List new.
			
			(* Watchdog budgets, in milliseconds; 0 disables. requestTimeoutMs covers
		   one provider request, toolTimeoutMs one round of tool execution. See
		   withWatchdog:ms:reason:. *)
			public requestTimeoutMs <Integer> ::= 120000.
			public toolTimeoutMs <Integer> ::= 180000.
			
			(* Mid-turn progress, for the status UI: what the turn is doing right now
		   ('idle', 'waiting for model', 'running <tools>') and when that began
		   (JS wall-clock ms). See enterPhase:. *)
			public phase <String> ::= 'idle'.
			public phaseStartedAt <Number> ::= 0.
			
			(* Token accounting, from provider usageOf:. lastUsage is the most recent
		   request's normalised map (#input #output #cacheRead #cacheWrite); the
		   totals accumulate over the session. requestCount counts provider
		   round-trips (a tool-use turn makes several). *)
			public lastUsage <Map[Symbol, Integer] | UndefinedObject>
			public lastStopReason <String | UndefinedObject>
			public totalInputTokens <Integer> ::= 0.
			public totalOutputTokens <Integer> ::= 0.
			public totalCacheReadTokens <Integer> ::= 0.
			public totalCacheWriteTokens <Integer> ::= 0.
			public requestCount <Integer> ::= 0.
			
			(* User-facing lines about events inside the current turn that the
		   model's own text may not report (output truncated, tool call refused).
		   The chat surface drains them with takeTurnNotices when the turn
		   settles. truncationsThisTurn bounds the refuse-and-retry loop. *)
			turnNotices <List[String]> = List new.
			truncationsThisTurn <Integer> ::= 0.
		|
		toolList do: [:t <Tool> | toolMap at: t name put: t ].
	) (
		
		(* Running dollar estimate, accumulated per request by recordUsageFrom: at
   the rates of the model that served each request (provider costOfUsage:),
   so a mid-session model switch does not reprice history. Lazy DELIBERATELY:
   these were added while sessions with the eager slots were live, and a new
   eager slot is nil on every existing instance (schema migration does not
   re-run initializers) — lazy slots initialize on first touch instead. *)
		lazy public totalCostUsd ::= 0.
		lazy public lastCostUsd ::= 0.
		public addSystemNotice: line <String> = (
			(* Queue a one-shot line to ride the next turn's system prompt. *)
			
			pendingSystemNotices add: line.
			notifyUpdate
		)
		toolResultFor: id <String> handlerValue: v isError: isError <Boolean> ^<Object> = (
			(* Normalize a tool handler's resolved value to the canonical
	   {text, media} form, apply the 'See attached' default when text is
	   empty but media is present, then ask the provider to build its
	   native tool-result outcome. The returned object is opaque to
	   Session — only this provider's addToolResults:toMessages: knows
	   how to fold it into the message stream.

	   Accepted handler shapes:
	     - String          → {text: v, media: []}
	     - {text, media}   → as-is (media defaults to empty array if
	                         absent)
	     - other           → {text: v printString, media: []} fallback.

	   Defensive against alien-bridge quirks at every leaf: the
	   safeStringAt:-style pattern at v's text/media fields, try/catch
	   around `media at: 'length'` for the substitution decision. A
	   handler that returns garbage produces an empty-or-printString
	   result rather than crashing the chat session. *)
			
			| text media mlen |
			v isKindOfString ifTrue: [
					text:: v.
					media:: createJSArray
				]
				ifFalse: [
					(v isKindOfJSAlien and: [ v includesKey: 'text' ]) ifTrue: [
							text:: [ (v at: 'text') , '' ] on: Exception do: [:e | '' ].
							media:: [ v at: 'media' ] on: Exception do: [:e | createJSArray ].
							media isNil ifTrue: [ media:: createJSArray ]
						]
						ifFalse: [
							text:: [ v printString ] on: Exception do: [:e | '<unprintable result>' ].
							media:: createJSArray
						]
				].
			mlen:: [ media at: 'length' ] on: Exception do: [:e | 0 ].
			mlen isNil ifTrue: [ mlen:: 0 ].
			(text isEmpty and: [ mlen > 0 ]) ifTrue: [ text:: 'See attached' ].
			^provider makeToolResult: id textResult: text media: media isError: isError
		)
		notifyUpdate = (
			(* Fire the on-update callback if one is wired. Used by chat UIs to
	   refresh on conversation state change without polling. *)
			
			onUpdate isNil ifFalse: [ onUpdate value ]
		)
		withWatchdog: promise <Alien[Promise]> ms: ms <Integer> reason: reason <String> ^<Alien[Promise]> = (
			(* Race `promise` against a JS timer that rejects with `reason`, so a
	   request that never settles becomes a visible error instead of a
	   permanent hang. Answers a promise that settles however the race
	   settles, with the timer cleared either way.

	   The timer is deliberately a JS-side setTimeout rather than
	   anything Newspeak-scheduled: that makes the watchdog independent
	   of the alien bridge delivering a settlement at all, so it also
	   catches the known failure mode where a rejection raised out of a
	   then-closure is swallowed (see completeWithToolLoop's comment and
	   NEWSPEAK_JS_PROMISE_NOTES_2026-05-18.md).

	   Promise.withResolvers, not `new Promise(executor)` — the bridge
	   passes nil for both executor arguments (see AI_IDE_Support
	   pickFile). Clearing the timer on settle matters: a live timer
	   holds a callback that would otherwise fire minutes later, and
	   psoup keeps scheduling turns while timers are outstanding.
	   Rejecting an already-settled race is harmless (a settled promise
	   ignores later settlement), so a lost clearTimeout would be a
	   waste, not a bug. *)
			
			| deferred <Alien> rejectFn <Alien> timerId contenders <Alien[Array]> |
			ms <= 0 ifTrue: [ ^promise ].
			deferred:: JSPromise withResolvers.
			rejectFn:: deferred at: 'reject'.
			timerId:: global setTimeout: [
					rejectFn call: js undefined with: reason.
					nil
				]
				with: ms.
			contenders:: createJSArray.
			contenders push: promise.
			contenders push: (deferred at: 'promise').
			^(JSPromise race: contenders) then: [:v |
					global clearTimeout: timerId.
					v
				]
				onError: [:err |
					global clearTimeout: timerId.
					JSPromise reject: err
				]
		)
		effectiveRequestTimeoutMs ^<Integer> = (
			(* Nil-tolerant read: a Session that predates these slots (schema
	   migration on hot-load leaves new slots nil) still gets a
	   watchdog rather than a DNU. *)
			
			requestTimeoutMs isNil ifTrue: [ ^120000 ].
			^requestTimeoutMs
		)
		effectiveToolTimeoutMs ^<Integer> = (
			toolTimeoutMs isNil ifTrue: [ ^180000 ].
			^toolTimeoutMs
		)
		timeoutReason: what <String> ms: ms <Integer> ^<String> = (
			^what , ' timed out after ' , (ms // 1000) printString , 's. The turn was abandoned; nothing further will arrive from it. Retry re-drives this turn from the last recorded message.'
		)
		public repairHistory ^<Boolean> = (
			(* Make the history valid to send again after a failed turn, by
	   answering any tool calls that were announced but never executed.
	   Answers whether anything needed repair. Never raises: a repair
	   that fails must not take down the send that called it. *)
			
			^[ provider repairTrailingToolUseIn: apiMessages ] on: Exception
				do: [:e | false ]
		)
		public canRetry ^<Boolean> = (
			(* There is something to re-drive exactly when the conversation is
	   non-empty. *)
			
			^apiMessages isEmpty not
		)
		lastAssistantText ^<String> = (
			(* The most recent assistant text in the display projection, or ''.
	   Used as retryLastTurn's value when the turn had in fact
	   completed. *)
			
			| msgs <List> i <Integer> |
			msgs:: [ displayMessages ] on: Exception do: [:e | List new ].
			i:: msgs size.
			[ i > 0 ] whileTrue: [
					| m <Array> |
					m:: msgs at: i.
					(m at: 1) = 'assistant' ifTrue: [ ^m at: 2 ].
					i:: i - 1
				].
			^''
		)
		public displayMessages ^<List> = (
			(* Returns a List of {role <String>, text <String>} tuples for UI
	   rendering, in conversation order. Skips entries that don't have
	   displayable text (tool results, etc.). *)
			
			^provider displayMessagesFromMessages: apiMessages
		)
		public clearHistory = (
			(* Reset the conversation history. The provider config (model, key)
	   is untouched — the next sendMessage: starts a fresh conversation
	   on the same provider. *)
			
			apiMessages removeAll.
			notifyUpdate
		)
		nowMs ^<Number> = (
			(* JS wall-clock milliseconds, for phase timing; 0 if the bridge is not live. *)
			
			^[ (global at: 'Date') now ] on: Exception do: [:e | 0 ]
		)
		enterPhase: p <String> = (
			(* Record what the turn is doing right now and when that began, then let
	   the UI know. Short of true streaming, this is the only mid-turn signal
	   a status view has. *)
			
			phase:: p.
			phaseStartedAt:: nowMs.
			notifyUpdate
		)
		addTurnNotice: text <String> = (
			(* Queue a user-facing line about something that happened inside this
	   turn which the model's own text may not report (output truncated, tool
	   call refused). The chat surface drains these with takeTurnNotices when
	   the turn settles, so the user sees them whether or not the model
	   chose to mention them. *)
			
			turnNotices add: text.
			notifyUpdate
		)
		public takeTurnNotices ^<List[String]> = (
			(* Hand over and clear the notices accumulated during the current turn. *)
			
			| taken <List[String]> = List new. |
			turnNotices do: [:n <String> | taken add: n ].
			turnNotices removeAll.
			^taken
		)
		beginTurn = (
			(* Reset per-turn bookkeeping at the start of a send or retry. *)
			
			truncationsThisTurn:: 0.
			enterPhase: 'waiting for model'
		)
		recordUsageFrom: response <Alien> = (
			(* Fold one response's token usage and stop reason into the running
	   totals. Never raises: accounting must not take down a turn. *)
			
			| u |
			requestCount:: requestCount + 1.
			lastStopReason:: [ provider stopReasonOf: response ] on: Exception
				do: [:e | nil ].
			u:: [ provider usageOf: response ] on: Exception do: [:e | nil ].
			u isNil ifTrue: [ ^self ].
			lastUsage:: u.
			[
				| cost |
				cost:: provider costOfUsage: u.
				cost isNil ifFalse: [
						lastCostUsd:: cost.
						totalCostUsd:: totalCostUsd + cost
					]
			] on: Exception do: [:e | nil ].
			totalInputTokens:: totalInputTokens + (u at: #input ifAbsent: [ 0 ]).
			totalOutputTokens:: totalOutputTokens + (u at: #output ifAbsent: [ 0 ]).
			totalCacheReadTokens:: totalCacheReadTokens + (u at: #cacheRead
				ifAbsent: [ 0 ]).
			totalCacheWriteTokens:: totalCacheWriteTokens + (u at: #cacheWrite
				ifAbsent: [ 0 ])
		)
		maxTruncationsPerTurn ^<Integer> = (
			(* How many times in one turn the model may hit max_tokens mid-tool-call
	   before we stop re-prompting it and hand the turn back to the user. *)
			
			^2
		)
		inputExcerptOf: toolUseBlock <Alien> ^<String> = (
			(* The call's input as it arrived, JSON-serialised and clipped, so a
	   truncation message can show exactly which fields made it through. *)
			
			| dump <String> |
			dump:: [ JSON stringify: (toolUseBlock at: 'input') ] on: Exception
				do: [:e | nil ].
			dump isNil ifTrue: [ ^'(unavailable)' ].
			dump size > 300 ifTrue: [ dump:: (dump copyFrom: 1 to: 300) , '…' ].
			^dump
		)
		refuseTruncatedToolCall: toolUseBlock <Alien> ^<Alien[Promise]> = (
			(* The model exhausted maxTokens while still emitting this call, so the
	   input we hold is a prefix of what it meant to send. Running it would
	   feed a handler garbage (an undefined document body, a half method).
	   Instead answer an is_error tool_result that says precisely what
	   happened and what arrived, and queue a notice for the user. *)
			
			| id name excerpt msg |
			id:: [ toolUseBlock at: 'id' ] on: Exception do: [:e | nil ].
			name:: [ toolUseBlock at: 'name' ] on: Exception do: [:e | nil ].
			name isNil ifTrue: [ name:: '(unknown tool)' ].
			excerpt:: inputExcerptOf: toolUseBlock.
			msg:: 'Truncated: your output hit the token limit (max_tokens = ' , maxTokens printString , ') while you were still emitting the input for this ' , name , ' call. The tool was NOT run. Input received: ' , excerpt , '. Do not re-emit the same call: send a smaller payload (split the write, or use a patch-style tool that sends only the changed part), or tell the user the content is too large for one call.'.
			addTurnNotice: 'Model output was cut off at the ' , maxTokens printString , '-token limit while emitting a ' , name , ' call; the call was not executed. Input received: ' , excerpt.
			^JSPromise resolve: (toolResultFor: id handlerValue: msg isError: true)
		)
		missingRequiredInputsFor: tool <Tool> in: input <Alien> ^<String> = (
			(* Names of the tool schema's `required` fields absent from input, comma
	   separated; '' when all present or when the schema cannot be read. A
	   handler must never see an input missing a required field — that is how
	   a truncated call turned into a lost promise and a silent chat. *)
			
			| schema required len missing <String> |
			schema:: [ JSON parse: tool inputSchema ] on: Exception do: [:e | nil ].
			required:: safeAt: schema field: 'required'.
			len:: safeAt: required field: 'length'.
			missing:: ''.
			len isNil ifTrue: [ ^missing ].
			0 to: len - 1
				do: [:i <Integer> |
					| k present |
					k:: safeStringAt: required field: i.
					present:: [ input isNil not and: [ input includesKey: k ] ] on: Exception
						do: [:e | false ].
					(k isNil or: [ present ]) ifFalse: [
							missing:: missing isEmpty ifTrue: [ k ] ifFalse: [ missing , ', ' , k ]
						]
				].
			^missing
		)
		toolNamesOf: toolBlocks <List> ^<String> = (
			(* Comma-separated tool names of a round's tool-use blocks, for the phase
		   display. NB: names must be a MUTABLE temp (::=) — an immutable `=` temp
		   has no setter, so `names::` compiles to a doesNotUnderstand send. *)
			
			| names <String> ::= ''. |
			toolBlocks do: [:tb |
					| n |
					n:: [ tb at: 'name' ] on: Exception do: [:e | nil ].
					n isNil ifTrue: [ n:: '?' ].
					names:: names isEmpty ifTrue: [ n ] ifFalse: [ names , ', ' , n ]
				].
			^names
		)
		completeWithToolLoop ^<Alien[Promise]> = (
			(* One turn of the conversation, recursing through tool-use rounds. Ships
	   apiMessages to the provider, appends the assistant response, records
	   usage, and either executes the tool calls and recurses, or resolves
	   with the assistant's text.

	   Truncation: if the provider reports the model stopped at maxTokens, any
	   tool_use blocks are prefixes of what the model meant to send, so they
	   are REFUSED (refuseTruncatedToolCall:) rather than executed — the model
	   gets an is_error result explaining why, the user gets a turn notice.
	   After maxTruncationsPerTurn refusals in one turn we stop recursing and
	   hand the turn back rather than loop.

	   The whole then-body is wrapped in on:Exception do: returning a
	   Promise.reject: a raise unwinding out of a then-closure is LOST by the
	   JS-Promise bridge (see NEWSPEAK_JS_PROMISE_NOTES_2026-05-18.md). *)
			
			enterPhase: 'waiting for model'.
			^(withWatchdog: (provider complete: (provider messagesAsRequestPayload: apiMessages)
					system: systemPrompt
					notices: pendingSystemNotices
					tools: (provider buildToolsPayload: toolDefs)
					maxTokens: maxTokens)
				ms: effectiveRequestTimeoutMs
				reason: (timeoutReason: 'The AI request' ms: effectiveRequestTimeoutMs)) then: [:response |
					| stage <String> |
					stage:: 'start of then'.
					[
						| truncated <Boolean> |
						stage:: 'appendAssistantResponse:'.
						provider appendAssistantResponse: response toMessages: apiMessages.
						stage:: 'recordUsageFrom:'.
						recordUsageFrom: response.
						truncated:: [ provider wasTruncated: response ] on: Exception
							do: [:e | false ].
						truncated ifTrue: [ truncationsThisTurn:: truncationsThisTurn + 1 ].
						stage:: 'hasToolUse:'.
						(provider hasToolUse: response) ifTrue: [
								| toolBlocks <List> promises <Alien[Array]> |
								stage:: 'toolUseBlocksFrom:'.
								toolBlocks:: provider toolUseBlocksFrom: response.
								promises:: createJSArray.
								truncated ifTrue: [
										stage:: 'refuseTruncatedToolCall: dispatch'.
										toolBlocks do: [:tb <Alien> |
												promises push: (refuseTruncatedToolCall: tb)
											]
									]
									ifFalse: [
										stage:: 'executeToolCall: dispatch'.
										enterPhase: 'running ' , (toolNamesOf: toolBlocks).
										toolBlocks do: [:tb <Alien> | promises push: (executeToolCall: tb) ]
									].
								stage:: 'Promise.all then'.
								(withWatchdog: (JSPromise all: promises)
									ms: effectiveToolTimeoutMs
									reason: (timeoutReason: 'Tool execution' ms: effectiveToolTimeoutMs)) then: [:results <Alien[Array]> |
										| innerStage <String> |
										innerStage:: 'addToolResults:toMessages:'.
										[
											provider addToolResults: results toMessages: apiMessages.
											notifyUpdate.
											(truncated and: [ truncationsThisTurn >= maxTruncationsPerTurn ]) ifTrue: [
													innerStage:: 'truncation limit'.
													addTurnNotice: 'Turn stopped: the model''s output was cut off ' , truncationsThisTurn printString , ' times in a row. Ask it to proceed in smaller steps, or raise the session''s maxTokens.'.
													enterPhase: 'idle'.
													''
												]
												ifFalse: [
													innerStage:: 'recursive completeWithToolLoop'.
													completeWithToolLoop
												]
										] on: Exception
											do: [:e |
												notifyUpdate.
												JSPromise reject: '[stage: ' , innerStage , '] ' , (errorDescription: e)
											]
									]
							]
							ifFalse: [
								stage:: 'no tool use'.
								truncated ifTrue: [
										addTurnNotice: 'The model''s reply was cut off at the ' , maxTokens printString , '-token limit.'
									].
								enterPhase: 'idle'.
								stage:: 'extractTextFromResponse:'.
								provider extractTextFromResponse: response
							]
					] on: Exception
						do: [:e |
							| dump |
							notifyUpdate.
							
							(* The raw provider response is the single most useful diagnostic
			   for protocol drift; include it so the user can paste it verbatim. *)
							dump:: [ JSON stringify: response ] on: Exception
								do: [:e2 | '(unstringifiable response)' ].
							JSPromise reject: '[stage: ' , stage , '] ' , (errorDescription: e) , ' | response: ' , dump
						]
				]
		)
		executeToolCall: toolUseBlock <Alien> ^<Alien[Promise]> = (
			(* Resolve a tool-use block ('id', 'name', 'input' by provider contract)
	   to a tool-result promise. Handlers may answer a value or a promise;
	   both are normalised here. Every failure — unknown tool, missing
	   required input, handler raise, rejected handler promise — becomes an
	   is_error tool_result the model sees next round, never a hang.

	   Required-input check: a handler must never see an input missing a
	   schema-required field. That is how a truncated set_document_contents
	   call fed an undefined body into a document, raised inside a JS
	   callback, and lost the turn's promise — a silent chat. *)
			
			| toolName <String | UndefinedObject> input <Alien> tool <Tool | UndefinedObject> id <String | UndefinedObject> resultOrPromise stage <String> safeId <String> missing <String> |
			stage:: 'read id'.
			[
				id:: toolUseBlock at: 'id'.
				stage:: 'read name'.
				toolName:: toolUseBlock at: 'name'.
				stage:: 'read input'.
				input:: toolUseBlock at: 'input'
			] on: Exception
				do: [:e |
					| dump |
					dump:: [ JSON stringify: toolUseBlock ] on: Exception
						do: [:e2 | '(unstringifiable)' ].
					^JSPromise reject: '[executeToolCall stage: ' , stage , '] ' , (errorDescription: e) , ' | block: ' , dump
				].
			safeId:: id isNil ifTrue: [ '(no id)' ] ifFalse: [ id ].
			toolName isNil ifTrue: [
					| dump |
					dump:: [ JSON stringify: toolUseBlock ] on: Exception
						do: [:e2 | '(unstringifiable)' ].
					^JSPromise reject: 'Tool call missing name field | block: ' , dump
				].
			tool:: toolMap at: toolName
				ifAbsent: [
					^JSPromise resolve: (toolResultFor: safeId
							handlerValue: 'Unknown tool: ' , toolName
							isError: true)
				].
			missing:: missingRequiredInputsFor: tool in: input.
			missing isEmpty ifFalse: [
					addTurnNotice: 'Tool call ' , toolName , ' rejected: missing required input ' , missing , '. The call was not executed.'.
					^JSPromise resolve: (toolResultFor: safeId
							handlerValue: 'Rejected: this ' , toolName , ' call is missing required input field(s): ' , missing , '. The tool was NOT run. Input received: ' , (inputExcerptOf: toolUseBlock)
							isError: true)
				].
			resultOrPromise:: [ tool handler value: input ] on: Exception
				do: [:e |
					| msg <String> |
					
					(* Some exceptions raise when sent messageText; be defensive. *)
					msg:: [ 'Error: ' , e messageText ] on: Exception
						do: [:e2 |
							[ 'Error: ' , e printString ] on: Exception
								do: [:e3 | 'Error: <unprintable exception>' ]
						].
					^JSPromise resolve: (toolResultFor: id handlerValue: msg isError: true)
				].
			(resultOrPromise isKindOfJSAlien and: [ resultOrPromise includesKey: 'then' ]) ifTrue: [
					^resultOrPromise then: [:result |
							toolResultFor: id handlerValue: result isError: false
						]
						onError: [:err |
							toolResultFor: id handlerValue: 'Error: ' , err printString isError: true
						]
				].
			^JSPromise resolve: (toolResultFor: id
					handlerValue: resultOrPromise
					isError: false)
		)
		public sendMessage: text <String> ^<Alien[Promise]> = (
			(* User-facing entry: append the user's text, drive the tool loop, answer
	   a Promise of the assistant's final text. repairHistory first, so a
	   turn that died mid-tool-loop does not poison every later request.
	   The phase is reset to idle however the turn settles. *)
			
			repairHistory.
			provider addUserText: text toMessages: apiMessages.
			beginTurn.
			^completeWithToolLoop then: [:responseText <String> |
					pendingSystemNotices removeAll.
					enterPhase: 'idle'.
					responseText
				]
				onError: [:err |
					enterPhase: 'idle'.
					JSPromise reject: err
				]
		)
		public sendMessage: text <String> attachments: docs <List> ^<Alien[Promise]> = (
			(* As sendMessage:, with document attachments ({filename. content} tuples)
	   forwarded to the provider's addUserText:documents:toMessages:. *)
			
			repairHistory.
			provider addUserText: text documents: docs toMessages: apiMessages.
			beginTurn.
			^completeWithToolLoop then: [:responseText <String> |
					pendingSystemNotices removeAll.
					enterPhase: 'idle'.
					responseText
				]
				onError: [:err |
					enterPhase: 'idle'.
					JSPromise reject: err
				]
		)
		public retryLastTurn ^<Alien[Promise]> = (
			(* Re-drive the current turn with no new user message. If the history
	   ends with a user or tool-result message the model never answered, so
	   re-enter the tool loop; if it ends with an assistant message the model
	   did answer and the turn died afterwards, so resolve with that text. *)
			
			| role <String | UndefinedObject> |
			apiMessages isEmpty ifTrue: [
					^JSPromise reject: 'Nothing to retry: this conversation has no messages yet.'
				].
			repairHistory.
			notifyUpdate.
			role:: [ provider lastMessageRoleIn: apiMessages ] on: Exception
				do: [:e | nil ].
			role = 'assistant' ifTrue: [ ^JSPromise resolve: lastAssistantText ].
			beginTurn.
			^completeWithToolLoop then: [:responseText <String> |
					pendingSystemNotices removeAll.
					enterPhase: 'idle'.
					responseText
				]
				onError: [:err |
					enterPhase: 'idle'.
					JSPromise reject: err
				]
		)
	) : ()
	public class GeminiProvider apiKey: key <String> model: mdl <String> = Provider new (
		(* Provider for Google's Gemini API. Conversation messages are stored in
 Gemini's native shape:

   user message:      {role: 'user',  parts: [{text: '...'}]}
   assistant message: {role: 'model', parts: [{text: '...'}, ...]}

 The 'model' role is mapped to 'assistant' for UI rendering. complete:
 ships these straight into the request body without per-turn translation.
 The response is returned as Gemini's raw JSON;
 appendAssistantResponse: and extractTextFromResponse: navigate it
 directly via safeAt:.

 Tool calls (Gemini function-calling) are translated to and from
 Anthropic's tool-block surface so Session.completeWithToolLoop works
 uniformly across providers:

   - Outgoing: buildToolsPayload: wraps the IDE's Tool list as
     [{functionDeclarations: [...]}]. Gemini's declaration shape uses
     'parameters' rather than Anthropic's 'input_schema'.
   - Incoming functionCall parts: toolUseBlocksFrom: builds shim JS
     objects with 'id', 'name', 'input' top-level fields so the
     Session can dispatch them with no Gemini-specific path. Gemini
     does not issue tool-call ids of its own, so we synthesise one
     ('gem-N') per call and stash the call's name in pendingCallNames
     so makeToolResult: can recover it. The map is replaced (not
     accumulated) at the start of each tool-loop round.
   - Outgoing tool results: makeToolResult: builds a functionResponse
     part; addToolResults:toMessages: wraps the round's parts into a
     user-role message ({role: 'user', parts: [...]}).

 Quirks:
   - Free-tier accounts hit aggressive rate limiting (429s).
   - Gemini intermittently returns a 200-OK with empty body ({}); see
     attemptComplete:'s retry logic. *)
		
		|
			public apiKey <String> ::= key.
			public model <String> ::= mdl.
			private toolCallCounter <Integer> ::= 0.
			private pendingCallNames <Map[String, String]> ::= Map new.
		|
	) (
		public staticFallbackModels ^<List[String]> = (
			(* Hardcoded list shipped in this build, used when no localStorage
	   cache is available. The Gemini model set drifts faster than this
	   code can track — when refreshAvailableModels resolves, the cache
	   supersedes this. *)
			
			^{'gemini-3.1-pro-preview'. 'gemini-3.5-flash'. 'gemini-3-flash-preview'. 'gemini-3.1-flash-lite'. 'gemini-2.5-pro'. }
		)
		public staticDisplayNameFor: modelId <String> ^<String> = (
			modelId = 'gemini-3.1-pro-preview' ifTrue: [ ^'Gemini 3.1 Pro (preview)' ].
			modelId = 'gemini-3.5-flash' ifTrue: [ ^'Gemini 3.5 Flash' ].
			modelId = 'gemini-3-flash-preview' ifTrue: [ ^'Gemini 3 Flash (preview)' ].
			modelId = 'gemini-3.1-flash-lite' ifTrue: [ ^'Gemini 3.1 Flash Lite' ].
			modelId = 'gemini-2.5-pro' ifTrue: [ ^'Gemini 2.5 Pro' ].
			^modelId
		)
		public listModelsEndpoint ^<String> = (
			^'https://generativelanguage.googleapis.com/v1beta/models'
		)
		public fetchAvailableModelsFromAPI ^<Alien[Promise]> = (
			(* GET /v1beta/models with the x-goog-api-key header. Returns the raw
	   parsed body Promise. Filtering + 'models/' prefix stripping happens
	   in parseListModelsResponse: one level up, NOT nested here. *)
			
			| headers options |
			headers:: createJSObject.
			headers at: 'x-goog-api-key' put: apiKey.
			options:: createJSObject.
			options at: 'method' put: 'GET'.
			options at: 'headers' put: headers.
			^(global fetch: listModelsEndpoint with: options) then: [:response |
					[
						| status statusText |
						status:: safeAt: response field: 'status'.
						statusText:: safeAt: response field: 'statusText'.
						statusText isNil ifTrue: [ statusText:: '' ].
						(status isNil or: [ status >= 400 ]) ifTrue: [
								JSPromise reject: 'Gemini list-models error: ' , (status isNil ifTrue: [
											'(no status)'
										]
										ifFalse: [ status printString ]) , ' ' , statusText
							]
							ifFalse: [ response json ]
					] on: Exception
						do: [:e |
							JSPromise reject: 'Gemini list-models error: ' , (errorDescription: e)
						]
				]
		)
		public parseListModelsResponse: body <Alien> ^<List> = (
			(* Walk the models array, filter to entries that support
	   generateContent, strip the 'models/' prefix from name. *)
			
			| models mlen tuples |
			models:: safeAt: body field: 'models'.
			mlen:: safeAt: models field: 'length'.
			mlen isNil ifTrue: [
					Error signal: 'Gemini list-models response missing models array'
				].
			tuples:: List new.
			0 to: mlen - 1
				do: [:i <Integer> |
					| entry rawName supported supportsGen id dn |
					entry:: safeAt: models field: i.
					supported:: safeAt: entry field: 'supportedGenerationMethods'.
					supportsGen:: supportsGenerateContent: supported.
					supportsGen ifTrue: [
							rawName:: safeStringAt: entry field: 'name'.
							dn:: safeStringAt: entry field: 'displayName'.
							dn isNil ifTrue: [ dn:: '' ].
							id:: stripModelsPrefix: rawName.
							id isNil ifFalse: [ tuples add: {id. dn. } ]
						]
				].
			^tuples
		)
		supportsGenerateContent: methods <Alien[Array] | UndefinedObject> ^<Boolean> = (
			(* True iff the array contains the string 'generateContent'. Defensive
	   against missing/short arrays. *)
			
			| len |
			len:: safeAt: methods field: 'length'.
			len isNil ifTrue: [ ^false ].
			0 to: len - 1
				do: [:i <Integer> |
					(safeStringAt: methods field: i) = 'generateContent' ifTrue: [ ^true ]
				].
			^false
		)
		stripModelsPrefix: rawName <String | UndefinedObject> ^<String | UndefinedObject> = (
			(* Gemini's 'name' field is 'models/gemini-...'; the generateContent
	   URL uses just the suffix. Return nil if rawName is nil or doesn't
	   start with the expected prefix. *)
			
			| prefix |
			rawName isNil ifTrue: [ ^nil ].
			prefix:: 'models/'.
			(rawName startsWith: prefix) ifFalse: [ ^rawName ].
			^rawName copyFrom: prefix size + 1 to: rawName size
		)
		public addUserText: text <String> toMessages: messages <List> = (
			| userMsg <Alien> parts <Alien[Array]> textPart <Alien> |
			parts:: createJSArray.
			textPart:: createJSObject.
			textPart at: 'text' put: text.
			parts push: textPart.
			userMsg:: createJSObject.
			userMsg at: 'role' put: 'user'.
			userMsg at: 'parts' put: parts.
			messages add: userMsg
		)
		public appendAssistantResponse: response <Alien> toMessages: messages <List> = (
			(* Walk candidates[0].content.parts. safeAt: returns nil on any
	   missing/malformed level and cascades through subsequent safeAt:
	   calls (which short-circuit on nil receiver), so a single terminal
	   isNil check covers every way the response can be unusable: no
	   candidates, empty candidates array (safety block, the {} anomaly
	   we retried, etc.), missing content, missing parts. The raw
	   response is dumped in missingFieldError: for diagnosis. *)
			
			| candidates firstCandidate firstContent parts assistantMsg <Alien> |
			candidates:: safeAt: response field: 'candidates'.
			firstCandidate:: safeAt: candidates field: 0.
			firstContent:: safeAt: firstCandidate field: 'content'.
			parts:: safeAt: firstContent field: 'parts'.
			parts isNil ifTrue: [
					^missingFieldError: 'candidates[0].content.parts' on: response
				].
			assistantMsg:: createJSObject.
			assistantMsg at: 'role' put: 'model'.
			assistantMsg at: 'parts' put: parts.
			messages add: assistantMsg
		)
		missingFieldError: field <String> on: response <Alien> = (
			(* Raise with the field name and the raw response stringified so the
	   user has all the diagnostic context (safety block details, error
	   bodies, model-deprecation messages, etc.) in one error string.
	   The Session.completeWithToolLoop on:Exception backstop converts
	   the raise to a JS Promise rejection. *)
			
			| stringified <String> |
			stringified:: [ (global at: 'JSON') stringify: response ] on: Exception
				do: [:e | '(unstringifiable response)' ].
			Error signal: 'Gemini response missing ' , field , '. Raw: ' , stringified
		)
		public messagesAsRequestPayload: messages <List> ^<Alien[Array]> = (
			(* apiMessages already holds Gemini-shaped entries; just JSArray-ify. *)
			
			| arr <Alien[Array]> |
			arr:: createJSArray.
			messages do: [:m | arr push: m ].
			^arr
		)
		public extractTextFromResponse: response <Alien> ^<String> = (
			(* Defensive walk of candidates[0].content.parts. Returns '' if any
	   level is absent or malformed, rather than raising into the user's
	   chat. (appendAssistantResponse: surfaces shape problems instead;
	   this method is purely for "what's the text payload?".) *)
			
			| candidates length firstCandidate firstContent parts result <String> text plen |
			result:: ''.
			candidates:: safeAt: response field: 'candidates'.
			length:: safeAt: candidates field: 'length'.
			(length isNil or: [ length = 0 ]) ifTrue: [ ^result ].
			firstCandidate:: safeAt: candidates field: 0.
			firstContent:: safeAt: firstCandidate field: 'content'.
			parts:: safeAt: firstContent field: 'parts'.
			plen:: safeAt: parts field: 'length'.
			plen isNil ifTrue: [ ^result ].
			0 to: plen - 1
				do: [:i <Integer> |
					| part |
					part:: safeAt: parts field: i.
					text:: safeStringAt: part field: 'text'.
					text isNil ifFalse: [ result:: result , text ]
				].
			^result
		)
		public displayMessagesFromMessages: messages <List> ^<List> = (
			(* Walks apiMessages — entries we constructed ourselves via
	   addUserText: / appendAssistantResponse: / addToolResults:.
	   functionCall parts (assistant side, after tool use) and
	   functionResponse parts (user side, tool-result messages) carry no
	   text. safeStringAt: guarantees we get nil-or-real-String, never
	   JS undefined (which sneaks past isNil and crashes String concat). *)
			
			| result <List> |
			result:: List new.
			messages do: [:msg <Alien> |
					| role <String> displayRole <String> parts <Alien[Array]> text <String> plen |
					role:: msg at: 'role'.
					displayRole:: role = 'model' ifTrue: [ 'assistant' ] ifFalse: [ role ].
					parts:: msg at: 'parts'.
					text:: ''.
					plen:: safeAt: parts field: 'length'.
					plen isNil ifFalse: [
							0 to: plen - 1
								do: [:i <Integer> |
									| t |
									t:: safeStringAt: (safeAt: parts field: i) field: 'text'.
									t isNil ifFalse: [ text:: text , t ]
								]
						].
					text isEmpty ifFalse: [ result add: {displayRole. text. } ]
				].
			^result
		)
		responsePartsOf: response <Alien> ^<Alien | UndefinedObject> = (
			(* Pull candidates[0].content.parts defensively. Used by hasToolUse:
	   and toolUseBlocksFrom: to find functionCall parts. Returns nil if
	   any level is missing or malformed. *)
			
			| candidates firstCandidate firstContent |
			candidates:: safeAt: response field: 'candidates'.
			firstCandidate:: safeAt: candidates field: 0.
			firstContent:: safeAt: firstCandidate field: 'content'.
			^safeAt: firstContent field: 'parts'
		)
		public supportsFileUploads ^<Boolean> = (
			(* Gemini delivers media as inlineData parts that ride alongside the
	   functionResponse part in the same user-role message. Image/PDF/
	   audio/video are all supported; makeToolResult:textResult:media:
	   isError: handles the split between the functionResponse text and
	   the sibling inlineData parts. *)
			
			^true
		)
		public hasToolUse: response <Alien> ^<Boolean> = (
			(* True if any part in the assistant's response is a functionCall.
	   Gemini does not set a tool-use-specific stop_reason; the only
	   reliable signal is a functionCall part with a non-nil name.

	   Gate on functionCall.name rather than on functionCall itself.
	   Reason: on text-only parts, safeAt: of the missing 'functionCall'
	   field may yield JS undefined rather than Newspeak nil (the alien
	   bridge isn't uniform here — see safeAt:'s docstring), and
	   `undefined isNil` is false, so a functionCall isNil ifFalse:
	   guard incorrectly admits text parts. The two-step safeAt: chain
	   ending in 'name' is reliable because safeAt: short-circuits on
	   nil receivers, and only a real functionCall has a name. *)
			
			| parts plen result |
			parts:: responsePartsOf: response.
			plen:: safeAt: parts field: 'length'.
			plen isNil ifTrue: [ ^false ].
			result:: false.
			0 to: plen - 1
				do: [:i <Integer> |
					| name |
					name:: safeStringAt: (safeAt: (safeAt: parts field: i)
							field: 'functionCall')
						field: 'name'.
					name isNil ifFalse: [ result:: true ]
				].
			^result
		)
		public toolUseBlocksFrom: response <Alien> ^<List> = (
			(* Collect every functionCall part as a shim JS object that exposes
	   'id', 'name', 'input' at the top level — matching Anthropic's
	   tool_use block surface so Session.executeToolCall: needs no
	   provider-specific path. Synthesise an opaque id per call and
	   remember it under pendingCallNames so makeToolResult: can recover
	   the function name (Gemini matches function responses to calls by
	   name, not id; the id is purely a Session-side handle). The map
	   is reset here so previous-round entries don't accumulate. *)
			
			| parts plen blocks |
			pendingCallNames:: Map new.
			blocks:: List new.
			parts:: responsePartsOf: response.
			plen:: safeAt: parts field: 'length'.
			plen isNil ifTrue: [ ^blocks ].
			0 to: plen - 1
				do: [:i <Integer> |
					| part fc name args id shim |
					part:: safeAt: parts field: i.
					fc:: safeAt: part field: 'functionCall'.
					name:: safeStringAt: fc field: 'name'.
					
					(* Gate on a non-nil name, not on fc — see hasToolUse: rationale.
		   On text parts the missing functionCall surfaces as JS
		   undefined that fails isNil, so a `fc isNil ifFalse:` guard
		   would let text parts through and produce malformed shims. *)
					name isNil ifFalse: [
							args:: safeAt: fc field: 'args'.
							args isNil ifTrue: [ args:: createJSObject ].
							toolCallCounter:: toolCallCounter + 1.
							id:: 'gem-' , toolCallCounter printString.
							pendingCallNames at: id put: name.
							shim:: createJSObject.
							shim at: 'id' put: id.
							shim at: 'name' put: name.
							shim at: 'input' put: args.
							blocks add: shim
						]
				].
			^blocks
		)
		public makeToolResult: id <String> textResult: text <String> media: mediaParts <Alien[Array]> isError: err <Boolean> ^<Alien[Array]> = (
			(* Build the Gemini parts for one tool call: a functionResponse part
	   carrying the text, followed by an inlineData part per supported
	   media item. Returned as an array because Gemini delivers media as
	   sibling parts in the same user-role message (not inside the
	   functionResponse, whose response field is JSON-only). The whole
	   array is later flattened by addToolResults:toMessages: into the
	   round's parts list.

	   Gemini accepts image/*, audio/*, video/*, and application/pdf as
	   inlineData. Other MIME types are dropped with a notice appended
	   to the functionResponse text. Filenames have no native slot in
	   inlineData, so they're surfaced via an 'Attached files: ...' line
	   added to the text so the model can refer to them by name.

	   Gemini has no standard is_error flag; convention is to put the
	   failure text under 'error' instead of 'result'. The function name
	   is recovered from pendingCallNames; missing id falls back to
	   'unknown' so the response still carries useful diagnostics. *)
			
			| parts name funcResp funcRespPart respBody finalText skippedNotes namedList inlineParts mlen |
			name:: pendingCallNames at: id ifAbsent: [ 'unknown' ].
			finalText:: text.
			skippedNotes:: ''.
			namedList:: ''.
			inlineParts:: List new.
			mlen:: safeAt: mediaParts field: 'length'.
			mlen isNil ifTrue: [ mlen:: 0 ].
			0 to: mlen - 1
				do: [:i <Integer> |
					| m mime b64 mname inlinePart inlineData label |
					m:: mediaParts at: i.
					mime:: safeStringAt: m field: 'mimeType'.
					mime isNil ifTrue: [ mime:: '' ].
					b64:: safeStringAt: m field: 'dataBase64'.
					b64 isNil ifTrue: [ b64:: '' ].
					mname:: safeStringAt: m field: 'name'.
					mname isNil ifTrue: [ mname:: '' ].
					((mime startsWith: 'image/') or: [
							(mime startsWith: 'audio/') or: [
									(mime startsWith: 'video/') or: [ mime = 'application/pdf' ]
								]
						]) ifTrue: [
							inlineData:: createJSObject.
							inlineData at: 'mimeType' put: mime.
							inlineData at: 'data' put: b64.
							inlinePart:: createJSObject.
							inlinePart at: 'inlineData' put: inlineData.
							inlineParts add: inlinePart.
							mname isEmpty ifFalse: [
									namedList:: namedList isEmpty ifTrue: [ mname ]
										ifFalse: [ namedList , ', ' , mname ]
								]
						]
						ifFalse: [
							label:: mname isEmpty ifTrue: [ mime ]
								ifFalse: [ mname , ' (' , mime , ')' ].
							skippedNotes:: skippedNotes isEmpty ifTrue: [ label ]
								ifFalse: [ skippedNotes , ', ' , label ]
						]
				].
			namedList isEmpty ifFalse: [
					finalText:: finalText , String lf , 'Attached files: ' , namedList
				].
			skippedNotes isEmpty ifFalse: [
					finalText:: finalText , String lf , '[note: skipped attachments with media type not supported by Gemini: ' , skippedNotes , ']'
				].
			respBody:: createJSObject.
			err ifTrue: [ respBody at: 'error' put: finalText ]
				ifFalse: [ respBody at: 'result' put: finalText ].
			funcResp:: createJSObject.
			funcResp at: 'name' put: name.
			funcResp at: 'response' put: respBody.
			funcRespPart:: createJSObject.
			funcRespPart at: 'functionResponse' put: funcResp.
			parts:: createJSArray.
			parts push: funcRespPart.
			inlineParts do: [:p | parts push: p ].
			^parts
		)
		public buildToolsPayload: toolDefs <List[Tool]> ^<Alien[Array] | UndefinedObject> = (
			(* Gemini's tools field shape: [{functionDeclarations: [...]}].
	   Each declaration uses 'parameters' for its JSON Schema rather
	   than Anthropic's 'input_schema'. Returns nil if no tools, so the
	   request body's 'tools' field is omitted. *)
			
			| arr declarations toolEntry |
			toolDefs isEmpty ifTrue: [ ^nil ].
			declarations:: createJSArray.
			toolDefs do: [:t <Tool> |
					| decl |
					decl:: createJSObject.
					decl at: 'name' put: t name.
					decl at: 'description' put: t description.
					decl at: 'parameters' put: (JSON parse: t inputSchema).
					declarations push: decl
				].
			toolEntry:: createJSObject.
			toolEntry at: 'functionDeclarations' put: declarations.
			arr:: createJSArray.
			arr push: toolEntry.
			^arr
		)
		public addToolResults: results <Alien[Array]> toMessages: messages <List> = (
			(* Flatten the per-call parts arrays into one user-role message's
	   parts list. Each entry in results is the JS array produced by
	   makeToolResult:textResult:media:isError:: a functionResponse part
	   followed by zero or more inlineData parts (the media siblings
	   that Gemini delivers alongside the functionResponse in the same
	   wrapping user message). Flattening collapses N arrays-of-parts
	   into one flat parts array, which is the shape Gemini's API
	   expects. *)
			
			| msg parts rlen |
			parts:: createJSArray.
			rlen:: safeAt: results field: 'length'.
			rlen isNil ifTrue: [ rlen:: 0 ].
			0 to: rlen - 1
				do: [:i <Integer> |
					| entry elen |
					entry:: results at: i.
					elen:: safeAt: entry field: 'length'.
					elen isNil ifTrue: [ elen:: 0 ].
					0 to: elen - 1 do: [:j <Integer> | parts push: (entry at: j) ]
				].
			msg:: createJSObject.
			msg at: 'role' put: 'user'.
			msg at: 'parts' put: parts.
			messages add: msg
		)
		public complete: messages <Alien[Array]> system: systemPrompt <String> tools: tools <Alien[Array] | UndefinedObject> maxTokens: maxTokens <Integer> ^<Alien[Promise]> = (
			(* Gemini intermittently returns 200-OK with an empty body ({}) — no
	   candidates field at all. Retry up to 3 attempts before giving up.
	   Safety-blocked responses (candidates present but empty, with
	   promptFeedback) are NOT retried — only the no-candidates case is —
	   since a safety block is a real model decision, not a transient. *)
			
			^attemptComplete: messages
				system: systemPrompt
				tools: tools
				maxTokens: maxTokens
				triesLeft: 3
		)
		attemptComplete: messages <Alien[Array]> system: systemPrompt <String> tools: tools <Alien[Array] | UndefinedObject> maxTokens: maxTokens <Integer> triesLeft: triesLeft <Integer> ^<Alien[Promise]> = (
			(* Single attempt + retry-on-empty. The recursive call is via Promise
	   chaining (return another Promise from a then: block); A+ flattens
	   so the outer Promise still resolves to the eventual response (or
	   the last empty one, when retries are exhausted — at which point
	   appendAssistantResponse: will raise via missingFieldError:). *)
			
			^(doRequest: messages system: systemPrompt tools: tools maxTokens: maxTokens) then: [:response <Alien> |
					| candidates |
					candidates:: safeAt: response field: 'candidates'.
					(candidates isNil and: [ triesLeft > 1 ]) ifTrue: [
							attemptComplete: messages
								system: systemPrompt
								tools: tools
								maxTokens: maxTokens
								triesLeft: triesLeft - 1
						]
						ifFalse: [ response ]
				]
		)
		doRequest: messages <Alien[Array]> system: systemPrompt <String> tools: tools <Alien[Array] | UndefinedObject> maxTokens: maxTokens <Integer> ^<Alien[Promise]> = (
			(* Build the request body, POST to Gemini, return a Promise that
	   resolves to the parsed JSON body (success) or rejects with a
	   diagnostic string (HTTP error or other failure). *)
			
			| body <Alien> headers <Alien> options <Alien> apiUrl <String> |
			body:: createJSObject.
			
			(* messages is already Gemini-shaped (built via addUserText: and
	   appendAssistantResponse:), so it goes straight into the body. *)
			body at: 'contents' put: messages.
			systemPrompt isEmpty ifFalse: [
					| sysInst <Alien> sysParts <Alien[Array]> textPart <Alien> |
					sysInst:: createJSObject.
					sysParts:: createJSArray.
					textPart:: createJSObject.
					textPart at: 'text' put: systemPrompt.
					sysParts push: textPart.
					sysInst at: 'parts' put: sysParts.
					body at: 'systemInstruction' put: sysInst
				].
			tools isNil ifFalse: [
					(tools at: 'length') > 0 ifTrue: [ body at: 'tools' put: tools ]
				].
			apiUrl:: 'https://generativelanguage.googleapis.com/v1beta/models/' , model , ':generateContent'.
			headers:: createJSObject.
			headers at: 'Content-Type' put: 'application/json'.
			headers at: 'x-goog-api-key' put: apiKey.
			options:: createJSObject.
			options at: 'method' put: 'POST'.
			options at: 'headers' put: headers.
			options at: 'body' put: (JSON stringify: body).
			^(global fetch: apiUrl with: options) then: [:response <Alien> |
					[
						| status <Integer | UndefinedObject> statusText <String | UndefinedObject> |
						
						(* Check status as a number (via at:) rather than response.ok.
			   ok is a getter; primordialsoup's alien bridge does not
			   reliably invoke getters via either at: or unary sends. *)
						status:: safeAt: response field: 'status'.
						statusText:: safeAt: response field: 'statusText'.
						statusText isNil ifTrue: [ statusText:: '' ].
						(status isNil or: [ status >= 400 ]) ifTrue: [
								
								(* Return a JS-rejected Promise rather than `Error signal:`.
					   Raising a Newspeak exception inside a closure passed to
					   `jsPromise then:` unwinds non-locally through the alien
					   bridge BEFORE the expat's rawPush: runs, leaving the
					   alien stack in a state where the next chained then-
					   callback receives garbage. Returning Promise.reject(...)
					   keeps the rejection on the JS Promise side, which A+
					   propagates correctly. *)
								JSPromise reject: 'Gemini API error: ' , (status isNil ifTrue: [
											'(no status)'
										]
										ifFalse: [ status printString ]) , ' ' , statusText
							]
							ifFalse: [ response json ]
					] on: Exception
						do: [:e |
							
							(* Backstop: any raise from inside the then-block (e.g. unexpected
			   MNU) becomes a JS-side rejection, never a non-local unwind
			   through the bridge. *)
							JSPromise reject: 'Gemini provider error: ' , (errorDescription: e)
						]
				]
		)
		public stopReasonOf: response <Alien> ^<String | UndefinedObject> = (
			| candidates firstCandidate |
			candidates:: safeAt: response field: 'candidates'.
			firstCandidate:: safeAt: candidates field: 0.
			^safeStringAt: firstCandidate field: 'finishReason'
		)
		public wasTruncated: response <Alien> ^<Boolean> = (
			^(stopReasonOf: response) = 'MAX_TOKENS'
		)
		public usageOf: response <Alien> ^<Map[Symbol, Integer] | UndefinedObject> = (
			| usage |
			usage:: safeAt: response field: 'usageMetadata'.
			usage isNil ifTrue: [ ^nil ].
			^usageInput: (safeAt: usage field: 'promptTokenCount')
				output: (safeAt: usage field: 'candidatesTokenCount')
				cacheRead: (safeAt: usage field: 'cachedContentTokenCount')
				cacheWrite: 0
		)
	) : ()
	public class OpenAICompatibleProvider apiKey: key <String> model: mdl <String> baseUrl: url <String> = Provider new (
		(* Provider for any server speaking OpenAI's chat-completions API:
 Ollama, LM Studio, mlx-omni-server, apple-on-device-openai,
 llama.cpp's HTTP server, etc. — and the OpenAI hosted API itself
 if a user points it there. The base URL is configured per-session.

 Conversation messages are stored in the OpenAI wire shape directly:

   system message:    {role: 'system',    content: '...'}
   user message:      {role: 'user',      content: '...'}
   assistant message: {role: 'assistant', content: '...', tool_calls: [...]}
   tool result:       {role: 'tool',      tool_call_id: '...', content: '...'}

 The system prompt is NOT stored in the history; it is prepended fresh
 on each request (matching Anthropic's complete: shape).

 Tool calls in the assistant message have a quirk: function.arguments
 is a JSON-encoded String, not a JSON object. toolUseBlocksFrom: parses
 each arguments String into an alien object before handing the shim
 to Session.executeToolCall:.

 File uploads are not supported in the OpenAI tool channel (tool result
 content is a String only). The split-message workaround for multimodal
 models is deferred. supportsFileUploads ^false.

 Quirks:
   - Many local servers ignore the Authorization header (no auth needed
     for localhost), but accepting a Bearer prefix is universal.
   - Some servers default to streaming responses; we send stream:false
     explicitly because the IDE has no streaming pipeline.
   - The /models endpoint exists on most servers but isn't strictly
     required by the spec — a 404 or 405 there just leaves the cache
     empty and the model field falls back to the freeform editor. *)
		
		|
			public apiKey <String> ::= key.
			public model <String> ::= mdl.
			public baseUrl <String> ::= url.
		|
	) (
		public staticFallbackModels ^<List[String]> = (
			(* No fallback list — we have no idea what server the user is
	   pointed at or what they have installed. Returning empty lets the
	   setup screen's modelField fall back to the freeform CodeMirror
	   editor on first run, so the user can type any model id manually.
	   Once refreshAvailableModels resolves, the dropdown takes over. *)
			
			^{}
		)
		public staticDisplayNameFor: modelId <String> ^<String> = (
			(* No hardcoded labels — the cache (when present) provides display
	   names; otherwise we show the raw id. *)
			
			^modelId
		)
		public localStorageModelsKey ^<String> = (
			(* Per-baseUrl cache key so switching between Ollama and LM Studio
	   (or any two OpenAI-compat servers) doesn't show stale models from
	   the other one. *)
			
			^'ns_ai_models_' , class name , '_' , baseUrl
		)
		public listModelsEndpoint ^<String> = (
			^baseUrl , '/models'
		)
		public fetchAvailableModelsFromAPI ^<Alien[Promise]> = (
			(* GET {baseUrl}/models with Bearer auth (when a key is set).
	   Returns the raw parsed body Promise. The flat then-shape mirrors
	   AnthropicProvider's fetchAvailableModelsFromAPI — parsing into
	   tuples is done by refreshAvailableModels one level up, not
	   nested here. *)
			
			| headers options |
			headers:: createJSObject.
			apiKey isEmpty ifFalse: [
					headers at: 'Authorization' put: 'Bearer ' , apiKey
				].
			options:: createJSObject.
			options at: 'method' put: 'GET'.
			options at: 'headers' put: headers.
			^(global fetch: listModelsEndpoint with: options) then: [:response |
					[
						| status statusText |
						status:: safeAt: response field: 'status'.
						statusText:: safeAt: response field: 'statusText'.
						statusText isNil ifTrue: [ statusText:: '' ].
						(status isNil or: [ status >= 400 ]) ifTrue: [
								JSPromise reject: 'OpenAI-compat list-models error: ' , (status isNil ifTrue: [
											'(no status)'
										]
										ifFalse: [ status printString ]) , ' ' , statusText
							]
							ifFalse: [ response json ]
					] on: Exception
						do: [:e |
							JSPromise reject: 'OpenAI-compat list-models error: ' , (errorDescription: e)
						]
				]
		)
		public parseListModelsResponse: body <Alien> ^<List> = (
			(* Walk the data array and build {id, displayName} 2-tuples. Standard
	   OpenAI entries are {id, object, created, owned_by, ...}; some
	   local servers add display_name or displayName fields, which we
	   honor when present. *)
			
			| data dlen tuples |
			data:: safeAt: body field: 'data'.
			dlen:: safeAt: data field: 'length'.
			dlen isNil ifTrue: [
					Error signal: 'OpenAI-compat list-models response missing data array'
				].
			tuples:: List new.
			0 to: dlen - 1
				do: [:i <Integer> |
					| entry id dn |
					entry:: safeAt: data field: i.
					id:: safeStringAt: entry field: 'id'.
					dn:: safeStringAt: entry field: 'display_name'.
					dn isNil ifTrue: [ dn:: safeStringAt: entry field: 'displayName' ].
					dn isNil ifTrue: [ dn:: '' ].
					id isNil ifFalse: [ tuples add: {id. dn. } ]
				].
			^tuples
		)
		public complete: messages <Alien[Array]> system: systemPrompt <String> tools: tools <Alien[Array] | UndefinedObject> maxTokens: maxTokens <Integer> ^<Alien[Promise]> = (
			(* POST {baseUrl}/chat/completions. The system prompt is prepended
	   to the messages array fresh on each request (the OpenAI wire
	   format puts the system message in the messages array, not as a
	   separate top-level field like Anthropic does). stream:false is
	   explicit because the IDE has no streaming pipeline. *)
			
			| body headers options url payload sysMsg |
			payload:: createJSArray.
			systemPrompt isEmpty ifFalse: [
					sysMsg:: createJSObject.
					sysMsg at: 'role' put: 'system'.
					sysMsg at: 'content' put: systemPrompt.
					payload push: sysMsg
				].
			0 to: (messages at: 'length') - 1
				do: [:i <Integer> | payload push: (messages at: i) ].
			body:: createJSObject.
			body at: 'model' put: model.
			body at: 'max_tokens' put: maxTokens.
			body at: 'messages' put: payload.
			body at: 'stream' put: false.
			tools isNil ifFalse: [
					(tools at: 'length') > 0 ifTrue: [ body at: 'tools' put: tools ]
				].
			headers:: createJSObject.
			headers at: 'Content-Type' put: 'application/json'.
			apiKey isEmpty ifFalse: [
					headers at: 'Authorization' put: 'Bearer ' , apiKey
				].
			options:: createJSObject.
			options at: 'method' put: 'POST'.
			options at: 'headers' put: headers.
			options at: 'body' put: (JSON stringify: body).
			url:: baseUrl , '/chat/completions'.
			^(global fetch: url with: options) then: [:response |
					[
						| status statusText |
						status:: safeAt: response field: 'status'.
						statusText:: safeAt: response field: 'statusText'.
						statusText isNil ifTrue: [ statusText:: '' ].
						(status isNil or: [ status >= 400 ]) ifTrue: [
								JSPromise reject: 'OpenAI-compat API error: ' , (status isNil ifTrue: [
											'(no status)'
										]
										ifFalse: [ status printString ]) , ' ' , statusText
							]
							ifFalse: [ response json ]
					] on: Exception
						do: [:e |
							JSPromise reject: 'OpenAI-compat provider error: ' , (errorDescription: e)
						]
				]
		)
		public addUserText: text <String> toMessages: messages <List> = (
			| userMsg <Alien> |
			userMsg:: createJSObject.
			userMsg at: 'role' put: 'user'.
			userMsg at: 'content' put: text.
			messages add: userMsg
		)
		firstChoiceMessageOf: response <Alien> ^<Alien | UndefinedObject> = (
			(* Defensive walk of choices[0].message. Used by appendAssistantResponse:,
	   extractTextFromResponse:, hasToolUse:, and toolUseBlocksFrom:. *)
			
			| choices firstChoice |
			choices:: safeAt: response field: 'choices'.
			firstChoice:: safeAt: choices field: 0.
			^safeAt: firstChoice field: 'message'
		)
		firstChoiceFinishReasonOf: response <Alien> ^<String | UndefinedObject> = (
			| choices firstChoice |
			choices:: safeAt: response field: 'choices'.
			firstChoice:: safeAt: choices field: 0.
			^safeStringAt: firstChoice field: 'finish_reason'
		)
		public appendAssistantResponse: response <Alien> toMessages: messages <List> = (
			(* Pull choices[0].message and store it as the assistant entry. The
	   message carries role, content (may be null when tool_calls is
	   present), and tool_calls (when finish_reason='tool_calls'). We
	   store it verbatim so it round-trips on the next request as-is. *)
			
			| message |
			message:: firstChoiceMessageOf: response.
			message isNil ifTrue: [
					Error signal: 'OpenAI-compat response missing choices[0].message'
				].
			messages add: message
		)
		public messagesAsRequestPayload: messages <List> ^<Alien[Array]> = (
			| arr <Alien[Array]> |
			arr:: createJSArray.
			messages do: [:m | arr push: m ].
			^arr
		)
		public extractTextFromResponse: response <Alien> ^<String> = (
			(* OpenAI's assistant message has a single content field (String) or
	   null when only tool_calls were issued. Return '' for the null
	   case rather than raising — appendAssistantResponse: handles
	   shape validation. *)
			
			| message text |
			message:: firstChoiceMessageOf: response.
			text:: safeStringAt: message field: 'content'.
			text isNil ifTrue: [ ^'' ].
			^text
		)
		public displayMessagesFromMessages: messages <List> ^<List> = (
			(* Walk message history producing {role, text} tuples for UI
	   rendering. tool result and assistant-with-tool_calls messages
	   are not shown to the user — they're for the next round-trip. *)
			
			| result <List> |
			result:: List new.
			messages do: [:msg <Alien> |
					| role <String> content text |
					role:: safeStringAt: msg field: 'role'.
					role isNil ifFalse: [
							(role = 'user' or: [ role = 'assistant' ]) ifTrue: [
									content:: safeStringAt: msg field: 'content'.
									content isNil ifFalse: [
											text:: content.
											text isEmpty ifFalse: [ result add: {role. text. } ]
										]
								]
						]
				].
			^result
		)
		public hasToolUse: response <Alien> ^<Boolean> = (
			^(firstChoiceFinishReasonOf: response) = 'tool_calls'
		)
		public toolUseBlocksFrom: response <Alien> ^<List> = (
			(* Collect each tool_call as a shim object exposing {id, name, input}
	   at the top level so Session.executeToolCall: needs no
	   OpenAI-specific path. The 'arguments' field on each tool_call is a
	   JSON-encoded String per the OpenAI spec — we JSON.parse it into a
	   real alien JS object before stuffing it into the shim. *)
			
			| message toolCalls len blocks |
			blocks:: List new.
			message:: firstChoiceMessageOf: response.
			toolCalls:: safeAt: message field: 'tool_calls'.
			len:: safeAt: toolCalls field: 'length'.
			len isNil ifTrue: [ ^blocks ].
			0 to: len - 1
				do: [:i <Integer> |
					| call id fn name argsStr argsObj shim |
					call:: safeAt: toolCalls field: i.
					id:: safeStringAt: call field: 'id'.
					fn:: safeAt: call field: 'function'.
					name:: safeStringAt: fn field: 'name'.
					argsStr:: safeStringAt: fn field: 'arguments'.
					argsObj:: (argsStr isNil or: [ argsStr isEmpty ]) ifTrue: [ createJSObject ]
						ifFalse: [
							[ JSON parse: argsStr ] on: Exception do: [:e | createJSObject ]
						].
					(id isNil or: [ name isNil ]) ifFalse: [
							shim:: createJSObject.
							shim at: 'id' put: id.
							shim at: 'name' put: name.
							shim at: 'input' put: argsObj.
							blocks add: shim
						]
				].
			^blocks
		)
		public makeToolResult: id <String> textResult: text <String> media: mediaParts <Alien[Array]> isError: err <Boolean> ^<Alien> = (
			(* Build a {role: 'tool', tool_call_id: id, content: text} message
	   for one tool call. OpenAI's tool channel carries content as a
	   plain String — no content-block array support — so any media is
	   dropped with a notice appended to the text and any error flag is
	   surfaced by prepending 'Error: ' to the text. *)
			
			| msg finalText skippedNotes mlen |
			finalText:: text.
			skippedNotes:: ''.
			mlen:: safeAt: mediaParts field: 'length'.
			mlen isNil ifTrue: [ mlen:: 0 ].
			0 to: mlen - 1
				do: [:i <Integer> |
					| m mime name label |
					m:: mediaParts at: i.
					mime:: safeStringAt: m field: 'mimeType'.
					mime isNil ifTrue: [ mime:: '' ].
					name:: safeStringAt: m field: 'name'.
					name isNil ifTrue: [ name:: '' ].
					label:: name isEmpty ifTrue: [ mime ] ifFalse: [ name , ' (' , mime , ')' ].
					skippedNotes:: skippedNotes isEmpty ifTrue: [ label ]
						ifFalse: [ skippedNotes , ', ' , label ]
				].
			skippedNotes isEmpty ifFalse: [
					finalText:: finalText , String lf , '[note: skipped attachments — provider does not support media in tool results: ' , skippedNotes , ']'
				].
			err ifTrue: [ finalText:: 'Error: ' , finalText ].
			msg:: createJSObject.
			msg at: 'role' put: 'tool'.
			msg at: 'tool_call_id' put: id.
			msg at: 'content' put: finalText.
			^msg
		)
		public buildToolsPayload: toolDefs <List[Tool]> ^<Alien[Array] | UndefinedObject> = (
			(* OpenAI's tools-array shape: each entry is {type: 'function',
	   function: {name, description, parameters}}. parameters is the
	   parsed JSON Schema object. *)
			
			| arr <Alien[Array]> |
			toolDefs isEmpty ifTrue: [ ^nil ].
			arr:: createJSArray.
			toolDefs do: [:t <Tool> |
					| obj fn |
					fn:: createJSObject.
					fn at: 'name' put: t name.
					fn at: 'description' put: t description.
					fn at: 'parameters' put: (JSON parse: t inputSchema).
					obj:: createJSObject.
					obj at: 'type' put: 'function'.
					obj at: 'function' put: fn.
					arr push: obj
				].
			^arr
		)
		public pendingToolUseIdsIn: messages <List> ^<List[String]> = (
			(* OpenAI-compatible: unanswered calls are the tool_calls of a
	   trailing assistant message. appendAssistantResponse: stores the
	   API's message verbatim, so the ids are the real ones the API
	   expects to see echoed back as tool_call_id. *)
			
			| last <Alien> toolCalls len ids <List[String]> |
			ids:: List new.
			messages isEmpty ifTrue: [ ^ids ].
			last:: messages at: messages size.
			(safeStringAt: last field: 'role') = 'assistant' ifFalse: [ ^ids ].
			toolCalls:: safeAt: last field: 'tool_calls'.
			len:: safeAt: toolCalls field: 'length'.
			len isNil ifTrue: [ ^ids ].
			0 to: len - 1
				do: [:i <Integer> |
					| id |
					id:: safeStringAt: (safeAt: toolCalls field: i) field: 'id'.
					id isNil ifFalse: [ ids add: id ]
				].
			^ids
		)
		public addToolResults: results <Alien[Array]> toMessages: messages <List> = (
			(* OpenAI emits each tool result as its own role:'tool' message.
	   No content-block aggregation, no follow-up user message — flat
	   append. *)
			
			| len |
			len:: safeAt: results field: 'length'.
			len isNil ifTrue: [ ^self ].
			0 to: len - 1 do: [:i <Integer> | messages add: (results at: i) ]
		)
		public supportsFileUploads ^<Boolean> = (
			(* OpenAI's tool channel does not accept media. The split-message
	   workaround (text-only tool result + follow-up user message with
	   image_url parts) is deferred. *)
			
			^false
		)
		public stopReasonOf: response <Alien> ^<String | UndefinedObject> = (
			| choices firstChoice |
			choices:: safeAt: response field: 'choices'.
			firstChoice:: safeAt: choices field: 0.
			^safeStringAt: firstChoice field: 'finish_reason'
		)
		public wasTruncated: response <Alien> ^<Boolean> = (
			^(stopReasonOf: response) = 'length'
		)
		public usageOf: response <Alien> ^<Map[Symbol, Integer] | UndefinedObject> = (
			| usage details |
			usage:: safeAt: response field: 'usage'.
			usage isNil ifTrue: [ ^nil ].
			details:: safeAt: usage field: 'prompt_tokens_details'.
			^usageInput: (safeAt: usage field: 'prompt_tokens')
				output: (safeAt: usage field: 'completion_tokens')
				cacheRead: (safeAt: details field: 'cached_tokens')
				cacheWrite: 0
		)
	) : ()
	lazy public global = js global.
	lazy public JSON = global at: #JSON.
	lazy public JSPromise = global at: #Promise.
	createJSObject ^<Alien> = (
		(* Returns a fresh empty JS object (`{}`) we can populate with at:put:
	   and pass through the alien bridge. We round-trip through JSON.parse
	   rather than calling the JS Object constructor because primordialsoup
	   exposes parsed JSON values as ordinary alien receivers — direct
	   construction of `new Object()` via at:'Object'/new sometimes returns
	   handles that don't accept dynamic property writes the same way. *)
		
		^JSON parse: '{}'
	)
	createJSArray ^<Alien> = (
		(* Sibling to createJSObject — a fresh empty JS Array, supports push:
	   and indexed at:put:. Used for building messages/contents/parts
	   arrays in provider request bodies. *)
		
		^JSON parse: '[]'
	)
	errorDescription: e <Exception> ^<String> = (
		(* Defensive non-nil String description of an exception for
	   error reporting that crosses a String boundary — Promise.reject:
	   and markError: both blow up or surface as 'nil' if the
	   exception's messageText is nil.

	   Order:
	     1. e messageText if non-nil (the author's intent).
	     2. e class name printString — at least the kind of error.
	     3. e printString — last-ditch.
	     4. '<unprintable exception>' if even printString raises.

	   Each step is wrapped so an alien-bridge or method-lookup hiccup
	   at any layer doesn't sink the whole error path. *)
		
		^[
			| mt |
			mt:: [ e messageText ] on: Exception do: [:e2 | nil ].
			mt isNil ifTrue: [
					[ e class name printString ] on: Exception
						do: [:e2 |
							[ e printString ] on: Exception do: [:e3 | '<unprintable exception>' ]
						]
				]
				ifFalse: [ mt ]
		] on: Exception do: [:e4 | '<unprintable exception>' ]
	)
	safeAt: receiver <Object> field: field <String | Integer> = (
		(* Defensive JS field access for *structural navigation*. JS `undefined`
   USUALLY maps to Newspeak `nil` in primordialsoup's alien bridge, but not in
   every edge case (e.g. some object shapes where the at: dispatch raises rather
   than returns nil). Wrap every field access on response-tree nodes in this so
   a deviant shape produces nil rather than blowing up the chat session. Returns
   nil for missing fields or non-respondent receivers; otherwise returns the
   field value AS-IS — which may still be JS undefined for callers that read
   scalar leaves directly. For those, use safeStringAt:field: instead.

   Lives at MODULE level so that BOTH the providers and the module's own
   webFetch: can reach it: a nested class sees its enclosing scope, but a module
   method cannot see a nested class's members. It sat on Provider until
   2026-08-29, which made every successful webFetch: die with
   `MessageNotUnderstood: AIAccess safeAt:field:` at the status check. *)
		
		receiver isNil ifTrue: [ ^nil ].
		^[ receiver at: field ] on: Exception do: [:e | nil ]
	)
	safeStringAt: receiver <Object> field: field <String | Integer> ^<String | UndefinedObject> = (
		(* Defensive String-field access. Like safeAt: but additionally filters out JS
   undefined / null / non-String values that the alien bridge sometimes passes
   through as values which fail isNil. Returns nil if the field is missing or
   not a String, otherwise the String value.

   Mechanism: a real String concatenated with the empty String returns itself.
   Anything else (JS undefined, JS null, numbers, objects) raises on `,` and is
   normalised to nil. Cheap, single alien round-trip, no type-class guessing.

   Use this at every leaf where you read a string field from an alien
   (response.parts[i].text, tool name, etc.) and intend to use it in a String
   context. Module-level for the same reason as safeAt:field: above. *)
		
		| v |
		receiver isNil ifTrue: [ ^nil ].
		v:: [ receiver at: field ] on: Exception do: [:e | nil ].
		v isNil ifTrue: [ ^nil ].
		^[ v , '' ] on: Exception do: [:e | nil ]
	)
	public webFetch: url <String> ^<Alien[Promise]> = (
		(* Generic GET behind the local_fetch tool. When the platform's host offers
   /_ns/fetch (HOST_SERVICES_DESIGN_2026-08-31.md, staging step 5), the fetch
   runs server-side through the front door: no CORS, and a failure comes back
   as a diagnostics envelope - status, headers, redirects, and the error page
   itself - instead of the browser's opaque TypeError. Anything that breaks in
   the /_ns machinery itself falls back to the browser-side path, so a dead
   front door never makes local_fetch worse than it was without one. Without a
   host (a deployed origin, an old platform) the browser-side path stands
   unchanged.

   Discovery is fail-closed until it settles, so we WAIT for the host's probe
   to finish before deciding rather than reading availability synchronously:
   otherwise the first fetch of a session always races ahead of discovery and
   silently takes the browser-side path. *)
		
		hostModule isNil ifTrue: [ ^webFetchBrowserSide: url ].
		^hostReadyPromise then: [:ignored |
				
				(* No raise may escape a JS then: closure - it is memory-unsafe on the
	   psoup bridge - so the decision is wrapped and any failure degrades to
	   the browser-side path. *)
				[
					| origin <String | UndefinedObject> |
					origin:: hostFetchOrigin.
					origin isNil ifTrue: [ webFetchBrowserSide: url ]
						ifFalse: [ webFetch: url throughHostAt: origin ]
				] on: Exception do: [:e | webFetchBrowserSide: url ]
			]
			onError: [:e | webFetchBrowserSide: url ]
	)
	hostReadyPromise ^<Alien[Promise]> = (
		(* A JS promise that resolves (with nil) once the host's discovery has
   settled - fulfilled immediately if it already has. Bridges Host>>whenReady:
   into the JS-promise world webFetch: lives in. The callback only resolves; it
   never rejects and never raises, so a probe that fails closed simply resolves
   and lets hostFetchOrigin answer nil. *)
		
		| deferred <Alien> resolveFn <Alien> |
		deferred:: JSPromise withResolvers.
		resolveFn:: deferred at: 'resolve'.
		[
			hostModule whenReady: [:h |
					[ resolveFn call: js undefined with: js undefined ] on: Exception
						do: [:e | nil ].
					nil
				]
		] on: Exception do: [:e | resolveFn call: js undefined with: js undefined ].
		^deferred at: 'promise'
	)
	webFetchBrowserSide: url <String> ^<Alien[Promise]> = (
		(* The pre-host path. Tries the URL directly and, if the fetch never
   completed, retries through the front door's git proxy — the same route the
   repository clone path uses (default /_ns/git, convention
   <prefix>/<host>/<path>).

   Direct first, proxy second, rather than always proxying: a direct hit is one
   round trip, keeps the request on the user's own network identity, and reaches
   same-origin resources the proxy would refuse. The proxy is the fallback for
   exactly the case that used to be fatal — a cross-origin target that sends no
   Access-Control-Allow-Origin.

   ONLY transport failures are retried. An HTTP error is a real answer from the
   server: re-fetching it through the proxy would double the traffic and could
   mask the status.

   Configure via localStorage 'ns_ai_web_fetch_proxy' — another prefix to
   relocate it, or 'off' to disable the fallback entirely. Note the proxy always
   speaks https upstream, so an http:// target is not proxyable. *)
		
		| proxied <String | UndefinedObject> |
		proxied:: proxiedUrlFor: url.
		^(fetchAndRead: url) then: [:body | body ]
			onError: [:directError |
				| desc <String> |
				desc:: describeRejection: directError.
				((desc startsWith: transportMarker) and: [ proxied isNil not ]) ifTrue: [
						(fetchAndRead: proxied) then: [:body | body ]
							onError: [:proxyError |
								JSPromise reject: 'local_fetch failed both directly and through the proxy for ' , url , String lf , '  direct: ' , desc , String lf , '  proxy (' , proxied , '): ' , (describeRejection: proxyError) , String lf , 'If the proxy leg failed to connect, it is probably not running: python3 tool/cors-proxy.py'
							]
					]
					ifFalse: [
						JSPromise reject: (proxied isNil ifTrue: [
									desc , String lf , '(No proxy fallback was attempted: either localStorage ns_ai_web_fetch_proxy is ''off'', or this URL is not http/https.)'
								]
								ifFalse: [ desc ])
					]
			]
	)
	hostFetchOrigin ^<String | UndefinedObject> = (
		(* The origin whose /_ns/fetch should carry local_fetch: '' for the page's
   own origin, a base URL for the dev fallback, nil when this platform has no
   host module, discovery has not settled (fail closed), or the host does not
   offer fetch. *)
		
		^[
			hostModule isNil ifTrue: [ nil ]
				ifFalse: [
					hostModule fetchAvailable ifTrue: [ hostModule serviceOrigin ]
						ifFalse: [ nil ]
				]
		] on: Exception do: [:e | nil ]
	)
	webFetch: url <String> throughHostAt: origin <String> ^<Alien[Promise]> = (
		(* Server-side fetch through the front door. A non-200 from /_ns/fetch
   itself means the machinery refused (a stale token after a server restart,
   most likely), not that the target failed - the token cache is dropped and
   the browser-side path takes over for this call. *)
		
		^(hostTokenFrom: origin) then: [:tok |
				(global fetch: origin , '/_ns/fetch?token=' , tok , '&url=' , (global encodeURIComponent: url)) then: [:response |
						| status <Integer | UndefinedObject> |
						status:: safeAt: response field: 'status'.
						(status isNil or: [ status < 200 or: [ status >= 300 ] ]) ifTrue: [
								nsHostToken:: nil.
								webFetchBrowserSide: url
							]
							ifFalse: [
								response json then: [:env | envelopeResult: env for: url ]
									onError: [:e | webFetchBrowserSide: url ]
							]
					]
					onError: [:e | webFetchBrowserSide: url ]
			]
			onError: [:e | webFetchBrowserSide: url ]
	)
	hostTokenFrom: origin <String> ^<Alien[Promise]> = (
		(* The per-run token, fetched from /_ns/token once and cached in a slot -
   the decided distribution: a loopback-only file, never localStorage (which
   the Croquet runtime virtualizes away in any case). *)
		
		nsHostToken isNil ifFalse: [ ^JSPromise resolve: nsHostToken ].
		^(global fetch: origin , '/_ns/token') then: [:response |
				response json then: [:parsed |
						nsHostToken:: safeStringAt: parsed field: 'token'.
						nsHostToken isNil ifTrue: [
								JSPromise reject: 'no token in the /_ns/token response'
							]
							ifFalse: [ nsHostToken ]
					]
			]
	)
	envelopeResult: env <Alien> for: url <String> = (
		(* Unpack the /_ns/fetch diagnostics envelope: the body for a 2xx/3xx
   answer, a legible rejection otherwise. Everything here was observed
   server-side, so even a transport failure carries its cause. *)
		
		| transport <String | UndefinedObject> status <Integer | UndefinedObject> statusText <String | UndefinedObject> body <String | UndefinedObject> |
		transport:: safeStringAt: env field: 'transportError'.
		transport isNil ifFalse: [
				^JSPromise reject: 'local_fetch (server-side, via /_ns/fetch) could not reach ' , url , ': ' , transport
			].
		status:: safeAt: env field: 'status'.
		statusText:: safeStringAt: env field: 'statusText'.
		statusText isNil ifTrue: [ statusText:: '' ].
		body:: safeStringAt: env field: 'body'.
		body isNil ifTrue: [ body:: '' ].
		(status isNil or: [ status >= 400 ]) ifTrue: [
				^JSPromise reject: 'HTTP ' , (statusLabel: status) , ' ' , statusText , ' fetching ' , url , String lf , 'Response body: ' , (excerptOf: body)
			].
		(safeAt: env field: 'truncated') = true ifTrue: [
				^body , String lf , '[body truncated by /_ns/fetch at 256KB]'
			].
		^body
	)
	fetchAndRead: url <String> ^<Alien[Promise]> = (
		(* One attempt. Rejects with a transportMarker-prefixed reason when the fetch
   itself never completed — CORS, DNS, refused connection, offline — since the
   browser exposes no status, headers or body for that class. Rejects with
   'HTTP <status>' plus a body excerpt when the server did answer >= 400: an
   error PAGE is often the whole diagnosis (a Cloudflare 1014 names its own
   misconfiguration), so it is returned rather than discarded. *)
		
		| options <Alien> |
		options:: createJSObject.
		options at: 'method' put: 'GET'.
		^(global fetch: url with: options) then: [:response <Alien> |
				[
					| status <Integer | UndefinedObject> statusText <String> |
					status:: safeAt: response field: 'status'.
					statusText:: safeStringAt: response field: 'statusText'.
					statusText isNil ifTrue: [ statusText:: '' ].
					(status isNil or: [ status >= 400 ]) ifTrue: [
							response text then: [:body <String> |
									JSPromise reject: 'HTTP ' , (statusLabel: status) , ' ' , statusText , ' fetching ' , url , String lf , 'Response body: ' , (excerptOf: body)
								]
								onError: [:e2 |
									JSPromise reject: 'HTTP ' , (statusLabel: status) , ' ' , statusText , ' fetching ' , url , ' (response body unreadable)'
								]
						]
						ifFalse: [ response text ]
				] on: Exception
					do: [:e | JSPromise reject: 'local_fetch error: ' , (errorDescription: e) ]
			]
			onError: [:err |
				JSPromise reject: transportMarker , url , ' — ' , (describeRejection: err) , '. The browser reports no status, headers or body for this class of failure, so it does NOT establish that the site is down.'
			]
	)
	transportMarker ^<String> = (
		(* Prefix marking "the request never completed", which is the only class of
   failure worth retrying through the proxy. *)
		
		^'TRANSPORT '
	)
	statusLabel: status <Integer | UndefinedObject> ^<String> = (
		status isNil ifTrue: [ ^'(no status)' ].
		^status printString
	)
	describeRejection: reason ^<String> = (
		(* A promise rejection may be a Newspeak String we produced or a JS error
   alien; normalise either to something printable without raising. *)
		
		^[ reason , '' ] on: Exception
			do: [:e |
				[ reason printString ] on: Exception do: [:e2 | '(unprintable rejection)' ]
			]
	)
	webFetchProxyPrefix ^<String | UndefinedObject> = (
		(* Proxy prefix from localStorage 'ns_ai_web_fetch_proxy'; absent means the
   default, 'off' means no fallback. The default is the front door's /_ns/git
   route, page-origin-relative so it needs no hardcoded port and works wherever
   the front door serves the page. (This browser-side fallback is now the
   backstop under webFetchBrowserSide:; the primary path is server-side
   /_ns/fetch when the host offers it.) Same per-user config pattern as the API
   keys, so nothing is baked into the image. *)
		
		| raw <String | UndefinedObject> |
		raw:: [ js localStorage getItem: 'ns_ai_web_fetch_proxy' ] on: Exception
			do: [:e | nil ].
		raw isNil ifTrue: [ ^'/_ns/git' ].
		(raw isKindOfString and: [ raw isEmpty ]) ifTrue: [ ^'/_ns/git' ].
		raw = 'off' ifTrue: [ ^nil ].
		^raw
	)
	proxiedUrlFor: url <String> ^<String | UndefinedObject> = (
		(* Rewrite https://host/path as <proxy>/host/path, the convention
   @isomorphic-git/cors-proxy and tool/cors-proxy.py both use. Answers nil when
   there is no proxy configured or the URL is not http/https — the proxy speaks
   https upstream regardless, so an http:// target cannot be forwarded
   faithfully and is not attempted. *)
		
		| prefix <String | UndefinedObject> rest <String> |
		prefix:: webFetchProxyPrefix.
		prefix isNil ifTrue: [ ^nil ].
		(prefix endsWith: '/') ifTrue: [
				prefix:: prefix copyFrom: 1 to: prefix size - 1
			].
		(url startsWith: 'https://') ifTrue: [ rest:: url copyFrom: 9 to: url size ]
			ifFalse: [ ^nil ].
		rest isEmpty ifTrue: [ ^nil ].
		^prefix , '/' , rest
	)
	excerptOf: body <String> ^<String> = (
		(* First ~1200 characters of a response body. Enough to carry an error page's
   actual message without flooding the conversation. *)
		
		| limit <Integer> |
		limit:: 1200.
		^[
			body size <= limit ifTrue: [ body ]
				ifFalse: [ (body copyFrom: 1 to: limit) , String lf , '... (truncated)' ]
		] on: Exception do: [:e | '(unreadable body)' ]
	)
) : ()
