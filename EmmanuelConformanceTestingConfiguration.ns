Newspeak3
'Emmanuel'
class EmmanuelConformanceTestingConfiguration packageTestsUsing: manifest = (
	(* Runs the Emmanuel reference implementation against the specification's
regressions. From tool/:
  ./run-tests.sh EmmanuelConformanceTestingConfiguration ../Emmanuel.ns ../EmmanuelTesting.ns *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelTesting = manifest EmmanuelTesting.
		private EmmanuelConformanceTesting = manifest EmmanuelConformanceTesting.
	|
) (
	public testModulesUsingPlatform: p minitest: m = (
		^{EmmanuelConformanceTesting usingPlatform: p
			minitest: m
			testing: (EmmanuelTesting usingPlatform: p
				emmanuel: (Emmanuel usingPlatform: p)). }
	)
) : ()
