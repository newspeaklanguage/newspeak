;; Section 4.2: white space.

def $isWS(char) : bool
def $isWS(c) =
  c = "\t" \/ c = "\n" \/ c = "\u{0B}" \/ c = "\u{0C}" \/ c = "\r" \/ c = " "

def $dropWS(char*) : char*
def $dropWS(eps) = eps
def $dropWS(c u*) = $dropWS(u*)
  -- if $isWS(c)
def $dropWS(c u*) = c u*
  -- if ~$isWS(c)

;; @equation eq:collapse
def $collapse(char*) : char*
def $collapse(eps) = eps
def $collapse(c u*) = " " $collapse($dropWS(u*))
  -- if $isWS(c)
def $collapse(c u*) = c $collapse(u*)
  -- if ~$isWS(c)

;; Children of a block in the store. RUN, NOTE, DNU, STRAY and ROOTPOP are
;; shared with finished trees; BLK refers into the store.
;; @equation eq:block-store
syntax kid =
  | RUN (char*) span
  | BLK nat
  | NOTE span
  | MUT stmt
  | DNU stmt
  | STRAY (char*) span
  | ROOTPOP stmt
  | REFUSED stmt
var g : kid

;; @equation eq:text-child
syntax childresult = NOCHILD | CHILD kid
def $child(contentclass, char*, span) : childresult
def $childOf(contentclass, char*, char*, span) : childresult
def $child(q, u*, s) = $childOf(q, $collapse(u*), u*, s)
def $childOf(q, eps, u*, s) = NOCHILD
def $childOf(FLOW, " ", u*, s) = NOCHILD
def $childOf(q, " ", u*, s) = CHILD (RUN (" ") s)
  -- if q =/= FLOW
def $childOf(FLOW, c w*, u*, s) = CHILD (STRAY (u*) s)
  -- if c =/= " " \/ w* =/= eps
def $childOf(q, c w*, u*, s) = CHILD (RUN (c w*) s)
  -- if q =/= FLOW
  -- if c =/= " " \/ w* =/= eps

;; @equation eq:trim
;; The LaTeX's trimEnd matches a suffix of the children and of the run's
;; text; the pinned evaluator mismatches suffix patterns in functions, so
;; the transcription reverses, trims at the start, and reverses back. The
;; start cases are folded through $runOrDrop: stripping a run that does not
;; begin with a space leaves it unchanged, which is the LaTeX's third case.
def $revChars(char*) : char*
def $revChars(eps) = eps
def $revChars(c u*) = $revChars(u*) c

def $revKids(kid*) : kid*
def $revKids(eps) = eps
def $revKids(g g'*) = $revKids(g'*) g

def $isRun(kid) : bool
def $isRun(RUN (u*) s) = true
def $isRun(BLK k) = false
def $isRun(NOTE s) = false
def $isRun(MUT sigma) = false
def $isRun(DNU sigma) = false
def $isRun(STRAY (u*) s) = false
def $isRun(ROOTPOP sigma) = false
def $isRun(REFUSED sigma) = false

def $lstrip(char*) : char*
def $lstrip(eps) = eps
def $lstrip(" " u*) = u*
def $lstrip(c u*) = c u*
  -- if c =/= " "

def $rstrip(char*) : char*
def $rstrip(u*) = $revChars($lstrip($revChars(u*)))

def $runOrDrop(char*, span) : kid*
def $runOrDrop(eps, s) = eps
def $runOrDrop(c u*, s) = RUN (c u*) s

def $trimStart(kid*) : kid*
def $trimStart(eps) = eps
def $trimStart((RUN (u*) s) g*) = $runOrDrop($lstrip(u*), s) g*
def $trimStart(g g'*) = g g'*
  -- if ~$isRun(g)

def $trimEndRev(kid*) : kid*
def $trimEndRev(eps) = eps
def $trimEndRev((RUN (u*) s) g*) = $runOrDrop($rstrip(u*), s) g*
def $trimEndRev(g g'*) = g g'*
  -- if ~$isRun(g)

def $trimEnd(kid*) : kid*
def $trimEnd(g*) = $revKids($trimEndRev($revKids(g*)))

def $trim(kid*) : kid*
def $trim(g*) = $trimEnd($trimStart(g*))
