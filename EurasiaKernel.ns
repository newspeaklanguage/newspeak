	public class Message selector: s <String> arguments: a = (
		|
			public selector <Symbol> = s asSymbol.
			public arguments <Array[Object]> = a.
		|
	) (
		public sendEventualTo: receiver = (
			halt
		)
		public sendTo: receiver = (
