Newspeak3
'Emmanuel'
class EmmanuelBlocks usingPlatform: p emmanuel: em = (
	(* The standard block library of Emmanuel (Section 6 of the specification,
formal-semantics/emmanuel/spectec/library/07-library.spectec): one
DocumentBlock subclass per kind of block, and, for each, the Hopscotch
presenter that renders it.

A block's protocol is its content model: model lists the messages it
understands. Receiving one answers an effect: openers push a new block,
closers pop, newline and the displays (verbatim:, codeBlock:, html:) add
leaves, and the inline-argument messages (section:, title:, subtitle:,
author:, attribution:, caption:) take a markup literal, interpreted with an
inline root, or a string.

A symbol is a string literal, so labels and languages, written as symbols
(#intro), are Strings like any other string argument.

Rendering: a block names its presenter (presenterOn:). A presenter renders
its tree as an ElementFragment, an HTML element whose children are text and
the presenters of the subtrees. *)
	
	|
		private List = p collections List.
		private Map = p collections Map.
		private emmanuel = em.
		private DocumentBlock = em DocumentBlock.
		private Fragment = p hopscotch Fragment.
		private Presenter = p hopscotch Presenter.
		private Subject = p hopscotch Subject.
		private domDocument = p js global at: #document.
	|
) (
	public class Amplet code: v inline: b = LibraryBlock new (
		(* An amplet (Section 6): live content the view computes by running v,
the host value of the amplet's code (in the Newspeak host, a closure). In
flow content it is a display; elsewhere, an inline leaf. *)
		
		|
			public code = v.
			public isInline = b.
		|
	) (
		public contentClass = (
			^isInline ifTrue: [ #inline ] ifFalse: [ #flow ]
		)
		public htmlTag = (
			^isInline ifTrue: [ 'span' ] ifFalse: [ 'div' ]
		)
		public presenterOn: s = (
			^AmpletPresenter onSubject: s
		)
		public stateName = (
			^isInline ifTrue: [ 'inlineAmplet' ] ifFalse: [ 'amplet' ]
		)
		public stateValues = (
			^{code. }
		)
	) : ()
	public class AmpletPresenter onSubject: s = BlockPresenter onSubject: s (
		(* Shows an amplet: what running its code answers, which the session
the tree is rendered in computes and keeps; with no session, its code. *)
		
	) (
		childFragments = (
			^{subject ampletFragmentFor: block code. }
		)
		definition = (
			^noEdit: super definition
		)
	) : ()
	public class AmpletRunner evaluator: ev = (
		(* Runs the amplets of the trees a view renders, and keeps what they
answer: an amplet is run once, and its result kept while its code is
unchanged. A result is keyed by the amplet's code and its occurrence among
the amplets with that code in one rendering; a rendering is bracketed by
beginRender and endRender, which drops the results it did not use.

ev evaluate: aString answers the value of the code aString in the
document's scope; an amplet's code is a block, which is then run. With no
evaluator, an amplet shows its code. *)
		
		|
			private evaluator = ev.
			private cache ::= Map new.
			private next ::= Map new.
			private counts ::= Map new.
		|
	) (
		public adopt: other = (
			(* Take over the results other keeps, as a new rendering of a
document does from the one it replaces. *)
			
			cache:: other keptResults
		)
		public beginRender = (
			next:: Map new.
			counts:: Map new
		)
		codeOfKey: key = (
			(* The code of a key of the cache: the key less its occurrence suffix. *)
			
			^key copyFrom: 1 to: (key lastIndexOf: '#') - 2
		)
		public endRender = (
			cache:: next
		)
		public fragmentFor: closure = (
			(* What the amplet whose code's value is closure shows. *)
			
			| code = closure code. n = (counts at: code ifAbsent: [ 0 ]) + 1. key = code , ' #' , n printString. result |
			counts at: code put: n.
			result:: cache at: key ifAbsent: [ run: code ].
			next at: key put: result.
			^result
		)
		public keptResults = (
			^cache
		)
		public refresh = (
			(* Run the kept amplets that answered fragments again, as an
Ampleforth document's amplets run again on each refresh of the GUI
(updateGUI:), and reconcile each new fragment with the one it replaces, so
that it takes over its visual and state: a presenter whose subject changed
shows the change (a presentation's next slide). Other results are kept. *)
			
			| fresh = Map new. |
			cache keysAndValuesDo: [:key :old |
					| new ::= old. |
					old isKindOfFragment ifTrue: [
							new:: run: (codeOfKey: key).
							(new isKindOfFragment and: [ old hasVisual ]) ifTrue: [
									new parent: old parent.
									new updateVisualsFrom: old
								]
						].
					fresh at: key put: new
				].
			cache:: fresh
		)
		run: code = (
			| value |
			evaluator isNil ifTrue: [ ^code ].
			value:: [ (evaluator evaluate: code) value ] on: Error
				do: [:e | ^errorFragment: 'The amplet failed: ' , e messageText printString ].
			value isKindOfFragment ifTrue: [ ^value ].
			value isKindOfString ifTrue: [ ^value ].
			^value printString
		)
	) : ()
	public class BlockPresenter onSubject: s = Presenter onSubject: s (
		(* Renders a tree: an element with the block's tag and style, holding the
tree's children. Subclasses add what the block's fields show. *)
		
	) (
		annotated: fragment = (
			(* The fragment of the block, marked for the editor: its path, and
its index among its parent's children. *)
			
			| ss = subject steps. last |
			fragment attributes: fragment attributes , {{'data-steps'. join: ss with: ' '. }. }.
			ss isEmpty ifFalse: [
					last:: emmanuel codePointsOf: ss last.
					last first = 105 ifTrue: [
							fragment attributes: fragment attributes , {{'data-item'. emmanuel stringOfCodePoints: (last copyFrom: 2
										to: last size). }. }
						]
				].
			^fragment
		)
		block = (
			^tree state
		)
		childFragments = (
			^fragmentsOfItems: tree items steps: subject steps amplets: subject amplets
		)
		definition = (
			^annotated: (ElementFragment tag: block htmlTag
					style: (styleOf: block)
					children: leadingFragments , childFragments , trailingFragments)
		)
		field: v tag: tag style: st = (
			(* The element that shows the field v: editable text when it holds
markup, marked with the path into the field; a string as it is. *)
			
			| f = ElementFragment tag: tag
				style: st
				children: (fragmentsOfValue: v
					steps: (fieldSteps: v)
					amplets: subject amplets). |
			v isKindOfTreeValue ifTrue: [
					f attributes: {{'data-steps'. join: (fieldSteps: v) with: ' '. }. }
				]
				ifFalse: [ f attributes: {{'contenteditable'. 'false'. }. } ].
			^f
		)
		fieldSteps: v = (
			| fields = block fields: tree messages. |
			fields keysAndValuesDo: [:i :phi |
					phi value == v ifTrue: [ ^subject steps , {'f' , (i - 1) printString. } ]
				].
			^subject steps
		)
		public isKindOfEmmanuelBlockPresenter = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelBlockPresenter
		)
		leadingFragments = (
			^{}
		)
		styleOf: b = (
			tree flag = #unclosed ifTrue: [ ^b htmlStyle , ' outline: 1px dashed red;' ].
			tree flag = #rejected ifTrue: [ ^b htmlStyle , ' outline: 1px solid red;' ].
			^b htmlStyle
		)
		trailingFragments = (
			^{}
		)
		tree = (
			^subject tree
		)
	) : ()
	public class BulletList new = LibraryBlock new (
	) (
		public htmlTag = (
			^'ul'
		)
		public model = (
			^{'item'. 'endList'. }
		)
		public stateName = (
			^'list'
		)
	) : ()
	public class Cell new = LibraryBlock new (
	) (
		public contentClass = (
			^#cell
		)
		public htmlTag = (
			^'td'
		)
		public model = (
			^flowContent , inlineContent , {'endCell'. }
		)
		public stateName = (
			^'cell'
		)
	) : ()
	public class CodeDisplay text: t language: l = LibraryBlock new (
		(* codeBlock: and codeBlock:language:, a leaf. *)
		
		|
			public text = t.
			public language = l.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: text statement: messages first index: 0. }
		)
		public htmlTag = (
			^'pre'
		)
		public presenterOn: s = (
			^TextBlockPresenter onSubject: s
		)
		public stateName = (
			^'codeBlock'
		)
		public stateValues = (
			^{text. language. }
		)
	) : ()
	public class DocumentPresenter onSubject: s = BlockPresenter onSubject: s (
		(* A document shows its title, subtitle, and authors before its body. *)
		
	) (
		leadingFragments = (
			| out = List new. |
			block title isNil ifFalse: [
					out add: (field: block title tag: 'h1' style: '')
				].
			block subtitle isNil ifFalse: [
					out add: (field: block subtitle tag: 'h2' style: 'font-weight: normal;')
				].
			block authors do: [:a |
					out add: (field: a tag: 'div' style: 'font-style: italic;')
				].
			^out asArray
		)
	) : ()
	public class DocumentRoot title: t subtitle: st authors: as = LibraryBlock new (
		(* The root block of a document: its title, subtitle, and authors. *)
		
		|
			public title = t.
			public subtitle = st.
			public authors = as.
		|
	) (
		authorFields: messages = (
			(* A field for each author, from the author: messages in order. *)
			
			| sends = withSelector: 'author:' in: messages. |
			^(1 to: authors size) asArray collect: [:i |
					emmanuel Field value: (authors at: i) statement: (sends at: i) index: 0
				]
		)
		depth = (
			^0
		)
		public fields: messages = (
			^(fieldFor: title selector: 'title:' messages: messages) , (fieldFor: subtitle
				selector: 'subtitle:'
				messages: messages) , (authorFields: messages)
		)
		free: x = (
			x = 'title:' ifTrue: [ ^title isNil ].
			x = 'subtitle:' ifTrue: [ ^subtitle isNil ].
			^true
		)
		public htmlTag = (
			^'article'
		)
		public model = (
			^flowContent , {'section:'. 'title:'. 'subtitle:'. 'author:'. }
		)
		public presenterOn: s = (
			^DocumentPresenter onSubject: s
		)
		public stateName = (
			^'doc'
		)
		public stateValues = (
			^{title. subtitle. } , authors
		)
		with: x value: v hostState: chi = (
			x = 'title:' ifTrue: [
					^mutate: (DocumentRoot title: v subtitle: subtitle authors: authors)
						hostState: chi
				].
			x = 'subtitle:' ifTrue: [
					^mutate: (DocumentRoot title: title subtitle: v authors: authors)
						hostState: chi
				].
			x = 'author:' ifTrue: [
					^mutate: (DocumentRoot title: title
							subtitle: subtitle
							authors: (authors copyWith: v))
						hostState: chi
				].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^title: nil subtitle: nil authors: {}
		)
	)
	public class ElementFragment tag: t style: st children: cs = Fragment new (
		(* An HTML element with a tag and a style, whose children are text
(Strings) and fragments. Unlike an HTMLFragment it is not wrapped in a
document body, so it can be inline. *)
		
		|
			public tag = t.
			public style = st.
			public children = cs.
			public rawHTML ::= nil.
			public attributes ::= {}.
		|
	) (
		public childrenDo: action = (
			children do: [:c | c isKindOfString ifFalse: [ action value: c ] ]
		)
		createVisual = (
			| element = domDocument createElement: tag. |
			(style isNil or: [ style isEmpty ]) ifFalse: [
					element setAttribute: 'style' to: style
				].
			attributes do: [:a | element setAttribute: (a at: 1) to: (a at: 2) ].
			rawHTML isNil ifFalse: [ element at: 'innerHTML' put: rawHTML ].
			children do: [:c |
					c isKindOfString ifTrue: [
							element appendChild: (domDocument createTextNode: c)
						]
						ifFalse: [
							c parent: self.
							element appendChild: c visual
						]
				].
			^element
		)
		public isKindOfEmmanuelElementFragment = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelElementFragment
		)
		updateVisualsFromSameKind: oldFragment = (
			(* Rendering is read-only for now: a new element replaces the old. *)
			
			^replaceVisual: oldFragment visual with: visual
		)
	) : ()
	public class Emphasis new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'em'
		)
		public model = (
			^inlineContent , {'endEmphasis'. }
		)
		public stateName = (
			^'emph'
		)
	) : ()
	public class Figure caption: c label: l = LibraryBlock new (
		|
			public caption = c.
			public label = l.
		|
	) (
		public fields: messages = (
			^fieldFor: caption selector: 'caption:' messages: messages
		)
		free: x = (
			x = 'caption:' ifTrue: [ ^caption isNil ].
			^true
		)
		public htmlTag = (
			^'figure'
		)
		public isLabelled = (
			^true
		)
		public model = (
			^displays , {'caption:'. 'label:'. 'endFigure'. }
		)
		public presenterOn: s = (
			^FigurePresenter onSubject: s
		)
		public relabel: v = (
			^Figure caption: caption label: v
		)
		public stateName = (
			^'figure'
		)
		public stateValues = (
			^{caption. label. }
		)
		with: x value: v hostState: chi = (
			x = 'caption:' ifTrue: [
					^mutate: (Figure caption: v label: label) hostState: chi
				].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^caption: nil label: nil
		)
	)
	public class FigurePresenter onSubject: s = BlockPresenter onSubject: s (
	) (
		trailingFragments = (
			block caption isNil ifTrue: [ ^{} ].
			^{field: block caption tag: 'figcaption' style: ''. }
		)
	) : ()
	public class HeaderRow new = LibraryBlock new (
	) (
		public htmlStyle = (
			^'font-weight: bold;'
		)
		public htmlTag = (
			^'tr'
		)
		public model = (
			^{'cell'. 'endRow'. }
		)
		public stateName = (
			^'headerRow'
		)
	) : ()
	public class Html text: t = LibraryBlock new (
		(* html:, a leaf. *)
		
		|
			public text = t.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: text statement: messages first index: 0. }
		)
		public presenterOn: s = (
			^HtmlPresenter onSubject: s
		)
		public stateName = (
			^'html'
		)
		public stateValues = (
			^{text. }
		)
	) : ()
	public class HtmlPresenter onSubject: s = BlockPresenter onSubject: s (
	) (
		definition = (
			| f = ElementFragment tag: 'div' style: '' children: {}. |
			f rawHTML: block text.
			f attributes: {{'contenteditable'. 'false'. }. }.
			^annotated: f
		)
	) : ()
	public class InlineCode new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'code'
		)
		public model = (
			^inlineContent , {'endCode'. }
		)
		public stateName = (
			^'code'
		)
	) : ()
	public class InlineRoot new = LibraryBlock new (
		(* The root of an inline argument, such as a title. *)
		
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'span'
		)
		public model = (
			^inlineContent
		)
		public stateName = (
			^'inline'
		)
	) : ()
	public class Item new = LibraryBlock new (
	) (
		public htmlTag = (
			^'li'
		)
		public model = (
			^flowContent , {'endItem'. }
		)
		public stateName = (
			^'item'
		)
	) : ()
	public class LibraryBlock new = DocumentBlock new (
		(* The behaviour the library's blocks share: the rules of Section 6.
Subclasses give their state (stateName, stateValues), content class,
content model, and rendering (htmlTag, htmlStyle, presenterOn:), and
override free:, with:value:hostState:, and relabel: for the messages that
change their fields. *)
		
	) (
		public contentClass = (
			^#flow
		)
		depth = (
			^Error signal: 'no depth: ' , stateName
		)
		displays = (
			^{'verbatim:'. 'codeBlock:'. 'codeBlock:language:'. 'html:'. 'amplet:'. }
		)
		effect: kind hostState: chi = (
			^emmanuel Effect kind: kind block: nil hostState: chi
		)
		public effectOf: x args: vs hostState: chi machine: m = (
			(understands: x) ifFalse: [ ^effect: #notUnderstood hostState: chi ].
			((inlineArgs includes: x) and: [ vs size = 1 ]) ifTrue: [
					^inline: x argument: vs first hostState: chi machine: m
				].
			^plain: x args: vs hostState: chi
		)
		public enterPriority = (
			(* Enter splits the innermost list item, making a new item, and where
there is none the innermost paragraph. *)
			
			stateName = 'item' ifTrue: [ ^2 ].
			stateName = 'para' ifTrue: [ ^1 ].
			^0
		)
		fieldFor: v selector: x messages: messages = (
			(* The field of a value set by the message x, if it is set. *)
			
			v isNil ifTrue: [ ^{} ].
			^{emmanuel Field value: v
				statement: (withSelector: x in: messages) first
				index: 0. }
		)
		flowContent = (
			^displays , {'paragraph'. 'list'. 'numberedList'. 'quote'. 'table'. 'figure'. }
		)
		free: x = (
			^true
		)
		public htmlStyle = (
			^''
		)
		public htmlTag = (
			^'div'
		)
		inline: x argument: v hostState: chi machine: m = (
			(* Lib-Inline: a markup literal is interpreted with an inline root; a
string is taken as it is; anything else is refused. *)
			
			| done |
			(free: x) ifFalse: [ ^effect: #refuse hostState: chi ].
			v isKindOfMarkupLiteral ifTrue: [
					done:: m interpretLiteral: v root: InlineRoot new hostState: chi.
					done isKindOfRaised ifTrue: [ ^done ].
					^with: x
						value: (emmanuel TreeValue literal: v tree: done tree)
						hostState: done hostState
				].
			(v isKindOfTreeValue or: [ v isKindOfString ]) ifTrue: [
					^with: x value: v hostState: chi
				].
			^effect: #refuse hostState: chi
		)
		inlineArgs = (
			^{'section:'. 'title:'. 'subtitle:'. 'author:'. 'attribution:'. 'caption:'. }
		)
		inlineContent = (
			^{'emphasis'. 'strong'. 'code'. 'newline'. 'amplet:'. 'link:'. }
		)
		isHostValue: v = (
			(* Whether v is a host value: not a literal, a tree, a string, a
number, or nil. The Newspeak host's closures are host values. *)
			
			^(v isNil or: [
					v isKindOfString or: [
							v isKindOfInteger or: [
									v isKindOfMarkupLiteral or: [ v isKindOfTreeValue ]
								]
						]
				]) not
		)
		public isLabelled = (
			^false
		)
		public joins = (
			^{'para'. 'emph'. 'strong'. 'code'. 'link'. 'list'. 'numbered'. 'item'. } includes: stateName
		)
		leaf: block hostState: chi = (
			^emmanuel Effect kind: #leaf block: block hostState: chi
		)
		public model = (
			^{}
		)
		mutate: block hostState: chi = (
			^emmanuel Effect kind: #mutate block: block hostState: chi
		)
		plain: x args: vs hostState: chi = (
			| v |
			vs isEmpty ifTrue: [
					(openers includes: x) ifTrue: [
							^emmanuel Effect kind: #push block: (opened: x) hostState: chi
						].
					(closers includes: x) ifTrue: [ ^effect: #pop hostState: chi ].
					x = 'newline' ifTrue: [ ^leaf: Newline new hostState: chi ]
				].
			vs size = 1 ifTrue: [
					v:: vs first.
					x = 'verbatim:' ifTrue: [
							^v isKindOfString ifTrue: [ leaf: (Verbatim text: v) hostState: chi ]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'html:' ifTrue: [
							^v isKindOfString ifTrue: [ leaf: (Html text: v) hostState: chi ]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'codeBlock:' ifTrue: [
							^v isKindOfString ifTrue: [
									leaf: (CodeDisplay text: v language: 'newspeak') hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'link:' ifTrue: [
							^v isKindOfString ifTrue: [
									emmanuel Effect kind: #push block: (Link target: v) hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'amplet:' ifTrue: [
							^(isHostValue: v) ifTrue: [
									leaf: (Amplet code: v inline: contentClass ~= #flow) hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						].
					x = 'label:' ifTrue: [
							^(isLabelled and: [ label isNil and: [ v isKindOfString ] ]) ifTrue: [
									mutate: (relabel: v) hostState: chi
								]
								ifFalse: [ effect: #refuse hostState: chi ]
						]
				].
			(vs size = 2 and: [ x = 'codeBlock:language:' ]) ifTrue: [
					^(vs first isKindOfString and: [ vs last isKindOfString ]) ifTrue: [
							leaf: (CodeDisplay text: vs first language: vs last) hostState: chi
						]
						ifFalse: [ effect: #refuse hostState: chi ]
				].
			^effect: #refuse hostState: chi
		)
		public presenterOn: s = (
			^BlockPresenter onSubject: s
		)
		public understands: x = (
			^model includes: x
		)
		with: x value: v hostState: chi = (
			x = 'section:' ifTrue: [
					^emmanuel Effect kind: #push
						block: (Section depth: depth + 1 heading: v label: nil)
						hostState: chi
				].
			^Error signal: 'no field for ' , x
		)
		withSelector: x in: messages = (
			(* The messages that are sends of x. *)
			
			^(messages select: [:s | s isComment not and: [ s selector = x ] ]) asArray
		)
	) : ()
	public class Link target: u = LibraryBlock new (
		(* A link (Section 6): an inline block whose target is a string, and
whose text is inline content, without links. *)
		
		|
			public target = u.
		|
	) (
		public contentClass = (
			^#inline
		)
		public fields: messages = (
			^{emmanuel Field value: target statement: messages first index: 0. }
		)
		public htmlTag = (
			^'a'
		)
		public model = (
			^(inlineContent reject: [:x | x = 'link:' ]) , {'endLink'. }
		)
		public presenterOn: s = (
			^LinkPresenter onSubject: s
		)
		public stateName = (
			^'link'
		)
		public stateValues = (
			^{target. }
		)
	) : ()
	public class LinkPresenter onSubject: s = BlockPresenter onSubject: s (
		(* A link shows its text, linked to its target. *)
		
	) (
		definition = (
			| f = super definition. |
			f attributes: f attributes , {{'href'. block target. }. }.
			^f
		)
	) : ()
	public class Newline new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'br'
		)
		public stateName = (
			^'newline'
		)
	) : ()
	public class NumberedList new = LibraryBlock new (
	) (
		public htmlTag = (
			^'ol'
		)
		public model = (
			^{'item'. 'endNumberedList'. }
		)
		public stateName = (
			^'numbered'
		)
	) : ()
	public class Paragraph new = LibraryBlock new (
	) (
		public contentClass = (
			^#para
		)
		public htmlTag = (
			^'p'
		)
		public model = (
			^inlineContent , {'endParagraph'. }
		)
		public stateName = (
			^'para'
		)
	) : ()
	public class Quote attribution: a = LibraryBlock new (
		|
			public attribution = a.
		|
	) (
		public fields: messages = (
			^fieldFor: attribution selector: 'attribution:' messages: messages
		)
		free: x = (
			x = 'attribution:' ifTrue: [ ^attribution isNil ].
			^true
		)
		public htmlTag = (
			^'blockquote'
		)
		public model = (
			^flowContent , {'attribution:'. 'endQuote'. }
		)
		public presenterOn: s = (
			^QuotePresenter onSubject: s
		)
		public stateName = (
			^'quote'
		)
		public stateValues = (
			^{attribution. }
		)
		with: x value: v hostState: chi = (
			x = 'attribution:' ifTrue: [ ^mutate: (Quote attribution: v) hostState: chi ].
			^super with: x value: v hostState: chi
		)
	) : (
		public new = (
			^attribution: nil
		)
	)
	public class QuotePresenter onSubject: s = BlockPresenter onSubject: s (
	) (
		trailingFragments = (
			block attribution isNil ifTrue: [ ^{} ].
			^{ElementFragment tag: 'footer'
				style: ''
				children: {noEdit: (ElementFragment tag: 'span'
						style: ''
						children: {'— '. }). field: block attribution tag: 'span' style: ''. }. }
		)
	) : ()
	public class Row new = LibraryBlock new (
	) (
		public htmlTag = (
			^'tr'
		)
		public model = (
			^{'cell'. 'endRow'. }
		)
		public stateName = (
			^'row'
		)
	) : ()
	public class Section depth: d heading: h label: l = LibraryBlock new (
		(* A section: its depth (1 at the top), heading, and label. *)
		
		|
			public depth = d.
			public heading = h.
			public label = l.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: heading statement: messages first index: 0. }
		)
		public htmlTag = (
			^'section'
		)
		public isLabelled = (
			^true
		)
		public model = (
			^flowContent , {'section:'. 'label:'. 'endSection'. }
		)
		public presenterOn: s = (
			^SectionPresenter onSubject: s
		)
		public relabel: v = (
			^Section depth: depth heading: heading label: v
		)
		public stateName = (
			^'section'
		)
		public stateValues = (
			^{depth. heading. label. }
		)
	) : ()
	public class SectionPresenter onSubject: s = BlockPresenter onSubject: s (
		(* A section shows its heading, at its depth. *)
		
	) (
		leadingFragments = (
			^{field: block heading
				tag: 'h' , (block depth + 1 min: 6) printString
				style: ''. }
		)
	) : ()
	public class Strong new = LibraryBlock new (
	) (
		public contentClass = (
			^#inline
		)
		public htmlTag = (
			^'strong'
		)
		public model = (
			^inlineContent , {'endStrong'. }
		)
		public stateName = (
			^'strong'
		)
	) : ()
	public class Table label: l = LibraryBlock new (
		|
			public label = l.
		|
	) (
		public htmlStyle = (
			^'border-collapse: collapse;'
		)
		public htmlTag = (
			^'table'
		)
		public isLabelled = (
			^true
		)
		public model = (
			^{'headerRow'. 'row'. 'label:'. 'endTable'. }
		)
		public relabel: v = (
			^Table label: v
		)
		public stateName = (
			^'table'
		)
		public stateValues = (
			^{label. }
		)
	) : (
		public new = (
			^label: nil
		)
	)
	public class TextBlockPresenter onSubject: s = BlockPresenter onSubject: s (
		(* verbatim: and codeBlock: show their text as it is. *)
		
	) (
		childFragments = (
			^{block text. }
		)
		definition = (
			^noEdit: super definition
		)
	) : ()
	public class TreeSubject onModel: tree = Subject onModel: tree (
		(* The subject of a block's presenter: the block's tree, and its path
from the root of the document (steps: 'i3' into child 3, 'f0' into field 0),
which the editor reads from the rendering. *)
		
		|
			public steps ::= {}.
			public amplets ::= nil.
		|
	) (
		public ampletFragmentFor: code = (
			(* What an amplet shows: the fragment its amplets runner computes for
its code, or, with none, the code itself. *)
			
			amplets isNil ifTrue: [ ^code code ].
			^amplets fragmentFor: code
		)
		createPresenter = (
			^model state presenterOn: self
		)
		public isKindOfEmmanuelTreeSubject = (
			^true
		)
		isMyKind: other = (
			^other isKindOfEmmanuelTreeSubject
		)
		public tree = (
			^model
		)
	) : ()
	public class Verbatim text: t = LibraryBlock new (
		(* verbatim:, a leaf. *)
		
		|
			public text = t.
		|
	) (
		public fields: messages = (
			^{emmanuel Field value: text statement: messages first index: 0. }
		)
		public htmlTag = (
			^'pre'
		)
		public presenterOn: s = (
			^TextBlockPresenter onSubject: s
		)
		public stateName = (
			^'verbatim'
		)
		public stateValues = (
			^{text. }
		)
	) : ()
	public closerOf: x = (
		x = 'paragraph' ifTrue: [ ^'endParagraph' ].
		x = 'emphasis' ifTrue: [ ^'endEmphasis' ].
		x = 'strong' ifTrue: [ ^'endStrong' ].
		x = 'code' ifTrue: [ ^'endCode' ].
		x = 'list' ifTrue: [ ^'endList' ].
		x = 'numberedList' ifTrue: [ ^'endNumberedList' ].
		x = 'item' ifTrue: [ ^'endItem' ].
		x = 'quote' ifTrue: [ ^'endQuote' ].
		x = 'headerRow' ifTrue: [ ^'endRow' ].
		x = 'row' ifTrue: [ ^'endRow' ].
		x = 'cell' ifTrue: [ ^'endCell' ].
		x = 'figure' ifTrue: [ ^'endFigure' ].
		^Error signal: 'no closer: ' , x
	)
	closers = (
		^{'endParagraph'. 'endEmphasis'. 'endStrong'. 'endCode'. 'endSection'. 'endList'. 'endNumberedList'. 'endItem'. 'endQuote'. 'endTable'. 'endRow'. 'endCell'. 'endFigure'. 'endLink'. }
	)
	public errorFragment: description = (
		(* A fragment that reports what kept a source from being shown. *)
		
		^ElementFragment tag: 'div' style: 'color: red;' children: {description. }
	)
	errorSpan: text = (
		^ElementFragment tag: 'span'
			style: 'color: red; text-decoration: underline wavy red;'
			children: {text. }
	)
	fragmentsOfItems: items steps: ss amplets: amplets = (
		(* The fragments of a tree's children: text runs, the presenters of
the subtrees, and markers for the error leaves, each marked with its index
for the editor. Notes and mutations render nothing. ss is the path of the
tree. *)
		
		| out = List new. |
		items keysAndValuesDo: [:i :g |
				| j = (i - 1) printString. |
				g kind = #run ifTrue: [
						out add: (item: j
								fragment: (ElementFragment tag: 'span'
									style: ''
									children: {emmanuel stringOfCodePoints: g chars. }))
					].
				g kind = #stray ifTrue: [
						out add: (item: j
								fragment: (noEdit: (errorSpan: (emmanuel stringOfCodePoints: g chars))))
					].
				g kind = #sub ifTrue: [
						| s = TreeSubject onModel: g ref. |
						s steps: ss , {'i' , j. }.
						s amplets: amplets.
						out add: s presenter
					].
				({#dnu. #refused. #rootPop. } includes: g kind) ifTrue: [
						out add: (item: j
								fragment: (noEdit: (errorSpan: '⚠' , g statement selector)))
					]
			].
		^out asArray
	)
	fragmentsOfValue: v steps: ss amplets: amplets = (
		(* What a field shows: the children of a tree, or a string. *)
		
		v isKindOfTreeValue ifTrue: [
				^fragmentsOfItems: v tree items steps: ss amplets: amplets
			].
		v isKindOfString ifTrue: [ ^{v. } ].
		^{v printString. }
	)
	item: j fragment: f = (
		f attributes: f attributes , {{'data-item'. j. }. }.
		^f
	)
	join: strings with: separator = (
		| out ::= ''. |
		strings keysAndValuesDo: [:i :s |
				i > 1 ifTrue: [ out:: out , separator ].
				out:: out , s
			].
		^out
	)
	public libErrors: tree = (
		(* libErrors(tree) (Section 6): the errors of a tree, as the core's
errors(tree), together with those of the trees its blocks' fields hold, in
document order. *)
		
		| out = List new. |
		libErrorsOf: tree into: out.
		^out asArray
	)
	libErrorsOf: tree into: out = (
		tree flag = #unclosed ifTrue: [
				out add: (emmanuel MarkupError kind: #unclosedBlock data: tree messages)
			].
		tree flag = #rejected ifTrue: [
				out add: (emmanuel MarkupError kind: #rejectedBlock data: tree messages)
			].
		tree state stateValues do: [:v |
				v isKindOfTreeValue ifTrue: [ libErrorsOf: v tree into: out ]
			].
		tree items do: [:g |
				g kind = #sub ifTrue: [ libErrorsOf: g ref into: out ]
					ifFalse: [
						({#dnu. #stray. #rootPop. #refused. } includes: g kind) ifTrue: [
								out add: (emmanuel MarkupError kind: #errorLeaf data: g)
							]
					]
			]
	)
	noEdit: f = (
		(* f, which the editor does not let one type into. *)
		
		f attributes: f attributes , {{'contenteditable'. 'false'. }. }.
		^f
	)
	opened: x = (
		x = 'paragraph' ifTrue: [ ^Paragraph new ].
		x = 'emphasis' ifTrue: [ ^Emphasis new ].
		x = 'strong' ifTrue: [ ^Strong new ].
		x = 'code' ifTrue: [ ^InlineCode new ].
		x = 'list' ifTrue: [ ^BulletList new ].
		x = 'numberedList' ifTrue: [ ^NumberedList new ].
		x = 'item' ifTrue: [ ^Item new ].
		x = 'quote' ifTrue: [ ^Quote new ].
		x = 'table' ifTrue: [ ^Table new ].
		x = 'headerRow' ifTrue: [ ^HeaderRow new ].
		x = 'row' ifTrue: [ ^Row new ].
		x = 'cell' ifTrue: [ ^Cell new ].
		^Figure new
	)
	public openers = (
		^{'paragraph'. 'emphasis'. 'strong'. 'code'. 'list'. 'numberedList'. 'item'. 'quote'. 'table'. 'headerRow'. 'row'. 'cell'. 'figure'. }
	)
	public styleClose: x = (
		(* The statement that closes the style x (Section 7.9). *)
		
		^unary: (closerOf: x)
	)
	public styleOpen: x = (
		(* The statement that opens the style x: emphasis, strong, or code. *)
		
		^unary: x
	)
	public template: x = (
		(* The items of the template of the opener x before the view's
caret: the opener, and for a table, a row of one cell. *)
		
		x = 'table' ifTrue: [ ^unaryItems: {'table'. 'row'. 'cell'. } ].
		^unaryItems: {x. }
	)
	public templateAfter: x = (
		(* The items of the template of x after the caret: its closer. *)
		
		x = 'table' ifTrue: [ ^unaryItems: {'endCell'. 'endRow'. 'endTable'. } ].
		^unaryItems: {closerOf: x. }
	)
	unary: x = (
		(* A unary send with no source: its span is [0, 0). *)
		
		^emmanuel SendStatement comments: {}
			selector: x
			arguments: {}
			span: (emmanuel Span from: 0 to: 0)
	)
	unaryItems: selectors = (
		^selectors collect: [:x |
				emmanuel Item text: nil span: nil statement: (unary: x)
			]
	)
) : ()
