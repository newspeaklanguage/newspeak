Newspeak3
'Emmanuel'
class EmmanuelSyncTestingConfiguration packageTestsUsing: manifest = (
	(* From tool/:
  ./run-tests.sh EmmanuelSyncTestingConfiguration ../Emmanuel.ns ../EmmanuelNewspeakHost.ns ../EmmanuelBlocks.ns ../EmmanuelEdit.ns ../EmmanuelIncremental.ns ../AmpleforthEditor.ns ../NewspeakASTs.ns ../EmmanuelSyncTesting.ns

The tests run headless, on a stub platform with the real collections,
kernel, and mirrors; they use the live editor's Session, which never
renders. *)
	
	|
		private Emmanuel = manifest Emmanuel.
		private EmmanuelBlocks = manifest EmmanuelBlocks.
		private EmmanuelNewspeakHost = manifest EmmanuelNewspeakHost.
		private EmmanuelEdit = manifest EmmanuelEdit.
		private EmmanuelIncremental = manifest EmmanuelIncremental.
		private AmpleforthEditor = manifest AmpleforthEditor.
		private EmmanuelSyncTesting = manifest EmmanuelSyncTesting.
		private NewspeakASTs = manifest NewspeakASTs.
		private NewspeakPredictiveParsing = manifest NewspeakPredictiveParsing.
	|
) (
	class Stub new = (
		(* Answers itself to every message. *)
		
	) (
		public doesNotUnderstand: message = (
			^self
		)
	) : ()
	class StubPlatform realPlatform: real = (
		(* The real collections, kernel, and mirrors; anything else is a Stub. *)
		
		|
			private realPlatform = real.
			private stub = Stub new.
		|
	) (
		public collections = (
			^realPlatform collections
		)
		public doesNotUnderstand: message = (
			^stub
		)
		public kernel = (
			^realPlatform kernel
		)
		public mirrors = (
			^realPlatform mirrors
		)
	) : ()
	public testModulesUsingPlatform: p minitest: m = (
		^{EmmanuelSyncTesting usingPlatform: p
			minitest: m
			editor: (AmpleforthEditor usingPlatform: (StubPlatform realPlatform: p)
				emmanuel: Emmanuel
				newspeakHost: EmmanuelNewspeakHost
				blocks: EmmanuelBlocks
				edit: EmmanuelEdit
				incremental: EmmanuelIncremental
				parsing: NewspeakPredictiveParsing
				asts: NewspeakASTs). }
	)
) : ()
