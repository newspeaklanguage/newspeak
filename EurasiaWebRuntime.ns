Newspeak3
'Eurasia'
class EurasiaWebRuntime hopscotch: hopscotchModule ducts: ductsModule graphics: graphicsModule fonts: fontsModule text: textModule voiceController: voiceControllerClass aiAccess: aiAccessModule = (
	(* The platform of a Hopscotch application on Eurasia's web host, as RuntimeForHopscotchForHTML's is on psoup: Eurasia's base platform (EurasiaRuntime), extended with psoup's graphics, fonts, text, ducts, AI access and Hopscotch modules. Images are loaded by the browser from files beside the page, named as in the newspeak checkout. Modules are built when the platform is, at genesis, so they must not touch the host then; their host lookups are lazy, as on psoup, where they are built before serialization. *)
	
	|
		private Hopscotch = hopscotchModule.
		private Ducts = ductsModule.
		private Graphics = graphicsModule.
		private Fonts = fontsModule.
		private TextModule = textModule.
		private VoiceController = voiceControllerClass.
		private AIAccess = aiAccessModule.
	|
) (
	class Images usingPlatform: p = (
		(* The images Hopscotch uses, loaded lazily by the browser from their files. *)
		
		|
			platform = p.
		|
	) (
		lazy public accept16px = resolveImage: 'accept16px.png'.
		lazy public addImage = resolveImage: 'addImage.png'.
		lazy public ampleforthDocument = resolveImage: 'ampleforthDocument.png'.
		lazy public backImage = resolveImage: 'backImage.png'.
		lazy public brainImage = resolveImage: 'brain.png'.
		lazy public cancel16px = resolveImage: 'cancel16px.png'.
		lazy public classImage = resolveImage: 'classImage.png'.
		lazy public classPresenterImage = resolveImage: 'classPresenterImage.png'.
		lazy public classUnknownImage = resolveImage: 'classUnknownImage.png'.
		lazy public clearImage = resolveImage: 'clearImage.png'.
		lazy public collapseImage = resolveImage: 'collapseImage.png'.
		lazy public disclosureClosedImage = resolveImage: 'disclosureClosedImage.png'.
		lazy public disclosureOpenImage = resolveImage: 'disclosureOpenImage.png'.
		lazy public downloadImage = resolveImage: 'downloadImage.png'.
		lazy public dropDownImage = resolveImage: 'dropDownImage.png'.
		lazy public editIcon = resolveImage: 'editIcon.png'.
		lazy public expandImage = resolveImage: 'expandImage.png'.
		lazy public findImage = resolveImage: 'findImage.png'.
		lazy public forwardImage = resolveImage: 'forwardImage.png'.
		lazy public helpImage = resolveImage: 'helpImage.png'.
		lazy public historyImage = resolveImage: 'historyImage.png'.
		lazy public homeImage = resolveImage: 'homeImage.png'.
		lazy public itemReferencesImage = resolveImage: 'itemReferencesImage.png'.
		lazy public mikeImage = resolveImage: 'mikeImage.png'.
		lazy public newImage = resolveImage: 'newImage.png'.
		lazy public peekingeye1610 = resolveImage: 'peekingeye1610.png'.
		lazy public privateAccessImage = resolveImage: 'privateAccessImage.png'.
		lazy public protectedAccessImage = resolveImage: 'protectedAccessImage.png'.
		lazy public publicAccessImage = resolveImage: 'publicAccessImage.png'.
		lazy public refreshImage = resolveImage: 'refreshImage.png'.
		lazy public saveImage = resolveImage: 'saveImage.png'.
		lazy public sectionImage = resolveImage: 'sectionImage.png'.
		resolveImage: path <String> ^<Alien[Image]> = (
			^(platform js global at: 'Image') new at: 'src' put: path;
				yourself
		)
	) : ()
	public class Platform over: basePlatform = (
		|
			public kernel = basePlatform kernel.
			public collections = basePlatform collections.
			public mirrors = basePlatform mirrors.
			public victoryFuel = basePlatform victoryFuel.
			public actors = basePlatform actors.
			public js = basePlatform js.
			public fonts = Fonts usingPlatform: self.
			public graphics = Graphics usingPlatform: self.
			public text = TextModule usingPlatform: self.
			public local = self.
			public transcript = Transcript new.
			public aiAccess = AIAccess usingPlatform: self.
			public hopscotch = Hopscotch usingPlatform: self
				images: (Images usingPlatform: self)
				ducts: (Ducts usingPlatform: self)
				voiceControlClass: VoiceController.
			public buildInfo (* The BuildInfo module the application was packaged with, which answers buildTime; nil if none. *)
			public hostModule (* The Host module (host services), which the application gives the platform; nil if none. *)
		|
	) (
		lazy public host = nil = hostModule ifFalse: [ hostModule usingPlatform: self ].
		public class Transcript new = (
			(* A transcript that writes to the host's console. *)
			
		) (
			public cr = (
				'' out
			)
			public print: o = (
				o printString out
			)
			public show: message <String> = (
				message out
			)
		) : ()
		public buildTime ^<String> = (
			(* When the application was built, as psoup's platform answers it; every platform answers this. *)
			
			^nil = buildInfo ifTrue: [ 'unknown' ] ifFalse: [ buildInfo builtAt ]
		)
		public isKindOfPlatformWithHopscotch ^<Boolean> = (
			^true
		)
		public operatingSystem ^<String> = (
			(* psoup answers its host's name (primitive 99); here the host is always the browser. *)
			
			^'web'
		)
	) : ()
) : ()
