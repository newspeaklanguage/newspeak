;; Newspeak lookup/dispatch domains. See README.md for the view boundary.
;; Distinct constructors matter: SpecTec types are structural, so mere aliases
;; of nat would NOT give disjoint identity domains.

syntax objectid = OID nat
syntax classid = CID nat
syntax mixinid = MID nat
syntax actid = AID nat
syntax closureid = CLID nat
syntax mirrorid = GID nat
syntax actorid = ARID nat
syntax classdecl = CD nat
syntax literaldecl = LD nat
syntax methodid = MD nat
syntax actdecl = methodid | BLOCKDECL nat
syntax classbodydecl = classdecl | literaldecl
syntax scopedecl = classbodydecl | actdecl
syntax siteid = SITE nat
syntax objref =
  | OBJECTREF objectid
  | CLASSREF classid
  | MIXINREF mixinid
  | ACTIVATIONREF actid
  | CLOSUREREF closureid
  | MIRRORREF mirrorid
  | ACTORREF actorid
syntax selector = text
syntax access = PUBLIC | PROTECTED | PRIVATE
syntax message = selector objref*

;; Lookup observes this projection of a method, not its executable body.
;; The stable ID identifies the full method in the original program.
;; @partial eq:method-definition
;; @partial eq:method-projections
syntax methodview = {
  ID methodid, SELECTOR selector, ACCESS access, OWNER classbodydecl
}
;; @partial eq:mixin-record
syntax mixinview = { DECL classbodydecl, METHODS (selector, methodview)* }
;; @partial eq:heap-records
syntax classview = { MIXIN mixinid, SUPER classid, ENCLOSING objref }
;; @partial eq:heap-records
syntax activationview = {
  RECEIVER objref, CURRENT classid,
  SCOPES (scopedecl, objref)*
}

;; These are named lookup views, NOT truncated definitions of P or H.
;; The README gives the exact field-wise projection from the LaTeX records.
;; Full execution and reflection will use the full semantic records.
;; @partial eq:program-definition
;; @partial eq:distinguished-platform-classes
syntax lookupProgram = {
  TOP classid, OBJECT classid,
  MIXINS (mixinid, mixinview)*,
  DECLMIXINS (classbodydecl, mixinid)*,
  LEXPARENTS (classdecl, classdecl)*,
  ACTIVATIONMEMBERS (actdecl, selector*)*,
  SCOPECHAINS (siteid, scopedecl*)*
}
;; @partial eq:heap-records
syntax lookupHeap = {
  CLASSES (classid, classview)*,
  TYPEOF (objref, classid)*,
  ACTIVATIONS (actid, activationview)*
}

var P : lookupProgram
var H : lookupHeap
var C : classid
var M : mixinid
var D : classdecl
var L : literaldecl
var K : classbodydecl
var q : actdecl
var d : scopedecl
var z : siteid
var o : objref
var a : actid
var f : methodview
var s : selector
var mu : message
var n : nat

syntax methodoption = NOMETHOD | METHODFOUND methodview
syntax classresult = NOCLASS | CLASSFOUND classid
syntax decloption = NODECL | DECLFOUND classdecl
syntax scopeoption = NOSCOPE | SCOPEFOUND scopedecl
syntax natoption = NOINDEX | INDEXFOUND nat

;; Finite maps are represented by duplicate-free association sequences.
;; Guards are disjoint: no semantic priority or first-success rule ordering.
;; Result is a zero-or-one-element sequence, as determined by these clauses.
def $mapGet(syntax X, syntax Y, (X, Y)*, X) : Y*
def $mapGet(syntax X, syntax Y, eps, x) = eps
def $mapGet(syntax X, syntax Y, (x, y) (x', y')*, x_0) = y
  -- if x = x_0
def $mapGet(syntax X, syntax Y, (x, y) (x', y')*, x_0) =
  $mapGet(X, Y, (x', y')*, x_0)
  -- if x =/= x_0

def $unique(syntax X, X*) : bool
def $unique(syntax X, eps) = true
def $unique(syntax X, x x'*) = ~(x <- x'*) /\ $unique(X, x'*)

def $mapUnique(syntax X, syntax Y, (X, Y)*) : bool
def $mapUnique(syntax X, syntax Y, (x, y)*) = $unique(X, x*)

;; The head is intentionally partial; maps supply at most one value.
def $require(syntax X, X*) : X
def $require(syntax X, x x'*) = x

def $methodOption(methodview*) : methodoption
def $methodOption(eps) = NOMETHOD
def $methodOption(f) = METHODFOUND f

def $declOption(classdecl*) : decloption
def $declOption(eps) = NODECL
def $declOption(D) = DECLFOUND D

def $mixinAt(lookupProgram, mixinid) : mixinview
def $mixinAt(P, M) = $require(mixinview, $mapGet(mixinid, mixinview, P.MIXINS, M))

def $classAt(lookupHeap, classid) : classview
def $classAt(H, C) = $require(classview, $mapGet(classid, classview, H.CLASSES, C))

def $activationAt(lookupHeap, actid) : activationview
def $activationAt(H, a) = $require(activationview, $mapGet(actid, activationview, H.ACTIVATIONS, a))

def $classOf(lookupHeap, objref) : classid
def $classOf(H, o) = $require(classid, $mapGet(objref, classid, H.TYPEOF, o))

def $superclass(lookupHeap, classid) : classid
def $superclass(H, C) = $classAt(H, C).SUPER

def $declaration(lookupProgram, lookupHeap, classid) : classbodydecl
def $declaration(P, H, C) = $mixinAt(P, $classAt(H, C).MIXIN).DECL

def $methods(lookupProgram, mixinid) : (selector, methodview)*
def $methods(P, M) = $mixinAt(P, M).METHODS

;; @equation eq:direct
def $direct(lookupProgram, lookupHeap, classid, selector) : methodoption
def $direct(P, H, C, s) =
  $methodOption($mapGet(selector, methodview, $methods(P, $classAt(H, C).MIXIN), s))

syntax lookupresult = ABSENT | FOUND methodview classid
syntax dispatchresult =
  | INVOKE methodview objref classid message
  | MISSING objref classid message
  | INVALIDSUPER classid
var r : lookupresult
var cr : classresult
var dr : dispatchresult
var copt : classresult
var dopt : decloption
