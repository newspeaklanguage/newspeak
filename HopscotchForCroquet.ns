			items: i
			action: a (
			|
				public fragmentId <String> ::= newPickerId.
				scope_slot <String>
			|
		) (
			croquetEventSpecs ^<Array[Symbol]> = (
				^{#model_picker_pick. }
			)
			createVisual ^<Alien[Element]> = (
				ensureCroquetSubscriptions.
				^super createVisual
