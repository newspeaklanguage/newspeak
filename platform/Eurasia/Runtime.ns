Newspeak3
'Eurasia'
class Runtime kernel: kernelModule collections: collectionsModule actors: actorsModule = (
	(* The platform on Eurasia, as RuntimeForPrimordialSoup is on psoup: psoup's public kernel, collections and actors modules over the internal kernel (InternalKernel). An application packaged with the genesis packager builds it in platformOver:, which the genesis entry calls; what Eurasia does not have yet (mirrors, M6; serialization between VMs, which ports need) is a stand-in whose classes are nil. *)
	
	|
		private Kernel = kernelModule.
		private Collections = collectionsModule.
		private Actors = actorsModule.
	|
) (
	class JS internalKernel: ik = (
		(* What psoup's JSForPrimordialSoup gives the platform, on Eurasia's call-based FFI: host objects are the kernel's Aliens, whose operations are natives (operation list, section 10). On a host without host objects (the command line) every operation fails with #unsupported. *)
		
		|
			private Alien = ik Alien.
		|
	) (
		public global = (
			^Alien global
		)
		public localStorage = (
			^(global at: 'window') at: 'localStorage'
		)
		public undefined = (
			^global at: 'undefined'
		)
	) : ()
	public class Platform internalKernel: ik = (
		|
			public kernel = Kernel wrapping: ik.
			public collections = Collections usingInternalKernel: ik.
			public victoryFuel = Unavailable new.
			public mirrors = Unavailable new.
			public actors = Actors usingPlatform: self.
			public js = JS internalKernel: ik.
		|
	) (
	) : ()
	class Unavailable new = (
		(* Stands in for a module Eurasia does not have yet; its users only store these classes. *)
		
	) (
		public ClassMirror = (
			^nil
		)
		public Deserializer = (
			^nil
		)
		public ObjectMirror = (
			^nil
		)
		public Serializer = (
			^nil
		)
	) : ()
) : ()
