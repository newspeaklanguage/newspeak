		public class DropDownMenuFragment menu: ms image: img <Image> alignment: side <Symbol> = super DropDownMenuFragment menu: ms
			image: img
			alignment: side (
			(* Dropdown menus operate in two stages: first, the menu button is clicked, to display the actual menu.  This is handled in this class, via #clickHandler, which publishes the #dropDownMenu_click event.
Once the menu is displayed, individual entries in it can be clicked.  This is handled via class #Menu. Here we compute an instance of #Menu based on the menu contents; this is what gets displayed. *)
			
			(* NOT named fragmentId. That would override the slot of the same name in
     ImageButtonFragment, our superclass, whose initializer runs FIRST and calls
     setupCroquetView - and #scope there dispatches the id accessor to THIS slot,
     still uninitialized, so it read nil. Every dropdown then subscribed on
     'nsImagebutton_nil', because nil printString silently produced a string
     instead of failing. *)
			
			|
				public dropDownMenuId <String> ::= newDropDownMenuId.
				
				(* The Menu computed at the most recent open (see updateContent). Held so its subscription can be retired: Menu is not a Fragment, so the lifecycle machinery cannot reach it, and without this every open leaked one subscription. Public, because same-kind adoption transfers it. *)
				public currentMenu <Menu>
			|
			scope_slot: 'nsdropdownmenu_' , dropDownMenuId.
		) (
			croquetEventSpecs ^<Array[Symbol]> = (
				(* Only our own spec: our setupCroquetView subscribes the dropdown click alone, not the inherited image-button click. createVisual is inherited from ImageButtonFragment and dispatches here. *)
				
				^{#model_dropDownMenu_click. }
			)
			updateVisualsFromSameKind: oldFragment <DropDownMenuFragment> ^<Alien[InputElement]> = (
				(* The publisher's payload carries dropDownMenuId (see the initializer comment for why it is not named fragmentId), so the lineage id to adopt is that one, in addition to the shared identity. The most recent Menu travels with the lineage too, so its subscription stays reachable for retirement. *)
				
				dropDownMenuId: oldFragment dropDownMenuId.
				currentMenu: oldFragment currentMenu.
				adoptCroquetIdentityFrom: oldFragment.
				^super updateVisualsFromSameKind: oldFragment
			)
			public noticeDisposal = (
				currentMenu isNil ifFalse: [
						currentMenu retire.
						currentMenu: nil
					].
				super noticeDisposal
			)
			updateContent ^<Alien[Element]> = (
				(* Overridden so as to wrap the menu items so that their actions post Croquet events. Each open computes a fresh Menu, which subscribes; this runs inside the synchronized dropdown-click event, so retiring the PREVIOUS open's subscription here happens at the same event position on every client and under replay - bounding a dropdown lineage to at most one menu subscription. *)
				
				| menu <Alien[Div]> |
				currentMenu isNil ifFalse: [ currentMenu retire ].
				currentMenu: (Menu supplier: menuSupplier).
				menu:: computeContentForMenu: [ currentMenu menuContents ].
				showMenu: menu forFragment: self.
				^menu
			)
			setupCroquetView = (
				(* When the Croquet view is notified of a click, it will call back to the Newspeak button to perform its normal action *)
				
				subscribe: #model_dropDownMenu_click
					handler: [:e | super computeClickHandler value: e ]
			)
			computeClickHandler ^<[:Alien | Boolean]> = (
				^[:event |
					event stopPropagation.
					publish: 'nsdropdownmenu_' event: #dropDownMenu_click data: dropDownMenuId.
					nil
				]
			)
		) : (
			public menu: ms <[{Symbol | {String. []}}]> ^<Instance> = (
				^menu: ms image: dropDownImage alignment: #right
			)
			public menu: ms <[{Symbol | {String. []}}]> alignment: side <Symbol> ^<Instance> = (
				^menu: ms image: dropDownImage alignment: side
			)
			public menu: ms <[{Symbol | {String. []}}]> image: img <Image> ^<Instance> = (
				^menu: ms image: img alignment: #right
			)
		)
		public class Fragment new = super Fragment new (
			|
				public croquetView_slot <Promise[Alien[NewspeakCroquetFragmentView]]>
			|
		) (
			lazy public croquetSubscribed <Boolean> ::= (* Whether this fragment currently owns its lineage's subscriptions. Public, because adoption reads and clears it on the OLD fragment; lazy, so instances that predate a hot-load of this class answer false rather than nil. *) false.
			croquetModel = (
				^croquetView model
			)
			croquetView = (
				croquetView_slot isNil ifTrue: [ setupCroquetView ].
				^croquetView_slot
			)
			setupCroquetView = (
				(* only fragments that actively need croquet support need this *)
				
				subclassResponsibility
			)
			subscribe: eventSpec <String> handler: blk <[CroquetEvent]> = (
				subscribeFragment: fragmentId
					scope: scope
					eventSpec: eventSpec
					handler: blk
					label: croquetLabel
			)
			croquetLabel ^<String> = (
				(* What this fragment IS, for the divergence alarm's label check (croquet-post.js nsCheckLabel): the enclosing presenter's class, this fragment's kind, and - see croquetLabelDetail - a button's or link's text. Registered with each subscription, so every client holds it beside the address; a publisher's copy rides its recorded event, and a client whose fragment at that address is labelled differently has minted ids in a different order. That is reported on receipt even when a fragment of the same kind sits at the address, which the delivery count check cannot see (Cancel where Apply should be, 2026-09-14). Must be identical on every client that is in sync: nothing client-specific - a view id, a local time - may enter it. Guarded and cheap: a label is never worth raising over. *)
				
				^[
					| p |
					p:: parent.
					[ p isNil or: [ p isKindOfPresenter ] ] whileFalse: [ p:: p parent ].
					(p isNil ifTrue: [ '' ] ifFalse: [ p presenterLabel ]) , '/' , self class name , croquetLabelDetail
				] on: Exception do: [:e | '' ]
			)
			croquetLabelDetail ^<String> = (
				(* The part of croquetLabel that tells THIS fragment from siblings of its kind in the same presenter; empty unless a leaf overrides it (buttons and links: their text). *)
				
				^''
			)
			croquetEventSpecs ^<Array[Symbol]> = (
				(* The model eventSpecs this fragment's setupCroquetView subscribes to, one entry per subscribe:handler: call there. Drives subscription retirement and same-kind transfer; empty for fragments that need no synchronization, so retirement is a no-op for them. Leaves that define setupCroquetView must override this to match. *)
				
				^{}
			)
			ensureCroquetSubscriptions = (
				(* Sent from createVisual: a lineage subscribes when it FIRST attaches, not at construction - presenter rebuilds construct fragments wholesale, including ones that never attach, and replay drives realization, so replayed histories subscribe at the same event positions. The guard keeps a leaf whose base updateVisualsFromSameKind: rebuilds its visual via createVisual from subscribing a second time after adoption already did. *)
				
				croquetSubscribed ifFalse: [
						croquetSubscribed: true.
						setupCroquetView
					]
			)
			retireCroquetSubscriptions = (
				croquetSubscribed ifTrue: [
						croquetSubscribed: false.
						croquetEventSpecs do: [:spec |
								js global nsUnsubscribe: scope eventSpec: spec
							]
					]
			)
			public noticeDisposal = (
				(* This fragment's ownership of its visual ends with no same-kind successor (see the base definition): its lineage is over, so its subscriptions are retired. Disposal is driven by synchronized GUI updates, so it happens at the same event position on every client and under replay. *)
				
				retireCroquetSubscriptions.
				super noticeDisposal
			)
			public noticeExposure = (
				(* Disposal is not always final: subjects cache their presenters, so history navigation can RE-DISPLAY a page whose subscriptions were retired when it was navigated away from - its visuals and DOM handlers intact, so it publishes under its original ids, which noticeDisposal has unsubscribed. Exposure is propagated on every display, within the synchronized navigation event, so re-arming here happens at the same event position on every client and under replay. On a first display createVisual has just subscribed, making this a no-op; the isEmpty guard keeps fragments without subscriptions away from setupCroquetView, which is a subclass responsibility.

	This hook alone cannot be relied on: several classes override noticeExposure without a super send (base CodeMirrorFragment and HolderComposer among them), cutting the walk. The shell's displayPresenter: therefore also drives rearmCroquetSubscriptions, a dedicated walk over childrenDo:, which every fragment implements structurally. This hook stays for exposure paths that bypass displayPresenter:, such as the toggle composer's collapse/expand notifications. *)
				
				croquetEventSpecs isEmpty ifFalse: [
						hasVisual ifTrue: [ ensureCroquetSubscriptions ]
					].
				super noticeExposure
			)
			public rearmCroquetSubscriptions = (
				(* See noticeExposure: restore the subscriptions of a re-displayed tree, walking childrenDo: because the noticeExposure walk is cut by overrides that do not propagate. Idempotent - croquetSubscribed guards each leaf - so overlapping walks are harmless. *)
				
				croquetEventSpecs isEmpty ifFalse: [
						hasVisual ifTrue: [ ensureCroquetSubscriptions ]
					].
				childrenDo: [:each | each rearmCroquetSubscriptions ]
			)
			adoptCroquetIdentityFrom: oldFragment <Fragment> = (
				(* Same-kind transfer, sent from a leaf's updateVisualsFromSameKind: BEFORE the super send: take over the old fragment's lineage identity - its fragmentId, and therefore its scope, under which the lineage's whole recorded history lives - then re-point the lineage's subscriptions at this fragment: unsubscribe the old fragment's handlers and subscribe our own under the adopted scope. Publish-id and subscription-id then both equal the lineage id for the visual's entire life.

	   Two cases the first version got wrong (a chat page left and re-entered typed into a dead address, 2026-09-16):
	   - This fragment may already have attached under its OWN id: AmpleforthFragment>>processChildren realizes every amplet's visual at construction, before the diff adopts. Those subscriptions would outlive the id they were made under, so they are dropped first, while scope still names it.
	   - The old fragment may be RETIRED - its page was navigated away from, so noticeDisposal unsubscribed it - and is now being re-displayed through a fresh tree. The lineage is being shown again, so it is subscribed again; whether the old fragment was still subscribed only decides whether its handlers need removing first. *)
				
				croquetSubscribed ifTrue: [
						croquetSubscribed: false.
						croquetEventSpecs do: [:spec |
								js global nsUnsubscribe: scope eventSpec: spec
							]
					].
				oldFragment croquetSubscribed ifTrue: [
						oldFragment croquetSubscribed: false.
						croquetEventSpecs do: [:spec |
								js global nsUnsubscribe: oldFragment scope eventSpec: spec
							]
					].
				fragmentId: oldFragment fragmentId.
				scope_slot: oldFragment scope.
				croquetEventSpecs isEmpty ifFalse: [
						croquetSubscribed: true.
						setupCroquetView
					]
			)
		) : ()
		public class Menu supplier: ms <[{Symbol | {String. []}}]> = Object new (
			(* This class reifies the structure displayed by a dropdown menu when it is clicked, ergo, the list of menu entries (the actual menu). The handling of the latter clicking is done in #DropDownMenuFragment.

Instances of this class are not proper fragments in and of themselves (perhaps an oversight in the Hopscotch menu design for the web).
Nevertheless, it operates in a similar manner. Each entry shows the original menu text, but wraps the corresponding action so that when the entry is clicked, an event will get published indicating what entry was selected.  A handler is set up, subscribing to the notification events from the model, that uses the name of the entry provided by the event to choose the appropriate action. This is done by looking it up in a map, #menuItemMap, which is constructed from the original menu supplier, #ms, via the #buildMenuItemMap method. *)
			
			|
				fragmentId <String> = newMenuId.
				public menuContents <List[Symbol | {String. []}]> = List new.
				menuItemMap <Map[String, []]> = Map new.
			|
			buildMenuItemMap: ms.
			setupCroquetView.
		) (
			lazy scope <String> = 'nsmenu_' , fragmentId.
			public retire = (
				(* The menu's one subscription. A Menu lives for one dropdown open; the owning DropDownMenuFragment retires it when the next open computes a replacement, and at its own disposal. *)
				
				js global nsUnsubscribe: scope eventSpec: #model_menu_click
			)
			setupCroquetView = (
				subscribeFragment: fragmentId
					scope: scope
					eventSpec: #model_menu_click
					handler: [:e <String> |
						('executing menu item ' , e) out.
						(menuItemMap at: e) value
					]
			)
			buildMenuItemMap: ms <[{Symbol | {String. []}}]> ^<Map[String, []]> = (
				ms value do: [:item <Symbol | {String. []}> |
						item = #separator ifFalse: [
								menuItemMap at: item first put: item last.
								('menu item ' , item first , fragmentId) out.
								menuContents add: {item first. [
										('published menu click ' , fragmentId , ' ' , item first) out.
										publish: 'nsmenu_'
											event: 'menu_click'
											data: (js global newspeakFragmentData: fragmentId data: item first)
									]. }
							]
							ifTrue: [ menuContents add: #separator ]
					]
			)
		) : ()
		class HopscotchShell new = super HopscotchShell new (
			(* We override HopscotchShell, much like we override fragments. This is needed because users interact via the navigation buttons in the web browser (or our own navigation buttons in non-browser configurations. 

This behavior is routed through the #userBack: method, which handles web browser navigation events ('onpopstate'). *)
			
			|
				fragmentId <String> = newWindowId.
				
				(* The Menu of the most recently opened context menu (see the module's openMenu:forShell:inVisual:). Held so its subscription can be retired at the next open, as DropDownMenuFragment holds currentMenu; a shell shows one menu at a time. *)
				contextMenu <Menu>
			|
			setupCroquetView.
		) (
			scope = (
				^'nsshell_' , fragmentId
			)
			public noteContextMenu: m <Menu> = (
				(* Retire the previous context menu's subscription; it is unreachable once its popup is gone. Called inside the synchronized action that opens the new menu, so the retirement happens at the same event position on every client and under replay. *)
				
				contextMenu isNil ifFalse: [ contextMenu retire ].
				contextMenu: m
			)
			convertPopState: event = (
				^js global nsPopstateData: event
			)
			userBack: event = (
				publish: 'nsshell_'
					event: #shell_userBack
					data: (js global newspeakFragmentData: fragmentId
						data: (convertPopState: event))
			)
			public displayPresenter: p = (
				super displayPresenter: p.
				
				(* A re-displayed page's subscriptions were retired when it was navigated away from; restore them for the whole tree. The noticeExposure hook (see Fragment) covers only the parts of the tree its walk reaches. *)
				p rearmCroquetSubscriptions.
				
				(* As explained in the class comment, the very first presenter we display needs to notify the JS code that a replay of any unprocessed events should be done. *)
				isStartingUp ifTrue: [
						isStartingUp:: false.
						
						(* The replayed event handlers assume that all Newspeak processing for the turn has completed by the time they run (as it has in normal execution). A direct send honors that: replayEvents only ENQUEUES handler thunks on the dispatch chain, and promise thunks run after the current turn's synchronous processing. This used to be an eventual send (rootView <-: replay), which raised MessageNotUnderstood on the JS platform and silently cost late joiners their entire catch-up there. (That MNU turned out to be a since-fixed bug in ActorsForJS enqueueMessage: - master 4713887 - not a platform limitation; the direct send is kept because its turn-ordering argument stands on its own.) *)
						rootView replay
					]
			)
			public activeMenuBlurred = (
				publish: 'nsshell_' event: #shell_activeMenuBlurred data: fragmentId
			)
			setupCroquetView = (
				subscribeFragment: fragmentId
					scope: scope
					eventSpec: #model_shell_userBack
					handler: [:e |
						super userBack: e.
						nil
					].
				subscribeFragment: fragmentId
					scope: scope
					eventSpec: #model_shell_activeMenuBlurred
					handler: [:e |
						super activeMenuBlurred.
						nil
					]
			)
		) : ()
		public class FileChooserFragment allowMultiples: b <Boolean> = super FileChooserFragment allowMultiples: b (
			(* public, like the class it overrides: an override with no modifier is protected,
     which NARROWS a public member, and clients import this one with an ordinary
     cross-object send (AI_IDE_Support: `platform hopscotch FileChooserFragment`).
     Getting it wrong shows up as `MessageNotUnderstood: Hopscotch FileChooserFragment`
     during IDE startup, long before anything renders. *)
			
			(* This fragment is a bit unusual. We deviate somewhat from this module's standard formula for overriding fragments. The browser will not allow the standard (i.e., inherited) FileChooserFragment action to take place unless there was an actual user action (i.e., the user activated the UI).
As a result, only the client where the request to load files was initiated can respond with a file dialog, and only in the same turn.  This means we must take action to read files immediately, and so the #chooseFileList: method calls the super method. However, it sends it a different closure than the one passed in to it.
The original closure is stored in the #lastAction slot, while the super method is passed a closure that accepts the locally read file metadata, and forwards that data as part of the event sent to the croquet reflector.  The actual file contents are stored on the croquet server as well. The separation of metadata and file contents is needed because of size restrictions on events. When the reflector responds, the data is used to look up file contents on the server so they can be fed into the original closure kept in #lastAction. See  #chooseFlieList: and #setupCroquetView for the details.

A complication is that the file API is asynchronous, so we only have promises initially. We must wait for these promises to be resolved to obtain the required data which we will forward to the reflector. This is handled in #extractFileData:whenReady:. *)
			
			|
				fragmentId <String> = newFileChooserId.
				scope_slot <String>
				lastAction <[:List[Alien[File]] | Object]>
				lastCancel <[Object]>
			|
			liveFileChoosers add: self.
			setupCroquetView.
		) (
			public scope ^<String> = (
				(* Lazily return a unique identifier for this fragment *)
				
				scope_slot isNil ifTrue: [ scope_slot: 'nsfilechooser_' , fragmentId ].
				^scope_slot
			)
			updateVisualsFromSameKind: oldFragment <FileChooserFragment> ^<Alien[Node]> = (
				scope_slot: oldFragment scope.
				^self
			)
			descriptorFor: fd <JSObject> ^<JSObject> = (
				(* Given a file description, produce a description of the metadata only, without the contents *)
				
				| descriptor = JSObject new. |
				
				(* Copy all the data except the actual file contents (the array buffer) to the incoming file descriptor *)
				{#name. #type. #lastModified. #webkitRelativePath. } do: [:pn <Symbol> |
						descriptor at: pn put: (fd at: pn)
					].
				^descriptor
			)
			public chooseFileList: blk <[:List[Alien[File]] | Object]> = (
				(* Save the original closure for later *)
				
				lastAction:: blk.
				
				(* Locally read the files and pass their data to the reflector. In more detail:
      Once we've extracted the actual file contents, we can store them on the Croquet server. We then separate out the file metadata and pass that in the Croquet event. When that data is received by clients (including the one that sent it), it will be placed in File-like objects so that the original closure (now stored in #lastAction) can consume it.  See #setupCroquetView for details. *)
				super chooseFileList: [:fs <List[Alien[File]]> | storeAndPublish: fs ]
			)
			public chooseFileList: blk <[:List[Alien[File]] | Object]> ifCanceled: cancelBlk <[Object]> = (
				(* As chooseFileList:, for a caller that also wants to hear of a dismissed
	   dialog. Without this override the inherited method ran, which wires and
	   clicks the input itself, so such a caller got no coordination at all:
	   only the initiating client ever heard of the files, and every other
	   client waited forever. The AI upload_file tool is such a caller (found
	   2026-09-15).

	   The cancel is coordinated too. The initiating client, the only one whose
	   dialog opened, publishes a click carrying NO descriptors when its dialog
	   is dismissed; the handler in setupCroquetView reads an empty list as the
	   cancel and runs the cancel block, so every client - and a joiner
	   replaying the session - gives up on the files together. An empty list
	   needs no new model event, so the support script is untouched. Both
	   blocks go to the inherited method together, which wires them to the one
	   input it clicks (input builds a fresh node per access). *)
				
				lastAction:: blk.
				lastCancel:: cancelBlk.
				super chooseFileList: [:fs <List[Alien[File]]> | storeAndPublish: fs ]
					ifCanceled: [
						publish: 'nsfilechooser_'
							event: #fileChooser_click
							data: (js global newspeakFragmentData: fragmentId
								data: ((js global at: 'Array') new: 0))
					]
			)
			storeAndPublish: fs <List[Alien[File]]> = (
				(* The locally chosen files: store each one's contents on the Croquet
	   server, then publish the descriptors (metadata plus stored-data handle)
	   as the click event every client - this one included - consumes in
	   setupCroquetView. *)
				
				extractFileData: fs
					whenReady: [:fds <JSArray[JSObject]> |
						| ps <List[Alien[Promise[[ArrayBuffer]]]]> = (js global at: 'Array') new: fds
							at: #length. descriptors = (js global at: 'Array') new: fs size. |
						1 to: fs size
							do: [:i <Integer> |
								| fd <JSObject> = fds at: i - 1. |
								
								(* store the file contents in the reflector *)
								ps at: i - 1 put: (rootView storedData store: (fd at: #arrayBuff)).
								
								(* Gather file metadata, to be published to all clients *)
								descriptors at: i - 1 put: (descriptorFor: fd)
							].
						
						(* When data has been stored, publish notification, which will be passed on to all clients *)
						((js global at: 'Promise') all: ps) then: [:handles <JSArray[CroquetHandle]> |
								0 to: fs size - 1
									do: [:i <Integer> |
										(descriptors at: i) at: #handle put: (handles at: i)
									].
								publish: 'nsfilechooser_'
									event: #fileChooser_click
									data: (js global newspeakFragmentData: fragmentId data: descriptors).
								nil
							]
							onError: [:ex |
								alert: 'HopscotchForCroquet FileChooserFragment storeAndPublish: ' , ex printString.
								nil
							]
					]
			)
			extractFileData: fs <List[Alien[File]]> whenReady: blk <[:JSArray[JSObject] | Object]> = (
				(* In principle, the data is the file list, fs. However, files cannot be serialized as part of a Croquet event. Even if they could, they are often too large. We must obtain their contents via their asynchronous API and package that up. We then feed the data into the blk parameter for further processing. See #chooseFileList: for what that further processing looks like. *)
				
				| ps <List[Alien[Promise[[ArrayBuffer]]]]> = (js global at: 'Array') new: fs size. fds <JSArray[JSObject]> = 
				(* An array of file descriptors - JS objects of the form 
  {name: String, type: String, lastModified: Float, webkitRelativePath: String, handle: JSPromise, arrayBuff: Blob} *)
				(js global at: 'Array') new: fs size. |
				1 to: fs size
					do: [:i <Integer> |
						| f <Alien[File]> = fs at: i. |
						ps at: i - 1 put: (fs at: i) arrayBuffer.
						fds at: i - 1 put: (descriptorFor: f)
					].
				((js global at: 'Promise') all: ps) then: [:buffers <JSArray[ArrayBuffer]> |
						0 to: fs size - 1
							do: [:i <Integer> | (fds at: i) at: #arrayBuff put: (buffers at: i) ].
						[
							blk value: fds.
							nil
						] on: Error
							do: [:ex |
								alert: 'HopscotchForCroquet FileChooserFragment extractFileData:whenReady ' , ex printString.
								nil
							].
						nil
					]
					onError: [:ex |
						alert: ex printString.
						nil
					]
			)
			setupCroquetView = (
				(* When the Croquet view is notified of the chosen files, it will message us back with the file metadata. We will use that metadata to extract the file contents, stored on the Croquet server. We want to submit all that information to the original action block passed into #chooseFileList:. 
        The block wants a list of Files, so we need to feed it objects with the same API - including async methods that return the data. Of course, we actually resolved that data before posting the original event, and so the incoming data needs to repackaged into File-like objects with a fake async API. *)
				
				subscribe: #model_fileChooser_click
					handler: [:e <JSArray[JSObject]> |
						
						(* An empty descriptor list is the initiating client's dismissed
	      dialog; see chooseFileList:ifCanceled:. *)
						(e at: #length) = 0 ifTrue: [
								lastCancel isNil ifFalse: [ lastCancel value ].
								liveFileChoosers remove: self
							]
							ifFalse: [ deliverChosenFiles: e ].
						nil
					]
			)
			deliverChosenFiles: e <JSArray[JSObject]> = (
				(* The event data: an array of file descriptors - JS objects of the form
	   {name: String, type: String, lastModified: Float, webkitRelativePath: String, handle: JSPromise}.
	   Fetch each file's contents from the server, repackage them as File-ish
	   objects and hand the list to the action block chooseFileList: kept. *)
				
				| len <Integer> = e at: #length. fds <List[Alien[File]]> = List new: len. contents <JSArray[JSPromise]> = (js global at: 'Array') new: len. |
				0 to: len - 1
					do: [:i <Integer> |
						| fd <JSObject> = e at: i. |
						contents at: i put: (rootView storedData fetch: (fd at: #handle))
					].
				((js global at: 'Promise') all: contents) then: [:cs |
						0 to: len - 1
							do: [:i <Integer> |
								(e at: i) at: #arrayBuff put: (cs at: i).
								fds add: (createFile: (e at: i))
							].
						lastAction value: fds.
						liveFileChoosers remove: self.
						nil
					]
					onError: [:ex |
						alert: 'HopscotchForCroquet FileChooserFragment deliverChosenFiles: ' , ex printString.
						nil
					]
			)
		) : (
			public new ^<Instance> = (
				^allowMultiples: false
			)
		)
		class MediaCreatorFragment type: t <Symbol> name: fn <String> registry: mr <Map[String, Blob]> width: w = super MediaCreatorFragment type: t
			name: fn
			registry: mr
			width: w (
			|
				fragmentId <String> = newMediaCreatorId.
				scope_slot <String>
			|
			setupCroquetView.
		) (
			updateVisualsFromSameKind: oldFragment <MediaCreatorFragment> ^<Alien[Element]> = (
				scope_slot: oldFragment scope.
				^super updateVisualsFromSameKind: oldFragment
			)
			public scope ^<String> = (
				scope_slot isNil ifTrue: [ scope_slot: 'nsmediacreator_' , fragmentId ].
				^scope_slot
			)
			file: f <Alien[File]> = (
				| uri = blobURIFor: f. |
				registry at: fileName put: f.
				holder content: (computeHolderContentsFrom: uri)
			)
			setupCroquetView = (
				subscribe: #model_mediaCreator_setFile
					handler: [:e |
						| handle <[CroquetHandle]> = 
						(* extract handle from event *)
						e at: #handle. p <JSPromise> = 
						(* retrieve file data *)
						rootView storedData fetch: handle. |
						
						(* when the file data is actually ready ... *)
						p then: [:fd <Alien[JSObject]> |
								
								(* get the file contents and add to the file descriptor *)
								e at: #arrayBuff put: fd.
								
								(* derive a file object and pass to the super method to do the actual update *)
								file: (createFile: e).
								nil
							]
							onError: [:ex |
								alert: 'HopscotchForCroquet MediaCreatorFragment setupCroquetView: ' , ex printString.
								nil
							]
					]
			)
			public setFile: f <Alien[File]> = (
				(* publish event *)
				
				extractFileData: {f. }
					whenReady: [:fds <JSArray[JSObject]> |
						| fd = fds at: 0. p <JSPromise[CroquetHandle]> = 
						(* store the file contents in the reflector *)
						rootView storedData store: (fd at: #arrayBuff). descriptor = 
						(* Gather file metadata, to be published to all clients *)
						descriptorFor: fd. |
						
						(* When data has been stored, publish notification, which will be passed on to all clients *)
						p then: [:handle <[CroquetHandle]> |
								
								(* update descriptor with handle *)
								descriptor at: #handle put: handle.
								
								(* publish *)
								publish: 'nsmediacreator_'
									event: #mediaCreator_setFile
									data: (js global newspeakFragmentData: fragmentId data: descriptor).
								nil
							]
							onError: [:ex |
								alert: 'HopscotchForCroquet mediaForFile: ' , ex printString.
								nil
							]
					]
			)
		) : (
			public type: t <Symbol> name: fn <String> registry: mr <Map[String, Blob]> ^<Instance> = (
				^type: t name: fn registry: mr width: '600px'
			)
		)
		public class TimerFragment duration: seconds <Integer> = super TimerFragment duration: seconds (
			(* Synchronized countdown. The base class decrements on a client-local
	   schedule - free-running divergence in a lock-step system. Here no client
	   schedules anything: every client publishes timer_start on realization (the
	   model honors only the FIRST for a given fragment id), and the root model
	   drives the ticks from its own future queue, so they pace on teatime -
	   identical on every client, with no relative drift. Each tick is recorded
	   in the model's event history, so late joiners replay the same tick stream.
	   The countdown length travels in the start event and the model stops
	   itself; nothing needs to publish a stop. *)
			
			|
				fragmentId <String> = newTimerId.
				scope_slot <String>
			|
			setupCroquetView.
		) (
			public scope ^<String> = (
				scope_slot isNil ifTrue: [ scope_slot: 'nstimer_' , fragmentId ].
				^scope_slot
			)
			subscribe: eventSpec <String> handler: blk <[CroquetEvent]> = (
				subscribeFragment: fragmentId scope: scope eventSpec: eventSpec handler: blk
			)
			createVisual = (
				(* As the base method, but WITHOUT the client-local schedule; ticks come
	     from the model. *)
				
				| timer = (js global at: #document) createElement: 'div'. spec = (js global at: #Object) new. |
				timer at: 'id' put: 'timer'.
				timer at: #innerHTML put: duration.
				spec at: #interval put: 1000;
					at: #count put: duration.
				publish: 'nstimer_'
					event: #timer_start
					data: (js global newspeakFragmentData: fragmentId data: spec).
				^timer
			)
			updateVisualsFromSameKind: oldFragment <TimerFragment> ^<Alien[Element]> = (
				(* Carry over identity and state; do NOT restart the schedule (the model
	     owns it, and republishing start after completion would restart the
	     countdown). *)
				
				scope_slot: oldFragment scope.
				timeLeft:: oldFragment timeLeft.
				^oldFragment visual
			)
			setupCroquetView = (
				subscribe: #model_timer_tick
					handler: [:remaining <Integer> |
						timeLeft:: remaining.
						visual at: #innerHTML put: remaining
					]
			)
		) : ()
		public class NonSyncingPresenter onSubject: s <Subject> = Presenter onSubject: s (
			(* It is sometimes desirable to display information that is not-synchronized, but instead restricted on a client. This presenter is intended to support that.
All methods that produce synchronizing fragments are overridden to provide the original, non-synchronizing fragments.

To produce a non-synchronizing part of the UI, subclass NonSyncingPresenter and write a normal presenter definition. *)
			
		) (
			timePicker: value <Holder> action: a <[:Boolean | Object]> = (
				^super TimePickerFragment value: value action: a
			)
			slider: value <Holder> min: mn <Float> max: mx <Float> = (
				^super SliderFragment value: value min: mn max: mx
			)
			radioButton: text <String> value: v <Holder> group: g <Integer> action: a <[:Boolean | Object]> = (
				^super RadioButtonFragment text: text value: v group: g action: a
			)
			picker: text <String> items: i <List[String]> action: a <[:String | Object]> = (
				^super PickerFragment text: text items: i action: a
			)
			multipleFileChooser = (
				^super FileChooserFragment allowMultiples: true
			)
			checkbox: text <String> value: v <Boolean | Holder> action: a <[:Boolean | Object]> ^<CheckboxFragent> = (
				^super CheckboxFragment text: text value: v action: a
			)
			codeMirror: t <Text | String> = (
				^super CodeMirrorFragment onText: t
			)
			collapsed: collapsed <[Fragment]> expanded: expanded <[Fragment]> initiallyExpanded: flag <Boolean> ^<ToggleComposer> = (
				^super ToggleComposer collapsedDefinition: collapsed
					expandedDefinition: expanded
					initiallyExpanded: flag
			)
			collapsed: collapsed <[Fragment]> expanded: expanded <[Fragment]> initiallyExpanded: flag <Boolean> tag: t <String> ^<ToggleComposer> = (
				^(super ToggleComposer collapsedDefinition: collapsed
					expandedDefinition: expanded
					initiallyExpanded: flag) tag: t;
					yourself
			)
			colorPicker: value <Holder> action: a <[:Boolean | Object]> = (
				^super ColorPickerFragment value: value action: a
			)
			datePicker: value <Holder> action: a <[:Boolean | Object]> = (
				^super DatePickerFragment value: value action: a
			)
