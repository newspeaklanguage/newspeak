Newspeak3
'Eurasia'
class EurasiaCompiledGCProbe usingPlatform: platform = (
	(* The baseline compiler's guard against collections in the middle of a call (EURASIA_COMPILER_DESIGN_2026-11-19.md section 9): compiled code keeps the receiver, nil, true and false in its own locals, so after a call during which the heap was collected it must not go on, but leave the frame to the interpreter: a collection leaves a safepoint due, which compiled code checks after every call, and the VM also refuses to let it go on after one. Each round allocates garbage, then a cell above it, and sends the cell probe:, which collects (the cell slides down over the garbage) and then compares self with the cell as an Array, which the collector updated, holds it. Run with every method compiled (eurasia/scripts/web-tests.sh); without both checks, compiled code's self is the cell's old address and every round fails. The genesis packager packages this application as if nested in InternalKernel (so vm is visible) and fills the module slots below. *)
	
	|
		Kernel
		PrimordialSoupCollections
		Actors
		Runtime
		internalKernel
	|
) (
	class Cell new = (
	) (
		public probe: holder = (
			vm garbageCollect.
			^(holder at: 1) == self
		)
	) : ()
	public main: platform args: args = (
		| failures |
		failures:: 0.
		1 to: 20
			do: [:i |
				| junk cell holder |
				junk:: Array new: 2000.
				cell:: Cell new.
				holder:: Array new: 1.
				holder at: 1 put: cell.
				junk:: nil.
				(cell probe: holder) ifFalse: [ failures:: failures + 1 ]
			].
		vm print: 'compiled code across collections: ' , failures printString , ' of 20 rounds failed'
	)
	public platformOver: ik = (
		internalKernel:: ik.
		^(Runtime kernel: Kernel collections: PrimordialSoupCollections actors: Actors) Platform internalKernel: ik
	)
) : ()
