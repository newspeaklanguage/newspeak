;; Section 2: characters, spans, modes, lexemes, results, and tokens.

;; A character is a Unicode scalar value, represented as a one-scalar text.
;; That every char of a source is a single scalar value is an input
;; well-formedness obligation, not checked here.
syntax char = text
syntax span = SPAN nat nat

var c : char
var u : char
var w : char
var i : nat
var j : nat
var k : nat
var d : nat

;; @equation eq:lexical-sequences
def $openSeq : char*
def $openSeq = "[" "\\"
def $closeSeq : char*
def $closeSeq = "\\" "]"
def $backslashEscape : char*
def $backslashEscape = "\\" "\\"
def $bracketEscape : char*
def $bracketEscape = "\\" "["

syntax mode = TEXTMODE | CODEMODE
syntax modestack = mode*
var mu : mode

;; @equation eq:mode-stacks
relation ModeStack: (modestack)
rule ModeStack/bottom:
  (TEXTMODE)
rule ModeStack/text:
  (mu* TEXTMODE)
  -- if mu* =/= eps
  -- ModeStack: (mu*)
rule ModeStack/code:
  (mu* CODEMODE)
  -- if mu* =/= eps
  -- ModeStack: (mu*)

;; @equation eq:mode-alternation
def $alternating(modestack) : bool
def $alternating(eps) = false
def $alternating(TEXTMODE mu*) = $alternatesFrom(TEXTMODE, mu*)
def $alternating(CODEMODE mu*) = false

;; Head recursion: the pinned evaluator mis-splits known-suffix list
;; patterns inside function evaluation (see the Newspeak README).
def $alternatesFrom(mode, mode*) : bool
def $alternatesFrom(mu, eps) = true
def $alternatesFrom(TEXTMODE, CODEMODE mu*) = $alternatesFrom(CODEMODE, mu*)
def $alternatesFrom(CODEMODE, TEXTMODE mu*) = $alternatesFrom(TEXTMODE, mu*)
def $alternatesFrom(TEXTMODE, TEXTMODE mu*) = false
def $alternatesFrom(CODEMODE, CODEMODE mu*) = false

;; @equation eq:lexemes
syntax lexeme =
  | CHAR char
  | OPENMESSAGES | CLOSEMESSAGES | OPENMARKUP | CLOSEMARKUP
  | CODE char*
var lambda : lexeme

;; @equation eq:lex-results
syntax located = LOC lexeme span
syntax lexerror = STRAYCLOSE | UNCLOSEDLITERAL | UNCLOSEDBRACKET
syntax lexresult = LEXED located* | LEXERROR lexerror nat
var l : located
var e : lexerror
var r : lexresult

;; @equation eq:tokens
syntax token =
  | TEXT char*
  | CODE char*
  | OPENMESSAGES | CLOSEMESSAGES | OPENMARKUP | CLOSEMARKUP
syntax spantoken = TOK token span
var tau : token
var t : spantoken
