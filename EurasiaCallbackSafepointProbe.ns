Newspeak3
'Eurasia'
class EurasiaCallbackSafepointProbe usingPlatform: platform = (
	(* Compiled code in a host callback while a checkpoint is pending (eurasia 905c3d9). A callback cannot take a checkpoint, so a pending one must not keep a safepoint due there: when it did, compiled code handed its frame back to the callback's loop after every call, and after SmallInteger arithmetic done without a send (compiled_send's fast path) the frame still pointed at an earlier instruction: the loop ran the method from there again, a value more on the operand stack each round, until the stack's growth overflowed (eurasia 905c3d9 keeps the safepoint from being due; the fast path now records the instruction too). On the VM before 905c3d9 this probe traps. A host timer calls back while the VM is idle (a callback that may run compiled code); the callback asks for a checkpoint (vm checkpointNow, as Actors>>saveImage: does) and then makes many sends in a loop, with blocks and returns among them. Run with every method compiled (eurasia/scripts/web-tests.sh); it prints its line only if the callback ran to its end. The genesis packager packages this application as if nested in InternalKernel (so vm is visible) and fills the module slots below. *)
	
	|
		Kernel
		PrimordialSoupCollections
		Actors
		Runtime
		internalKernel
	|
) (
	class Cell new = (
		|
			public count ::= 0.
		|
	) (
		public step: i = (
			count:: count + 1.
			^(self twice: i) \\ 7
		)
		public twice: i = (
			^i \\ 2 = 1 ifTrue: [ i + i ] ifFalse: [ i * 2 ]
		)
	) : ()
	public main: platform args: args = (
		platform js global setTimeout: [
				| cell total |
				vm checkpointNow.
				cell:: Cell new.
				total:: 0.
				1 to: 3000000 do: [:i | total:: total + (cell step: i) ].
				vm print: 'sends in a callback with a checkpoint pending: ' , cell count printString , ' sends, sum ' , total printString.
				nil
			]
			with: 0
	)
	public platformOver: ik = (
		internalKernel:: ik.
		^(Runtime kernel: Kernel collections: PrimordialSoupCollections actors: Actors) Platform internalKernel: ik
	)
) : ()
