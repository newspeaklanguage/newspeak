Newspeak3
'Eurasia'
class EurasiaBuild packageUsing: manifest = (
	(* Builds the genesis images of a list of applications from source, on Eurasia (EURASIA_BUILD_AND_DEPLOY_DESIGN_2026-11-21.md, section 3). One packager packages them all, so a module that several applications share is compiled once; eurasia/scripts/build.sh then runs genesis on each image.

Usage:
	EurasiaBuild <newspeak> <primordialsoup> <eurasia> <BuildInfo.ns> <out> [<name> ...]

The checkouts' directories; the BuildInfo module to package in place of newspeak/BuildInfo.ns (build.sh stamps it); the output directory, where each application's genesis image is written as <name>.genesis.eus, its entry as <name>.entry.ns, and the modules packaged with it, one path a line, as <name>.modules.txt, and the image resources a page serving it must offer (X as X.png), one name a line, as <name>.images.txt. With names, only those applications are built.

The build list is newspeak/EurasiaBuildList.ns, Newspeak code compiled when the build runs: its class answers the applications (applicationsFor:) from what EurasiaDeployment's Builder offers. The applications, their platform definitions and their entries are EurasiaDeployment's; this module gives it the checkouts' files (Files) and runs the packager. *)
	
	|
		private EurasiaPackager = manifest EurasiaPackager.
		private EurasiaNatives = manifest EurasiaNatives.
		private EurasiaDeployment = manifest EurasiaDeployment.
		private packagerManifest = manifest.
		private newspeakRoot
		private psoupRoot
		private buildInfoPath
		private contents
		private existence
	|
) (
	class Files new = (
		(* The source provider of the checkouts' files (EurasiaDeployment's Builder): a module's reference is its file's path. A module X is newspeak/X.ns, else primordialsoup/newspeak/X.ns, except BuildInfo, which is the build's; platform P's module X is platform/P/X.ns in either; an image resource X is X.png in newspeak or newspeak/out. *)
		
	) (
		public buildInfo ^<String> = (
			^buildInfoPath
		)
		public hasImage: n <String> ^<Boolean> = (
			^(exists: newspeakRoot , '/' , n , '.png') or: [
					exists: newspeakRoot , '/out/' , n , '.png'
				]
		)
		public module: n <String> ^<String | Nil> = (
			n = 'BuildInfo' ifTrue: [ ^buildInfoPath ].
			^(newspeakModule: n) ifNil: [ psoupModule: n ]
		)
		public module: n <String> ofPlatform: p <String> ^<String | Nil> = (
			{newspeakRoot. psoupRoot , '/newspeak'. } do: [:root |
					| path = root , '/platform/' , p , '/' , n , '.ns'. |
					(exists: path) ifTrue: [ ^path ]
				].
			^nil
		)
		public newspeakFile: path <String> ^<String> = (
			^newspeakRoot , '/' , path
		)
		public newspeakModule: n <String> ^<String | Nil> = (
			| path = newspeakRoot , '/' , n , '.ns'. |
			^(exists: path) ifTrue: [ path ] ifFalse: [ nil ]
		)
		public primordialsoupFile: path <String> ^<String> = (
			^psoupRoot , '/' , path
		)
		public psoupModule: n <String> ^<String | Nil> = (
			| path = psoupRoot , '/newspeak/' , n , '.ns'. |
			^(exists: path) ifTrue: [ path ] ifFalse: [ nil ]
		)
		public source: path <String> ^<String> = (
			^read: path
		)
	) : ()
	exists: path <String> ^<Boolean> = (
		^existence at: path
			ifAbsentPut: [
				[
					read: path.
					true
				] on: Exception do: [:e | false ]
			]
	)
	joined: strings with: separator <String> ^<String> = (
		| result |
		result:: ''.
		strings do: [:s |
				result isEmpty ifFalse: [ result:: result , separator ].
				result:: result , s
			].
		^result
	)
	public main: platform args: args = (
		| deployment packager kernelSource apps selected newline |
		args size < 5 ifTrue: [
				'Usage: EurasiaBuild <newspeak> <primordialsoup> <eurasia> <BuildInfo.ns> <out> [<name> ...]' out.
				^nil
			].
		newspeakRoot:: args at: 1.
		psoupRoot:: args at: 2.
		buildInfoPath:: args at: 4.
		contents:: platform collections Map new.
		existence:: platform collections Map new.
		newline:: String with: 10.
		selected:: (6 to: args size) collect: [:i | args at: i ].
		deployment:: EurasiaDeployment usingPlatform: platform.
		apps:: (deployment classFromSource: (read: newspeakRoot , '/EurasiaBuildList.ns')) new applicationsFor: (deployment Builder over: Files new).
		packager:: EurasiaPackager packageUsing: packagerManifest.
		kernelSource:: read: newspeakRoot , '/platform/Eurasia/InternalKernel.ns'.
		apps do: [:app |
				(selected isEmpty or: [ selected includes: app name ]) ifTrue: [
						| entry paths bytes output |
						entry:: app entrySource.
						paths:: app modulePaths.
						writeBytes: (ByteArray withAll: entry)
							toFileNamed: (args at: 5) , '/' , app name , '.entry.ns'.
						writeBytes: (ByteArray withAll: (joined: paths with: newline) , newline)
							toFileNamed: (args at: 5) , '/' , app name , '.modules.txt'.
						writeBytes: (ByteArray withAll: (joined: app imageResources with: newline) , newline)
							toFileNamed: (args at: 5) , '/' , app name , '.images.txt'.
						bytes:: packager buildGenesisFromKernel: kernelSource
							natives: EurasiaNatives new table
							app: entry
							modules: paths asArray
							sources: (paths asArray collect: [:p | read: p ])
							keepSources: app keepsSources
							platform: platform.
						output:: (args at: 5) , '/' , app name , '.genesis.eus'.
						writeBytes: bytes toFileNamed: output.
						('Wrote ' , bytes size printString , ' bytes to ' , output , (app keepsSources ifTrue: [
								''
							]
							ifFalse: [ ' (without sources)' ])) out.
						app unresolvedNames isEmpty ifFalse: [
								('  answered nil (no module, no image): ' , (joined: app unresolvedNames
									with: ', ')) out
							].
						app absentModules isEmpty ifFalse: [
								('  absent (psoup primitives, no Eurasia fork): ' , (joined: app absentModules
									with: ', ')) out
							]
					]
			]
	)
	read: path <String> ^<String> = (
		^contents at: path ifAbsentPut: [ String withAll: (readFileAsBytes: path) ]
	)
	readFileAsBytes: filename = (
		(* Eurasia: a native (VmReadFile), by the natives table. *)
		
		halt
	)
	writeBytes: bytes toFileNamed: filename = (
		(* Eurasia: a native (VmWriteFile), by the natives table. *)
		
		halt
	)
) : ()
